procedure TtecDBGrid.TitleClick(Column: TColumn);
var
 i: integer;
 RegistroAtual: TbookMark;
 vordenacaoAux: String;
begin
  inherited;

  if DataSource <> nil then
    if not DenySort then
    begin
      if TtecQuery(DataSource.DataSet).Active then
      begin
  //      if not AltOn and not ShiftOn then
        begin
          if not CtrlIsOn then
          begin
            if Ordenacao <> column.FieldName then
            begin
              Ordenacao := column.FieldName
              {
              fOrdenacao := column.FieldName;
              ListaOrdenacao := nil;
              SetLength(FListaOrdenacao, length(ListaOrdenacao)+1);
              ListaOrdenacao[0] := Ordenacao;

              RegistroAtual := TtecQuery(DataSource.DataSet).GetBookmark;
              case TipoOrdenacao of
                Asc :
                begin
                  if asigned(GridAssociado) then
                    GridAssociado.Ordenacao := Ordenacao
                  else
                    TtecQuery(DataSource.DataSet).SortByField(Ordenacao);
                end;
                Desc: TtecQuery(DataSource.DataSet).SortDescByField(Ordenacao);
              end;
              TtecQuery(DataSource.DataSet).GotoBookmark(RegistroAtual);
              TtecQuery(DataSource.DataSet).FreeBookmark(RegistroAtual);

              for i:=0 to self.Columns.Count-1 do
                columns[i].Title.Font.Style := [];
              Column.Title.Font.Style := [fsBold];
              }
            end;


          end
          else
          begin
  //        CtrlOn := false;
            if Ordenacao <> '' then
            begin

              if pos(column.FieldName, Ordenacao) <> 0 then
              begin
                if (length(ListaOrdenacao)>1) and (column.FieldName<>FOrdenacao) then
                begin
                  for i:=0 to length(ListaOrdenacao)-1 do
                    if ListaOrdenacao[i] = column.FieldName then
                      ListaOrdenacao[i] := '';

                  if assigned(GridAssociado) then
                    for i:=0 to length(GridAssociado.ListaOrdenacao)-1 do
                      if GridAssociado.ListaOrdenacao[i] = column.FieldName then
                        GridAssociado.ListaOrdenacao[i] := '';

                  Column.Title.Font.Style := [];
                end;

              end
              else
              begin
                SetLength(FListaOrdenacao, length(ListaOrdenacao)+1);
                ListaOrdenacao[length(ListaOrdenacao)-1] := column.FieldName;

                if assigned(GridAssociado) then
                begin
                  SetLength(GridAssociado.FListaOrdenacao, length(GridAssociado.ListaOrdenacao)+1);
                  GridAssociado.ListaOrdenacao[length(GridAssociado.ListaOrdenacao)-1] := column.FieldName;
                end;


                Column.Title.Font.Style := [fsBold];
              end;

            end
            else
            begin
              ListaOrdenacao := nil;
              SetLength(FListaOrdenacao, length(ListaOrdenacao)+1);
              ListaOrdenacao[0] := column.FieldName;

              if assigned(GridAssociado) then
              begin
                SetLength(GridAssociado.FListaOrdenacao, length(GridAssociado.ListaOrdenacao)+1);
                GridAssociado.ListaOrdenacao[0] := column.FieldName;
              end;


              Column.Title.Font.Style := [fsBold];
            end;


            for i:=0 to length(ListaOrdenacao)-1 do
              if ListaOrdenacao[i]<>'' then
                vordenacaoAux := vordenacaoAux + ListaOrdenacao[i]+',';

            if vordenacaoAux<>'' then
              if Copy(vordenacaoAux,length(vordenacaoAux),1)=',' then
                delete(vordenacaoAux,length(vordenacaoAux),1);

            if vordenacaoAux <> FOrdenacao then
            begin
              Ordenacao := vordenacaoAux;
              {
              RegistroAtual := TtecQuery(DataSource.DataSet).GetBookmark;
              FOrdenacao := vordenacaoAux;
              if FOrdenacao<>'' then
              begin
                case TipoOrdenacao of
                  Asc : TtecQuery(DataSource.DataSet).SortByField(FOrdenacao);
                  Desc: TtecQuery(DataSource.DataSet).SortDescByField(FOrdenacao);
                end;
              end
              else
              begin
                  TtecQuery(DataSource.DataSet).SortClear;
              end;
              TtecQuery(DataSource.DataSet).GotoBookmark(RegistroAtual);
              TtecQuery(DataSource.DataSet).FreeBookmark(RegistroAtual);
              }
            end;

          end;
        end;
      end;
    end;
end;

procedure TtecDBGrid.SetOrdenacao(const Value: String);
var
 i,j,k: integer;
 campo, ordenacaotemp: String;
 EstaNaLista: boolean;
begin
  FOrdenacao := Value;

  {
  if pos(',',FOrdenacao)=0 then
  begin
    for i:=0 to self.Columns.Count-1 do
    begin
      if self.Columns[i].FieldName = FOrdenacao then
      begin
        self.TitleClick(self.Columns[i]);
        break;
      end
      else
      if FOrdenacao='' then
        columns[i].Title.Font.Style := [];
    end
  end
  else
  begin
  }
    ordenacaotemp := FOrdenacao + ',';
    Campo := '';
    ListaOrdenacao := nil;

    for j := 0 to self.Columns.Count-1 do
      columns[j].Title.Font.Style := [];

    if assigned(GridAssociado) then
      for j := 0 to GridAssociado.Columns.Count-1 do
        GridAssociado.columns[j].Title.Font.Style := [];


    for i:=0 to length(ordenacaotemp)-1 do
    begin
      if ordenacaotemp[i+1] <> ',' then
        campo := campo + ordenacaotemp[i+1]
      else
        if campo<>'' then
        begin

          for j := 0 to self.Columns.Count-1 do
          begin
            if self.Columns[j].FieldName = campo then
            begin
              SetLength(FListaOrdenacao, length(ListaOrdenacao)+1);
              ListaOrdenacao[length(ListaOrdenacao)-1] := campo;
              columns[j].Title.Font.Style := [fsBold];
              break;
            end;
          end;

          if assigned(GridAssociado) then
          begin
            for j := 0 to GridAssociado.Columns.Count-1 do
            begin
              if GridAssociado.Columns[j].FieldName = campo then
              begin
                SetLength(GridAssociado.FListaOrdenacao , length(GridAssociado.ListaOrdenacao)+1);
                GridAssociado.ListaOrdenacao[length(GridAssociado.ListaOrdenacao)-1] := campo;
                GridAssociado.columns[j].Title.Font.Style := [fsBold];
                break;
              end;
            end;
          end;

          campo := '';

        end;
    end;

    if FOrdenacao<>'' then
    begin
      if assigned(GridAssociado) then
        GridAssociado.FOrdenacao := FOrdenacao;

      if DataSource <> nil then
        case TipoOrdenacao of
          Asc : begin
                 if fordenacao = CampoSequencial then
                   TtecQuery(DataSource.DataSet).SortByField(FOrdenacao)
                 else
                   TtecQuery(DataSource.DataSet).SortByField(FOrdenacao);
                end;
          Desc: TtecQuery(DataSource.DataSet).SortDescByField(FOrdenacao);
        end;
    end
    else
    begin

      {
       NUNCA VAIR CAIR NESTA OPÇÃO
      if ListaOrdenacaoSQL <> '' then
        TtecQuery(DataSource.DataSet).SortByField(FListaOrdenacaoSQL)
      else
      }
      if DataSource <> nil then
        TtecQuery(DataSource.DataSet).SortClear;
    end;

  //end;
end;

procedure TtecDBGrid.DeslocarRegistroParaBaixo;
var
  RegistroSendoDeslocado: TBookMark;
begin
   if (CampoSequencial<>'') and
      (TtecQuery(DataSource.DataSet).FieldDefList.Find(CampoSequencial) <> nil) and
      not (TtecQuery(DataSource.DataSet).ReadOnly) then
   begin

     if Ordenacao <> CampoSequencial then
        Ordenacao := CampoSequencial;

     RegistroSendoDeslocado := TtecQuery(DataSource.DataSet).GetBookmark;
     TtecQuery(DataSource.DataSet).next;
     if not TtecQuery(DataSource.DataSet).eof and not (TtecQuery(DataSource.DataSet).RecordCount=1) then
     begin
       TtecQuery(DataSource.DataSet).Edit;
       TtecQuery(DataSource.DataSet).FieldByName(CampoSequencial).AsInteger :=
         TtecQuery(DataSource.DataSet).FieldByName(CampoSequencial).AsInteger - 1;
       TtecQuery(DataSource.DataSet).Post;

       TtecQuery(DataSource.DataSet).GotoBookmark(RegistroSendoDeslocado);
       TtecQuery(DataSource.DataSet).Edit;
       TtecQuery(DataSource.DataSet).FieldByName(CampoSequencial).AsInteger :=
         TtecQuery(DataSource.DataSet).FieldByName(CampoSequencial).AsInteger + 1;
       TtecQuery(DataSource.DataSet).Post;
     end;
     TtecQuery(DataSource.DataSet).FreeBookmark(RegistroSendoDeslocado);
     
     RefazerOrdenacaoSequencial(nil);
   end;
end;

