function TtecQuery.CheckRequiredFields(Todos: Boolean = false;
           VerificarTabelaVazia: Boolean = false;
           ExibirMensagem: Boolean = true): Boolean;
var
 k: integer;


  function inValidField(Campo: Integer): Boolean;
  var
    vConteudoCampo, vConteudoExpressao : String;
  begin
    case Fields[Campo].DataType of
      ftString  :
      begin
        vConteudoCampo := Fields[Campo].AsString;
        vConteudoExpressao := Fields[Campo].DefaultExpression;

        Result := (Trim(vConteudoCampo) = '') and not (vConteudoExpressao=quotedstr(''));
      end
      else        Result:= False;
    end
  end;

  procedure PosicionarCursor(objeto: tcomponent; nomefield: String; nomeDataSet: String);
  var
    j: Integer;
    PropInfo: PPropInfo;
    comp, compparent : tcomponent;
    vobjeto : tcomponent;

    procedure PosicionarPage;
    begin
      compparent  := comp;
      repeat
        compparent := compparent.GetParentComponent;
        if (compparent is TTabSheet) then
        begin
          if TTabSheet(compparent).TabVisible then
          begin
            if compparent.GetParentComponent is ttecpagecontrol then
              ttecpagecontrol(compparent.GetParentComponent).ActivePage := TTabSheet(compparent)
            else
              tpagecontrol(compparent.GetParentComponent).ActivePage := TTabSheet(compparent);
          end;
        end;
      until (Compparent is TForm) or (compparent = nil);
    end;

  begin
    vobjeto := objeto;
    for J := vobjeto.ComponentCount-1 downto 0 do
    begin
      comp := vobjeto.components[j];

      if comp is TDBAdvGrid then
      begin
      
        if TDBAdvGrid(comp).DataSource <> nil then
          if TDBAdvGrid(comp).DataSource.DataSet <> nil then
            if TDBAdvGrid(comp).DataSource.DataSet.Name = nomeDataSet then
            begin
              PosicionarPage;
              TDBAdvGrid(comp).SetFocus;
              TDBAdvGrid(comp).col := TDBAdvGrid(comp).ColumnByFieldName[nomefield].Index;
              break;
            end;

      end;

      if (comp.InheritsFrom(TFrame))  then
        PosicionarCursor(comp, nomefield, nomeDataSet);

      PropInfo := GetPropInfo(comp.ClassInfo, 'DataField');

      if PropInfo <> nil then
      begin
        if (GetPropValue(comp, 'DataField') = nomefield) then
          if (TDataSource(Integer(GetPropValue(Comp, 'DataSource'))).DataSet.Name = nomeDataSet)  then
          begin
            PosicionarPage;
            
//            if (GetPropValue(comp, 'Enabled') = True) then
              break;

          end;
      end;
    end;
  end;

  function Verificar: boolean;
  var
   I: Integer;

  begin
    Result := True;

    if self.active and
       (not self.IsEmpty or (self.IsEmpty and VerificarTabelaVazia)) then
    begin

      if State in dsEditModes then
        UpdateRecord;

      for I := 0 to Fields.Count - 1 do
        if Fields[I].Required and not Fields[I].ReadOnly and (Fields[I].FieldKind = fkData) and
          (Fields[I].IsNull or inValidField(I)) then
          begin
            if assigned(self.owner.owner) then
              PosicionarCursor(self.owner.owner, Fields[i].FieldName, self.name );
              
            Fields[I].FocusControl;


            if Fields[I].tag = 0 then  //Somente campos com Tag 0 impedem a grava~ção
            begin
              if ExibirMensagem then
                MensagemAviso(ctCODIGONECESSARIO + ' e o campo "' + Fields[I].DisplayLabel + #13#10 + '" não está preenchido com uma informação válida.');
              Result := False;
              break;
            end
            else
            begin
              if ExibirMensagem then
                MensagemAviso( 'O campo "' + Fields[I].DisplayLabel + #13#10 + '" não está preenchido.');
                
              result := true;
            end;
        end;
    end;
  end;

  function VerificarTabela: boolean;
  begin
    first;
    while not eof do
    begin
      if result then
      begin
        result := Verificar;
        if not result then
          break;
      end
      else
        break;
      next;
    end;
  end;

begin
  result := true;
  if self.active then
  begin

    if todos then
    begin
      if self.MasterSource <> nil then
      begin
        self.MasterSource.DataSet.first;
        while not self.MasterSource.DataSet.eof do
        begin
          if result then
          begin
            result := VerificarTabela;
            if not result then
              break;
          end
          else
            break;
          self.MasterSource.DataSet.next;
        end;
      end
      else
        result := VerificarTabela;
    end
    else
    begin
      if result then
        result := Verificar;
    end;
  end;
end;

