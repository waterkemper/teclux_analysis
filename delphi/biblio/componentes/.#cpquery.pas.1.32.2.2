procedure TtecQuery.SetText(Sender: TField;
                      const Text:   String);
begin
   If DataEmBranco(Text) Then
      Sender.AsString := ''
   Else
      Sender.AsString := Text
end;

procedure TtecQuery.DoAfterOpen;
var NN: Integer;
begin
   inherited;

   self.Options := [doAutoFillDefs];

   For NN:=0 to FieldList.Count-1 do
   begin
     case FieldList[NN].DataType of
     {ftInteger,} ftWord,ftCurrency,ftFloat:
       If (TNumericField(FieldList[NN]).DisplayFormat = '') Then begin
          FieldList[NN].Alignment := taRightJustify;
          Case FieldList[NN].DataType of
            ftInteger,
            ftWord,
            ftSmallInt: TNumericField(FieldList[NN]).DisplayFormat := '0';
            ftCurrency,
            ftFloat:    TNumericField(FieldList[NN]).DisplayFormat := '0.00';
          end;
       end;
     ftDate:
       If (TDateField(FieldList[NN]).EditMask = '') Then begin
          FieldList[NN].Alignment := taCenter;
          TDateField(FieldList[NN]).EditMask := '99/99/9999;1; ';
          TDateField(FieldList[NN]).OnSetText := SetText;
       end;
     ftTime:
       If (TTimeField(FieldList[NN]).EditMask = '') Then begin
          FieldList[NN].Alignment := taCenter;
          TTimeField(FieldList[NN]).EditMask := '99:99;1; ';
          TTimeField(FieldList[NN]).OnSetText := SetText;
       end;
     end;
   end;

   if assigned(FAfter_Open) then
     FAfter_Open(self);
end;

