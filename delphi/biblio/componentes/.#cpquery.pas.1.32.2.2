const
  CheckTypeSizesSmaller = [ftString, ftFixedChar, ftWideString];
begin
  with Field do
  begin
    if ((DataType in CheckTypeSizesSmaller) and (Size <> FieldDef.Size) and not ReadOnly) then
      Size := FieldDef.Size;
  end;
end;
