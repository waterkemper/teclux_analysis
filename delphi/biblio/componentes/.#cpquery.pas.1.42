procedure TtecQuery.CalcularMD5(pIdentifier: String;
  pListFieldNames: String; pKey: String;
  pAllRecords: Boolean; Salvar: Boolean);
var
  I, J, k: Integer;
  Buffer : string;
  RecordData: PRecordData;
  FieldDesc: PFieldDesc;
  Stream: TFileStream;
  ValordoCampo : Variant;
  ListadeCampos: TStringList;
  vNomedoCampo: String;
  sListFieldNames : TStringList;
//  vExist : Boolean;

//  tempT_MD5 : T_MD5;

begin

  sListFieldNames := tStringlist.create;
  sListFieldNames.Delimiter := ',';

  ExtractStrings([','], [','], pchar(pListFieldNames), sListFieldNames);


  Buffer:='';
  if not pAllRecords then
  begin
    for i := 0 to sListFieldNames.count-1 do
      Buffer := Buffer + self.fieldbyname(sListFieldNames[i]).asString;
  end
  else
  begin
    for I := 0 to self.SqlBuffer.Count-1 do
    begin

      if I > 0 then
        Buffer := Buffer + #13#10;

      RecordData := self.SqlBuffer[I];

      for k := 0 to sListFieldNames.count-1 do
      begin
        for J := 0 to self.SqlBuffer.SqlFields.Count-1 do
        begin
          FieldDesc := self.SqlBuffer.SqlFields[J];
          if (uppercase(FieldDesc.FieldObj.FieldName) = uppercase(sListFieldNames[k])) then
          begin
            Valordocampo := '';

            if not (FieldDesc.FieldType in [ftInteger, ftSmallInt, ftFloat, ftAutoInc, ftCurrency{$IFNDEF VER100}, ftLargeInt{$ENDIF}, ftBCD])
               and not self.SqlBuffer.GetFieldNull(FieldDesc, RecordData) then
              Valordocampo := ZSqlTypes.StringToSql(self.SqlBuffer.GetField(FieldDesc, RecordData))
            else
              Valordocampo :=  self.SqlBuffer.GetField(FieldDesc, RecordData);

            Buffer := Buffer + ValordoCampo;
            break;
          end;

        end;
      end;
    end;
  end;

//  vExist := False;
  md5 := md5_(buffer);

                {
  if MD5Itens.Count <> 0 then
  begin
    for i :=0 to MD5Itens.Count-1 do
    begin
      if MD5Itens.Items[i].identifier = pIdentifier then
      begin
        MD5Itens.Items[i].ValorMD5 := buffer;
        vExist := true;
      end;
    end;
  end;

  if not vExist then
  begin

    with MD5Itens.New do
    begin
      identifier := pIdentifier ;
      ListFieldNames := pListFieldNames;
      key := pkey;
      AllRecords := pAllRecords;
      ValorMD5   := buffer;
    end;

  end;
  }

  if Salvar then
    SalvarValorMD5(pIdentifier, pListFieldNames, pkey, md5, pallrecords);

end;



{ T_MD5 }

constructor T_MD5.Create;
begin
  inherited Create;
end;

{ T_MD5Itens }


{
function T_MD5Itens.Add(AObject: T_MD5): integer;
begin
  Result := inherited Add(AObject);
end;
}

function T_MD5Itens.GetItem(Index: integer): T_MD5;
begin
  Result := (inherited GetItem(index) as T_MD5);

end;

{
procedure T_MD5Itens.Insert(Index: integer; AObject: T_MD5);
begin
  inherited Insert(index, AObject);
end;
}

function T_MD5Itens.New: T_MD5;
begin
  Result := T_MD5.Create;
  Add(Result);
end;

procedure T_MD5Itens.SetItem(Index: integer; const Value: T_MD5);
begin
  inherited SetItem(index, Value);
end;


{
procedure TtecQuery.SetMD5Itens(const Value: T_MD5Itens);
begin
  FMD5Itens.Assign(Value);
end;
}


function TtecQuery.ExisteDiferencaMD5(pIdentifier, pkey: String): Boolean;
var
i: integer;
vMD5 : String;
vExist : Boolean;
tmd5 : T_MD5;

begin
  result := false;

  AbrirMD5(pIdentifier, pkey);
  if qryMD5.RecordCount = 1 then
  begin
    CalcularMD5(pIdentifier,
                qryMD5.fieldbyname('listadecampos').asString,
                pkey,
                qryMD5.fieldbyname('todos').asBoolean, false);
    result := md5 <> qryMD5.fieldbyname('valormd5').asString;
  end;

end;

procedure TtecQuery.SalvarValorMD5(pIdentifier, pListFieldNames, pkey, pValorMD5: String; pallrecords: Boolean);
{var
  qryMD5: TtecQuery;}
begin
  AbrirMD5(pIdentifier, pkey);
  if qryMD5.RecordCount = 1 then
  begin
    qryMD5.edit;
    qrymd5.fieldbyname('valormd5').asString := pValorMD5;
    qrymd5.post;
  end
  else
  begin
    qryMD5.append;
    qryMD5.fieldbyname('chave').asString := pkey;
    qryMD5.fieldbyname('identificador').asString := pidentifier;
    qrymd5.fieldbyname('valormd5').asString := pvalormd5;
    qrymd5.fieldbyname('listadecampos').asString := pListFieldNames;
    qrymd5.fieldbyname('todos').asBoolean := pAllRecords;
    qrymd5.post;
  end
end;

procedure TtecQuery.AbrirMD5(pIdentifier, pkey: String);
begin
  if not assigned (qryMD5) then
  begin
    qryMD5 := TtecQuery.Create(self);
    qryMD5.Database := self.Database;
    qryMD5.Transaction := self.Transaction;
    qryMD5.requestlive := true;
    qryMD5.cachedupdates := false;
    qryMD5.Sql.Text := 'select md5.* from md5 where md5.chave = :chave and md5.identificador = :identificador ';
  end;

  qryMD5.close;
  qryMD5.parambyname('chave').asString := pkey;
  qryMD5.parambyname('identificador').asString := pIdentifier;
  qryMD5.Open;
end;

end.



