procedure TtecQuery.SaveToFile(FileName: string; AcrescentaraoArquivo: Boolean; SomenteVisiveis: Boolean; CamposEspecificos: String;
                               Separador: String = '"'; Delimitador: String = ';'; incluirCabecalho: boolean = true;
                               NuloQuandoNULL: Boolean = false; BooleanExtenso: boolean = false; FalseQuandoBooleanNULL : boolean = false;
                               ContratolarCaracteresEspeciais: boolean = false;
                               DelimitadornoUltimoCampo: boolean = false;
                               DecimalehVirgual: boolean = false;
                               FormatoData: String = 'yyyy-mm-dd');
{ CamposEspecificos : formato  '"nomedocampo1","nomedocampo2"'}
var
  I, J, k: Integer;
  Buffer : string;
  RecordData: PRecordData;
  FieldDesc: PFieldDesc;
  Stream: TFileStream;
  ValordoCampo : Variant;
  ListadeCampos: TStringList;
  vNomedoCampo: String;

begin
  QueryRecords(True);

// itSDS Feldnamen als Überschrift ausgeben !!

  if CamposEspecificos <> '' then
  begin
    ListadeCampos := TStringList.Create;
    vNomedoCampo := '';
    for i:=1 to length(CamposEspecificos) do
    begin
      if (CamposEspecificos[i] <> '"') and
         (CamposEspecificos[i] <> ';') then
        vNomedoCampo := vNomedoCampo + CamposEspecificos[i];

      if (CamposEspecificos[i] = ';') or (i = length(CamposEspecificos)-1) then
      begin
        ListadeCampos.Append(vnomedocampo);
        vNomedoCampo := '';
      end;
    end;
  end;

  self.Options := [{doHourGlass,} doQueryAllRecords, doAutoFillDefs];

  try

    if not AcrescentaraoArquivo then
    begin
      DeleteFile(FileName);
      Stream := TFileStream.Create(FileName, fmCreate);
    end
    else
    begin
      if fileexists(Filename) then
        Stream := TFileStream.Create(FileName, fmOpenWrite)
      else
        Stream := TFileStream.Create(FileName, fmCreate);
    end;

    if self.SqlBuffer.Count > 0 then
    begin
      if incluirCabecalho then
      begin
        if CamposEspecificos<>'' then
        begin
          Buffer := '';
          for i := 0 to ListadeCampos.count-1 do
          begin
            if i > 0 then
              Buffer := Buffer + Delimitador;

            for J := 0 to self.FieldCount-1 do
            begin
              if (uppercase(self.Fields[j].FieldName) = uppercase(ListadeCampos[i])) then
              begin
                Buffer := Buffer + separador + self.Fields[J].FieldName + separador;
                break;
              end;
            end;
          end;

          if DelimitadornoUltimoCampo then
            Buffer := Buffer + Delimitador;

          Buffer := Buffer + #13#10;

          Stream.Write(PChar(Buffer)^, Length(Buffer));
        end
        else
        begin

          Buffer := '';
          for J := 0 to self.FieldCount-1 do begin
            if (self.Fields[j].visible and SomenteVisiveis) or not SomenteVisiveis  then
            begin
              if J > 0 then
                Buffer := Buffer + Delimitador;
              Buffer := Buffer + separador + self.Fields[J].FieldName + separador;
            end;
          end;

          if DelimitadornoUltimoCampo then
            Buffer := Buffer + Delimitador;

          Buffer := Buffer + #13#10;
          Stream.Write(PChar(Buffer)^, Length(Buffer));
        end;
      end;
    end;


    for I := 0 to self.SqlBuffer.Count-1 do
    begin
      if CamposEspecificos <> '' then
      begin
        Buffer := '';
        RecordData := self.SqlBuffer[I];
        if I > 0 then Buffer := Buffer + #13#10;

        for k := 0 to ListadeCampos.count-1 do
        begin
          if k > 0 then
            Buffer := Buffer + Delimitador;

          for J := 0 to self.SqlBuffer.SqlFields.Count-1 do
          begin
            FieldDesc := self.SqlBuffer.SqlFields[J];
            if (uppercase(FieldDesc.FieldObj.FieldName) = uppercase(ListadeCampos[k])) then
            begin

              Valordocampo := '';
              if not (FieldDesc.FieldType in [ftInteger, ftSmallInt, ftFloat, ftAutoInc, ftCurrency{$IFNDEF VER100}, ftLargeInt{$ENDIF}, ftBCD])
                 and not self.SqlBuffer.GetFieldNull(FieldDesc, RecordData) then
              begin
                Valordocampo := ZSqlTypes.StringToSql(self.SqlBuffer.GetField(FieldDesc, RecordData));

                if BooleanExtenso and (FieldDesc.FieldType in [ftboolean])  then
                begin
                  if ValordoCampo = 'f' then
                    ValordoCampo := 'False'
                  else
                    ValordoCampo := 'True';
                end;

                if (FormatoData <> 'yyyy-mm-dd') and (FieldDesc.FieldType in [ftdate, ftdatetime])  then
                begin
                  if (ValordoCampo <> '') and (valordoCampo <> 'NULL') then
                    ValordoCampo := formatdatetime(formatodata, strtodate(copy(Valordocampo,9,2)+'/'+copy(ValordoCampo,6,2)+'/'+copy(ValordoCampo,1,4)));
                end;

                if ContratolarCaracteresEspeciais and  (FieldDesc.FieldType in [ftString])  then
                  ValordoCampo := TagControls(ValordoCampo);

              end
              else
              begin
                Valordocampo :=  self.SqlBuffer.GetField(FieldDesc, RecordData);

                if DecimalehVirgual and (FieldDesc.FieldType in [ftFloat, ftCurrency]) then
                  ValordoCampo := trocar(Valordocampo,'.',',');

                if FalseQuandoBooleanNULL and (FieldDesc.FieldType in [ftBoolean]) and (ValordoCampo='NULL') then
                  ValordoCampo := 'False';
              end;

              if (ValordoCampo = 'NULL') and NuloQuandoNULL and self.SqlBuffer.GetFieldNull(FieldDesc, RecordData) then
                Valordocampo := '';

              Buffer := Buffer + Separador + ValordoCampo + Separador;
              break;
            end;
          end;
        end;
      end
      else
      begin

        Buffer := '';
        RecordData := self.SqlBuffer[I];
        if I > 0 then Buffer := Buffer + #13#10;

        for J := 0 to self.SqlBuffer.SqlFields.Count-1 do
        begin
          FieldDesc := self.SqlBuffer.SqlFields[J];
          if (FieldDesc.FieldObj.visible and SomenteVisiveis) or not SomenteVisiveis then
          begin

            if J > 0 then
              Buffer := Buffer + Delimitador;

            Valordocampo := '';

            if not (FieldDesc.FieldType in [ftInteger, ftSmallInt, ftFloat, ftAutoInc, ftCurrency{$IFNDEF VER100}, ftLargeInt{$ENDIF}, ftBCD])
               and not self.SqlBuffer.GetFieldNull(FieldDesc, RecordData) then
            begin
              Valordocampo := ZSqlTypes.StringToSql(self.SqlBuffer.GetField(FieldDesc, RecordData));

              if BooleanExtenso and (FieldDesc.FieldType in [ftboolean])  then
              begin
                if ValordoCampo = 'f' then
                  ValordoCampo := 'False'
                else
                  ValordoCampo := 'True';
              end;

              if (FormatoData <> 'yyyy-mm-dd') and (FieldDesc.FieldType in [ftdate, ftdatetime])  then
              begin
                if (ValordoCampo <> '') and (valordoCampo <> 'NULL') then
                  ValordoCampo := formatdatetime(formatodata, strtodate(copy(Valordocampo,9,2)+'/'+copy(ValordoCampo,6,2)+'/'+copy(ValordoCampo,1,4)));
              end;

            end
            else
              Valordocampo :=  self.SqlBuffer.GetField(FieldDesc, RecordData);

            if (ValordoCampo = 'NULL') and NuloQuandoNULL and self.SqlBuffer.GetFieldNull(FieldDesc, RecordData) then
              Valordocampo := '';

            Buffer := Buffer + Separador + ValordoCampo + Separador;
          end;
        end;

      end;

      if DelimitadornoUltimoCampo then
        Buffer := Buffer + Delimitador;

      Stream.Write(PChar(Buffer)^, Length(Buffer));
    end;

  finally

    stream.free;
    self.Options := [doAutoFillDefs];

  end;
end;



