procedure TtecQuery.MarcarRegistros(
  DS: TClientDataSet;
  CampoMarcar: TBooleanField;
  Marcando, MarcarTodos, DesabilitarControles: Boolean);

  var Pos: TBookmark;
    I, J:   Integer;

begin

   if not DS.IsEmpty then
   begin

      if not MarcarTodos then
      begin
        if DesabilitarControles then
          DS.DisableControls;

        DS.Edit;
        CampoMarcar.AsBoolean:= not CampoMarcar.AsBoolean;
        DS.Post;

        if CampoMarcar.AsBoolean then
          Inc(FQtdeMarcados)
        else Dec(FQtdeMarcados);

        if DesabilitarControles then
          DS.EnableControls;

      end
      else
      begin
         FQtdeMarcados:= 0;
         Pos := DS.GetBookmark;
         try
            if DesabilitarControles then
              DS.DisableControls;
            DS.First;
            for I:= 1 to DS.RecordCount do
            begin
                if     (Marcando and not CampoMarcar.AsBoolean) or
                   (not Marcando and     CampoMarcar.AsBoolean) then
                begin
                   DS.Edit;
                   CampoMarcar.AsBoolean:= Marcando;
                   DS.Post;
                end;

                if CampoMarcar.AsBoolean then Inc(FQtdeMarcados);
                DS.Next;

            end;
         finally
            DS.GotoBookmark(Pos);
            DS.FreeBookmark(Pos);
            if DesabilitarControles then
              DS.EnableControls;
         end;
      end;
   end;

end;


