procedure TtecQuery.OcultarColunasGrid;
  var
  i,j,k: Integer;
  PropInfo: PPropInfo;
  comp, compparent : tcomponent;
  vobjeto : tcomponent;
  visivel : Boolean;
  vNomeCAmpo : String;

begin

  vObjeto := self.owner.owner;
  for J := vobjeto.ComponentCount - 1 downto 0 do
  begin
    comp := vobjeto.components[j];
    if (comp is TtecDBGrid) then
    begin
      if (TtecDBGrid(comp).datasource.dataset.name = self.name) and
         TtecDBGrid(comp).ShowWhenFieldInvisible AND
         (TtecDBGrid(comp).datasource.dataset.recordcount<>0) then
      begin
        for i:=0 to TtecDBGrid(comp).columns.count -1 do
        begin
//          vNomeCampo := TtecDBGrid(comp).columns[i].fieldname;
//          for k:=0 to self.datasource.dataset.fieldcount
          visivel := self.fieldbyname(TtecDBGrid(comp).columns[i].fieldname).visible;
          TtecDBGrid(comp).columns[i].visible := visivel;
        end;
      end;
    end;
  end;

end;

procedure TtecQuery.AtivarOrdenacao;
begin
  if v_ordenacao <> '' then
  begin
    if vstAscending then
      self.sortbyfield(v_ordenacao)
    else
      self.SortDescByField(v_ordenacao);
  end;
end;

procedure TtecQuery.DesativarOrdenacao;
var
i: integer;
begin

  v_ordenacao := '';
  for i:=0 to TZDataset(self).SqlBuffer.SortFieldCount - 1 do
    v_ordenacao := v_ordenacao + TZDataset(self).fields[TZDataset(self).SqlBuffer.SortFields[i]].FieldName + ',';

  if v_ordenacao <> '' then
  begin
    if (Copy(v_ordenacao,length(v_ordenacao),1)=',') then
      system.delete(v_ordenacao, length(v_ordenacao),1);

    vstAscending := self.SQLBuffer.SortType = stAscending;

    self.SortClear;
    self.SqlBuffer.SortFieldCount := 0;

  end;


end;

procedure TtecQuery.GuardarRegistroAtual(DesligarControles: Boolean; LigarControles: Boolean = False);
begin
 RegistroAtual_ := self.GetBookmark;
 if DesligarControles then
   self.DisableControls;

 if LigarControles then
   self.EnableControls;

end;

procedure TtecQuery.VoltarRegistro;
begin
  if self.Bookmarkvalid(RegistroAtual_) then
  begin
    self.GotoBookmark(RegistroAtual_);
    self.FreeBookmark(RegistroAtual_);
  end;

  self.EnableControls;
end;


{
const
  CheckTypeSizesSmaller = [ftString, ftFixedChar, ftWideString];
begin
  with Field do
  begin
    if ((DataType in CheckTypeSizesSmaller) and (Size <> FieldDef.Size) and not ReadOnly) then
      Size := FieldDef.Size;
  end;
end;
}

procedure TtecQuery.CheckFieldCompatibility(Field: TField;
  FieldDef: TFieldDef);
var
  vDisplayWidth: integer;

const
  CheckTypeSizesSmaller = [ftString, ftFixedChar, ftWideString];

begin
  inherited;

  with Field do
  begin
    if ((DataType in CheckTypeSizesSmaller) and (Size <> FieldDef.Size) and not ReadOnly) then
    begin
      vDisplayWidth :=  DisplayWidth;
      Size := FieldDef.Size;
      DisplayWidth := vDisplayWidth;
    end;
  end;

end;

