    property CODIGOS_DE_ERRO: string read fCODIGOS_DE_ERRO write fCODIGOS_DE_ERRO;         //CÓDIGOS DE ERRO NÃO 254 283 X(30)
    property BRANCOS: string read fBRANCOS write fBRANCOS;                                 //COMPLEMENTO DO REGISTRO NÃO 284 7741 X(458)
