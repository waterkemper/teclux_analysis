#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = ExportarExcel.bpl Build_d7.bpl frx.bpl tecsoft6.bpl tecsoftd6.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

Build_d7.bpl: N:\projetos\terceiros\FastReport 4\Build_d7.dpk
  $(DCC)

frx.bpl: N:\instalacao\terceiros\fast\source\frx.dpk
  $(DCC)

tecsoft6.bpl: tecsoft6.dpk
  $(DCC)

tecsoftd6.bpl: tecsoftd6.dpk
  $(DCC)

ExportarExcel.bpl: ..\terceiros\excelExport\ExportarExcel.dpk
  $(DCC)


