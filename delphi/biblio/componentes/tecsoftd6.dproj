<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{7307EE02-9A0B-41A1-B930-8CE232974283}</ProjectGuid>
        <MainSource>tecsoftd6.dpk</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <TargetedPlatforms>0</TargetedPlatforms>
        <AppType>Package</AppType>
        <FrameworkType>None</FrameworkType>
        <ProjectVersion>15.4</ProjectVersion>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_MapFile>3</DCC_MapFile>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <DCC_UNSAFE_TYPE>true</DCC_UNSAFE_TYPE>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
        <VerInfo_MajorVer>0</VerInfo_MajorVer>
        <VerInfo_Locale>1046</VerInfo_Locale>
        <DCC_DebugInformation>1</DCC_DebugInformation>
        <GenDll>true</GenDll>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_AssertionsAtRuntime>false</DCC_AssertionsAtRuntime>
        <DCC_N>true</DCC_N>
        <DCC_Description>Tecsoft - componentes</DCC_Description>
        <DCC_K>false</DCC_K>
        <DCC_S>false</DCC_S>
        <VerInfo_MinorVer>9</VerInfo_MinorVer>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <DCC_UNSAFE_CAST>true</DCC_UNSAFE_CAST>
        <DCC_F>false</DCC_F>
        <DCC_BplOutput>c:\windows\system</DCC_BplOutput>
        <DCC_IOChecking>false</DCC_IOChecking>
        <GenPackage>true</GenPackage>
        <DCC_DcpOutput>$(DELPHI)\Lib</DCC_DcpOutput>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_UsePackage>vcl;rtl;vclx;VclSmp;vclshlctrls;dbrtl;adortl;vcldb;qrpt;bdertl;vcldbx;dsnap;cds;bdecds;teeui;teedb;tee;teeqr;ibxpress;visualclx;visualdbclx;vclie;xmlrtl;inet;inetdbbde;inetdbxpress;inetdb;nmfast;dbexpress;dbxcds;indy;dclOffice2k;ACBrDiversos;ACBrComum;ACBr_TEFD;synapse;ACBr_Boleto;ZPgSql6;ZDbware6;ZCommon6;VKDBF6;RLibWinD6clx;ACBrSerial;ACBr_SPED;ACBr_PAF;RfGridComponent;$(DCC_UsePackage)</DCC_UsePackage>
        <DCC_UNSAFE_CODE>true</DCC_UNSAFE_CODE>
        <SanitizedProjectName>tecsoftd6</SanitizedProjectName>
        <DCC_E>false</DCC_E>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <VerInfo_Keys>CompanyName=TecSoft Tecnologia S/C;FileDescription=Emissão de livros fiscais;FileVersion=0.9.0.0;InternalName=livrosfiscais;LegalCopyright=;LegalTrademarks=;OriginalFilename=livrosfiscais.bpl;ProductName=tecLUX;ProductVersion=0.9;Comments=</VerInfo_Keys>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <Icon_MainIcon>tecsoftd6_Icon.ico</Icon_MainIcon>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="tecsoft6.dcp"/>
        <DCCReference Include="rgtecsoft.pas"/>
        <DCCReference Include="peparameters.pas"/>
        <DCCReference Include="ceeditioncontrolvalidationeditor.pas"/>
        <DCCReference Include="dfeditioncontrolvalidation.pas">
            <Form>dfmEditionControlValidation</Form>
        </DCCReference>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">tecsoftd6.dpk</Source>
                </Source>
                <Language>
                    <Language Name="RootDir">..\..\..\..\projetos.vcl\biblio\componentes\</Language>
                </Language>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Android">False</Platform>
                <Platform value="iOSDevice">False</Platform>
                <Platform value="iOSSimulator">False</Platform>
                <Platform value="OSX32">False</Platform>
                <Platform value="Win32">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
