package tecsoftk;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'tecsoft'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  visualclx,
  visualdbclx,
  indy,
  baseclx,
  ZPgSqlK,
  ZDbwareK,
  ZCommonK,
  frxk;

contains
  biblio in '../biblio.pas',
  ctconstantes in '../ctconstantes.pas',
  clfinanceira in '../clfinanceira.pas',
  clusuario in '../clusuario.pas',
  constants in 'constants.pas',
  cpcep in 'cpcep.pas',
  cpcnpj in 'cpcnpj.pas',
  cpcpf in 'cpcpf.pas',
  cpdata in 'cpdata.pas',
  cpdatabase in 'cpdatabase.pas',
  cpdatasource in 'cpdatasource.pas',
  cpdbdiames in 'cpdbdiames.pas',
  cpdbfindcontrols in 'cpdbfindcontrols.pas',
  cpdbmemo in 'cpdbmemo.pas',
  cpdbtext in 'cpdbtext.pas',
  cpdocumento in 'cpdocumento.pas',
  cpdoubledts in 'cpdoubledts.pas',
  cpeditioncontrolvalidation in 'cpeditioncontrolvalidation.pas',
  cpfone in 'cpfone.pas',
  cpnotify in 'cpnotify.pas',
  cpnumero in 'cpnumero.pas',
  cppagecontrol in 'cppagecontrol.pas',
  cpquery in 'cpquery.pas',
  cptable in 'cptable.pas',
  cptexto in 'cptexto.pas',
  cptransact in 'cptransact.pas',
  cpdbcombobox in 'cpdbcombobox.pas',
  cpdbradiogroup in 'cpdbradiogroup.pas',
  cpcpfcnpj in 'cpcpfcnpj.pas',
  clparametrossistema in '../clparametrossistema.pas',
  cpdbmesano in 'cpdbmesano.pas',
  clserial in '../clserial.pas',
  cpdblookupcombobox in 'cpdblookupcombobox.pas',
  cpdbgrid in 'cpdbgrid.pas',
  cpcpfcnpj2 in 'cpcpfcnpj2.pas',
  fmmensagemsimnaoopcaocancela in '../../repositorio/fmmensagemsimnaoopcaocancela.pas' {frmMensagemSimNaoOpcaoCancela},
  cpmascara in 'cpmascara.pas',
  cpdbdata in 'cpdbdata.pas',
  Dates in 'Dates.pas',
  QMonthCalendar in 'QMonthCalendar.pas',
  cpdbspinedit in 'cpdbspinedit.pas';

end.
