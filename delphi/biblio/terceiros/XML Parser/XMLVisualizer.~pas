    FBackgroundColorName: String;
    FBorderColorName: String;
    FColorItemName: String;
    FDefaultColorName: String;
    FPaintBox: TPaintBox;
    FOldPaintBoxOnPaint : TNotifyEvent;
    FConnectionLineName: String;
