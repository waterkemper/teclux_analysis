    function  IsChildOf(Item : TXMLVisualItemData) : Boolean;
    procedure MoveTo(Item : TXMLVisualItemData);
    function  IndexOf(Item : TXMLVisualItemData) : Integer;
    procedure Delete(Index : Integer);
    procedure Clear;
    
