  object qryImprimirOperacoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryImprimirOperacoesAfterScroll
    OnNewRecord = qryOperacoesNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'datainclusao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dataalteracao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FluxogramaOperacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'InclusaoOperacoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AlteracaoOperacoes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListarSetup'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListarPlano'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListarBloqueio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CodigoOperacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select o.* from'
      '('
      'select o.*,'
      ''
      '       (select ol.trigger_user'
      '        from operacoes_log ol'
      '        where trigger_mode = '#39'INSERT'#39
      '          and ol.codigo = o.codigo'
      '          %datainclusao'
      '        order by ol.trigger_changed desc limit 1'
      '       )'
      #9'   as UsuarioInclusao,'
      ''
      
        '       (select cast(to_char(ol.trigger_changed, '#39'DD/MM/YY HH24:M' +
        'I:SS'#39') as varchar(20))'
      '        from operacoes_log ol'
      '        where trigger_mode = '#39'INSERT'#39
      '          and ol.codigo = o.codigo'
      '          %datainclusao'
      '        order by ol.trigger_changed desc limit 1'
      '       )'
      #9'   as DataHoraInclusao,'
      ''
      ''
      '      ('
      '      SELECT selecao.usuarioalteracao FROM'
      '      ('
      '           ('
      '           select ol.trigger_user as usuarioAlteracao,'
      '            ol.trigger_changed as dataHoraAlteracao'
      '             from operacoes_log ol'
      '              where ol.codigo = o.codigo'
      '               %dataalteracao'
      '                and ol.trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and ol.trigger_tuple = '#39'new'#39
      '               order by ol.trigger_changed desc limit 1'
      '            )'
      '        union all'
      '          ('
      '            select fol.trigger_user as usuarioAlteracao,'
      '             fol.trigger_changed as dataHoraAlteracao'
      '             from falhasoperacoes_log fol'
      '              where fol.operacao = o.codigo'
      '              %dataalteracao'
      '               and fol.trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and fol.trigger_tuple = '#39'new'#39
      '              order by fol.trigger_changed desc limit 1'
      '              )'
      #9#9'union all'
      '          ('
      '            select oml.trigger_user as usuarioAlteracao,'
      '             oml.trigger_changed as dataHoraAlteracao'
      '             from operacoesmaquinas_log oml'
      '              where oml.operacao = o.codigo'
      '              %dataalteracao'
      '               and oml.trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and oml.trigger_tuple = '#39'new'#39
      '              order by oml.trigger_changed desc limit 1'
      '              )'
      #9#9'union all'
      '          ('
      '            select osl.trigger_user as usuarioAlteracao,'
      '             osl.trigger_changed as dataHoraAlteracao'
      '             from operacoessetup_log osl'
      '              where osl.operacao = o.codigo'
      '              %dataalteracao'
      '               and osl.trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and osl.trigger_tuple = '#39'new'#39
      '              order by osl.trigger_changed desc limit 1'
      '              )'
      '     '#9'union all'
      '          ('
      '            select pcl.trigger_user as usuarioAlteracao,'
      '             pcl.trigger_changed as dataHoraAlteracao'
      '             from processoscontrole_log pcl'
      '              where pcl.operacao = o.codigo'
      '              %dataalteracao'
      '               and pcl.trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and pcl.trigger_tuple = '#39'new'#39
      '              order by pcl.trigger_changed desc limit 1'
      '              )'
      #9#9#9
      '      ) AS selecao'
      '        order by dataHoraAlteracao desc limit 1)'
      #9#9'as usuarioalteracao,'
      ''
      ''
      ''
      '       ('
      '       select selecao.DataHoraAlteracao from'
      '       ('
      ''
      
        '           (select cast(to_char(ol.trigger_changed, '#39'DD/MM/YY HH' +
        '24:MI:SS'#39') as varchar(20)) as datahoraalteracao'
      '              from operacoes_log ol'
      '               where ol.codigo = o.codigo'
      '                %dataalteracao'
      '                and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and trigger_tuple = '#39'new'#39
      '               order by ol.trigger_changed desc limit 1'
      '             )'
      '           union all'
      
        '           (select cast(to_char(fol.trigger_changed, '#39'DD/MM/YY H' +
        'H24:MI:SS'#39') as varchar(20))as datahoraalteracao'
      '              from falhasoperacoes_log fol'
      '               where fol.operacao = o.codigo'
      '                %dataalteracao'
      '                and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and trigger_tuple = '#39'new'#39
      '               order by fol.trigger_changed desc limit 1'
      '             )'
      #9#9#9' union all'
      
        '           (select cast(to_char(oml.trigger_changed, '#39'DD/MM/YY H' +
        'H24:MI:SS'#39') as varchar(20))as datahoraalteracao'
      '              from operacoesmaquinas_log oml'
      '               where oml.operacao = o.codigo'
      '                %dataalteracao'
      '                and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and trigger_tuple = '#39'new'#39
      '               order by oml.trigger_changed desc limit 1'
      '             )'
      #9#9#9' union all'
      
        '           (select cast(to_char(osl.trigger_changed, '#39'DD/MM/YY H' +
        'H24:MI:SS'#39') as varchar(20))as datahoraalteracao'
      '              from operacoessetup_log osl'
      '               where osl.operacao = o.codigo'
      '                %dataalteracao'
      '                and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and trigger_tuple = '#39'new'#39
      '               order by osl.trigger_changed desc limit 1'
      '             )'
      #9#9#9' union all'
      
        '           (select cast(to_char(pcl.trigger_changed, '#39'DD/MM/YY H' +
        'H24:MI:SS'#39') as varchar(20))as datahoraalteracao'
      '              from processoscontrole_log pcl'
      '               where pcl.operacao = o.codigo'
      '                %dataalteracao'
      '                and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and trigger_tuple = '#39'new'#39
      '               order by pcl.trigger_changed desc limit 1'
      '             )'
      '      )as selecao'#9'order by datahoraalteracao limit 1)'
      #9'  as DataHoraAlteracao,'
      ''
      ''
      '       (select selecao.operacao from'
      '        ('
      
        '        (select cast(case when trigger_mode = '#39'INSERT'#39' THEN '#39'INC' +
        'LUS'#195'O'#39
      
        '                                            else '#39'ALTERA'#199#195'O'#39' end' +
        ' as varchar(10)) as operacao,'
      '              ol.trigger_changed as dataHoraAlteracao'
      '            from operacoes_log ol'
      '             where ol.codigo = o.codigo'
      '             %dataalteracao'
      '              and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '              and trigger_tuple = '#39'new'#39
      '             order by ol.trigger_changed desc limit 1'
      '            )'
      '          union all'
      
        '          (select cast(case when trigger_mode = '#39'INSERT'#39' THEN '#39'I' +
        'NCLUS'#195'O'#39
      
        '                                            else '#39'ALTERA'#199#195'O'#39' end' +
        ' as varchar(10)) as operacao,'
      '              fol.trigger_changed as dataHoraAlteracao'
      '            from falhasoperacoes_log fol'
      '             where fol.operacao = o.codigo'
      '            %dataalteracao'
      '              and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '              and trigger_tuple = '#39'new'#39
      '             order by fol.trigger_changed desc limit 1'
      '            )'
      #9#9#9'union all'
      
        '          (select cast(case when trigger_mode = '#39'INSERT'#39' THEN '#39'I' +
        'NCLUS'#195'O'#39
      
        '                                            else '#39'ALTERA'#199#195'O'#39' end' +
        ' as varchar(10)) as operacao,'
      '              oml.trigger_changed as dataHoraAlteracao'
      '            from operacoesmaquinas_log oml'
      '             where oml.operacao = o.codigo'
      '            %dataalteracao'
      '              and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '              and trigger_tuple = '#39'new'#39
      '             order by oml.trigger_changed desc limit 1'
      '            )'
      #9#9#9'union all'
      
        '          (select cast(case when trigger_mode = '#39'INSERT'#39' THEN '#39'I' +
        'NCLUS'#195'O'#39
      
        '                                            else '#39'ALTERA'#199#195'O'#39' end' +
        ' as varchar(10)) as operacao,'
      '              osl.trigger_changed as dataHoraAlteracao'
      '            from operacoessetup_log osl'
      '             where osl.operacao = o.codigo'
      '            %dataalteracao'
      '              and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '              and trigger_tuple = '#39'new'#39
      '             order by osl.trigger_changed desc limit 1'
      '            )'
      #9#9#9'union all'
      
        '          (select cast(case when trigger_mode = '#39'INSERT'#39' THEN '#39'I' +
        'NCLUS'#195'O'#39
      
        '                                            else '#39'ALTERA'#199#195'O'#39' end' +
        ' as varchar(10)) as operacao,'
      '              pcl.trigger_changed as dataHoraAlteracao'
      '            from processoscontrole_log pcl'
      '             where pcl.operacao = o.codigo'
      '            %dataalteracao'
      '              and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '              and trigger_tuple = '#39'new'#39
      '             order by pcl.trigger_changed desc limit 1'
      '            )'
      '        )as selecao order by dataHoraAlteracao desc limit 1)'
      #9#9'as operacao,'
      ''
      ''
      '       (select selecao.tabela'
      '        FROM'
      '        ('
      '        ('
      '         select cast('#39'OPERA'#199#213'ES'#39' as varchar(30)) as tabela,'
      '                ol.trigger_changed as dataHoraAlteracao'
      '         from operacoes_log ol'
      '          where ol.codigo = o.codigo'
      '          %dataalteracao'
      '           and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '           and trigger_tuple = '#39'new'#39
      '          order by ol.trigger_changed desc limit 1'
      '         )'
      '         union all'
      '        ('
      '         select cast('#39'OP. FALHAS'#39' as varchar(30)) as tabela,'
      '                fol.trigger_changed as dataHoraAlteracao'
      '         from falhasoperacoes_log fol'
      '          where fol.operacao = o.codigo'
      '          %dataalteracao'
      '           and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '           and trigger_tuple = '#39'new'#39
      '          order by fol.trigger_changed desc limit 1'
      '         )'
      #9#9' union all'
      '        ('
      '         select cast('#39'OP. M'#193'QUINAS'#39' as varchar(30)) as tabela,'
      '                oml.trigger_changed as dataHoraAlteracao'
      '         from operacoesmaquinas_log oml'
      '          where oml.operacao = o.codigo'
      '          %dataalteracao'
      '           and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '           and trigger_tuple = '#39'new'#39
      '          order by oml.trigger_changed desc limit 1'
      '         )'
      #9#9' union all'
      '        ('
      '         select cast('#39'OP. SET-UP'#39' as varchar(30)) as tabela,'
      '                osl.trigger_changed as dataHoraAlteracao'
      '         from operacoessetup_log osl'
      '          where osl.operacao = o.codigo'
      '          %dataalteracao'
      '           and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '           and trigger_tuple = '#39'new'#39
      '          order by osl.trigger_changed desc limit 1'
      '         )'
      #9#9' union all'
      '        ('
      
        '         select cast('#39'OP. PROC. CONTROLE'#39' as varchar(30)) as tab' +
        'ela,'
      '                pcl.trigger_changed as dataHoraAlteracao'
      '         from processoscontrole_log pcl'
      '          where pcl.operacao = o.codigo'
      '          %dataalteracao'
      '           and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '           and trigger_tuple = '#39'new'#39
      '          order by pcl.trigger_changed desc limit 1'
      '         )'
      '        ) as selecao'
      '        order by dataHoraAlteracao desc limit 1) as Tabela'
      ''
      ''
      ''
      'from operacoes o'
      '%FluxogramaOperacao'
      'where true'
      '%InclusaoOperacoes'
      '%AlteracaoOperacoes'
      '%ListarSetup'
      '%ListarPlano'
      '%ListarBloqueio'
      '%CodigoOperacao'
      ''
      ') as o'#9' '
      ''
      'order by o.nome, o.c01, o.c02, o.c03'
      ''
      ''
      '/*'
      ':fluxograma'
      ':codigo'
      ':datainicialinclusao'
      ':datafinalinclusao'
      ':datainicialalteracao'
      ':datafinalalteracao'
      '*/')
    RequestLive = True
    Left = 422
    Top = 176
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'fluxograma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicialinclusao'
        ParamType = ptUnknown
