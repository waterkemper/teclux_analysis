  object qryRegistrodasOperacaoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select inclusao.*,'
      '       (select u.nome'
      '        from usuarios u'
      '        where u.usename = UsuarioInclusao'
      '        ) as NomeUsuarioInclusao,'
      '       alteracao.*,'
      '       (select u.nome'
      '        from usuarios u'
      '        where u.usename = UsuarioAlteracao'
      '        ) as NomeUsuarioAlteracao'
      ''
      'from'
      '('
      ''
      'select inclusao.* from ('
      '('
      'select opl.trigger_user as UsuarioInclusao,'
      
        '       cast(to_char(opl.trigger_changed, '#39'DD/MM/YYYY HH24:MI:SS'#39 +
        ') as varchar(20)) as DataInclusao'
      'from operacoes_log opl'
      'where opl.codigo = :operacao'
      '  and trigger_mode = '#39'INSERT'#39
      'order by opl.trigger_changed desc limit 1'
      ')'
      ''
      'union all'
      ''
      '('
      'select cast(null as varchar(50)) as UsuarioInclusao,'
      '       cast(null as varchar(20)) as DataInclusao'
      'where not exists (select opl.codigo'
      '                  from operacoes_log opl'
      '                  where opl.codigo = :operacao'
      '                   and trigger_mode = '#39'INSERT'#39
      '                   order by opl.trigger_changed desc limit 1)'
      ''
