  inherited;
  if qryOperacoestempopadrao.AsCurrency > 0 then
    qryOperacoespecashora.AsCurrency := 6000 / qryOperacoestempopadrao.AsCurrency
  else
    qryOperacoespecashora.AsCurrency := 0;
end;

