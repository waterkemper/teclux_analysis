procedure TdtmCadastroOperacoes.ZMonitor1MonitorEvent(Sql, Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\operacoes.sql') then
    Listar.loadfromfile('c:\operacoes.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\operacoes.sql');
  listar.free;
end;

