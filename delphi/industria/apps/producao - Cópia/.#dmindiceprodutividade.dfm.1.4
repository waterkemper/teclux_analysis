  object qryIndiceProdutividade: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroPeriodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSetoresProducao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroFuncionarios'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select selecao.*'
      'from'
      '('
      'select setorproducao, descricaosetorproducao, usuario, nome,'
      '       case when sum(tempo)<>0 then'
      
        '       cast(100 * sum((percentual * tempo))/sum(tempo) as numeri' +
        'c(15,2)) else 0 end as percentualsetor'
      'from'
      '('
      
        'select setorproducao, descricaosetorproducao, usuario, nome, tem' +
        'popadrao, quantidade, tempo,'
      
        '       case when coalesce(tempo,0)<>0 then tempo/quantidade else' +
        ' 0 end as indice,'
      
        '       case when (coalesce(tempopadrao,0)<>0) and (coalesce(temp' +
        'o,0)<>0) then TempoPadrao / (100 * tempo/quantidade) else 0 end ' +
        'as percentual'
      '       '
      'from'
      '('
      
        'select coalesce(c.setorproducao,cast(null as varchar(4))) as set' +
        'orproducao,'
      
        '       coalesce(sp.descricao, cast('#39'DIVERSOS'#39' as varchar(50))) a' +
        's descricaosetorproducao,'
      '       oou.usuario,'
      '       u.nome,'
      '       o.tempopadrao,'
      '       '
      '       sum((oou.quantidade -'
      '        coalesce((select sum(oouf.quantidadeperda)'
      '                  from operacoesospusuariofalhas oouf'
      '                  where oouf.osp = oou.osp'
      '                    and oouf.lote = oou.lote'
      '                    and oouf.operacao = oou.operacao'
      '                    and oouf.usuario = oou.usuario'
      '                    and oouf.data = oou.data'
      
        '                    and oouf.inicio = oou.inicio),0))) as quanti' +
        'dade,'
      '                    '
      
        '       cast(sum((extract(epoch from (cast(oou.datatermino||'#39' '#39'||' +
        'oou.termino as timestamp)) - (cast(oou.data||'#39' '#39'||oou.inicio as ' +
        'timestamp)))/60)) as integer) as tempo'
      '                    '
      '/*'
      '       cast('
      #9'   trim('
      #9'   to_char('
      #9'   cast('
      '       cast('
      '       cast(EXTRACT(DAYS FROM ('
      
        '       cast(cast(oou.datatermino as varchar)||'#39' '#39'||cast(oou.term' +
        'ino as varchar) as timestamp) -'
      
        '       cast(cast(oou.data as varchar)||'#39' '#39'||cast(oou.inicio as v' +
        'archar) as timestamp))'
      '       ) * 24 as integer) +'
      ''
      '       cast(to_char('
      
        '       cast(cast(oou.datatermino as varchar)||'#39' '#39'||cast(oou.term' +
        'ino as varchar) as timestamp) -'
      
        '       cast(cast(oou.data as varchar)||'#39' '#39'||cast(oou.inicio as v' +
        'archar) as timestamp),'
      '       '#39'HH24'#39')'
      '        as integer) as char(2)) as integer),'#39'00'#39'))||'#39':'#39'||'
      ''
      '       cast(to_char('
      
        '       cast(cast(oou.datatermino as varchar)||'#39' '#39'||cast(oou.term' +
        'ino as varchar) as timestamp) -'
      
        '       cast(cast(oou.data as varchar)||'#39' '#39'||cast(oou.inicio as v' +
        'archar) as timestamp),'
      '       '#39'MI'#39') as char(2))||'#39':'#39'||'
      ''
      '       cast(to_char('
      
        '       cast(cast(oou.datatermino as varchar)||'#39' '#39'||cast(oou.term' +
        'ino as varchar) as timestamp) -'
      
        '       cast(cast(oou.data as varchar)||'#39' '#39'||cast(oou.inicio as v' +
        'archar) as timestamp),'
      '       '#39'SS'#39') as char(2)) as char(8))  as tempo,'
      '       '
      '       oou.data,'
      '       oou.inicio,'
      '       oou.datatermino,'
      '       oou.termino'
      '*/'
      ''
      'from operacoesospusuario oou'
      '     join operacoes o'
      '     on oou.operacao = o.codigo'
      ''
      '     join usuarios u'
      '     on oou.usuario = u.codigo'
      '     '
      '     join osp'
      '          join produtos p'
      '               join caracteristicas c'
      '                    left join setoresproducao sp'
      '                    on c.setorproducao = sp.codigo'
      '                    '
      '               on p.caracteristica = c.codigo'
      '          on osp.produto = p.codigo'
      '          '
      '     on oou.osp = osp.numero'
      ''
      '     join maquinas m'
      '     on oou.maquina = m.codigo'
      ''
      'where not coalesce(o.naobloqueiausuario,false)'
      '  and coalesce(oou.quantidade,0)<>0'
      '  and oou.datatermino is not null'
      '  and oou.termino is not null'
      '  and oou.maquina is not NULL'
      '  '
      '  %FiltroPeriodo'
      '  %FiltroSetoresProducao'
      '  %FiltroFuncionarios'
      ''
      ''
      'group by coalesce(c.setorproducao,cast(null as varchar(4))),'
      
        '         coalesce(sp.descricao, cast('#39'DIVERSOS'#39' as varchar(50)))' +
        ','
      '         oou.usuario,'
      '         u.nome,'
      '         o.tempopadrao'
      ') as selecao'
      ') as selecao'
      'group by setorproducao, descricaosetorproducao, usuario, nome'
      ') as selecao'
      
        'order by setorproducao, descricaosetorproducao, percentualsetor ' +
        'desc, usuario, nome'
      ''
      '/*'
      'PARAMETROS'
      ':datainicial'
      ':datafinal'
      '*/'
      ''
      ''
      '')
    RequestLive = False
    Left = 96
    Top = 56
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
