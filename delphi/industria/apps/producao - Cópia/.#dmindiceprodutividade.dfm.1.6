  object qryIndiceProdutividade: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'FiltroPeriodo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroSetoresProducao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'FiltroFuncionarios'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT s3.*'
      'FROM'
      '('
      ' SELECT SetorProducao, DescricaoSetorProducao, Usuario, Nome,'
      '        CASE WHEN SUM(Tempo) <> 0'
      
        '            THEN CAST(100 * SUM((Percentual * Tempo)) / SUM(Temp' +
        'o) AS NUMERIC(15,2))'
      '            ELSE 0'
      '        END AS PercentualSetor'
      ' FROM'
      ' ('
      
        '  SELECT SetorProducao, DescricaoSetorProducao, Usuario, Nome, T' +
        'empoPadrao, Quantidade, Tempo,'
      '         CASE WHEN COALESCE(Tempo, 0) <> 0'
      '              THEN Tempo / Quantidade'
      '              ELSE 0'
      '         END AS Indice,'
      ''
      
        '         CASE WHEN COALESCE(TempoPadrao, 0) <> 0 AND COALESCE(Te' +
        'mpo, 0) <> 0'
      '              THEN TempoPadrao / (100 * Tempo / Quantidade)'
      '              ELSE 0'
      '         END AS Percentual'
      '       '
      '  FROM'
      '  ('
      
        '   SELECT COALESCE(c.SetorProducao, CAST(NULL AS VARCHAR(4))) AS' +
        ' SetorProducao,'
      
        '          COALESCE(sp.Descricao, CAST('#39'DIVERSOS'#39' AS VARCHAR(50))' +
        ') AS DescricaoSetorProducao,'
      '          oou.Usuario, u.Nome, o.TempoPadrao,'
      '       '
      
        '          SUM(oou.Quantidade - COALESCE((SELECT SUM(oouf.Quantid' +
        'adePerda)'
      
        '                                         FROM OperacoesOSPUsuari' +
        'oFalhas oouf'
      
        '                                         WHERE oouf.OSP      = o' +
        'ou.OSP'
      
        '                                           AND oouf.Lote     = o' +
        'ou.Lote'
      
        '                                           AND oouf.Operacao = o' +
        'ou.Operacao'
      
        '                                           AND oouf.Usuario  = o' +
        'ou.Usuario'
      
        '                                           AND oouf.Data     = o' +
        'ou.Data'
      
        '                                           AND oouf.Inicio   = o' +
        'ou.Inicio), 0)) AS Quantidade,'
      '                    '
      
        '          CAST(SUM((EXTRACT(EPOCH FROM CAST(oou.DataTermino || '#39 +
        ' '#39' || oou.Termino AS TIMESTAMP) - '
      
        '                                       CAST(oou.Data        || '#39 +
        ' '#39' || oou.Inicio  AS TIMESTAMP)) / 60)) AS INTEGER) AS Tempo'
      '                    '
      ''
      '   FROM OperacoesOSPUsuario oou'
      '        JOIN Operacoes o  ON oou.Operacao = o.Codigo'
      '        JOIN Usuarios u   ON oou.Usuario  = u.Codigo'
      '/*      JOIN Maquinas m   ON oou.Maquina  = m.Codigo */'
      ''
      '        JOIN OSP'
      '             JOIN Produtos p'
      '                  JOIN Caracteristicas c'
      '                       LEFT JOIN SetoresProducao sp'
      '                       ON c.SetorProducao = sp.Codigo'
      '                  ON p.Caracteristica = c.Codigo'
      '             ON OSP.Produto = p.Codigo'
      '        ON oou.OSP = OSP.Numero'
      ''
      ''
      '   WHERE NOT COALESCE(o.NaoBloqueiaUsuario,FALSE)'
      '      AND COALESCE(oou.Quantidade,0) <> 0'
      '      AND oou.DataTermino IS NOT NULL'
      '      AND oou.Termino     IS NOT NULL'
      '/*    AND oou.Maquina     IS NOT NULL */'
      '  '
      '      %FiltroPeriodo'
      '      %FiltroSetoresProducao'
      '      %FiltroFuncionarios'
      ''
      '   GROUP BY COALESCE(c.SetorProducao, CAST(NULL AS VARCHAR(4))),'
      
        '            COALESCE(sp.Descricao, CAST('#39'DIVERSOS'#39' AS VARCHAR(50' +
        '))),'
      '            oou.Usuario, u.Nome, o.TempoPadrao'
      '  ) AS s1'
      ' ) AS s2'
      ' GROUP BY SetorProducao, DescricaoSetorProducao, Usuario, Nome'
      ') AS s3'
      
        'ORDER BY SetorProducao, DescricaoSetorProducao, PercentualSetor ' +
        'DESC, Usuario, Nome'
      ''
      ''
      '/* PAR'#194'METROS'
      ':DataInicial'
      ':DataFinal'
      '*/'
      '')
    RequestLive = True
    Left = 96
    Top = 56
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end>
  end
