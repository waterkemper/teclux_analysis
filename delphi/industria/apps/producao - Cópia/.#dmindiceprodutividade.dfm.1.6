      ';'
      'select  usuario, nomeusuario,'
      '       case when NSetores > 1 then'
      '          case when SomaTempoUsuario <> 0 then'
      '            SomaPremios/SomaTempoUsuario'
      '          else 0 end'
      '       else PremioTotal'
      '       end as PremioTotal'
      'from'
      '('
      ''
      'select usuario, nomeusuario,'
      
        '       sum(EficienciaSetor * SomaTempoUsuario *  PremioTotal) as' +
        ' SomaPremios,'
      
        #9'   sum(SomaTempoUsuario) as SomaTempoUsuario, NSetores, PremioT' +
        'otal'
      'from'
      '('#9
      'select  *, PremioIndividual+PremioSetor as PremioTotal'
      'from'
      '('
      ' select setorproducao, usuario, nomeusuario,'
      ''
      '       EficienciaUsuario, SomaTempoUsuario, NSetores,'
      ''
      '       case when EficienciaUsuario < 0.70 then 0'
      
        #9'   '#9'      when EficienciaUsuario < 0.80 then EficienciaUsuario ' +
        '* ValorPremio / 4'
      
        '       else                                    EficienciaUsuario' +
        ' * ValorPremio / 2'
      #9#9'   end  as PremioIndividual,'
      ''
      ''
      '       EficienciaSetor,'
      ''
      '       case when EficienciaUsuario < 0.70'
      '            then 0'
      '            else EficienciaSetor * ValorPremio / 2'
      #9#9'   end  as PremioSetor'
      #9#9
      '   from'
      ' ('
      '            '#9#9
      ''
      '  SELECT setores.SetorProducao, setores.DescricaoSetor,'
      ''
      '         CASE WHEN setores.SomaTempo <> 0'
      '              THEN setores.EficienciaTempo / setores.SomaTempo'
      '              ELSE 0'
      '         END AS EficienciaSetor,'
      #9#9
      #9#9' (select spp.valor'
      #9#9'  from setoresproducaopremiacao spp'
      #9#9'  where spp.setor = setores.SetorProducao'
      
        #9#9'    and spp.mes = to_char(cast(:datainicial as date), '#39'MM/YYYY' +
        #39')) as ValorPremio,'
      #9#9
      ''
      '         usuarios.usuario,'
      '         usuarios.nomeusuario,'
      '         usuarios.EficienciaUsuario,'
      #9#9' usuarios.SomaTempoUsuario,'
      #9#9' usuarios.NSetores'
      ''
      '  FROM'
      '  ('
      
        '   SELECT COALESCE(m.SetorProducao, CAST(NULL AS VARCHAR(4))) AS' +
        ' SetorProducao,'
      
        '          COALESCE(sp.Descricao, CAST('#39'DIVERSOS'#39' AS VARCHAR(50))' +
        ') AS DescricaoSetor,'
      ''
      
        '          SUM(EficienciaOperacaoUsuario(oou.OSP, oou.Lote, oou.O' +
        'peracao, oou.Usuario, oou.Data, oou.Inicio) *'
      
        '              TempoOperacaoUsuario     (oou.OSP, oou.Lote, oou.O' +
        'peracao, oou.Usuario, oou.Data, oou.Inicio)) AS EficienciaTempo,'
      ''
      
        '          SUM(TempoOperacaoUsuario     (oou.OSP, oou.Lote, oou.O' +
        'peracao, oou.Usuario, oou.Data, oou.Inicio)) AS SomaTempo'
      ''
      '   FROM OperacoesOSPUsuario oou'
      '        JOIN Operacoes o  ON oou.Operacao = o.Codigo'
      '        JOIN Usuarios u   ON oou.Usuario  = u.Codigo'
      
        '        JOIN Maquinas m   ON m.Codigo     = COALESCE(oou.Maquina' +
        ', (SELECT om.Maquina FROM OperacoesMaquinas om'
      
        '                                                                ' +
        '      WHERE om.Operacao = oou.Operacao LIMIT 1))'
      '      JOIN SetoresProducao sp ON sp.Codigo = m.SetorProducao'
      ''
      ''
      '   WHERE NOT COALESCE(o.NaoBloqueiaUsuario,FALSE)'
      '      AND COALESCE(oou.Quantidade,0) <> 0'
      '      AND oou.DataTermino IS NOT NULL'
      '      AND oou.Termino     IS NOT NULL'
      ''
      '      %FiltroPeriodo'
      '      %FiltroSetoresProducao'
      ''
      '   GROUP BY SetorProducao, DescricaoSetor'
      '  ) AS setores'
      ''
      '  join'
      ''
      '  ('
      
        '  SELECT SetorProducao, DescricaoSetor, Usuario, NomeUsuario, So' +
        'maTempo as SomaTempoUsuario, NSetores,'
      ''
      '         CASE WHEN SomaTempo <> 0'
      '              THEN EficienciaTempo / SomaTempo'
      '              ELSE 0'
      '         END AS EficienciaUsuario'
      ''
      '  FROM'
      '  ('
      
        '   SELECT COALESCE(m.SetorProducao, CAST(NULL AS VARCHAR(4))) AS' +
        ' SetorProducao,'
      
        '          COALESCE(sp.Descricao, CAST('#39'DIVERSOS'#39' AS VARCHAR(50))' +
        ') AS DescricaoSetor,'
      '          oou.Usuario, u.Nome AS NomeUsuario,'
      ''
      
        '          SUM(EficienciaOperacaoUsuario(oou.OSP, oou.Lote, oou.O' +
        'peracao, oou.Usuario, oou.Data, oou.Inicio) *'
      
        '              TempoOperacaoUsuario     (oou.OSP, oou.Lote, oou.O' +
        'peracao, oou.Usuario, oou.Data, oou.Inicio)) AS EficienciaTempo,'
      ''
      
        '          SUM(TempoOperacaoUsuario     (oou.OSP, oou.Lote, oou.O' +
        'peracao, oou.Usuario, oou.Data, oou.Inicio)) AS SomaTempo,'
      ''
      ''
      ''
      ''
      '   (select count(*) from'
      '   ('
      
        '   SELECT COALESCE(m2.SetorProducao, CAST(NULL AS VARCHAR(4))) A' +
        'S SetorProducao,'
      
        '          COALESCE(sp2.Descricao, CAST('#39'DIVERSOS'#39' AS VARCHAR(50)' +
        ')) AS DescricaoSetor,'
      '          oou2.Usuario, u2.Nome AS NomeUsuario'
      ''
      '   FROM OperacoesOSPUsuario oou2'
      '        JOIN Operacoes o2  ON oou2.Operacao = o2.Codigo'
      '        JOIN Usuarios u2   ON oou2.Usuario  = u2.Codigo'
      
        '        JOIN Maquinas m2   ON m2.Codigo     = COALESCE(oou2.Maqu' +
        'ina, (SELECT om.Maquina FROM OperacoesMaquinas om'
      
        '                                                                ' +
        '      WHERE om.Operacao = oou2.Operacao LIMIT 1))'
      '      JOIN SetoresProducao sp2 ON sp2.Codigo = m2.SetorProducao'
      ''
      ''
      '   WHERE NOT COALESCE(o2.NaoBloqueiaUsuario,FALSE)'
      '      AND COALESCE(oou2.Quantidade,0) <> 0'
      '      AND oou2.DataTermino IS NOT NULL'
      '      AND oou2.Termino     IS NOT NULL'
      '      and oou2.usuario = oou.usuario'
      ''
      '      %FiltroPeriodo2'
      '      %FiltroSetoresProducao2'
      ''
      
        '   GROUP BY SetorProducao, DescricaoSetor, oou2.Usuario, NomeUsu' +
        'ario'
      '   ) as usuarios) as NSetores'
      ''
      ''
      '   FROM OperacoesOSPUsuario oou'
      '        JOIN Operacoes o  ON oou.Operacao = o.Codigo'
      '        JOIN Usuarios u   ON oou.Usuario  = u.Codigo'
      
        '        JOIN Maquinas m   ON m.Codigo     = COALESCE(oou.Maquina' +
        ', (SELECT om.Maquina FROM OperacoesMaquinas om'
      
        '                                                                ' +
        '      WHERE om.Operacao = oou.Operacao LIMIT 1))'
      '      JOIN SetoresProducao sp ON sp.Codigo = m.SetorProducao'
      ''
      ''
      '   WHERE NOT COALESCE(o.NaoBloqueiaUsuario,FALSE)'
      '      AND COALESCE(oou.Quantidade,0) <> 0'
      '      AND oou.DataTermino IS NOT NULL'
      '      AND oou.Termino     IS NOT NULL'
      ''
      ''
      '      %FiltroPeriodo'
      '      %FiltroSetoresProducao'
      '      %FiltroFuncionarios'
      ''
      
        '   GROUP BY SetorProducao, DescricaoSetor, oou.Usuario, NomeUsua' +
        'rio'
      '  ) as usuarios'
      '  ) as usuarios'
      '  on setores.setorproducao = usuarios.setorproducao'
      ' ) as premiacao'
      ') as premiacao'
      'ORDER BY SetorProducao, Usuario'
      ') as premiacao'
      'group by usuario, nomeusuario, NSetores, PremioTotal'
      ') as premiacao'
      'order by  usuario'
      ''
