    Sql.Strings = (
      'select'
      ' osp,'
      ' lote,  '
      ' operacao,'
      ' usuario,'
      ' data,'
      ' inicio,'
      ' falha,'
      ' quantidadeperda,'
      ' perdatotal,'
      
        '/* (select f.PerdaTotal from falhas f where f.codigo = falha) as' +
        ' PerdaTotal,*/'
      
        ' (select f.descricao from falhas f where f.codigo = falha) as de' +
        'scricao,'
      ' True as FalhaValidada'
      'from operacoesospusuariofalhas'
      'where osp = :osp'
      '  and lote = :lote'
      'order by falha')
    RequestLive = False
    Left = 96
