  object qryOperacoesOSPUsuario: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkFields = 'osp=osp,lote=lote,operacao=operacao'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrOperacoesOSP
    Constraints = <>
    AfterOpen = qryOperacoesOSPUsuarioAfterOpen
    BeforeInsert = qryOperacoesOSPUsuarioBeforeInsert
    AfterInsert = qryOperacoesOSPUsuarioAfterInsert
    AfterEdit = qryOperacoesOSPUsuarioAfterEdit
    BeforePost = qryOperacoesOSPUsuarioBeforePost
    AfterPost = qryOperacoesOSPUsuarioAfterPost
    BeforeDelete = qryOperacoesOSPUsuarioBeforeDelete
    AfterDelete = qryOperacoesOSPUsuarioAfterDelete
    AfterScroll = qryOperacoesOSPUsuarioAfterScroll
    OnCalcFields = qryOperacoesOSPUsuarioCalcFields
    OnNewRecord = qryOperacoesOSPUsuarioNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select'
      ' oou.osp,'
      ' oou.lote,'
      ' oou.operacao,'
      ' oou.usuario,'
      ' u.nome,'
      ' oou.usuariosetup,'
      ' (select u.nome'
      '  from usuarios u'
      '  where u.codigo = oou.usuariosetup) as nomeusuariosetup,'
      ' oou.data,'
      ' oou.inicio,'
      ' oou.maquina,'
      
        ' (select m.descricao from maquinas m where m.codigo = oou.maquin' +
        'a) as descricaomaquina,'
      ' oou.datatermino,'
      ' oou.usuariotermino,'
      ' oou.termino,'
      ' oou.quantidade,'
      ' true as UsuarioValidado,'
      ' true as usuarioSetupvalidado,'
      ' true as usuarioFechamentovalidado,'
      ' true as MaquinaValidada,'
      ''
      ' oou.usuario as usuariorelacao,'
      ' oou.data as datarelacao,'
      ' oou.inicio as iniciorelacao,'
      ' oou.turno,'
      ' oou.numeromovimento,'
      ' oou.retrabalho,'
      ' case when oou.intervalo is not null then oou.intervalo'
      ' else'
      
        '  NrMinutosIntervaloTurno(oou.Data, oou.Inicio, oou.DataTermino,' +
        ' oou.Termino, u.turno)'
      ' end as intervalo,'
      ''
      ' oou.intervalo,'
      ''
      
        ' TempoOperacaoUsuario     (oou.OSP, oou.Lote, oou.Operacao, oou.' +
        'Usuario, oou.Data, oou.Inicio) AS Tempo,'
      
        ' EficienciaOperacaoUsuario(oou.OSP, oou.Lote, oou.Operacao, oou.' +
        'Usuario, oou.Data, oou.Inicio, FALSE) * 100 AS Eficiencia,'
      
        ' QualidadeOperacaoUsuario (oou.OSP, oou.Lote, oou.Operacao, oou.' +
        'Usuario, oou.Data, oou.Inicio, FALSE) * 100 AS Qualidade'
      ''
      'from operacoesospusuario oou'
      '     join usuarios u'
      '     on oou.usuario = u.codigo'
      ''
      'where oou.osp      = :osp'
      '  and oou.lote      = :lote'
      'order by  oou.data,'
      '          oou.inicio,'
      '          oou.termino'
      ''
      '')
    RequestLive = False
    Left = 96
    Top = 152
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'osp'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'lote'
        ParamType = ptUnknown
      end>
