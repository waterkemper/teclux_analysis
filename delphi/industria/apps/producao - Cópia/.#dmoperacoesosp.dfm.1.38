      DisplayFormat = '0'
    end
    object qryOperacoesMaquinasnomeusuario: TStringField
      FieldName = 'nomeusuario'
      Size = 40
    end
    object qryOperacoesMaquinascodigoparada: TIntegerField
      FieldName = 'codigoparada'
