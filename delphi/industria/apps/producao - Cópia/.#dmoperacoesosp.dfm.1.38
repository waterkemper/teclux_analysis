  object qryOperacoesMaquinas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select om.*,'
      '       m.descricao as descricaomaquina,'
      '       cast('#39'DISPON'#205'VEL'#39' as varchar(10)) as situacao,'
      '       cast(null as integer) as usuario,'
      '       cast(null as varchar(40)) as nomeusuario,'
      '       cast(null as integer) as codigoparada,'
      '       cast(null as varchar(50)) as descricaoparada,'
      '       cast(null as integer) as osp,'
      '       cast(null as integer) as lote,'
      ''
      '       coalesce((select o.naobloqueiausuario'
      '        from operacoesospusuario oou'
      '             join operacoes o'
      '             on oou.operacao = o.codigo'
      '        where o.naobloqueiausuario'
      '          and oou.maquina = om.maquina'
      '          and oou.datatermino  is null'
      '          limit 1), false) as naobloqueiausuario'
      ''
      ''
      ''
      'from operacoesmaquinas om'
      '     join maquinas m'
      '     on om.maquina = m.codigo'
      'where om.operacao = :operacao'
      '  and not exists (select oou.maquina'
      '                  from ((operacoesospusuario oou'
      '                         join operacoes o'
      '                         on oou.operacao = o.codigo)'
      ''
      
        '                         left join operacoesospusuarioparadas oo' +
        'up'
      '                         on oou.osp      = ooup.osp      and'
      '                            oou.lote     = ooup.lote     and'
      '                            oou.operacao = ooup.operacao and'
      '                            oou.usuario  = ooup.usuario  and'
      '                            oou.data     = ooup.data     and'
      '                            oou.inicio   = ooup.inicio)'
      ''
      '                  where oou.maquina  = om.maquina'
      
        '                         /* operacao em aberto e bloqueante: est' +
        'a situacao vai para '#39'EM USO'#39' */'
      
        '                    and ((oou.datatermino  is null and not coale' +
        'sce(o.naobloqueiausuario,false) and not m.usocomum)'
      
        '                         /* operacao fechada por por parada que ' +
        'bloqueia maquina: esta situa'#231#227'o vai para '#39'BLOQUEADAS'#39' */'
      '                         or (oou.datatermino  is not null and'
      
        '                             coalesce(ooup.bloqueiamaquina,false' +
        ') and'
      '                             ooup.fimparada is null)))'
      ''
      ''
      'union all'
      ''
      'select om.*,'
      '       m.descricao as descricaomaquina,'
      '       cast('#39'EM USO'#39' as varchar(10)) as situacao,'
      '       oou.usuario,'
      '       u.nome as nomeusuario,'
      '       cast(null as integer) as codigoparada,'
      '       cast(null as varchar(50)) as descricaoparada,'
      '       oou.osp,'
      '       oou.lote,'
      '       false as naobloqueiausuario'
      ''
      ''
      'from ((operacoesmaquinas om'
      '       join maquinas m'
      '       on om.maquina = m.codigo)'
      ''
      '       join ((operacoesospusuario oou'
      '              join operacoes o'
      '               on oou.operacao = o.codigo)'
      ''
      '              join usuarios u'
      '               on oou.usuario = u.codigo)'
      '        on om.maquina = oou.maquina)'
      ''
      'where om.maquina = m.codigo'
      '  and oou.operacao = o.codigo'
      '  and oou.usuario = u.codigo'
      '  and om.maquina = oou.maquina'
      ''
      '  and om.operacao = :operacao'
      '  and not coalesce(o.naobloqueiausuario,false)'
      '  and oou.datatermino is null'
      ''
      ''
      ''
      '/*'
      'union all'
      ''
      'select om.*,'
      '       m.descricao as descricaomaquina,'
      '       cast('#39'BLOQUEADO'#39' as varchar(10)) as situacao,'
      '       oou.usuario,'
      '       u.nome as nomeusuario,'
      '       ooup.codigoparada,'
      '       mp.descricao as descricaoparada,'
      '       oou.osp,'
      '       oou.lote,'
      '       false as naobloqueiausuario'
      ''
      'from ((operacoesmaquinas om'
      '       join maquinas m'
      '       on om.maquina = m.codigo)'
      ''
      '       join (((operacoesospusuario oou'
      '               join (operacoesospusuarioparadas ooup'
      '                     join motivosparadas mp'
      '                     on ooup.codigoparada = mp.codigo)'
      '               on oou.osp      = ooup.osp      and'
      '                  oou.lote     = ooup.lote     and'
      '                  oou.operacao = ooup.operacao and'
      '                  oou.usuario  = ooup.usuario  and'
      '                  oou.data     = ooup.data     and'
      '                  oou.inicio   = ooup.inicio)'
      ''
      '              join operacoes o'
      '               on oou.operacao = o.codigo)'
      ''
      '              join usuarios u'
      '               on oou.usuario = u.codigo)'
      '        on om.maquina = oou.maquina)'
      'where oou.datatermino  is not null and'
      '      coalesce(ooup.bloqueiamaquina,false) and'
      '      ooup.fimparada is null'
      '      and om.operacao = :operacao'
      '      */'
      '')
    RequestLive = False
    Left = 368
    Top = 304
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'operacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'esta'
        ParamType = ptUnknown
      end>
    object qryOperacoesMaquinasoperacao: TIntegerField
      FieldName = 'operacao'
      DisplayFormat = '0'
    end
    object qryOperacoesMaquinasmaquina: TIntegerField
      FieldName = 'maquina'
      DisplayFormat = '0'
    end
    object qryOperacoesMaquinasdescricaomaquina: TStringField
      FieldName = 'descricaomaquina'
      Size = 30
