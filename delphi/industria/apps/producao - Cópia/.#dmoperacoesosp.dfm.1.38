  object qryOperacaoesaFechar: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkFields = 'maquina=maquina'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrMaquinasaFechar
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select oou.osp,'
      '       oou.lote,'
      '       oou.maquina,'
      '       m.descricao as descricaomaquina,'
      '       oou.operacao,'
      '       o.nome,'
      '       o.c01,'
      '       o.c02,'
      '       o.c03,'
      '       o.descricao as descricaooperacao,'
      '       oou.usuario,'
      '       u.nome as nomeuusuario,'
      '       oou.data,'
      '       oou.inicio,'
      ''
      '       '
      '      (coalesce((select sum(oou2.quantidade)'
      '        from operacoesospusuario oou2'
      '        where oou2.osp  = oou.osp'
      '          and oou2.lote = oou.lote'
      '          and oou2.datatermino is not null'
      '          and oou2.operacao = (select oo2.operacao'
      '                               from operacoesosp oo2'
      '                               where oo2.osp = oo.osp'
      '                                 and oo2.lote = oo.lote'
      
        '                                 and cast(oo2.sequencia as numer' +
        'ic) < cast(oo.sequencia as numeric)'
      
        '                               order by cast(oo2.sequencia as nu' +
        'meric) desc limit 1 )'
      '          ),0) -'
      ''
      '       coalesce((select sum(oou2.quantidade)'
      '        from operacoesospusuario oou2'
      '        where oou2.osp  = oou.osp'
      '          and oou2.lote = oou.lote'
      '          and oou2.operacao = oou.operacao'
      
        '          and oou2.datatermino is not null),0) ) as quantidadeaf' +
        'echar,'
      '          '
      '      o.naobloqueiausuario,'
      '      false as operacaopermitidaaousuario'
      ''
      'from operacoesospusuario oou'
      '     join operacoesosp oo'
      '     on oou.osp = oo.osp'
      '     and oou.lote = oo.lote'
      '     and oou.operacao = oo.operacao'
      '     '
      '     join usuarios u'
      '     on oou.usuario = u.codigo'
      '     '
      '     join operacoes o'
      '     on oou.operacao = o.codigo'
      '     '
      '     join maquinas m'
      '     on oou.maquina = m.codigo'
      '     '
      'where oou.maquina is not null'
      '  and oou.datatermino is null'
      '  and o.naobloqueiausuario'
      ''
      'order by oou.maquina, o.nome, o.c01, o.c02, o.c03'
      '')
    RequestLive = True
    Left = 864
    Top = 152
