  object qryOperacoesOSP: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterPost = qryOperacoesOSPAfterPost
    BeforeDelete = qryOperacoesOSPBeforeDelete
    AfterScroll = qryOperacoesOSPAfterScroll
    OnCalcFields = qryOperacoesOSPCalcFields
    OnFilterRecord = qryOperacoesOSPFilterRecord
    Filtered = True
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select operacoesosp.osp,'
      '       operacoesosp.lote,'
      '       operacoesosp.operacao,'
      '       operacoesosp.sequencia,'
      '       operacoes.nome,'
      '       operacoes.c01,'
      '       operacoes.c02,'
      '       operacoes.c03,'
      '       operacoes.setup,'
      '       operacoes.planocontrole,'
      '       false as heaprimeiraoperacao,'
      ''
      '      (SELECT otp.TempoPadrao'
      '          FROM OperacoesTemposPadrao otp'
      '          WHERE otp.Operacao = Operacoes.Codigo'
      '          ORDER BY otp.Data DESC LIMIT 1) AS TempoPadrao,'
      ''
      '       /*'
      '       (select fo.tipooperacao'
      '        from fluxogramasoperacoes fo'
      '        where fo.fluxograma = (select cp.fluxograma'
      '                               from clientesprodutos cp'
      
        '                               where (cp.cliente, cp.tipocliente' +
        ', cp.produto) in'
      
        '                                     (select osp.cliente, cast('#39 +
        'C'#39' as char(1)), osp.produto'
      '                                      from osp'
      
        '                                      where osp.numero = :osp li' +
        'mit 1) limit 1) and'
      
        '              fo.operacao = operacoesosp.operacao) as tipooperac' +
        'ao,'
      '       */'
      ''
      '       operacoesosp.tipooperacao,'
      ''
      '       /*'
      '       (select fo.origemoperacaoalternativa'
      '        from fluxogramasoperacoes fo'
      '        where fo.fluxograma = (select cp.fluxograma'
      '                               from clientesprodutos cp'
      
        '                               where (cp.cliente, cp.tipocliente' +
        ', cp.produto) in'
      
        '                                     (select osp.cliente, cast('#39 +
        'C'#39' as char(1)), osp.produto'
      '                                      from osp'
      
        '                                      where osp.numero = :osp li' +
        'mit 1) limit 1) and'
      
        '              fo.operacao = operacoesosp.operacao) as origemoper' +
        'acaoalternativa,'
      '       */'
      ''
      '      operacoesosp.origemoperacaoalternativa,'
      ''
      '       operacoes.ppm,'
      ''
      '       false as OperacaoemAndamento,'
      '       false as OperacaoemAndamento_Complementar,'
      '       false as OperacaoLiberada,'
      '       false as HabilitadoSetup,'
      '       operacoesosp.selecionada,'
      ''
      '       /*'
      '       (coalesce((select count(*)'
      '        from fluxogramasoperacoes fo'
      '        where fo.fluxograma = (select cp.fluxograma'
      '                               from clientesprodutos cp'
      
        '                               where (cp.cliente, cp.tipocliente' +
        ', cp.produto) in'
      
        '                                     (select osp.cliente, cast('#39 +
        'C'#39' as char(1)), osp.produto'
      '                                      from osp'
      
        '                                      where osp.numero = :osp li' +
        'mit 1) limit 1) and'
      
        '              fo.origemoperacaoalternativa = operacoesosp.operac' +
        'ao limit 1),0)<>0) as PossuiAlternativa,'
      '        */'
      ''
      '        /*'
      '       (coalesce((select count(*)'
      '                  from operacoesosp oo2'
      '                  where oo2.osp = operacoesosp.osp'
      
        '                    and oo2.origemoperacaoalternativa = operacoe' +
        'sosp.operacao'
      
        '                    and oo2.tipooperacao='#39'A'#39'),0)<>0) as PossuiAl' +
        'ternativa,'
      ''
      '       (coalesce((select count(*)'
      '                  from operacoesosp oo2'
      '                  where oo2.osp = operacoesosp.osp'
      
        '                    and oo2.origemoperacaoalternativa = operacoe' +
        'sosp.operacao'
      
        '                    and oo2.tipooperacao='#39'C'#39'),0)<>0) as PossuiCo' +
        'mplementar,'
      '       */             '
      ''
      '       (select sum(oou.quantidade - coalesce(oou.retrabalho,0))'
      '        from operacoesospusuario oou'
      '        where oou.osp      = operacoesosp.osp'
      '          and oou.lote     = operacoesosp.lote'
      
        '          and oou.operacao = operacoesosp.operacao) as quantidad' +
        'e,'
      ''
      '       (select sum(oouf.quantidadeperda)'
      
        '        from operacoesospusuariofalhas oouf join falhas f on oou' +
        'f.falha = f.codigo'
      '        where oouf.osp      = operacoesosp.osp'
      '          and oouf.lote     = operacoesosp.lote'
      '          and oouf.operacao = operacoesosp.operacao'
      '          and oouf.perdatotal) as quantidadecomperda,'
      ''
      '       (select sum(oouf.quantidadeperda)'
      
        '        from operacoesospusuariofalhas oouf join falhas f on oou' +
        'f.falha = f.codigo'
      '        where oouf.osp      = operacoesosp.osp'
      '          and oouf.lote     = operacoesosp.lote'
      '          and oouf.operacao = operacoesosp.operacao'
      '          and not oouf.perdatotal) as quantidadesemperda,'
      ''
      '       (select sum(ooup.tempoparada)'
      '        from operacoesospusuarioparadas ooup'
      '        where ooup.osp      = operacoesosp.osp'
      '          and ooup.lote     = operacoesosp.lote'
      
        '          and ooup.operacao = operacoesosp.operacao) as totaltem' +
        'poparada,'
      ''
      '       cast(0 as integer) as quantidadeanterior,'
      '       cast(0 as integer) as quantidadelimite,'
      '       '
      '       cast(0 as integer) as QuantidadeNasAlternativas,'
      ''
      '       operacoes.naobloqueiausuario,'
      '       operacoesosp.OperacaoemGrupoComAnterior,'
      '       operacoesosp.InformarTerminodoProcesso,'
      '       operacoesosp.fechamentoforcado,'
      '       operacoesosp.c8d'
      ''
      
        'from operacoesosp join operacoes on operacoesosp.operacao = oper' +
        'acoes.codigo'
      'where operacoesosp.osp = :osp'
      '  and operacoesosp.lote = :lote'
      ''
      'order by cast(operacoesosp.sequencia as numeric)')
    RequestLive = True
    Left = 88
    Top = 96
    ParamData = <
      item
        DataType = ftString
        Name = 'osp'
        ParamType = ptUnknown
        Value = '0'
      end
      item
        DataType = ftUnknown
        Name = 'lote'
        ParamType = ptUnknown
      end>
