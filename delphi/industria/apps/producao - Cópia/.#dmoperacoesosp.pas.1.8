    qryOperacoesOSPUsuarioParadas.Cancel;
    qryOperacoesOSPUsuarioParadas.First;
    while not qryOperacoesOSPUsuarioParadas.Eof do
    begin
      if not (qryOperacoesOSPUsuarioParadasparadavalidada.AsBoolean) or
