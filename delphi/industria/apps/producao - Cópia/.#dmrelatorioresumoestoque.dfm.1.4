  object qryEstoquePeriodo: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT Grupo, SUM(Financeiro) AS Financeiro'
      'FROM'
      '('
      '  SELECT ep.*'
      '  FROM'
      '  ('
      '    SELECT m1.Produto, m1.Filial,'
      
        '          (m2.EmEstoque + m2.Reservado  + m2.Transito + m2.Demon' +
        'stracao +'
      
        '           m2.Conserto  + m2.Danificada + m2.ReservaPrevia) AS Q' +
        'tdeEstoque,'
      '           m2.Financeiro, m2.Grupo'
      '    FROM'
      '    ('
      '      SELECT m1.data, m1.Produto, m1.Filial,'
      '            (SELECT MAX(m2.Lancto)'
      '                FROM Movimentos m2'
      '                WHERE m2.Produto = m1.Produto'
      '                  AND m2.Filial  = m1.Filial'
      '                  AND m2.Data    = m1.Data) AS Lancto'
      '      FROM'
      '      ('
      '        SELECT MAX(m1.Data) AS Data, m1.Produto, m1.Filial'
      '           FROM Movimentos m1'
      '                JOIN Produtos p        ON p.Codigo = m1.Produto'
      
        '                JOIN Caracteristicas c ON c.Codigo = p.Caracteri' +
        'stica'
      '           WHERE m1.Data < (CAST(:DataFinal AS DATE)+1)'
      #9#9'   '
      
        '             AND ((m1.Data < '#39'2012-06-01'#39') OR m1.TipoMovimento N' +
        'OT IN ('#39'EN2'#39', '#39'NFN'#39', '#39'RIE'#39'))'
      
        '             AND ((:DataInicial <= '#39'2012-06-01'#39') OR (c.TipoProdu' +
        'to = '#39'01'#39')) /* Mat'#233'ria-prima */'
      ''
      '        GROUP BY m1.Produto, m1.Filial'
      '        ORDER BY m1.Produto, m1.Filial'
      '      ) AS m1'
      '    ) AS m1 JOIN Movimentos m2 ON m1.Data    = m2.Data    AND'
      '                                  m1.Lancto  = m2.Lancto  AND'
      '                                  m1.Produto = m2.Produto AND'
      '                                  m1.Filial  = m2.Filial'
      '    ORDER BY m1.Produto, m1.Filial'
      '  ) AS ep'
      ''
      '  WHERE QtdeEstoque > 0'
      ') AS ep'
      'GROUP BY Grupo'
      'ORDER BY Grupo')
    RequestLive = False
    Left = 40
    Top = 88
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end>
