procedure TfrmCadastroOperacoes.edfCopiaC3KeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (key =VK_return) then
    if not fraConsultaProcesso.qryProcuraOperacoes.isempty then
    begin
      if (MensagemConfirmacao('A importação dos processos de controle da operação:  '+
                              fraConsultaProcesso.qryProcuraOperacoesnome.AsString + ' '+
                              fraConsultaProcesso.qryProcuraOperacoesc01.AsString + ' ' +
                              fraConsultaProcesso.qryProcuraOperacoesc02.AsString + ' ' +
                              fraConsultaProcesso.qryProcuraOperacoesc03.AsString) = smbOk) then
        dtmCadastroOperacoes.importarprocessoscontrole(fraConsultaProcesso.qryProcuraOperacoescodigo.AsInteger);
    end;
end;

end.
