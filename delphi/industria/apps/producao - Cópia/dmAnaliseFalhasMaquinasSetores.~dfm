      item
        DataType = ftUnknown
        Name = 'FiltroFalhas'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT SetorProducao,'
      '       maquina,'
      '       descricaomaquina,'
      
        '       Falha, Descricaofalha, SUM(QuantidadePerda) AS Quantidade' +
        ', ROUND(SUM(QuantidadePerda * COALESCE(CustoFalha)),2) AS TotalC' +
        'usto,'
      '       TipoFalha'
      'FROM'
      ''
      '('
      
        ' SELECT oouf.Falha,  f.descricao as descricaofalha, oouf.Quantid' +
        'adePerda, f.CustoFalha, m.SetorProducao, oou.Maquina, m.descrica' +
        'o as descricaomaquina,'
      ''
      '        CAST(CASE WHEN f.TipoFalha = '#39'I'#39' THEN '#39'INERENTE'#39
      '                  WHEN f.TipoFalha = '#39'R'#39' THEN '#39'RETRABALHO'#39
      '                  WHEN f.TipoFalha = '#39'P'#39' THEN '#39'PERDA TOTAL'#39
      '                                         ELSE '#39#39
      '             END AS VARCHAR) AS TipoFalha,'
      ''
      '       (SELECT cp.PN'
      '           FROM ClientesProdutos cp'
      '           WHERE cp.Cliente     = osp.Cliente     AND'
      '                 cp.TipoCliente = osp.TipoCliente AND'
      '                 cp.Produto     = osp.Produto LIMIT 1) AS PN'
      ''
      ' FROM OperacoesOSPUsuario oou'
      
        '         JOIN ((select * from OperacoesOSPUsuarioFalhas_(cast(:D' +
        'ataInicial as date), cast(:DataFinal as date), cast(null as char' +
        '))) oouf'
      '                    JOIN Falhas f ON oouf.Falha = f.Codigo)'
      ''
      
        '              ON oou.OSP  = oouf.OSP  AND oou.Operacao = oouf.Op' +
        'eracao AND oou.Data   = oouf.Data AND'
      
        '                 oou.Lote = oouf.Lote AND oou.Usuario  = oouf.Us' +
        'uario  AND oou.Inicio = oouf.Inicio'
      ''
      '         JOIN OSP ON osp.Numero = oou.OSP'
      ''
      '       JOIN Maquinas m'
      '           JOIN SetoresProducao sp'
      '             ON sp.Codigo = m.SetorProducao'
      ''
      
        '      ON m.Codigo = COALESCE(oou.Maquina, (SELECT om.Maquina FRO' +
        'M OperacoesMaquinas om'
      
        '                                              WHERE om.Operacao ' +
        '= oou.Operacao LIMIT 1))'
      ''
      ''
      ' WHERE TRUE'
      '       %FiltroPeriodo'
      '       %FiltroSetores'
      '       %FiltroMaquinas'
      '       %FiltroFalhas'
      ''
      ''
      ') AS selecao'
      ''
      
        'GROUP BY SetorProducao, maquina, descricaomaquina, Falha, Descri' +
        'caofalha, TipoFalha'
      
        'order BY SetorProducao, maquina, descricaomaquina, Falha, Descri' +
        'caofalha, TipoFalha'
      ''
      '/* PAR'#194'METROS'
      ':DataInicial'
      ':DataFinal'
      '*/'
      ''
      '')
    RequestLive = False
    Left = 88
    Top = 80
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
