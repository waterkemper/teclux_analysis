    Sql.Strings = (
      ';'
      'SELECT SetorProducao,'
      '       maquina,'
      '       descricaomaquina,'
      
        '       codigoparada, Descricaoparada, SUM(tempoparada) AS TempoP' +
        'arada'
      'FROM'
      ''
      '('
      
        ' SELECT ooup.codigoparada,  mp.descricao as descricaoparada, oou' +
        'p.tempoparada, m.SetorProducao, oou.Maquina, m.descricao as desc' +
        'ricaomaquina'
      ' FROM OperacoesOSPUsuario oou'
      '         JOIN operacoesospusuarioparadas ooup'
      
        '               JOIN motivosParadas mp ON ooup.codigoparada = mp.' +
        'Codigo'
      ''
      '         ON oou.numero = ooup.numero_operacoesospusuario'
      ''
      '         JOIN OSP ON osp.Numero = oou.OSP'
      ''
      '       JOIN Maquinas m'
      '           JOIN SetoresProducao sp'
      '             ON sp.Codigo = m.SetorProducao'
      ''
      
        '      ON m.Codigo = COALESCE(oou.Maquina, (SELECT om.Maquina FRO' +
        'M OperacoesMaquinas om'
      
        '                                              WHERE om.Operacao ' +
        '= oou.Operacao LIMIT 1))'
      ''
      ' WHERE TRUE'
      '       %FiltroPeriodo'
      '       %FiltroSetores'
      '       %FiltroMaquinas'
      '       %FiltroParadas'
      ''
      ''
      ') AS selecao'
      ''
      
        'GROUP BY SetorProducao, maquina, descricaomaquina, codigoparada,' +
        ' Descricaoparada'
      
        'order BY SetorProducao, maquina, descricaomaquina, codigoparada,' +
        ' Descricaoparada'
      ''
      '/* PAR'#194'METROS'
      ':DataInicial'
      ':DataFinal'
      '*/'
      ''
      '')
    RequestLive = False
