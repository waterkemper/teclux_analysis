    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select fcip.*,'
      '       p.codigovisual,'
      '       (select cp.pn'
      '        from clientesprodutos cp'
      '        where cp.produto = p.codigo'
      '          and cp.pn is not null'
      '          and cp.cliente<>1'
      '          and cp.tipocliente<>'#39'L'#39' limit 1) as pn,'
      '       p.descricao'
      ''
      'from fciprodutos fcip'
