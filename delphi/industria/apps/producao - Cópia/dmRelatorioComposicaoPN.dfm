  object qryProdutosCompostos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'codigo = composto'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrClientesProdutos
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'ListadePNs'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 's'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      
        'select pc.composto, pc.ordem, pc.quantidade, c.unidade, p.codigo' +
        'visual as componente'
      'from produtoscompostos pc'
      '     join produtos p'
      '          join caracteristicas c'
      '          on p.caracteristica = c.codigo'
      '     on pc.componente = p.codigo'
      'where True'
      '%ListadePNs'
      
        '/*and pc.composto in (select cp.composto from clientesprodutos c' +
        'p where cp.pn in (%s))*/     '
      'order by pc.composto, pc.ordem, pc.componente')
    RequestLive = False
    Left = 192
    Top = 208
    object qryProdutosCompostoscomposto: TLargeintField
      FieldName = 'composto'
    end
    object qryProdutosCompostosordem: TIntegerField
      FieldName = 'ordem'
      DisplayFormat = '0'
    end
