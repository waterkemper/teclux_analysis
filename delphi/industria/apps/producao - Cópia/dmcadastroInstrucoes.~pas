procedure TdtmCadastroInstrucoes.qryInstrucoesTrabalhoOperacoesBeforeDelete(
  DataSet: TDataSet);
var
  i:integer;
begin
  inherited;
  for i:=0 to ListaTempoPadraoOriginal[operacao].Count-1 do
  begin
    if qryInstrucoesTrabalhoOperacoesoperacao.AsString = ListaTempoPadraoOriginal[operacao].Strings[i] then
    begin
      ListaTempoPadraoOriginal[operacao].Delete(i);
      ListaTempoPadraoOriginal[tempo].Delete(i);
      break;
    end;
  end;      
end;

