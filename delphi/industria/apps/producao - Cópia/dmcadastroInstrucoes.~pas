function TdtmCadastroInstrucoes.SalvarInstrucaoperacoes: boolean;
begin
  result := true;
  if (qryInstrucoesTrabalhoOperacoes.State in [dsedit, dsinsert]) then
  begin
    if qryInstrucoesTrabalhoOperacoes.CheckRequiredFields then
      qryInstrucoesTrabalhoOperacoes.Post
    else
      result := false;
  end;

end;

procedure TdtmCadastroInstrucoes.qryInstrucoesTrabalhoOperacoesAfterOpen(
  DataSet: TDataSet);
begin
  AtualizaListaOperacoes;

  ListaTempoPadraoOriginal[operacao] := TStringList.Create;    // Guarda os valores originais de tempo padrao
  ListaTempoPadraoOriginal[tempo]    := TStringList.Create;    // para posterior update

  while Not qryInstrucoesTrabalhoOperacoes.Eof do
  begin
    ListaTempoPadraoOriginal[operacao].Append(qryInstrucoesTrabalhoOperacoesoperacao.AsString);
    ListaTempoPadraoOriginal[tempo].Append(qryInstrucoesTrabalhoOperacoestempopadrao.AsString);
    qryInstrucoesTrabalhoOperacoes.Next;
  end;
  qryInstrucoesTrabalhoOperacoes.First;

  inherited;
  
end;

procedure TdtmCadastroInstrucoes.qryInstrucoesTrabalhoOperacoesAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  EditarInstrucoes;
  AtualizaListaOperacoes;
end;

procedure TdtmCadastroInstrucoes.qryInstrucoesTrabalhoOperacoesAfterDelete(
