    begin
       qryInstrucoes.Delete;
       Perpetrar([qryInstrucoes]);
       RefazConsultaPorNome(qryRegistrodasOperacoes,['Instrucao'],[qryInstrucoescodigo.AsVariant]);
    end;
end;

function TdtmCadastroInstrucoes.GravarInstrucao: boolean;
var
  CodigoInstrucaoGerado,
  i: integer;
  ListaTempoPadrao: array[1..2] of TStringList;

  function AtribuirCodigo: boolean;
  var
    j:integer;
  begin
    result := true;
//    i:=1;
    ListaTempoPadrao[Operacao] := TStringList.Create;
    ListaTempoPadrao[Tempo]    := TStringList.Create;
    GuardarRegistroAtual(qryInstrucoesTrabalhoOperacoes,true);
    qryInstrucoesTrabalhoOperacoes.First;
    while not qryInstrucoesTrabalhoOperacoes.Eof do
    begin
      if qryInstrucoesTrabalhoOperacoesInstrucaotrabalho.AsInteger = CodigoInstrucaoGerado then
      begin
        qryInstrucoesTrabalhoOperacoes.Edit;
        if qryInstrucoesTrabalhoOperacoesinstrucaotrabalho.AsInteger <> qryInstrucoescodigo.AsInteger then
          qryInstrucoesTrabalhoOperacoesinstrucaotrabalho.AsInteger := qryInstrucoescodigo.AsInteger;
        qryInstrucoesTrabalhoOperacoes.Post;
      end;
      (* COMPARA O VALOR DO TEMPO PADRAO COM O ORIGINAL E GUARDA EM "LISTATEMPOPADRAO" P/ GERAR O UPDATE *)
      for j:=0 to ListaTempoPadraoOriginal[operacao].Count-1 do
      begin
        if (ListaTempoPadraoOriginal[operacao].Strings[j] = qryInstrucoesTrabalhoOperacoesoperacao.AsString) and
           (ListaTempoPadraoOriginal[tempo].Strings[j] <> qryInstrucoesTrabalhoOperacoestempopadrao.AsString) then
        begin
          ListaTempoPadrao[Operacao].Append(qryInstrucoesTrabalhoOperacoesoperacao.AsString);
          ListaTempoPadrao[Tempo].Append(qryInstrucoesTrabalhoOperacoestempopadrao.AsString);
          break;
        end;
      end;

      result := qryInstrucoesTrabalhoOperacoes.CheckRequiredFields;
      if not result then
        break
      else
        Inc(i);
      qryInstrucoesTrabalhoOperacoes.Next;
    end;
    VoltarRegistroAtual(qryInstrucoesTrabalhoOperacoes);
  end;

begin
  result := false;
  if (qryInstrucoes.CheckRequiredFields) then
  begin
    if SalvarInstrucaoperacoes then
    begin
      CodigoInstrucaoGerado := qryInstrucoescodigo.AsInteger;
      if qryInstrucoes.State = dsinsert then
          qryInstrucoescodigo.AsInteger := ProximoCodigo;

      if AtribuirCodigo then
      begin
        qryInstrucoes.Post;
        result := Perpetrar([qryInstrucoes,
                             qryInstrucoesTrabalhoOperacoes]);

        {if Result then
          for i := 0 to ListaTempoPadrao[Operacao].Count - 1 do
          begin
            updOperacoes.Close;
            updOperacoes.ParamByName('tempo').AsCurrency   := StrToCurr(ListaTempoPadrao[Tempo].Strings[i]);
            updOperacoes.ParamByName('operacao').AsInteger := StrToInt(ListaTempoPadrao[Operacao].Strings[i]);
            updOperacoes.ExecSql;
          end;   }
        RefazConsultaPorNome(qryRegistrodasOperacoes,['Instrucao'],[qryInstrucoescodigo.AsVariant]);
      end;
    end;
  end;
end;

