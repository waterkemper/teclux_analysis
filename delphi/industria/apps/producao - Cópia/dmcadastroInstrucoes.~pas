procedure TdtmCadastroInstrucoes.imprimir(dataInicialInclusao,
  dataFinalInclusao, dataInicialAlteracao, dataFinalAlteracao: String;
  ordenacao: integer);
const
  SQLDataInicial = 'and cast(trigger_changed as date) between :datainicialalteracao and :datafinalalteracao';
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
  if (dataInicialInclusao<>'') and (dataFinalInclusao<>'') then
  begin
    qryImprimirInstrucoes.MacroByName('datainclusao').asstring := 'and cast(trigger_changed as date) between :datainicialinclusao and :datafinalinclusao';
    qryImprimirInstrucoes.MacroByName('InclusaoInstrucoes').asstring := 'and cast(datahorainclusao as date) between :datainicialinclusao and :datafinalinclusao';

    qryImprimirInstrucoes.paramByName('datainicialinclusao').AsDateTime := strtodatetime(dataInicialinclusao);
    qryImprimirInstrucoes.paramByName('datafinalinclusao').AsDateTime := strtodatetime(dataFinalinclusao);

  end
   else
  if (dataInicialinclusao<>'') and (dataFinalinclusao='') then
  begin
    qryImprimirInstrucoes.MacroByName('datainclusao').asstring := 'and cast(trigger_changed as date) >= :datainicialinclusao';
    qryImprimirInstrucoes.MacroByName('InclusaoInstrucoes').asstring := 'and cast(datahorainclusao as date) >= :datainicialinclusao';
    qryImprimirInstrucoes.paramByName('datainicialinclusao').AsDateTime := strtodatetime(dataInicialinclusao);
    qryImprimirInstrucoes.paramByName('datafinalinclusao').clear;
  end
  else
  if (dataInicialinclusao='') and (dataFinalinclusao<>'') then
  begin
    qryImprimirInstrucoes.MacroByName('datainclusao').asstring := 'and cast(trigger_changed as date) <= :datafinalinclusao';
    qryImprimirInstrucoes.MacroByName('InclusaoInstrucoes').asstring := 'and cast(datahorainclusao as date) <= :datafinalinclusao';
    qryImprimirInstrucoes.paramByName('datainicialinclusao').clear;
    qryImprimirInstrucoes.paramByName('datafinalinclusao').AsDateTime := strtodatetime(dataFinalinclusao);
  end
  else
  if (dataInicialinclusao='') and (dataFinalinclusao='') then
  begin
    qryImprimirInstrucoes.MacroByName('datainclusao').asstring := '';
    qryImprimirInstrucoes.MacroByName('InclusaoInstrucoes').asstring := '';
    qryImprimirInstrucoes.paramByName('datainicialinclusao').clear;
    qryImprimirInstrucoes.paramByName('datafinalinclusao').clear;
  end;



  if (dataInicialalteracao<>'') and (dataFinalalteracao<>'') then
  begin
    qryImprimirInstrucoes.MacroByName('dataalteracao').asstring := 'and cast(trigger_changed as date) between :datainicialalteracao and :datafinalalteracao';
    qryImprimirInstrucoes.MacroByName('AlteracaoInstrucoes').asstring := 'and cast(datahoraalteracao as date) between :datainicialalteracao and :datafinalalteracao';
    qryImprimirInstrucoes.paramByName('datainicialalteracao').AsDateTime := strtodatetime(dataInicialAlteracao);
    qryImprimirInstrucoes.paramByName('datafinalalteracao').AsDateTime := strtodatetime(dataFinalAlteracao);
  end
  else
  if (dataInicialalteracao<>'') and (dataFinalalteracao='') then
  begin
    qryImprimirInstrucoes.MacroByName('dataalteracao').asstring := 'and cast(trigger_changed as date) >= :datainicialalteracao';
    qryImprimirInstrucoes.MacroByName('AlteracaoInstrucoes').asstring := 'and cast(datahoraalteracao as date) >= :datainicialalteracao';
    qryImprimirInstrucoes.paramByName('datainicialalteracao').AsDateTime := strtodatetime(dataInicialAlteracao);
    qryImprimirInstrucoes.paramByName('datafinalalteracao').clear;
  end
  else
  if (dataInicialalteracao='') and (dataFinalalteracao<>'') then
  begin
    qryImprimirInstrucoes.MacroByName('dataalteracao').asstring := 'and cast(trigger_changed as date) <= :datafinalalteracao';
    qryImprimirInstrucoes.MacroByName('AlteracaoInstrucoes').asstring := 'and cast(datahoraalteracao as date) <= :datafinalalteracao';
    qryImprimirInstrucoes.paramByName('datainicialalteracao').clear;
    qryImprimirInstrucoes.paramByName('datafinalalteracao').AsDateTime := strtodatetime(dataFinalAlteracao);
  end
  else
  if (dataInicialalteracao='') and (dataFinalalteracao='') then
  begin
    qryImprimirInstrucoes.MacroByName('dataalteracao').asstring := '';
    qryImprimirInstrucoes.MacroByName('AlteracaoInstrucoes').asstring := '';
    qryImprimirInstrucoes.paramByName('datainicialalteracao').clear;
    qryImprimirInstrucoes.paramByName('datafinalalteracao').clear;
  end;

  case ordenacao of
  0: begin
       qryImprimirInstrucoes.MacroByName('Ordenacao').asstring := 'order by f.codigo';
     end;
  1: begin
       qryImprimirInstrucoes.MacroByName('Ordenacao').asstring := 'order by f.descricao';
     end;
  end;


  frmPreview := TfrmPreviewPadrao.create(self);
  frmPreview.cmbZoom.ItemIndex := 3; //125%
  try
   Relatorio := frmPreview.frCompositeReport;
   with frmPreview do
   begin
     frCompositeReport.Reports.Clear;
     frCompositeReport.DoublePass:= True;
     frVariables['TITULO'] := 'CADASTRO DE Instrucoes';
     frVariables['SUBTITULO'] := '';
     frCompositeReport.Reports.Add(frpImprimirInstrucoes);
     Relatorio.Preview := frmPreview.frPreviewPadrao;
     Relatorio.ShowReport;
     frmPreview.ShowModal;
   end;
  finally
   frmPreview.Free
  end; 

end;

