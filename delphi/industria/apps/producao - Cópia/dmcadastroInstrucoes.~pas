procedure TdtmCadastroInstrucoes.AtualizaListaOperacoes;
var
  Pos: TBookmark;
  i,j : integer;
  vOperacaoAnterior : String;
begin
  Pos := qryInstrucoesTrabalhoOperacoes.GetBookmark;
  qryInstrucoesTrabalhoOperacoes.DisableControls;
  i := 0;
  j := 0;

  try
    ListaOperacoesSelecionadas := '';

    qryInstrucoesTrabalhoOperacoes.AfterEdit := nil;
    qryInstrucoesTrabalhoOperacoes.AfterPost := nil;
    vOperacaoAnterior := '';
    qryInstrucoesTrabalhoOperacoes.First;
    while Not qryInstrucoesTrabalhoOperacoes.Eof do
    begin
      if qryInstrucoesTrabalhoOperacoesoperacao.AsString<>'' then
        if ListaOperacoesSelecionadas <> '' then
          ListaOperacoesSelecionadas := ListaOperacoesSelecionadas + ', '+
                                       qryInstrucoesTrabalhoOperacoesoperacao.AsString
        else
          ListaOperacoesSelecionadas := qryInstrucoesTrabalhoOperacoesoperacao.AsString;

      {if (qryInstrucoesTrabalhoOperacoestipooperacao.AsString = 'N') then
      begin
        i := i + 1;
        j := 0;

        if qryInstrucoesTrabalhoOperacoessequencia.AsString <> inttostr(i) then
        begin
          qryInstrucoesTrabalhoOperacoes.Edit;
          qryInstrucoesTrabalhoOperacoessequencia.AsString := inttostr(i);
        end;

        vOperacaoAnterior := qryInstrucoesTrabalhoOperacoesoperacao.AsString;
      end
      else
      if (qryInstrucoesTrabalhoOperacoesorigemoperacaoalternativa.AsString = vOperacaoAnterior) then
      begin
        j := j + 1;
        if  qryInstrucoesTrabalhoOperacoessequencia.AsString <> inttostr(i)+'.'+inttostr(j) then
        begin
          qryInstrucoesTrabalhoOperacoes.Edit;
          qryInstrucoesTrabalhoOperacoessequencia.AsString := inttostr(i)+'.'+
                                                       inttostr(j);
        end;
      end; }

      qryInstrucoesTrabalhoOperacoes.Next;

    end;


  finally

  if ListaOperacoesSelecionadas = ''
  then ListaOperacoesSelecionadas := '0';


    qryInstrucoesTrabalhoOperacoes.AfterEdit := qryInstrucoesTrabalhoOperacoesAfterEdit;
    qryInstrucoesTrabalhoOperacoes.AfterPost := qryInstrucoesTrabalhoOperacoesAfterPost;

    qryInstrucoesTrabalhoOperacoes.GotoBookmark(Pos);
    qryInstrucoesTrabalhoOperacoes.FreeBookmark(Pos);


    qryInstrucoesTrabalhoOperacoes.EnableControls;
  end;
end;


