  begin
    ListaTempoPadraoOriginal[operacao].Append(qryInstrucoesTrabalhoOperacoesoperacao.AsString);
    ListaTempoPadraoOriginal[tempo].Append(qryInstrucoesTrabalhoOperacoestempopadrao.AsString);
  end
  {else
  if field = qryInstrucoesTrabalhoOperacoestipooperacao then
  begin
    if field.Value = 'N' then
    begin
      dsrInstrucoesTrabalhoOperacoes.OnDataChange := nil;
      qryInstrucoesTrabalhoOperacoesorigemoperacaoalternativa.Clear;
      dsrInstrucoesTrabalhoOperacoes.OnDataChange := dsrInstrucoesTrabalhoOperacoesDataChange;
    end;
  end;}
end;

