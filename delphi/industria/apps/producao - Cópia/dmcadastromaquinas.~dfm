    Sql.Strings = (
      ';'
      'select m.*'
      'from'
      '('
      'select m.*,'
      ''
      '       (select opl.trigger_user'
      '        from maquinas_log opl'
      '        where trigger_mode = '#39'INSERT'#39
      '          and opl.codigo = m.codigo'
      '          %datainclusao'
      '        order by opl.trigger_changed desc limit 1'
      '       )  as UsuarioInclusao,'
      ''
      '       (select opl.trigger_changed'
      '        from maquinas_log opl'
      '        where trigger_mode = '#39'INSERT'#39
      '          and opl.codigo = m.codigo'
      '          %datainclusao'
      '        order by opl.trigger_changed desc limit 1'
      '       )  as DataHoraInclusao,'
      ''
      ''
      '('
      'SELECT selecao.usuarioalteracao FROM'
      '('
      '     ('
      '     select opl.trigger_user as usuarioAlteracao,'
      #9#9#9'opl.trigger_changed as dataHoraAlteracao'
      '       from maquinas_log opl'
      '        where opl.codigo = m.codigo'
      '         %dataalteracao'
      ''
      '          and opl.trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '          and opl.trigger_tuple = '#39'new'#39
      '         order by opl.trigger_changed desc limit 1'
      '      )'
      ''
      #9'union all'
      ''
      #9'  ('
      '      select opl.trigger_user as usuarioAlteracao,'
      #9#9#9' opl.trigger_changed as dataHoraAlteracao'
      '       from operacoesmaquinas_log opl'
      '        where opl.maquina = m.codigo'
      '        %dataalteracao'
      ''
      '         and opl.trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '          and opl.trigger_tuple = '#39'new'#39
      '        order by opl.trigger_changed desc limit 1'
      '        )'
      ') AS selecao'
      '  order by dataHoraAlteracao desc limit 1) as usuarioalteracao,'
      ''
      ''
      ''
      ' ('
      ' select selecao.DataHoraAlteracao from'
      ' ('
      #9
      
        #9'   (select cast(to_char(opl.trigger_changed, '#39'DD/MM/YY HH24:MI:' +
        'SS'#39') as varchar(20)) as datahoraalteracao'
      '        from maquinas_log opl'
      '         where opl.codigo = m.codigo'
      '          %dataalteracao'
      '          and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '          and trigger_tuple = '#39'new'#39
      '         order by opl.trigger_changed desc limit 1'
      '       )'
      #9'   union all'
      
        #9'   (select cast(to_char(opl.trigger_changed, '#39'DD/MM/YY HH24:MI:' +
        'SS'#39') as varchar(20))as datahoraalteracao'
      '        from operacoesmaquinas_log opl'
      '         where opl.maquina = m.codigo'
      '          %dataalteracao'
      '          and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '          and trigger_tuple = '#39'new'#39
      '         order by opl.trigger_changed desc limit 1'
      '       )'
      
        ')as selecao'#9'order by datahoraalteracao limit 1)   as DataHoraAlt' +
        'eracao,'
      ''
      ''
      '      (select selecao.operacao from'
      #9'  ('
      
        #9'  (select cast(case when trigger_mode = '#39'INSERT'#39' THEN '#39'INCLUS'#195'O' +
        #39
      
        '                                        else '#39'ALTERA'#199#195'O'#39' end as ' +
        'varchar(10)) as operacao,'
      #9#9#9#9#9'opl.trigger_changed as dataHoraAlteracao'
      '        from maquinas_log opl'
      '         where opl.codigo = m.codigo'
      '         %dataalteracao'
      '          and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '          and trigger_tuple = '#39'new'#39
      '         order by opl.trigger_changed desc limit 1'
      '        )'
      #9'    union all'
      ''
      
        #9'    (select cast(case when trigger_mode = '#39'INSERT'#39' THEN '#39'INCLUS' +
        #195'O'#39
      
        '                                        else '#39'ALTERA'#199#195'O'#39' end as ' +
        'varchar(10)) as operacao,'
      #9#9#9#9#9'opl.trigger_changed as dataHoraAlteracao'
      '        from operacoesmaquinas_log opl'
      '         where opl.maquina = m.codigo'
      '        %dataalteracao'
      '          and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '          and trigger_tuple = '#39'new'#39
      '         order by opl.trigger_changed desc limit 1'
      '        )'
      #9#9')as selecao'
      #9#9'order by dataHoraAlteracao desc limit 1) as operacao,'
      ''
      '       (select selecao.tabela'
      '        FROM'
      '        ('
      '        ('
      '         select cast('#39'M'#193'QUINAS'#39' as varchar(30)) as tabela,'
      '                opl.trigger_changed as dataHoraAlteracao'
      '         from maquinas_log opl'
      '          where opl.codigo = m.codigo'
      '          %dataalteracao'
      '           and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '           and trigger_tuple = '#39'new'#39
      '          order by opl.trigger_changed desc limit 1'
      '         )'
      '         union all'
      '        ('
      '         select cast('#39'OP. M'#193'QUINAS'#39' as varchar(30)) as tabela,'
      '                opl.trigger_changed as dataHoraAlteracao'
      '         from operacoesmaquinas_log opl'
      '          where opl.maquina = m.codigo'
      '          %dataalteracao'
      '           and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '           and trigger_tuple = '#39'new'#39
      '          order by opl.trigger_changed desc limit 1'
      '         )'
      '        ) as selecao'
      '        order by dataHoraAlteracao desc limit 1) as Tabela'
      ''
      'from maquinas m'
      ') as m'
      'where true'
      '%InclusaoMaquinas'
      '%AlteracaoMaquinas'
      ''
      '%Ordenacao'
      ''
      ''
      '/*'
      ''
      ':datainicialinclusao'
