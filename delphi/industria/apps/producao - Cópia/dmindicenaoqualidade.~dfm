    Sql.Strings = (
      ';'
      
        'SELECT SetorProducao, Maquina, MaquinaDescricao, Operador, Opera' +
        'dorNome, Parada, ParadaDescricao, TempoParada, PN'
      'FROM'
      ''
      '('
      ' SELECT  m.SetorProducao,'
      '         m.Codigo AS Maquina, m.Descricao AS MaquinaDescricao,'
      ''
      '         oou.Usuario AS Operador,'
      ''
      '        (SELECT u.Nome'
      '            FROM Usuarios u'
      '            WHERE u.Codigo = oou.Usuario) AS OperadorNome,'
      ''
      '         mp.Codigo AS Parada, mp.Descricao AS ParadaDescricao,'
      ''
