    Sql.Strings = (
      ';'
      'SELECT PN, Nome, C01, C02, C03, '
      '       QtdeProduzida,'
      '      (QtdePerdaInerente + QtdePerdaTotal) AS QtdeTotalPerda,'
      
        '       ROUND((QtdePerdaInerente + QtdePerdaTotal) * COALESCE(Cus' +
        'toFalha), 2) AS CustoNaoQualidade,'
      ''
      '       PPM,'
      
        '      ((1000000 * (QtdePerdaInerente + QtdePerdaTotal)) / QtdePr' +
        'oduzida) AS PPM_Periodo'
      'FROM'
      ''
      '('
      ' SELECT o.Nome, o.C01, o.C02, o.C03, o.PPM, f.CustoFalha,'
      ''
      '       (SELECT cp.PN'
      '           FROM ClientesProdutos cp'
      '           WHERE cp.Cliente     = OSP.Cliente     AND'
      '                 cp.TipoCliente = OSP.TipoCliente AND'
      '                 cp.Produto     = OSP.Produto LIMIT 1) AS PN,'
      ''
      '        SUM(CASE WHEN f.TipoFalha = '#39'I'#39
      '                 THEN COALESCE(oouf.QuantidadePerda,0)'
      '                 ELSE 0'
      '            END) AS QtdePerdaInerente,'
      ''
      '        SUM(CASE WHEN f.TipoFalha = '#39'P'#39
      '                 THEN COALESCE(oouf.QuantidadePerda,0)'
      '                 ELSE 0'
      '            END) AS QtdePerdaTotal,'
      ''
      '        SUM(oou.Quantidade) AS QtdeProduzida'
      ''
      ''
      ' FROM ((OperacoesOSPUsuario oou'
      
        '        JOIN ( (select * from OperacoesOSPUsuarioFalhas_(cast(:D' +
        'ataInicial as date), cast(:DataFinal as date))) oouf'
      
        '                   JOIN Falhas f ON oouf.Falha = f.Codigo AND f.' +
        'TipoFalha IN ('#39'I'#39',  /* [I]nerente ao processo */'
      
        '                                                                ' +
        '              '#39'P'#39')) /* [P]erda Total          */'
      ''
      
        '                   ON oou.OSP  = oouf.OSP  AND oou.Operacao = oo' +
        'uf.Operacao AND oou.Data   = oouf.Data AND'
      
        '                      oou.Lote = oouf.Lote AND oou.Usuario  = oo' +
        'uf.Usuario  AND oou.Inicio = oouf.Inicio )'
      ''
      '             JOIN OSP         ON OSP.Numero   = oou.OSP'
      '             JOIN Operacoes o ON oou.Operacao = o.Codigo)'
      ''
      ''
      ''
      ''
      ' FROM OperacoesOSPUsuario oou'
      
        '         JOIN ((select * from OperacoesOSPUsuarioFalhas_(cast(:D' +
        'ataInicial as date), cast(:DataFinal as date))) oouf'
      '                    JOIN Falhas f ON oouf.Falha = f.Codigo)'
      ''
      
        '              ON oou.OSP  = oouf.OSP  AND oou.Operacao = oouf.Op' +
        'eracao AND oou.Data   = oouf.Data AND'
      
        '                 oou.Lote = oouf.Lote AND oou.Usuario  = oouf.Us' +
