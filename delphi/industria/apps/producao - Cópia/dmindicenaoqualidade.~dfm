      '        JOIN (OperacoesOSPUsuarioParadas ooup'
      
        '                   JOIN MotivosParadas mp ON ooup.CodigoParada =' +
        ' mp.Codigo)'
      ''
      
        '                   ON oou.OSP  = ooup.OSP  AND oou.Operacao = oo' +
        'up.Operacao AND oou.Data   = ooup.Data AND'
      
