    Sql.Strings = (
      'SELECT OSP.Numero,'
      '       OSP.Semana AS SemanaNormal,'
      
        '       CAST(TRIM(TO_CHAR(OSP.Semana, '#39'00'#39')) AS VARCHAR) AS Seman' +
        'a,'
      '       CAST(OSP.Ano AS VARCHAR) AS Ano,'
      
        '       CAST(TRIM(TO_CHAR(OSP.Semana,'#39'00'#39')) || '#39'/'#39' || OSP.Ano AS ' +
        'VARCHAR) AS Marcador,'
      '       OSP.Prioridade,'
      '       OSP.Produto,'
      '       OSP.Data,'
      '       OSP.Cliente,'
      '       cl.Nome AS NomeCliente,'
      '       CASE WHEN c.Unidade = '#39'MIL'#39
      '            THEN 1000 * OSP.Quantidade'
      '            ELSE OSP.Quantidade'
      '       END AS Quantidade,'
      ''
      '       CASE WHEN c.Unidade = '#39'MIL'#39
      '            THEN 1000 * (SELECT SUM(pdf.Quantidade)'
      '                            FROM DadosFiscais df'
      '                                 JOIN ProdutosDadosFiscais pdf'
      
        '                                      ON df.Numero = pdf.DadoFis' +
        'cal'
      '                            WHERE df.Situacao = '#39'N'#39' AND'
      '                                  pdf.OSP = OSP.Numero)'
      '            WHEN c.Unidade = '#39'CT'#39
      '            THEN 100 * (SELECT SUM(pdf.Quantidade)'
      '                           FROM DadosFiscais df'
      '                                JOIN ProdutosDadosFiscais pdf'
      
        '                                     ON df.Numero = pdf.DadoFisc' +
        'al'
      '                           WHERE df.Situacao = '#39'N'#39' AND'
      '                                 pdf.OSP = OSP.Numero)'
      ''
      '            ELSE (SELECT SUM(pdf.Quantidade)'
      '                     FROM DadosFiscais df'
      '                          JOIN ProdutosDadosFiscais pdf'
      '                               ON df.Numero = pdf.DadoFiscal'
      '                     WHERE df.Situacao = '#39'N'#39' AND'
      '                           pdf.OSP = OSP.Numero)'
      '       END AS Entregue,'
      ''
      '       cp.Produto_Cliente,'
      '       p.CodigoVisual AS ProdutoVisual,'
      '       cp.PN'
      ''
      ''
      '   FROM OSP'
      '        JOIN Produtos p'
      '             JOIN Caracteristicas c'
      '                  ON p.Caracteristica = c.Codigo'
      '        ON OSP.Produto = p.Codigo'
      ''
      '        JOIN Clientes cl'
      '             ON OSP.Cliente = cl.Codigo'
      ''
      '        JOIN ClientesProdutos cp'
      '             ON OSP.Cliente = cp.Cliente AND'
      '                OSP.Produto = cp.Produto'
      ''
      '   WHERE NOT OSP.Cancelado AND'
      '         COALESCE(OSP.Quantidade,0) > 0 AND'
      '         COALESCE((SELECT SUM(pdf.Quantidade)'
      '                        FROM DadosFiscais df'
      '                             JOIN ProdutosDadosFiscais pdf'
      '                                  ON df.Numero = pdf.DadoFiscal'
      '                       WHERE df.Situacao = '#39'N'#39' AND'
      
        '                             pdf.OSP = OSP.Numero), 0) < OSP.Qua' +
        'ntidade'
      '   %Semana'
      '   %Cliente'
      
        '   GROUP BY OSP.Semana, OSP.Ano, OSP.Prioridade, c.Unidade, OSP.' +
        'Cliente,'
      
        '           OSP.Entrega, p.CodigoVisual, Produto_Cliente, OSP.Qua' +
        'ntidade,'
      '           Nome, OSP.Numero, OSP.Produto, OSP.Data, cp.PN'
      '   ORDER BY OSP.Entrega, Nome, OSP.Numero DESC')
