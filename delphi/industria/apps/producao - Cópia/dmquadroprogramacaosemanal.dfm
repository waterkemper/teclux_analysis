  object qryOsp: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryOspCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Semana'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Cliente'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'SELECT Selecao.*,'
      '       CASE WHEN Selecao.Unidade = '#39'MIL'#39
      '            THEN (SELECT SUM(1000 * pdf.Quantidade)'
      '                     FROM DadosFiscais df'
      '                          JOIN ProdutosDadosFiscais pdf'
      '                               ON df.Numero = pdf.DadoFiscal'
      '                     WHERE df.Situacao = '#39'N'#39' AND'
      '                           pdf.OSP = Selecao.Numero)'
      ''
      '            WHEN Selecao.Unidade = '#39'CT'#39
      '            THEN (SELECT SUM(100 * pdf.Quantidade)'
      '                     FROM DadosFiscais df'
      '                          JOIN ProdutosDadosFiscais pdf'
      '                               ON df.Numero = pdf.DadoFiscal'
      '                     WHERE df.Situacao = '#39'N'#39' AND'
      '                           pdf.OSP = Selecao.Numero)'
      ''
      '            ELSE (SELECT SUM(pdf.Quantidade)'
      '                     FROM DadosFiscais df '
      '                          JOIN ProdutosDadosFiscais pdf'
      '                               ON df.Numero = pdf.DadoFiscal'
      '                     WHERE df.Situacao = '#39'N'#39' AND'
      '                           pdf.OSP = Selecao.Numero) '
      '       END AS QtdeEntregue'
      ''
      'FROM (SELECT 0 AS Ordem,'
      '             OSP.Numero,'
      '             OSP.Semana AS SemanAnormal,'
      '             CASE WHEN OSP.Semana <= 9'
      '                  THEN CAST('#39'0'#39' || OSP.Semana AS VARCHAR)'
      '                  ELSE CAST(OSP.Semana AS VARCHAR)'
      '             END AS Semana,'
      ''
      '             CAST(OSP.Ano AS VARCHAR) AS Ano,'
      '             CAST(TRIM(TO_CHAR(OSP.Semana,'#39'00'#39')) '
      
        '                                      || '#39'/'#39' || OSP.Ano AS VARCH' +
        'AR) AS Marcador,'
      '             OSP.Prioridade,'
      '             OSP.Produto,'
      '             OSP.Data,'
      '             OSP.Cliente,'
      '             cl.Nome AS NomeCliente,'
      ''
      '             c.Unidade, '
      
        '             CASE WHEN c.Unidade = '#39'MIL'#39' THEN 1000 * OSP.Quantid' +
        'ade'
      
        '                  WHEN c.Unidade = '#39'CT'#39'  THEN  100 * OSP.Quantid' +
        'ade'
      
        '                                         ELSE        OSP.Quantid' +
        'ade'
      '             END AS Quantidade,'
      ''
      '             cp.Produto_Cliente,'
      '             p.CodigoVisual AS ProdutoVisual,'
      '             cp.PN'
      ''
      '         FROM OSP'
      '              JOIN (Produtos p'
      '                    JOIN Caracteristicas c'
      '                         ON p.Caracteristica = c.Codigo)'
      '              ON OSP.Produto = p.Codigo'
      ''
      '              JOIN Clientes cl'
      '                   ON OSP.Cliente = cl.Codigo'
      ''
      '             JOIN ClientesProdutos cp'
      '                  ON OSP.Cliente = cp.Cliente AND '
      '                     OSP.Produto = cp.Produto'
      ''
      '         WHERE NOT OSP.Cancelado AND'
      '               COALESCE((SELECT SUM(pdf.Quantidade)'
      '                            FROM DadosFiscais df'
      '                                 JOIN ProdutosDadosFiscais pdf'
      
        '                                      ON df.Numero = pdf.DadoFis' +
        'cal'
      '                            WHERE df.Situacao = '#39'N'#39' AND'
      
        '                                 pdf.OSP = OSP.Numero), 0) < OSP' +
        '.Quantidade'
      '               %Semana'
      '               %Cliente'
      ''
      
        '         GROUP BY OSP.Semana, OSP.Ano, OSP.prioriDade, OSP.Clien' +
        'te, p.CodigoVisual,'
      
        '                  Produto_Cliente, OSP.QuantiDade, Nome, OSP.Num' +
        'ero, OSP.Produto,'
      '                  OSP.data, cp.PN, c.Unidade'
      ''
      '         ORDER BY Semana, OSP.Ano, Nome, OSP.Numero DESC'
      '     ) AS Selecao'
      '')
    RequestLive = True
    Left = 48
    Top = 24
