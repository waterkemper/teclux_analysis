  object qryOSP: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryOSPAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Ordenacao'
        ParamType = ptUnknown
        Size = 100
      end>
    Sql.Strings = (
      'select osp.numero,'
      ' cp.produto_cliente,'
      ' cp.pn,'
      ' osp.entrega,'
      ' osp.semana,'
      ' osp.ano,'
      
        ' cast(cast(osp.semana as varchar)||'#39'/'#39'||substr(cast(osp.ano as v' +
        'archar),3,2) as varchar) as SemanaAno,'
      ' osp.prioridade,'
      ' osp.observacoes,'
      ' osp.produto,'
      ' osp.data,'
      ' osp.cliente,'
      
        ' (select c.apelido from clientes c where c.codigo = osp.cliente)' +
        ' as nomecliente,'
      ' osp.pedidocliente,'
      ' c.unidade,'
      ' case when c.unidade IN ('#39'ML'#39', '#39'MIL'#39') then osp.quantidade * 1000'
      '      when c.unidade IN ('#39'CT'#39')        then osp.quantidade * 100'
      '                                      else osp.quantidade'
      ' end as quantidade,'
      ' osp.preco,'
      ''
      ' p.codigovisual as produtovisual,'
      ' p.caracteristica,'
      ' c.codigovisual as caracteristicavisual,'
      ' (select sum(pdf.quantidade)'
      
        ' from DadosFiscais df join produtosdadosfiscais pdf on df.numero' +
        ' = pdf.dadofiscal'
      ' where df.situacao='#39'N'#39
      ' and pdf.osp = osp.numero) as qtdeentregue,'
      ' cast(null as numeric(11,2)) as qtdeTotal'
      'from osp'
      ''
      '     join (produtos p '
      '           join caracteristicas c '
      '           on p.caracteristica = c.codigo)'
      '     on osp.produto = p.codigo'
      ''
      '     join clientesprodutos cp '
      '     on osp.produto = cp.produto and'
      '        osp.cliente = cp.cliente   '
      'where osp.data between :datainicial and :datafinal'
      '%Ordenacao')
    RequestLive = False
    Left = 40
    Top = 40
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
