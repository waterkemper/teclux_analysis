  object qryMovimentacao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT m.TipoMovimento, c.Grupo, SUM(m.Valor) as Valor'
      ''
      'FROM Movimentos m'
      '     JOIN Produtos p        ON p.Codigo = m.Produto'
      '     JOIN Caracteristicas c ON c.Codigo = p.Caracteristica'
      ''
      '     WHERE m.Data BETWEEN :DataInicial AND :DataFinal'
      
        '/*             AND ((m.Data < '#39'2012-06-01'#39') OR  -- Mat'#233'ria-prima' +
        ' s'#243' passou a valer ap'#243's 31-MAI-2012'
      
        '             (NOT (m.Grupo IN ('#39'GERL'#39', '#39'QUIM'#39', '#39'MTPR'#39')) OR (c.Ti' +
        'poProduto = '#39'01'#39')))'
      '*/'
      'GROUP BY m.TipoMovimento, c.Grupo'
      'ORDER BY m.TipoMovimento, c.Grupo')
    RequestLive = False
    Left = 40
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object qryMovimentacaotipomovimento: TStringField
      FieldName = 'tipomovimento'
      Size = 3
    end
    object qryMovimentacaogrupo: TStringField
      FieldName = 'grupo'
      Size = 4
    end
    object qryMovimentacaovalor: TFloatField
      FieldName = 'valor'
      DisplayFormat = '0.00'
    end
  end
  object qryEstoquePeriodo: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT Grupo, SUM(Financeiro) AS Financeiro'
      'FROM'
      '('
      '  SELECT ep.*'
      '  FROM'
      '  ('
      '    SELECT m1.Produto, m1.Filial,'
      
        '          (m2.EmEstoque + m2.Reservado  + m2.Transito + m2.Demon' +
        'stracao +'
      
        '           m2.Conserto  + m2.Danificada + m2.ReservaPrevia) AS Q' +
        'tdeEstoque,'
      '           m2.Financeiro,'
      '          (SELECT c.Grupo'
      '              FROM Caracteristicas c'
      '              WHERE c.Codigo = (SELECT p.Caracteristica'
      '                                   FROM Produtos p'
      
        '                                   WHERE p.Codigo = m1.Produto))' +
        ' AS Grupo'
      '    FROM'
      '    ('
      '      SELECT m1.data, m1.Produto, m1.Filial,'
      '            (SELECT MAX(m2.Lancto)'
      '                FROM Movimentos m2'
      '                WHERE m2.Produto = m1.Produto'
      '                  AND m2.Filial  = m1.Filial'
      '                  AND m2.Data    = m1.Data) AS Lancto'
      '      FROM'
      '      ('
      '        SELECT MAX(m1.Data) AS Data, m1.Produto, m1.Filial'
      '           FROM Movimentos m1'
      '                JOIN Produtos p        ON p.Codigo = m1.Produto'
      
        '                JOIN Caracteristicas c ON c.Codigo = p.Caracteri' +
        'stica'
      '           WHERE m1.Data < (CAST(:DataFinal AS DATE)+1)'
      
        '/*             AND ((m1.Data < '#39'2012-06-01'#39') OR  - Mat'#233'ria-prima' +
        ' s'#243' passou a valer ap'#243's 31-MAI-2012'
      
        '             (NOT (m1.Grupo IN ('#39'GERL'#39', '#39'QUIM'#39', '#39'MTPR'#39')) OR (c.T' +
        'ipoProduto = '#39'01'#39')))'
      '*/'
      '        GROUP BY m1.Produto, m1.Filial'
      '        ORDER BY m1.Produto, m1.Filial'
      '      ) AS m1'
      '    ) AS m1 JOIN Movimentos m2 ON m1.Data    = m2.Data    AND'
      '                                  m1.Lancto  = m2.Lancto  AND'
      '                                  m1.Produto = m2.Produto AND'
      '                                  m1.Filial  = m2.Filial'
      '    ORDER BY m1.Produto, m1.Filial'
      '  ) AS ep'
      ''
      '  WHERE QtdeEstoque > 0'
      ') AS ep'
      'GROUP BY Grupo'
      'ORDER BY Grupo')
    RequestLive = False
    Left = 40
    Top = 88
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object qryEstoquePeriodogrupo: TStringField
      FieldName = 'grupo'
      Size = 4
    end
    object qryEstoquePeriodofinanceiro: TFloatField
      FieldName = 'financeiro'
      DisplayFormat = '0.00'
    end
  end
  object qryEstoqueAnterior: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT Grupo, SUM(Financeiro) AS Financeiro'
      'FROM'
      '('
      '  SELECT ep.*'
      '  FROM'
      '  ('
      '    SELECT m1.Produto, m1.Filial,'
      
        '          (m2.EmEstoque + m2.Reservado  + m2.Transito + m2.Demon' +
        'stracao +'
      
        '           m2.Conserto  + m2.Danificada + m2.ReservaPrevia) AS Q' +
        'tdeEstoque,'
      '           m2.Financeiro,'
      '          (SELECT c.Grupo'
      '              FROM Caracteristicas c'
      '              WHERE c.Codigo = (SELECT p.Caracteristica'
      '                                   FROM Produtos p'
      
        '                                   WHERE p.Codigo = m1.Produto))' +
        ' AS Grupo'
      '    FROM'
      '    ('
      '      SELECT m1.data, m1.Produto, m1.Filial,'
      '            (SELECT MAX(m2.Lancto)'
      '                FROM Movimentos m2'
      '                WHERE m2.Produto = m1.Produto'
      '                  AND m2.Filial  = m1.Filial'
      '                  AND m2.Data    = m1.Data) AS Lancto'
      '      FROM'
      '      ('
      '        SELECT MAX(m1.Data) AS Data, m1.Produto, m1.Filial'
      '           FROM Movimentos m1'
      '                JOIN Produtos p        ON p.Codigo = m1.Produto'
      
        '                JOIN Caracteristicas c ON c.Codigo = p.Caracteri' +
        'stica'
      '           WHERE m1.Data < CAST(:DataInicial AS DATE)'
      
        '/*             AND ((m1.Data < '#39'2012-06-01'#39') OR  -- Mat'#233'ria-prim' +
        'a s'#243' passou a valer ap'#243's 31-MAI-2012'
      
        '             (NOT (m1.Grupo IN ('#39'GERL'#39', '#39'QUIM'#39', '#39'MTPR'#39')) OR (c.T' +
        'ipoProduto = '#39'01'#39')))'
      ' */'
      '        GROUP BY m1.Produto, m1.Filial'
      '        ORDER BY m1.Produto, m1.Filial'
      '      ) AS m1'
      '    ) AS m1 JOIN Movimentos m2 ON m1.Data    = m2.Data    AND'
      '                                  m1.Lancto  = m2.Lancto  AND'
      '                                  m1.Produto = m2.Produto AND'
      '                                  m1.Filial  = m2.Filial'
      '    ORDER BY m1.Produto, m1.Filial'
      '  ) AS ep'
      ''
      '  WHERE QtdeEstoque > 0'
      ') AS ep'
      'GROUP BY Grupo'
      'ORDER BY Grupo')
    RequestLive = False
    Left = 40
    Top = 144
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end>
    object qryEstoqueAnteriorgrupo: TStringField
      FieldName = 'grupo'
      Size = 4
    end
    object qryEstoqueAnteriorfinanceiro: TFloatField
      FieldName = 'financeiro'
      DisplayFormat = '0.00'
    end
  end
