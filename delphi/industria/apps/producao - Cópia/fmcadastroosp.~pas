  inherited;
  if ckbSomenteProdutosdoCliente.Checked then
    if fraConsultaCliente.edfCodigo.Text='' then
      ckbSomenteProdutosdoCliente.Checked := false;
  fraProduto.SomenteProdutosdoCliente := ckbSomenteProdutosdoCliente.Checked;
