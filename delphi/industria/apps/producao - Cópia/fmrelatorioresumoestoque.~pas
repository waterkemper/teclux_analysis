{$R *.dfm}

{ TfrmRelatorioResumoEstoque }

constructor TfrmRelatorioResumoEstoque.Create(AOwner: TComponent);
begin
  dtmRelatorioResumoEstoque := TdtmRelatorioResumoEstoque.Create(Self);
  inherited;
  DataSet := dtmRelatorioResumoEstoque.qryResumoEstoqueKrahIce;
  edfDataInicial.Text := datetostr(PrimeiroDiaMesAnterior(now()));
//  edfDataInicial.Update;
  edfDataFinal.text := datetostr(UltimoDiaMesAnterior(now()));
//  edfDataFinal.Update;
  edfDataFinal.SelectAll;

  edfDataInicial.Exist;
  edfDataFinal.Exist;
//  AtualizarValores;

end;


destructor TfrmRelatorioResumoEstoque.Destroy;
begin
  dtmRelatorioResumoEstoque := nil;
  inherited;
  frmRelatorioResumoEstoque := nil;
end;

procedure TfrmRelatorioResumoEstoque.edfDataFinalFound(Found: Boolean);
begin
  inherited;
  if found then
    AtualizarValores;
end;

function TfrmRelatorioResumoEstoque.InternoExcluir: Boolean;
begin
  Result:= inherited InternoExcluir;
  if Result then
    dtmRelatorioResumoEstoque.ExcluirRelatorioResumo
end;

function TfrmRelatorioResumoEstoque.InternoGravar: Boolean;
begin
  Result:= inherited InternoGravar;
  if Result then
   dtmRelatorioResumoEstoque.GravarRelatorioResumo;
end;

procedure TfrmRelatorioResumoEstoque.sbnImprimirClick(Sender: TObject);
begin
  inherited;
  dtmRelatorioResumoEstoque.ImprimirRelatorio;
end;

procedure TfrmRelatorioResumoEstoque.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  if key =VK_F7 then
    if sbnImprimir.Enabled then
      dtmRelatorioResumoEstoque.ImprimirRelatorio;
end;

procedure TfrmRelatorioResumoEstoque.Action1Update(Sender: TObject);
begin
  inherited;
  sbnImprimir.Enabled := not dtmRelatorioResumoEstoque.qryResumoEstoqueKrahIce.IsEmpty;

end;

procedure TfrmRelatorioResumoEstoque.edfDataInicialKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if (key <>VK_return) and
     (key <>VK_F5) and
     (key <>VK_F6) then
  begin
    dtmRelatorioResumoEstoque.qryResumoEstoqueKrahIcedatafinal.Clear;
    edfDataFinal.Clear
  end;
end;


procedure TfrmRelatorioResumoEstoque.AtualizarValores;
begin
  dtmRelatorioResumoEstoque.AtualizarValores(edfDataInicial.Text, edfDataFinal.Text);
  gbxMateriaisFabricados.Caption:= 'MATERIAIS FABRICADOS PELA KRAH-ICE EM ' + edfDataFinal.Text;
  gbxEstoqueResistores.  Caption:= 'ESTOQUE DE RESISTORES EM TRÂNSITO EM ' + edfDataFinal.Text;
  gbxEstoqueMateriais.   Caption:= 'ESTOQUE DE MATERIAIS EM ' + edfDataFinal.Text;
  lblTotalMateriaPrima.  Caption:= 'TOTAL DE MATÉRIA-PRIMA EM ' + edfDataFinal.Text;
  lblMateriaPrimaFinal.  Caption:= 'Estoque de Matéria-prima em '+formatdatetime('dd/mm/yyyy',strtodate(edfDataInicial.text)-1);
end;

