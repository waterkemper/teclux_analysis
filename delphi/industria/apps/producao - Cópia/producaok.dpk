package producaok;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$SONAME 'producao'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  repositoriok;

contains
  dmcadastroosp in 'dmcadastroosp.pas' {dtmCadastroOSP: TDataModule},
  fmcadastroosp in 'fmcadastroosp.pas' {frmCadastroOSP},
  rgproducao in 'rgproducao.pas',
  fmcadastroniveissalariais in 'fmcadastroniveissalariais.pas' {frmCadastroNiveisSalariais},
  dmcadastroniveissalariais in 'dmcadastroniveissalariais.pas' {dtmCadastroNiveisSalariais: TDataModule},
  fmcadastromaquinas in 'fmcadastromaquinas.pas' {frmCadastroMaquinas},
  dmcadastromaquinas in 'dmcadastromaquinas.pas' {dtmCadastroMaquinas: TDataModule},
  dmcadastrooperacoes in 'dmcadastrooperacoes.pas' {dtmCadastroOperacoes: TDataModule},
  fmcadastrooperacoes in 'fmcadastrooperacoes.pas' {frmCadastroOperacoes},
  dmcadastrofluxogramas in 'dmcadastrofluxogramas.pas' {dtmCadastroFluxoGramas: TDataModule},
  fmcadastrofluxogramas in 'fmcadastrofluxogramas.pas' {frmCadastroFluxoGramas},
  fmrelatorioentradaosp in 'fmrelatorioentradaosp.pas' {frmrelatorioentradaosp},
  dmrelatorioentradaosp in 'dmrelatorioentradaosp.pas' {dtmRelatorioentradaOSP: TDataModule},
  dmrelatorionotasportransportador in 'dmrelatorionotasportransportador.pas' {dtmrelatorionotasportransportador: TDataModule},
  fmrelatorionotasportransportador in 'fmrelatorionotasportransportador.pas' {frmrelatorionotasportransportador};

end.
