  object qryImprimirFalhasOperacoes: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'datainclusao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dataalteracao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Inclusaofalhas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Alteracaofalhas'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'Ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      'select f.*'
      'from'
      '('
      'select f.*,'
      '          o.nome,'
      '          o.codigo as codigooperacao,'
      '          o.c01,'
      '          o.c02,'
      '          o.c03,'
      '          o.descricao as descricaooperacao,'
      '          o.setup,'
      '          o.planocontrole,'
      ''
      '       (select fl.trigger_user'
      '        from falhas_log fl'
      '        where trigger_mode = '#39'INSERT'#39
      '          and fl.codigo = f.codigo'
      '          %datainclusao'
      '        order by fl.trigger_changed desc limit 1'
      '       )  as UsuarioInclusao,'
      ''
      '       (select fl.trigger_changed'
      '        from falhas_log fl'
      '        where trigger_mode = '#39'INSERT'#39
      '          and fl.codigo = f.codigo'
      '          %datainclusao'
      '        order by fl.trigger_changed desc limit 1'
      '       )  as DataHoraInclusao,'
      ''
      ''
      '      ('
      '      SELECT selecao.usuarioalteracao FROM'
      '      ('
      '           ('
      '           select fl.trigger_user as usuarioAlteracao,'
      '            fl.trigger_changed as dataHoraAlteracao'
      '             from falhas_log fl'
      '              where fl.codigo = f.codigo'
      '               %dataalteracao'
      '                and fl.trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and fl.trigger_tuple = '#39'new'#39
      '               order by fl.trigger_changed desc limit 1'
      '            )'
      '        union all'
      '          ('
      '            select fl.trigger_user as usuarioAlteracao,'
      '             fl.trigger_changed as dataHoraAlteracao'
      '             from falhasoperacoes_log fl'
      '              where fl.falha = f.codigo'
      '              %dataalteracao'
      ''
      '               and fl.trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and fl.trigger_tuple = '#39'new'#39
      '              order by fl.trigger_changed desc limit 1'
      '              )'
      '      ) AS selecao'
      
        '        order by dataHoraAlteracao desc limit 1) as usuarioalter' +
        'acao,'
      ''
      ''
      ''
      '       ('
      '       select selecao.DataHoraAlteracao from'
      '       ('
      ''
      
        '           (select cast(to_char(fl.trigger_changed, '#39'DD/MM/YY HH' +
        '24:MI:SS'#39') as varchar(20)) as datahoraalteracao'
      '              from falhas_log fl'
      '               where fl.codigo = f.codigo'
      '                %dataalteracao'
      '                and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and trigger_tuple = '#39'new'#39
      '               order by fl.trigger_changed desc limit 1'
      '             )'
      '           union all'
      
        '           (select cast(to_char(fl.trigger_changed, '#39'DD/MM/YY HH' +
        '24:MI:SS'#39') as varchar(20))as datahoraalteracao'
      '              from falhasoperacoes_log fl'
      '               where fl.falha = f.codigo'
      '                %dataalteracao'
      '                and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '                and trigger_tuple = '#39'new'#39
      '               order by fl.trigger_changed desc limit 1'
      '             )'
      
        '      )as selecao'#9'order by datahoraalteracao limit 1)   as DataH' +
        'oraAlteracao,'
      ''
      ''
      '       (select selecao.operacao from'
      '        ('
      
        '        (select cast(case when trigger_mode = '#39'INSERT'#39' THEN '#39'INC' +
        'LUS'#195'O'#39
      
        '                                            else '#39'ALTERA'#199#195'O'#39' end' +
        ' as varchar(10)) as operacao,'
      '              fl.trigger_changed as dataHoraAlteracao'
      '            from falhas_log fl'
      '             where fl.codigo = f.codigo'
      '             %dataalteracao'
      '              and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '              and trigger_tuple = '#39'new'#39
      '             order by fl.trigger_changed desc limit 1'
      '            )'
      '          union all'
      ''
      
        '          (select cast(case when trigger_mode = '#39'INSERT'#39' THEN '#39'I' +
        'NCLUS'#195'O'#39
      
        '                                            else '#39'ALTERA'#199#195'O'#39' end' +
        ' as varchar(10)) as operacao,'
      '              fl.trigger_changed as dataHoraAlteracao'
      '            from falhasoperacoes_log fl'
      '             where fl.falha = f.codigo'
      '            %dataalteracao'
      '              and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '              and trigger_tuple = '#39'new'#39
      '             order by fl.trigger_changed desc limit 1'
      '            )'
      '        )as selecao'
      '        order by dataHoraAlteracao desc limit 1) as operacao,'
      ''
      '       (select selecao.tabela'
      '        FROM'
      '        ('
      '        ('
      '         select cast('#39'M'#193'QUINAS'#39' as varchar(30)) as tabela,'
      '                fl.trigger_changed as dataHoraAlteracao'
      '         from falhas_log fl'
      '          where fl.codigo = f.codigo'
      '          %dataalteracao'
      '           and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '           and trigger_tuple = '#39'new'#39
      '          order by fl.trigger_changed desc limit 1'
      '         )'
      '         union all'
      '        ('
      '         select cast('#39'OP. M'#193'QUINAS'#39' as varchar(30)) as tabela,'
      '                fl.trigger_changed as dataHoraAlteracao'
      '         from falhasoperacoes_log fl'
      '          where fl.falha = f.codigo'
      '          %dataalteracao'
      '           and trigger_mode in ('#39'INSERT'#39', '#39'UPDATE'#39')'
      '           and trigger_tuple = '#39'new'#39
      '          order by fl.trigger_changed desc limit 1'
      '         )'
      '        ) as selecao'
      '        order by dataHoraAlteracao desc limit 1) as Tabela'
      ''
      ''
      ''
      ''
      'from (falhas f'
      #9'  left join (falhasoperacoes fo'
      #9#9#9'join operacoes o'
      #9#9#9' on fo.operacao = o.codigo)'
      #9'  on f.codigo = fo.falha)'
      ') as f'
      'where true'
      '%Inclusaofalhas'
      '%Alteracaofalhas'
      ''
      '%Ordenacao'
      ''
      ''
      '/*'
      ''
      ':datainicialinclusao'
      ':datafinalinclusao'
      ''
      ':datainicialalteracao'
      ':datafinalalteracao'
      '*/'
      '')
    RequestLive = False
    Left = 376
    Top = 160
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicialinclusao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinalinclusao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicialalteracao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinalalteracao'
        ParamType = ptUnknown
      end>
    object qryImprimirFalhasOperacoescodigo: TIntegerField
      FieldName = 'codigo'
      DisplayFormat = '0'
    end
    object qryImprimirFalhasOperacoesdescricao: TStringField
      FieldName = 'descricao'
      Size = 300
    end
    object qryImprimirFalhasOperacoescustofalha: TFloatField
      FieldName = 'custofalha'
      DisplayFormat = '0.00'
    end
    object qryImprimirFalhasOperacoessetorproducao: TStringField
      FieldName = 'setorproducao'
      Size = 4
    end
    object qryImprimirFalhasOperacoestipofalha: TStringField
      FieldName = 'tipofalha'
      Size = 1
    end
    object qryImprimirFalhasOperacoesusuarioinclusao: TStringField
      FieldName = 'usuarioinclusao'
      Size = 50
    end
    object qryImprimirFalhasOperacoesdatahorainclusao: TDateTimeField
      FieldName = 'datahorainclusao'
    end
    object qryImprimirFalhasOperacoesusuarioalteracao: TStringField
      FieldName = 'usuarioalteracao'
      Size = 7
    end
    object qryImprimirFalhasOperacoesdatahoraalteracao: TStringField
      FieldName = 'datahoraalteracao'
      Size = 19
    end
    object qryImprimirFalhasOperacoesoperacao: TStringField
      FieldName = 'operacao'
      Size = 9
    end
    object qryImprimirFalhasOperacoestabela: TStringField
      FieldName = 'tabela'
      Size = 8
    end
    object qryImprimirFalhasOperacoesnome: TStringField
      FieldName = 'nome'
      Size = 10
    end
    object qryImprimirFalhasOperacoescodigooperacao: TIntegerField
      FieldName = 'codigooperacao'
      DisplayFormat = '0'
    end
    object qryImprimirFalhasOperacoesc01: TStringField
      FieldName = 'c01'
      Size = 2
    end
    object qryImprimirFalhasOperacoesc02: TStringField
      FieldName = 'c02'
      Size = 2
    end
    object qryImprimirFalhasOperacoesc03: TStringField
      FieldName = 'c03'
      Size = 2
    end
    object qryImprimirFalhasOperacoesdescricaooperacao: TStringField
      FieldName = 'descricaooperacao'
      Size = 60
    end
    object qryImprimirFalhasOperacoessetup: TBooleanField
      FieldName = 'setup'
    end
    object qryImprimirFalhasOperacoesplanocontrole: TBooleanField
      FieldName = 'planocontrole'
    end
  end
  object qryAtualizarTipoFalhaOriginal: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'update falhas set tipofalha = cast(:tipofalha as char(1))'
      'from'
      '('
      ' select codigo'
      ' from falhas'
      ' where falhaoperacaoorigem = :codigo'
      '  and tipofalha <> :tipofalha'
      ') as selecao'
      'where falhas.codigo = selecao.codigo  ')
    RequestLive = False
    Left = 240
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'tipofalha'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
  end
end
