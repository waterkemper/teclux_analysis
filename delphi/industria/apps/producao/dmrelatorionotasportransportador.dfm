  object qrynotastransportador: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereTransportadoras'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT n.Numero,'
      '       CAST(NULL AS VARCHAR) AS NumeroNota,'
      ''
      '       CASE WHEN df.Transportadora_Nome IS NOT NULL'
      '            THEN df.Transportadora_Nome'
      '            ELSE (SELECT f.Razao'
      '                     FROM Fornecedores f'
      '                     WHERE f.Codigo = df.FornecedorTransporte)'
      '        END AS Transportadora,'
      ''
      '        CASE WHEN df.Transportadora_Nome IS NOT NULL'
      
        '             THEN df.Transportadora_NomeCidade || '#39' - '#39' || df.Tr' +
        'ansportadora_Estado'
      '             ELSE (SELECT (SELECT c.Nome'
      '                              FROM Cidades c'
      '                              WHERE c.Estado = f.Estado AND'
      
        '                                    c.Codigo = f.Cidade) || '#39' - ' +
        #39' || f.Estado AS CidadeTransp'
      '                       FROM Fornecedores f'
      '                       WHERE f.Codigo = df.FornecedorTransporte)'
      '        END AS CidadeTransportadora,'
      ''
      '        df.CodigoFiscal,'
      '        df.Data,'
      '        df.Cliente,'
      ''
      '       (SELECT vf.Nome'
      '           FROM vFornecedores vf'
      '           WHERE vf.Codigo = df.Cliente AND'
      '                 vf.Tipo   = df.TipoCliente) AS NomeCliente,'
      ''
      '        CASE WHEN df.Estado = '#39'.'#39
      '             THEN (SELECT b.Nome'
      '                       FROM Bairros b'
      '                       WHERE b.Estado = df.Estado AND'
      '                             b.Cidade = df.Cidade AND'
      '                             b.Codigo = df.Bairro) || '#39' - '#39' ||'
      '                   (SELECT d.Nome'
      '                       FROM Cidades d'
      '                       WHERE d.Estado = df.Estado AND'
      '                             d.Codigo = df.Cidade)'
      ''
      '              ELSE (SELECT d.Nome'
      '                        FROM Cidades d'
      '                       WHERE d.Estado = df.Estado AND'
      
        '                             d.Codigo = df.Cidade) || '#39' - '#39' || d' +
        'f.Estado'
      '         END AS CidadeCliente,'
      ''
      '         df.ValorProdutos,'
      ''
      '        (SELECT COALESCE(SUM(vl.PesoBruto), 0)'
      '            FROM VolumesDadosFiscais vl'
      '            WHERE vl.DadoFiscal = df.Numero) AS Peso,'
      ''
      '        (SELECT COALESCE(SUM(vl.Volumes), 0)'
      '            FROM VolumesDadosFiscais vl'
      '            WHERE vl.DadoFiscal = df.Numero) AS Volumes'
      ''
      'FROM Notas n, DadosFiscais df'
      ''
      'WHERE  n.DadoFiscal = df.Numero AND'
      '       %WHERETransportadoras'
      '       df.Data BETWEEN :Datainicial AND :Datafinal AND'
      '       df.Situacao = '#39'N'#39
      ''
      'ORDER BY Transportadora, n.Numero'
      '')
    RequestLive = True
    Left = 208
    Top = 24
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object qrynotastransportadornumero: TIntegerField
      FieldName = 'numero'
    end
    object qrynotastransportadornumeronota: TStringField
      FieldName = 'numeronota'
      Size = 50
    end
    object qrynotastransportadortransportadora: TStringField
      FieldName = 'transportadora'
      Size = 50
    end
    object qrynotastransportadorcidadetransportadora: TMemoField
      FieldName = 'cidadetransportadora'
      BlobType = ftMemo
    end
    object qrynotastransportadorcodigofiscal: TIntegerField
      FieldName = 'codigofiscal'
    end
    object qrynotastransportadordata: TDateField
      FieldName = 'data'
    end
    object qrynotastransportadorcliente: TIntegerField
      FieldName = 'cliente'
    end
    object qrynotastransportadornomecliente: TStringField
      FieldName = 'nomecliente'
      Size = 50
    end
    object qrynotastransportadorcidadecliente: TMemoField
      FieldName = 'cidadecliente'
      BlobType = ftMemo
    end
    object qrynotastransportadorvalorprodutos: TFloatField
      FieldName = 'valorprodutos'
    end
    object qrynotastransportadorpeso: TFloatField
      FieldName = 'peso'
    end
    object qrynotastransportadorvolumes: TLargeintField
      FieldName = 'volumes'
    end
  end
