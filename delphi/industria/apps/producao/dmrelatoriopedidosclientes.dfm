    Sql.Strings = (
      'select osp.numero,'
      '       osp.entrega,'
      '       osp.produto,'
      '       osp.data,'
      '       osp.cliente,'
      '       osp.pedidocliente,'
      '       case when c.unidade = '#39'MIL'#39' then 1000 * osp.quantidade'
      '       else osp.quantidade end as quantidade,'
      '       cl.nome as nomecliente,'
      '       p.codigovisual as produtovisual'
      'from osp join clientes cl on osp.cliente = cl.codigo'
      '         join produtos p on osp.produto = p.codigo'
      
        '              join caracteristicas c on p.caracteristica = c.cod' +
        'igo'
      'where true'
      '%OSP'
      '%CLIENTE'
      '%SEMANAENTRADA'
      '%SEMANAENTREGA'
      'order by nomecliente, osp.entrega, osp.numero'
      '')
