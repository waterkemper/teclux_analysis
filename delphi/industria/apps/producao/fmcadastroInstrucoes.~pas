end;

procedure TfrmCadastroInstrucoes.sbnImprimirClick(Sender: TObject);
begin
  inherited;
  frmImprimirInstrucoes := TfrmImprimirInstrucoes.Create(frmImprimirInstrucoes);
  frmImprimirInstrucoes.ShowModal;
  frmImprimirInstrucoes.Free;
end;
}
end.


