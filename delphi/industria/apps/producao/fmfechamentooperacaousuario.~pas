procedure TfrmFechamentoOperacoesUsuario.Timer1Timer(Sender: TObject);
begin
  inherited;
//  lblHoraTermino.Caption := FormatDateTime('HH:MM:SS',now());
  lblHoraTermino.Caption := FormatDateTime('HH:MM:SS', dtmOperacoesOSP.HoraServidor);
