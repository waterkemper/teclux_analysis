procedure TfrmFechamentoOperacoesUsuario.dbgOPeracoesOSPUsuarioFalhasKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  if Shift = [ssCtrl] then
  begin
    case Key of
     VK_F9     : begin
                     ConsultaListaFalhas.CtrlOn := Shift = [ssCtrl];
                     if (Shift = []) or ConsultaListaFalhas.CtrlOn then
                       AcionarPesquisaGradeFalhas
                   end;
    end;
  end
  else
  case Key of
    VK_Return:
    begin
      if dbgOPeracoesOSPUsuarioFalhas.SelectedIndex = 0 then
      begin
        if ConsultaListaFalhas.edfcodigo.Exist then
        begin
          ConsultaListaFalhas.edfcodigo.Modified := true;
          ConsultaListaFalhas.edfcodigo.DoExit;
          dbgOPeracoesOSPUsuarioFalhas.SelectedIndex := 3;
        end
        else
        begin
          dtmOperacoesOSP.qryListaFalhascodigo.Clear;
          dtmOperacoesOSP.qryListaFalhasdescricao.Clear;
        end;
      end
      else
      if dbgOPeracoesOSPUsuarioFalhas.SelectedIndex = 1 then
        dbgOPeracoesOSPUsuarioFalhas.SelectedIndex := 3
      else
      if dbgOPeracoesOSPUsuarioFalhas.SelectedIndex = 2 then
        dbgOPeracoesOSPUsuarioFalhas.SelectedIndex := 3
      else
      if dbgOPeracoesOSPUsuarioFalhas.SelectedIndex = 3 then
      begin
        if (dtmOperacoesOSP.qryListaFalhas.State in [dsinsert,dsedit]) then
          dtmOperacoesOSP.GravarFalhas
        else
        begin
          dtmOperacoesOSP.qryListaFalhas.Next;
          if dtmOperacoesOSP.qryListaFalhas.eof then
          begin
            dbgOPeracoesOSPUsuarioParadas.SetFocus;
            dbgOPeracoesOSPUsuarioParadas.SelectedIndex := 0;
          end;
        end;
      end;
    end;
  end;
end;

procedure TfrmFechamentoOperacoesUsuario.bbnOKClick(Sender: TObject);
var
 vQtPerdaTotal, vQuantidadeLimite : integer;

begin
  inherited;
  vQtPerdaTotal := 0;
  with dtmOperacoesOSP do
  begin
    qryListaFalhas.DisableControls;
    qryListaFalhas.First;
    while not qryListaFalhas.Eof do
    begin
      if qryListaFalhasperdatotal.AsBoolean then
        vQtPerdaTotal := vQtPerdaTotal + qryListaFalhasquantidade.Asinteger;
      qryListaFalhas.Next;
    end;

    qryListaFalhas.EnableControls;

    vQuantidadeLimite := qryOperacoesOSPquantidadeanterior.AsInteger - qryOperacoesOSPquantidade.AsInteger - qryOperacoesOSPquantidadenasalternativas.AsInteger;

//    ModalResult := mrOK;

    if qryOperacoesOSPUsuarioquantidade.AsInteger = 0 then
    begin
      MensagemErro(format('A quantidade não foi informada.',
        [inttostr(vQuantidadeLimite)]));
      edtQuantidade.SetFocus;
      edtQuantidade.SelectAll;
//      ModalResult := mrnone;
    end
    else
    if not qryOperacoesOSPheaprimeiraoperacao.AsBoolean and
      ((qryOperacoesOSPUsuarioquantidade.AsInteger + vQtPerdaTotal) > vQuantidadeLimite) and
      not qryOperacoesOSPInformarTerminodoProcesso.AsBoolean then
    begin
      MensagemErro(format('A quantidade informada acrescida da perda total está ultrapassando o limite de %s em relação ao saldo do processo anterior',
        [inttostr(vQuantidadeLimite)]));
      edtQuantidade.SetFocus;
      edtQuantidade.SelectAll;
//    ModalResult := mrnone;
    end
    else
    if qryOperacoesOSPheaprimeiraoperacao.AsBoolean and
      ((qryOperacoesOSPUsuarioquantidade.AsInteger + vQtPerdaTotal) > vQuantidadeLimite) and
      not qryOperacoesOSPInformarTerminodoProcesso.AsBoolean then
    begin
      if MensagemConfirmacao(format('A quantidade informada acrescida da perda total está ultrapassando o limite de %s em relação ao tamanho do lote e o excedente permitido',
        [inttostr(vQuantidadeLimite)])) = smbOK then
        ModalResult := mrOK
      else
      begin
        edtQuantidade.SetFocus;
        edtQuantidade.SelectAll;
      end;
//        ModalResult := mrnone;
    end
{
    else
    if qryOperacoesOSPdesviodeprocesso.AsBoolean and
       qryOperacoesOSPUsuarioc8d.isnull then
    begin
      MensagemAviso('A operação é um desvio de processo, informe o documento do desvio.');
      edtNrDocumentoProcesso.SetFocus;
      edtNrDocumentoProcesso.SelectAll;
    end
    }
    else
      ModalResult := mrOK;
  end;
end;

