procedure TfrmTecsoft.mitLoginClick(Sender: TObject);
begin
  inherited;
  while Screen.FormCount > 3 do
    if Screen.Forms[0] is TfrmNavControles then
      Screen.Forms[0].Free;
  if LerConfiguracaoSistema(nil, False) then begin
    CarregarMenus(mmuTecsoft);
    //CopiarMenu(mmuTecsoft, true, false);
    //LiberarModulos;
    //CarregarPacotes;
    VerificarMenu;
    frmTecsoft.SetFocus;
    frmTecsoft.mitCadastros.InitiateAction;
    end else begin
    ConsultarTermino := False;
    Close;
  end;
end;

