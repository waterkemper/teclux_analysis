procedure TfrmTecsoft.mitCancelarCupomClick(Sender: TObject);
var
  UsuarioAut: TtecUsuarios;
  OK, Acerto: Boolean;
  frmAjuda: TForm;
begin
  inherited;
  if UsuarioLogin.GerenteCaixa then
    UsuarioAut := TdtmBasico.ObterAutorizacao(taSENHA, ctCANCELAMENTOCUPOM, ctGERENTECAIXA, '')
  else
    UsuarioAut := TdtmBasico.ObterAutorizacao(taLOGIN, ctCANCELAMENTOCUPOM, ctGERENTECAIXA, '');
  if Assigned(UsuarioAut) then begin
    OK := UsuarioAut.GerenteCaixa;
    if Not OK then
      MensagemAviso(ctUSUARIOSEMPERMISSAO);
  end else
    OK := False;
  if OK then begin
    ECFPadrao.CancelarCupom;

    if ECFPadrao.Erro then
      MensagemErro(ECFPadrao.Mensagem)
    else
    begin
      dtmAcertoCupomCancelado := TdtmAcertoCupomCancelado.Create(Self);
      acerto := dtmAcertoCupomCancelado.AcertaMovimentacoes(StrToInt(ECFPadrao.NumeroMaquina),StrToInt(ECFPadrao.Intervencao),StrToInt(ECFPadrao.Cupom) - 1);
      dtmAcertoCupomCancelado.Free;
    end;
    if Acerto then
    begin
      frmAjuda := FormExists('TfrmCadastroContratos');
      if Assigned(frmAjuda) then
        TfrmAjuda(frmAjuda).OperacaoPadrao([]);
    end;
  end
end;

