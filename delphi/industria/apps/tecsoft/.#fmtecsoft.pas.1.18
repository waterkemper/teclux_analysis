procedure TfrmTecsoft.MostrarFormRegistrado(Value: Array of Variant; NomeForm: String; Modal: Boolean);
var
  frmAjuda: TfrmAjuda;
  frmAjudaClass: TfrmAjudaClass;
begin
  inherited;
  frmAjuda := TfrmAjuda(FormExists(NomeForm));
  if Assigned(frmAjuda) then
    frmAjuda.OperacaoPadrao(Value)
  else begin
    frmAjudaClass := FormRegistrado(NomeForm);
    if Assigned(frmAjudaClass) then begin
      frmAjuda := frmAjudaClass.Create(Self);
      if Assigned(frmAjuda) then begin
        frmAjuda.OperacaoPadrao(Value);
        frmAjuda.SetFocus;
        if frmAjuda.WindowState = wsMinimized then
          frmAjuda.WindowState := wsNormal
      end
    end else
      MensagemErro(Format(ctCLASSENAOREGISTRADA, [NomeForm]))
  end;
end;

procedure TfrmTecsoft.MostrarSituacaoCaixa;
var
  Str, SituacaoUsuario: String;
begin
  if UsuarioLogin.Caixa then begin
    if UsuarioLogin.CaixaAberto then
      Str := ctAberto + ' (' + DateTimeToStr(UsuarioLogin.DataAberturaCaixa) + ')'
    else
      Str := ctFechado;
    SituacaoUsuario := NomeUsuario + ' - ' + ctCAIXA + ' %s';
    stbPrincipal.Panels[1].Text := Format(SituacaoUsuario, [Str]);
  end else
    stbPrincipal.Panels[1].Text := NomeUsuario
end;

function TfrmTecsoft.NomeForm(MenuItem: TMenuItem): String;
begin
  Result := 'Tfrm' + Copy(MenuItem.Name, 4, Length(MenuItem.Name));
end;

procedure TfrmTecsoft.OperacaoPadrao(Value: Array of Variant);
begin
  if Assigned(Menu) then
    Menu := nil
  else
    Menu := mmuTecsoft
end;

procedure TfrmTecsoft.VerificarMenu;

  procedure HabilitarTodosMenus;
  var
    a: Integer;

    procedure HabilitarTodosSubMenus(ItemMenu: TMenuItem);
    var
      a: Integer;
    begin
      for a := 0 to ItemMenu.Count - 1 do
        HabilitarTodosSubMenus(ItemMenu[a]);
      ItemMenu.Visible := true;
    end;

  begin
    for a := 0 to mmuTecsoft.Items.Count - 1 do
      HabilitarTodosSubMenus(mmuTecsoft.Items[a]);
  end;

  function EsconderItemsMenu(ItemMenu: TMenuItem): Boolean;
  var
    a: Integer;
    Esconder: Boolean;
  begin
    Esconder := True;
    for a := 0 to ItemMenu.Count - 1 do
      if Not EsconderItemsMenu(ItemMenu[a]) then
        Esconder := False;
    if ItemMenu.Count = 0 then
      Result := Not ItemMenu.Visible
    else
    begin
      ItemMenu.Visible := Not Esconder and ItemMenu.visible;
      Result := Not ItemMenu.visible;
    end
  end;

  procedure VerificarTodosMenus;
  var
    a: Integer;

    procedure VerificarTodosSubMenus(ItemMenu: TMenuItem);
    var
      b,index: Integer;
      visivel: boolean;
    begin
      for b := 0 to ItemMenu.Count - 1 do
        VerificarTodosSubMenus(ItemMenu[b]);

      visivel :=(Assigned(FormRegistrado(ItemMenu)) and
                                       (UsuarioLogin.Suporte or
                                        UsuarioLogin.Administrador or
             (usuariologin.AcessosUsuarios.Find(ItemMenu.name,index)))
                             or (ItemMenu.Tag = 1));

       if itemMenu.Visible <> visivel then
          ItemMenu.Enabled := visivel;
    end;

  begin
    for a := 0 to mmuTecsoft.Items.Count - 1 do
      VerificarTodosSubMenus(mmuTecsoft.Items[a]);
  end;

  procedure ApagarTodosMenusDesligados;
  var
    a: Integer;
    temsubmenu : boolean;
    procedure ApagarTodosSubMenusDesligados(ItemMenu: TMenuItem);
    var
      i: Integer;
    begin
      for i := ItemMenu.count -1 downto 0 do
      begin
        if (itemMenu[i].Count > 0) and not temsubmenu then
         temsubmenu := true;
        ApagarTodosSubMenusDesligados(ItemMenu[i]);
        if (temsubmenu) and (itemmenu.count = 0) then
          itemMenu.Enabled := false;
      end;
      if (not itemMenu.Enabled) then
        ItemMenu.Free;
    end;
  begin
    for a := mmuTecsoft.Items.Count - 1 downto 0 do
    begin
      temsubmenu := false;
      ApagarTodosSubMenusDesligados(mmuTecsoft.Items[a]);
      if (mmutecsoft.Items[a].Count = 0) then
        mmutecsoft.Items[a].free;
    end;
  end;

begin
  Notificar(NotificacaoSplash, ctDEFININDOACESSOS);
  VerificarTodosMenus;
//  mitFrenteCaixa.enabled          := ModuloEmUSo('caixa') and (usuariologin.Caixa or usuariologin.Suporte or UsuarioLogin.Administrador);
  mitConfiguracoesSistema.enabled := UsuarioLogin.Suporte or UsuarioLogin.Administrador;
  mitParametrosSistema.enabled    := UsuarioLogin.Suporte or UsuarioLogin.Administrador;

  mitComandosECF.Enabled := False;
  if (Assigned(ECFPadrao)) and ((UsuarioLogin.GerenteCaixa) or (UsuarioLogin.Caixa)) then
  begin
    mitComandosECF.Enabled := True;
    mitLeituraMemriaFiscal.Enabled := True;
    mitLeituraMemoriaFiscalData.Enabled := True;
  end;



{  mitAdministracaoTEF.Enabled := False;
  if (mitFrenteCaixa.Enabled) then
    mitAdministracaoTEF.Enabled := True;
}
  //if mitAdministracaoTEF.Enabled then
    mitAdministracaoTEF.Enabled := (ParSistema.TipoTEF <> tsSEMTEF) and UsuarioLogin.Caixa;

  MostrarSituacaoCaixa;
  if FrenteCaixa and UsuarioLogin.Caixa then
  begin
    Menu := nil;
    AbrirCaixa;
    if UsuarioLogin.CaixaAberto then
      ExecutarItemMenuMax(mitFrenteCaixa, True);
//    mitFrenteCaixaClick(mitFrenteCaixa);
  end;
  ApagarTodosMenusDesligados;
end;

procedure TfrmTecsoft.mitLerRetornosClick(Sender: TObject);
