var
  ConsultarTermino: Boolean = true;

procedure TfrmTecsoft.AbrirCaixa;
var
  UsuarioAut: TtecUsuarios;
  OK: Boolean;
begin
  if Not UsuarioLogin.CaixaAberto then
    if UsuarioLogin.PermiteAbrirCaixa then begin
      UsuarioLogin.AbrirCaixa;
      MostrarSituacaoCaixa
    end else if MensagemConfirmacao(ctCAIXAFECHADONODIA) = smbOK then begin
      if UsuarioLogin.GerenteCaixa then
        UsuarioAut := TdtmBasico.ObterAutorizacao(taSENHA, ctREABERTURACAIXA, ctGERENTECAIXA, '')
      else
        UsuarioAut := TdtmBasico.ObterAutorizacao(taLOGIN, ctREABERTURACAIXA, ctGERENTECAIXA, '');
      if Assigned(UsuarioAut) then begin
        OK := UsuarioAut.GerenteCaixa;
        if Not OK then
          MensagemAviso(ctUSUARIOSEMPERMISSAO);
      end else
        OK := False;
      if OK then begin
        UsuarioLogin.ReAbrirCaixa;
        MostrarSituacaoCaixa
      end
    end
end;

procedure TfrmTecsoft.CarregarPacotes;
begin
  biblio.CarregarModulos([''])
end;

procedure TfrmTecsoft.mitConfiguraMenuPorModulo(Sender: TObject);
var
  a: Integer;
begin
  inherited;
  for a := Screen.FormCount - 1 downto 0 do
    if (Screen.Forms[a] is TfrmAjuda) and (Screen.Forms[a] <> frmTecsoft) then
      Screen.Forms[a].Free;
  //LiberarModulos;
  //CarregarPacotes;
  //CopiarMenu(mmuTecsoft, true, False);
  VerificarMenu;
  SetFocus
end;

procedure TfrmTecsoft.CarregarMenus(Menu: TMainMenu);
var
  cod,i,j,m,Pos: Integer;
  ItemdeMenu: TMenuItem;
begin
  if Menu.Items.Count > 0 then
    CopiarMenu(Menu, True, False);;
  cod:= 0;
  i:= 0;
  j:= 0;
  m:= 0;

  for cod:= 0 to High(IMenu) do
    begin
      ItemdeMenu:= TMenuItem.Create(Self);
      ItemdeMenu.Caption:= IMenu[cod].Caption;
      ItemdeMenu.Name:= IMenu[cod].Name;
      ItemdeMenu.Tag:= IMenu[cod].Tag;
      ItemdeMenu.GroupIndex:= IMenu[cod].GroupIndex;
      ItemdeMenu.OnClick:= IMenu[cod].OnClick;
      Pos:= IMenu[cod].Pos;

      if IMenu[cod].TipoMenu = 'MP' then
      begin
        Menu.Items.Add(ItemdeMenu);
        inc(i);
        j:=0;
      end
      else if IMenu[cod].TipoMenu = 'SM1' then
      begin
        Menu.Items[Pos].Add(ItemdeMenu);
        inc(j);
        m:=0;
      end
      else if IMenu[cod].TipoMenu = 'SM2' then
      begin
        Menu.Items[Pos].Items[j-1].Add(ItemdeMenu);
        inc(m);
      end
      else if IMenu[cod].TipoMenu = 'SM3' then
        Menu.Items[Pos].Items[j-1].Items[m-1].Add(ItemdeMenu);
    end;
end;

procedure TfrmTecsoft.CopiarMenu(MenuOrigem: TMainMenu; SoRemoverMenu, RemoverTudo: Boolean);
var
 i,j,k,h,a,b,c,d: integer;
 ItemMenu : TMenuItem;
 Metodo, NomeItem, MenuOrdem: String;

 procedure AtribuirItemMenu;
 begin
   if High(IMenu) = -1 then
      SetLength(IMenu, 1)
    else
      SetLength(IMenu, High(IMenu) + 2);
   if MenuOrdem = 'MP' then
   begin
     IMenu[cod].TipoMenu    :=  MenuOrdem;
     IMenu[cod].Pos         :=  a;
     IMenu[cod].Caption     :=  MenuOrigem.Items[i].Caption;
     IMenu[cod].Tag         :=  MenuOrigem.Items[i].Tag;
     IMenu[cod].GroupIndex  :=  MenuOrigem.Items[i].GroupIndex;
     IMenu[cod].Name        :=  MenuOrigem.Items[i].Name;
   end
   else if MenuOrdem = 'SM1' then
   begin
     IMenu[cod].TipoMenu    :=  MenuOrdem;
     IMenu[cod].Pos         :=  a-1;
     IMenu[cod].Caption     :=  MenuOrigem.Items[i].Items[j].Caption;
     IMenu[cod].Tag         :=  MenuOrigem.Items[i].Items[j].Tag;
     IMenu[cod].GroupIndex  :=  MenuOrigem.Items[i].Items[j].GroupIndex;
     IMenu[cod].Name        :=  MenuOrigem.Items[i].Items[j].Name;
     IMenu[cod].OnClick     :=  MenuOrigem.Items[i].Items[j].OnClick;
   end
   else if MenuOrdem = 'SM2' then
   begin
     IMenu[cod].TipoMenu    :=  MenuOrdem;
     IMenu[cod].Pos         :=  a-1;
     IMenu[cod].Caption     :=  MenuOrigem.Items[i].Items[j].Items[k].Caption;
     IMenu[cod].Tag         :=  MenuOrigem.Items[i].Items[j].Items[k].Tag;
     IMenu[cod].GroupIndex  :=  MenuOrigem.Items[i].Items[j].Items[k].GroupIndex;
     IMenu[cod].Name        :=  MenuOrigem.Items[i].Items[j].Items[k].Name;
     IMenu[cod].OnClick     :=  MenuOrigem.Items[i].Items[j].Items[k].OnClick;
   end
   else if MenuOrdem = 'SM3' then
   begin
     IMenu[cod].TipoMenu    :=  MenuOrdem;
     IMenu[cod].Pos         :=  a-1;
     IMenu[cod].Caption     :=  MenuOrigem.Items[i].Items[j].Items[k].Items[h].Caption;
     IMenu[cod].Tag         :=  MenuOrigem.Items[i].Items[j].Items[k].Items[h].Tag;
     IMenu[cod].GroupIndex  :=  MenuOrigem.Items[i].Items[j].Items[k].Items[h].GroupIndex;
     IMenu[cod].Name        :=  MenuOrigem.Items[i].Items[j].Items[k].Items[h].Name;
     IMenu[cod].OnClick     :=  MenuOrigem.Items[i].Items[j].Items[k].Items[h].OnClick;
   end;
 end;
 procedure RemoverTodosItens(ItensMenu: array of TItensMenu);
 var
   a: integer;
 begin
   if High(ItensMenu) > 0 then
     for a:= 0 to High(ItensMenu) do
     begin
       IMenu[a].TipoMenu    :=  '';
       IMenu[a].Pos         :=  0;
       IMenu[a].Caption     :=  '';
       IMenu[a].Tag         :=  0;
       IMenu[a].GroupIndex  :=  0;
       IMenu[a].Name        :=  '';
     end;
 end;

 procedure RemoverTodosMenus(ItemMenu :TmenuItem);
 var
   a:integer;
 begin
   for a := ItemMenu.Count -1 downto 0 do
     RemoverTodosMenus(ItemMenu.Items[a]);
   ItemMenu.Free;
 end;

begin
  if SoRemoverMenu then
  begin
    for i:=mmuTecsoft.Items.Count - 1 downto 0 do
    RemoverTodosMenus(MenuOrigem.Items[i]);
    //MenuOrigem.Destroy;
  end
  else if RemoverTudo then
  begin
    RemoverTodosItens(IMenu);
    for i:=mmuTecsoft.Items.Count - 1 downto 0 do
    RemoverTodosMenus(MenuOrigem.Items[i]);
  end
  else
  begin
    a:= 0;
    cod:=0;
    for i:= 0 to MenuOrigem.Items.Count-1 do
    begin
      MenuOrdem:= 'MP';
      AtribuirItemMenu;
      Inc(a);
      inc(cod);

      b:= 0;
      for j:=0 to MenuOrigem.Items[i].Count-1 do
      begin
        MenuOrdem:= 'SM1';
        AtribuirItemMenu;
        Inc(b);
        inc(cod);

        c:= 0;
        for k:=0 to MenuOrigem.Items[i].items[j].Count-1 do
        begin
          MenuOrdem:= 'SM2';
          AtribuirItemMenu;
          Inc(c);
          inc(cod);

          for h:= 0 to MenuOrigem.Items[i].Items[j].Items[k].Count-1 do
          begin
            MenuOrdem:= 'SM3';
            AtribuirItemMenu;
            Inc(d);
            inc(cod);
          end;
        end;
      end;
    end;
  end;
end;

constructor TfrmTecsoft.Create(AOwner: TComponent);
var Usuario : String;
begin
  inherited;
  Caption := Application.Title;
  if dmbasico.ComUsuario then
    if UsuarioLogin.Caixa then
      OnFechamentoCaixa := MostrarSituacaoCaixa;
  CarregarPacotes;
  mitSobre.Caption := mitSobre.Caption + ' ' +Application.Title;
  //mmuTecsoftAux := TMainMenu.Create(self);
  //mmuTecSoftAux.Name := 'mmuTecSoftAux';
  CopiarMenu(mmuTecsoft, false, false);
  VerificarMenu;
  WindowState := wsMaximized;
  stbPrincipal.Panels[1].Text := stbPrincipal.Panels[1].Text + ' '+ctfilialbase+': '+TdtmBasico.DescricaoFilial;
  Inserindo := false;
end;

procedure TfrmTecsoft.ExecutarItemMenu(Sender: TObject);
var
  frmAjuda: TfrmAjuda;
  frmAjudaClass: TfrmAjudaClass;
begin
  if not Assigned(FormExists(NomeForm(TMenuItem(Sender)))) then
  begin
    frmAjudaClass := FormRegistrado(TMenuItem(Sender));
    if Assigned(frmAjudaClass) then
    begin
      frmAjuda := frmAjudaClass.Create(Application);
      if Assigned(frmAjuda) then
      begin
        if frmAjuda.FormStyle = fsMDIChild then
        begin
          frmAjuda.SetFocus;
          if frmAjuda.WindowState = wsMinimized then
            frmAjuda.WindowState := wsNormal
        end;
        if frmAjuda.FormStyle = fsNormal then
        begin
          frmAjuda.ShowModal;
        end;
      end;
    end
    else
    begin
      MensagemErro(Format(ctCLASSENAOREGISTRADA, [NomeForm(TMenuItem(Sender))]));
    end;
  end;
end;

procedure TfrmTecsoft.ExecutarItemMenuMax(Sender: TObject; Maximizado: Boolean);
var
  frmAjuda: TfrmAjuda;
  frmAjudaClass: TfrmAjudaClass;
begin
  if not Assigned(FormExists(NomeForm(TMenuItem(Sender)))) then
  begin
    frmAjudaClass := FormRegistrado(TMenuItem(Sender));
    if Assigned(frmAjudaClass) then
    begin
      frmAjuda := frmAjudaClass.Create(Application);
      if Assigned(frmAjuda) then
      begin
        if frmAjuda.FormStyle = fsMDIChild then
        begin
          frmAjuda.SetFocus;
          if frmAjuda.WindowState = wsMinimized then
            frmAjuda.WindowState := wsNormal;
          if Maximizado then
            frmAjuda.WindowState := wsMaximized;
        end;
        if frmAjuda.FormStyle = fsNormal then
        begin
          frmAjuda.ShowModal;
        end;
      end;
    end
    else
    begin
      MensagemErro(Format(ctCLASSENAOREGISTRADA, [NomeForm(TMenuItem(Sender))]));
    end;
  end;
end;

procedure TfrmTecsoft.FormCloseQuery(Sender: TObject; var CanClose: Boolean);

  function CadastroAberto: Boolean;
  var
    cnt: Integer;
  begin
    Result := False;
    for cnt := 0 to Screen.FormCount - 1 do begin
      if Screen.Forms[cnt] is TfrmCadastroPadrao then
        if (Screen.Forms[cnt] as TfrmCadastroPadrao).DataSet.State in [dsEdit] then begin
          MensagemAviso(Format(ctCADASTROABERTO,[UpperCase(Screen.Forms[cnt].Caption)]));
          Result := True;
          Break;
        end;
    end;
  end;

var
  F: TForm;
begin
  inherited;
  if Assigned(Menu) and UsuarioLogin.Caixa and UsuarioLogin.CaixaAberto then
    MensagemAviso(ctCAIXAABERTO);
  if ConsultarTermino then begin
    F := Screen.ActiveForm;
    CanClose := not CadastroAberto;
    if CanClose then
      CanClose := MensagemConfirmacao(Format(ctCONFIRMESAIR, [Application.Title])) = smbOk;
    if not CanClose then
      FindForm(F);
  end else
    CanClose := True;
end;

function TfrmTecsoft.FormRegistrado(MenuItem: TMenuItem): TfrmAjudaClass;
var
  Nome: String;
begin
  Nome := NomeForm(MenuItem);
  Result := FormRegistrado(Nome)
end;

function TfrmTecsoft.FormRegistrado(NomeForm: String): TfrmAjudaClass;
var
  Pers: TPersistentClass;
begin
  Pers := ActivateClassGroup(TControl);
  Result := TfrmAjudaClass(GetClass(NomeForm));
  ActivateClassGroup(Pers);
end;

procedure TfrmTecsoft.mitAdministracaoTEFClick(Sender: TObject);
{$IFDEF LINUX}
begin

{$ELSE}
var
  tecTEFDiscado: TtecTEFDiscado;
  CupomEmitido: Boolean;
begin
  inherited;
  if Assigned(ECFPadrao) and ECFPadrao.CupomAberto then begin
    SetFocus;
    MensagemAviso(ctCUPOMFISCALABERTO);
    SetFocus;
  end else if ParSistema.TipoTEF = tsDISCADO then begin
    tecTEFDiscado := TtecTEFDiscado.Create;
    try
      if tecTEFDiscado.GerenciadorAtivo(False) then begin
        CupomEmitido := False;
        if tecTEFDiscado.ExecutarOperacao(sopADMIN, 0) then
          tecTEFDiscado.ImprimirCupom(CupomEmitido, 0, '', '', 0)
      end else begin
        SetFocus;
        MensagemErro(ctTEFTEGERENCIADORINATIVO);
        SetFocus;
      end
    finally
      tecTEFDiscado.Free
    end;
  end else if ParSistema.TipoTEF = tsDEDICADO then
    ExecutarItemMenu(mitAdministracaoTEF);
{$ENDIF}
end;

