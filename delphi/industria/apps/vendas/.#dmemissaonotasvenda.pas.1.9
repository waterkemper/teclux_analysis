function TdtmEmissaoNotasVenda.GerarNFE(Var ChaveAcesso, LoteNFe,
                  ReciboNFe, ProtocoloNFe: String; Validando : Boolean = False): Boolean;
var
  NFe: TTecNotaFiscalEletronica;
  DataHoraProcessamento: String;

begin
  result := false;
  if  not Validando then
    NFe := TTecNotaFiscalEletronica.Create
  else
    NFe := TTecNotaFiscalEletronica.Create(dtmTecSoft.Database);

  NFe.DiretorioEnvio       := NFeDirEnvio;
  NFe.DiretorioEnviado     := NFeDirEnviados;
  NFe.DiretorioRetorno     := NFeDirRetorno;
  NFe.DiretorioCompartilha := NfeDirCompartilha;
  NFe.Executavel           := NFeExecNFe;

  try
    if not Validando then
    begin
      ShowProcessando('Gerando o arquivo da NF-e!');
      Sleep(500);
    end;

    // EMITENTE
    NFe.Emit_Documento := CNPJFilialBase;
    NFe.Emit_Nome      := RazaoFilialBase;
    NFe.Emit_Rua       := RuaSemNumeroFilialBase;
    NFe.Emit_Nro       := NumeroFilialBase;
    NFe.Emit_Compl     := ComplementoFilialBase;
    NFe.Emit_Bairro    := BairroFilialBase;
    NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
    NFe.Emit_Mun       := CidadeFilialBase;
    NFe.Emit_UF        := EstadoFilialBase;
    NFe.Emit_CEP       := CEPFilialBase;
    NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
    NFe.Emit_IE        := InscricaoEstadualFilialBase;
    NFe.Emit_IM        := InscricaoMunicipalFilialBase;
    NFe.Emit_CNAE      := CNAEFiscalFilialBase;
    NFe.Emit_CRT       := qryDadosFiscaisregimetributario.AsInteger;

    // DESTINATARIO
    NFe.Dest_TipoPessoa := qryDadosFiscaispessoatipo.AsString;
    NFe.Dest_Documento := qryDadosFiscaispessoanumero.AsString;
    NFe.Dest_Nome      := qryDadosFiscaisnome.AsString;
    NFe.Dest_Rua       := qryDadosFiscaisrua.AsString;
    NFe.Dest_Nro       := qryDadosFiscaisendnumero.AsString;
    NFe.Dest_Compl     := qryDadosFiscaisendcomplemento.AsString;
    NFe.Dest_Bairro    := qryDadosFiscaisnomebairro.AsString;
    NFe.Dest_CodMun    := qryDadosFiscaiscidadeibge.AsString;
    NFe.Dest_Mun       := qryDadosFiscaisnomecidade.AsString;
    NFe.Dest_UF        := qryDadosFiscaisestado.AsString;
    NFe.Dest_CEP       := qryDadosFiscaiscep.AsString;
    NFe.Dest_CodPais   := qryDadosFiscaispais.AsInteger;
    NFe.Dest_Pais      := qryDadosFiscaisnomepais.AsString;
    NFe.Dest_Fone      := qryDadosFiscaisfoneddd.AsString+qryDadosFiscaisfonenumero.AsString;
    NFe.Dest_IE        := qryDadosFiscaisdocumento.AsString;
    NFe.Dest_ISUF      := qryDadosFiscaisiesubsttributario.AsString;

    // ENTREGA
    NFe.Entrega_Documento := qryDadosFiscaislocalentrega_cnpj.AsString;
    NFe.Entrega_Rua       := qryDadosFiscaislocalentrega_rua.AsString;
    NFe.Entrega_Nro       := qryDadosFiscaislocalentrega_numero.AsString;
    NFe.Entrega_Compl     := qryDadosFiscaislocalentrega_complemento.AsString;
    NFe.Entrega_Bairro    := qryDadosFiscaislocalentrega_nomebairro.AsString;
    NFe.Entrega_CodMun    := qryDadosFiscaislocalentrega_cidadeibge.AsString;
    NFe.Entrega_Mun       := qryDadosFiscaislocalentrega_nomecidade.AsString;
    NFe.Entrega_UF        := qryDadosFiscaislocalentrega_estado.AsString;

    nfe.Validando := Validando;

    Result := NFe.GerarNFe(qryDadosFiscais,nil,qryProdutosDadosFiscais,nil,nil,
                 qryVenctosDadosFiscais,qryVolumesDadosFiscais,
                 qryLacresVolumesDadosFiscais,nil,nil,SerieSugestao,
                 'S');

    if Result and not Validando then
    begin
      if NFeTipoEmissao in [1,3] then
      begin
        ShowProcessando;
        ShowProcessando('Verificando status do serviço NF-e!');
        Sleep(500);
        Result := NFe.VerificarStatusServico(IntToStr(NFeAmbiente));
        if Result then
        begin
          ShowProcessando;
          ShowProcessando('Processando o arquivo de envio da NF-e!');
          Sleep(500);
          Result := NFe.EnviarNFe(ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString, LoteNFe, ReciboNFe);
          if Result then
          begin
            qryDadosFiscais.Edit;
            qryDadosFiscaisnumlotenfe.AsString   := LoteNFe;
            qryDadosFiscaisnumrecibonfe.AsString := ReciboNFe;
            qryDadosFiscais.Post;
            Result := Perpetrar([qryDadosFiscais]);
            if Result then
            begin
              ShowProcessando;
              ShowProcessando('Consultando o arquivo de retorno da NF-e!');
              Sleep(500);
              Result := NFe.ConsultarSituacaoLote(ReciboNFe, ProtocoloNFe, DataHoraProcessamento, IntToStr(NFeAmbiente));
              if Result then
              begin
                qryDadosFiscais.Edit;
                qryDadosFiscaisnumprotocolonfe.AsString := ProtocoloNFe;
                qryDadosFiscaisdhprocnfe.AsDateTime :=  FormatarTimeStamp(DataHoraProcessamento);
                qryDadosFiscais.Post;
                Result := Perpetrar([qryDadosFiscais]);
                if Result then
                begin
                  ShowProcessando;
                  ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                  Sleep(500);
                  try
                    NFe.CompartilharXML(ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,
                                                  ReciboNFe, qryDadosFiscaisfilialvenda.AsString,
                                                  SerieSugestao, qryDadosFiscaisnrdocumento.AsString,
                                                  qryDadosFiscaisdata.AsDateTime);
                  finally
                    ShowProcessando;
                  end;
                  ShowProcessando('Imprimindo o DANFE!');
                  try
                    NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                      qryDadosFiscaisfilialvenda.AsString,
                                      SerieSugestao,
                                      qryDadosFiscaisnrdocumento.AsString,
                                      qryDadosFiscaislocalentrega_cep.AsString,
                                      qryDadosFiscaisemail.AsString,
                                      IntToStr(NFeNVias), NFeLogotipoDANFE,
                                      ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                                      qryDadosFiscaisdata.AsDateTime,nil,NFeExecDANFE);
                  finally
                    ShowProcessando;
                  end;
                  if (qryDadosFiscaisemail.AsString <> '')      and
                     (UsuarioLogin.PortaSmpt        <> '')      and
                     (UsuarioLogin.HostSmtp         <> '')      and
                     (UsuarioLogin.Email            <> '')      and
                     (UsuarioLogin.SenhaEmail       <> '')      and
                     EmailValido(qryDadosFiscaisemail.AsString) then
                  begin
                    ShowProcessando('Enviando email para o cliente');
                    try
                      if not NFe.EnviarEmail(UsuarioLogin.Email,qryDadosFiscaisemail.AsString,
                                qryDadosFiscaisnrdocumento.AsString, SerieSugestao, IntToStr(FilialBase),
                                NomeFilialBase, RazaoFilialBase, CNPJFilialBase, DDDFilialBase, FoneFilialBase,
                                DDDFaxFilialBase, FaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMPT,
                                UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                qryDadosFiscaisdata.AsDateTime, qryDadosFiscaisvalortotal.AsCurrency,
                                UsuarioLogin.AutenticarSMTP, qryDadosFiscaisdata.AsDateTime) then
                        MensagemAviso('Ocorreu um erro inesperado no envio do email')
                    finally
                      ShowProcessando;
                    end;
                  end;
                end
                else
                  ShowProcessando;
              end
              else
                ShowProcessando;;
            end
            else
              ShowProcessando;
          end
          else
            ShowProcessando;
        end
        else
          ShowProcessando;
      end
      else
      begin
        if not NFeVisualizarDANFE then
          MensagemAviso('Impressão da Nota Fiscal será iniciada.');
        NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                          qryDadosFiscaisfilialvenda.AsString,
                          SerieSugestao,
                          qryDadosFiscaisnrdocumento.AsString,
                          qryDadosFiscaislocalentrega_cep.AsString,
                          qryDadosFiscaisemail.AsString,
                          IntToStr(NFeNVias), NFeLogotipoDANFE,
                          ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                          qryDadosFiscaisdata.AsDateTime,nil,NFeExecDANFE);
      end;
    end;

  finally
    FreeAndNil(NFe); //NFe.Free;
  end;
end;

procedure TdtmEmissaoNotasVenda.RatearValoresProdutos;
var
  i, t: Integer;
  FreteRateado,
  DescontoRateado,
  SeguroRateado,
  AcrescimoRateado,
  DespesaRateada,
  Total{, TotalAcrescimo,
  TotalDesconto}: Currency;
begin
  // LIMPA OS CAMPOS NO CASO DE OS VALORES TEREM SIDO ALTERADO DE MODO Q HOUVESSEM VALORES RATEADO, POREM NAO HA MAIS
  try
    GuardarRegistroAtual(qryProdutosDadosFiscais,true);
    qryProdutosDadosFiscais.First;
    while not qryProdutosDadosFiscais.Eof do
    begin
      qryProdutosDadosFiscais.Edit;
      qryProdutosDadosFiscaisfrete.Clear;
      qryProdutosDadosFiscaisdesconto.Clear;
      qryProdutosDadosFiscaisseguro.Clear;
      qryProdutosDadosFiscaisacrescimo.Clear;
      qryProdutosDadosFiscaisdespesasacessorias.Clear;
      qryProdutosDadosFiscais.Post;
      qryProdutosDadosFiscais.Next;
    end;
  finally
    VoltarRegistroAtual(qryProdutosDadosFiscais);
  end;

  if (qryDadosFiscaisvalorfrete.AsCurrency > 0) or
     (qryDadosFiscaisdesconto.AsCurrency > 0) or
     (qryDadosFiscaisseguro.AsCurrency > 0) or
     (Valoracrescimo > 0) or
     (qryDadosFiscaisdespesasacessorias.AsCurrency > 0) then
  begin
    FreteRateado := qryDadosFiscaisvalorfrete.AsCurrency;
    DescontoRateado := qryDadosFiscaisdesconto.AsCurrency;
    SeguroRateado := qryDadosFiscaisseguro.AsCurrency;
    AcrescimoRateado := ValorAcrescimo;
    DespesaRateada := qryDadosFiscaisdespesasacessorias.AsCurrency;
    try
      GuardarRegistroAtual(qryProdutosDadosFiscais,true);
      t:= qryProdutosDadosFiscais.RecordCount;
      qryProdutosDadosFiscais.First;
      for i := 1 to T do
      begin
        qryProdutosDadosFiscais.Edit;
        if FreteRateado > 0 then
        begin
          if i = t then
            qryProdutosDadosFiscaisfrete.AsCurrency := FreteRateado
          else
          begin
            qryProdutosDadosFiscaisfrete.AsCurrency := qryProdutosDadosFiscaisprecovenda.AsCurrency *
                                                   qryProdutosDadosFiscaisquantidade.AsCurrency *
                                                   qryDadosFiscaisvalorfrete.AsCurrency /
                                                   qryDadosFiscaisvalorprodutos.AsCurrency;
            FreteRateado := FreteRateado - qryProdutosDadosFiscaisfrete.AsCurrency;
          end;
        end;

        if SeguroRateado > 0 then
        begin
          if i = t then
            qryProdutosDadosFiscaisseguro.AsCurrency := SeguroRateado
          else
          begin
            qryProdutosDadosFiscaisseguro.AsCurrency := qryProdutosDadosFiscaisprecovenda.AsCurrency *
                                                    qryProdutosDadosFiscaisquantidade.AsCurrency *
                                                    qryDadosFiscaisseguro.AsCurrency /
                                                    qryDadosFiscaisvalorprodutos.AsCurrency;
            SeguroRateado := SeguroRateado - qryProdutosDadosFiscaisseguro.AsCurrency;
          end;
        end;

        if AcrescimoRateado > 0 then
        begin
          if i = t then
            qryProdutosDadosFiscaisacrescimo.AsCurrency := AcrescimoRateado
          else
          begin
            qryProdutosDadosFiscaisacrescimo.AsCurrency := qryProdutosDadosFiscaisprecovenda.AsCurrency *
                                                       qryProdutosDadosFiscaisquantidade.AsCurrency *
                                                       ValorAcrescimo /
                                                       qryDadosFiscaisvalorprodutos.AsCurrency;
            AcrescimoRateado := AcrescimoRateado - qryProdutosDadosFiscaisacrescimo.AsCurrency;
          end;
        end;

        if DescontoRateado > 0 then
        begin
          if i = t then
            qryProdutosDadosFiscaisdesconto.AsCurrency := DescontoRateado
          else
          begin
            qryProdutosDadosFiscaisdesconto.AsCurrency := qryProdutosDadosFiscaisprecovenda.AsCurrency *
                                                               qryProdutosDadosFiscaisquantidade.AsCurrency *
                                                               qryDadosFiscaisdesconto.AsCurrency /
                                                               qryDadosFiscaisvalorprodutos.AsCurrency;
            DescontoRateado := DescontoRateado - qryProdutosDadosFiscaisdesconto.AsCurrency;
          end;
        end;

        if DespesaRateada > 0 then
        begin
          if i = t then
            qryProdutosDadosFiscaisdespesasacessorias.AsCurrency := DespesaRateada
          else
          begin
            qryProdutosDadosFiscaisdespesasacessorias.AsCurrency := qryProdutosDadosFiscaisprecovenda.AsCurrency *
                                                               qryProdutosDadosFiscaisquantidade.AsCurrency *
                                                               qryDadosFiscaisdespesasacessorias.AsCurrency /
                                                               qryDadosFiscaisValorprodutos.AsCurrency;
            DespesaRateada := DespesaRateada - qryProdutosDadosFiscaisdespesasacessorias.AsCurrency;
          end;
        end;

        qryProdutosDadosFiscais.Post;
        qryProdutosDadosFiscais.Next;
      end;
    finally
      VoltarRegistroAtual(qryProdutosDadosFiscais);
    end;
  end;
end;

end.
