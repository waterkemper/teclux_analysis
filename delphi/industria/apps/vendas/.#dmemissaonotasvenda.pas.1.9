function TdtmEmissaoNotasVenda.VerificarProdutosDadosFiscais: boolean;
var
  aliquotaicms, aliquotaipi,
  TotalDescontoDadoFiscal,
  TotalIPI: Currency;

  TotalProdutos : Real;
begin
  TotalDescontoDadoFiscal := 0;
  TotalProdutos := 0;
  TotalIPI := 0;
  if qryProdutosDadosFiscais.State in [dsedit, dsinsert] then
  begin
    if (qryProdutosDadosFiscaisproduto.AsString<>'') and
       (qryProdutosDadosFiscaisquantidade.AsCurrency<>0) and
       (qryProdutosDadosFiscaisprecovenda.AsCurrency<>0) then
      qryProdutosDadosFiscais.Post
    else
      qryProdutosDadosFiscais.Cancel;
  end;

  result := not qryProdutosDadosFiscais.IsEmpty;
  if result then
  begin
    GuardarRegistroAtual(qryProdutosDadosFiscais,false);
    qryProdutosDadosFiscais.First;
    aliquotaicms := qryProdutosDadosFiscaisaliquotaicms.AsCurrency;
    aliquotaipi := qryProdutosDadosFiscaisaliquotaipi.AsCurrency;
    while not qryProdutosDadosFiscais.Eof do
    begin
      result := qryProdutosDadosFiscais.CheckRequiredFields;
      if result then
      begin
        TotalProdutos := TotalProdutos  + Truncar(qryProdutosDadosFiscaisprecovenda.Asfloat *
                                                  qryProdutosDadosFiscaisquantidade.AsFloat, 2);


        if qryProdutosDadosFiscaisaliquotaicms.AsCurrency < 0 then
        begin
          qryProdutosDadosFiscais.edit;


          qryProdutosDadosFiscaisdesconto.AsCurrency :=
                   Truncar((qryProdutosDadosFiscaisquantidade.AsCurrency *
                            qryProdutosDadosFiscaisprecovenda.AsCurrency)  *
                            abs(qryProdutosDadosFiscaisaliquotaicms.AsCurrency) / 100, 2);


          qryProdutosDadosFiscais.post;
          TotalDescontoDadoFiscal := TotalDescontoDadoFiscal + qryProdutosDadosFiscaisdesconto.AsCurrency;
        end;

        TotalIPI := TotalIPI + roundTo(((qryProdutosDadosFiscaisquantidade.AsCurrency * qryProdutosDadosFiscaisprecovenda.AsCurrency) - qryProdutosDadosFiscaisdesconto.AsCurrency) *
             abs(qryProdutosDadosFiscaisaliquotaipi.AsCurrency) / 100,-2);


        qryProdutosDadosFiscais.Edit;
        qryProdutosDadosFiscaistribquantidade.AsCurrency := qryProdutosDadosFiscaisquantidade.AsCurrency;
        qryProdutosDadosFiscaistribunitario.AsCurrency := qryProdutosDadosFiscaisprecovenda.AsCurrency;
        qryProdutosDadosFiscais.post;

        qryProdutosDadosFiscais.Next;
        if (aliquotaicms <> qryProdutosDadosFiscaisaliquotaicms.AsCurrency) then
        begin
          result := false;
          MensagemAviso('Existem diferenças de alíquotas de icms');
          break;
        end;

        if (aliquotaipi <> qryProdutosDadosFiscaisaliquotaipi.AsCurrency) then
        begin
          result := false;
          MensagemAviso('Existem diferenças de alíquotas de ipi');
          break;
        end;
      end
      else
        break;
    end;

    VoltarRegistroAtual(qryProdutosDadosFiscais);
  end
  else
    MensagemAviso(ctNAOEXISTEMITENSCADASTRADOS);

  if result then
  begin
    TotalProdutos :=  roundto(TotalProdutos,-2);
    qryDadosFiscaisvalorprodutos.AsCurrency := TotalProdutos;

    dsrDadosFiscais.onDataChange := nil;
    qryDadosFiscaisdesconto.AsCurrency      := TotalDescontoDadoFiscal;
    dsrDadosFiscais.onDataChange := dsrDadosFiscaisDataChange;
    
    qryDadosFiscaisvaloripi.AsCurrency      := TotalIPI;
    qryDadosFiscaisvalortotal.AsCurrency    := qryDadosFiscaisvalorprodutos.AsCurrency -
                                               qryDadosFiscaisdesconto.AsCurrency      +
                                               qryDadosFiscaisvaloripi.AsCurrency      +
                                               qryDadosFiscaisvalorfrete.AsCurrency    +
                                               qryDadosFiscaisseguro.AsCurrency        +
                                               qryDadosFiscaisdespesasacessorias.AsCurrency;
  end;
end;

