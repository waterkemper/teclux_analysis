function TdtmEmissaoNotasVenda.IncluirProdutosDadoFiscal: Boolean;
begin
result := true;
qryProdutosDadosFiscais.Append;
{
  if (qryOSPGridqtdenota.AsCurrency > 0) and
     (qryOSPGridpreco.AsCurrency > 0) then
  begin
    if (qryProdutosDadosFiscais.RecordCount > 0) and
       (qryOSPGridsubstituicaoipi.AsBoolean <> FSubstituicaoIPIProdutos) then
       setar no 1. e todos devem ser iguais
    begin
      MensagemAviso('Produto com valor substituicao ipi diferente dos demais.');
      qryOSPGridqtdenota.AsCurrency := 0;
      Result := False;
    end
    else
    begin
      Result := qryOSPGrid.RecNo = qryOSPGrid.RecordCount;
      try
        FPodeIncluirProdutosDadosFiscais := True;
        try
          if not qryProdutosDadosFiscais.Active then
            qryProdutosDadosFiscais.Open;
          if not qryProdutosDadosFiscais.Locate('osp,produto',
                                                VarArrayOf([qryOSPGridnumero.AsVariant,
                                                            qryProdutosPedidosGridproduto.AsVariant]),[]) then
          begin
            qryProdutosDadosFiscais.Append;
            qryProdutosDadosFiscaisfilial.AsInteger   := FilialBase;
            qryProdutosDadosFiscaisvendedor.AsInteger := UsuarioLogin.CodigoUsuario;
            qryProdutosDadosFiscaisproduto.AsLargeInt := qryOSPGridproduto.AsLargeInt;
            qryProdutosDadosFiscaisprodutocliente.AsString := qryOSPGridproduto_cliente.AsString;
            qryProdutosDadosFiscaissubstituicaoIPI.AsBoolean := qryOSPGridsubstituicaoipi.AsBoolean;
            qryProdutosDadosFiscaisdescricaoproduto.AsString := qryOSPGriddescricaoproduto.AsString;
            qryProdutosDadosFiscaisquantidade.AsCurrency := qryOSPGridqtdenota.AsCurrency;
            qryProdutosDadosFiscaisprecovenda.AsCurrency := qryOSPGridpreco.AsCurrency;
            qryProdutosDadosFiscaisprecotabela.AsCurrency:= qryOSPgridprecotabela.AsCurrency;
            qryProdutosDadosFiscaisosp.AsInteger := qryOSPGridosp.AsInteger;
            qryProdutosDadosFiscaispedidocliente.AsString:= qryOSPGridpedidocliente.AsString;
            qryProdutosDadosFiscaisunidade.AsString := qryOSPGridunidade.AsString;
            qryProdutosDadosFiscaiscodigovisual.AsString := qryOSPGridcodigovisual.AsString;
            qryProdutosDadosFiscaisincidencia.AsString := qryOSPGridincidencia.AsString;
            qryProdutosDadosFiscaisorigem.AsString := qryOSPGridorigem.AsString;
            qryProdutosDadosFiscaisbrinde.AsBoolean := False;

            qryProdutosDadosFiscaisbaseicms.AsCurrency     := qryOSPGridbaseicms.AsCurrency;
            if qryOSPGridicms.AsInteger > 0 then
            begin
              qryProdutosDadosFiscaisicms.AsInteger          := qryOSPGridicms.AsInteger;
              qryProdutosDadosFiscaisaliquotaicms.AsCurrency := qryOSPGridaliquotaicms.AsCurrency;
            end;
            if qryOSPGridipi.AsInteger > 0 then
            begin
              qryProdutosDadosFiscaisipi.AsInteger           := qryOSPGridipi.AsInteger;
              qryProdutosDadosFiscaisaliquotaipi.AsCurrency  := qryOSPGridaliquotaipi.AsCurrency;
              qryProdutosDadosFiscaisvaloripi.AsCurrency     :=
                truncar((((qryProdutosDadosFiscaisquantidade.AsCurrency * qryProdutosDadosFiscaisprecovenda.AsFloat) * qryProdutosDadosFiscaisaliquotaipi.AsCurrency)) / 100, 2);
            end;
          end
          else
          begin
            qryProdutosDadosFiscais.Edit;
            qryProdutosDadosFiscaisproduto.AsLargeInt := qryOSPGridproduto.AsLargeInt;
            qryProdutosDadosFiscaiscodigovisual.AsString := qryOSPGridcodigovisual.AsString;
            qryProdutosDadosFiscaisdescricaoproduto.AsString := qryOSPGriddescricaoproduto.AsString;
            qryProdutosDadosFiscaisquantidade.AsCurrency := qryOSPGridqtdenota.AsCurrency;
            qryProdutosDadosFiscaisprecovenda.AsCurrency := qryOSPGridpreco.AsCurrency;
            if qryOSPGridicms.AsInteger > 0 then
            begin
              qryProdutosDadosFiscaisicms.AsInteger          := qryOSPGridicms.AsInteger;
              qryProdutosDadosFiscaisaliquotaicms.AsCurrency := qryospGridaliquotaicms.AsCurrency;
            end;
            if qryProdutosPedidosGridipi.AsInteger > 0 then
            begin
              qryProdutosDadosFiscaisipi.AsInteger           := qryOSPGridipi.AsInteger;
              qryProdutosDadosFiscaisaliquotaipi.AsCurrency  := qryOSPGridaliquotaipi.AsCurrency;
              qryProdutosDadosFiscaisvaloripi.AsCurrency     :=
                truncar((((qryProdutosDadosFiscaisquantidade.AsCurrency * qryProdutosDadosFiscaisprecovenda.AsFloat) * qryProdutosDadosFiscaisaliquotaipi.AsCurrency)) / 100, 2);
            end;
          end;
          FSubstituicaoIPIProdutos := qryProdutosDadosFiscaissubstituicaoipi.AsBoolean;
          qryProdutosDadosFiscais.Post;
        except
          Result:=False;
        end;
      finally
        FPodeIncluirProdutosDadosFiscais := False;
      end;
    end;
    if not Result then
      qryospGrid.Next;
  end
  else
    Result := False;
}
end;

function TdtmEmissaoNotasVenda.GetDadosFiscalEmEdicaoInsercao: Boolean;
begin
  Result := qryDadosFiscais.State in [dsEdit, dsInsert];
end;

procedure TdtmEmissaoNotasVenda.qryProdutosPedidosGridAfterInsert(
  DataSet: TDataSet);
begin
  inherited;
  if not FAdicionandoNoGrid then
    DataSet.Cancel;
end;

procedure TdtmEmissaoNotasVenda.qryDadosFiscaisAfterInsert(
  DataSet: TDataSet);
begin
  inherited;
  AbrirTabelas;
  FSubstituicaoIPIProdutos := False;
end;

procedure TdtmEmissaoNotasVenda.AbrirTabelas;
begin
  RefazConsulta(qryProdutosDadosFiscais,[0],[0]);
  RefazConsulta(qryVenctosDadosFiscais,[0],[0]);
  RefazConsulta(qryNotas,[],[]);
  ReFazConsulta(qryVolumesDadosFiscais,[0],[0]);
  ReFazConsulta(qryLacresVolumesDadosFiscais,[0],[0]);
end;

procedure TdtmEmissaoNotasVenda.FecharTabelas;
begin
  qryProdutosDadosFiscais.Close;
  qryLinhasNotasFiscais.Close;
  qryVenctosDadosFiscais.Close;
  if qryNotas.State <> dsInactive then
    qryNotas.Close;
  if qrySeriesFiliais.State <> dsInactive then
  begin
    qrySeriesFiliais.Close;
    Perpetrar([]); //unlock Row-level locks
  end;
  qryVolumesDadosFiscais.close;
  qryLacresVolumesDadosFiscais.Close;
end;

procedure TdtmEmissaoNotasVenda.qryPedidosSaidaBeforeDelete(
  DataSet: TDataSet);
begin
  inherited;
  if not FPermiteDeletarPedido then
    DataSet.Cancel;
end;

procedure TdtmEmissaoNotasVenda.qryDadosFiscaisAfterCancel(
  DataSet: TDataSet);
begin
  inherited;
  FecharTabelas;
  if Assigned(OnDadosFiscaisAfterCancel) then
    OnDadosFiscaisAfterCancel(qryDadosFiscais);
end;

procedure TdtmEmissaoNotasVenda.qryPedidosSaidaBeforeInsert(
  DataSet: TDataSet);
begin
  inherited;
  if not qryDadosFiscais.Active then
    qryDadosFiscais.Open;
  if not DadosFiscalEmEdicaoInsercao then
    qryDadosFiscais.Append;
end;

function TdtmEmissaoNotasVenda.GravarDadoFiscal: Boolean;
var
  baseicms,
  valoricms,
  valorISS,
  ValorIPI,
  ValorPIS,
  ValorCOFINS,
  ValorTotal: Currency;

  ChaveAcesso,
  LoteNFe,
  ReciboNFe,
  ProtocoloNFe: String;

{
  procedure GerarLinhasNotasFiscais;
  var
    i, Cont, Linha, OSPAnterior: Integer;
    Obs, ObsLinha: String;
  begin
    Linha := 1;

    if not qryLinhasNotasFiscais.Active then
      qryLinhasNotasFiscais.Open;
    qryLinhasNotasFiscais.Append;
    qryLinhasNotasFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
    qryLinhasNotasFiscaislinha.AsInteger := Linha;
    qryLinhasNotasFiscaistexto.AsString  := 'RESISTORES DE FIO DO TIPO:';
    qryLinhasNotasFiscais.Post;

    GuardarRegistroAtual(qryProdutosDadosFiscais,True);
    try
      qryProdutosDadosFiscais.First;
      OSPAnterior := qryProdutosDadosFiscaisosp.AsInteger;
      while not qryProdutosDadosFiscais.Eof do
      begin
        if (qryProdutosDadosFiscais.RecNo = 1) or
           (qryProdutosDadosFiscaisosp.AsInteger <> OSPAnterior) then
        begin
          Inc(linha);
          qryLinhasNotasFiscais.Append;
          qryLinhasNotasFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
          qryLinhasNotasFiscaislinha.AsInteger := linha;
          qryLinhasNotasFiscaistexto.AsString  := 'N/N ' + Format('%6.6d',[qryProdutosDadosFiscaisOSP.AsInteger]) +
                                                  '     S/N ' + qryProdutosDadosFiscaispedidocliente.AsString;
          qryLinhasNotasFiscais.Post;
        end;

        if qryProdutosDadosFiscaisprodutocliente.AsString <> '' then
        begin
          Inc(linha);
          qryLinhasNotasFiscais.Append;  // LINHA COM O PRODUTO SIMPLES
          qryLinhasNotasFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
          qryLinhasNotasFiscaislinha.AsInteger := linha;
          qryLinhasNotasFiscaistexto.AsString  := '   ' + qryProdutosDadosFiscaiscodigovisual.AsString;
          qryLinhasNotasFiscais.Post;
        end;

        Inc(linha);
        qryLinhasNotasFiscais.Append;
        qryLinhasNotasFiscaisdadofiscal.AsInteger        := qryDadosFiscaisnumero.AsInteger;
        qryLinhasNotasFiscaislinha.AsInteger             := linha;
        qryLinhasNotasFiscaisprodutodadofiscal.AsInteger := qryProdutosDadosFiscaisnumero.AsInteger;
        qryLinhasNotasFiscais.Post;

        qryProdutosDadosFiscais.Next;
      end;

      //QDO ALÍQUOTA DOS PRODUTOS FOR NEGATIVA VAI TER DESCONTO
      if qryDadosFiscaisdesconto.AsCurrency<>0 then
      begin
        Inc(linha);
        qryLinhasNotasFiscais.Append;
        qryLinhasNotasFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
        qryLinhasNotasFiscaislinha.AsInteger := linha;
        qryLinhasNotasFiscaistexto.AsString  := 'DIFERENÇA DE PREÇO POR MOTIVO';
        qryLinhasNotasFiscais.Post;
        Inc(linha);
        qryLinhasNotasFiscais.Append;
        qryLinhasNotasFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
        qryLinhasNotasFiscaislinha.AsInteger := linha;
        qryLinhasNotasFiscaistexto.AsString  := 'DA OPERAÇÃO SER ISENTA DE ICMS '+'    '+
                                                 FormatFloat('##0.00',qryProdutosDadosFiscaisaliquotaicms.AsCurrency)+'%'+
                                                 '     '+formatfloat('###,###,##0.00',qryDadosFiscaisdesconto.AsCurrency);
        qryLinhasNotasFiscais.Post;
      end;

      if Trim(qryDadosFiscaisobscliente.AsString) <> '' then
        Obs := qryDadosFiscaisobscliente.AsString;
      if qryDadosFiscaisipisuspenso.AsBoolean and
         (trim(qryDadosFiscaisobsclienteipisuspenso.AsString) <> '') then
        Obs := Obs + sLineBreak + qryDadosFiscaisobsclienteipisuspenso.AsString;
      if (qrydadosfiscaisdadofiscalcomplementar.Asinteger<>0) and
         (trim(qryDadosFiscaisobservacoescomplementar.AsString) <> '') then
        Obs := Obs + sLineBreak + qryDadosFiscaisobservacoescomplementar.AsString;

      ObsLinha := '';
      Cont := 0;
      i := 1;
      while i <= Length(Obs) do
      begin
        Inc(Cont);
        if ((Obs[i] = #$D) and (Obs[i+1] = #$A)) or (Cont = 63) or (i = Length(Obs)) then
        begin
         if (Obs[i] = #$D) and (Obs[i+1] = #$A) then
            Inc(i)
         else
         if (Cont = 63) or (i = Length(Obs)) then
           ObsLinha := ObsLinha + Obs[i];
          Inc(Linha);
          qryLinhasNotasFiscais.Append;
          qryLinhasNotasFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
          qryLinhasNotasFiscaislinha.AsInteger := Linha;
          qryLinhasNotasFiscaistexto.AsString  := ObsLinha;
          qryLinhasNotasFiscais.Post;
          ObsLinha := '';
          Cont := 0;
        end
        else
          ObsLinha := ObsLinha + Obs[i];
        inc(i);
      end;

    finally
      VoltarRegistroAtual(qryProdutosDadosFiscais);
    end;
  end;
}
begin
  Result     := false;
  ValorTotal := 0;
  ValorPIS   := 0;
  ValorCOFINS:= 0;
  if qryDadosFiscais.CheckRequiredFields then
  begin
    spcDadosFiscaisProximo.Open;
    qryDadosFiscaisnumero.AsInteger := spcDadosFiscaisProximonumero.AsInteger;
    qryDadosFiscais.Post;
    spcDadosFiscaisProximo.Close;

//    GuardarRegistroAtual(qryVolumesDadosFiscais,true);
    qryVolumesDadosFiscais.DisableControls;
    try
      qryVolumesDadosFiscais.First;
      while not qryVolumesDadosFiscais.Eof do
      begin
        if (qryVolumesDadosFiscaisvolumes.AsString           = '') and
           (qryVolumesDadosFiscaisnumeracao.AsString         = '') and
           (qryVolumesDadosFiscaispesobruto.AsString         = '') and
           (qryVolumesDadosFiscaispesoliquido.AsString       = '') and
           (qryVolumesDadosFiscaismarca.AsString             = '') and
           (qryVolumesDadosFiscaisespecietransporte.AsString = '') then
          qryVolumesDadosFiscais.Delete
        else
        begin
          qryVolumesDadosFiscais.Edit;
          qryVolumesDadosFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
          qryVolumesDadosFiscais.Post;
          qryLacresVolumesDadosFiscais.First;
          while not qryLacresVolumesDadosFiscais.Eof do
          begin
            if (qryLacresVolumesDadosFiscaislacre.AsString = '') then
              qryLacresVolumesDadosFiscais.Delete
            else
            begin
              qryLacresVolumesDadosFiscais.Edit;
              qryLacresVolumesDadosFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
              qryLacresVolumesDadosFiscais.Post;
              qryLacresVolumesDadosFiscais.Next;
            end;
          end;
          qryVolumesDadosFiscais.Next;
        end;
      end;
    finally
      qryVolumesDadosFiscais.EnableControls; //VoltarRegistroAtual(qryVolumesDadosFiscais);
    end;


    GuardarRegistroAtual(qryProdutosDadosFiscais,true);
    qryProdutosDadosFiscais.First;
    while not qryProdutosDadosFiscais.Eof do
    begin
      qryProdutosDadosFiscais.Edit;
      qryProdutosDadosFiscaisnumero.AsInteger := qryProdutosDadosFiscais.RecNo;
      qryProdutosDadosFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
      qryProdutosDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger;
      qryProdutosDadosFiscaisnatureza.AsInteger := qryDadosFiscaiscodigonatureza.AsInteger;

      qryProdutosDadosFiscaisnaogerardebitoicms.AsBoolean := qryProcuraNaturezasCFOPnaogerardebitoicms.AsBoolean;
      qryProdutosDadosFiscaisnaogerardebitoipi.AsBoolean := qryProcuraNaturezasCFOPnaogerardebitoipi.AsBoolean;
      qryProdutosDadosFiscaisnaocalcularipisobrefrete.AsBoolean := qryProcuraNaturezasCFOPnaocalcularipisobrefrete.AsBoolean;
{      qryProdutosDadosFiscaisdestacaripi.AsBoolean := qryProcuraCodigoFiscalProdutodestacaripi.AsBoolean;}


      qryProdutosDadosFiscaisentregue.AsCurrency :=
        qryProdutosDadosFiscaisentregue.AsCurrency +
        qryProdutosDadosFiscaisquantidade.AsCurrency;
      qryProdutosDadosFiscais.Post;
      ValorPIS := ValorPIS + qryProdutosDadosFiscaispisvalor.AsCurrency;
      ValorCOFINS := ValorCOFINS + qryProdutosDadosFiscaiscofinsvalor.AsCurrency;
      qryProdutosDadosFiscais.Next;
    end;

    VoltarRegistroAtual(qryProdutosDadosFiscais);

    GuardarRegistroAtual(qryVenctosDadosFiscais,true);
    qryVenctosDadosFiscais.First;
    while not qryVenctosDadosFiscais.Eof do
    begin
      qryVenctosDadosFiscais.Edit;
      qryVenctosDadosFiscaisdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
      qryVenctosDadosFiscais.Post;
      ValorTotal := ValorTotal + qryVenctosDadosFiscaisvalorvencto.AsCurrency;
      qryVenctosDadosFiscais.Next;
    end;
    VoltarRegistroAtual(qryVenctosDadosFiscais);

    qryNotas.Edit;
    qryNotasdadofiscal.AsInteger := qryDadosFiscaisnumero.AsInteger;
    qryNotas.Post;

    qryDadosFiscais.Edit;
    if not qryDadosFiscaisipisuspenso.AsBoolean then
      qryDadosFiscaisobsclienteipisuspenso.Clear;

    qryDadosFiscaisvalortotal.AsCurrency   := ValorTotal;
//    qryDadosFiscaisvalorprodutos.AsCurrency:= TotalProdutos;
    qryDadosFiscaisvalorvista.AsCurrency   := qryDadosFiscaisvalorprodutos.AsCurrency +
                                              qryDadosFiscaisvalorfrete.AsCurrency +
                                              qryDadosFiscaisseguro.AsCurrency +
                                              qryDadosFiscaisdespesasacessorias.AsCurrency +
                                              qryDadosFiscaisvaloripi.AsCurrency -
                                              qryDadosFiscaisdesconto.AsCurrency;
//    qryDadosFiscaisdesconto.AsCurrency    := TotalDescontos;
    qryDadosFiscaissituacao.AsString      := 'N';

    RatearValoresProdutos;

    CalcularImpostos(qryprodutosdadosfiscais, qrydadosFiscais, contribipi, true, true, nil, nil, false, NotaIndustria);


  {
  Modelo do documento fiscal autorizado:
  55 - Nota Fiscal eletrônica,
  57 - Conhecimento de Transporte eletrônico.
  99 - uso exclusivo do Fisco para inclusão de
  qualquer órgão público no cadastro de
  emissores de DFe com objetivo de permitir o
  acesso ao WS - CadConsultaCadastro de
  Consulta Cadastro de Contribuintes do ICMS
  de qualquer unidade federada.
  }
    if qryDadosFiscaismodelodocto.IsNull then
      qryDadosFiscaismodelodocto.AsString      := '55';
    qryDadosFiscaisnrdocumento.AsInteger     := qryNotasnumero.AsInteger;
    Randomize;
    qryDadosFiscaiscodaleatorio.AsInteger    := random(99999999);
    qryDadosFiscaisformapagto.AsInteger      := FormaPagamento;

    { 1-Retrato/ 2-Paisagem }
    qryDadosFiscaisformatodanfe.AsInteger    := 1;
    {1-Normal/ 2-Contingência com Formulario de Segurança/ 3- Contingência SCAN/ 4-Contingência Eletrônica}
    qryDadosFiscaisformaemissao.AsInteger    := NFeTipoEmissao;

    ChaveAcesso :=
               copy(CodigoCidadeIBGEFilialBase,1,2)+                       // 2
               FormatDateTime('YYMM',qryDadosFiscaisdata.AsDateTime)+      // 4
               preencheString(CNPJFilialBase,'0',14,false)+                // 14
               preencheString(qryDadosFiscaismodelodocto.AsString,'0',2,false)+// 2
               preencheString(SerieSugestao,'0',3,false)+                  // 3
               preencheString(qryDadosFiscaisnrdocumento.Asstring,'0',9,false) + // 9
               qryDadosFiscaisformaemissao.AsString + // 1
               preencheString(qryDadosFiscaiscodaleatorio.Asstring,'0',8,false);  // 8

    qryDadosFiscaisdigchaveacesso.AsString   := Modulo11(ChaveAcesso);
    qrydadosfiscaischv_nfe.asstring := ChaveAcesso + qryDadosFiscaisdigchaveacesso.AsString;
//       modulo11(ChaveAcesso,'98765432',false);

    qryDadosFiscaisambiente.AsInteger         := NFeAmbiente; {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}

    {1 - normal 2 - compelementar}
    if qryDadosFiscaisdadofiscalcomplementar.AsInteger=0 then
       qryDadosFiscaisfinalidadenf.AsInteger  := 1
    else
       qryDadosFiscaisfinalidadenf.AsInteger  := 2;

    qryDadosFiscaisversaolayout.AsCurrency  := 2.00;

    qryDadosFiscaisprocemissao.AsString      := '0';
    qryDadosFiscaisversaoteclux.AsString     := VersaoTecLUX;

    if Trim(qryDadosFiscaisobscliente.AsString) <> '' then
      qryDadosFiscaisinfcomplementar.AsString := qryDadosFiscaisobscliente.AsString;
    if qryDadosFiscaisipisuspenso.AsBoolean and
      (trim(qryDadosFiscaisobsclienteipisuspenso.AsString) <> '') then
      qryDadosFiscaisinfcomplementar.AsString := qryDadosFiscaisinfcomplementar.AsString +
        sLineBreak + qryDadosFiscaisobsclienteipisuspenso.AsString;
    if (qrydadosfiscaisdadofiscalcomplementar.Asinteger<>0) and
       (trim(qryDadosFiscaisobservacoescomplementar.AsString) <> '') then
      qryDadosFiscaisinfcomplementar.AsString := qryDadosFiscaisinfcomplementar.AsString + sLineBreak + qryDadosFiscaisobservacoescomplementar.AsString;

    result := gravarContrato;
    if result then
    begin
      qryDadosFiscaiscontrato.AsString := qryTecContratonumero.AsString;
      qrydadosfiscais.Post;

      if ParSistema.EmissorNfe then
        result := GerarNFE(ChaveAcesso, LoteNFe, ReciboNFe, ProtocoloNFe, true);

      if result then
      begin
        result := Perpetrar([qryTecContrato, qryProdutosContratos, qryParcelas,
                           qryDadosFiscais,
                           qryVolumesDadosFiscais, qrylacresVolumesDadosFiscais,
                           {qryLinhasNotasFiscais, }qryProdutosDadosFiscais,
                           qryVenctosDadosFiscais,
                           qryNotas, qrySeriesFiliais]);

        if result then
        begin
          GerarArquivoExportacao;

          if not ParSistema.EmissorNfe then
            Result := ImprimirNotaFiscal
          else
            result := GerarNFE(ChaveAcesso, LoteNFe, ReciboNFe, ProtocoloNFe, true);

          if result then
          begin
            if ParSistema.GerarContabilidade then
            begin
              result := GerarLancamentosContabilidade;
              if result  then
                result := Perpetrar([qryTecContrato, qryProdutosContratos, qryParcelas,
                                     qryDadosFiscais,
                                     qryVolumesDadosFiscais, qrylacresVolumesDadosFiscais,
                                     {qryLinhasNotasFiscais, }qryProdutosDadosFiscais,
                                     qryVenctosDadosFiscais,
                                     qryNotas, qrySeriesFiliais,
                                     dtmLancamentoContabilidade.qryLancamentosNotasSaidas]);
            end
            else
              result := Perpetrar([qryTecContrato, qryProdutosContratos, qryParcelas,
                                   qryDadosFiscais,
                                   qryVolumesDadosFiscais, qrylacresVolumesDadosFiscais,
                                   {qryLinhasNotasFiscais, }qryProdutosDadosFiscais,
                                   qryVenctosDadosFiscais,
                                   qryNotas, qrySeriesFiliais]);

            if Result then
              result := GerarNFE(ChaveAcesso, LoteNFe, ReciboNFe, ProtocoloNFe);
          end;
        end;      
      end;
    end
    else
      MensagemErro(format(ctERROPROCESSAMENTO,['GRAVAÇÃO DO CONTRATO']));
  end;
end;

function TdtmEmissaoNotasVenda.ComplementarDadosNota: Boolean;
begin
  result := VerificarSerieFilial;
  if Result then
  begin
    if not (qrydadosfiscais.State in [dsedit, dsinsert]) then
      qryDadosFiscais.Edit;
    qryDadosFiscaisdata.AsDateTime := DataServidor;
    qryDadosFiscaisdatasaida.AsDateTime := DataServidor;
  //  qryDadosFiscaiscomplementarnota.AsBoolean := False;
    qryDadosFiscaissubstituicaoipi.AsBoolean := FSubstituicaoIPIProdutos;

    if not qryNotas.active then
      qryNotas.open;
    if not (qrynotas.state in [dsinsert]) then
      qryNotas.Append;
    qryNotasnumero.AsInteger := qrySeriesFiliaisnumeroinicial.AsInteger;
    qryNotasfilial.AsInteger := FilialBase;
    qryNotasserie.AsString   := SerieSugestao;
    qryNotas.Post;

    qrySeriesFiliais.Edit;
    qrySeriesFiliaisnumeroinicial.AsInteger := qrySeriesFiliaisnumeroinicial.AsInteger + 1;
    qrySeriesFiliais.Post;

    if qryConsultaNaturezasCFOP.MacroByName('CodigoFiscal').AsString = '' then
      qryConsultaNaturezasCFOP.MacroByName('CodigoFiscal').AsString :=
        'and (n.codigofiscal in (select cf.codigo from codigosfiscais cf))';

    if qryDadosFiscaisestadocfo.AsString = dtmEmissaoNotasVenda.EstadoFilialBase then
    begin
      qryConsultaNaturezasCFOP.ParamByName('local').asstring := 'L';
      qryprocuraNaturezasCFOP.ParamByName('local').asstring  := 'L';
      if qryDadosFiscaisrecolhericmsst.AsBoolean then
        qryDadosFiscaiscodigofiscal.AsInteger                  := 5401
      else
        qryDadosFiscaiscodigofiscal.AsInteger                  := 5101;

    end
    else
    if HeUnidadeFederacao(qryDadosFiscaisestadocfo.AsString) then
    begin
      qryConsultaNaturezasCFOP.ParamByName('local').asstring := 'F';
      qryprocuraNaturezasCFOP.ParamByName('local').asstring  := 'F';
      if qryDadosFiscaisrecolhericmsst.AsBoolean then
        qryDadosFiscaiscodigofiscal.AsInteger                  := 6401
      else
        qryDadosFiscaiscodigofiscal.AsInteger                  := 6101;
    end
    else
    begin
      qryConsultaNaturezasCFOP.ParamByName('local').asstring := 'E';
      qryprocuraNaturezasCFOP.ParamByName('local').asstring  := 'E';
      qryDadosFiscaiscodigofiscal.AsInteger                  := 7101;
    end;

    qryProcuraNaturezasCFOP.ParamByName('codigofiscal').AsInteger := qryDadosFiscaiscodigofiscal.AsInteger;
    ReFazConsulta(qryProcuraNaturezasCFOP,[],[]);

  end;
end;

