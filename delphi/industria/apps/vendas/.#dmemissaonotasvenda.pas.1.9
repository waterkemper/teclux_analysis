procedure TdtmEmissaoNotasVenda.DefinirVentosDadosFiscais(Parcelas: TResumosParcelas;
  MesTrintaDias: Boolean; Intervalo: Integer);
const
  Numero           = 1;
  Vencimento       = 2;
  Valor            = 3;
  FormaPagamento   = 4;
  TipoRecebimento  = 5;
var
  Data  : TDateTime;
  A,B,NP: Integer;
  ParcelasAuxiliar: array [1..5] of TStringList;
begin
  ParcelasAuxiliar[Numero] := TStringList.Create;
  ParcelasAuxiliar[Vencimento] := TStringList.Create;
  ParcelasAuxiliar[Valor] := TStringList.Create;
  ParcelasAuxiliar[FormaPagamento] := TStringList.Create;
  ParcelasAuxiliar[TipoRecebimento] := TStringList.Create;

  qryVenctosDadosFiscais.Close;
  NP := 1;
  for A := 0 to high(Parcelas) do
  begin
    B := 0;
    Data := Parcelas[A].Vencimento;
    while B < Parcelas[A].Parcelas do
    begin
      if (Parcelas[A].Valor<>0) then
      begin
        ParcelasAuxiliar[Numero].Append(inttostr(NP));
        if B = 0 then
          ParcelasAuxiliar[Vencimento].Append(datetimetostr(Data))
        else
        begin
          if MesTrintaDias then
            ParcelasAuxiliar[Vencimento].Append(datetimetostr(SomarDia(Data, Intervalo*B ,'S')))
          else ParcelasAuxiliar[Vencimento].Append(datetimetostr(SomarDia(Data, Intervalo*B ,'N')));
        end;
        ParcelasAuxiliar[Valor].Append(floattostr(Parcelas[A].Valor));
        ParcelasAuxiliar[FormaPagamento].Append(Parcelas[A].FormaPagamento);
        ParcelasAuxiliar[TipoRecebimento].Append(IntToStr(Parcelas[A].TipoRecebimento));
        Inc(NP);
      end;
      Inc(B);
    end;
  end;
(*
  for A := 1 to ParcelasAuxiliar[Vencimento].Count - 1 do begin
    B := A;
    While strtodatetime(ParcelasAuxiliar[Vencimento].Strings[B])<
          strtodatetime(ParcelasAuxiliar[Vencimento].Strings[B-1]) do
    begin
      ParcelasAuxiliar[Vencimento].Move(B,B-1);
      ParcelasAuxiliar[Numero].Move(B,B-1);
      ParcelasAuxiliar[Valor].Move(B,B-1);
      ParcelasAuxiliar[FormaPagamento].Move(B,B-1);
      ParcelasAuxiliar[TipoRecebimento].Move(B,B-1);
      if B=1 then
        break
      else
        B := B-1;
    end;
  end;
*)

  if qryVenctosDadosFiscais.RecordCount > 0 then
    LimparTabela(qryVenctosDadosFiscais);
  if not qryVenctosDadosFiscais.Active then
    qryVenctosDadosFiscais.Open;
  for A := 0 to ParcelasAuxiliar[Vencimento].Count - 1 do begin
    qryVenctosDadosFiscais.Append;
    qryVenctosDadosFiscaisnumero.AsInteger        := strtoint(ParcelasAuxiliar[Numero].Strings[A]);
    qryVenctosDadosFiscaisdatavencto.AsString     := ParcelasAuxiliar[Vencimento].strings[A];
    qryVenctosDadosFiscaisvalorvencto.AsString    := ParcelasAuxiliar[Valor].strings[A];
    qryVenctosDadosFiscais.Post;
  end;
end;

function TdtmEmissaoNotasVenda.ImprimirNotaFiscal: Boolean;
begin
  if qryDadosFiscais.Active then begin
    dtmImprimeFiscal := TdtmImprimeFiscal.Create(Self);
    try
      Result := dtmImprimeFiscal.ImprimirNotaIndustria(qryDadosFiscaisnumero.AsInteger);
    finally
      dtmImprimeFiscal.Free;
      dtmImprimeFiscal := nil;
    end
  end
  else
    Result := False;
end;

procedure TdtmEmissaoNotasVenda.qryProdutosDadosFiscaisCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if (qryDadosFiscais.State = dsinsert) then
  begin
    qryProdutosDadosFiscaissaldo.AsCurrency := qryProdutosDadosFiscaispedida.AsCurrency -
                                      qryProdutosDadosFiscaisquantidade.AsCurrency   -
                                      qryProdutosDadosFiscaisentregue.AsCurrency;
    if (qryDadosFiscaisdadofiscalcomplementar.AsInteger<>0) then
      qryProdutosDadosFiscaissaldo.AsCurrency := qryProdutosDadosFiscaispedida.AsCurrency -
                                        qryProdutosDadosFiscaisentregue.AsCurrency;
  end
  else
    qryProdutosDadosFiscaissaldo.AsCurrency := qryProdutosDadosFiscaispedida.AsCurrency -
                                      qryProdutosDadosFiscaisentregue.AsCurrency
end;

function TdtmEmissaoNotasVenda.GravarProdutoDadoFiscal: Boolean;
begin
  if qryProdutosDadosFiscaisquantidade.AsCurrency = 0 then
    qryProdutosDadosFiscaisquantidade.Clear;
  if qryProdutosDadosFiscaisprecovenda.AsCurrency = 0 then
    qryProdutosDadosFiscaisprecovenda.clear;
  result := qryProdutosDadosFiscais.CheckRequiredFields;
  if result then
  begin
    if qryProdutosDadosFiscais.state in [dsedit, dsinsert] then
      qryProdutosDadosFiscais.Post;
  end;
end;

