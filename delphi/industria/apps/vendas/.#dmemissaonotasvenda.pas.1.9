function TdtmEmissaoNotasVenda.GetFormaPagamento: byte;
begin
    {
      0 – pagamento à vista;
      1 – pagamento à prazo;
      2 - outros.
    }

  fFormaPagamento := 0;
  qryVenctosDadosFiscais.First;
  while not qryVenctosDadosFiscais.Eof do
  begin
    if qryVenctosDadosFiscaisdatavencto.AsDateTime <> qryDadosFiscaisdata.AsDateTime then
    begin
      fFormaPagamento := 1;
      break;
    end;
    qryVenctosDadosFiscais.Next;
  end;
  Result := fFormaPagamento;
end;

