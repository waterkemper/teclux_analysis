function TdtmEmissaoNotasVenda.QuantidadeNaturezas: Boolean;
begin
 Result := (qryProcuraNaturezasCFOP.RecordCount > 1) and
            (qryDadosFiscais.State in [dsInsert, dsEdit]);
  if Result then
  begin
    qryConsultaNaturezasCFOP.MacroByName('CodigoFiscal').AsString := 'and (mod(n.codigofiscal,1000) = mod(' + IntToStr(qryProcuraNaturezasCFOPcodigofiscal.AsInteger) + ',1000))';
  end
  else
    qryConsultaNaturezasCFOP.MacroByName('CodigoFiscal').AsString := 'and (n.codigofiscal in (select cf.codigo from codigosfiscais cf))';
end;

procedure TdtmEmissaoNotasVenda.SelecionarNatureza;
begin
  qryProcuraNaturezasCFOP.parambyname('codigofiscal').asInteger  := qryConsultaNaturezasCFOPcodigofiscal.AsInteger;
  qryProcuraNaturezasCFOP.macrobyname('codigoconsulta').asstring := ' and (n.codigo = ' + IntToStr(qryConsultaNaturezasCFOPcodigo.AsInteger) + ') ';
  refazconsulta(qryProcuraNaturezasCFOP,[],[]);
  if not (qryDadosFiscais.State in [dsinsert, dsedit]) then
