procedure TdtmEmissaoNotasVenda.qryProcuraNaturezasCFOPAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
  qryDadosFiscaiscodigonatureza.AsInteger := qryProcuraNaturezasCFOPcodigonatureza.AsInteger;
  qryDadosFiscaisnatureza.AsString        := qryProcuraNaturezasCFOPdescricaonatureza.AsString;

  if qryDadosFiscaisdadofiscalcomplementar.AsInteger = 0 then
  begin
    qryProdutosDadosFiscais.First;
    while not qryProdutosDadosFiscais.Eof do
    begin
      qryProdutosDadosFiscais.Edit;

      {Excessão a regra: quando for para estado do Amazonas temos uma aliquota negativa para dar desconto}

      if qryProdutosDadosFiscaisaliquotaicms.AsCurrency < 0 then
      begin
        qryProdutosDadosFiscaisincidencia.AsString := '40'; //isentas
        qryProdutosDadosFiscaiscsosn.AsString := '101'; //Simples nacional
      end
      else
        if qryProcuraNaturezasCFOPicmscst.AsString<>'' then
          qryProdutosDadosFiscaisincidencia.AsString := qryProcuraNaturezasCFOPicmscst.AsString;

      if qryDadosFiscaisrecolhericmsst.AsBoolean and (qryProdutosDadosFiscaisincidencia.AsString = '00') then
        qryProdutosDadosFiscaisincidencia.AsString := '10';

      if qryProcuraNaturezasCFOPcsosn.AsString<>'' then
        qryProdutosDadosFiscaiscsosn.AsString := qryProcuraNaturezasCFOPcsosn.AsString;

      if qryDadosFiscaisipisuspenso.AsBoolean then
        qryProdutosDadosFiscaisipicst.AsString := '55'
      else
        qryProdutosDadosFiscaisipicst.AsString := qryProcuraNaturezasCFOPipicst.AsString;

      qryProdutosDadosFiscaispiscst.AsString := qryProcuraNaturezasCFOPpiscst.AsString;
      qryProdutosDadosFiscaiscofinscst.AsString := qryProcuraNaturezasCFOPcofinscst.AsString;

      qryProdutosDadosFiscaisnatureza.asinteger := qryDadosFiscaiscodigonatureza.AsInteger;
      qryProdutosDadosFiscaiscodigofiscal.AsInteger := qryDadosFiscaiscodigofiscal.AsInteger;

      qryProdutosDadosFiscais.post;
      qryProdutosDadosFiscais.Next;
    end;

  end;
  CalcularImpostos(qryprodutosdadosfiscais, qrydadosFiscais, contribipi, true, true, nil, nil, false, NotaIndustria);
end;

