  object qryVendasProdutosporGrupos_AUX: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'meses_1'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'meses_2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sqlMoedaSelecionada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sqlDataFaturamento_2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sqlMoeda'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sqlDataCotacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';select vendas.*,'
      '       %meses_1'
      '       produtos.quantidadeperiodo,'
      '       produtos.valorperiodo'
      'from'
      '('
      'SELECT * FROM crosstab'
      '('
      #39'select cast(vendas.descricaogrupo||'
      '             vendas.grupo||'
      '             vendas.descricaoproduto||'
      '             vendas.produto  as varchar(100)) as grupoproduto,'
      ''
      '             cast(null as varchar(1)) as expandir,'
      '             vendas.produto,'
      ''
      
        '             cast('#39#39'  '#39#39'||vendas.descricaoproduto as varchar(43)' +
        ') as descricaoproduto,'
      ''
      '             Vendas.PN,'
      '             vendas.grupo,'
      '             vendas.descricaogrupo,'
      '             vendas.ano_mes,'
      
        '             cast(trim(to_char(vendas.quantidade_mes, '#39#39'00000000' +
        '0'#39#39'))||trim(to_char(vendas.valor_mes,'#39#39'000000000.00'#39#39')) as char(' +
        '21)) as quantidade_mes'
      ''
      ' from'
      ' ('
      
        '   select grupo, descricaogrupo, produto, descricaoproduto, pn, ' +
        'ano_mes, sum(quantidade_mes) as quantidade_mes, sum(Valor_Mes) a' +
        's Valor_Mes'
      '   from'
      '   ('
      '   select c.grupo, df.Cliente,'
      '          g.descricao as descricaogrupo,'
      '          pdf.produto,'
      '          p.descricao as descricaoproduto,'
      ''
      '         (select cp.pn'
      '             from clientesprodutos cp'
      '             where pdf.produto = cp.produto'
      '                AND df.Cliente = cp.Cliente'
      '                and df.tipocliente = '#39#39'C'#39#39
      '                and cp.pn is not null limit 1) as pn,'
      ''
      '          to_char(df.data, '#39#39'YYYY/MM'#39#39') as ano_mes,'
      ''
      
        '          cast(sum(case when c.unidade = '#39#39'MIL'#39#39' then 1000*pdf.q' +
        'uantidade'
      
        '                        when c.unidade = '#39#39'CT'#39#39'  then 100*pdf.qu' +
        'antidade'
      
        '                                                 else pdf.quanti' +
        'dade'
      '                   end'
      '               ) as numeric(9,0)) as quantidade_mes,'
      ''
      
        '          cast(sum(pdf.quantidade*pdf.precovenda) as numeric(9,2' +
        ')) as valor_mes'
      ''
      ''
      '          from (dadosfiscais df'
      '                join (produtosdadosfiscais pdf'
      '                      join (produtos p join (caracteristicas c'
      
        '                                            join grupos g on c.g' +
        'rupo = g.codigo)'
      
        '                                            on p.caracteristica ' +
        '= c.codigo)'
      '                      on pdf.produto = p.codigo)'
      '                on df.numero = pdf.dadofiscal)'
      '          where df.situacao = '#39#39'N'#39#39
      
        '            and (mod(df.codigofiscal,1000) between 101 and 125 o' +
        'r'
      
        '                 MOD(df.codigofiscal,1000) BETWEEN 401 and 405 O' +
        'R'
      '                 mod(df.codigofiscal,1000) between 501 and 503)'
      ''
      '            %sqlDataFaturamento_1'
      ''
      
        '          group by  c.grupo, g.descricao, pdf.produto, p.descric' +
        'ao, ano_mes, df.cliente, df.tipocliente, pn'
      '   ) as vendas'
      
        '     group by grupo, descricaogrupo, produto, descricaoproduto, ' +
        'pn, ano_mes'
      ' ) as vendas'
      ' order by 1'#39','
      ' '#39'select distinct to_char(cast('#39#39
      '        %DataInicial_1'
      
        '        '#39#39' as date)  + s.a,'#39#39'YYYY/MM'#39#39') as mes from generate_ser' +
        'ies(1,cast('#39#39
      '            %DataFinal'
      '            '#39#39' as date)-cast('#39#39
      '              %DataInicial_2'
      '             '#39#39' as date)) as s(a) order by 1'#39
      ')'
      'AS'
      ' ( grupoproduto varchar(100),'
      ' expandir varchar(1),'
      ' produto bigint,'
      ' descricaoproduto varchar(43),'
      ' pn integer,'
      ' grupo varchar(4),'
      ' descricaogrupo varchar(30),'
      ' %meses_2'
      ' )'
      ') as vendas join'
      '               ('
      '                 select produto,'
      '                        sum(valorperiodo) as valorperiodo,'
      
        '                        sum(quantidadeperiodo) as quantidadeperi' +
        'odo'
      '                 from'
      '                 ('
      '                  select produtos.produto,'
      
        '                        %sqlMoedaSelecionada /*case when true th' +
        'en*/'
      '                           case when mc.cotacao is not null then'
      
        '                             produtos.valorperiodo/mc.cotacao en' +
        'd'
      '                           else'
      '                             produtos.valorperiodo'
      '                         end as valorperiodo,'
      '                         produtos.quantidadeperiodo'
      '                  from'
      '                   (select pdf.produto,'
      '                         to_char(df.data, '#39'YYYY/MM'#39') as ano_mes,'
      
        '                          sum(pdf.quantidade*pdf.precovenda) as ' +
        'valorperiodo,'
      
        '                          cast(sum(case when c.unidade = '#39'MIL'#39' t' +
        'hen 1000*pdf.quantidade'
      
        '                                        when c.unidade = '#39'CT'#39'  t' +
        'hen  100*pdf.quantidade'
      
        '                                                               e' +
        'lse      pdf.quantidade'
      '                                   end'
      
        '                              ) as numeric(9,0)) as quantidadepe' +
        'riodo'
      '                   from dadosfiscais df'
      '                        join produtosdadosfiscais pdf'
      '                             join produtos p'
      '                                   join caracteristicas c'
      
        '                                   on p.caracteristica = c.codig' +
        'o'
      '                             on pdf.produto = p.codigo'
      '                        on df.numero = pdf.dadofiscal'
      '                   where df.situacao = '#39'N'#39
      
        '                     and (mod(df.codigofiscal,1000) between 101 ' +
        'and 125 or'
      
        '                          MOD(df.codigofiscal,1000) BETWEEN 401 ' +
        'and 405 OR'
      
        '                          mod(df.codigofiscal,1000) between 501 ' +
        'and 503)'
      ''
      '                     %sqlDataFaturamento_2'
      '                   group by pdf.produto, ano_mes)'
      ''
      '                     as produtos left join'
      ''
      '                  (select ano_mes,'
      '                          avg(mc.cotacao) as cotacao'
      
        '                          from (select to_char(mc.data, '#39'YYYY/MM' +
        #39') as ano_mes,'
      '                                       mc.cotacao'
      '                                from moedascotacoes mc'
      
        '                                %sqlMoeda /*where mc.moeda = '#39#39'U' +
        'S$'#39#39'*/'
      
        '                                %sqlDataCotacao /* and mc.data b' +
        'etween('#39#39'2008-01-01'#39#39') and ('#39#39'2008-12-31'#39#39')*/'
      '                                ) as mc'
      
        '                  group by ano_mes) as mc on produtos.ano_mes = ' +
        'mc.ano_mes'
      '                 ) as produtos'
      '                 group by produto'
      
        '                ) as produtos on vendas.produto = produtos.produ' +
        'to'
      'order by vendas.grupoproduto'
      '')
    RequestLive = False
    Left = 312
    Top = 8
  end
