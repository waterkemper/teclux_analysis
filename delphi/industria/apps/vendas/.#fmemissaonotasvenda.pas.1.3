  edtLocalRetiradaCNPJ.Tipo := 'J';

  fraEnderecoRetirada.CampoCidadeIBGE := dtmEmissaoNotasVenda.qryDadosFiscaislocalretirada_cidadeibge;
  fraEnderecoEntrega.CampoCidadeIBGE := dtmEmissaoNotasVenda.qryDadosFiscaislocalentrega_cidadeibge;

