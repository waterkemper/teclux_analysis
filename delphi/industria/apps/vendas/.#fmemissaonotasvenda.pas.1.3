  pgcNotasVenda.Style := tsTabs;

  InternoIncluir;

end;

function TfrmEmissaoNotasVenda.InternoIncluir: Boolean;
begin
  Result:= inherited InternoIncluir;
  if Result then
  begin
    if not CtrlOn then
    begin
      if dtmEmissaoNotasVenda.IncluirNota then
      begin
        gbxOSP.Enabled := true;
        dbgProdutosDadosFiscais.Columns[4].ReadOnly := false;
        dbgProdutosDadosFiscais.Columns[1].ReadOnly := false;
        OperacaoNota := tonOSP;
        pgcNotasVenda.ActivePage := tstOSPs;
        FocarGridOSP(self);
        ConsultaOSP.qryProcuraCliente.Close;
      end;
    end
    else
      result := incluirProdutocontrato;
  end;
end;

procedure TfrmEmissaoNotasVenda.dbgProdutosDadosFiscaisKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Shift = [ssCtrl] then
  begin
    case Key of
      VK_F9 : begin
                 if dtmEmissaoNotasVenda.qryDadosFiscaisdadofiscalcomplementar.AsInteger=0 then
                 begin
                   ConsultaOSP.CtrlOn := Shift = [ssCtrl];
                   if (Shift = []) or ConsultaOSP.CtrlOn then
                     AcionaPesquisaGrade
                 end;
               end;
    end;
  end
  else
  begin
    case key of
      VK_Return :
      begin
        case dbgProdutosDadosFiscais.SelectedIndex of
        1 : begin
             if dtmEmissaoNotasVenda.qryDadosFiscaisdadofiscalcomplementar.AsInteger<>0 then
               dbgProdutosDadosFiscais.SelectedIndex := 5
             else
             begin
               if ConsultaOSP.edfCodigo.Exist then
               begin
                 AtribuirDadosOSP;
                 dbgProdutosDadosFiscais.SelectedIndex := 4;
                 dbgProdutosDadosFiscais.SetFocus;
               end
               else
               begin
                 dtmEmissaoNotasVenda.qryProdutosDadosFiscaisosp.Clear;
                 dbgProdutosDadosFiscais.SelectedIndex := 1;
                 dbgProdutosDadosFiscais.SetFocus;
               end;
             end;
            end;
        4 : dbgProdutosDadosFiscais.SelectedIndex := 5;
        5 : begin
              CtrlOn := True;
              if dtmEmissaoNotasVenda.GravarProdutoDadoFiscal then
              begin
                 if dtmEmissaoNotasVenda.qryDadosFiscaisdadofiscalcomplementar.AsInteger<>0 then
                   dtmEmissaoNotasVenda.qryProdutosDadosFiscais.Next
                 else
                 begin
                   InternoIncluir;
                   dbgProdutosDadosFiscais.SetFocus;
                   dbgProdutosDadosFiscais.SelectedIndex := 1;
                 end;
              end
              else
                  dbgProdutosDadosFiscais.SelectedIndex := 5;
            end;
        end;
      end;
    end;
  end;
end;

procedure TfrmEmissaoNotasVenda.AlterarEstadoBotoes;
begin
  inherited;
  if dtmEmissaoNotasVenda.DadosFiscalEmEdicaoInsercao then
  begin
    pnlCabecalhoDireita.Enabled := True;
    gbxCliente.Enabled := True;
    gbxObservacoes.Enabled := True;
  end
  else
  begin
    pnlCabecalhoDireita.Enabled := False;
    gbxCliente.Enabled := False;
    gbxObservacoes.Enabled := False;
  end;
  sbnSalvar.Enabled := (dtmEmissaoNotasVenda.qryProdutosDadosFiscais.RecordCount<>0) and
                       (dtmEmissaoNotasVenda.DadosFiscalEmEdicaoInsercao);

  sbnIncluirProduto.Enabled := dtmEmissaoNotasVenda.DadosFiscalEmEdicaoInsercao;
  sbnExcluirProduto.Enabled := sbnSalvar.Enabled;
end;

procedure TfrmEmissaoNotasVenda.FocarGridOSP(Sender: TObject);
begin
  if dbgProdutosDadosFiscais.CanFocus then
  begin
    dbgProdutosDadosFiscais.SetFocus;
    dbgProdutosDadosFiscais.SelectedIndex := 1;
    AlterarEstadoBotoes;
  end;
end;

function TfrmEmissaoNotasVenda.InternoGravar: Boolean;
begin
  Result := inherited InternoGravar;
  if Result then
  begin
    if OperacaoNota = tonOSP then
    begin
      result := dtmEmissaoNotasVenda.VerificarProdutosDadosFiscais;
      if result then
        Result := ComplementarDadosNota;
    end
    else
    begin
      Result := dtxValorTotal.DataSource.DataSet.FieldByName('valortotal').AsCurrency = dtmEmissaoNotasVenda.TotalVenctos;
      if not Result then
      begin
        MensagemAviso('A soma dos vencimentos: R$ ' + formatarValor(dtmEmissaoNotasVenda.TotalVenctos,2) +
                      ' difere do total da nota: R$ ' + formatarValor(dtxValorTotal.DataSource.DataSet.FieldByName('valortotal').AsCurrency,2));
        dbgVenctos.SetFocus;
      end
      else
        if dtmEmissaoNotasVenda.GravarDadoFiscal then
          InternoIncluir;
    end;
  end;
end;

function TfrmEmissaoNotasVenda.ComplementarDadosNota: Boolean;
begin
  Result := dtmEmissaoNotasVenda.ComplementarDadosNota;
  if Result then
  begin
    {frmComplementarNotasVenda := TfrmComplementarNotasVenda.Create(Self);
    try
      frmComplementarNotasVenda.DataModulo := dtmEmissaoNotasVenda;
      Result := frmComplementarNotasVenda.ShowModal = mrOK;
    finally
      frmComplementarNotasVenda.Free;
      SetFocus;
    end;
    }
    OperacaoNota := tonCOMPLEMENTAR;
    pgcNotasVenda.ActivePage := tstComplemento;
    edtDataEmissao.SetFocus;
  end;
end;


function TfrmEmissaoNotasVenda.Internoexcluir: Boolean;
begin
  inherited Internoexcluir;
  if MensagemConfirmacao(Format(ctCONFIRMEEXCLUIR, ['a osp desta nota fiscal'])) = smbOk then
  begin
    dtmEmissaoNotasVenda.qryProdutosDadosFiscais.Delete;
    AlterarEstadoBotoes;
  end;
  result := true;
end;

procedure TfrmEmissaoNotasVenda.sbnExcluirProdutoClick(Sender: TObject);
begin
  inherited;
  Internoexcluir;
end;

procedure TfrmEmissaoNotasVenda.OnProdutosDadosFiscaisAfterPost(
  Sender: TObject);
begin
  AlterarEstadoBotoes;
end;

procedure TfrmEmissaoNotasVenda.sbnIncluirProdutoClick(Sender: TObject);
begin
  inherited;
  incluirProdutocontrato;
end;

function TfrmEmissaoNotasVenda.incluirProdutocontrato: Boolean;
begin
  result := true;
  if (dtmEmissaoNotasVenda.qryProdutosDadosFiscais.State in [dsedit, dsinsert]) or
     (dtmEmissaoNotasVenda.qryProdutosDadosFiscais.RecordCount > 0) then
   result := dtmEmissaoNotasVenda.GravarProdutoDadoFiscal;

  if result then
  begin
    Result := dtmEmissaoNotasVenda.IncluirProdutosDadoFiscal;
    dbgProdutosDadosFiscais.SetFocus;
    dbgProdutosDadosFiscais.SelectedIndex := 1;
  end;
end;

procedure TfrmEmissaoNotasVenda.ParametrosNota;
begin
  fraConsultaNotaFiscalComplementar.qryProcuraNotas.ParamByName('filial').AsInteger :=
    dtmEmissaoNotasVenda.FilialBase;
  fraConsultaNotaFiscalComplementar.qryProcuraNotas.ParamByName('serie').AsString :=
    dtmEmissaoNotasVenda.SerieSugestao;
  fraConsultaNotaFiscalComplementar.qryProcuraNotas.MacroByName('SQL').AsString :=
    'and df.tipocliente = ''C''';

  fraConsultaNotaFiscalComplementar.qryconsultaNotas.MacroByName('SQL').AsString :=
    'and d.tipocliente = ''C'' '+
    'and n.filial = '+ inttostr(FilialBase) +
    'and n.serie = '+ dtmEmissaoNotasVenda.SerieSugestao;
end;

procedure TfrmEmissaoNotasVenda.AtribuirDadosOSPNFComplementar;
var
 i: integer;
begin
  with dtmEmissaoNotasVenda do
  begin
    ReFazConsulta(fraConsultaNotaFiscalComplementar.qryProcuraCliente,[0,1],
                 [fraConsultaNotaFiscalComplementar.qryProcuraNotascliente.AsInteger,'C']);

    if fraConsultaNotaFiscalComplementar.qryProcuraNotasCliente.AsInteger<>0 then
      qryDadosFiscaiscliente.value    := fraConsultaNotaFiscalComplementar.qryProcuraNotasCliente.value
    else
      qryDadosFiscaiscliente.clear;

    qryDadosFiscaisdadofiscalcomplementar.clear;
    qryDadosFiscaistagadpednfe.AsBoolean := fraConsultaNotaFiscalComplementar.qryProcuraClienteTagAdPedNFE.asboolean;
    qryDadosFiscaisnome.AsString       := fraConsultaNotaFiscalComplementar.qryProcuraClientenome.AsString;
    qryDadosFiscaisapelido.AsString     := fraConsultaNotaFiscalComplementar.qryProcuraClienteapelido.value;
    qryDadosFiscaistipocliente.AsString := 'C';
    qryDadosFiscaispessoatipo.value     := fraConsultaNotaFiscalComplementar.qryProcuraClientepessoatipo.value;
    qryDadosFiscaispessoanumero.value   := fraConsultaNotaFiscalComplementar.qryProcuraClientepessoanumero.value;
    qryDadosFiscaisfonenumero.value     := fraConsultaNotaFiscalComplementar.qryProcuraClientefonenumero.value;
    qryDadosFiscaisfoneddd.value        := fraConsultaNotaFiscalComplementar.qryProcuraClientefoneddd.value;
    qryDadosFiscaisdocumento.value      := fraConsultaNotaFiscalComplementar.qryProcuraClienteinscricaoestadual.value;
    qryDadosFiscaissuframa.value        := fraConsultaNotaFiscalComplementar.qryProcuraClientesuframa.value;
    //Este campos é para atribuir a ie da uf da filial no estado de destino da mercadoria
    //porém a Krah_ice nao possue retencão icms subst. tribut.
    //qryDadosFiscaisiesubsttributario.AsString := '';

    qryDadosFiscaisestadocfo.value            := fraConsultaNotaFiscalComplementar.qryProcuraClienteestado.value;
    qryDadosFiscaisobscliente.value           := fraConsultaNotaFiscalComplementar.qryProcuraClienteobsnotafiscal.value;
    qryDadosFiscaisipisuspenso.AsBoolean      := fraConsultaNotaFiscalComplementar.qryProcuraClienteipisuspenso.AsBoolean;
    qryDadosFiscaisobsclienteipisuspenso.value:= fraConsultaNotaFiscalComplementar.qryProcuraClienteobsipisuspenso.value;
    qryDadosFiscaisvendedor.value             := UsuarioLogin.CodigoUsuario;

    qryDadosFiscaisrua.value            := fraConsultaNotaFiscalComplementar.qryProcuraClienterua.value;
    qryDadosFiscaisendnumero.value      := fraConsultaNotaFiscalComplementar.qryProcuraClientenumero.value;
    qryDadosFiscaisendcomplemento.value := fraConsultaNotaFiscalComplementar.qryProcuraClientecomplemento.value;
    qryDadosFiscaisbairro.value         := fraConsultaNotaFiscalComplementar.qryProcuraClientebairro.value;
    qryDadosFiscaisnomebairro.AsString  := fraConsultaNotaFiscalComplementar.qryProcuraClientenomebairro.value;
    qryDadosFiscaiscidade.value         := fraConsultaNotaFiscalComplementar.qryProcuraClientecidade.value;
    qryDadosFiscaisnomecidade.AsString  := fraConsultaNotaFiscalComplementar.qryProcuraClientenomecidade.AsString;
    qryDadosFiscaiscidadeibge.value     := fraConsultaNotaFiscalComplementar.qryProcuraClientecidadeibge.value;
    qryDadosFiscaisestado.value         := fraConsultaNotaFiscalComplementar.qryProcuraClienteestado.value;
    qryDadosFiscaiscep.value            := fraConsultaNotaFiscalComplementar.qryProcuraClientecep.value;

    qryDadosFiscaislocalentrega_rua.AsString         := fraConsultaNotaFiscalComplementar.qryProcuraClienterefrua.AsString;
    qryDadosFiscaislocalentrega_numero.AsString      := fraConsultaNotaFiscalComplementar.qryProcuraClienterefnumero.AsString;
    qryDadosFiscaislocalentrega_complemento.AsString := fraConsultaNotaFiscalComplementar.qryProcuraClienterefcomplemento.AsString;
    qryDadosFiscaislocalentrega_bairro.AsString      := fraConsultaNotaFiscalComplementar.qryProcuraClienterefbairro.AsString;
    qryDadosFiscaislocalentrega_nomebairro.AsString  := fraConsultaNotaFiscalComplementar.qryProcuraClienterefnomebairro.AsString;
    qryDadosFiscaislocalentrega_cidade.AsString      := fraConsultaNotaFiscalComplementar.qryProcuraClienterefcidade.AsString;
    qryDadosFiscaislocalentrega_nomecidade.AsString  := fraConsultaNotaFiscalComplementar.qryProcuraClienterefnomecidade.AsString;
    qryDadosFiscaislocalentrega_cidadeibge.AsString  := fraConsultaNotaFiscalComplementar.qryProcuraClienterefcidadeibge.AsString;
    qryDadosFiscaislocalentrega_estado.AsString      := fraConsultaNotaFiscalComplementar.qryProcuraClienterefestado.AsString;
    qryDadosFiscaislocalentrega_cep.AsString         := fraConsultaNotaFiscalComplementar.qryProcuraClienterefcep.AsString;
    qryDadosFiscaislocalentrega_cnpj.AsString        := fraConsultaNotaFiscalComplementar.qryProcuraClientepessoanumero.AsString;

    qryDadosFiscaisvalortotal.AsCurrency   := fraConsultaNotaFiscalComplementar.qryProcuraNotasvalortotal.value;
    qryDadosFiscaisvalorprodutos.AsCurrency:= fraConsultaNotaFiscalComplementar.qryProcuraNotasvalorprodutos.value;
    qryDadosFiscaisvalorvista.AsCurrency   := fraConsultaNotaFiscalComplementar.qryProcuraNotasvalorvista.value;
    qryDadosFiscaisdesconto.AsCurrency    := fraConsultaNotaFiscalComplementar.qryProcuraNotasdesconto.value;
    qryDadosFiscaisvaloripi.AsCurrency := fraConsultaNotaFiscalComplementar.qryProcuraNotasvaloripi.value;

    while not qryProdutosDadosFiscais.Eof do
      qryProdutosDadosFiscais.Delete;

    ReFazConsulta(qryProdutosDadosFiscaisComplementar,[0],
      [fraConsultaNotaFiscalComplementar.qryProcuraNotasDadoFiscal.AsVariant]);

    while not qryProdutosDadosFiscaisComplementar.Eof do
    begin
      if qryprodutosdadosfiscais.State <> dsinsert then
        qryProdutosDadosFiscais.Append;

      for i:=0 to qryProdutosDadosFiscaisComplementar.FieldCount-1 do
      begin
        case qryProdutosDadosFiscaisComplementar.fields[i].DataType of
          ftLargeint :
          qryProdutosDadosFiscais.FieldByName(qryProdutosDadosFiscaisComplementar.fields[i].fieldName).asstring :=
             qryProdutosDadosFiscaisComplementar.fields[i].asstring

        else
          qryProdutosDadosFiscais.FieldByName(qryProdutosDadosFiscaisComplementar.fields[i].fieldName).Value :=
             qryProdutosDadosFiscaisComplementar.fields[i].value;
        end;
      end;
      qryProdutosDadosFiscais.Post;

      qryProdutosDadosFiscaisComplementar.Next;
    end;
    if fraConsultaNotaFiscalComplementar.qryProcuraNotasdadofiscal.AsInteger<>0 then
      qryDadosFiscaisdadofiscalcomplementar.AsInteger := fraConsultaNotaFiscalComplementar.qryProcuraNotasdadofiscal.AsInteger;
    dbgProdutosDadosFiscais.Columns[4].ReadOnly := not qryDadosFiscaisdadofiscalcomplementar.isnull;
    dbgProdutosDadosFiscais.Columns[1].ReadOnly := not qryDadosFiscaisdadofiscalcomplementar.isnull;
  end;
end;

