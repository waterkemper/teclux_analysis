procedure TfrmEmissaoNotasVenda.Action1Update(Sender: TObject);
begin
  inherited;
  if OperacaoNota = tonOSP then
    sbnSalvar.Caption := 'Complementar F5'
  else
    sbnSalvar.Caption := 'Imprimir F5';
end;

procedure TfrmEmissaoNotasVenda.KeyDown(var Key: Word; Shift: TShiftState);
begin
  case key of
    VK_ESCAPE: begin
                  if OperacaoNota = tonCOMPLEMENTAR then
                  begin
                    dtmEmissaoNotasVenda.LimparTabelasNotas;
                    OperacaoNota := tonOSP;
                    pgcNotasVenda.ActivePage := tstOSPs;
                    FocarGridOSP(self);
                  end
                  else
                    inherited;
                end;
    else
      inherited;
  end;
end;

procedure TfrmEmissaoNotasVenda.edtPlacaTransporteKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if key = VK_delete then
  begin
    dtmEmissaoNotasVenda.qryDadosFiscaisplaca.Clear;
    edtPlacaTransporte.Clear;
    edtPlacaTransporte.SelectAll;
  end;

end;

end.
