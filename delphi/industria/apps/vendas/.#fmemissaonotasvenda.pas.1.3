procedure TfrmEmissaoNotasVenda.AtribuirVenctosDadosFiscais;
var
  Parcelas: TResumosParcelas;
  ValorPrazo, TaxaJuros, Desconto: Real;
  Plano: Integer;
begin
  inherited;
  if dtmEmissaoNotasVenda.qryDadosFiscaisplano.AsInteger > 0 then
  begin
    dtmEmissaoNotasVenda.qryDadosFiscaisagente.AsInteger := fraConsultaCodigoPlano.qryProcuraPlanoagente.AsInteger;
    dtmEmissaoNotasVenda.qryDadosFiscaistaxajuros.AsCurrency := fraConsultaCodigoPlano.qryProcuraPlanotaxamensaljuros.AsCurrency;

    Plano := dtmEmissaoNotasVenda.qryDadosFiscaisplano.AsInteger;
    dtmCalculoFinanciamento := TdtmCalculoFinanciamento.Create(Owner);
    try
      dtmCalculoFinanciamento.ValorMercadoria  := dtmEmissaoNotasVenda.qryDadosFiscaisvalorprodutos.AsCurrency -
                                                  dtmEmissaoNotasVenda.qryDadosFiscaisdesconto.AsCurrency +
                                                  dtmEmissaoNotasVenda.qryDadosFiscaisvaloripi.AsCurrency;

      dtmCalculoFinanciamento.ValorFrete       := dtmEmissaoNotasVenda.qryDadosFiscaisvalorfrete.AsCurrency;
      dtmCalculoFinanciamento.ValorSeguro      := dtmEmissaoNotasVenda.qryDadosFiscaisseguro.AsCurrency +
                                                  dtmEmissaoNotasVenda.qryDadosFiscaisdespesasacessorias.AsCurrency;
      dtmCalculoFinanciamento.Desconto         := 0;
      dtmCalculoFinanciamento.CreditoTroca     := 0;
      dtmCalculoFinanciamento.DataCalculo      := dtmEmissaoNotasVenda.qryDadosFiscaisdata.AsString;
      dtmCalculoFinanciamento.PermiteDesconto  := False;
      dtmCalculoFinanciamento.ValorSubstituicaoTributaria := dtmEmissaoNotasVenda.qryDadosFiscaistotalvaloricmssubstituicao.AsCurrency;
      dtmCalculoFinanciamento.EstadoCliente    := dtmEmissaoNotasVenda.qryDadosFiscaisestado.AsString;
      dtmCalculoFinanciamento.DescontoItem     := 0;

      dtmCalculoFinanciamento.PreencherValores(True, Plano, Parcelas, nil, nil);

      if dtmCalculoFinanciamento.localizaPlanoPadrao(Plano) then
      begin
        dtmCalculoFinanciamento.ResumosParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano);
        dtmEmissaoNotasVenda.DefinirVentosDadosFiscais(Parcelas,
          fraConsultaCodigoPlano.edfCodigo.LookupSource.DataSet.FieldByName('mestrintadias').AsBoolean,
          fraConsultaCodigoPlano.edfCodigo.LookupSource.DataSet.FieldByName('intervaloparcelas').AsInteger);

      end;
    finally
      dtmCalculoFinanciamento.Free;
    end;
  end;
end;

