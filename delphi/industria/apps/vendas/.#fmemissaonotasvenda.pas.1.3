procedure TfrmEmissaoNotasVenda.AcionaPesquisaGrade;
begin
  ConsultaOSP.CtrlOn := True;
  if dtmEmissaoNotasVenda.qryDadosFiscaiscliente.IsNull then
    ConsultaOSP.qryProcuraCliente.Close;

  dbgProdutosDadosFiscais.SetFocus;
  case ConsultaOSP.InternoPesquisar(ctOSP) of
    mrOk   : begin
               dbgProdutosDadosFiscais.SelectedIndex :=  4;
               dbgProdutosDadosFiscais.SetFocus;
             end;
    mrCancel:begin
               dbgProdutosDadosFiscais.SelectedIndex :=  1;
               dbgProdutosDadosFiscais.SetFocus;
             end;
  end
end;

procedure TfrmEmissaoNotasVenda.AtribuirDadosOSP;
begin
  with dtmEmissaoNotasVenda do
  begin
    if (qryDadosFiscaiscliente.AsInteger  <> ConsultaOSP.qryProcuraOSPcliente.AsInteger) and
       (ConsultaOSP.qryProcuraOSPcliente.AsInteger<>0) then
    begin
      ReFazConsulta(ConsultaOSP.qryProcuraCliente,[0,1],[ConsultaOSP.qryProcuraOSPcliente.AsInteger,'C']);

      qryDadosFiscaiscliente.AsInteger    := ConsultaOSP.qryProcuraClientecodigo.AsInteger;
      qryDadosFiscaistagadpednfe.AsBoolean := ConsultaOSP.qryProcuraClienteTagAdPedNFE.asboolean;
      qryDadosFiscaisnome.AsString        := ConsultaOSP.qryProcuraClientenome.AsString;
      qryDadosFiscaisapelido.AsString     := ConsultaOSP.qryProcuraClienteapelido.AsString;
      qryDadosFiscaistipocliente.AsString := 'C';
      qryDadosFiscaispessoatipo.AsString  := ConsultaOSP.qryProcuraClientepessoatipo.AsString;
      qryDadosFiscaispessoanumero.AsString:= ConsultaOSP.qryProcuraClientepessoanumero.AsString;
      qryDadosFiscaisfonenumero.AsVariant := ConsultaOSP.qryProcuraClientefonenumero.AsVariant;
      qryDadosFiscaisfoneddd.AsVariant    := ConsultaOSP.qryProcuraClientefoneddd.AsVariant;
      qryDadosFiscaisdocumento.AsString   := ConsultaOSP.qryProcuraClienteinscricaoestadual.AsString;
      qryDadosFiscaisemail.AsString       := ConsultaOSP.qryProcuraClienteemail.AsString;
      qryDadosFiscaissuframa.AsString     := ConsultaOSP.qryProcuraClientesuframa.AsString;
      qryDadosFiscaisrecolhericmsst.AsBoolean := ConsultaOSP.qryProcuraClienterecolhericmsst.asboolean;

      //Este campos é para atribuir a ie da uf da filial no estado de destino da mercadoria
      //porém a Krah_ice nao possue retencão icms subst. tribut.
      //qryDadosFiscaisiesubsttributario.AsString := '';

      qryDadosFiscaisestadocfo.AsString   := ConsultaOSP.qryProcuraClienteestado.AsString;
      qryDadosFiscaisobscliente.AsString  := ConsultaOSP.qryProcuraClienteobsnotafiscal.AsString;
      qryDadosFiscaisipisuspenso.AsBoolean:= ConsultaOSP.qryProcuraClienteipisuspenso.AsBoolean;
      qryDadosFiscaisobsclienteipisuspenso.AsString:= ConsultaOSP.qryProcuraClienteobsipisuspenso.AsString;
      qryDadosFiscaisvendedor.AsInteger := UsuarioLogin.CodigoUsuario;


       if qryDadosFiscaisdebitar.isNull then
         if not ConsultaOSP.qryProcuraClientedebito.IsNull then
           qryDadosFiscaisdebitar.AsVariant   := ConsultaOSP.qryProcuraClientedebito.AsVariant;

      if ConsultaOSP.qryProcuraClienteestado.AsString='.' then {estrangeiro}
      begin
        qryDadosFiscaispais.asstring                     := ConsultaOSP.qryProcuraClientecidadeibge.asstring;
        qryDadosFiscaisnomepais.AsString                 := ConsultaOSP.qryProcuraClientenomecidade.AsString;
        qryDadosFiscaisrua.AsString                      := ConsultaOSP.qryProcuraClienterua.AsString;
        qryDadosFiscaisendnumero.AsString                := consultaosp.qryProcuraClientenumero.AsString;
        qryDadosFiscaisendcomplemento.AsString           := consultaosp.qryProcuraClientecomplemento.AsString;
//        qryDadosFiscaisbairro.AsString                   := ConsultaOSP.qryProcuraClientebairro.AsString;
//        qryDadosFiscaisnomebairro.AsString               := ConsultaOSP.qryProcuraClientenomebairro.AsString;
        qryDadosFiscaiscidade.AsString                   := ConsultaOSP.qryProcuraClientebairro.AsString;
        qryDadosFiscaisnomecidade.AsString               := ConsultaOSP.qryProcuraClientenomebairro.AsString;
        //qryDadosFiscaiscidadeibge.AsString               := ConsultaOSP.qryProcuraClientecidadeibge.AsString;
        qryDadosFiscaisestado.AsString                   := ConsultaOSP.qryProcuraClienteestado.AsString;
        //qryDadosFiscaiscep.AsInteger                     := ConsultaOSP.qryProcuraClientecep.AsInteger;
      end
      else
      begin
        qryDadosFiscaispais.AsInteger                    := 1058;
        qryDadosFiscaisnomepais.AsString                 := 'Brasil';
        qryDadosFiscaisrua.AsString                      := ConsultaOSP.qryProcuraClienterua.AsString;
        qryDadosFiscaisendnumero.AsString                := consultaosp.qryProcuraClientenumero.AsString;
        qryDadosFiscaisendcomplemento.AsString           := consultaosp.qryProcuraClientecomplemento.AsString;
        qryDadosFiscaisbairro.AsString                   := ConsultaOSP.qryProcuraClientebairro.AsString;
        qryDadosFiscaisnomebairro.AsString               := ConsultaOSP.qryProcuraClientenomebairro.AsString;
        qryDadosFiscaiscidade.AsString                   := ConsultaOSP.qryProcuraClientecidade.AsString;
        qryDadosFiscaisnomecidade.AsString               := ConsultaOSP.qryProcuraClientenomecidade.AsString;
        qryDadosFiscaiscidadeibge.AsString               := ConsultaOSP.qryProcuraClientecidadeibge.AsString;
        qryDadosFiscaisestado.AsString                   := ConsultaOSP.qryProcuraClienteestado.AsString;
        qryDadosFiscaiscep.Asstring                     := ConsultaOSP.qryProcuraClientecep.AsString;
      end;

      qryDadosFiscaislocalentrega_rua.AsString         := ConsultaOSP.qryProcuraClienterefrua.AsString;
      qryDadosFiscaislocalentrega_numero.AsString      := consultaosp.qryProcuraClienterefnumero.AsString;
      qryDadosFiscaislocalentrega_complemento.AsString := consultaosp.qryProcuraClienterefcomplemento.AsString;
      qryDadosFiscaislocalentrega_bairro.AsString      := ConsultaOSP.qryProcuraClienterefbairro.AsString;
      qryDadosFiscaislocalentrega_nomebairro.AsString  := ConsultaOSP.qryProcuraClienterefnomebairro.AsString;
      qryDadosFiscaislocalentrega_cidade.AsString      := ConsultaOSP.qryProcuraClienterefcidade.AsString;
      qryDadosFiscaislocalentrega_nomecidade.AsString  := ConsultaOSP.qryProcuraClienterefnomecidade.AsString;
      qryDadosFiscaislocalentrega_cidadeibge.AsString  := ConsultaOSP.qryProcuraClienterefcidadeibge.AsString;
      qryDadosFiscaislocalentrega_estado.AsString      := ConsultaOSP.qryProcuraClienterefestado.AsString;
      qryDadosFiscaislocalentrega_cep.AsString        := ConsultaOSP.qryProcuraClienterefcep.AsString;
      qryDadosFiscaislocalentrega_cnpj.AsString        := ConsultaOSP.qryProcuraClientepessoanumero.AsString;

    end;

    if (qryProdutosDadosFiscais.RecordCount = 0) or
        ((qryProdutosDadosFiscais.RecordCount = 1) and
        (qryProdutosDadosFiscais.State = dsedit)) then
      SubstituicaoIPIProdutos := ConsultaOSP.qryProcuraOSPsubstituicaoipi.AsBoolean;

    if (ConsultaOSP.qryProcuraOSPsubstituicaoipi.AsBoolean <> SubstituicaoIPIProdutos) then
      MensagemAviso('Produto com valor substituicao ipi diferente dos demais.')
    else
    begin
      if not (qryProdutosDadosFiscais.State in [dsedit, dsinsert]) then
        qryProdutosDadosFiscais.edit;
      qryProdutosDadosFiscaisfilial.AsInteger   := FilialBase;
      qryProdutosDadosFiscaisvendedor.AsInteger := UsuarioLogin.CodigoUsuario;
      qryProdutosDadosFiscaisproduto.AsLargeInt := ConsultaOSP.qryProcuraOSPproduto.AsLargeInt;
      qryProdutosDadosFiscaispn.AsString        := ConsultaOSP.qryProcuraOSPpn.AsString;
      qryProdutosDadosFiscaisprodutocliente.AsString := ConsultaOSP.qryProcuraOSPproduto_cliente.AsString;
      qryProdutosDadosFiscaissubstituicaoIPI.AsBoolean := ConsultaOSP.qryProcuraOSPsubstituicaoipi.AsBoolean;

      if ConsultaOSP.qryProcuraOSPdescricaonanf.asstring<>'' then
        qryProdutosDadosFiscaisdescricaoproduto.AsString := ConsultaOSP.qryProcuraOSPdescricaonanf.asstring;

      if qryDadosFiscaistagadpednfe.AsBoolean then
      begin
        if trim(ConsultaOSP.qryProcuraOSPnumero.AsString) <> '' then
          qryProdutosDadosFiscaisdescricaoproduto.AsString := qryProdutosDadosFiscaisdescricaoproduto.AsString +
           ' OSP ' + ConsultaOSP.qryProcuraOSPnumero.AsString;

          qryProdutosDadosFiscaisdescricaoproduto.AsString := qryProdutosDadosFiscaisdescricaoproduto.AsString +
           ' id item="'   +  trim(ConsultaOSP.qryProcuraOSPproduto_cliente.AsString) +
             '" ped="'    +  trim(ConsultaOSP.qryProcuraOSPpedidocliente.AsString) +
             '" div uM="' +  trim(ConsultaOSP.qryProcuraOSPunidade.AsString) + '"';
      end
      else
      begin
        if trim(ConsultaOSP.qryProcuraOSPpedidocliente.AsString) <> '' then
          qryProdutosDadosFiscaisdescricaoproduto.AsString := qryProdutosDadosFiscaisdescricaoproduto.AsString +
           ' S/PED ' +ConsultaOSP.qryProcuraOSPpedidocliente.AsString;
        if trim(ConsultaOSP.qryProcuraOSPproduto_cliente.AsString) <> '' then
          qryProdutosDadosFiscaisdescricaoproduto.AsString := qryProdutosDadosFiscaisdescricaoproduto.AsString +
           ' ' + ConsultaOSP.qryProcuraOSPproduto_cliente.AsString
        else
          qryProdutosDadosFiscaisdescricaoproduto.AsString := qryProdutosDadosFiscaisdescricaoproduto.AsString +
           ' ' + ConsultaOSP.qryProcuraOSPcodigovisual.AsString;
        if trim(ConsultaOSP.qryProcuraOSPnumero.AsString) <> '' then
          qryProdutosDadosFiscaisdescricaoproduto.AsString := qryProdutosDadosFiscaisdescricaoproduto.AsString +
           ' OSP ' + ConsultaOSP.qryProcuraOSPnumero.AsString;
      end;

      qryProdutosDadosFiscaisquantidade.clear;
      qryProdutosDadosFiscaispedida.AsCurrency := consultaosp.qryProcuraOSPquantidade.AsCurrency;
      qryProdutosDadosFiscaisentregue.AsCurrency := consultaosp.qryProcuraOSPqtdeentregue.AsCurrency;
      qryProdutosDadosFiscaisprecovenda.AsCurrency := ConsultaOSP.qryProcuraOSPpreco.AsCurrency;
      qryProdutosDadosFiscaisprecotabela.AsCurrency:= ConsultaOSP.qryProcuraOSPpreco.AsCurrency;
      qryProdutosDadosFiscaisosp.AsInteger := ConsultaOSP.qryProcuraOSPnumero.AsInteger;
      qryProdutosDadosFiscaispedidocliente.AsString:= ConsultaOSP.qryProcuraOSPpedidocliente.AsString;
      qryProdutosDadosFiscaisunidade.AsString := ConsultaOSP.qryProcuraOSPunidade.AsString;
      qryProdutosDadosFiscaistribunidade.AsString := ConsultaOSP.qryProcuraOSPunidade.AsString;

      qryProdutosDadosFiscaiscodigovisual.AsString := ConsultaOSP.qryProcuraOSPcodigovisual.AsString;

      qryProdutosDadosFiscaisorigem.AsString := ConsultaOSP.qryProcuraOSPorigem.AsString;
      qryProdutosDadosFiscaisorigemproduto.AsString := ConsultaOSP.qryProcuraOSPorigemproduto.AsString;
      qryProdutosDadosFiscaisbrinde.AsBoolean := False;

      qryProdutosDadosFiscaisbaseicms.AsCurrency     := ConsultaOSP.qryProcuraOSPbaseicms.AsCurrency;
      if ConsultaOSP.qryProcuraOSPicms.AsInteger > 0 then
      begin
        qryProdutosDadosFiscaisicms.AsInteger          := ConsultaOSP.qryProcuraOSPicms.AsInteger;
        qryProdutosDadosFiscaisaliquotaicms.AsCurrency := ConsultaOSP.qryProcuraOSPaliquotaicms.AsCurrency;
      end;

      {Excessão a regra: quando for para estado do Amazonas temos uma aliquota negativa para dar desconto}
      if qryProdutosDadosFiscaisaliquotaicms.AsCurrency < 0 then
        qryProdutosDadosFiscaisincidencia.AsString := '40' //isentas
      else
        qryProdutosDadosFiscaisincidencia.AsString := ConsultaOSP.qryProcuraOSPincidencia.AsString;

      if qryDadosFiscaisrecolhericmsst.AsBoolean and (qryProdutosDadosFiscaisincidencia.AsString = '00') then
        qryProdutosDadosFiscaisincidencia.AsString := '10';

      qryProdutosDadosFiscaisgenero.AsString := ConsultaOSP.qryProcuraOSPgenero.AsString;
      qryProdutosDadosFiscaisextipi.AsString := ConsultaOSP.qryProcuraOSPextipi.AsString;

      if ConsultaOSP.qryProcuraOSPipi.AsInteger > 0 then
      begin
        qryProdutosDadosFiscaisipi.AsInteger           := ConsultaOSP.qryProcuraOSPipi.AsInteger;
        qryProdutosDadosFiscaisclassificacaofiscal.AsString := ConsultaOSP.qryProcuraOSPclassificacaofiscal.AsString;
        if not qryDadosFiscaisipisuspenso.AsBoolean then
          qryProdutosDadosFiscaisaliquotaipi.AsCurrency  := ConsultaOSP.qryProcuraOSPaliquotaipi.AsCurrency
        else
          qryProdutosDadosFiscaisaliquotaipi.AsCurrency  := 0.00;
      end;

      qryProdutosDadosFiscaisicmsmodalidade.AsString := ConsultaOSP.qryProcuraOSPicmsmodalidade.AsString;
      qryProdutosDadosFiscaisicmsmodsubst.AsString := ConsultaOSP.qryProcuraOSPicmsmodsubst.AsString;
      qryProdutosDadosFiscaisenquadramento.AsString := '999';
      qryProdutosDadosFiscaispisaliquota.AsCurrency  := ConsultaOSP.qryProcuraOSPaliquotapis.AsCurrency;
      qryProdutosDadosFiscaiscofinsaliquota.AsCurrency  := ConsultaOSP.qryProcuraOSPaliquotacofins.AsCurrency;
    end;
  end;
end;

procedure TfrmEmissaoNotasVenda.Condicoesosp;
const
  SQLOSPemAberto =
       ' and ((select coalesce(sum(pdf.quantidade),0) ' +
       ' from dadosfiscais df '+
            ' join produtosdadosfiscais pdf ' +
            ' on df.numero = pdf.dadofiscal ' +
       ' where df.situacao = ''N'' ' +
         ' and pdf.osp = osp.numero ' +
         ' and pdf.produto = osp.produto) = 0) ';
  SQLCliente = ' and not osp.semiacabado and osp.cliente = %s ';
begin
  with dtmEmissaoNotasVenda do
  begin
    ConsultaOSP.qryProcuraOSP.ParamByName('estadofilialbase').AsString := EstadoFilialBase;
//    ConsultaOSP.qryConsultaOSP.MacroByName('SQLOSP').AsString := SQLOSPemAberto;
//    ConsultaOSP.qryprocuraOSP.MacroByName('SQLOSP').AsString := SQLOSPemAberto;
    if qryDadosFiscaiscliente.AsInteger<>0 then
    begin
      ConsultaOSP.qryConsultaOSP.MacroByName('SQLOSP').AsString :=
        format({SQLOSPemAberto+}SQLCliente,[qryDadosFiscaiscliente.AsString]);

      ConsultaOSP.qryprocuraOSP.MacroByName('SQLOSP').AsString :=
        format({SQLOSPemAberto+}SQLCliente,[qryDadosFiscaiscliente.AsString]);

      ConsultaOSP.qryConsultaOSP.ParamByName('cliente').AsInteger := qryDadosFiscaiscliente.AsInteger;
    end;
  end;
end;

constructor TfrmEmissaoNotasVenda.Create(AOwner: TComponent);
begin
  inherited;
  dtmEmissaoNotasVenda := TdtmEmissaoNotasVenda.Create(Self);
  DataSet := dtmEmissaoNotasVenda.qryDadosFiscais;

  ConsultaOSP := TfraConsultaCodigo.Create(self);
  ConsultaOSP.Name := 'fraConsultaOSP';
