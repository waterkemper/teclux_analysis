  fraConsultaCodigoTransportadora.TipoPesquisa := pesTRANSPORTADORES;

  fraConsultaEstadoTransportadora.TipoPesquisa := pesESTADOS;
  fraConsultaUFEmbarque.TipoPesquisa := pesESTADOS;

