      end;
      qryPedidosClientesporAtividades.Post;
    end;
    qryPedidosporAtividades.Next;
    qryPedidosporAtividadesPerc.Next;
  end;

  //GRAVANDO TOTAIS
  qryPedidosClientesporAtividades.Append;
  for i:=0 to qryPedidos.FieldCount-1 do
      qryPedidosClientesporAtividades.FieldByName(qryPedidos.Fields[i].FieldName).Value :=
        qryPedidos.fields[i].Value;
  qryPedidosClientesporAtividades.Post;

  qryPedidosClientesporAtividades.First;
  qryPedidosClientesporAtividades.EnableControls;

  qryPedidosClientesporAtividadesTotal.Index := qryPedidosClientesporAtividades.FieldCount-1;

  result := not qryPedidosporAtividades.IsEmpty;
end;

procedure TdtmPedidosporAtividades.qryPedidosClientesporAtividadesCalcFields(
  DataSet: TDataSet);
var i:integer;
begin
  inherited;
  if qryPedidosClientesporAtividadesnome.AsString<>'' then
  begin
    qryPedidosClientesporAtividadesTotal.AsCurrency := 0;
    for i:=0 to qryPedidosClientesporAtividades.FieldCount-1 do
      if copy(qryPedidosClientesporAtividades.Fields[i].FieldName,1,1)='m' then
        qryPedidosClientesporAtividadesTotal.AsCurrency :=
          qryPedidosClientesporAtividadesTotal.AsCurrency +
          qryPedidosClientesporAtividades.Fields[i].AsCurrency;
  end;
end;

procedure TdtmPedidosporAtividades.qryPedidosAfterOpen(DataSet: TDataSet);
var i:integer;
begin
  inherited;
  qryPedidos.Edit;
  qryPedidos.FieldByName('total').AsCurrency := 0;
  for i:=0 to qryPedidos.FieldCount-1 do
    if copy(qryPedidos.Fields[i].FieldName,1,1)='m' then
      qryPedidos.FieldByName('total').AsCurrency :=
        qryPedidos.FieldByName('total').AsCurrency +
        qryPedidos.Fields[i].AsCurrency;
  qryPedidos.Post;
end;

