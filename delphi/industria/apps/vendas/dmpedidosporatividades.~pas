      if i = qryPedidosporAtividades.FieldCount then
        break;
    end;
    if i = qryPedidosporAtividades.FieldCount then
      break;
  end;

  posicaomeses := NumerodalinhanoTexto(qryPedidosporAtividades.sql, '%meses');
  qrynMeses.First;
  for i:=0 to qrynMeses.RecordCount-1 do
  begin
    mes := 'm'+copy(qrynMeses.FieldByName('mes').AsString,6,2)+'_'+
           copy(qrynMeses.FieldByName('mes').AsString,1,4);

    with TCurrencyField.Create(dsrPedidosporAtividades) do
    begin
     DisplayLabel := uppercase(copy(NomeMeses[strtoint(copy(mes,2,2))],1,3)
                     +'/'+
                     copy(mes,5,4));
     FieldName := mes;
     FieldKind:= fkData;
     DataSet := qryPedidosporAtividades;
     DisplayFormat := '###,###,##0.00';
     DisplayWidth := 11;
     qryPedidosporAtividades.FieldDefs.Add('qryPedidosporAtividades'+mes, ftCurrency);
    end;

{    if i = qrynMeses.RecordCount-1 then
      qryPedidosporAtividades.Sql.Insert(posicaomeses+i,mes+' numeric(12,2)')
    else
      qryPedidosporAtividades.Sql.Insert(posicaomeses+i,mes+' numeric(12,2),');}
