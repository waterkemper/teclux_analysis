     FieldKind:= fkData;
     DataSet := qryPedidosClientesporAtividades;
     DisplayFormat := '###,###,##0.00';
     DisplayWidth := 11;
     qryPedidosClientesporAtividades.FieldDefs.Add('qryPedidosClientesporAtividades'+mes, ftCurrency);
