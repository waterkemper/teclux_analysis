    else
      qryPedidosClientesporAtividades.Sql.Insert(posicaomeses+i,mes+' numeric(12,2),');}
    qrynMeses.Next;
  end;

  qryPedidos.Open;
  qryPedidosporAtividadesPerc.Open;
  qryPedidosporAtividadesPerc.First;
  while not qryPedidosporAtividadesPerc.Eof do
  begin
    TotalLinha := 0;
    qryPedidosporAtividadesPerc.edit;
    for i:=0 to qryPedidosporAtividadesPerc.FieldCount-1 do
    begin
      if copy(qryPedidosporAtividadesPerc.Fields[i].FieldName,1,1) = 'm' then
      begin
        if (not qryPedidos.Fieldbyname(qryPedidosporAtividadesPerc.Fields[i].fieldname).isnull) and
           (qryPedidos.Fieldbyname(qryPedidosporAtividadesPerc.Fields[i].fieldname).AsCurrency <> 0) then
        begin
          TotalLinha := TotalLinha + qryPedidosporAtividadesPerc.Fields[i].AsCurrency;
          qryPedidosporAtividadesPerc.Fields[i].AsCurrency := qryPedidosporAtividadesPerc.Fields[i].AsCurrency * 100/
                                                          qryPedidos.Fieldbyname(qryPedidosporAtividadesPerc.Fields[i].fieldname).AsCurrency;
        end;
      end;
    end;

    if qryPedidos.Fieldbyname('total').AsCurrency<>0 then
      qryPedidosporAtividadesPerc.FieldByName('total').AsCurrency :=
         TotalLinha * 100 / qryPedidos.Fieldbyname('total').AsCurrency;
