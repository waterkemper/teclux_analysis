function TdtmVendasPlanRealizadas.GerarConsulta(periodoinicial,
  periodofinal: String): Boolean;
const
  FiltroDataFiscal_Periodo      = ' (df.data BETWEEN ''%s'' AND ''%s'')';
  FiltroDataFiscal_AnoAnterior  = ' (df.data between ''%s'' and ''%s'')';
  FiltroDataFiscal_AnterioreAtual = ' (df.data between ''%s'' and ''%s'')';

  FiltroDatafiscal_TotalPeriodo = ' (df.data BETWEEN   %s   AND   %s)';
  FiltroDataFiscal_TotalAnoAnterior  = ' (df.data between %s and %s)';
  FiltroDataFiscal_TotalAnterioreAtual = ' (df.data between %s and %s)';

  FiltroDataEntrega_Periodo      = ' (osp.entrega between ''%s'' and ''%s'')';
  FiltroDataEntrega_AnoAtual     = ' (osp.entrega between ''%s'' and ''%s'')';
  FiltroDataEntrega_AnterioreAtual =' (osp.entrega between ''%s'' and ''%s'')';

  FiltroDataEntrega_TotalPeriodo = ' (osp.entrega BETWEEN   %s   AND   %s)';
  FiltroDataEntrega_TotalAnoAtual = ' (osp.entrega between %s and %s)';
  FiltroDataEntrega_TotalAnterioreAtual =' (osp.entrega between %s and %s)';

var
  FiltroVendas,
  FiltroServicos, mes, meses,teste : String;
  i,j,posicaomeses :integer;

  DataInicialPeriodo,
  DatafinalPeriodo,
  DataInicialAnoAnterior,
  DataFinalAnoAnterior,
  DataInicialAnoAtual: String;

begin
  DataInicialPeriodo := FormatDateTime('dd/mm/yyyy', strtodatetime('01/01/'+periodoinicial));
  DataFinalPeriodo   := FormatDateTime('dd/mm/yyyy', strtodatetime('31/12/'+periodofinal));

  DataInicialAnoAnterior := FormatDateTime('dd/mm/yyyy', strtodatetime('01/01/'+inttostr(strtoint(periodofinal)-1)));
  DataFinalAnoAnterior   := FormatDateTime('dd/mm/yyyy', strtodatetime('31/12/'+inttostr(strtoint(periodofinal)-1)));

  DataInicialAnoAtual := FormatDateTime('dd/mm/yyyy', strtodatetime('01/01/'+inttostr(strtoint(periodofinal))));

  qryPlanRealizadas.Close;
  qryPlanRealizadas.Sql.Text := qryPlanRealizadas_AUX.Sql.Text;

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataFiscal_Periodo')] :=
    format(FiltroDataFiscal_Periodo,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialPeriodo))),
                       quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DatafinalPeriodo)))]);

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataFiscal_AnoAnterior')] :=
    format(FiltroDataFiscal_AnoAnterior,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialAnoAnterior))),
                       quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataFinalAnoAnterior)))]);

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataFiscal_AnterioreAtual')] :=
    format(FiltroDataFiscal_AnterioreAtual,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialAnoAnterior))),
                       quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DatafinalPeriodo)))]);

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDatafiscal_TotalPeriodo')] :=
    format(FiltroDatafiscal_TotalPeriodo,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialPeriodo))),
                                          quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DatafinalPeriodo)))]);

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataFiscal_TotalAnoAnterior')] :=
    format(FiltroDataFiscal_TotalAnoAnterior,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialAnoAnterior))),
                                              quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataFinalAnoAnterior)))]);

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataFiscal_TotalAnterioreAtual')] :=
    format(FiltroDataFiscal_TotalAnterioreAtual,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialAnoAnterior))),
                                              quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DatafinalPeriodo)))]);


  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataEntrega_Periodo')] :=
    format(FiltroDataEntrega_Periodo,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialPeriodo))),
                       quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DatafinalPeriodo)))]);

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataEntrega_AnoAtual')] :=
    format(FiltroDataEntrega_AnoAtual,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialAnoAtual))),
                       quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DatafinalPeriodo)))]);

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataEntrega_AnterioreAtual')] :=
    format(FiltroDataEntrega_AnterioreAtual,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialAnoAnterior))),
                       quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DatafinalPeriodo)))]);

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataEntrega_TotalPeriodo')] :=
    format(FiltroDataEntrega_TotalPeriodo,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialPeriodo))),
                                          quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DatafinalPeriodo)))]);

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataEntrega_TotalAnoAtual')] :=
    format(FiltroDataEntrega_TotalAnoAtual,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialAnoAtual))),
                                              quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DatafinalPeriodo)))]);

  qryPlanRealizadas.Sql[NumerodalinhanoTexto(qryPlanRealizadas.sql, '%FiltroDataEntrega_TotalAnterioreAtual')] :=
    format(FiltroDataEntrega_TotalAnterioreAtual,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DataInicialAnoAnterior))),
                                              quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(DatafinalPeriodo)))]);

  qryPlanRealizadas.ParamByName('AnoAtual').AsString := quotedstr(periodofinal);
  if periodofinal = FormatDateTime('yyyy', date()) then
    qryPlanRealizadas.ParamByName('mesAnoAtual').AsInteger := MonthOf(date())
  else
    qryPlanRealizadas.ParamByName('mesAnoAtual').AsInteger := 12;

  qryPlanRealizadas.close;
  qryPlanRealizadas.Open;

  result := not qryPlanRealizadas.IsEmpty;
end;

procedure TdtmVendasPlanRealizadas.qryPlanRealizadasAfterOpen(
  DataSet: TDataSet);
var
  NomeCliente, produto, descricaoproduto, produtocliente, finalidade, pn: String;
  CodigoCliente : integer;
  RegistroCliente1, RegistroCliente2 : TBookmark;
  FinalArquivo : Boolean;
begin
  inherited;
  {
  TCurrencyField(qryPlanRealizadas.FieldByName('jan')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('fev')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('mar')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('abr')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('mai')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('jun')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('jul')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('ago')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('set')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('out')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('nov')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('dez')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('quantidade_total')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  TCurrencyField(qryPlanRealizadas.FieldByName('media')).DisplayFormat := ParSistema.MascaraQuantidadeGrade;
}

  TCurrencyField(qryPlanRealizadas.FieldByName('jan')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('fev')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('mar')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('abr')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('mai')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('jun')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('jul')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('ago')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('set')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('out')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('nov')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('dez')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('quantidade_total')).DisplayFormat := '###,###,###';
  TCurrencyField(qryPlanRealizadas.FieldByName('media')).DisplayFormat := '###,###,###';

  qryPlanRealizadas.DisableControls;

  FinalArquivo := false; 
  qryPlanRealizadas.First;
  NomeCliente := qryPlanRealizadasnome.AsString;
  CodigoCliente := qryPlanRealizadascliente.AsInteger;
  RegistroCliente1 := qryPlanRealizadas.GetBookmark;
  while not qryPlanRealizadas.Eof do
  begin
    qryPlanRealizadas.Next;
    if (CodigoCliente <> qryPlanRealizadascliente.AsInteger) or
       (qryPlanRealizadas.Eof) then
    begin
      RegistroCliente2 := qryPlanRealizadas.GetBookmark;
      qryPlanRealizadas.GotoBookmark(RegistroCliente1);

      while (CodigoCliente = qryPlanRealizadascliente.AsInteger) do
      begin
        produto := qryPlanRealizadasproduto.AsString;
        descricaoproduto := qryPlanRealizadasdescricaoproduto.AsString;
        pn := qryPlanRealizadaspn.AsString;
        produtocliente := qryPlanRealizadasproduto_cliente.AsString;
        finalidade := qryPlanRealizadasfinalidade.AsString;

        try
          while (produto = qryPlanRealizadasproduto.AsString) and
                (codigocliente = qryPlanRealizadascliente.AsInteger) do
          begin
            if descricaoproduto<>'' then
            begin
              qryPlanRealizadas.Edit;
              qryPlanRealizadasdescricaoproduto.AsString := '  '+descricaoproduto;
              qryPlanRealizadas.post;
              descricaoproduto := '';
            end
            else
            if pn <> '' then
            begin
              qryPlanRealizadas.Edit;
              qryPlanRealizadasdescricaoproduto.AsString := '  PN '+pn;
              qryPlanRealizadas.post;
              pn := '';
            end
            else
            if produtocliente <> '' then
            begin
              qryPlanRealizadas.Edit;
              qryPlanRealizadasdescricaoproduto.AsString := '     '+produtocliente;
              qryPlanRealizadas.post;
              produtocliente := '';
            end
            else
            if finalidade <> '' then
            begin
              qryPlanRealizadas.Edit;
              qryPlanRealizadasdescricaoproduto.AsString := '     '+finalidade;
              qryPlanRealizadas.post;
              finalidade := '';
            end
            else
            begin
              qryPlanRealizadas.Edit;
              qryPlanRealizadasdescricaoproduto.Clear;
              qryPlanRealizadas.post;
            end;
            qryPlanRealizadas.Next;
            if qryPlanRealizadas.Eof then
            begin
              FinalArquivo := true;
              break;
            end;
          end;
        finally
          if not qryPlanRealizadas.Eof then
            qryPlanRealizadas.prior;
        end;
        qryPlanRealizadas.Next;
        if qryPlanRealizadas.Eof then
        begin
          FinalArquivo := true;
          break;
        end;
      end;

      qryPlanRealizadas.GotoBookmark(RegistroCliente1);
      qryPlanRealizadas.Insert;
      qryPlanRealizadasdescricaoproduto.AsString := NomeCliente;
      qryPlanRealizadas.Post;
      qryPlanRealizadas.FreeBookmark(RegistroCliente1);

      qryPlanRealizadas.GotoBookmark(RegistroCliente2);
      qryPlanRealizadas.FreeBookmark(RegistroCliente2);
      NomeCliente := qryPlanRealizadasnome.AsString;
      CodigoCliente := qryPlanRealizadascliente.AsInteger;
      RegistroCliente1 := qryPlanRealizadas.GetBookmark;
    end;

    if FinalArquivo then
       break;
  end;

  if assigned(RegistroCliente1) then
    qryPlanRealizadas.FreeBookmark(RegistroCliente1);
  qryPlanRealizadas.EnableControls;
end;

