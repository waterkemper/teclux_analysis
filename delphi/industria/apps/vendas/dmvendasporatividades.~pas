procedure TdtmVendasporAtividades.FiltrarVendas(tecla:String);
var
 cargo: String;
begin
  if VisualizarClientes then
  begin
    if not assigned(AtividadesSelecionadas) then
      AtividadesSelecionadas := TStringList.Create;

    GuardarRegistroAtual(qryVendasClientesporAtividades, false);

    if qryVendasClientesporAtividadesexpandir.AsString = '+' then
    begin
      if (tecla = '') or (tecla = '+') then
      begin
        if qryVendasClientesporAtividades.fieldbyname('empcargo').AsString<>'' then
          AtividadesSelecionadas.Delete(AtividadesSelecionadas.IndexOf(qryVendasClientesporAtividades.fieldbyname('empcargo').AsString));

        qryVendasClientesporAtividades.Edit;
        qryVendasClientesporAtividadesexpandir.AsString := '-';
        qryVendasClientesporAtividades.Post;

        if qryVendasClientesporAtividades.FieldByName('nome').AsString='' then
        begin
          qryVendasClientesporAtividades.Prior;
          if qryVendasClientesporAtividadesexpandir.AsString='' then
            MensagemAviso('erro')
          else
          begin
            qryVendasClientesporAtividades.Edit;
            qryVendasClientesporAtividadesexpandir.AsString := '-';
            qryVendasClientesporAtividades.Post;
          end;
        end
        else
        begin
          qryVendasClientesporAtividades.next;
          if qryVendasClientesporAtividadesexpandir.AsString='' then
            MensagemAviso('erro')
          else
          begin
            qryVendasClientesporAtividades.Edit;
            qryVendasClientesporAtividadesexpandir.AsString := '-';
            qryVendasClientesporAtividades.Post;
          end
        end;
      end;
    end
    else
    if qryVendasClientesporAtividadesexpandir.AsString = '-' then
    begin
      if (tecla='') or (tecla='-') then
      begin
        if qryVendasClientesporAtividades.fieldbyname('empcargo').AsString<>'' then
          AtividadesSelecionadas.Append(qryVendasClientesporAtividades.fieldbyname('empcargo').AsString);

        qryVendasClientesporAtividades.Edit;
        qryVendasClientesporAtividadesexpandir.AsString := '+';
        qryVendasClientesporAtividades.Post;
        if qryVendasClientesporAtividades.FieldByName('nome').AsString='' then
        begin
          qryVendasClientesporAtividades.Prior;
          if qryVendasClientesporAtividadesexpandir.AsString='' then
            MensagemAviso('erro')
          else
          begin
          qryVendasClientesporAtividades.Edit;
          qryVendasClientesporAtividadesexpandir.AsString := '+';
          qryVendasClientesporAtividades.Post;
          end;
        end
        else
        begin
          qryVendasClientesporAtividades.next;
          if qryVendasClientesporAtividadesexpandir.AsString='' then
            MensagemAviso('erro')
          else
          begin
          qryVendasClientesporAtividades.Edit;
          qryVendasClientesporAtividadesexpandir.AsString := '+';
          qryVendasClientesporAtividades.Post;
          end;
        end;
      end;
    end;

    qryVendasClientesporAtividades.Filtered :=
      (AtividadesSelecionadas.Count<>0);

    VoltarRegistroAtual(qryVendasClientesporAtividades);
  end;
end;

procedure TdtmVendasporAtividades.GerarPlanilha(PeriodoInicial,
  PeriodoFinal, moeda: String);
const
 xlCenter = -4108;

var i,coluna,eline: Integer;
    oXL, oWB, oSheet, oRng, VArray : Variant;
    NomeArquivo,v: String;
    ColunaSomatorioEvento, LinhaSomatorioEvento, LinhaSomatorioGrupo: Integer;

begin
  inherited;
  // Start Excel and get Application Object
  oXL:= CreateOleObject('Excel.Application');
  oXL.Visible := true;

  // Get a new workbook
  oWB := oXL.Workbooks.Add;
  oSheet := oWB.ActiveSheet;

  // Dataset Header

  eline :=1;

  oSheet.name := 'VENDAS ACUMULADAS';
  oSheet.Cells[eline,2].Font.FontStyle := 'Negrito';
  oSheet.Cells[eline,2].Font.size := 14;

  oSheet.Cells[eline,2] := 'VENDAS ACUMULADAS POR ATIVIDADE '+
                           ansiuppercase(nomeMeses[strtoint(copy(PeriodoInicial,1,2))]) +
                           ' DE '+copy(PeriodoInicial,4,4)+
                           ' ATÉ '+
                           ansiuppercase(nomeMeses[strtoint(copy(PeriodoFinal,1,2))]) +
                           ' DE '+copy(PeriodoFinal,4,4);
  eline := eline + 1;

  oSheet.Cells[eline,3].Font.FontStyle := 'Negrito';
  oSheet.Cells[eline,3].Font.size := 14;
  oSheet.Cells[eline,3] := 'V E R S A N D  N A C H  B R A N C H E N';

  eline := eline + 2;

  coluna:=1;
  for i:=0 to qryVendasClientesporAtividades.FieldCount -1 do
  begin
    if qryVendasClientesporAtividades.Fields[i].Visible then
      if qryVendasClientesporAtividades.Fields[i].FieldName <> 'expandir' then
      begin
        oSheet.Cells[eline,coluna].Font.FontStyle := 'Negrito';
        oSheet.Cells[eline,coluna] := ' '+qryVendasClientesporAtividades.Fields[i].DisplayLabel;
        oSheet.Cells[eline,coluna].HorizontalAlignment := xlCenter;
        inc(coluna);
      end;
  end;

  if qryVendasClientesporAtividades.IsEmpty then
    Inc(eline);

  qryVendasClientesporAtividades.First;

  while not qryVendasClientesporAtividades.Eof do // Detail
  begin
    Inc(eline); // Add 1 to the line of Sheet
    coluna :=1;
    for i:=0 to (qryVendasClientesporAtividades.FieldCount-1) do
    begin
      if qryVendasClientesporAtividades.Fields[i].visible then
      begin
        if qryVendasClientesporAtividades.Fields[i].FieldName <> 'expandir' then
        begin
          if qryVendasClientesporAtividades.Fields[i].fieldname = 'nome' then
          begin
            if ((qryVendasClientesporAtividadesexpandir.AsString<>'')
                 and VisualizarClientes) or
               ((qryVendasClientesporAtividadesexpandir.AsString<>'')
                 and (qryVendasClientesporAtividadesempcargo.IsNull)) then
               oSheet.Cells[eline,coluna].Font.FontStyle := 'Negrito';
            oSheet.Cells[eline,coluna].ColumnWidth := 50;
            oSheet.Cells[eline,coluna] := qryVendasClientesporAtividades.Fields[i].value;
          end
          else
          begin
            oSheet.Cells[eline,coluna].ColumnWidth := 15;
            if qryVendasClientesporAtividadesnome.AsString='' then
            begin
              oSheet.Cells[eline,coluna] := qryVendasClientesporAtividades.Fields[i].value/100;
              oSheet.Cells[eline,coluna].numberformat := '##0,00%';
            end
            else
            begin
              oSheet.Cells[eline,coluna] := qryVendasClientesporAtividades.Fields[i].value;
              oSheet.Cells[eline,coluna].numberformat := '###.###.##0,00';
            end;
            if ((qryVendasClientesporAtividadesexpandir.AsString<>'')
                 and VisualizarClientes) {or
               ((qryVendasClientesporAtividadesexpandir.AsString<>'')
                 and (qryVendasClientesporAtividadesempcargo.IsNull)) or
               (qryVendasClientesporAtividades.Fields[i].fieldname = 'Total')} then
               oSheet.Cells[eline,coluna].Font.FontStyle := 'Negrito';
          end;
          inc(coluna);
        end;
      end;
    end;
    qryVendasClientesporAtividades.Next;

    if (qryVendasClientesporAtividadesexpandir.AsString <> '') and
       (qryVendasClientesporAtividadesnome.AsString<>'') then
      inc(eline);

  end;
  // Save the file
  NomeArquivo := ExtractFilePath(Application.ExeName) + 'Saidas';

  if not DirectoryExists(NomeArquivo) then
    if not CreateDir(NomeArquivo) then
    raise Exception.Create('Impossível criar o diretório '+NomeArquivo);

  NomeArquivo := NomeArquivo+'\VendasAcumuladasporAtividades_'+
                 copy(PeriodoInicial,4,4)+'_'+copy(PeriodoInicial,1,2)+'_a_'+
                 copy(PeriodoFinal,4,4)+'_'+copy(PeriodoFinal,1,2);
  try
  oWB.SaveAs(NomeArquivo); except end;
//  oXL.Visible := true;
//  oXL.Quit;
end;

procedure TdtmVendasporAtividades.SetarVisualizacao;
var
 i:integer;
begin
  qryVendasClientesporAtividades.Filtered := false;

  qryVendasClientesporAtividades.Filtered := not VisualizarClientes;

  if assigned(AtividadesSelecionadas) then
  begin
    if not VisualizarClientes then
    begin
      for i:=0 to AtividadesSelecionadas.Count -1 do
      begin
        if qryVendasClientesporAtividades.Locate('empcargo',AtividadesSelecionadas[i],[]) then
        begin
          if (qryVendasClientesporAtividadesexpandir.AsString<>'-') and
             (qryVendasClientesporAtividadesexpandir.AsString<>'') then
          begin
            qryVendasClientesporAtividades.Edit;
            qryVendasClientesporAtividadesexpandir.AsString := '-';
            qryVendasClientesporAtividades.Next;
            qryVendasClientesporAtividades.Edit;
            qryVendasClientesporAtividadesexpandir.AsString := '-';
            qryVendasClientesporAtividades.Post;
          end
        end;
      end;
      AtividadesSelecionadas := nil;
    end;
  end;

end;

