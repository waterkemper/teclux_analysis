procedure TdtmVendasporAtividades.qryVendasClientesporAtividadesFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  if VisualizarClientes then
  begin
    if AtividadesSelecionadas.Count = 0 then
      Accept := true
    else
    begin
      if qryVendasClientesporAtividadesexpandir.AsString<>'' then
        accept := true
      else
        accept := AtividadesSelecionadas.IndexOf(qryVendasClientesporAtividades.fieldbyname('empcargo').AsString)=-1;
    end;
  end
  else
  begin
   if not VisualizarClientes then
   begin
     if (qryVendasClientesporAtividadesexpandir.AsString <> '') then
       Accept := true
     else
       Accept := false;
   end;
  end;
end;

