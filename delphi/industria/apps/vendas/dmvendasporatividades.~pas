    end;
    if i = qryVendasporAtividades.FieldCount then
      break;
  end;

  posicaomeses := NumerodalinhanoTexto(qryVendasporAtividades.sql, '%meses');
  qrynMeses.First;
  for i:=0 to qrynMeses.RecordCount-1 do
  begin
    mes := 'm'+copy(qrynMeses.FieldByName('mes').AsString,6,2)+'_'+
           copy(qrynMeses.FieldByName('mes').AsString,1,4);

    with TCurrencyField.Create(dsrVendasporAtividades) do
