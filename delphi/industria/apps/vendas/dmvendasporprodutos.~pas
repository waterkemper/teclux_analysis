  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%sqlDataFaturamento_1')] :=
    format(FiltroData,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(dataInicial))),
                       quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(datafinal)))]);

  qryVendas.Sql[NumerodalinhanoTexto(qryVendas.sql, '%sqlDataFaturamento_2')] :=
    format(FiltroData_2,[quotedstr(formatdatetime('yyyy-mm-dd',strtodatetime(dataInicial))),
