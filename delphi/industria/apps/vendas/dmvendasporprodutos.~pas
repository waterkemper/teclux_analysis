procedure TdtmVendasporProdutos.qryVendasProdutosporGruposFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  inherited;
  if VisualizarClientes then
  begin
    if Selecionadas.Count = 0 then
      Accept := true
    else
    begin
      if qryVendasProdutosporGruposexpandir.AsString<>'' then
        accept := true
      else
        accept := Selecionadas.IndexOf(qryVendasProdutosporGrupos.fieldbyname('grupo').AsString)=-1;
    end;
  end
  else
  begin
   if not VisualizarClientes then
   begin
     if (qryVendasProdutosporGruposexpandir.AsString <> '') then
       Accept := true
     else
       Accept := false;
   end;
  end;
end;

function TdtmVendasporProdutos.GerarConsulta(periodoinicial,
