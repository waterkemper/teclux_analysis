  end
  else
  begin
    qryVendasProdutosporGrupos.Sql[NumerodalinhanoTexto(qryVendasProdutosporGrupos.sql, '%sqlMoedaSelecionada')] :=
      FiltroMoedaNaoSelecionada;
    qryVendasProdutosporGrupos.Sql[NumerodalinhanoTexto(qryVendasProdutosporGrupos.sql, '%sqlMoeda')] :=
      FiltrosemMoeda;
  end;
  qryVendasProdutosporGrupos.Sql[NumerodalinhanoTexto(qryVendasProdutosporGrupos.sql, '%DataInicial_1')] :=
     formatdatetime('yyyy-mm-dd',strtodatetime(dataInicial));
  qryVendasProdutosporGrupos.Sql[NumerodalinhanoTexto(qryVendasProdutosporGrupos.sql, '%DataInicial_2')] :=
     formatdatetime('yyyy-mm-dd',strtodatetime(dataInicial));
  qryVendasProdutosporGrupos.Sql[NumerodalinhanoTexto(qryVendasProdutosporGrupos.sql, '%DataFinal')] :=
     formatdatetime('yyyy-mm-dd',strtodatetime(datafinal));


  qrynMeses.Sql[NumerodalinhanoTexto(qrynMeses.sql, '%DataInicial_1')] :=
     formatdatetime('yyyy-mm-dd',strtodatetime(dataInicial));
  qrynMeses.Sql[NumerodalinhanoTexto(qrynMeses.sql, '%DataInicial_2')] :=
     formatdatetime('yyyy-mm-dd',strtodatetime(dataInicial));
  qrynMeses.Sql[NumerodalinhanoTexto(qrynMeses.sql, '%DataFinal')] :=
     formatdatetime('yyyy-mm-dd',strtodatetime(datafinal));

  qrynMeses.close;
  qrynMeses.Open;

  posicaomeses := NumerodalinhanoTexto(qryVendas.sql, '%meses');
  qrynMeses.First;
  for i:=0 to qrynMeses.RecordCount-1 do
  begin
    mes := 'm'+copy(qrynMeses.FieldByName('mes').AsString,6,2)+'_'+
           copy(qrynMeses.FieldByName('mes').AsString,1,4);

    if i = qrynMeses.RecordCount-1 then
      qryVendas.Sql.Insert(posicaomeses+i,mes+' numeric(9,0)')
    else
      qryVendas.Sql.Insert(posicaomeses+i,mes+' numeric(9,0),');
    qrynMeses.Next;
  end;

  posicaomeses := NumerodalinhanoTexto(qryVendasporGruposPerc.sql, '%meses');
  qrynMeses.First;
  for i:=0 to qrynMeses.RecordCount-1 do
  begin
    mes := 'm'+copy(qrynMeses.FieldByName('mes').AsString,6,2)+'_'+
           copy(qrynMeses.FieldByName('mes').AsString,1,4);

    if i = qrynMeses.RecordCount-1 then
      qryVendasporGruposPerc.Sql.Insert(posicaomeses+i,mes+' numeric(9,0)')
    else
      qryVendasporGruposPerc.Sql.Insert(posicaomeses+i,mes+' numeric(9,0),');
    qrynMeses.Next;
  end;

  posicaomeses := NumerodalinhanoTexto(qryVendasporGrupos.sql, '%meses');
  qrynMeses.First;
  for i:=0 to qrynMeses.RecordCount-1 do
  begin
    mes := 'm'+copy(qrynMeses.FieldByName('mes').AsString,6,2)+'_'+
           copy(qrynMeses.FieldByName('mes').AsString,1,4);

    if i = qrynMeses.RecordCount-1 then
      qryVendasporGrupos.Sql.Insert(posicaomeses+i,mes+' numeric(9,0)')
    else
      qryVendasporGrupos.Sql.Insert(posicaomeses+i,mes+' numeric(9,0),');
    qrynMeses.Next;
  end;

  for i:=0 to qryVendasProdutosporGrupos.FieldCount-1 do
  begin
  {
    if qryVendasProdutosporGrupos.Fields[i].FieldName = 'quantidadeperiodo' then
      TCurrencyField(qryVendasProdutosporGrupos.Fields[i]).DisplayFormat := ParSistema.MascaraQuantidadeGrade;

    if qryVendasProdutosporGrupos.Fields[i].FieldName = 'valorperiodo' then
      TCurrencyField(qryVendasProdutosporGrupos.Fields[i]).DisplayFormat := '###,###,##0.00';
   }
    while copy(qryVendasProdutosporGrupos.Fields[i].FieldName,1,1) = 'm' do
    begin
      qryVendasProdutosporGrupos.Fields[i].Free;
      if i = qryVendasProdutosporGrupos.FieldCount-1 then
        break;
    end;
    if i = qryVendasProdutosporGrupos.FieldCount-1 then
      break;
  end;

  posicaomeses := NumerodalinhanoTexto(qryVendasProdutosporGrupos.sql, '%meses');
  qrynMeses.First;
  for i:=0 to qrynMeses.RecordCount-1 do
  begin
    mes := 'm'+copy(qrynMeses.FieldByName('mes').AsString,6,2)+'_'+
           copy(qrynMeses.FieldByName('mes').AsString,1,4);
    with TCurrencyField.Create(dsrVendasProdutosporGrupos) do
    begin
     DisplayLabel := uppercase(copy(NomeMeses[strtoint(copy(mes,2,2))],1,3)
                     +'/'+
                     copy(mes,5,4));
     FieldName := mes;
     FieldKind:= fkData;
     DataSet := qryVendasProdutosporGrupos;
//     DisplayFormat := ParSistema.MascaraQuantidadeGrade;
     DisplayFormat := '###,###';
//     DisplayWidth := 11;
     DisplayWidth := 8;
     qryVendasProdutosporGrupos.FieldDefs.Add('qryVendasProdutosporGrupos'+mes, ftCurrency);
    end;

    if i = qrynMeses.RecordCount-1 then
      qryVendasProdutosporGrupos.Sql.Insert(posicaomeses+i,mes+' numeric(9,0)')
    else
      qryVendasProdutosporGrupos.Sql.Insert(posicaomeses+i,mes+' numeric(9,0),');
    qrynMeses.Next;
  end;

  qryvendas.Open;
  qryVendasporGruposPerc.Open;
  qryVendasporGruposPerc.First;
  while not qryVendasporGruposPerc.Eof do
  begin
    qryVendasporGruposPerc.edit;
    for i:=0 to qryVendasporGruposPerc.FieldCount-1 do
    begin
      if copy(qryVendasporGruposPerc.Fields[i].FieldName,1,1) = 'm' then
      begin
        if not qryVendas.Fieldbyname(qryVendasporGruposPerc.Fields[i].fieldname).isnull then
          qryVendasporGruposPerc.Fields[i].AsCurrency := qryVendasporGruposPerc.Fields[i].AsCurrency * 100/
                                                          qryVendas.Fieldbyname('quantidadeperiodo').AsCurrency;
      end;
    end;

    if qryVendas.Fieldbyname('quantidadeperiodo').AsCurrency<>0 then
      qryVendasporGruposPerc.FieldByName('quantidadeperiodo').AsCurrency :=
         qryVendasporGruposPerc.FieldByName('quantidadeperiodo').AsCurrency * 100 /
         qryVendas.Fieldbyname('quantidadeperiodo').AsCurrency;

    if qryVendas.Fieldbyname('valorperiodo').AsCurrency<>0 then
      qryVendasporGruposPerc.FieldByName('valorperiodo').AsCurrency :=
         qryVendasporGruposPerc.FieldByName('valorperiodo').AsCurrency * 100 /
         qryVendas.Fieldbyname('valorperiodo').AsCurrency;

    qryVendasporGruposPerc.Post;
    qryVendasporGruposPerc.Next;
  end;

  qryVendasporGrupos.Open;
  qryVendasporGrupos.First;
  qryVendasporGruposPerc.First;
  qryVendasProdutosporGrupos.DisableControls;
  qryVendasProdutosporGrupos.Open;

  while not qryVendasporGrupos.Eof do
  begin
    if qryVendasProdutosporGrupos.Locate('grupo',qryVendasporGrupos.fieldbyname('grupo').AsString,[]) then
    begin
      //GRAVANDO PERCENTUAIS
      qryVendasProdutosporGrupos.Insert;
      for i:=0 to qryVendasporGruposPerc.FieldCount-1 do
        qryVendasProdutosporGrupos.FieldByName(qryVendasporGruposPerc.Fields[i].FieldName).Value :=
          qryVendasporGruposPerc.fields[i].Value;
      qryVendasProdutosporGrupos.Post;

      //GRAVANDO VALORES
      qryVendasProdutosporGrupos.Insert;
      for i:=0 to qryVendasporGrupos.FieldCount-1 do
        qryVendasProdutosporGrupos.FieldByName(qryVendasporGrupos.Fields[i].FieldName).Value :=
          qryVendasporGrupos.fields[i].Value;
      qryVendasProdutosporGrupos.Post;
    end;
    qryVendasporGrupos.Next;
    qryVendasporGruposPerc.Next;
  end;

  //GRAVANDO TOTAIS
  qryVendasProdutosporGrupos.Append;
  for i:=0 to qryVendas.FieldCount-1 do
      qryVendasProdutosporGrupos.FieldByName(qryVendas.Fields[i].FieldName).Value :=
        qryVendas.fields[i].Value;
  qryVendasProdutosporGrupos.Post;

  qryVendasProdutosporGrupos.First;
  qryVendasProdutosporGrupos.EnableControls;

  qryVendasProdutosporGruposquantidadeperiodo.Index := qryVendasProdutosporGrupos.FieldCount-1;
  qryVendasProdutosporGruposvalorperiodo.Index := qryVendasProdutosporGrupos.FieldCount-1;

  result := not qryVendasporGrupos.IsEmpty;
end;

