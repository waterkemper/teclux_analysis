procedure TdtmVendasporProdutos.FiltrarVendas(tecla:String);
var
 cargo: String;
begin
  if VisualizarClientes then
  begin
    if not assigned(Selecionadas) then
      Selecionadas := TStringList.Create;

    GuardarRegistroAtual(qryVendasProdutosporGrupos, false);

    if qryVendasProdutosporGruposexpandir.AsString = '+' then
    begin
      if (tecla = '') or (tecla = '+') then
      begin
        if qryVendasProdutosporGruposgrupo.AsString<>'' then
          Selecionadas.Delete(Selecionadas.IndexOf(qryVendasProdutosporGruposgrupo.AsString));
        qryVendasProdutosporGrupos.Edit;
        qryVendasProdutosporGruposexpandir.AsString := '-';
        qryVendasProdutosporGrupos.Post;

        if qryVendasProdutosporGruposdescricaoproduto.AsString='' then
        begin
          qryVendasProdutosporGrupos.Prior;
          if qryVendasProdutosporGruposexpandir.AsString='' then
            MensagemAviso('erro')
          else
          begin
            qryVendasProdutosporGrupos.Edit;
            qryVendasProdutosporGruposexpandir.AsString := '-';
            qryVendasProdutosporGrupos.Post;
          end;
        end
        else
        begin
          qryVendasProdutosporGrupos.next;
          if qryVendasProdutosporGruposexpandir.AsString='' then
            MensagemAviso('erro')
          else
          begin
            qryVendasProdutosporGrupos.Edit;
            qryVendasProdutosporGruposexpandir.AsString := '-';
            qryVendasProdutosporGrupos.Post;
          end
        end;
      end;
    end
    else
    if qryVendasProdutosporGruposexpandir.AsString = '-' then
    begin
      if (tecla='') or (tecla='-') then
      begin
        if qryVendasProdutosporGruposgrupo.AsString<>'' then
          Selecionadas.Append(qryVendasProdutosporGruposgrupo.AsString);

        qryVendasProdutosporGrupos.Edit;
        qryVendasProdutosporGruposexpandir.AsString := '+';
        qryVendasProdutosporGrupos.Post;

        if qryVendasProdutosporGruposdescricaoproduto.AsString='' then
        begin
          qryVendasProdutosporGrupos.Prior;
          if qryVendasProdutosporGruposexpandir.AsString='' then
            MensagemAviso('erro')
          else
          begin
            qryVendasProdutosporGrupos.Edit;
            qryVendasProdutosporGruposexpandir.AsString := '+';
            qryVendasProdutosporGrupos.Post;
          end;
        end
        else
        begin
          qryVendasProdutosporGrupos.next;
          if qryVendasProdutosporGruposexpandir.AsString='' then
            MensagemAviso('erro')
          else
          begin
            qryVendasProdutosporGrupos.Edit;
            qryVendasProdutosporGruposexpandir.AsString := '+';
            qryVendasProdutosporGrupos.Post;
          end;
        end;
      end;
    end;

    qryVendasProdutosporGrupos.Filtered := (Selecionadas.Count<>0);

    VoltarRegistroAtual(qryVendasProdutosporGrupos);
  end;
end;

procedure TdtmVendasporProdutos.GerarPlanilha(PeriodoInicial,
  PeriodoFinal, moeda: String);
const
 xlCenter = -4108;

var i,coluna,eline: Integer;
    oXL, oWB, oSheet, oRng, VArray : Variant;
    NomeArquivo,v: String;
    ColunaSomatorioEvento, LinhaSomatorioEvento, LinhaSomatorioGrupo: Integer;

begin
  inherited;
  // Start Excel and get Application Object
  oXL:= CreateOleObject('Excel.Application');
  oXL.Visible := true;

  // Get a new workbook
  oWB := oXL.Workbooks.Add;
  oSheet := oWB.ActiveSheet;

  // Dataset Header

  eline :=1;

  oSheet.name := 'VENDAS ACUMULADAS';
  oSheet.Cells[eline,2].Font.FontStyle := 'Negrito';
  oSheet.Cells[eline,2].Font.size := 14;

  oSheet.Cells[eline,2] := 'VENDAS ACUMULADAS POR TIPO E QUANTIDADE '+
                           ansiuppercase(nomeMeses[strtoint(copy(PeriodoInicial,1,2))]) +
                           ' DE '+copy(PeriodoInicial,4,4)+
                           ' ATÉ '+
                           ansiuppercase(nomeMeses[strtoint(copy(PeriodoFinal,1,2))]) +
                           ' DE '+copy(PeriodoFinal,4,4);
  eline := eline + 1;

  oSheet.Cells[eline,3].Font.FontStyle := 'Negrito';
  oSheet.Cells[eline,3].Font.size := 14;
  oSheet.Cells[eline,3] := 'V E R S A N D    N A C H    T Y P E N';

  eline := eline + 2;

  coluna:=1;
  for i:=0 to qryVendasProdutosporGrupos.FieldCount -1 do
  begin
    if qryVendasProdutosporGrupos.Fields[i].Visible then
      if qryVendasProdutosporGrupos.Fields[i].FieldName <> 'expandir' then
      begin
        oSheet.Cells[eline,coluna].Font.FontStyle := 'Negrito';
        oSheet.Cells[eline,coluna] := ' '+qryVendasProdutosporGrupos.Fields[i].DisplayLabel;
        oSheet.Cells[eline,coluna].HorizontalAlignment := xlCenter;
        inc(coluna);
      end;
  end;

  if qryVendasProdutosporGrupos.IsEmpty then
    Inc(eline);

  qryVendasProdutosporGrupos.First;

  while not qryVendasProdutosporGrupos.Eof do // Detail
  begin
    Inc(eline); // Add 1 to the line of Sheet
    coluna :=1;
    for i:=0 to (qryVendasProdutosporGrupos.FieldCount-1) do
    begin
      if qryVendasProdutosporGrupos.Fields[i].visible then
      begin
        if qryVendasProdutosporGrupos.Fields[i].FieldName <> 'expandir' then
        begin
          if qryVendasProdutosporGrupos.Fields[i].fieldname = 'descricaoproduto' then
          begin
            if ((qryVendasProdutosporGruposexpandir.AsString<>'')
                 and VisualizarClientes) or
               ((qryVendasProdutosporGruposexpandir.AsString<>'')
                 and (qryVendasProdutosporGruposgrupo.IsNull)) then
               oSheet.Cells[eline,coluna].Font.FontStyle := 'Negrito';
            oSheet.Cells[eline,coluna].ColumnWidth := 50;
            oSheet.Cells[eline,coluna] := qryVendasProdutosporGrupos.Fields[i].value;
          end
          else
          if qryVendasProdutosporGrupos.Fields[i].fieldname = 'pn' then
          begin
            if ((qryVendasProdutosporGruposexpandir.AsString<>'')
                 and VisualizarClientes) or
               ((qryVendasProdutosporGruposexpandir.AsString<>'')
                 and (qryVendasProdutosporGruposgrupo.IsNull)) then
               oSheet.Cells[eline,coluna].Font.FontStyle := 'Negrito';
            oSheet.Cells[eline,coluna].ColumnWidth := 10;
            oSheet.Cells[eline,coluna] := qryVendasProdutosporGrupos.Fields[i].value;
          end
          else
          begin
            oSheet.Cells[eline,coluna].ColumnWidth := 10;
            if qryVendasProdutosporGruposdescricaoproduto.AsString='' then
            begin
              oSheet.Cells[eline,coluna] := qryVendasProdutosporGrupos.Fields[i].value/100;
              oSheet.Cells[eline,coluna].numberformat := '##0,00%';
            end
            else
            begin
              oSheet.Cells[eline,coluna] := qryVendasProdutosporGrupos.Fields[i].value;
//              oSheet.Cells[eline,coluna].numberformat := '###.###.##0,00';
//            oSheet.Cells[eline,coluna].numberformat := trocar(trocar(trocar(ParSistema.MascaraQuantidadeGrade,'.','p'),',','.'),'p',',');
            oSheet.Cells[eline,coluna].numberformat := trocar(trocar(trocar('###,###','.','p'),',','.'),'p',',');
            end;
            if ((qryVendasProdutosporGruposexpandir.AsString<>'')
                 and VisualizarClientes) {or
               ((qryVendasProdutosporGruposexpandir.AsString<>'')
                 and (qryVendasProdutosporGruposgrupo.IsNull))
               (qryVendasProdutosporGrupos.Fields[i].fieldname = 'quantidadeperiodo') or
               (qryVendasProdutosporGrupos.Fields[i].fieldname = 'valorperiodo')} then
               oSheet.Cells[eline,coluna].Font.FontStyle := 'Negrito';
          end;
          inc(coluna);
        end;
      end;
    end;
    qryVendasProdutosporGrupos.Next;

    if (qryVendasProdutosporGruposexpandir.AsString <> '') and
       (qryVendasProdutosporGruposdescricaoproduto.AsString<>'') then
      inc(eline);

  end;
  // Save the file
  NomeArquivo := ExtractFilePath(Application.ExeName) + 'Saidas';

  if not DirectoryExists(NomeArquivo) then
    if not CreateDir(NomeArquivo) then
    raise Exception.Create('Impossível criar o diretório '+NomeArquivo);

  NomeArquivo := NomeArquivo+'\VendasAcumuladasporTipoeQuantidade_'+
                 copy(PeriodoInicial,4,4)+'_'+copy(PeriodoInicial,1,2)+'_a_'+
                 copy(PeriodoFinal,4,4)+'_'+copy(PeriodoFinal,1,2);
  try
  oWB.SaveAs(NomeArquivo); except end;
//  oXL.Visible := true;
//  oXL.Quit;
end;

procedure TdtmVendasporProdutos.SetarVisualizacao;
var
 i:integer;
begin
  qryVendasProdutosporGrupos.Filtered := false;

  qryVendasProdutosporGrupos.Filtered := (not VisualizarClientes);

  if assigned(Selecionadas) then
  begin
    if not VisualizarClientes then
    begin
      for i:=0 to Selecionadas.Count -1 do
      begin
        if qryVendasProdutosporGrupos.Locate('grupo',Selecionadas[i],[]) then
        begin
          if (qryVendasProdutosporGruposexpandir.AsString<>'-') and
             (qryVendasProdutosporGruposexpandir.AsString<>'') then
          begin
            qryVendasProdutosporGrupos.Edit;
            qryVendasProdutosporGruposexpandir.AsString := '-';
            qryVendasProdutosporGrupos.Next;
            qryVendasProdutosporGrupos.Edit;
            qryVendasProdutosporGruposexpandir.AsString := '-';
            qryVendasProdutosporGrupos.Post;
          end
        end;
      end;
      Selecionadas := nil;
    end;
  end;

end;

