  FiltrocomMoeda = 'where mc.moeda = %s';
  FiltrosemMoeda = 'where mc.moeda is null';
  FiltroMoedaSelecionada = 'case when true then';
  FiltroMoedaNaoSelecionada = 'case when false then';
var
  FiltroVendas,
  FiltroServicos, mes, meses,teste : String;
  i,j,posicaomeses :integer;
  DataInicial, Datafinalaux, DataFinal: String;
begin
  qryVendasProdutosporGrupos.Filtered := false;
  if Assigned(Selecionadas) then
    Selecionadas := nil;
  DataInicial := FormatDateTime('dd/mm/yyyy', strtodatetime('01/'+periodoinicial));
  Datafinalaux := FormatDateTime('dd/mm/yyyy', strtodatetime(trim('01/'+periodofinal)));
  DataFinal   := FormatDateTime('dd/mm/yyyy', strtodatetime(inttostr(DaysInMonth(strtodatetime(Datafinalaux))) + '/'+ periodofinal));

  qryvendas.Close;
  qryvendas.Sql.Text := qryVendas_AUX.Sql.Text;

  qryVendasporGrupos.Close;
  qryVendasporGrupos.sql.Text := qryVendasporGrupos_AUX.Sql.Text;

