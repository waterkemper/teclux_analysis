function TfrmCadastroClientes.PermitirProcura: Boolean;
begin
  Result := True;
  if Assigned(ActiveControl) and (ActiveControl.Parent.Parent.ClassType = TfraEnderecoEditor) then
    Result := False
  else if CtrlOn then begin
    if ActiveControl = flkEstadoClientes then
      TipoProcura := tpESTADOSCLIENTES
    else if ActiveControl = flkConceitoClientes then
      TipoProcura := tpCONCEITOSCLIENTES
    else if ActiveControl = flkCargoClientes then
      TipoProcura := tpCARGOSCLIENTES
    else if ActiveControl = flkCargoConjuge then
      TipoProcura := tpCARGOSCONJUGECLIENTES
    else if ActiveControl = flkEstadoClientes then
      TipoProcura := tpESTADOSCLIENTES
    else if ActiveControl = flkConjuge then
      TipoProcura := tpCONJUGECLIENTES
    else if ActiveControl = flkNaturalidade then
      TipoProcura := tpNATURALCIDADECLIENTES
    else if ActiveControl = flkDebitar then
      TipoProcura:= tpCONTADEBITO
    else if ActiveControl = flkCreditar then
      TipoProcura := tpCONTACREDITO
    else if ActiveControl = flkPlanoPadrao then
      TipoProcura := tpPLANOPADRAO
    else
      Result := False;
  end else
    TipoProcura  := tpCLIENTES
end;

