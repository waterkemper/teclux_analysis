{ TfrmCadastroClientes }

constructor TfrmCadastroClientes.Create(AOwner: TComponent);
begin
  FormOrigem := '';
  dtmCadastroClientes := TdtmCadastroClientes.Create(Self);
  if(ParSistema.ContratoComServico) then
    dtmCadastroEquipamentos:= TdtmCadastroEquipamentos.Create(Self);

  inherited  Create(AOwner);
//  dtmCadastroClientes.Abre(ctCrediarioClienteCadastro);
  DataSet := dtmCadastroClientes.TabelaClientes;
  dtmCadastroClientes.OnScrollClientes  := ClientesOnScroll;
  dtmCadastroClientes.AfterPostClientes := ClientesAfterPost;
  dtmCadastroClientes.AfterCloseClientes:=ClientesAfterClose;
  ReCalcularTempoCivil  := false;
  ReCalcularTempoMoradia:= false;
  JaTestouEmail:= false;

  tstDependentes.TabVisible := ParSistema.ClienteComDependentes;
  if ParSistema.ANEXOCONTRATORECEITAOCULOS then
    tstReceitasOculos.TabVisible := dtmCadastroClientes.ReceitasOculos;

  if ParSistema.ClientePessoaJuridica then
  begin
    pgcGeral.ActivePage := tstGeralJuridica;
    fraEnderecoCliente.Parent := tstGeralJuridica;
    fraEnderecoCliente.TabOrder := 0;
    tstResidencia_ou_Entrega.Caption := '&2 - Entrega';
    pgcResidencia_ou_Entrega.ActivePage := tstEntrega;
    tstDadosComerciais.TabVisible := false;
    tstConjuge.TabVisible := false;
    tstReferencia.TabVisible := false;
//    tstOutrosDados.TabVisible := false;
    tstDependentes.TabVisible := false;
    tstEquipamentos.TabVisible := false;
    tstReceitasOculos.TabVisible := false;
  end
  else
  begin
    pgcGeral.ActivePage := tstGeralFisica;
    fraEnderecoCliente.Parent := pnlResidencia;
    fraEnderecoCliente.TabOrder := 0;
    tstResidencia_ou_Entrega.Caption := '&2 - Residência';
    pgcResidencia_ou_Entrega.ActivePage := tstResidencia;
    tstDadosComerciais.TabVisible := true;
    tstConjuge.TabVisible := true;
    tstReferencia.TabVisible := true;
//    tstOutrosDados.TabVisible := true;
    tstDependentes.TabVisible := true;
    tstEquipamentos.TabVisible := true;
    tstReceitasOculos.TabVisible := true;
  end;

  EhPessoaFisicaOuJuridica;


  pgcCadastroClientes.ActivePageIndex:= 0;
  gbxContabilidade.Visible:= ParSistema.GerarContabilidade;
  gbxPlanoPadrao.Visible := ParSistema.ClientesComPlanoPadrao;
  pnlOcultarObservacoesClienteVendedor.Visible := not(ParSistema.OcultarObservacoesClienteVendedor and
                                                  not (UsuarioLogin.AnalistaCredito or UsuarioLogin.Administrador or
                                                       UsuarioLogin.Suporte or UsuarioLogin.GerenteCaixa));
  if pnlOcultarObservacoesClienteVendedor.Visible then
  begin
    mmoClientesObservacoes.ReadOnly := true;
    mmoClientesObservacoes.TabStop  := false;
  end;
  ckbNaoExibirFichaFinanceira.Visible := UsuarioLogin.AnalistaCredito or UsuarioLogin.Administrador or UsuarioLogin.Suporte;

  fraConsultaVendedor.TipoPesquisa := pesVENDEDORES;
  fraConsultaRamodeAtividade.TipoPesquisa := pesCARGOS;
  fraConsultaPracaPagto.CondicoesdaConsulta := AtribuirParametroEstado;
  fraConsultaPracaPagto.TipoPesquisa := pesESTADOCIDADES;
  fraConsultaPracaPagto.OnFound := AtribuirParametrosPracaPagto;

  fraConsultaClienteTransito.Tipovfornecedor := 'C';
  fraConsultaClienteTransito.TipoCliente := 'C';
  fraConsultaClienteTransito.TipoPesquisa := pesCLIENTES;

  dtmCadastroClientes.OnChangeTipoFornecedor := OnChangeTipoFornecedor;


  fraConsultaModeloDocto := TfraConsultaCodigoContabil.Create(self);
  fraConsultaModeloDocto.Name := 'ConsultaModeloDocto';
  fraConsultaModeloDocto.edfCodigo.MaxLength := 2;
