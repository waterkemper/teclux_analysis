procedure TfrmCadastroClientes.KeyDown(var Key: Word; Shift: TShiftState);
var
  frmAjuda: TfrmAjuda;
begin
  case key of
   VK_Escape: begin
                  if FormOrigem='' then
                  begin
                    pgcCadastroClientes.ActivePage := tstGeral;
                    LimparEditDeTempo;
                  end
                  else
                  begin
                    frmAjuda := TfrmAjuda(FormExists(FormOrigem));
                    if Assigned(frmAjuda) then
                      frmajuda.BringToFront;
                  end;
                end;
   VK_Return: begin
                  if Shift = [] then
                  begin
                    if (pgcCadastroClientes.ActivePage = tstGeral) and
                       (pgcGeral.ActivePage = tstGeralFisica) and
                       (ActiveControl = fraConsultaPracaPagto.edfCodigo) then
                      pgcCadastroClientes.ActivePage := tstResidencia_ou_Entrega
                    else
                    if ActiveControl = edtClientesResOnus then
                    begin
                      pgcCadastroClientes.ActivePage := tstDadosComerciais;
                      edtClientesEmpresa.SetFocus;
                      Key:=0;
                    end
                    else
                    if ActiveControl = edtClientesEmpOutrasValor then begin
                      pgcCadastroClientes.ActivePage := tstConjuge;
                      flkConjuge.SetFocus;
                      Key:=0;
                    end
                    else
                    if ActiveControl = edtEmailPJ then
                    begin
                      pgcCadastroClientes.ActivePage:= tstResidencia_ou_Entrega;
                      fraEnderecoReferencia.mmoRua.SetFocus;
                      Key:=0;
                    end
                    else
                    if (pgcGeral.ActivePage = tstGeralFisica) and
                       (ActiveControl = fraConsultaPracaPagto.edfCodigo) then begin
                      pgcResidencia_ou_Entrega.ActivePage := tstEntrega;
                      Key:=0;
                    end
                    else
                    if ActiveControl = mmoObsIPISuspenso then begin
                      pgcCadastroClientes.ActivePage := tstOutrosDados;
                      if flkPlanoPadrao.CanFocus then
                        flkPlanoPadrao.SetFocus
                      else
                        ckbNaoExibirFichaFinanceira.SetFocus;
                      Key:=0;
                    end
                    else
                    if ActiveControl = edtRendaConjuge then begin
                      pgcCadastroClientes.ActivePage := tstReferencia;
                      rgpReferenciaClientes.SetFocus;
                      Key:=0;
                    end
                    else
                    if ActiveControl = fraFoneRamalReferencia_2.edtFoneRamal then begin
                      pgcCadastroClientes.ActivePage := tstOutrosDados;
                      if flkPlanoPadrao.CanFocus then
                        flkPlanoPadrao.SetFocus
                      else
                        ckbNaoExibirFichaFinanceira.SetFocus;
                      Key:=0;
                    end
                    else

                    if ((ActiveControl = flkCreditar) and ParSistema.GerarContabilidade) or
                       ((ActiveControl = ckbClientesAutomovel) and not ParSistema.GerarContabilidade) or
                       ((ActiveControl = edtMarkup) and not gbxPontuacao.Visible and not ParSistema.GerarContabilidade) then
                    begin

                      if (dtmCadastroClientes.tipopessoa = 'F') and
                         (tstDependentes.TabVisible) then
                      begin
                        pgcCadastroClientes.ActivePage := tstDependentes;
                        dbgDependentes.SetFocus;
                      end
                      else
                      if tstEquipamentos.TabVisible then
                      begin
                        pgcCadastroClientes.ActivePage := tstEquipamentos;
                        dbgEquipamentos.SetFocus;
                      end
                      else
                      if tstReceitasOculos.TabVisible then
                      begin
                        pgcCadastroClientes.ActivePage := tstReceitasOculos;
                        edtEsferico_od.SetFocus;
                      end
                      else
                      begin
                        pgcCadastroClientes.ActivePage := tstContatos;
                        dbgContatos.SetFocus;
                      end;
                      Key:=0;
                    end
                    else
                    if ActiveControl = edtCor then
                    begin
                      pgcCadastroClientes.ActivePage := tstContatos;
                      dbgContatos.SetFocus;
                    end;
                  end
                  else
                  if Shift = [ssCtrl] then
                  begin
                    if ActiveControl = dbgDependentes then
                    begin
                      pgcCadastroClientes.ActivePage := tstEquipamentos;
                      dbgEquipamentos.SetFocus;
                    end
                    else
                    if ActiveControl = dbgEquipamentos then
                    begin
                      pgcCadastroClientes.ActivePage := tstReceitasOculos;
                      edtEsferico_od.SetFocus;
                    end
                    else
                    if ActiveControl = dbgContatos then
                    begin
                      if (dtmCadastroClientes.tipopessoa = 'F') then
                      begin
                        pgcCadastroClientes.ActivePage := tstGeral;
                        edtClientesIdDocumento.SetFocus;
                      end
                      else
                      if (dtmCadastroClientes.tipopessoa = 'J') then
                      begin
                        pgcCadastroClientes.ActivePage := tstGeral;
                      end;
                    end
                  end;
                end;
  end;
  if not((Key =VK_Escape) and (FormOrigem <> '')) then
    inherited;
end;

