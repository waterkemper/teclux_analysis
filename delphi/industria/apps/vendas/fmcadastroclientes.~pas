procedure TfrmCadastroClientes.EhPessoaFisicaOuJuridica;
begin

   {----------------------------------------------------- Cliente pessoa física}
   if dtmCadastroClientes.TipoPessoa = 'F'
   then begin
      if rbnCasado.Checked or rbnOutros.Checked
      then if not tstConjuge.TabVisible
           then tstConjuge.TabVisible:= true;

      if not tstDadosComerciais.TabVisible
      then tstDadosComerciais.TabVisible:= true;

      if not tstReferencia.TabVisible
      then tstReferencia.TabVisible:= true;
      with fraEnderecoReferencia do begin
         Parent  := tstReferencia;
         TabOrder:= 2;
         Left    := 102;
         Top     := 49;
      end;

      with gbxPracaPagto do
         if Parent <> tstGeralFisica
         then begin
            Parent  := tstGeralFisica;
            TabOrder:= 9;
            Left    := 171;
            Top     := 309;
         end;


      if not ParSistema.ClienteComDependentes
      then tstDependentes.TabVisible:= false
      else if not tstDependentes.TabVisible
           then tstDependentes.TabVisible:= true;

      if not ParSistema.ContratoComServico
      then tstEquipamentos.TabVisible:= false
      else if not tstEquipamentos.TabVisible
           then tstEquipamentos.TabVisible:= true;

      if not dtmCadastroClientes.ReceitasOculos
      then tstReceitasOculos.TabVisible:= false
      else if not tstReceitasOculos.TabVisible
           then tstReceitasOculos.TabVisible:= true;

   end

   {--------------------------------------------------- Cliente pessoa jurídica}
   else begin
      tstConjuge.        TabVisible:= false;
      tstDadosComerciais.TabVisible:= false;
      tstDependentes.    TabVisible:= false;
      tstEquipamentos.   TabVisible:= false;
      tstReceitasOculos. TabVisible:= false;
      tstReferencia.     TabVisible:= false;
      with fraEnderecoReferencia do begin
         Parent  := pnlEntrega;
         TabOrder:= 0;
         Left    := 0;
         Top     := -2;
      end;

      with gbxPracaPagto do
         if Parent <> tstGeralJuridica
         then begin
            Parent  := tstGeralJuridica;
            TabOrder:= 4;
            Left    := 1;
            Top     := 218;
         end;


   end;
   gbxSerie.    Visible:= dtmCadastroClientes.TipoPessoa = 'J';
   gbxPontuacao.Visible:= dtmCadastroClientes.tipopessoa = 'F';
end;

end.

