procedure TfrmComplementarNotasVenda.AtribuirNatureza;
begin
  with dtmEmissaoNotasVenda do
  begin
    qryDadosFiscaiscodigonatureza.AsInteger := flkNaturezaOperacao.LookupSource.DataSet.fieldbyname('codigonatureza').AsInteger; //fraConsultaCodigoCFOP.edfCodigo.LookupSource.DataSet.fieldbyname('codigonatureza').AsInteger;
    qryDadosFiscaisnatureza.AsString := flkNaturezaOperacao.LookupSource.DataSet.fieldbyname('descricaonatureza').AsString;
    if qryDadosFiscaisdadofiscalcomplementar.AsInteger = 0 then
    begin
      qryProdutosDadosFiscais.First;
      while not qryProdutosDadosFiscais.Eof do
      begin
        qryProdutosDadosFiscais.Edit;

        if qryProcuraNaturezasCFOPicmscst.AsString<>'' then
          qryProdutosDadosFiscaisincidencia.AsString := qryProcuraNaturezasCFOPicmscst.AsString;

        if qryProcuraNaturezasCFOPcsosn.AsString<>'' then
          qryProdutosDadosFiscaiscsosn.AsString := qryProcuraNaturezasCFOPcsosn.AsString;

        if qryDadosFiscaisipisuspenso.AsBoolean then
          qryProdutosDadosFiscaisipicst.AsString := '55'
        else
          qryProdutosDadosFiscaisipicst.AsString := qryProcuraNaturezasCFOPipicst.AsString;

        qryProdutosDadosFiscaispiscst.AsString := qryProcuraNaturezasCFOPpiscst.AsString;
        qryProdutosDadosFiscaiscofinscst.AsString := qryProcuraNaturezasCFOPcofinscst.AsString;
        qryProdutosDadosFiscais.post;
        qryProdutosDadosFiscais.Next;
      end;
    end;
    CalcularImpostos(qryprodutosdadosfiscais, qrydadosfiscais, contribipi, true, true, nil, nil, false, NotaIndustria);
  end;
end;

procedure TfrmComplementarNotasVenda.AtribuirVenctosDadosFiscais;
var
  Parcelas: TResumosParcelas;
  ValorPrazo, TaxaJuros, Desconto: Real;
  Plano: Integer;
begin
  inherited;
  if dtmEmissaoNotasVenda.qryDadosFiscaisplano.AsInteger > 0 then
  begin
    dtmEmissaoNotasVenda.qryDadosFiscaisagente.AsInteger := fraConsultaCodigoPlano.qryProcuraPlanoagente.AsInteger;
    dtmEmissaoNotasVenda.qryDadosFiscaistaxajuros.AsCurrency := fraConsultaCodigoPlano.qryProcuraPlanotaxamensaljuros.AsCurrency;

    Plano := dtmEmissaoNotasVenda.qryDadosFiscaisplano.AsInteger;
    frmCalculoFinanciamento := TfrmCalculoFinanciamento.Create(Owner, True);
    try
      frmCalculoFinanciamento.DefinirValoresCalculo(True,
                                                    dtmEmissaoNotasVenda.qryDadosFiscaisvalorprodutos.AsCurrency -
                                                    dtmEmissaoNotasVenda.qryDadosFiscaisdesconto.AsCurrency +
                                                    dtmEmissaoNotasVenda.qryDadosFiscaisvaloripi.AsCurrency,
                                                    dtmEmissaoNotasVenda.qryDadosFiscaisvalorfrete.AsCurrency,
                                                    dtmEmissaoNotasVenda.qryDadosFiscaisseguro.AsCurrency +
                                                    dtmEmissaoNotasVenda.qryDadosFiscaisdespesasacessorias.AsCurrency,
                                                    0,
                                                    0,
                                                    0,
                                                    dtmEmissaoNotasVenda.qryDadosFiscaisplano.AsInteger,
                                                    dtmEmissaoNotasVenda.qryDadosFiscaisdata.AsString,
                                                    dtmEmissaoNotasVenda.qryDadosFiscaisestado.AsString,
                                                    Parcelas,
                                                    nil,
                                                    nil,
                                                    false, 0);
      if frmCalculoFinanciamento.CalcularPlanoPadrao(Plano) then
      begin
        frmCalculoFinanciamento.ResumosParcelas(Parcelas, ValorPrazo, TaxaJuros, Desconto, Plano);
        dtmEmissaoNotasVenda.DefinirVentosDadosFiscais(Parcelas,
          fraConsultaCodigoPlano.edfCodigo.LookupSource.DataSet.FieldByName('mestrintadias').AsBoolean,
          fraConsultaCodigoPlano.edfCodigo.LookupSource.DataSet.FieldByName('intervaloparcelas').AsInteger);
      end;
    finally
      frmCalculoFinanciamento.Free;
    end;
  end;
end;

