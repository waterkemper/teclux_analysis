procedure TfrmComplementarNotasVenda.bbnOKClick(Sender: TObject);
begin
  inherited;
  if dtxValorTotal.DataSource.DataSet.FieldByName('valortotal').AsCurrency <>
     dtmEmissaoNotasVenda.TotalVenctos then
  begin
    MensagemAviso('A soma dos vencimentos: R$ ' + formatarValor(dtmEmissaoNotasVenda.TotalVenctos,2) +
                  ' difere do total da nota: R$ ' + formatarValor(dtxValorTotal.DataSource.DataSet.FieldByName('valortotal').AsCurrency,2));
    dbgVenctos.SetFocus;
  end
  else
    ModalResult := mrOK;
end;

