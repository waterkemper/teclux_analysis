  Sender: TObject);
begin
  inherited;
  CtrlOn := True;
  flkNaturezaOperacao.SetFocus;
  InternoPesquisar(ctCODIGOFISCAL);
end;

procedure TfrmComplementarNotasVenda.flkNaturezaOperacaoChange(
  Sender: TObject);
begin
  inherited;
  if length(flkNaturezaOperacao.Text) = 4 then
    tstExportacao.TabVisible := (copy(flkNaturezaOperacao.Text,1,1)='7');
