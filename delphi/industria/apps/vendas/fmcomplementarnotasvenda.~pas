procedure TfrmComplementarNotasVenda.CondicoespesNaturezasCFOP;
begin
  fraConsultaCodigoCFOP.qryConsultaNaturezasCFOP.macrobyname('ListaVendas').asstring := ctCFOVENDAS;
  if fraConsultaCodigoCFOP.qryConsultaNaturezasCFOP.MacroByName('CodigoFiscal').AsString = '' then
    fraConsultaCodigoCFOP.qryConsultaNaturezasCFOP.MacroByName('CodigoFiscal').AsString :=
      'and (n.codigofiscal in (select cf.codigo from codigosfiscais cf))';

  fraConsultaCodigoCFOP.qryProcuraNaturezasCFOP.macrobyname('ListaVendas').asstring := ctCFOVENDAS;

  if dtmEmissaoNotasVenda.qryDadosFiscaisestadocfo.AsString = dtmEmissaoNotasVenda.EstadoFilialBase then
  begin
    fraConsultaCodigoCFOP.qryConsultaNaturezasCFOP.ParamByName('local').asstring  := 'L';
    fraConsultaCodigoCFOP.qryprocuraNaturezasCFOP.ParamByName('local').asstring := 'L';
  end
  else
  if HeUnidadeFederacao(dtmEmissaoNotasVenda.qryDadosFiscaisestadocfo.AsString) then
  begin
    fraConsultaCodigoCFOP.qryConsultaNaturezasCFOP.ParamByName('local').asstring  := 'F';
    fraConsultaCodigoCFOP.qryprocuraNaturezasCFOP.ParamByName('local').asstring := 'F';
  end
  else
  begin
    fraConsultaCodigoCFOP.qryConsultaNaturezasCFOP.ParamByName('local').asstring  := 'E';
    fraConsultaCodigoCFOP.qryprocuraNaturezasCFOP.ParamByName('local').asstring := 'E';
  end;
end;
}
