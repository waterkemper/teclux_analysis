function TfrmComplementarNotasVenda.InternoPesquisar(
  Titulo: String): Integer;
begin
  Result := mrNone;
  if flkNaturezaOperacao.Focused then
  begin
    dtmEmissaoNotasVenda.Abre(ctTabelaNaturezaOperacoes);
    Result := inherited InternoPesquisar(ctCodigoFiscal);
    if Result = mrOK then
      dtmEmissaoNotasVenda.SelecionarNatureza;
    dtmEmissaoNotasVenda.Fecha(ctTabelaNaturezaOperacoes);
  end;
end;

function TfrmComplementarNotasVenda.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
  TfrmConsultaPorCampo(Result).ConsultaInterativa := True;
  TfrmConsultaPorCampo(Result).UsarParametrosDaTabela := False;
end;

