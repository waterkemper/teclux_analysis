                               'Favor Definir o valor no CADASTRO DE PRODUTOS/SERVIÇOS ou no CADASTRO DE NATUREZAS';


  SQLDadosProdutos =
' select p.descricao as descricaoproduto,'                                                                                    +
'        c.descricaonanf,'                                                                                +
'         (select gr.descricao from grades gr where gr.codigo = c.grade1) as linha,'                      +
'         (select gr.descricao from grades gr where gr.codigo = c.grade2) as coluna,'                     +
'         p.valorgrade1,'                                                                                 +
'         p.valorgrade2,'                                                                                 +
'         c.anvisa, '                                                                                     +
'         c.grade1, c.grade2, '                                                                           +
'         p.codigo as produto, '                                                                          +
'         p.codigovisual as produtovisual, '                                                              +
'         p.codigovisual as produtodigitado, '                                                            +
'         e.filial,'                                                                                      +
'         estoques_preco(p.codigo, f.codigo) as precounitario,'                                           +
'         c.montagem,'                                                                                    +
'         c.unidade,'                                                                                     +
'         (select u.descricao from unidades u where u.codigo = c.unidade) as descricaounidade, '          +
'         c.brinde,'                                                                                      +
'         Selecionar_AliquotaIcms(:EstadoFilialBase,:Estadocfo,:TipoPessoa, p.codigo) as AliquotaIcms,'   +
'         c.baseicms,'                                                                                    +
'         c.icms,'                                                                                        +
'         c.ipi,'                                                                                         +
'         (select i.aliquota from ipi i where i.codigo = c.ipi) as Aliquotaipi,'                          +
'         (select i.aliquota from ipi i where i.codigo = c.ipi) as AliquotaipiOriginal,'                  +
'         c.aliquotapis,'                                                                                 +
'         c.aliquotacofins,'                                                                              +
'         (select i.classificacaofiscal  from ipi i    where (i.codigo = c.ipi)) as classificacaofiscal,' +
'         (select ipi.genero from ipi where ipi.codigo = c.ipi) as genero,'                               +
'         (select ipi.extipi from ipi where ipi.codigo = c.ipi) as extipi,'                               +
'         c.ICMSModalidade,'                                                                              +
'         c.ICMSModSubst,'                                                                                +
'         c.vendanegativa as vendasemestoque,'                                                            +
'         c.origem, '                                                                                     +
'         ti.valor as incidencia,'                                                                        +
'         c.csosn,'                                                                                       +
'         c.percreducaobase,'                                                                             +
'         c.pRedBCST,'                                                                                    +
'         (select case when (m.financeiro = 0) or (m.financeiro is null) then 0'                          +
'                           else round(m.financeiro/coalesce(nullif(quantidadetotaldoestoque(m.numero),0),1),2) end'+
'          from movimentos m '                                                                            +
'          where m.numero = (Select m.numero '                                                            +
'                             From movimentos m '                                                         +
'                             Where (m.produto = e.produto) and '                                         +
'                                   (m.filial  = e.filial) '                                              +
'          order by m.data desc, m.lancto desc limit 1 )) as ultimocustomedio,'                           +
'         case when c.composto then '                                                                     +
'            case when quantidadetotaldoestoque(e.produto,e.filial)>0 then '                              +
'            (select sum(e1.financeiro) '                                                                 +
'             from estoques e1 '                                                                          +
'             where e1.produto in (select componente from produtoscompostos where composto=e.produto) '   +
'             and e1.filial=e.filial)/quantidadetotaldoestoque(e.produto,e.filial) '                      +
'            else '                                                                                       +
'              0 '                                                                                        +
'            end '                                                                                        +
'         else '                                                                                          +
'         case when (e.financeiro = 0) or (e.financeiro is null) then 0'                                  +
'                 else round(e.financeiro/coalesce(nullif(quantidadetotaldoestoque(e.produto,e.filial),0),1),2)'+
'         end end as customedio,'                                                                         +
'         c.composto,'                                                                                    +
'         0.00 as aliquotaicmsst,'                                                                        +
'         0.00 as quantidade,'                                                                            +
'         c.ipicst,'                                                                                      +
'         c.piscst,'                                                                                      +
'         c.cofinscst,'                                                                                   +
'         c.codigo_efd_t53,'                                                                              +
'         e.valorultimacompra,'                                                                           +
'         e.localizacao,'                                                                                 +
'         p.caracteristica,'                                                                              +
'         c.grupo,'                                                                                       +
'         c.classe, c.cest, '                                                                             +
'       (select ncm.nacionalfederal '                                                                     +
'        from ncmtabela ncm'                                                                              +
'        where (ncm.codigotipi, coalesce(ncm.extipi,'''')) in'                             +
'                                       (select ipi.classificacaofiscal, coalesce(ipi.extipi,'''')' +
'                                        from ipi'                                                        +
'                                        where ipi.codigo = c.ipi)) as nacionalfederal,'                  +
'       (select ncm.importadosfederal'                                                                        +
'        from ncmtabela ncm'                                                                              +
'        where (ncm.codigotipi, coalesce(ncm.extipi,'''')) in'                             +
'                                              (select ipi.classificacaofiscal, coalesce(ipi.extipi,'''')' +
'                                               from ipi'                                                 +
'                                               where ipi.codigo = c.ipi)) as importadosfederal,'         +
'       (select ncm.cargaestadual'                                                                        +
'        from ncmtabela ncm'                                                                              +
'        where (ncm.codigotipi, coalesce(ncm.extipi,'''')) in'                             +
'                                              (select ipi.classificacaofiscal, coalesce(ipi.extipi,'''')' +
'                                               from ipi'                                                 +
'                                               where ipi.codigo = c.ipi)) as cargaestadual,'         +
'       (select ncm.chaveibpt'                                                                        +
'        from ncmtabela ncm'                                                                              +
'        where (ncm.codigotipi, coalesce(ncm.extipi,'''')) in'                             +
'                                              (select ipi.classificacaofiscal, coalesce(ipi.extipi,'''')' +
'                                               from ipi'                                                 +
'                                               where ipi.codigo = c.ipi)) as chaveibpt,'         +
'         c.markup as markup_produto,' +
'         g.markup as markup_grupo,' +
'         (select vf.markup from vfornecedores vf where vf.codigo = :fornecedor and vf.tipo = :tipofornecedor) as markup_fornecedor, ' +
'         g.calcularpreco, '+
'         c.codigovisual as caracteristicavisual, ' +
'         p.referencia, ' +
'         p.preco as codigopreco, '+
'         pr.descricao as descricaoprecoproduto, '+
'       (select m1.valor from estadosicms m1 where m1.icms = c.icms and m1.estado =:EstadoFilialBaseCalculoPreco) as aliquotaicmscalculopreco,' +
'       (case when g.naoreplicar then true else cl.naoreplicar end) as naoreplicar, '+
'         c.descricao as descricaocaracteristica, '           +
'        ti.valor as cst_produto, '+
'        c.csosn as csosn_produto, c.peso, c.volumes, ' +
'       coalesce((select pfu.fatorconversao from produtosfornecedoresunidades pfu '+
'         where pfu.fornecedor=:fornecedor '+
'           and pfu.tipofornecedor=:tipofornecedor '+
'           and pfu.produto = :produto '+
'           and pfu.unidade = :unidade), cast(1 as numeric(10,6))) as fatorconversao '+

' from (((produtos p join estoques e on p.codigo = e.produto)'                                             +
'                        join (((caracteristicas c left join tributosicms ti on c.incidencia = ti.codigo)'  +
'                                                join grupos g on c.grupo = g.codigo)'+
'                                                join classes cl on c.classe = cl.codigo)'+
'                                                        on p.caracteristica = c.codigo)'                  +
'                        left join precos pr '+
'                        on p.caracteristica = pr.caracteristica' +
'                        and p.preco = pr.codigo), filiais f' +
' where p.codigo = e.produto '                                                                            +
'   and p.caracteristica = c.codigo '                                                                     +
'   and p.codigo = :produto '                                                                              +
'   and (e.filial = case when f.tipofilial=''V'' then coalesce(f.filial_estoque,f.codigo) else f.codigo end) '+
'   and f.codigo = :filialbase ';
{'   and (p.inativo is null)';}



