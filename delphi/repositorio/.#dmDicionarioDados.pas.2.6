procedure TdtmDicionarioDados.qryQuestionariosAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  RefazConsultaPorNome(qryPerguntas,['questionario'],[qryQuestionarios.fieldbyname('codigo').asVariant]);
  RefazConsultaPorNome(qryRespostas,['questionario'],[qryQuestionarios.fieldbyname('codigo').asVariant]);

end;

procedure TdtmDicionarioDados.qryQuestionariosBeforeEdit(
  DataSet: TDataSet);
begin
  inherited;
;
end;

procedure TdtmDicionarioDados.AdicionarPerguntas;
begin
  if qryPerguntas.CheckRequiredFields then
    qryperguntas.append;
end;

procedure TdtmDicionarioDados.qryQuestionariosAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if assigned(AfterOpenQuestionarios) then
    AfterOpenQuestionarios(qryQuestionarios);
end;

procedure TdtmDicionarioDados.qryPerguntasAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if assigned(AfterOpenPerguntas) then
    AfterOpenPerguntas(qryQuestionarios);

end;

procedure TdtmDicionarioDados.ExcluirPerguntas;
begin
  Excluir(qryPerguntas);
end;

procedure TdtmDicionarioDados.Excluir(Tabela: TTecQuery);
begin
  if MensagemConfirmacao('Confirma a exclusão deste registro') = smbOK then
    Tabela.delete;
end;

procedure TdtmDicionarioDados.ExcluirRespostas;
begin
  Excluir(qryRespostas);
end;

function TdtmDicionarioDados.AdicionarRespostas: Boolean;
begin
  result := true;

  if (qryPerguntas.state in [dsinsert, dsedit]) then
  begin
    result := qryPerguntas.CheckRequiredFields;
    if result then
      qryPerguntas.post;
  end;

  if result then
  begin
    if qryRespostas.CheckRequiredFields then
      qryRespostas.append;
  end;


end;


procedure TdtmDicionarioDados.qryRespostasAfterOpen(DataSet: TDataSet);
begin
  inherited;
  if assigned(AfterOpenRespostas) then
    AfterOpenRespostas(qryRespostas);

end;

procedure TdtmDicionarioDados.qryPerguntasAfterPost(DataSet: TDataSet);
begin
  inherited;
  qryQuestionarios.edit;

  if qryPerguntastipo.asString = 'texto' then
  begin
    if qryRespostas.IsEmpty then
    begin
      qryRespostas.append;
      qryRespostasresposta.asString := 'Resposta';
      qryRespostas.post;
    end;
  end;
  
end;

procedure TdtmDicionarioDados.qryPerguntasAfterDelete(DataSet: TDataSet);
begin
  inherited;
  qryQuestionarios.edit;
end;

procedure TdtmDicionarioDados.qryRespostasAfterPost(DataSet: TDataSet);
begin
  inherited;
  qryQuestionarios.edit;


end;

procedure TdtmDicionarioDados.qryRespostasAfterDelete(DataSet: TDataSet);
begin
  inherited;
  qryQuestionarios.edit;
end;

function TdtmDicionarioDados.GravarQuestionarios: boolean;
begin
  result := qryQuestionarios.CheckRequiredFields;

  if result then
    result := qryPerguntas.CheckRequiredFields;

  if result then
    result := qryRespostas.CheckRequiredFields;

  if result then
  begin
    if qryQuestionarios.CheckRequiredFields then
    begin
      qryQuestionarios.post;

      result := Perpetrar([qryQuestionarios, qryPerguntas, qryRespostas]);
    end;
  end;  
end;

procedure TdtmDicionarioDados.qryPerguntasAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if assigned(AfterOpenRespostas) then
    AfterOpenRespostas(qryRespostas);

end;

procedure TdtmDicionarioDados.qryPerguntasNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryPerguntas.fieldbyname('justificativa').asBoolean := false;
  qryPerguntas.fieldbyname('questionario').asinteger := qryQuestionarios.fieldbyname('codigo').asInteger;
  qryPerguntas.fieldbyname('codigo').asinteger := PerguntasProximoCodigo;
  qryperguntas.fieldbyname('sequencia').asInteger := qryperguntas.recordcount + 1;

  if assigned(AfterOpenPerguntas) then
    AfterOpenPerguntas(qryQuestionarios);

end;

constructor TdtmDicionarioDados.Create(AOwner: TComponent);
begin
  inherited;
  
end;

function TdtmDicionarioDados.AdicionarQuestionarios: Boolean;
begin
  result := true;
  qryQuestionarios.append;
end;

function TdtmDicionarioDados.QuestionarioProximoCodigo: integer;
begin

 qryQuestionariosProximo.close;
 qryQuestionariosProximo.open;

 result := qryQuestionariosProximo.fieldbyname('codigo').asinteger;

end;

procedure TdtmDicionarioDados.qryQuestionariosNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryQuestionarios.fieldbyname('codigo').asInteger := QuestionarioProximoCodigo;
  qryQuestionariostipo.ASsTRING :=  'CheckList';
  qryQuestionariosdata_inicio.asDateTime := DataHoraServidor;
  qryQuestionariosdata_fim.asDateTime := IncYear(DataHoraServidor, 1);

  if assigned(AfterOpenQuestionarios) then
    AfterOpenQuestionarios(qryQuestionarios);
  

  
end;

function TdtmDicionarioDados.PerguntasProximoCodigo: integer;
begin
  qryPerguntasProximo.close;
  qryPerguntasProximo.open;
  result := qryPerguntasProximo.fieldbyname('codigo').asinteger;
end;

function TdtmDicionarioDados.RespostasProximoCodigo: integer;
begin
  qryRespostasProximo.close;
  qryRespostasProximo.open;
  result := qryRespostasProximo.fieldbyname('codigo').asinteger;

end;

procedure TdtmDicionarioDados.qryRespostasNewRecord(DataSet: TDataSet);
begin
  inherited;
  qryRespostas.fieldbyname('pergunta').asinteger := qryPerguntas.fieldbyname('codigo').asinteger;
  qryRespostas.fieldbyname('codigo').asinteger := RespostasProximocodigo;  
  qryRespostas.fieldbyname('sequencia').asInteger := qryRespostas.recordcount + 1;

  if assigned(AfterOpenRespostas) then
    AfterOpenRespostas(qryRespostas);
  
end;

function TdtmDicionarioDados.ExcluirQuestionario: boolean;
begin
  result := false;
  if MensagemConfirmacao('A Exclusão deste registo?') = smbOK then
  begin
    qryQuestionarios.delete;
    result := perpetrar([qryQuestionarios]);
  end;
end;

