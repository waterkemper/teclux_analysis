function VerificarProdutosNaoConferidos(Codigo: String; tipo: String): TModalResult;
var
  dtmDicionarioDados : TdtmDicionarioDados;

begin
  dtmDicionarioDados := TdtmDicionarioDados.create(nil);

  result := mrNone;

  with dtmDicionarioDados do
  begin

    if tipo = 'CTR' then
    begin

      qryProdutosConferencia.sql.text := qryProdutosConferencia_ProdutosContratos.sql.text;
      qryProdutosConferencia.MacroByName('codigo').asString := Codigo;
      qryProdutosConferencia.paramByName('tipo').asString := Tipo;
      qryProdutosConferencia.MacroByName('Condicao').AsString := 'and pc.quantidade > coalesce(pcf.lido,0)';

      qryProdutosConferencia.close;
      qryProdutosConferencia.open;

    end
    else
    if tipo = 'TRF' then
    begin

      qryProdutosConferencia.sql.text := qryProdutosConferencia_PedidosFiliais.sql.text;

      qryProdutosConferencia.MacroByName('codigo').asString := Codigo;
      qryProdutosConferencia.paramByName('tipo').asString := Tipo;
      qryProdutosConferencia.MacroByName('Condicao').AsString := ' and ((coalesce(pf.qtderecebida,0) <> coalesce(pcf.lido,0)) or coalesce(pf.qtderecebida,0)=0) ';

      qryProdutosConferencia.close;
      qryProdutosConferencia.open;

    end;



    if qryProdutosConferencia.recordcount <> 0 then
    begin

      frmmensagemgridprodutosconferencia := Tfrmmensagemgridprodutosconferencia.Create(frmmensagemgridprodutosconferencia);
      frmmensagemgridprodutosconferencia.lblTitulo.caption := 'LISTA DE PRODUTOS NÃO CONFERIDOS!';
      frmmensagemgridprodutosconferencia.lblTitulo.font.size := -11;

      qryProdutosConferenciaprodutovisual.visible := True;
      qryProdutosConferenciadescricaoproduto.visible := True;
      qryProdutosConferenciatipo.visible := false;
      qryProdutosConferenciacodigo.visible := false;
      qryProdutosConferenciaproduto.visible := false;
      qryProdutosConferencialido.visible := false;
      qryProdutosConferenciadigitado.visible := false;
      qryProdutosConferenciadatahora_inclusao.visible := false;
      qryProdutosConferenciadatahora_alteracao.visible := false;

      frmmensagemgridprodutosconferencia.dsrListaErros.DataSet := qryProdutosConferencia;
      frmmensagemgridprodutosconferencia.TipoOrigem := ProdutosConferencia;
      frmmensagemgridprodutosconferencia.dbgMensagem.Options := frmmensagemgridprodutosconferencia.dbgMensagem.Options + [goVertLine];
      frmmensagemgridprodutosconferencia.ShowModal;

      result := frmmensagemgridprodutosconferencia.modalresult;

    end;

  end;

end;

