    Macros = <>
    Sql.Strings = (
      'select c.cliente,'
      '       c.numero,'
      '       c.data as datavenda,'
      '       p.parcelaorigem,'
      '       p.contrato,'
      '       p.datavencto,'
      '       p.datapagto,'
      '       p.valorvencto,'
      '       cl.nome'
      '  from contratos c'
      '  join parcelas p  on p.contrato = c.numero'
      '  join clientes cl on cl.codigo = c.cliente'
      ' where c.cliente = :cliente'
      '   and p.datapagto is null'
      '   and (c.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39'))'
      
        '   and (0 = coalesce((select Count(*) from contratos c1 where c1' +
        '.origem = c.numero),0))'
      
        '   and (0 < coalesce((select count(*) from parcelas p where (p.c' +
        'ontrato = c.numero) and (p.datapagto is null)),0))'
      '/* Ru8n-Time  */'
      'order by to_number(c.numero, '#39'99999999999999999999'#39') desc')
