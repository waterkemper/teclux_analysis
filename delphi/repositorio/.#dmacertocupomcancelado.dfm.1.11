    Macros = <>
    Sql.Strings = (
      'select c.filial,'
      '       c.maquina,'
      '       c.numero as cupom,'
      '       d.numero,'
      '       d.data,'
      '       d.situacao,'
      '       d.contrato,'
      '       d.contratofrentecaixa,'
      '       d.creditotroca,'
      '       d.cliente,'
      '       d.tipocliente,'
      '       d.orcamento'
      
        'from dadosfiscais d left join cupons c on d.numero = c.dadofisca' +
        'l'
      'where'
      '     (('
      '        c.filial     = :filial  and'
      '        c.maquina    = :maquina and'
      '        c.intervensao= :intervencao and'
      '        c.numero     = :cupom and'
      '        c.numeroserie = :numeroserie ) or'
      ''
      '        d.numero = :dadofiscal)')
