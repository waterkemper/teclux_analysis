    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select count(df.*) as quant'
      'from dadosfiscais df join cupons c on c.dadofiscal = df.numero'
      'where df.situacao = '#39'N'#39
      '  and df.contrato = (select df1.contrato'
      
        '                     from dadosfiscais df1 join cupons c1 on c1.' +
        'dadofiscal = df1.numero'
      '                     where c1.filial      = :filial'
      '                       and c1.maquina     = :ecf'
      '                       and c1.intervensao = :intervencao'
      '                       and c1.numero      = :cupom'
      '                       and c1.numeroserie = :num_fab'
      '                     )')
