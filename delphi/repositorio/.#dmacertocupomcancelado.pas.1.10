    qryDadosFiscaistipocliente: TStringField;
    qryOrcamentos: TtecQuery;
    qryDadoFiscalVinculado: TtecQuery;
    qryDadoFiscalVinculadonumero: TIntegerField;
    qryDadoFiscalVinculadosituacao: TStringField;
    qryDadoFiscalVinculadomodelodocto: TStringField;
    qryDadosFiscaisorcamento: TIntegerField;
    qryVenctosDadosFiscais: TtecQuery;
    qryVenctosDadosFiscaisdadofiscal: TIntegerField;
    qryVenctosDadosFiscaisnumero: TIntegerField;
    qryVenctosDadosFiscaisdatavencto: TDateField;
