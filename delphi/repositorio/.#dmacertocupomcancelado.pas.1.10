    qryProdutosbaseicms: TFloatField;
    qryProdutosreducaobase: TFloatField;
    qryProdutoscomposto: TBooleanField;
    qryProdutosdiscriminarcomposto: TStringField;
    qryProdutosdiscriminarpreco: TBooleanField;
    qryContratoDadosFiscais: TtecQuery;
    qryContratoDadosFiscaisquant: TLargeintField;
    qryParcelasPagas: TtecQuery;
    qryParcelasPagasexiste: TBooleanField;
    qryContratos: TtecQuery;
    qryContratossituacao: TStringField;
    qryContratosnumero: TStringField;
    qryContratosoperacao: TStringField;
    qryDadosFiscaisfilial: TIntegerField;
    qryDadosFiscaismaquina: TIntegerField;
    qryDadosFiscaiscupom: TIntegerField;
    qryDadosFiscaisnumero: TIntegerField;
    qryDadosFiscaisdata: TDateField;
    qryDadosFiscaissituacao: TStringField;
    qryDadosFiscaiscontrato: TStringField;
    qryAutenticacoes: TtecQuery;
    qryAutenticacoesnumero: TIntegerField;
    qryAutenticacoesfilial: TIntegerField;
    qryAutenticacoesnum_usu: TIntegerField;
    qryAutenticacoescro: TIntegerField;
    qryAutenticacoescoo: TIntegerField;
    qryAutenticar: TtecQuery;
    qryAutenticarcaixa: TIntegerField;
    qryAutenticarautenticacao: TIntegerField;
    qryAutenticarfilial: TIntegerField;
    qryAutenticarnumero: TIntegerField;
    qryAutenticarsituacao: TBooleanField;
    qryAutenticartipo: TStringField;
    qryAutenticarvalor: TFloatField;
    spcAutenticacaoProximo: TtecQuery;
    spcAutenticacaoProximonumero: TIntegerField;
    qryAutenticacoesvalor: TFloatField;
    qryDetalheCupom: TtecQuery;
    qryDetalhedemaisdoctos: TtecQuery;
    qryDadosFiscaiscontratofrentecaixa: TStringField;
    qryRecebimentos: TtecQuery;
    qryAutenticacoestransacao: TIntegerField;
    qryRecebimentoscodigo: TIntegerField;
    qryRecebimentossituacao: TStringField;
    qryRecebimentosTemp: TtecQuery;
    qryRecebimentosTempnomeredensu: TStringField;
    qryRecebimentosTemptef: TStringField;
    qryRecebimentosTempdatalancto: TDateField;
    qryRecebimentosTemphora: TTimeField;
    qryRecebimentosTempvalortotal: TFloatField;
    qryProdutosTrocados: TtecQuery;
    qryProdutosTrocadosnumero: TIntegerField;
    qryProdutosTrocadostipo: TStringField;
    qryProdutosTrocadosdata: TDateTimeField;
    qryProdutosTrocadoscliente: TIntegerField;
    qryProdutosTrocadostipocliente: TStringField;
    qryProdutosTrocadoscontrato: TStringField;
