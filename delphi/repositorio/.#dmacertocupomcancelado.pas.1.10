  SysUtils, Classes, DB, ZQuery, ZPgSqlQuery, cpquery,
  cpdatasource, biblio, Variants, ZTransact, dmbasico, cltefdiscado,
  dmcontrolenotasfiscaiseletronicas, clusuario;

