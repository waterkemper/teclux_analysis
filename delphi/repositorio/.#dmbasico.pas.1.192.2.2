     function CalcularImpostoRateado(ValorImposto: Currency;
                                     Tipo: TtecLancamentosContasEntradas):Currency;
     var
       valor : currency;
       i: integer;
       TipoNaoCadastrado : Boolean;
     begin
       valor := ValorDoPercentualSobreTotal(ValorImposto,
                                     PercentualDoValorSobreTotal(
                                     qryDocumentosPag.FieldByName('ValorLiquido').AsCurrency,
                                     qryDuplicatas.FieldByName('ValorVencto').AsCurrency));
       TipoNaoCadastrado := true;
       for i := 0 to length(Lancamentoscontas)-1 do
         if tipo = LancamentosContas[i].Lancamento then
         begin
           TipoNaoCadastrado := false;
           LancamentosContas[i].Valor := LancamentosContas[i].Valor + valor;
           if ((ValorImposto - LancamentosContas[i].Valor) <= 0.01) then
              valor  := ValorImposto - LancamentosContas[i].Valor + valor;
         end;

       if TipoNaoCadastrado then
       begin
         i := length(Lancamentoscontas)+1;
         SetLength(Lancamentoscontas, i);
         LancamentosContas[i-1].Lancamento := tipo;
         LancamentosContas[i-1].Valor := valor;
       end;
       result := valor;
     end;

     function posicionarDocumentospagimpostosretidos: Boolean;
     begin
       result := false;
       qryDocumentospagimpostosretidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
         if (qryDocumentosPagImpostosRetidos.FieldByName('datavenctoorigem').AsDateTime =
             qryDuplicatas.FieldByName('DataVenctooriginal').asdatetime) and
            (qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').AsInteger =
             qryduplicatas.FieldByName('numero').Asinteger) and
            (qryDocumentosPagImpostosRetidos.FieldByName('documentopagorigem').AsInteger =
             qryduplicatas.FieldByName('documentopag').Asinteger) and
            (qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString =
             FilialContasEntradas[tipo]) then
         begin
           result := true;
           break;
         end
         else
           qryDocumentospagimpostosretidos.Next;
     end;
  begin
    result := true;
    HouveMudancaFatoGeradoreComQuitacao := false;
    if qryVenctosImpostosRetidosEntradas.Locate('descricao', FilialContasEntradas[tipo], []) then
    begin
      if qryVenctosImpostosRetidosEntradas.FieldByName('ocasiao').AsString = 'No pagto da duplicata' then
      begin
        if qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').AsInteger <> 0 then
        begin

          case situacao of
            VALIDAR:
            begin
              LocalizarDocumentosPagImpostosRetidosDuplicata;
              if HouveMudancaFatoGeradoreComQuitacao then
                result := MensagemConfirmacao(
                    format('O documento gerado ''%s - %s'' esta inconsistente com os parâmetros do sistema.'+#10#13+
                           'Fato gerador configurado: ''No pagamento da duplicata'''+#10#13+
                           'Fato gerador atual: ''No lançto da NF'''+#10#13+
                           'Sugestão: desquite este pagamento e gere novamente acessando o documento original.',
                           [qryDocumentosPagImpostosRetidos.fieldbyname('numero').asstring,
                            FilialContasEntradas[tipo]])) = smbOK;
            end;

            GRAVAR:
            begin
              {Verifica se não existe pagamento para o tipo específico}
              if LocalizarDocumentosPagImpostosRetidosDuplicata then
                {visto que não há pagamentos,
                 Efetua a exclusao para todos do tipo específico
                 dos documentospagimpostosretidos para serem refeitos}
                ApagarDocumentosPagImpostosRetidosDuplicata;

              if not HouveMudancaFatoGeradoreComQuitacao then
              begin
                valorimpostorateado := CalcularImpostoRateado(ValorImposto, Tipo);
                if posicionarDocumentospagimpostosretidos then
                begin
                  if valorimpostorateado <> 0 then
                  begin
                    if  not ExistePagamento_DuplicatasImpostosRetido then
                    begin
                      qryDocumentosPagImpostosRetidos.Edit;
                      AtribuirDocumentosPag;
                      qryDocumentosPagImpostosRetidos.post;
                      qryDuplicatasImpostosRetidos.Edit;
                      AtribuirDuplicatas;
                      qryDuplicatasImpostosRetidos.Post;
                    end;
                  end
                  else
                    qryDocumentosPagImpostosRetidos.Delete;
                end
                else
                begin
                  if valorimpostorateado <> 0 then
                  begin
                    qryDocumentosPagImpostosRetidos.Append;
                    spcDocumentosPagProximo.Open;
                    qryDocumentosPagImpostosRetidos.FieldByName('numero').AsInteger := spcDocumentosPagProximo.FieldByName('codigo').AsInteger;
                    spcDocumentosPagProximo.Close;
                    AtribuirDocumentosPag;
                    qryDocumentosPagImpostosRetidos.Post;
                    qryDuplicatasImpostosRetidos.Append;
                    AtribuirDuplicatas;
                    qryDuplicatasImpostosRetidos.Post;
                  end;
                end;
              end;
            end;

          end;
        end
        else
        begin
          if valorimposto <> 0  then
          begin
            result := false;
            MensagemErro(format(ctFORNECEDORPADRAONAOVINCULADO,[FilialContasEntradas[tipo]]));
          end;
        end;
      end;
    end
    else
    begin
      if valorimposto <> 0  then
      begin
        result := false;
        MensagemErro(format(ctCONTAPADRAONAOVINCULADA,[FilialContasEntradas[tipo]]));
      end;
    end;
  end;

  function VerificarImpostosRetidosnaNotaFiscal(ValorImposto: Currency; Tipo: TtecLancamentosContasEntradas): boolean;
  var
    HouveMudancaFatoGeradoreComQuitacao: Boolean;
    function LocalizarDocumentosPagImpostosRetidosNota: Boolean;

    begin
       result := true;
       HouveMudancaFatoGeradoreComQuitacao := false;

       {Verificar se houve mudança nos parâmetros do fato gerador:
        de lançamento na nota fiscal p/ pagamento duplicata}

       qryDocumentosPagImpostosRetidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
       begin
         if (qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo]) then
         begin
           if not qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').IsNull then
           begin
             if ExistePagamento_DuplicatasImpostosRetido then
             begin
               HouveMudancaFatoGeradoreComQuitacao := true;
               result := false;
               break;
             end
             else
               Result := true;
           end;
         end;
         qryDocumentosPagImpostosRetidos.Next;
       end;

       if result then
       begin
         qryDocumentosPagImpostosRetidos.First;
         while not qryDocumentosPagImpostosRetidos.Eof do
         begin
           if (qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo]) then
           begin
             if qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').IsNull then
             begin
               if ExistePagamento_DuplicatasImpostosRetido then
               begin
                 result := false;
                 break;
               end
               else
                 result := true;
             end
           end;
           qryDocumentosPagImpostosRetidos.Next;
         end;
       end;

    end;


     procedure ApagarDocumentosPagImpostosRetidosNota;
     begin
       qryDocumentosPagImpostosRetidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
       begin
         if qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo] then
           qryDocumentosPagImpostosRetidos.Delete
         else
           qryDocumentosPagImpostosRetidos.Next;
       end;
     end;

     procedure AtribuirDocumentosPag;
     begin
       qryDocumentosPagImpostosRetidos.FieldByName('fornecedor').AsInteger := qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('tipofornecedor').AsString := qryVenctosImpostosRetidosEntradas.FieldByName('tipofornecedor').AsString;
       qryDocumentosPagImpostosRetidos.FieldByName('creditar').clear;
       if qryContasEntradasFiliais.Locate('Descricao', FilialContasEntradas[tipo],[]) then
         if qryContasEntradasFiliais.FieldByName('contacontabil').AsInteger <> 0 then
            qryDocumentosPagImpostosRetidos.FieldByName('creditar').AsInteger := qryContasEntradasFiliais.FieldByName('contacontabil').AsInteger;

       qryDocumentosPagImpostosRetidos.FieldByName('emissao').AsDateTime := qryDocumentosPag.FieldByName('emissao').AsDateTime;
       qryDocumentosPagImpostosRetidos.FieldByName('datalancto').AsDateTime := qryDocumentosPag.FieldByName('datalancto').AsDateTime;
       qryDocumentosPagImpostosRetidos.FieldByName('evento').Asvariant := qryDocumentosPag.FieldByName('Evento').AsVariant;
       qryDocumentosPagImpostosRetidos.FieldByName('filialemissao').AsInteger := qryDocumentosPag.FieldByName('filialemissao').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('filialcontabil').AsInteger := qryDocumentosPag.FieldByName('filialcontabil').AsInteger;

       qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString := FilialContasEntradas[tipo];
       qryDocumentosPagImpostosRetidos.FieldByName('valor').AsCurrency := valorimpostorateado;
       qryDocumentosPagImpostosRetidos.FieldByName('documentopagorigem').AsInteger := qryDocumentosPag.FieldByName('Numero').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('datavenctoorigem').clear;
       qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').clear;
       qryDocumentosPagImpostosRetidos.FieldByName('complemento').AsString := qryDocumentosPag.FieldByName('complemento').AsString;
       qryDocumentosPagImpostosRetidos.FieldByName('previsao').AsBoolean := false;
       qryDocumentosPagImpostosRetidos.FieldByName('fatogerador').AsString := qryVenctosImpostosRetidosEntradas.FieldByName('ocasiao').AsString;
     end;

