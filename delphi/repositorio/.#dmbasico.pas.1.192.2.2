  function PISCOFINSBaseCalculo(tProdutos : TTecQuery): Real;
  begin
    result := 0.00;
    if tProdutos.FindField('valordescontoitem') <> nil then
      result := ArredondarouTruncar(ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * precounitario(produtos),-2)
                        - tProdutos.FieldByName('valordescontoitem').AsCurrency
                        - tProdutos.FieldByName('desconto').AsCurrency
                        + tProdutos.FieldByName('acrescimo').AsCurrency
                        + tProdutos.FieldByName('frete').AsCurrency
                        + tProdutos.FieldByName('seguro').AsCurrency
                        { + tProdutos.FieldByName('valoripi').AsCurrency }
                       { + tprodutos.FieldByName(CampoICMSValorST).AsCurrency   }
                        + tProdutos.FieldByName('despesasacessorias').AsCurrency ,-2)
{
O ICMS-ST não integra o valor das aquisições de mercadoria para revenda, para fins de cálculo do credito pis e cofins.
IN SRF nº 635/2006 - artigo 23º - § 4º.
Solução de Consulta nº 84 de 23/04/2007
}
    else
      result := ArredondarouTruncar(ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * precounitario(produtos), -2)
                        - tProdutos.FieldByName('desconto').AsCurrency
                        + tProdutos.FieldByName('acrescimo').AsCurrency
                        + tProdutos.FieldByName('frete').AsCurrency
                        + tProdutos.FieldByName('seguro').AsCurrency
                        { + tProdutos.FieldByName('valoripi').AsCurrency}
                       { + tprodutos.FieldByName(CampoICMSValorST).AsCurrency }
                        + tProdutos.FieldByName('despesasacessorias').AsCurrency ,-2);
  end;



