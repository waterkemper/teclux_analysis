  begin
    if ParSistema.PerguntarAntesExibirFicha then
    begin
      if pParcelaAtrasada and pChequeDevolvido then
        vDescricaoMensagem := 'parcelas em atraso e cheque devolvido'
      else
      if pParcelaAtrasada and not pChequeDevolvido then
        vDescricaoMensagem := 'parcelas em atraso'
      else
      if not pParcelaAtrasada and pChequeDevolvido then
        vDescricaoMensagem := 'cheque devolvido';

      if MensagemConfirmacao(format(msg,[NomeCliente, vDescricaoMensagem])) = smbOK then
      begin

        TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([Cliente,
                                                                         TipoCliente, FormOrigem], 'TfrmFichaFinanceira', True);
        FichaExibida := true;
      end;
    end
    else
    begin
      TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([Cliente,
                                                                       TipoCliente,FormOrigem], 'TfrmFichaFinanceira', True);
      FichaExibida := true;
    end;
  end;
begin
  FichaExibida := false;
  qryClienteAtrasado := TtecQuery.Create(nil);
  qryClienteAtrasado.Database := dtmTecSoft.Database;
  qryClienteAtrasado.Sql.Text := VerificarClienteAtrasado;
  ReFazConsulta(qryClienteAtrasado,[0,1], [cliente,tipocliente]);

  if ParSistema.MostrarFichaSomenteAtraso then
  begin
   if  qryClienteAtrasado.Fields[0].AsBoolean or qryClienteAtrasado.Fields[1].AsBoolean then
     if not UsuarioLogin.RestringirFichaCliente then
     begin
        ExibirFicha(ctCLIENTEPOSSUIATRASO, qryClienteAtrasado.Fields[0].AsBoolean, qryClienteAtrasado.Fields[1].AsBoolean);
     end;
  end
  else
  if not UsuarioLogin.RestringirFichaCliente then
  begin
    if qryClienteAtrasado.Fields[0].AsBoolean then
      ExibirFicha(ctCLIENTEPOSSUIATRASO, qryClienteAtrasado.Fields[0].AsBoolean, qryClienteAtrasado.Fields[1].AsBoolean)
    else
      ExibirFicha(ctVISUALIZARFICHAFINANCEIRA, qryClienteAtrasado.Fields[0].AsBoolean, qryClienteAtrasado.Fields[1].AsBoolean);
  end;
  result := FichaExibida;
end;

function TdtmBasico.ClienteCartaDevolvida(Cliente: Integer; TipoCliente, NomeCliente, FormOrigem: String): Boolean;
var
  CadastroAberto: Boolean;
  procedure AbrirConsulta;
  begin
    qryClienteEnderecoDesatualizado := TtecQuery.Create(nil);
    qryClienteEnderecoDesatualizado.Database := dtmTecSoft.Database;
    qryClienteEnderecoDesatualizado.Sql.Text := VerificarClienteCartaDevolvida;
    RefazConsulta(qryClienteEnderecoDesatualizado, [0,1], [Cliente, TipoCliente]);
  end;
begin
  CadastroAberto := false;
  if not assigned(qryClienteEnderecoDesatualizado) then
    AbrirConsulta
  else
   if (qryClienteEnderecoDesatualizado.Fields[0].Asinteger <> cliente) or
      (qryClienteEnderecoDesatualizado.Fields[1].AsString <> tipocliente) then
   begin
    RefazConsulta(qryClienteEnderecoDesatualizado, [0,1], [Cliente, TipoCliente]);
   end;
  if qryClienteEnderecoDesatualizado.Fields[2].AsBoolean then begin
    if FormOrigem = 'TfrmCadastroContratos' then begin
      if MensagemConfirmacao(Format(ctENDERECODESATUALIZADO, [NomeCliente])) = smbOK then
        CadastroAberto := True;
    end
    else if FormOrigem = 'TfrmCadastroClientes' then
      CadastroAberto := True
    else begin
      if MensagemConfirmacao(Format(ctENDERECODESATUALIZADO, [NomeCliente])) = smbOK then begin
        TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([Cliente, TipoCliente, FormOrigem], 'TfrmCadastroClientes', True);
        CadastroAberto := true;
      end;
    end;
  end;
  Result := CadastroAberto;
end;

