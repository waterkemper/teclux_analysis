procedure TdtmBasico.SelecionarDadosNaturezaPadrao(Descricao: String; Natureza, Produtos, Nota: TTecQuery;
                                                   OrigemCalculo : TtecOrigemCalculo = NotaAvulsa);
begin
  if not qryNaturezasPadrao.Active then
    qryNaturezasPadrao.Open;

  if qryNaturezasPadrao.Locate('descricao',descricao,[]) then
  begin

    Produtos.FieldByName('natureza').AsInteger     := qryNaturezasPadrao.FieldByName('natureza').AsInteger;

    if produtos.findfield('gerarpagamento')<>nil then
      Produtos.FieldByName('gerarpagamento').AsBoolean := qryNaturezasPadrao.FieldByName('gerarpagamento').AsBoolean;

    if produtos.findfield('naogerarcreditoicms')<>nil then
      produtos.FieldByName('naogerarcreditoicms').AsBoolean := qryNaturezasPadrao.FieldByName('naogerarcreditoicms').Asboolean;

    if produtos.findfield('naogerarcreditoipi')<>nil then
      produtos.FieldByName('naogerarcreditoipi').AsBoolean := qryNaturezasPadrao.FieldByName('naogerarcreditoipi').Asboolean;

    if produtos.findfield('icmssobreipi')<>nil then
      produtos.FieldByName('icmssobreipi').AsBoolean := qryNaturezasPadrao.FieldByName('icmssobreipi').Asboolean;

    if produtos.findfield('naogerardebitoicms')<>nil then
      produtos.FieldByName('naogerardebitoicms').AsBoolean := qryNaturezasPadrao.FieldByName('naogerardebitoicms').Asboolean;

    if produtos.findfield('naocalcularvaloresicmsdiferimento')<>nil then
      produtos.FieldByName('naocalcularvaloresicmsdiferimento').AsBoolean := qryNaturezasPadrao.FieldByName('naocalcularvaloresicmsdiferimento').Asboolean;

    if produtos.findfield('naogerardebitoipi')<>nil then
      produtos.FieldByName('naogerardebitoipi').AsBoolean := qryNaturezasPadrao.FieldByName('naogerardebitoipi').Asboolean;

    if produtos.findfield('naocalcularipisobrefrete')<>nil then
      produtos.FieldByName('naocalcularipisobrefrete').AsBoolean := qryNaturezasPadrao.FieldByName('naocalcularipisobrefrete').Asboolean;

    if produtos.findfield('destacarIPI')<>nil then
      Produtos.FieldByName('destacarIPI').AsBoolean  := qryNaturezasPadrao.FieldByName('destacaripi').AsBoolean;

    Produtos.FieldByName('operacao').AsString      := qryNaturezasPadrao.FieldByName('operacao').AsString;
    Produtos.FieldByName('tipomovimento').AsString := qryNaturezasPadrao.FieldByName('tipomovimento').AsString;

    case OrigemCalculo of
    NotaAvulsa :
      begin
        Natureza.MacroByName('CodigoNaturezaPadrao').AsString := 'and n.codigo = '+Produtos.FieldByName('natureza').AsString;
        Natureza.ParamByName('codigofiscal').AsInteger := qryNaturezasPadrao.FieldByName('codigofiscal').AsInteger;
        if qryNaturezasPadrao.FieldByName('codigofiscal').AsInteger <> 8000 then
          if not (nota.fieldbyname('estado').asstring = EstadoFilialBase) then
            if HeUnidadeFederacao(nota.fieldbyname('estado').asstring) then
            begin
              if qryNaturezasPadrao.FieldByName('codigofiscal').AsInteger = ctVENDASUBSTITUIDODENTROESTADO then
                Produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao.FieldByName('codigofiscal').AsInteger+999
              else
                Produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao.FieldByName('codigofiscal').AsInteger+1000;
            end
            else
              Produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao.FieldByName('codigofiscal').AsInteger+2000;

        Natureza.ParamByName('codigofiscal').AsInteger := Produtos.FieldByName('codigofiscal').AsInteger;
      end;


    NotaEntrada, NotaEntradaXML :
      begin
        Natureza.MacroByName('CodigoNaturezaPadrao').AsString := 'and naturezas.codigo = '+Produtos.FieldByName('natureza').AsString;
        Natureza.ParamByName('codigofiscal').AsInteger := qryNaturezasPadrao.FieldByName('codigofiscal').AsInteger;

        if HeUnidadeFederacao(nota.fieldbyname('estado').asString) then
        begin
          if nota.fieldbyname('estado').asstring = EstadoFilialBase then
            Produtos.FieldByName('codigofiscal').AsInteger := 1000 + qryNaturezasPadrao.FieldByName('codigofiscal').AsInteger mod 1000
          else
            Produtos.FieldByName('codigofiscal').AsInteger := 2000 + qryNaturezasPadrao.FieldByName('codigofiscal').AsInteger mod 1000;
        end
        else
          Produtos.FieldByName('codigofiscal').AsInteger := 3000 + qryNaturezasPadrao.FieldByName('codigofiscal').AsInteger mod 1000;

        if (produtos.findfield('descricaocodigofiscal')<>nil) then
          Produtos.FieldByName('descricaocodigofiscal').AsString    := qryNaturezasPadrao.FieldByName('descricaocodigofiscal').AsString;

        if (produtos.findfield('descricaonatureza')<>nil) then
          Produtos.FieldByName('descricaonatureza').AsString    := qryNaturezasPadrao.FieldByName('descricaonatureza').AsString;

        Natureza.ParamByName('codigofiscal').AsInteger := Produtos.FieldByName('codigofiscal').AsInteger;
      end;
    end;

    Natureza.close;
    Natureza.Open;
    Natureza.MacroByName('CodigoNaturezaPadrao').AsString := '';

    if natureza.IsEmpty then
      MensagemErro('CÓDIGO FISCAL VINCULADO A NATUREZA NÃO ENCONTRADO');

  end
  else
    MensagemErro('NATUREZA PADRÃO NÃO ENCONTRADA');
end;


function TdtmBasico.AtribuirDadosCalculosImpostos(qryNotaFiscal, qryProcuraProdutoNotaFiscal, qryProcuraNaturezasProduto: TtecQuery; var qryProdutosNotaFiscal: TTecQuery; OrigemCalculo : TtecOrigemCalculo; ReverNatureza: boolean): Boolean;

  function PossuiNDI: boolean;
  begin
    result := false;
    if qryNotaFiscal.FindField('ndi')<>nil then
      result := not qryNotaFiscal.fieldbyname('ndi').IsNull;
  end;

begin
  case OrigemCalculo of
    NotaEntrada, NotaEntradaXML :
    begin
      if ReverNatureza then
      begin
        if (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 202) //Devolução
           and NotaSubstituicao(ifthen(regimetributario=1,qryProcuraProdutoNotaFiscal.fieldbyname('csosn').AsString,qryProcuraProdutoNotaFiscal.fieldbyname('incidencia').AsString)) then
          SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIASUBSTTRIB, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 101) //Compra para industrialização
           and NotaSubstituicao(ifthen(regimetributario=1,qryProcuraProdutoNotaFiscal.fieldbyname('csosn').AsString,qryProcuraProdutoNotaFiscal.fieldbyname('incidencia').AsString)) then
          SelecionarDadosNaturezaPadrao(noCOMPRAINDSUBSTTRIBUT, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 102) //Compra para comercialização
           and NotaSubstituicao(ifthen(regimetributario=1,qryProcuraProdutoNotaFiscal.fieldbyname('csosn').AsString,qryProcuraProdutoNotaFiscal.fieldbyname('incidencia').AsString)) then
          SelecionarDadosNaturezaPadrao(noCOMPRACOMERCSUBSTTRIBUT, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
          SelecionarDadosNatureza(qryProcuraNaturezasProduto, qryProdutosNotaFiscal, OrigemCalculo);
      end
      else
        SelecionarDadosNatureza(qryProcuraNaturezasProduto, qryProdutosNotaFiscal, OrigemCalculo);

      // obedecer primeiro a natureza da nota se:
      if PossuiNDI then
      begin
        qryProdutosNotaFiscal.FieldbyName('incidencia').AsString := '00';
        qryProdutosNotaFiscal.FieldbyName('csosn').AsString := '900';
      end
      else
      if ((regimetributario=1) and (qryProcuraNaturezasProduto.fieldbyname('csosn').AsString <> '')) or     //eh do simples e tem csosn na natureza do produto
         ((regimetributario<>1) and (qryProcuraNaturezasProduto.fieldbyname('icmscst').AsString <> '')) then   // não eh do simples e tem cst na natureza do produto
      begin
        qryProdutosNotaFiscal.FieldbyName('incidencia').AsString := qryProcuraNaturezasProduto.fieldbyname('icmscst').AsString;
        qryProdutosNotaFiscal.FieldbyName('csosn').AsString := qryProcuraNaturezasProduto.fieldbyname('csosn').AsString;
      end
      else
      // senão obedecer o cadastro do produto se:
      if ((regimetributario=1) and (qryProcuraProdutoNotaFiscal.fieldbyname('csosn').AsString <> '')) or   //eh do simples e tem csosn no cadastro do produto
         ((regimetributario<>1) and (qryProcuraProdutoNotaFiscal.fieldbyname('incidencia').AsString <> '')) then // não eh do simples e tem cst no cadastro do produto
      begin
        qryProdutosNotaFiscal.FieldbyName('incidencia').AsString := qryProcuraProdutoNotaFiscal.fieldbyname('incidencia').AsString;
        qryProdutosNotaFiscal.FieldbyName('csosn').AsString      := qryProcuraProdutoNotaFiscal.fieldbyname('csosn').AsString;
      end;

      if qryProcuraNaturezasProduto.FieldByName('ipicst').AsString <> '' then  // VALOR NA NATUREZA DEFINIDA
        qryProdutosNotaFiscal.FieldByName('ipicst').AsString    := qryProcuraNaturezasProduto.FieldByName('ipicst').AsString
      else
      if qryProcuraProdutoNotaFiscal.FieldByName('ipicst').AsString <> '' then  // VALOR DO IPICST NO CADASTRO DO PRODUTO
        qryProdutosNotaFiscal.FieldByName('ipicst').AsString := qryProcuraProdutoNotaFiscal.FieldByName('ipicst').AsString;

      if qryProcuraNaturezasProduto.FieldByName('piscst').AsString <> '' then  // VALOR NA NATUREZA DEFINIDA
        qryProdutosNotaFiscal.FieldByName('piscst').AsString    := qryProcuraNaturezasProduto.FieldByName('piscst').AsString
      else
      if qryProcuraProdutoNotaFiscal.FieldByName('piscst').AsString <> '' then  // VALOR DO PISCST NO CADASTRO DO PRODUTO
        qryProdutosNotaFiscal.FieldByName('piscst').AsString := qryProcuraProdutoNotaFiscal.FieldByName('piscst').AsString;

      if qryProcuraNaturezasProduto.FieldByName('cofinscst').AsString <> '' then  // VALOR NA NATUREZA DEFINIDA
        qryProdutosNotaFiscal.FieldByName('cofinscst').AsString    := qryProcuraNaturezasProduto.FieldByName('cofinscst').AsString
      else
      if qryProcuraProdutoNotaFiscal.FieldByName('cofinscst').AsString <> '' then  // VALOR DO IPICST NO CADASTRO DO PRODUTO
        qryProdutosNotaFiscal.FieldByName('cofinscst').AsString := qryProcuraProdutoNotaFiscal.FieldByName('cofinscst').AsString;
    end;
  end;

end;


function TdtmBasico.AtribuirDadosProdutos(var Produtos: TtecQuery;
  Notas, CodigoFiscalProduto: TtecQuery; IPISuspenso:Boolean = false;
  OrigemCalculo : TtecOrigemCalculo = NotaAvulsa): Boolean;

const
  msgErroicms_faltante = 'O produto ''%s'' na incidência/csosn do imcs ''%s'' não possui informação no campo ''%s''.';
  msgErroincidencia_faltante = 'O produto ''%s'' não possui informação no campo ''%s''.'+#10#13+
                               'Favor Definir o valor no CADASTRO DE PRODUTOS ou no CADASTRO DE NATUREZAS';

  procedure EditarProdutos;
  begin
    if not (produtos.state in [dsinsert, dsedit]) then
      produtos.Edit;
  end;

  function Condicaorequernfentrada: boolean;
  begin
   result := false;
   if OrigemCalculo = NotaAvulsa then
    result := ((Notas.FindField('requernfentrada')<>nil) and
               (notas.fieldbyname('requernfentrada').AsBoolean));
  end;

  function CondicaoRequerNFSaida: boolean;
  begin
   result := false;
   if OrigemCalculo = NotaEntrada then
    result := ((Notas.FindField('requernfsaida')<>nil) and
               (notas.fieldbyname('requernfsaida').AsBoolean)) or
               
               ((produtos.fieldbyname('dadofiscal').asinteger <> 0) and
                (produtos.fieldbyname('numeroprodutotabela').asinteger <> 0))

  end;

  function CondicaoPedido: boolean;
  begin
   result := false;
   if (OrigemCalculo in [NotaEntrada, NotaEntradaxml]) then
    result := ((Produtos.FindField('pedido')<>nil) and
               ((Produtos.fieldbyname('pedido').AsInteger)<>0));
  end;

  function Saida: Boolean;
  begin
    result := (OrigemCalculo <> NotaEntrada) and (OrigemCalculo <> NotaEntradaXML);
  end;

  function PossuiNDI: boolean;
  begin
    result := false;
    if notas.FindField('ndi')<>nil then
      result := not notas.fieldbyname('ndi').IsNull;
  end;


begin
  result := true;
  {ATRIBUIR DADOS NOS PRODUTOS DA NOTA FISCAL}
  if ((produtos.findfield('produto') <> nil) and (produtos.fieldbyname('produto').Asinteger <> 0)) then
  begin
    if CondicaoRequerNFEntrada then
    begin
       qryDadosProdutos.Sql.text := SQLDadosProdutosNotasEntradas;
       qryDadosProdutos.ParamByName('FilialBase').AsInteger := FilialBase;
       qryDadosProdutos.ParamByName('codigo').AsString := produtos.fieldbyname('produto').asstring;
       qryDadosProdutos.ParamByName('codigonota').AsString := produtos.fieldbyname('codigonota').asstring;
       qryDadosProdutos.ParamByName('dadofiscal').asinteger := Notas.fieldbyName('numero').asinteger;
       qryDadosProdutos.ParamByName('NumeroProduto').asinteger := produtos.fieldbyName('numeroprodutotabela').asinteger;
       qryDadosProdutos.ParamByName('EstadoFilialBaseCalculoPreco').AsString := EstadoFilialBase;
    end
    else
    if CondicaoRequerNFSaida then
    begin
      qryDadosProdutos.Sql.text := SQLDadosProdutosNotasSaidas;
      qryDadosProdutos.ParamByName('FilialBase').AsInteger := FilialBase;
      qryDadosProdutos.ParamByName('codigo').AsString := produtos.fieldbyname('produto').asstring;
      qryDadosProdutos.ParamByName('dadofiscal').asinteger := produtos.fieldbyName('dadofiscal').asinteger;
      qryDadosProdutos.ParamByName('NumeroProduto').asinteger := produtos.fieldbyName('numeroprodutotabela').asinteger;

      qryDadosProdutos.ParamByName('EstadoFilialBaseCalculoPreco').AsString := EstadoFilialBase;
    end
    else
    if CondicaoPedido then
    begin
       qryDadosProdutos.Sql.text := SQLDadosProdutosPedidos;
       qryDadosProdutos.ParamByName('FilialBase').AsInteger := FilialBase;
       qryDadosProdutos.ParamByName('codigo').AsString := produtos.fieldbyname('produto').asstring;
       qryDadosProdutos.ParamByName('pedido').asinteger := produtos.fieldbyName('pedido').asinteger;
       qryDadosProdutos.ParamByName('EstadoFilialBaseCalculoPreco').AsString := EstadoFilialBase;
    end
    else
    begin
      qryDadosProdutos.Sql.Text    := SQLDadosProdutos;
      qryDadosProdutos.ParamByName('EstadoFilialBase').AsString := ifthen(Saida,EstadoFilialBase, notas.fieldbyname('estado').asstring);
      qryDadosProdutos.ParamByName('EstadoFilialBaseCalculoPreco').AsString := EstadoFilialBase;
      qryDadosProdutos.ParamByName('Estadocfo').AsString  := ifthen(Saida,notas.fieldbyname('estado').asstring,EstadoFilialBase);

      if notas.findfield('pessoatipo')<>nil then
        qryDadosProdutos.ParamByName('TipoPessoa').AsString  := notas.fieldbyname('pessoatipo').asstring
      else
        qryDadosProdutos.ParamByName('TipoPessoa').AsString  := 'J';

      qryDadosProdutos.ParamByName('FilialBase').AsInteger := FilialBase;
      qryDadosProdutos.ParamByName('codigo').AsString := produtos.fieldbyname('produto').asstring;
    end;

    qryDadosProdutos.close;
    qryDadosProdutos.Open;

    if qryDadosProdutos.RecordCount = 1 then
    begin
      EditarProdutos;

      if CondicaoRequerNFEntrada then
      begin
        if (produtos.findfield('codigonotaoriginal') <> nil) and
           (produtos.findfield('numeroprodutooriginal') <> nil) and
           (produtos.findfield('produtooriginal') <> nil) then
        begin
          if qrydadosprodutos.FieldByName('codigonotaoriginal').AsInteger <> 0 then
          begin
            produtos.fieldbyname('codigonotaoriginal').Asinteger := qrydadosprodutos.FieldByName('codigonotaoriginal').AsInteger;
            produtos.fieldbyname('numeroprodutooriginal').Asinteger := qrydadosprodutos.FieldByName('numeroprodutooriginal').AsInteger;
            produtos.fieldbyname('produtooriginal').AsString := qrydadosprodutos.FieldByName('produtooriginal').AsString;
          end
          else
          begin
            produtos.fieldbyname('codigonotaoriginal').Asinteger := qrydadosprodutos.FieldByName('codigonota').AsInteger;
            produtos.fieldbyname('numeroprodutooriginal').Asinteger := qrydadosprodutos.FieldByName('numeroproduto').AsInteger;
            produtos.fieldbyname('produtooriginal').AsString := qrydadosprodutos.FieldByName('produto').AsString;
          end;
        end;
      end;


      if CondicaoRequerNFSaida then
      begin
        if (produtos.findfield('codigonotaoriginal') <> nil) and
           (produtos.findfield('numeroprodutooriginal') <> nil) and
           (produtos.findfield('produtooriginal') <> nil) then
        begin
          if qrydadosprodutos.FieldByName('codigonotaoriginal').AsInteger <> 0 then
          begin
            produtos.fieldbyname('codigonotaoriginal').Asinteger := qrydadosprodutos.FieldByName('codigonotaoriginal').AsInteger;
            produtos.fieldbyname('numeroprodutooriginal').Asinteger := qrydadosprodutos.FieldByName('numeroprodutooriginal').AsInteger;
            produtos.fieldbyname('produtooriginal').AsString := qrydadosprodutos.FieldByName('produtooriginal').AsString;
          end
          else
          begin
            produtos.fieldbyname('codigonotaoriginal').clear;
            produtos.fieldbyname('numeroprodutooriginal').clear;
            produtos.fieldbyname('produtooriginal').clear;
          end;
        end;
      end;


      if produtos.findfield('peso') <> nil then
        produtos.fieldbyname('peso').AsFloat   := qryDadosProdutos.fieldbyname('peso'     ).AsFloat;

      if produtos.findfield('volumes') <> nil then
        produtos.fieldbyname('volumes').Ascurrency   := qryDadosProdutos.fieldbyname('volumes'     ).AsCurrency;

      if produtos.findfield('cst_produto') <> nil then
        produtos.fieldbyname('cst_produto').AsString   := qryDadosProdutos.fieldbyname('cst_produto'     ).AsString;

      if CondicaoRequerNFSaida then
      begin
        produtos.FieldByName('cst_nf').asstring := qrydadosprodutos.fieldbyname('cst_notasaida').AsString;
        produtos.FieldByName('csosn_nf').asstring := qrydadosprodutos.fieldbyname('csosn_notasaida').AsString;
      end;

      if produtos.findfield('csosn_produto') <> nil then
        produtos.fieldbyname('csosn_produto').AsString   := qryDadosProdutos.fieldbyname('csosn_produto'     ).AsString;

      if produtos.findfield('descricaoproduto') <> nil then
        produtos.fieldbyname('descricaoproduto').AsString   := qryDadosProdutos.fieldbyname('descricaoproduto'     ).AsString;

      if produtos.findfield('caracteristica') <> nil then
        produtos.fieldbyname('caracteristica').AsString   := qryDadosProdutos.fieldbyname('caracteristica'     ).AsString;

      if produtos.findfield('referencia') <> nil then
        produtos.fieldbyname('referencia').AsString   := qryDadosProdutos.fieldbyname('referencia'     ).AsString;

      if produtos.findfield('naoreplicar') <> nil then
        produtos.fieldbyname('naoreplicar').AsString   := qryDadosProdutos.fieldbyname('naoreplicar'     ).AsString;

      if produtos.findfield('descricaocaracteristica') <> nil then
        produtos.fieldbyname('descricaocaracteristica').AsString   := qryDadosProdutos.fieldbyname('descricaocaracteristica'     ).AsString;

      if produtos.findfield('aliquotaicmscalculopreco') <> nil then
        produtos.fieldbyname('aliquotaicmscalculopreco').AsCurrency   := qryDadosProdutos.fieldbyname('aliquotaicmscalculopreco'     ).Ascurrency;

      if produtos.findfield('preco') <> nil then
        produtos.fieldbyname('preco').Asinteger   := qryDadosProdutos.fieldbyname('codigopreco').AsInteger;

      if produtos.findfield('descricaoprecoproduto') <> nil then
        produtos.fieldbyname('descricaoprecoproduto').AsString   := qryDadosProdutos.fieldbyname('descricaoprecoproduto'     ).AsString;

      if produtos.findfield('caracteristicavisual') <> nil then
        produtos.fieldbyname('caracteristicavisual').AsString   := qryDadosProdutos.fieldbyname('caracteristicavisual'     ).AsString;

      if produtos.findfield('markup_produto') <> nil then
        produtos.fieldbyname('markup_produto').Ascurrency   := qryDadosProdutos.fieldbyname('markup_produto').AsCurrency;

      if produtos.findfield('markup_grupo') <> nil then
        produtos.fieldbyname('markup_grupo').Ascurrency   := qryDadosProdutos.fieldbyname('markup_grupo').AsCurrency;

      if produtos.findfield('calcularpreco') <> nil then
        produtos.fieldbyname('calcularpreco').AsBoolean   := qryDadosProdutos.fieldbyname('calcularpreco').AsBoolean;

      if produtos.findfield('grupo') <> nil then
        produtos.fieldbyname('grupo').AsString   := qryDadosProdutos.fieldbyname('grupo'     ).AsString;

      if produtos.findfield('classe') <> nil then
        produtos.fieldbyname('classe').AsString   := qryDadosProdutos.fieldbyname('classe'     ).AsString;

      if produtos.findfield('descricaonanf') <> nil then
        produtos.fieldbyname('descricaonanf'   ).AsString   := qryDadosProdutos.fieldbyname('descricaonanf'  ).AsString;

      if produtos.findfield('produtovisual') <> nil then
        produtos.fieldbyname('produtovisual'   ).AsString   := qryDadosProdutos.fieldbyname('codigovisual'  ).AsString;

      if produtos.findfield('codigovisual') <> nil then
        produtos.fieldbyname('codigovisual'   ).AsString   := qryDadosProdutos.fieldbyname('codigovisual'  ).AsString;

      if produtos.findfield('linha') <> nil  then
        produtos.fieldbyname('linha'           ).AsString   := qryDadosProdutos.fieldbyname('linha'         ).AsString;

      if produtos.findfield('coluna') <> nil  then
        produtos.fieldbyname('coluna'          ).AsString   := qryDadosProdutos.fieldbyname('coluna'        ).AsString;

      if produtos.findfield('valorgrade1') <> nil  then
        produtos.fieldbyname('valorgrade1'     ).AsString   := qryDadosProdutos.fieldbyname('valorgrade1'   ).AsString;

      if produtos.findfield('valorgrade2') <> nil  then
        produtos.fieldbyname('valorgrade2'     ).AsString   := qryDadosProdutos.fieldbyname('valorgrade2'   ).AsString;

      if produtos.findfield('grade1') <> nil  then
        produtos.fieldbyname('grade1'     ).AsString   := qryDadosProdutos.fieldbyname('grade1'   ).AsString;

      if produtos.findfield('grade2') <> nil  then
        produtos.fieldbyname('grade2'     ).AsString   := qryDadosProdutos.fieldbyname('grade2'   ).AsString;

      if produtos.findfield('codigo_efd_t53') <> nil  then
      begin
        if (trim(qryDadosProdutos.fieldbyname('codigo_efd_t53').AsString)<>'') and not assigned(ecfpadrao) then
          produtos.fieldbyname('codigo_efd_t53'     ).AsString   := qryDadosProdutos.fieldbyname('codigo_efd_t53').AsString
        else
          produtos.fieldbyname('codigo_efd_t53'     ).clear;
      end;

      if produtos.findfield('unidade') <> nil then
        produtos.fieldbyname('unidade'         ).AsString   := qryDadosProdutos.fieldbyname('unidade'       ).AsString;

      if produtos.findfield('unidadenf') <> nil then
        produtos.fieldbyname('unidadenf'         ).AsString   := qryDadosProdutos.fieldbyname('unidade'       ).AsString;

      if produtos.findfield('descricaounidade') <> nil then
        produtos.fieldbyname('descricaounidade'         ).AsString   := qryDadosProdutos.fieldbyname('descricaounidade'       ).AsString;

      if produtos.findfield('tribunidade') <> nil then
        produtos.fieldbyname('tribunidade'     ).AsString   := qryDadosProdutos.fieldbyname('unidade'       ).AsString;


      if produtos.findfield('pn') <> nil then
        produtos.fieldbyname('pn').AsString   := qryDadosProdutos.fieldbyname('codigo'        ).AsString;

      if produtos.findfield('genero') <> nil then
        produtos.fieldbyname('genero'          ).AsString   := qryDadosProdutos.fieldbyname('genero'        ).AsString;

      if produtos.findfield('extipi') <> nil then
        produtos.fieldbyname('extipi'          ).AsString   := qryDadosProdutos.fieldbyname('extipi'        ).AsString;

      if produtos.findfield('icmsmodalidade') <> nil then
        produtos.fieldbyname('icmsmodalidade'  ).AsString   := qryDadosProdutos.fieldbyname('icmsmodalidade').AsString;

      if produtos.findfield('icmsmodsubst') <> nil then
        produtos.fieldbyname('icmsmodsubst'    ).AsString   := qryDadosProdutos.fieldbyname('icmsmodsubst'  ).AsString;

      if produtos.findfield('pisaliquota') <> nil then
      begin
        if qryDadosProdutos.fieldbyname('aliquotapis').AsCurrency<>0 then
          produtos.fieldbyname('pisaliquota').AsCurrency := qryDadosProdutos.fieldbyname('aliquotapis').AsCurrency
        else
          produtos.fieldbyname('pisaliquota').clear;
      end;

      if produtos.findfield('cofinsaliquota') <> nil then
      begin
        if qryDadosProdutos.fieldbyname('aliquotacofins').AsCurrency<>0 then
          produtos.fieldbyname('cofinsaliquota').AsCurrency := qryDadosProdutos.fieldbyname('aliquotacofins').AsCurrency
        else
          produtos.fieldbyname('cofinsaliquota').clear;
      end;

      if produtos.findfield('localizacao') <> nil then
        produtos.fieldbyname('localizacao'     ).AsString   := qryDadosProdutos.fieldbyname('localizacao'   ).AsString;

      if produtos.findfield('aliquotaicms') <> nil then
      begin
        if qryDadosProdutos.fieldbyname('aliquotaicms').AsCurrency<>0 then
          produtos.fieldbyname('aliquotaicms').AsCurrency := qryDadosProdutos.fieldbyname('aliquotaicms'  ).AsCurrency
        else
          if not assigned(ecfPadrao) then
            produtos.fieldbyname('aliquotaicms').clear;
      end;

      if produtos.findfield('tipopreco')<>nil then
      begin
        if produtos.findfield('precovenda')<>nil then
        begin
          case produtos.fieldbyname('tipopreco').AsInteger of
            0{tpnVENDA}       : produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos.fieldbyname('precounitario').AsFloat;
            1{tpnCUSTOMEDIO}  : produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos.fieldbyname('customedio').AsFloat;
            2{tpnULTIMACOMPRA}: produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos.fieldbyname('valorultimacompra').AsFloat;
          end
        end;
      end
      else
        if (produtos.findfield('precounitario')<>nil) and (OrigemCalculo <> NotaEntradaXML) then
//          produtos.fieldbyname('precounitario').AsFloat := truncar(qryDadosProdutos.fieldbyname('precounitario').AsFloat, parsistema.PrecoUnitarioCasasDecimais);
          produtos.fieldbyname('precounitario').AsFloat := roundto(qryDadosProdutos.fieldbyname('precounitario').AsFloat, -abs(parsistema.PrecoUnitarioCasasDecimais));

      if produtos.findfield('precovenda')<>nil then
        //produtos.fieldbyname('precovenda').AsFloat := truncar(produtos.fieldbyname('precovenda').AsFloat, parsistema.PrecoUnitarioCasasDecimais);
        produtos.fieldbyname('precovenda').AsFloat :=  roundto(produtos.fieldbyname('precovenda').AsFloat, -abs(parsistema.PrecoUnitarioCasasDecimais));

      if produtos.findfield('precotabela')<>nil then
        produtos.fieldbyname('precotabela').AsCurrency  := produtos.fieldbyname('precovenda').AsCurrency;

      if Not qryDadosProdutos.fieldbyname('icms').IsNull then
        if produtos.FindField('icms') <> nil then
          produtos.fieldbyname('icms').AsInteger   := qryDadosProdutos.fieldbyname('icms').AsInteger;

      if produtos.FindField('percentualreducaobase') <> nil then
      begin
        if qryDadosProdutos.fieldbyname('percreducaobase').AsCurrency<>0 then
          produtos.fieldbyname('percentualreducaobase').AsCurrency := qryDadosProdutos.fieldbyname('percreducaobase').AsCurrency
        else
          produtos.fieldbyname('percentualreducaobase').clear;
      end;

      if produtos.FindField('percentualreducaobase_custo') <> nil then
      begin
        if qryDadosProdutos.fieldbyname('percreducaobase').AsCurrency<>0 then
          produtos.fieldbyname('percentualreducaobase_custo').AsCurrency := qryDadosProdutos.fieldbyname('percreducaobase').AsCurrency
        else
          produtos.fieldbyname('percentualreducaobase_custo').clear;
      end;

      if produtos.FindField('predbcst') <> nil then
      begin
        if qryDadosProdutos.fieldbyname('predbcst').AsCurrency<>0 then
          produtos.fieldbyname('predbcst').AsCurrency := qryDadosProdutos.fieldbyname('predbcst').AsCurrency
        else
          produtos.fieldbyname('predbcst').clear;
      end;

      if produtos.FindField('predbcst_custo') <> nil then
      begin
        if qryDadosProdutos.fieldbyname('predbcst').AsCurrency<>0 then
          produtos.fieldbyname('predbcst_custo').AsCurrency := qryDadosProdutos.fieldbyname('predbcst').AsCurrency
        else
          produtos.fieldbyname('predbcst_custo').clear;
      end;

      if produtos.FindField('aliquotaipi') <> nil then
      begin
        if (qryDadosProdutos.fieldbyname('aliquotaipi').AsFloat<>0) and
           (contribIPI or  CondicaoRequerNFEntrada or CondicaoPedido) then
          produtos.fieldbyname('aliquotaipi').AsFloat  := qryDadosProdutos.fieldbyname('aliquotaipi').AsFloat
        else
          produtos.fieldbyname('aliquotaipi').clear;
      end;

      if qryDadosProdutos.fieldbyname('ipi').AsInteger<>0 then
        if produtos.findfield('ipi')<>nil then
          produtos.fieldbyname('ipi').AsInteger := qryDadosProdutos.fieldbyname('ipi').AsInteger;

      if (produtos.findfield('aliqnacional')<>nil) and
         (qryDadosProdutos.findfield('aliqnacional')<>nil) then
          produtos.fieldbyname('aliqnacional').AsCurrency := qryDadosProdutos.fieldbyname('aliqnacional').AsCurrency;

      if (produtos.findfield('aliqimportado')<>nil) and
         (qryDadosProdutos.findfield('aliqimportado')<>nil) then
          produtos.fieldbyname('aliqimportado').AsCurrency := qryDadosProdutos.fieldbyname('aliqimportado').AsCurrency;

      if (qryDadosProdutos.fieldbyname('classificacaofiscal').AsString='') then
      begin
        if ParSistema.EmissorNfe and not Assigned(ECFPadrao) then
        begin
          if produtos.findfield('classificacaofiscal')<>nil then
            produtos.fieldbyname('classificacaofiscal').clear;

          if produtos.findfield('ncmempresa')<>nil then
            produtos.fieldbyname('ncmempresa').clear;

          if OrigemCalculo <> NotaEntradaXML then
            MensagemErro('Este item não possui o codigo do NCM, verifique no cadastro de produtos');

          result := false;
        end
      end
      else
      begin
        if produtos.findfield('classificacaofiscal')<>nil then
          produtos.fieldbyname('classificacaofiscal').AsString := qryDadosProdutos.fieldbyname('classificacaofiscal').AsString;

        if produtos.findfield('ncmempresa')<>nil then
          produtos.fieldbyname('ncmempresa').AsString := qryDadosProdutos.fieldbyname('classificacaofiscal').AsString;
      end;


      //TIRADO DA CONDICAO, ORIGEM - NOTAAVULSA, NAO ESTAVA ATRIBUINDO PARA NOTAS DE DEVOLUCAO A FORNCEDOR
      if not (OrigemCalculo in [Devolucao, Troca]) then
      begin

        if produtos.findfield('csosn')<>nil then
        begin
          if PossuiNDI then
             Produtos.FieldByName('csosn').AsString := '900'
          else
          if (codigofiscalproduto<>nil) and (CodigoFiscalProduto.FieldByName('csosn').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
            Produtos.FieldByName('csosn').AsString := CodigoFiscalProduto.FieldByName('csosn').AsString
          else
          if (qryDadosProdutos.FieldByName('csosn').AsString <> '') and
             (Produtos.FieldByName('csosn').AsString = '') then  // VALOR DA INCIDENCIA NO CADASTRO DO PRODUTO
            Produtos.FieldByName('csosn').AsString := qryDadosProdutos.FieldByName('csosn').AsString;
        end;

        if produtos.findfield('incidencia')<>nil then
        begin
          if PossuiNDI then
             Produtos.FieldByName('incidencia').AsString := '00'
          else
          if (codigofiscalproduto<>nil) and (CodigoFiscalProduto.FieldByName('icmscst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
            Produtos.FieldByName('incidencia').AsString := CodigoFiscalProduto.FieldByName('icmscst').AsString
          else
          if (qryDadosProdutos.FieldByName('incidencia').AsString <> '') and
             (Produtos.FieldByName('incidencia').AsString='') then  // VALOR DA INCIDENCIA NO CADASTRO DO PRODUTO
            Produtos.FieldByName('incidencia').AsString := qryDadosProdutos.FieldByName('incidencia').AsString;
        end;

        if produtos.findfield('ipicst')<>nil then
        begin
          if ipisuspenso and (ContribIPI or  ((codigofiscalproduto<>nil) and (CodigoFiscalProduto.fieldbyname('destacaripi').AsBoolean))) then
            Produtos.fieldbyname('ipicst').AsString := '55'
          else
          begin
            if (codigofiscalproduto<>nil) and (CodigoFiscalProduto.FieldByName('ipicst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
              Produtos.FieldByName('ipicst').AsString    := CodigoFiscalProduto.FieldByName('ipicst').AsString
            else
            if (qryDadosProdutos.FieldByName('ipicst').AsString <> '') and
               (Produtos.FieldByName('ipicst').AsString = '')  then  // VALOR DO IPICST NO CADASTRO DO PRODUTO
              Produtos.FieldByName('ipicst').AsString := qryDadosProdutos.FieldByName('ipicst').AsString;
          end;
        end;

        if produtos.findfield('piscst')<>nil then
        begin
          if (codigofiscalproduto<>nil) and (CodigoFiscalProduto.FieldByName('piscst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
            Produtos.FieldByName('piscst').AsString    := CodigoFiscalProduto.FieldByName('piscst').AsString
          else
          if (qryDadosProdutos.FieldByName('piscst').AsString <> '') and
             (Produtos.FieldByName('piscst').AsString = '') then  // VALOR DO PISCST NO CADASTRO DO PRODUTO
            Produtos.FieldByName('piscst').AsString := qryDadosProdutos.FieldByName('piscst').AsString;
        end;

        if produtos.findfield('cofinscst')<>nil then
        begin
          if (codigofiscalproduto<>nil) and (CodigoFiscalProduto.FieldByName('cofinscst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
            Produtos.FieldByName('cofinscst').AsString    := CodigoFiscalProduto.FieldByName('cofinscst').AsString
          else
          if (qryDadosProdutos.FieldByName('cofinscst').AsString <> '') and
             (Produtos.FieldByName('cofinscst').AsString = '') then  // VALOR DO IPICST NO CADASTRO DO PRODUTO
            Produtos.FieldByName('cofinscst').AsString := qryDadosProdutos.FieldByName('cofinscst').AsString;
        end;

      end;

      if produtos.findfield('origem')<>nil then
      begin
        if PossuiNDI then
          Produtos.FieldByName('origem').AsInteger     := 1
        else
          Produtos.FieldByName('origem').AsInteger     := qryDadosProdutos.FieldByName('origem').AsInteger;
      end;

      if Produtos.Findfield('composto')<>nil then
        Produtos.FieldByName('composto').AsBoolean   := qryDadosProdutos.FieldByName('composto').AsBoolean;

      if CondicaoRequerNFEntrada then
      begin
        Produtos.fieldbyname('quantidade').AsFloat := qryDadosProdutos.fieldbyname('quantidade').AsFloat;
        produtos.fieldbyname('quantidadenotaentrada').AsCurrency := qryDadosProdutos.fieldbyname('quantidade').AsFloat;
      end
	    else
	    if CondicaoPedido or CondicaoRequerNFSaida then
      begin
        if OrigemCalculo <> NotaEntradaXML then
          Produtos.fieldbyname('quantidade').AsFloat := qryDadosProdutos.fieldbyname('quantidade').AsFloat;
      end;

      if produtos.findfield('baseicms')<>nil then
        Produtos.FieldByName('baseicms').AsCurrency  := qryDadosProdutos.FieldByName('baseicms').AsCurrency;


      if RegimeTributario=1 then // SIMPLES
      begin
        if (produtos.findfield('csosn')<>nil) and (produtos.findfield('produto')<>nil) then
        begin
          if produtos.fieldbyname('csosn').isnull then
          begin
            if (notas.findfield('codigofiscal')<>nil) and
               (notas.FieldByName('codigofiscal').AsInteger<>0) then
            begin
              result := false;
              MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname('produto').asstring,
                            'ICMS CSOSN - Tributação no simples nacional']));
            end;
          end;
        end;
      end
      else
      begin
        if (produtos.findfield('incidencia')<>nil) and (produtos.findfield('produto')<>nil) then
        begin
          if produtos.FieldByName('incidencia').isnull then
          begin
            if (notas.findfield('codigofiscal')<>nil) and
               (notas.FieldByName('codigofiscal').AsInteger<>0) then
            begin
              result := false;
              MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname('produto').asstring,
                                'ICMS CST - Tributação do icms ']));
            end;                    
          end;
        end;
      end;


      if contribipi and
         (produtos.findfield('ipicst')<>nil) and
         (produtos.findfield('produto')<>nil) and
         produtos.FieldByName('ipicst').isnull then
      begin
        if (notas.findfield('codigofiscal')<>nil) and
           (notas.FieldByName('codigofiscal').AsInteger<>0) then
        begin
          result := false;
          MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname('produto').asstring,
                        'IPI CST - Tributação do IPI']));
        end
      end
      else
      if (produtos.findfield('piscst')<>nil) and
         (produtos.findfield('produto')<>nil) and
         produtos.FieldByName('piscst').isnull then
      begin
        if not Assigned(ECFPadrao) then
        begin
          if (notas.findfield('codigofiscal')<>nil) and
             (notas.FieldByName('codigofiscal').AsInteger<>0) then
          begin
            result := false;
            MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname('produto').asstring,
                          'PIS CST - Tributação do PIS']));
          end;                
        end;
      end
      else
      if (produtos.findfield('cofinscst')<>nil) and
         (produtos.findfield('produto')<>nil) and
         produtos.FieldByName('cofinscst').isnull then
      begin
        if not Assigned(ECFPadrao) then
        begin
          if (notas.findfield('codigofiscal')<>nil) and
             (notas.FieldByName('codigofiscal').AsInteger<>0) then
          begin
            result := false;
            MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname('produto').asstring,
                          'COFINS CST - Tributação do COFINS']));
          end;
        end;
      end;
	  
  	  if (produtos.findfield('produtototal')<>nil) and
	     (OrigemCalculo = NotaEntrada) then
	     produtos.fieldbyname('produtototal'). AsCurrency := (Produtos.fieldByname('precounitario').AsFloat * produtos.fieldByName('quantidade').AsFloat);	  
		 
  	  if (produtos.findfield('AliquotaipiOriginal')<>nil) and
	     (qryDadosProdutos.findfield('AliquotaipiOriginal')<>nil) and	  
	     (OrigemCalculo in [NotaEntrada, NotaEntradaXML]) then
	     produtos.fieldbyname('AliquotaipiOriginal').AsCurrency := qryDadosProdutos.fieldbyname('AliquotaipiOriginal'). AsCurrency;	  
		
      if produtos.findfield('produtook')<>nil then
        produtos.fieldbyname('produtook').asboolean := result;

    end;	
  end;
end;



function TdtmBasico.TipoNotaSaida(CodigoFiscal: integer): TtecTipoNotaSaida;
var
  CodFiscal: Integer;
begin
  CodFiscal := codigofiscal mod 1000;
  if (CodFiscal = ctCFOTRANSFERENCIA_150) or
     (CodFiscal = ctCFOTRANSFERENCIA_151) or
     (CodFiscal = ctCFOTRANSFERENCIA_152) or
     (CodFiscal = ctCFOTRANSFERENCIANAOTRANS) or
     (CodFiscal = ctCFOTRANSFERENCIASUBSTITUICAO)
  then
    result:= tnsTRANSFERENCIA
  else if (CodFiscal = ctCFOTRANSFERENCIACREDITOICMS) or
          (CodFiscal = ctCFOTRANSFERENCIASALDOCREDORICMS) or
          (CodFiscal = ctCFOTRANSFERENCIASALDODEVEDORICMS)
  then
    result := tnsTRANSFERENCIAICMS
  else if (CodFiscal = ctCFODEVOLUCAOSUBSTITUICAO) then
    result := tnsDEVOLUCAOFORNECEDORST
  else if (CodFiscal = ctDEVOLUCAO) then
    result := tnsDEVOLUCAOFORNECEDOR
  else
    result := tnsNORMAL;
end;

function TdtmBasico.eHNotaFiscalSaidaDevolucao(CodigoFiscal: integer; ST: boolean = false): boolean;
begin
    if ST then
      result := (CodigoFiscal mod 1000  = 410) or  // Devolução de compra para industrialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 411) or  // Devolução de compra para comercialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 412) or  // Devolução de bem do ativo imobilizado, em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 413)     // Devolução de mercadoria destinada ao uso ou consumo, em operação com mercadoria sujeita ao regime de substituição tributária

    else
      result := (CodigoFiscal mod 1000  = 201) or  // Devolução de compra para industrialização
                (CodigoFiscal mod 1000  = 202) or  // Devolução de compra para comercialização

                (CodigoFiscal mod 1000  = 205) or  // Anulação de valor relativo a aquisição de serviço de comunicação
                (CodigoFiscal mod 1000  = 206) or  // Anulação de valor relativo a aquisição de serviço de transporte
                (CodigoFiscal mod 1000  = 207) or  // Anulação de valor relativo à compra de energia elétrica
                (CodigoFiscal mod 1000  = 208) or  // Devolução de mercadoria recebida em transferência para industrialização
                (CodigoFiscal mod 1000  = 209) or  // Devolução de mercadoria recebida em transferência para comercialização
                (CodigoFiscal mod 1000  = 210) or  // Devolução de compra para utilização na prestação de serviço

                (CodigoFiscal mod 1000  = 410) or  // Devolução de compra para industrialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 411) or  // Devolução de compra para comercialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 412) or  // Devolução de bem do ativo imobilizado, em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 413) or  // Devolução de mercadoria destinada ao uso ou consumo, em operação com mercadoria sujeita ao regime de substituição tributária

                (CodigoFiscal mod 1000  = 553) or  // Devolução de compra de bem para o ativo imobilizado
                (CodigoFiscal mod 1000  = 555) or  // Devolução de bem do ativo imobilizado de terceiro, recebido para uso no estabelecimento
                (CodigoFiscal mod 1000  = 556) or  // Devolução de compra de material de uso ou consumo
                (CodigoFiscal mod 1000  = 902) or  // Retorno de mercadoria utilizada na industrialização por encomenda
                (CodigoFiscal mod 1000  = 903) or  //Retorno de mercadoria recebida para industrialização e não aplicada no referido processo
                (CodigoFiscal mod 1000  = 913) ;   //Retorno de mercadoria recebida para demonstração
end;


