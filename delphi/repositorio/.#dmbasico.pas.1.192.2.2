procedure TdtmBasico.ReFazConsultaPorNome(ds: TZDataset; Param: array of String;
  Valores: array of Variant);
var
  a: Integer;
begin
  if High(Param) <> High(Valores) then
    raise Exception.Create(ctERRORREFAZCONSULTA)
  else begin
    ds.Close;
    ds.DisableControls;
    for a := 0 to High(Param) do begin
      ds.ParamByName(Param[a]).Clear;
      ds.ParamByName(Param[a]).Value := Valores[a];
    end;
    ds.enablecontrols;
    ds.Open;
  end
end;


function TdtmBasico.VerificarCamposRequeridos(ds:TZDataset): boolean;
begin
  result := true;

  ds.First;
  while not ds.Eof do
  begin
    if not TtecQuery(ds).CheckRequiredFields then
    begin
      result := false;
      break;
    end
    else
      ds.next;
  end;
end;

function TdtmBasico.ValorCampodaTabela(NomedaTabela: String; Chaves: array of String; Valores: array of Variant; CamposaRetornar: array of String): TVariantArray;
var
  vTabela : TtecQuery;
  a: integer;
  vVariantArray : Variant;
  vDescricao: String;
  vPesquisa: String;
begin
  vPesquisa := '';
  vVariantArray := VarArrayCreate([0,1], varVariant);

  if High(Chaves) <> High(Valores) then
    raise Exception.Create('Parâmetros ''Chaves'' e ''Valores'' estão com tamanhos diferentes')
  else
  begin
    vTabela := TTecQuery.Create(nil);
    vTabela.Database := dtmTecSoft.Database;
    vTabela.Sql.Append('select * from ' + NomedaTabela + ' Where true');
    for a := 0 to High(Chaves) do
    begin
      vTabela.Sql.Append('and '+Chaves[a]+' = '+quotedstr(Valores[a]));
      vPesquisa := vPesquisa + ' ' + Chaves[a] + ' = ' + Valores[a];
    end;

    vTabela.Open;
    if vTabela.recordcount = 0 then
      MensagemErro('A pesquisa na tabela ''' + NomedaTabela + ''' com os parametros ''' + vpesquisa + ''' não foi encontrada')
    else
      for a := 0 to High(CamposaRetornar) do
        vVariantArray[a] := vTabela.fieldbyName('descricao').Value;

  end;

  result := vVariantArray;


end;



procedure TdtmBasico.AtribuirChave(ds: TZDataset;
                            Chaves: array of TField;
                            Valores: array of TField;
                            DesligarControles: Boolean = true;
                            SomenteRegistroAtual: Boolean = false);
var
  a: Integer;
  RegistroAtual: TBookMark;
  ControlesJaDesabilitados : Boolean;

  function ExisteDiferencadeChave: boolean;
  var
    a: Integer;
  begin
    result := false;
    for a := 0 to High(Chaves) do
    begin
      if Chaves[a].Value <> Valores[a].Value then
      begin
        result := true;
        break;
      end;
    end;
  end;

begin
  if High(Chaves) <> High(Valores) then
    raise Exception.Create('Parâmetros "Chaves" e "Valores" estão com tamanhos diferentes.')
  else
  begin
    RegistroAtual := ds.GetBookmark;

    ControlesJaDesabilitados := ds.ControlsDisabled;

    if not ControlesJaDesabilitados then
      if DesligarControles then
        ds.DisableControls;

    if SomenteRegistroAtual then
    begin
      if ExisteDiferencadeChave then
      begin
        ds.Edit;
        for a := 0 to High(Chaves) do
          Chaves[a].Value := Valores[a].Value;
        ds.Post;
      end;
    end
    else
    begin
      ds.First;
      while not ds.Eof do
      begin
        if ExisteDiferencadeChave then
        begin
          ds.Edit;
          for a := 0 to High(Chaves) do
            Chaves[a].Value := Valores[a].Value;
          ds.Post;
        end;
        ds.Next;
      end;
    end;

    ds.GotoBookmark(RegistroAtual);
    ds.FreeBookmark(RegistroAtual);

    if not ControlesJaDesabilitados then
      if DesligarControles then
        ds.EnableControls;
  end;
end;


function TdtmBasico.SomarValores(ds: TZDataset;
                            Campos: array of TField): Currency;
var
  a: Integer;
  RegistroAtual: TBookMark;
  ControlesJaDesabilitados : Boolean;
begin
  result := 0;

  RegistroAtual := ds.GetBookmark;
  ControlesJaDesabilitados := ds.ControlsDisabled;
  if not ControlesJaDesabilitados then
    ds.DisableControls;

  ds.First;
  while not ds.Eof do
  begin
    for a := 0 to High(Campos) do
    begin
      if not Campos[a].IsNull then
        result := result + Campos[a].value;
    end;

    ds.Next;
  end;
  ds.GotoBookmark(RegistroAtual);
  ds.FreeBookmark(RegistroAtual);

  if not ControlesJaDesabilitados then
    ds.EnableControls;
end;





