                                               qryDocumentosPag.FieldByName('filialemissao').AsInteger
                                               );
       qryDuplicatasImpostosRetidos.FieldByName('numero').AsInteger := 1;
       qryDuplicatasImpostosRetidos.FieldByName('valorvencto').AsCurrency := valorimpostorateado;
       qryDuplicatasImpostosRetidos.FieldByName('evento').AsVariant := qryDocumentosPag.FieldByName('Evento').AsVariant;
       qryDuplicatasImpostosRetidos.FieldByName('tipojuros').AsString := qryDuplicatas.FieldByName('tipojuros').AsString;
       qryDuplicatasImpostosRetidos.FieldByName('tipomulta').AsString := qryDuplicatas.FieldByName('tipomulta').AsString;
       qryDuplicatasImpostosRetidos.FieldByName('autorizado').AsBoolean := qryDuplicatas.FieldByName('autorizado').AsBoolean;
