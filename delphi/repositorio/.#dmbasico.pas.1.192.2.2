  function IcmsBaseCalculo(tProdutos :TTecQuery;
                           ConsiderarBaseFixa: boolean = true;
                           ConsiderarNotaFiscalVinculadaaoCupomFiscal: Boolean = False): Real;
  var
    Calcular : Boolean;
  begin
    result := 0.00;

    Calcular := True;

    if ConsiderarNotaFiscalVinculadaaoCupomFiscal then
      Calcular := True
    else
      if NotaFiscalVinculada then
        Calcular := False;

    if Calcular then
    begin
      if HeImportacao or
        (OrigemCalculo = NotaAcrescimoFinanceiro) then
        result := tProdutos.FieldByName('icmsbasecalculo').Asfloat
      else
      begin
        if (tProdutos.findfield('baseicms')<>nil) and
           (tProdutos.fieldbyname('baseicms').ascurrency<>0) and ConsiderarBaseFixa and saida then
            result := ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * tProdutos.fieldbyname('baseicms').ascurrency,-2)
        else
        begin

          if tProdutos.FindField('valordescontoitem') <> nil then
          begin
            if (tProdutos.FindField('produtototal') <> nil) and not PermiteAlterarDadosICMS then
              result := tProdutos.FindField('produtototal').ascurrency
                                - tProdutos.FieldByName('valordescontoitem').AsCurrency
                                - tProdutos.FieldByName('desconto').AsCurrency
                                {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                                + tProdutos.FieldByName('frete').AsCurrency
                                + tProdutos.FieldByName('seguro').AsCurrency
                                + ifthen(ICMSSobreIPI(tProdutos), tprodutos.fieldbyname('valoripi').ascurrency,0)
            else
              result := ArredondarouTruncar(ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * precounitario(produtos),-2)
                                - tProdutos.FieldByName('valordescontoitem').AsCurrency
                                - tProdutos.FieldByName('desconto').AsCurrency
                                {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                                + tProdutos.FieldByName('frete').AsCurrency
                                + tProdutos.FieldByName('seguro').AsCurrency
                                + ifthen(ICMSSobreIPI(tProdutos), tprodutos.fieldbyname('valoripi').ascurrency,0)
                                {+ tProdutos.FieldByName('despesasacessorias').AsCurrency} ,-2)
          end
          else
          begin
            if (tProdutos.FindField('produtototal') <> nil) and not PermiteAlterarDadosICMS then
              result := tProdutos.FindField('produtototal').ascurrency
                                      - tProdutos.FieldByName('desconto').AsCurrency
                                      {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                                      + tProdutos.FieldByName('frete').AsCurrency
                                      + tProdutos.FieldByName('seguro').AsCurrency
                                      + ifthen(ICMSSobreIPI(tProdutos), tprodutos.fieldbyname('valoripi').ascurrency,0)
            else
              result := ArredondarouTruncar(ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * precounitario(produtos), -2)
                                      - tProdutos.FieldByName('desconto').AsCurrency
                                      {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                                      + tProdutos.FieldByName('frete').AsCurrency
                                      + tProdutos.FieldByName('seguro').AsCurrency
                                      + ifthen(ICMSSobreIPI(tProdutos), tprodutos.fieldbyname('valoripi').ascurrency,0)
                                      {+ tProdutos.FieldByName('despesasacessorias').AsCurrency} ,-2);
          end;
       end;
      end;
    end;
  end;

