procedure TdtmBasico.MarcarRegistros(DS:             TZDataset;
                                     CampoMarcar:    TBooleanField;
                                     CampoTotalizar: TFloatField;
                                     Marcando:       Boolean;
                                     MarcarTodos:    Boolean);
var Pos: TBookmark;
    I:   Integer;


    procedure AtualizarValores;
    begin
       if CampoMarcar.AsBoolean then begin
          Inc(FQtdeMarcados);
          FTotalMarcados:= FTotalMarcados + CampoTotalizar.AsCurrency;
       end
       else begin
          Dec(FQtdeMarcados);
          FTotalMarcados:= FTotalMarcados - CampoTotalizar.AsCurrency;
       end;
    end;


begin
   if not DS.IsEmpty then begin
      if not MarcarTodos then begin
         DS.Edit;  CampoMarcar.AsBoolean:= not CampoMarcar.AsBoolean;
         DS.Post;  AtualizarValores;
      end
      else begin
         FQtdeMarcados := 0;
         FTotalMarcados:= 0;
         Pos:= DS.GetBookmark;
         try
            DS.DisableControls;
            DS.First;
            for I:= 1 to DS.RecordCount do begin
                if     (Marcando and not CampoMarcar.AsBoolean) or
                   (not Marcando and     CampoMarcar.AsBoolean) then begin
                   DS.Edit;      CampoMarcar.AsBoolean:= Marcando;
                   DS.Post;
                end;
                if CampoMarcar.AsBoolean then AtualizarValores;
                DS.Next;
            end;
         finally
            DS.GotoBookmark(Pos);
            DS.FreeBookmark(Pos);
            DS.EnableControls;
         end;
      end;
   end;
end;


