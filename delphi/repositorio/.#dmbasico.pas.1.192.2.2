  procedure AtribuirValoresRetidosST;
  var
   vFatorSubstituicao: Currency;
   vReducaoBaseST: Currency;
   valiquotaicmsst: Currency;

   vAliquotaICMSProprio : Currency;
   vValorICMSProprio : Currency;

   vicmsBaseCalculo, vicmsvalor : Currency;

  begin
    if (OrigemCalculo = NotaAvulsa) and
       RequerNFEntrada  and
       eHNotaFiscalSaidaDevolucao(produtos.fieldbyname('codigofiscal').Asinteger, true) then
    begin
      if not produtos.FieldByName('valoricmsstdigitado').AsBoolean then
      begin
        if (qryValoresSTRetidosCusto.Sql.Text <> SQLValoresSTRetidosCustoDevolucao) or
            not qryValoresSTRetidosCusto.Active or
            (qryValoresSTRetidosCusto.ParamByName('produto').asstring <> produtos.fieldbyname('produto').asstring) or
            (qryValoresSTRetidosCusto.ParamByName('codigonota').asstring <> produtos.fieldbyname('codigonota').asstring) then
        begin
          qryValoresSTRetidosCusto.Sql.Text := SQLValoresSTRetidosCustoDevolucao;
          RefazConsultaPorNome(qryValoresSTRetidosCusto,
               ['produto','codigonota'], [produtos.fieldbyname('produto').asstring,
                                          produtos.fieldbyname('codigonota').asstring]);
        end;

        produtos.FieldByName('vBCSTRet').ascurrency   := ArredondarouTruncar(qryValoresSTRetidosCusto.fieldbyname('icmsbasecalculost').ascurrency *
                                                         Produtos.fieldbyname('quantidade').AsFloat, -2);

        produtos.FieldByName('vICMSSTRet').AsCurrency := ArredondarouTruncar(qryValoresSTRetidosCusto.fieldbyname('icmsvalorst').ascurrency*
                                                         Produtos.fieldbyname('quantidade').AsFloat, -2);
      end;

      if not produtos.FieldByName('valoricmsdigitado').AsBoolean then
      begin
        if (qryValoresSTRetidosCusto.Sql.Text <> SQLValoresSTRetidosCustoDevolucao) or
            not qryValoresSTRetidosCusto.Active or
            (qryValoresSTRetidosCusto.ParamByName('produto').asstring <> produtos.fieldbyname('produto').asstring) or
            (qryValoresSTRetidosCusto.ParamByName('codigonota').asstring <> produtos.fieldbyname('codigonota').asstring) then
        begin
          qryValoresSTRetidosCusto.Sql.Text := SQLValoresSTRetidosCustoDevolucao;
          RefazConsultaPorNome(qryValoresSTRetidosCusto,
               ['produto','codigonota'], [produtos.fieldbyname('produto').asstring,
                                          produtos.fieldbyname('codigonota').asstring]);
        end;

        produtos.FieldByName('icmsbasecalculo_dev').ascurrency   := ArredondarouTruncar(qryValoresSTRetidosCusto.fieldbyname('icmsbasecalculo').ascurrency *
                                                         Produtos.fieldbyname('quantidade').AsFloat, -2);

        produtos.FieldByName('icmsvalor_dev').AsCurrency := ArredondarouTruncar(qryValoresSTRetidosCusto.fieldbyname('icmsvalor').ascurrency*
                                                         Produtos.fieldbyname('quantidade').AsFloat, -2);
      end;


      produtos.FieldByName('despesasacessorias').AsCurrency := produtos.FieldByName('vICMSSTRet').AsCurrency;
      qryValoresSTRetidosCusto.Close;
    end
    else
    begin

      produtos.FieldByName('vBCSTRet').ascurrency := 0;
      produtos.FieldByName('vICMSSTRet').AsCurrency := 0;

      if contribicms and
         ParSistema.DestacarSubstituicaoTributariaVendaContribuintesICMS and
         not (OrigemCalculo in [Devolucao,Troca, NotaAcrescimoFinanceiro]) then
      begin
        if (ParSistema.MarkupSubstituicao<>0) then
        begin
          if (produtos.FieldByName('ipi').AsInteger <> 0) and
             (fatorsubstituicao(EstadoSubstituicao) <> 0) then
          begin
            if EstadoSubstituicao = EstadoFilialBase then
              vAliquotaICMSProprio := ParSistema.ICMSaDestacarDentroEstado
            else
              vAliquotaICMSProprio := ParSistema.ICMSaDestacarForaEstado;

            vValorICMSProprio    := icmsbasecalculo(produtos) * vAliquotaICMSProprio;
            produtos.FieldByName('vBCSTRet').ascurrency := (icmsbasecalculo(produtos) / (1 + ParSistema.MarkupSubstituicao / 100)) * fatorsubstituicao(EstadoSubstituicao);
            produtos.FieldByName('vICMSSTRet').AsCurrency := (produtos.FieldByName('vBCSTRet').ascurrency * ParSistema.ICMSaDestacarDentroEstado);
            if vValorICMSProprio < produtos.FieldByName('vICMSSTRet').AsCurrency then
              produtos.FieldByName('vICMSSTRet').AsCurrency := produtos.FieldByName('vICMSSTRet').AsCurrency - vValorICMSProprio;

          end;
        end
        else
        begin
          if qryValoresSTRetidosCusto.Active and
             (qryValoresSTRetidosCusto.parambyname('produto').asstring <> produtos.fieldbyname('produto').asstring)  or
             not qryValoresSTRetidosCusto.active then
            RefazConsultaPorNome(qryValoresSTRetidosCusto,
               ['produto'{,'filial'}],
               [produtos.fieldbyname('produto').asstring{,
                produtos.fieldbyname('filial').asinteger}]);

          produtos.FieldByName('vBCSTRet').ascurrency   := ArredondarouTruncar(qryValoresSTRetidosCusto.fieldbyname('icmsbasecalculostcusto').ascurrency *
                                                           Produtos.fieldbyname('quantidade').AsFloat, -2);

          produtos.FieldByName('vICMSSTRet').AsCurrency := ArredondarouTruncar(qryValoresSTRetidosCusto.fieldbyname('icmsvalorstcusto').ascurrency*
                                                           Produtos.fieldbyname('quantidade').AsFloat, -2);

          {deveria encontrar os custos da subst. na entrada da nota fiscal,
          caso não encontrar faz-se uma pesquisa do último produto comprado e calcula-se o icmsst}

          if (produtos.FieldByName('vBCSTRet').ascurrency=0) or
             (produtos.FieldByName('vICMSSTRet').AsCurrency=0) then
          begin
            if qryValoresUltimaCompra.Active and
               (qryValoresUltimaCompra.parambyname('produto').asstring <> produtos.fieldbyname('produto').asstring)  or
               not qryValoresUltimaCompra.active then
              RefazConsultaPorNome(qryValoresUltimaCompra, ['produto'], [produtos.fieldbyname('produto').asstring]);

            if CondicaopMVAST(qryValoresUltimaCompra.fieldbyname('incidencia').asString,
                              qryValoresUltimaCompra.fieldbyname('csosn').asString,
                              crt,PessoaTipo,VendaConsumidorFinal) then

            begin
              vFatorSubstituicao := FatorSubstituicao(estadofilialbase);

              if qryValoresUltimaCompra.fieldbyname('icmsbasecalculo').ascurrency <> 0 then
                vicmsBaseCalculo := (qryValoresUltimaCompra.fieldbyname('icmsbasecalculo').ascurrency +
                                     qryValoresUltimaCompra.fieldbyname('valoripi').ascurrency) /
                                     qryValoresUltimaCompra.fieldbyname('quantidade').ascurrency *
                                     produtos.fieldbyname('quantidade').ascurrency
              else
                vicmsBaseCalculo := (IcmsBaseCalculo(qryValoresUltimaCompra) +
                                     qryValoresUltimaCompra.fieldbyname('valoripi').ascurrency) /
                                     qryValoresUltimaCompra.fieldbyname('quantidade').ascurrency *
                                     produtos.fieldbyname('quantidade').ascurrency;

              vReducaoBaseST := ArredondarouTruncar(vicmsBaseCalculo * vFatorSubstituicao *
                                  qryValoresUltimaCompra.fieldbyname('pRedBCST').ascurrency /100,-2);

              produtos.FieldByName('vBCSTRet').AsCurrency := ArredondarouTruncar(vicmsBaseCalculo * vFatorSubstituicao, -2) - vReducaoBaseST;


              {OS "SUPOSTOS RETIDOS ANTERIORMENTE":}

              valiquotaicmsst := AliquotaICMSST(estadofilialbase);
              produtos.FieldByName('vICMSSTRet').AsCurrency  := ArredondarouTruncar((produtos.FieldByName('vBCSTRet').AsCurrency *
                           valiquotaicmsst)/100,-2);

              {dúvida: a equalização na saida deve ser comparada com qual aliquota de icms da entrada ou saida ?}
              if (estadofilialbase <> notas.fieldbyname('estado').asstring) and
                 (valiquotaicmsst > qryValoresUltimaCompra.FieldByName('aliquotaicms').AsCurrency) and
                 not NoSimples then
                produtos.FieldByName('vICMSSTRet').AsCurrency := ArredondarouTruncar(produtos.FieldByName('vICMSSTRet').AsCurrency *
                    (1 - qryValoresUltimaCompra.FieldByName('aliquotaicms').AsCurrency/100) / (1 -valiquotaicmsst/100),-2);


              if qryValoresUltimaCompra.fieldbyname('icmsvalor').ascurrency <> 0 then
                 vicmsvalor := (qryValoresUltimaCompra.fieldbyname('icmsvalor').ascurrency /
                                qryValoresUltimaCompra.fieldbyname('quantidade').ascurrency *
                                produtos.fieldbyname('quantidade').ascurrency)
              else
                vicmsvalor := ArredondarouTruncar((vicmsBaseCalculo *
                                 qryValoresUltimaCompra.FieldByName('aliquotaicms').AsCurrency)/100,-2);

              if vicmsvalor < produtos.FieldByName('vICMSSTRet').AsCurrency then
                produtos.FieldByName('vICMSSTRet').AsCurrency := produtos.FieldByName('vICMSSTRet').AsCurrency -
                                                                 vicmsvalor;

            end;
          end;
        end;
      end;
    end;
  end;

