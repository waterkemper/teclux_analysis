function TdtmBasico.eHNotaFiscalEntradaCompra(
  CodigoFiscal: integer): boolean;
begin
    result := (CodigoFiscal mod 1000  = 101) or  // Compra para industrialização
              (CodigoFiscal mod 1000  = 102) or  // Compra para comercialização
              (CodigoFiscal mod 1000  = 401) or  // COMPRA INDUSTRIALIZACAO MERC. SUBST.TRIBUTARIA
              (CodigoFiscal mod 1000  = 403);  // COMPRA COMERCIALIZACAO MERC. SUBST. TRIBUTARIA

end;

function TdtmBasico.eHNotaFiscalEntradaUsoouConsumo(
  CodigoFiscal: integer): boolean;
begin
    result := (CodigoFiscal mod 1000  = 407);   //  COMPRA USO MERC. SUBST. TRIBUTARIA
end;

