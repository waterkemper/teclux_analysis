                    if not ExistePagamento_DuplicatasImpostosRetido then
                    begin
                      qryDocumentosPagImpostosRetidos.Edit;
                      AtribuirDocumentosPag;
                      qryDocumentosPagImpostosRetidos.post;
                      qryDuplicatasImpostosRetidos.Edit;
                      AtribuirDuplicatas;
                      qryDuplicatasImpostosRetidos.Post;
                    end;
                  end
                  else
                    qryDocumentosPagImpostosRetidos.Delete;
                end
                else
                begin
                  if valorimpostorateado <> 0 then
                  begin
                    qryDocumentosPagImpostosRetidos.Append;
                    spcDocumentosPagProximo.Open;
                    qryDocumentosPagImpostosRetidos.FieldByName('numero').AsInteger := spcDocumentosPagProximo.FieldByName('codigo').AsInteger;
                    spcDocumentosPagProximo.Close;
