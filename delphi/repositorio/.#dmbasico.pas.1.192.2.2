class function TdtmBasico.ObterAutorizacao(TipoAutorizacao: TtecTipoAutorizacao; Motivo, Responsavel, Complemento: String): TtecUsuarios;
var
  Msg: String;
begin
  Msg := Format(ctTEXTOAUTORIZACAO, [Motivo, Responsavel]) + #10#13 + Complemento;
  dtmsenhaautorizacao := TdtmSenhaAutorizacao.Create(Application.MainForm, TipoAutorizacao, Msg);
  try
    if Assigned(dtmSenhaAutorizacao) and dtmSenhaAutorizacao.Autorizado then
      try
        Result := TtecUsuarios.Create(dtmSenhaAutorizacao.dbaTecSoft)
      except
        on E:Exception do begin
          if Pos('permission denied', E.Message) > 0 then
            MensagemErro(ctERROPERMISSAONEGADA)
          else
            MensagemErro(E.Message);
          Result := nil;
        end
      end
    else
      Result := nil;
  finally
    dtmsenhaautorizacao.Free;
    dtmsenhaautorizacao := nil;
    RestaurarFoco;
  end
end;

function TdtmBasico.Perpetrar(ds: array of TZDataSet; TerminarTransacao: Boolean): Boolean;
var
  a: Integer;
begin
  try
    for a := 0 to High(ds) do
      if ds[a] is TZDataSet then
        if ds[a].UpdatesPending then
          ds[a].ApplyUpdates;
    if TerminarTransacao then begin
      dtmTecSoft.tstTecSoft.Commit;
      for a := 0 to High(ds) do
        if ds[a] is TZDataSet then
          if ds[a].CachedUpdates and ds[a].Active then
            ds[a].CommitUpdates;
    end;
    Result := True;
  except
//    if TerminarTransacao then
    begin
      for a := 0 to High(ds) do
        if ds[a] is TZDataSet then begin
           ds[a].RevertRecord;
           ds[a].CancelUpdates;
        end;
      dtmTecSoft.tstTecSoft.Rollback;
    end;  
  raise
  end;
end;

