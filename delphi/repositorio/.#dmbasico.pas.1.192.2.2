procedure TdtmBasico.ReFazConsulta(ds: TZDataSet;
                                   Param: array of integer;
                                   Valores: array of variant;
                                   RefazerSeParametroIgual: Boolean = true);
var
  a: Integer;
  ExisteParametroDiferente: Boolean;

  procedure AbrirConsulta;
  var
    a: Integer;
  begin
    ds.DisableControls;
    ds.Close;
    for a := 0 to High(Param) do begin
      ds.Params[Param[a]].Clear;
      ds.Params[Param[a]].Value := Valores[a];
    end;
    ds.enablecontrols;
    ds.Open;
  end;

begin
  if High(Param) <> High(Valores) then
    raise Exception.Create(ctERRORREFAZCONSULTA)
  else
  begin
    if RefazerSeParametroIgual then
      AbrirConsulta
    else
    begin
      for a := 0 to High(Param) do
        if not ExisteParametroDiferente then
          ExisteParametroDiferente := ds.Params[Param[a]].Value <> Valores[a];
      if ExisteParametroDiferente or not ds.Active then
        AbrirConsulta;
    end;
  end;
end;

