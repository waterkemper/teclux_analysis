function TdtmBasico.ImportarArquivoTXT(NomeArquivo: String; TipoArquivo: TTipoArquivo): boolean;
var Arquivo: TextFile;
    vLinha : String;
    RBlock, x, vtam, tam: integer;
begin
  result := true;

  Try
    AssignFile(Arquivo, NomeArquivo);
    Reset(Arquivo);

    while not eof(arquivo) do
    begin
      readln(arquivo, vlinha);
      if vLinha = '-----------------------------------------------------------------------------------------------' then
      begin
        readln(arquivo);
        readln(arquivo);
        break;
      end;
    end;

    ArquivoTXT_Daico := nil;
    while not eof(arquivo) do
    begin
      readln(arquivo, vlinha);
      if vlinha = '' then
        break;
      vtam := length(ArquivoTXT_Daico)+1;
      SetLength(ArquivoTXT_Daico, vtam);
      ArquivoTXT_Daico[vtam-1].Item := strtoint(trim(copy(vLinha,1,5)));
      ArquivoTXT_Daico[vtam-1].Quantidade := strtofloat(trocar(trim(copy(vLinha,6,5)),'.',','));
      ArquivoTXT_Daico[vtam-1].Referencia := trim(copy(vLinha,11,13));
      ArquivoTXT_Daico[vtam-1].Descricao  := trim(copy(vLinha,24,45));
      ArquivoTXT_Daico[vtam-1].Dimensoes  := trim(copy(vLinha,69,19));
      ArquivoTXT_Daico[vtam-1].PrecoCT    := strtofloat(trocar(trim(copy(vLinha,88,8)),'.',','));
    end;
    CloseFile(Arquivo);


  except
  on E: Exception do
    begin
      result := false;
      Close(Arquivo);
      raise exception.create(ctERROABERTURAARQUIVOTEXTO +  NomeArquivo);
    end;
  end;

end;


