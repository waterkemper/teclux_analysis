end;

class function TdtmBasico.VerificarFiliaisEstoques: string;
var
  SQL: String;
  qryEstoquesFiliais: TtecQuery;
begin
  qryEstoquesFiliais := TtecQuery.Create(nil);
  qryEstoquesFiliais.Database := dtmTecSoft.Database;
  SQL := Format(VerificarEstoquesFiliais, [GetFilialBase]);
  qryEstoquesFiliais.Sql.Text := SQL;

  ListaEstoquesFiliais := '';

  FFilialBasedaVirtual := 0;

  qryEstoquesFiliais.Open;
  qryEstoquesFiliais.First;
  while not qryEstoquesFiliais.Eof do
  begin
    ListaEstoquesFiliais := ListaEstoquesFiliais + qryEstoquesFiliais.fieldbyname('filialestoque').AsString + ',';
    if (GetTipoFilial = 'V') and
       (GetFilialBase <> qryEstoquesFiliais.fieldbyname('filialestoque').AsInteger) then
      FFilialBasedaVirtual := qryEstoquesFiliais.fieldbyname('filialestoque').AsInteger;

    qryEstoquesFiliais.Next;
  end;

  if pos(inttostr(GetFilialBase),ListaEstoquesFiliais)=0 then
    if GetTipoFilial <> 'V' then //não pode ser virtual
      ListaEstoquesFiliais := ListaEstoquesFiliais + inttostr(GetFilialBase) + ',';

  if ListaEstoquesFiliais<>'' then
    ListaEstoquesFiliais := copy(ListaEstoquesFiliais,1,length(ListaEstoquesFiliais)-1)
