function LerArquivoCFG(NotificarSplash: TtecProcParametroString = nil): Boolean;
var
  ArquivoCFG: TIniFile;
  strFilialBase,
  Host,
  Banco,
  Porta,
  ModeloImpCheque,
  TipoPorta,
  NumeroPorta,
  strFrenteCaixa: String;
  Pacotes: TStringList;
  ImpChequeClass: TtecImpressoraChequePadraoClass;
  Barra, strTrabalhaComoProducao: String;
begin
{$IFDEF LINUX}
  Barra := '/';
{$ELSE }
  Barra := '\';
{$ENDIF}

  RegisterClasses([{TtecECFBematech, TtecECFMecaf, TtecECFDaruma, TtecECFElgin,
                   TtecECFSweda, TtecECFEpson,}
                   TtecImpChequeBematech, TtecImpChequeTSP]);

  if ParamCount >= 1 then
  begin
    NomeArquivoCFG  := ParamStr(1) + Barra + ctNomeArquivoCFG;
    NomeArquivoECFs := ParamStr(1) + Barra + ctNomeArquivoECFs;
  end
  else
  begin
    NomeArquivoCFG  := ExtractFilePath(Application.ExeName)+ ctNomeArquivoCFG;
    NomeArquivoECFs := ExtractFilePath(Application.ExeName)+ ctNomeArquivoECFs;
  end;

  if FileExists(NomeArquivoCFG) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
{$IFDEF LINUX}
      ArquivoCFG.CaseSensitive := False;
{$ENDIF}
      Pacotes := TStringList.Create;
      try

       if ArquivoCFG.SectionExists(ProducaoSection)  then
       begin
         strTrabalhaComoProducao := uppercase(ArquivoCFG.ReadString(ProducaoSection, 'trabalharcomo','Não'));
         ParSistema.TrabalhaComoProducao := strTrabalhaComoProducao='SIM';
       end;

       if ArquivoCFG.SectionExists(AutenticacaoSection)  then
       begin
         ParSistema.AutenticarECF := ArquivoCFG.ReadBool(AutenticacaoSection, 'autenticarecf',False);
         ParSistema.Autenticadora := ArquivoCFG.ReadInteger(AutenticacaoSection, 'autenticadora',3);
       end;

       if ArquivoCFG.SectionExists(ImpressoraSection) then
       begin
         ParSistema.ImpressaoCarneECF      := ArquivoCFG.ReadBool(ImpressoraSection, 'imprimircarneecf',False);
         ParSistema.ImprimirLineFeednaImpressoraMatricial := ArquivoCFG.ReadBool(ImpressoraSection, 'imprimirlinefeednaimpressoramatricial',False);
         parsistema.NomeImpressoraNotaMercadorias     := ArquivoCFG.ReadString(ImpressoraSection, 'notafiscal', '');
         parsistema.NomeImpressoraNotaServicos     := ArquivoCFG.ReadString(ImpressoraSection, 'notafiscalservicos', '');

         parsistema.NomeImpressoraContrato := ArquivoCFG.ReadString(ImpressoraSection, 'contrato', '');
         parsistema.NomeImpressoraCarne    := ArquivoCFG.ReadString(ImpressoraSection, 'carne', '');
         parsistema.NomeImpressoraBoleto   := ArquivoCFG.ReadString(ImpressoraSection, 'boleto', '');
         ParSistema.NomeImpressoraFechamentoCaixa := ArquivoCFG.ReadString(ImpressoraSection, 'fechamentocaixa', '');

         ParSistema.NomeImpressoraOSP := ArquivoCFG.ReadString(ImpressoraSection, 'OSP', '');
         ParSistema.NomeImpressoraSetupProcesso := ArquivoCFG.ReadString(ImpressoraSection, 'SetupProcesso', '');
         ParSistema.NomeImpressoraControleProcesso := ArquivoCFG.ReadString(ImpressoraSection, 'ControleProcesso', '');
       end
       else
       begin
         ParSistema.ImpressaoCarneECF      := False;
         parsistema.NomeImpressoraNotaMercadorias     := ctImpDefault;
         parsistema.NomeImpressoraNotaServicos     := ctImpDefault;
         parsistema.NomeImpressoraContrato := ctImpDefault;
         parsistema.NomeImpressoraCarne    := ctImpDefault;
         parsistema.NomeImpressoraBoleto   := ctImpDefault;
         ParSistema.NomeImpressoraFechamentoCaixa := ctImpDefault;
         ParSistema.NomeImpressoraOSP := ctImpDefault;
         ParSistema.NomeImpressoraSetupProcesso := ctImpDefault;
         ParSistema.NomeImpressoraControleProcesso := ctImpDefault;
       end;

       {Parâmetros utilizados pelo PAF-ECF}
       if ArquivoCFG.SectionExists(Empresa_DesenvolvedoraSection) then
       begin
         ParSistema.NomeEmpresaDesenvolvedora :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'NomeEmpresaDesenvolvedora', ''));

         ParSistema.CNPJDesenvolvedora        :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'CNPJDesenvolvedora', ''));

         ParSistema.IEDesenvolvedora          :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'IEDesenvolvedora', ''));

         ParSistema.IMDesenvolvedora          :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'IMDesenvolvedora', ''));

         ParSistema.NomeComercialSistema      :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'NomeComercialSistema', ''));

         ParSistema.VersaoPAFECF              := '1.99.9.9';
           {Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'VersaoPAFECF', ''));}

//         ParSistema.CodigoMD5                 :=
//           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'CodigoMD5', ''));

         ParSistema.LaudoPAFECF               := 'URB0242012';
           {Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'LaudoPAFECF', ''));}

         ParSistema.Endereco1Desenvolvedora   :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'Endereco1', ''));

         ParSistema.Endereco2Desenvolvedora   :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'Endereco2', ''));

         ParSistema.TelefoneDesenvolvedora    :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'Telefone', ''));

         ParSistema.ContatoDesenvolvedora     :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'Contato', ''));
       end;


        if ArquivoCFG.SectionExists(TipoImpEtiquetaSection) then begin
          parsistema.TipoImpressoraEtiqueta := ArquivoCFG.ReadString(TipoImpEtiquetaSection, 'tipo', '');
          parsistema.NomeImpressoraEtiqueta := ArquivoCFG.ReadString(TipoImpEtiquetaSection, 'impressora', '');
        end
        else begin
          parsistema.TipoImpressoraEtiqueta := ctNENHUMA;
          parsistema.NomeImpressoraEtiqueta := ''; //ctImpDefault;
        end;

        ImpChequePadrao := nil;
        if ArquivoCFG.SectionExists(IMPCHQSection) then begin
          ModeloImpCheque := ArquivoCFG.ReadString(IMPCHQSection, 'marca', '');
          TipoPorta       := ArquivoCFG.ReadString(IMPCHQSection, 'tipoporta', '0');
          NumeroPorta     := ArquivoCFG.ReadString(IMPCHQSection, 'numeroporta', '');
          ImpChequeClass := TtecImpressoraChequePadraoClass(GetClass('TtecImpCheque'+ModeloImpCheque));
          if Assigned(ImpChequeClass) then begin
            ImpChequePadrao := ImpChequeClass.Create;
            if TipoPorta = 'SERIAL' then
              ImpChequePadrao.PortaImpressao := pisSERIAL
            else if TipoPorta = 'PARALELA' then
              ImpChequePadrao.PortaImpressao := pisPARALELA;
            ImpChequePadrao.NumeroPorta := StrToInt(NumeroPorta);
          end
        end;
        if ArquivoCFG.SectionExists(FrenteCaixaSection) then begin
          strFrenteCaixa := ArquivoCFG.ReadString(FrenteCaixaSection, 'trabalharcomo', '');
          FrenteCaixa    := strFrenteCaixa = 'sim';
        end;
        if ArquivoCFG.SectionExists(NFeSection) then
        begin
          FNFeAmbiente        := ArquivoCFG.ReadInteger(NFeSection, 'Ambiente'    , 2);
          FNFeTipoEmissao     := ArquivoCFG.ReadInteger(NFeSection, 'TipoEmissao' , 1);
          FNFeNVias           := ArquivoCFG.ReadInteger(NFeSection, 'NumVias'     , 1);
          FNFeDirEnvio        := ArquivoCFG.ReadString (NFeSection, 'DirEnvio'    , ExtractFilePath(Application.ExeName) + 'envio');
          FNFeDirRetorno      := ArquivoCFG.ReadString (NFeSection, 'DirRetorno'  , ExtractFilePath(Application.ExeName) + 'retorno');
          FNFeDirEnviados     := ArquivoCFG.ReadString (NFeSection, 'DirEnviados' , ExtractFilePath(Application.ExeName) + 'enviados');
          FNFeDirErros        := ArquivoCFG.ReadString (NFeSection, 'DirErros'    , ExtractFilePath(Application.ExeName) + 'erros');
          FNFeDirCompartilha  := ArquivoCFG.ReadString (NFeSection, 'DirComp'     , ExtractFilePath(Application.ExeName) + 'compartilhamento');
          FNFeLogotipoDANFE   := ArquivoCFG.ReadString (NFeSection, 'Logotipo'    , '');
          FNFeExecNFe         := ArquivoCFG.ReadString (NFeSection, 'ExecNFe'  , 'c:\unimake\uninfe\uninfe.exe');
          FNFeExecDANFE       := ArquivoCFG.ReadString (NFeSection, 'ExecDANFE', 'c:\unimake\uninfe\unidanfe.exe');
          FNFeVisualizarDANFE := ArquivoCFG.ReadInteger(NFeSection, 'Visualizar'  , 0) = 1;//ArquivoCFG.ReadBool(NFeSection, 'Visualizar', False);
        end;
        if ArquivoCFG.SectionExists(PCPSection) then
          FPCPDirExportacao   := ArquivoCFG.ReadString (PCPSection, 'DirExp'      , ExtractFilePath(Application.ExeName) + 'Saidas');

        if ArquivoCFG.SectionExists(SpedSection) then
        begin
          FSpedFiscalDir      := ArquivoCFG.ReadString(SpedSection, 'DirSpedFiscal',       ExtractFilePath(Application.ExeName) + 'Saidas');
          FSpedContabilDir    := ArquivoCFG.ReadString(SpedSection, 'DirSpedContabil',     ExtractFilePath(Application.ExeName) + 'Saidas');
          FSpedFContDir       := ArquivoCFG.ReadString(SpedSection, 'DirSpedFCont',        ExtractFilePath(Application.ExeName) + 'Saidas');
          FEFDContribuicoesDir:= ArquivoCFG.ReadString(SpedSection, 'DirEFDContribuições', ExtractFilePath(Application.ExeName) + 'Saidas');
        end;

        if ArquivoCFG.SectionExists(ExportacaoSection) then
          fExportacaoDir   := ArquivoCFG.ReadString (ExportacaoSection, 'DirExportação', ExtractFilePath(Application.ExeName) + 'Saidas');

        if FPCPDirExportacao='' then
          FPCPDirExportacao   := ExtractFilePath(Application.ExeName) + 'Saidas';

        Notificar(NotificarSplash, '');
        ArquivoCFG.ReadSectionValues(ModulosSection, Pacotes);
        if Not CarregarModulos(Pacotes) then
          MensagemErro(Format(ctERROTECSOFTLOCAL, [ANSIUpperCase(NomeArquivoCFG)]));
      finally
        Pacotes.Free;
      end;

      UsuarioPadrao := ArquivoCFG.ReadString(LoginSection, 'UsuarioPadrao', '');
      SenhaPadrao   := ArquivoCFG.ReadString(LoginSection, 'SenhaPadrao', '');

      Host          := ArquivoCFG.ReadString(LoginSection, 'Host', '');
      Banco         := ArquivoCFG.ReadString(LoginSection, 'Banco', '');
      Porta         := ArquivoCFG.ReadString(LoginSection, 'Porta', '');
      strFilialBase := ArquivoCFG.ReadString(LoginSection, 'FilialBase', '');
      FComUsuario   := ANSIUpperCase(ArquivoCFG.ReadString(LoginSection, 'usuario', '')) = 'SIM';
      ParSistema.MaxColAutenticadora := ArquivoCFG.ReadInteger(LoginSection, 'MaxColAutenticadora', 48);

      if (strFilialBase <> '') and (Host <> '') and (Banco <> '') then
        try
          FFilialBase := StrToInt(strFilialBase);
          TdtmTecSoft.ConfigurarConexao(Host, Banco, Porta);
          Result := True
        except
          Result := False
        end
      else begin
        MensagemErro(Format(ctERRORARQUIVOCFGINVALIDO, [NomeArquivoCFG]));
        Result := False
      end

    finally
      ArquivoCFG.Free
    end;
  end else begin
    MensagemErro(Format(ctERRORARQUIVOCFGNAOENCONTRADO, [NomeArquivoCFG]));
    Result := False
  end;

end;


function LerArquivoCFGECF(NotificarSplash: TtecProcParametroString = nil): Boolean;
var
  ArquivoCFG: TIniFile;
  Comm: string;
  v1: String;
begin
  result := true;
  if FileExists(NomeArquivoCFG) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
{$IFDEF LINUX}
      ArquivoCFG.CaseSensitive := False;
{$ENDIF}

      if ArquivoCFG.SectionExists(ECFSection) then
      begin
        FCodigoECF := ArquivoCFG.ReadString(ECFSection, 'codigo', '');
        FPortaECF := ArquivoCFG.ReadString(ECFSection, 'porta', '');
        FVelocidadePorta := ArquivoCFG.ReadString(ECFSection, ' VelocidadePorta', '');

        Comm := 'COM' + FPortaECF + 'Velocidade Porta: '+FVelocidadePorta;
        Notificar(NotificarSplash, Format(ctINICIANDOECF, [Comm]));
        if ECFPadrao.AtivarECF(NomeArquivoECFs, FPortaECF, FCodigoECF) then
        begin
          if ECFPadrao.VerificarGT(NomeArquivoECFs) then
          begin
            if FCodigoECF <> ECFPadrao.Codigo then
            begin
              FCodigoECF := ECFPadrao.Codigo;
              ArquivoCFG.WriteString(ECFSection, 'codigo', ECFPadrao.Codigo);
              ArquivoCFG.UpdateFile;
            end;
            GerarAnexo_X_PAF_ECF;

          end;
        end;
      end;

      if Assigned(ECFPadrao) then
      begin
        if ArquivoCFG.SectionExists(TEFSection) then
        begin
          TtecTEFDedicado.Terminal(ArquivoCFG.ReadString(TEFSection, 'Terminal', ''));
          ParSistema.TipoTEF     := TtecTipoTEF(ArquivoCFG.ReadInteger(TEFSection,'Tipo',0));
          ParSistema.LojaTEF     := ArquivoCFG.ReadString(TEFSection,'Loja'    ,'');
          ParSistema.MensagemTEF := ArquivoCFG.ReadString(TEFSection,'Mensagem','');
          ParSistema.IPTEF       := ArquivoCFG.ReadString(TEFSection,'IP'      ,'');
          ParSistema.TerminalTEF := ArquivoCFG.ReadString(TEFSection,'Terminal','');
          {$IFDEF MSWINDOWS}
          TtecTEFDiscado.DiretorioRequisicao(ArquivoCFG.ReadString(TEFSection, 'DirReq', ''));
          TtecTEFDiscado.DiretorioResposta(ArquivoCFG.ReadString(TEFSection, 'DirResp', ''));
          TtecTEFDiscado.ExecutavelTEF(ArquivoCFG.ReadString(TEFSection, 'Exec', ''));

          ParSistema.QtdeViaTEFDiscado := ArquivoCFG.ReadInteger(TEFSection,'Vias',1);
          ParSistema.DirReqTEF   := ArquivoCFG.ReadString(TEFSection,'DirReq' ,'');
          ParSistema.DirRespTEF  := ArquivoCFG.ReadString(TEFSection,'DirResp','');
          ParSistema.ExecTEF     := ArquivoCFG.ReadString(TEFSection,'Exec'   ,'');
          {$ENDIF}
        end
      end;
    finally
      ArquivoCFG.Free
    end;
  end else begin
    MensagemErro(Format(ctERRORARQUIVOCFGNAOENCONTRADO, [NomeArquivoCFG]));
    Result := False
  end;

end;


function LerConfiguracaoSistema(NotificarSplash: TtecProcParametroString = nil; CriarDmTecsoft: Boolean = True): Boolean;
var
  TEFDedicado: TtecTEFDedicado;

begin
  if CriarDmTecsoft then
    Result := LerArquivoCFG(NotificarSplash)
  else
    Result := True;

  if Result then begin
    if CriarDmTecsoft then
      Application.CreateForm(TdtmTecsoft, dtmTecSoft);

    if dtmTecSoft.Conectado then
      dtmTecSoft.Desconectar;

    Result := dtmTecSoft.Conectar(UsuarioPadrao, SenhaPadrao);
    if Result then begin
      try
        if UsuarioLogin <> nil then
          UsuarioLogin.Free;
        UsuarioLogin := TtecUsuarios.Create(dtmTecSoft.Database, FFilialBase);
        if UsuarioLogin.CodigoUsuario = 0 then
        begin
          MensagemAviso(Format(ctUSUARIOSEMCADASTRO, [dtmTecSoft.Database.Login]));
          Result := False
        end else if Not TdtmBasico.VerificarFilialBase then
          MensagemAviso(Format(ctERRORFILIALBASEINEXISTENTE, [FFilialBase]));

        if (UsuarioLogin.ExpiracaoSenha > 0) then
        begin
          if (UsuarioLogin.ExpiracaoSenha >= DataLocal) then
          begin
            if SomarDia(DataLocal, UsuarioLogin.DiasAvisoSenha,'N') >= UsuarioLogin.ExpiracaoSenha then
              if MensagemConfirmacao(Format(ctDIASAVISOSENHA,[DateToStr(UsuarioLogin.ExpiracaoSenha)])) = smbOK then
              begin
                Result := dtmTecSoft.RenovarSenha; //abre tela para renovar a senha
                if result then
                  UsuarioLogin.AtualizarSenha(dtmTecSoft.SenhaNova);
              end
          end
          else //if UsuarioLogin.ExpiracaoSenha < DataLocal then
          begin
            Result := dtmTecSoft.RenovarSenha; //tela para renovar a senha
            if Result then
              UsuarioLogin.AtualizarSenha(dtmTecSoft.SenhaNova);
          end;
        end;

        if result then begin
          Result := UsuarioLogin.Administrador or UsuarioLogin.Suporte or (UsuarioLogin.Filial = FFilialBase);
          if Not Result then
            MensagemErro(Format(ctFILIALUSUARIODIFFILIALBASE, [FFilialBase]))
        end;

        if Result then begin

          if CriarDmTecsoft then
            Result := LerArquivoCFGECF(NotificarSplash)
          else
            Result := True;

          ParSistema.Database    := dtmTecsoft.Database;
          ParSistema.Filial      := FilialBase;
          ParSistema.ValorGlobal := True;
          ParSistema.Ler;
          TdtmBasico.VerificarFiliais;
          TdtmBasico.VerificarGrupoFiliais;
          TdtmBasico.verificarLogotipoFilialBase;
          TdtmBasico.VerificarFiliaisEstoques;
          TdtmBasico.VerificarContingencias;

          if Assigned(ECFPadrao) and ECFPadrao.CupomAberto then
            ECFPadrao.CancelarCupom;
          if ParSistema.TipoTEF = tsDEDICADO then begin
            if TtecTEFDedicado.Terminal <> '' then begin
              TEFDedicado := TtecTEFDedicado.Create;
              try
                TEFDedicado.Loja := ParSistema.LojaTEF;
                TEFDedicado.ServerIP := ParSistema.IPTEF;
                TEFDedicado.ConfigurarTef;
                if TEFDedicado.ExistePinPad then
                  TEFDedicado.MensagemPermanentePinPad := ParSistema.MensagemTEF
                else
                  MensagemAviso(ctTEFPINPADNAOENCONTRADO)
              finally
                TEFDedicado.Free
              end
            end
          end // A VERIFICACAO DE PENDENCIAS DO TEFDISCADO FOI MOVIDA PARA "PENDENCIASTEF"
        end   // POIS OCORRIA UMA EXCECAO DURANTE A IMPRESSAO DO RELATORIO GERENCIAL
      except  // QUANDO EXECUTADO NESSE MOMENTO DENTRO DO FLUXO DE INICIALIZACAO DO SISTEMA
        on E:EDatabaseError do begin
          if Pos('permission denied', E.Message) > 0 then
            MensagemErro(ctERROPERMISSAONEGADA)
          else
            MensagemErro(E.Message);
          Result := False;
        end
      end
    end
  end;

  if result then
  begin
    Notificar(NotificarSplash, 'Aguarde... Processando. Reatualizando saldos contábeis.');
    TdtmBasico.VerificarAtualizacaoSaldoContabil;
    Notificar(NotificarSplash, '');
  end;
end;

