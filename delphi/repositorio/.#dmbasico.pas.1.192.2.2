function VerificarECF(NotificarSplash: TtecProcParametroString): Boolean;
var
  UltimaReducaoBanco: Integer;
begin
  result := true;
  if Assigned(ECFPadrao) then
  begin
    try
      Notificar(NotificarSplash, 'Verificando situação do emissor de Cupom Fiscal');
      if ECFPadrao.CupomAberto then
        ECFPadrao.CancelarCupom;

      dtmMenuFiscal := TdtmMenuFiscal.Create(nil);
      if ECFPadrao.RequerReducaoZ then
        dtmMenuFiscal.ReducaoZ
      else
      begin
        UltimaReducaoBanco := dtmMenuFiscal.UltimaReducaoZEmitida;
        if (UltimaReducaoBanco <> 0) and
           (UltimaReducaoBanco <> strtoint(ECFPadrao.NumeroReducoes)) and false then
          dtmMenuFiscal.ReducaoZAnterior;
      end;
      dtmMenuFiscal := nil;

      if not ECFPadrao.ImpressoraLivre then
         ECFPadrao.CorrigeEstadoDeErro(false);

      if ECFPadrao.Erro then
      begin
        MensagemErro(ECFPadrao.Mensagem);
      end
      else begin
        ECFPadrao.LerAliquotasDaECF;
        if ECFPadrao.Erro then
          MensagemErro(ECFPadrao.Mensagem)
        else
          ECFPadrao.IdentificarPAF;
      end;
    except
      on E:Exception do
      begin
        ErroECF := True;
        FreeAndNil(ECFPadrao);
        MensagemErro(E.Message);
        result := false;
      end;
    end;

    Notificar(NotificarSplash, 'Registrando as formas de pagamento no ECF');
    ECFPadrao.LerFormasPagamento;
    Notificar(NotificarSplash, '');
  end;
end;
{$IFDEF MSWINDOWS}
function PendenciasTEF(NotificarSplash: TtecProcParametroString): Boolean;
var
  tecTEFDiscado: TtecTEFDiscado;
  BackupTEFDiscado: TtecBackupTEFDiscado;
  Sair: Boolean;
begin
 Result := True;
 if (ParSistema.TipoTEF = tsDISCADO) then
  if (TtecTEFDiscado.ExecutavelTEF <> '') then
  begin
    Notificar(NotificarSplash, 'Resolvendo as pendências no módulo TEFDiscado.');
    tecTEFDiscado := TtecTEFDiscado.Create;
    Sair := False;
    try
      repeat
        if tecTEFDiscado.GerenciadorAtivo(False) then
        begin
          tecTEFDiscado.CancelarUltimaTransacaoPendente;
          BackupTEFDiscado := TtecBackupTEFDiscado.Create;
          Sair := True;
          try
            if BackupTEFDiscado.ExisteArquivo(False) then
            begin
              if (ErroECF) or not(Assigned(ECFPadrao)) then
              begin
                if BackupTEFDiscado.QtdadeTransacoes = 0 then
                  BackupTEFDiscado.ApagarArquivo
                else
                  MensagemErro(ctTEFERROECFNAOCANCVENDA)
              end
              else
              begin
                try
                  BackupTEFDiscado.ExecutarBackup
                except
                  on E:Exception do
                  begin
                    FreeAndNil(ECFPadrao);
                    MensagemErro(E.Message);
                  end;
                end;
              end
            end
          finally
            BackupTEFDiscado.Free
          end
        end
      until Sair;
    finally
      tecTEFDiscado.Free;
      Notificar(NotificarSplash, '');
    end
  end
  else
  begin
    Result := False;
    MensagemErro('Executavel TefDiscado não definido!')
  end;
end;
{$ENDIF}

function PendenciaNFe(NotificarSplash: TtecProcParametroString): Boolean;
var
  ArqINI: TIniFile;
  ControleNFe: TdtmControleNotasFiscaisEletronicas;
  Docto: String;
  TipoNFe, Operacao: Integer;
begin
  Result := False;
  ArqINI := TIniFile.Create(NomeArquivoCFG);
  try
    if ArqINI.ValueExists('NFe', 'Docto') then
    begin
      Notificar(NotificarSplash, 'Resolvendo a NF-e pendente.');
      Docto    := ArqINI.ReadString('NFe','Docto','');
      if ArqINI.ReadString('NFe','Tipo','') = 'E' then
        TipoNFe  := 0
      else
        TipoNFe  := 1;

      Operacao := ArqINI.ReadInteger('NFe','Operacao',1);

      ControleNFe := TdtmControleNotasFiscaisEletronicas.Create(nil);
      try
        if ControleNFe.SelecionarNotas(TipoNFe,Operacao,'','','','','',Docto) then
        begin
          ControleNFe.SelecionarRegistro;
          Result := ControleNFe.EnviarNotasFiscais
        end
        else
        begin
          ArqINI.DeleteKey('NFe', 'Docto');
          ArqINI.DeleteKey('NFe', 'Tipo');
          ArqINI.DeleteKey('NFe', 'Operacao');
          ArqINI.UpdateFile;
        end;
        ControleNFe.FecharTabelas;
      finally
        ControleNFe.Free;
      end;

    end
    else
      Result := True;
  finally
    ArqINI.Free;
    Notificar(NotificarSplash, '');
  end;
end;

function TdtmBasico.ParametroRelatorio(ParName: String): Variant;
begin
 if      ANSIUpperCase(ParName) ='RAZAOFILIALBASE' then result := RazaoFilialBase
 else if ANSIUpperCase(ParName) ='NOMECONTADOR'    then result := ParSistema.NomeContador
 else if ANSIUpperCase(ParName) ='CPFCONTADOR'     then result := ParSistema.CPFContador
 else if ANSIUpperCase(ParName) ='CRCCONTADOR'     then result := ParSistema.CRCContador
 else if ANSIUpperCase(ParName) ='RESPONSAVEL1'    then result := ParSistema.ResponsavelLivros1
 else if ANSIUpperCase(ParName) ='RESPONSAVEL2'    then result := ParSistema.ResponsavelLivros2
 else if ANSIUpperCase(ParName) ='FOLHA_OU_PAGINA' then
       case ParSistema.LivrosFiscaisFolhaouPagina of
        0: result := ctFOLHA;
        1: result := ctPAGINA;
       end;
end;

function TdtmBasico.Atualizavel(Tabela:TtecQuery): Boolean;
var
 i: Integer;
begin
  Result := False;
  for i:=0 to Tabela.FieldCount -1 do  //verifica todos os campos, exceto o ultimaalteracao
      if (Tabela.Fields[i].AsString <> VarToStr(Tabela.Fields[i].OldValue)) and
         (Tabela.Fields[i].Name <> 'qryClientesultimaalteracao') then
      begin
        Result := True;
        Break;
      end;
end;

function TdtmBasico.ValorCampoAlterado(Campo: TField): boolean;
begin
  result := Campo.newValue <> Campo.OldValue;
end;

class function TdtmBasico.VerificarGrupoFiliais: Boolean;
var
  qryVerificarGrupoFiliais: TtecQuery;
begin
  qryVerificarGrupoFiliais := TtecQuery.Create(nil);
  qryVerificarGrupoFiliais.Database := dtmTecSoft.Database;
  if ParSistema.RelatorioSomenteFiliaisAutorizadas then
  begin
    qryVerificarGrupoFiliais.Sql.Text := verificarGruposFiliaisUsuariosSQL;
    qryVerificarGrupoFiliais.Params[0].AsInteger := UsuarioLogin.CodigoUsuario;
  end
  else
    qryVerificarGrupoFiliais.Sql.Text := verificarGruposFiliaisSQL;
  qryVerificarGrupoFiliais.Open;
  Result := qryVerificarGrupoFiliais.RecordCount > 0;
  ListaGrupoFiliais := TStringList.Create;
  qryVerificarGrupoFiliais.first;
  while not qryVerificarGrupoFiliais.Eof do
  begin
    ListaGrupoFiliais.AddObject(format('%3s',[qryverificarGrupoFiliais.fieldbyname('codigo').AsString])+'. '+qryVerificarGrupoFiliais.fieldbyname('descricao').AsString, Pointer(qryVerificarGrupoFiliais.fieldbyname('codigo').AsInteger));
    qryVerificarGrupoFiliais.Next;
  end;
  qryVerificarGrupoFiliais.Close;
end;


class function TdtmBasico.VerificarAtualizacaoSaldoContabil(ExibirMsg: Boolean = false): Boolean;

var
  qryAtualizarSaldosContabeis: TtecQuery;
begin
  result := true;
  if ParSistema.ReatualizarSaldosContabeis then
  begin
    qryAtualizarSaldosContabeis := TtecQuery.Create(nil);

    qryAtualizarSaldosContabeis.Database := dtmTecSoft.Database;
    if ExibirMsg then
      TdtmBasico.ShowProcessando('Reatualizando saldos contábeis.');

    qryAtualizarSaldosContabeis.Sql.Text := AtualizarSaldosContabeis;
    qryAtualizarSaldosContabeis.Open;
    qryAtualizarSaldosContabeis.ApplyUpdates;
    qryAtualizarSaldosContabeis.Transaction.Commit;
    qryAtualizarSaldosContabeis.Close;

    qryAtualizarSaldosContabeis.Database := dtmTecSoft.Database;
    qryAtualizarSaldosContabeis.Sql.Text := AtualizarParametroSaldo;
    qryAtualizarSaldosContabeis.ExecSql;
    qryAtualizarSaldosContabeis.ApplyUpdates;
    qryAtualizarSaldosContabeis.Transaction.Commit;
    qryAtualizarSaldosContabeis.Close;

    if ExibirMsg then
      TdtmBasico.ShowProcessando;

    ParSistema.ReatualizarSaldosContabeis := false;
  end;
end;


class function TdtmBasico.VerificarLogotipoFilialBase: string;
var
  SQL: String;
  qryLogotipos: TtecQuery;
begin
  qryLogotipos := TtecQuery.Create(nil);
  qryLogotipos.Database := dtmTecSoft.Database;
  SQL := Format(VerificarLogotipoSQL, [GetFilialBase]);
  qryLogotipos.Sql.Text := SQL;
  qryLogotipos.Open;
