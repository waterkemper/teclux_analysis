      qryDetalheDemaisDoctos.Open;

      if qryDetalheDemaisDoctos.IsEmpty then
        qryDetalheDemaisDoctos.Append
      else
        qryDetalheDemaisDoctos.Edit;

      qryDetalheDemaisDoctos.FieldByName('filial').AsInteger  := FilialBase;
      qryDetalheDemaisDoctos.FieldByName('NUM_USU').AsInteger := vNUM_USU;
      qryDetalheDemaisDoctos.FieldByName('CRO').AsInteger     := vCRO;
      qryDetalheDemaisDoctos.FieldByName('COO').AsInteger     := vCOO;
      if ReadInteger('DemaisDoctosECF','COOREF', 0) <> 0 then
        qryDetalheDemaisDoctos.FieldByName('COOREF').AsInteger:= ReadInteger('DemaisDoctosECF','COOREF', 0)
      else
        qryDetalheDemaisDoctos.FieldByName('COOREF').clear;

      if ReadInteger('DemaisDoctosECF','GNF', 0) <> 0 then
        qryDetalheDemaisDoctos.FieldByName('GNF').AsInteger   := ReadInteger('DemaisDoctosECF','GNF', 0)
      else
        qryDetalheDemaisDoctos.FieldByName('GNF').clear;

      if ReadInteger('DemaisDoctosECF','GRG', 0) <> 0 then
        qryDetalheDemaisDoctos.FieldByName('GRG').AsInteger   := ReadInteger('DemaisDoctosECF','GRG', 0)
      else
        qryDetalheDemaisDoctos.FieldByName('GRG').clear;

      if ReadInteger('DemaisDoctosECF','CDC', 0) <> 0 then
        qryDetalheDemaisDoctos.FieldByName('CDC').AsInteger   := ReadInteger('DemaisDoctosECF','CDC', 0)
      else
        qryDetalheDemaisDoctos.FieldByName('CDC').clear;

      qryDetalheDemaisDoctos.FieldByName('DENOM').AsString    := ReadString('DemaisDoctosECF','DENOMINACAO', '');
      qryDetalheDemaisDoctos.FieldByName('DT_FIN').AsDateTime := ReadDateTime('DemaisDoctosECF','DT_FIN', now());
      qryDetalheDemaisDoctos.FieldByName('HR_FIN').AsDateTime := ReadDateTime('DemaisDoctosECF','HR_FIN', now());
      qryDetalheDemaisDoctos.Post;

      if SectionExists('FormasPagamento') then
      begin
        qryFormasPagamentoECF := TtecQuery.Create(nil);
        qryFormasPagamentoECF.CachedUpdates := true;
        qryFormasPagamentoECF.RequestLive := true;
        qryFormasPagamentoECF.Database := dtmTecSoft.Database;
        qryFormasPagamentoECF.Sql.Text := SQLFormasPagamentoECF;

        qryFormasPagamentoECF.ParamByName('filial').AsInteger := FilialBase;
        qryFormasPagamentoECF.ParamByName('NUM_USU').AsInteger := vNUM_USU;
        qryFormasPagamentoECF.ParamByName('CRO').AsInteger := vCRO;
        qryFormasPagamentoECF.ParamByName('COO').AsInteger := vCOO;
        qryFormasPagamentoECF.Open;

        if qryFormasPagamentoECF.IsEmpty then
          qryFormasPagamentoECF.Append
        else
          qryFormasPagamentoECF.edit;

        qryFormasPagamentoECF.FieldByName('filial').AsInteger := FilialBase;
        qryFormasPagamentoECF.FieldByName('NUM_USU').AsInteger := vNUM_USU;
        qryFormasPagamentoECF.FieldByName('CRO').AsInteger := vCRO;
        qryFormasPagamentoECF.FieldByName('COO').AsInteger := vCOO;
        qryFormasPagamentoECF.FieldByName('NUM_ITEM').asinteger :=  ReadInteger('FormasPagamento','NUM_ITEM', 1);
        qryFormasPagamentoECF.FieldByName('MP').AsString :=  ReadString('FormasPagamento','MP', '');
        qryFormasPagamentoECF.FieldByName('VL_PAGTO').AsCurrency :=  ReadFloat('FormasPagamento','VL_PAGTO', 0.00);
        qryFormasPagamentoECF.FieldByName('IND_EST').AsString :=  ReadString('FormasPagamento','IND_EST', 'N');
        qryFormasPagamentoECF.FieldByName('VL_EST').AsCurrency :=  ReadFloat('FormasPagamento','VL_EST', 0.00);
        qryFormasPagamentoECF.Post;
      end;

      result := dmBasico.Perpetrar([qryDadosCupom, qryDetalheDemaisDoctos,
                                    qryFormasPagamentoECF{,qryAtualizaHashInclusaoExclusao}]);
      {qryAtualizaHashInclusaoExclusao.ExecSql;}
    end;
  end;
end;

function SalvarECF(CodigoECF: Integer; GT: Currency; CRO: Integer): Boolean;
const
  SQLECF = 'SELECT grandetotal, ' +
           '       intervencao  ' +
           'FROM ecfs '           +
           'WHERE codigo = :codigo';
var
   dmBasico : TdtmBasico;
   qryECF: TTecQuery;
begin
  result := false;
  dmbasico := TdtmBasico.Create(nil);

  qryECF := TtecQuery.Create(nil);
  qryECF.CachedUpdates := true;
  qryECF.RequestLive := true;
  qryECF.Database := dtmTecSoft.Database;
  qryECF.Sql.Text := SQLECF;

  qryECF.ParamByName('codigo').AsInteger := CodigoECF;
  qryECF.Open;

  qryECF.Edit;

  qryECF.FieldByName('grandetotal').AsCurrency := GT;
  if CRO > 0 then
    qryECF.FieldByName('intervencao').AsInteger := CRO;
  qryECF.Post;

  result := dmbasico.perpetrar([qryECF]);
end;

