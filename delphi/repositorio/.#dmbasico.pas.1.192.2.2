class procedure TdtmBasico.VerificarContingencias;
var
  SQL : String;
  qryContingencias: TtecQuery;
begin
  qryContingencias := TtecQuery.Create(nil);
  qryContingencias.Database := dtmTecSoft.Database;
  sql := VerificaContingencias;
  qryContingencias.Sql.Text := sql;
  qryContingencias.open;


  if qryContingencias.RecordCount > 0 then
  begin
    ParSistema.DataHoraInicialContingencia := datetimetostr(qryContingencias.fieldbyname('datahorainicial').AsDateTime);
    ParSistema.RazaoContingencia := qryContingencias.fieldbyname('razao').AsString;
  end
  else
  begin
    ParSistema.DataHoraInicialContingencia := '';
    ParSistema.RazaoContingencia := '';
  end;
  qryContingencias.Close;

end;


