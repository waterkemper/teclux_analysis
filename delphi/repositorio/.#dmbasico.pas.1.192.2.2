procedure TdtmBasico.Abre(Grupo: Integer);
var
  a: Integer;
begin
  for a := 0 to ComponentCount - 1 do
    if (Components[a] is TDataSet) and (Components[a].Tag = Grupo) then
    begin
      if Not TDataSet(Components[a]).Active then
      begin
        try
           TDataSet(Components[a]).Open;
        except
                on E: Exception do ShowMessage(E.Message);
        end;
      end;
    end
end;

procedure TdtmBasico.AfterConstruction;
var
  a: Integer;
begin
  inherited AfterConstruction;
  if Tag = 0 then
    for a := 0 to ComponentCount - 1 do
      if Components[a].Tag = ctTabelas  then
        if Components[a] is TDataSet then
          if Not TDataSet(Components[a]).Active then
            TDataSet(Components[a]).Open;
end;

procedure TdtmBasico.BeforeDelete(DataSet: TDataSet);
begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, [ctINFORMACAO])) = smbCancel then
    Abort
end;

procedure TdtmBasico.BeforeDestruction;
var
  a: Integer;
begin
  if Tag = 0 then
    for a := 0 to ComponentCount - 1 do
      if Components[a] is TDataSet and TDataSet(Components[a]).Active then begin
        if TDataSet(Components[a]).State in [dsEdit, dsInsert] then
          TDataSet(Components[a]).Cancel;
        TDataSet(Components[a]).Close;
      end;
  inherited BeforeDestruction;
end;

function TdtmBasico.CancelarAtualizacoes(ds: array of TZDataSet): Boolean;
var
  a: Integer;
begin
  try
    for a := 0 to High(ds) do
      if ds[a] is TZDataSet then
        if ds[a].UpdatesPending and ds[a].Active then begin
          ds[a].RevertRecord;
          ds[a].CancelUpdates;
        end;
    dtmTecSoft.tstTecSoft.Rollback;
    Result := True;
  except
    raise
  end;
end;

