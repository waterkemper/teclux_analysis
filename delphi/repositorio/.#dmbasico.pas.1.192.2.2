function TdtmBasico.VerificarCNPJFilial(cnpj: String): boolean;
begin
  if not assigned(qryFiliais) then
  begin
    qryFiliais    := TTecQuery.Create(nil);
    qryFiliais.Database := dtmTecSoft.Database;
    qryFiliais.Sql.Text := 'select * from filiais where cnpj = :cnpj';
  end;

  qryFiliais.Params[0].AsString := cnpj;
  qryFiliais.close;
  qryFiliais.Open;

  result := qryFiliais.recordcount <> 0;

end;

