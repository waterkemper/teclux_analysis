          (CodigoFiscal = 5117) or { Venda de mercadoria adquirida ou recebida de terceiros, originada de encomenda para entrega futura }
          (CodigoFiscal = 5118) or { Venda de produção do estabelecimento entregue ao destinatário por conta e ordem do adquirente originário, em venda à ordem }
          (CodigoFiscal = 5119) or { Venda de mercadoria adquirida ou recebida de terceiros entregue ao destinatário por conta e ordem do adquirente originário, em venda à ordem }
          (CodigoFiscal = 5120) or { Venda de mercadoria adquirida ou recebida de terceiros entregue ao destinatário pelo vendedor remetente, em venda à ordem }
          (CodigoFiscal = 5122) or { Venda de produção do estabelecimento remetida para industrialização, por conta e ordem do adquirente, sem transitar pelo estabelecimento do adquirente }
          (CodigoFiscal = 5123) or { Venda de mercadoria adquirida ou recebida de terceiros remetida para industrialização, por conta e ordem do adquirente, sem transitar pelo estabelecimento do adquirente }

          {6100 - VENDAS DE PRODUÇÃO PRÓPRIA OU DE TERCEIROS FORA DO ESTADO}
          (CodigoFiscal = 6101) or { Venda de produção do estabelecimento 6102 { Venda de mercadoria adquirida ou recebida de terceiros }
          (CodigoFiscal = 6103) or { Venda de produção do estabelecimento, efetuada fora do estabelecimento }
          (CodigoFiscal = 6104) or { Venda de mercadoria adquirida ou recebida de terceiros, efetuada fora do estabelecimento }
          (CodigoFiscal = 6105) or { Venda de produção do estabelecimento que não deva por ele transitar }
          (CodigoFiscal = 6106) or { Venda de mercadoria adquirida ou recebida de terceiros, que não deva por ele transitar }
          (CodigoFiscal = 6107) or { Venda de produção do estabelecimento, destinada a não contribuinte }
          (CodigoFiscal = 6108) or { Venda de mercadoria adquirida ou recebida de terceiros, destinada a não contribuinte }
          (CodigoFiscal = 6109) or { Venda de produção do estabelecimento, destinada à Zona Franca de Manaus ou Áreas de Livre Comércio }
          (CodigoFiscal = 6110) or { Venda de mercadoria adquirida ou recebida de terceiros, destinada à Zona Franca de Manaus ou Áreas de Livre Comércio }
          (CodigoFiscal = 6111) or { Venda de produção do estabelecimento remetida anteriormente em consignação industrial }
          (CodigoFiscal = 6112) or { Venda de mercadoria adquirida ou recebida de Terceiros remetida anteriormente em consignação industrial }
          (CodigoFiscal = 6113) or { Venda de produção do estabelecimento remetida anteriormente em consignação mercantil }
          (CodigoFiscal = 6114) or { Venda de mercadoria adquirida ou recebida de terceiros remetida anteriormente em consignação mercantil }
          (CodigoFiscal = 6115) or { Venda de mercadoria adquirida ou recebida de terceiros, recebida anteriormente em consignação mercantil }
          (CodigoFiscal = 6116) or { Venda de produção do estabelecimento originada de encomenda para entrega futura }
          (CodigoFiscal = 6117) or { Venda de mercadoria adquirida ou recebida de terceiros, originada de encomenda para entrega futura }
          (CodigoFiscal = 6118) or { Venda de produção do estabelecimento entregue ao destinatário por conta e ordem do adquirente originário, em venda à ordem }
          (CodigoFiscal = 6119) or { Venda de mercadoria adquirida ou recebida de terceiros entregue ao destinatário por conta e ordem do adquirente originário, em venda à ordem }
          (CodigoFiscal = 6120) or { Venda de mercadoria adquirida ou recebida de terceiros entregue ao destinatário pelo vendedor remetente, em venda à ordem }
          (CodigoFiscal = 6122) or { Venda de produção do estabelecimento remetida para industrialização, por conta e ordem do adquirente, sem transitar pelo estabelecimento do adquirente }
          (CodigoFiscal = 6123) or { Venda de mercadoria adquirida ou recebida de terceiros remetida para industrialização, por conta e ordem do adquirente, sem transitar pelo estabelecimento do adquirente }

          {5400 - SAÍDAS DE MERCADORIAS SUJEITAS AO REGIME DE SUBSTITUIÇÃO TRIBUTÁRIA NO ESTADO}
          (CodigoFiscal = 5401) or { Venda de produção do estabelecimento em operação com produto sujeito ao regime de substituição tributária, na condição de contribuinte substituto }
          (CodigoFiscal = 5402) or { Venda de produção do estabelecimento de produto sujeito ao regime de substituição tributária, em operação entre contribuintes substitutos do mesmo produto }
          (CodigoFiscal = 5403) or { Venda de mercadoria adquirida ou recebida de terceiros em operação com mercadoria sujeita ao regime de substituição tributária, na condição de contribuinte substituto }
          (CodigoFiscal = 5405) or { Venda de mercadoria adquirida ou recebida de terceiros em operação com mercadoria sujeita ao regime de substituição tributária, na condição de contribuinte substituído }

          {6400 - SAÍDAS DE MERCADORIAS SUJEITAS AO REGIME DE SUBSTITUIÇÃO TRIBUTÁRIA FORA DO ESTADO}
          (CodigoFiscal = 6401) or { Venda de produção do estabelecimento em operação com produto sujeito ao regime de substituição tributária, na condição de contribuinte substituto }
          (CodigoFiscal = 6402) or { Venda de produção do estabelecimento de produto sujeito ao regime de substituição tributária, em operação entre contribuintes substitutos do mesmo produto }
          (CodigoFiscal = 6403) or { Venda de mercadoria adquirida ou recebida de terceiros em operação com mercadoria sujeita ao regime de substituição tributária, na condição de contribuinte substituto }
          (CodigoFiscal = 6404) or { Venda de mercadoria sujeita ao regime de substituição tributária, cujo imposto já tenha sido retido anteriormente }

          {7100 - VENDAS DE PRODUÇÃO PRÓPRIA OU DE TERCEIROS COM EXTERIOR}

          (ComExportacoes and
           ((CodigoFiscal = 7101) or { Venda de produção do estabelecimento }
            (CodigoFiscal = 7102) or { Venda de mercadoria adquirida ou recebida de terceiros }
            (CodigoFiscal = 7105) or { Venda de produção do estabelecimento, que não deva por ele transitar }
            (CodigoFiscal = 7106) or { Venda de mercadoria adquirida ou recebida de terceiros, que não deva por ele transitar }
            (CodigoFiscal = 7127))) or { Venda de produção do estabelecimento sob o regime de "drawback" }

          {5550 - OPERAÇÕES COM BENS DE ATIVO IMOBILIZADO E MATERIAIS PARA USO OU CONSUMO }
          (CodigoFiscal = 5551) or { Venda de bem do ativo imobilizado }

          {6550 - OPERAÇÕES COM BENS DE ATIVO IMOBILIZADO E MATERIAIS PARA USO OU CONSUMO }
          (CodigoFiscal = 6551) or { Venda de bem do ativo imobilizado

          {7550 - OPERAÇÕES COM BENS DE ATIVO IMOBILIZADO E MATERIAIS PARA USO OU CONSUMO }
          (CodigoFiscal = 7551); { Venda de bem do ativo imobilizado }
end;


procedure TdtmBasico.SelecionarDadosNatureza(Natureza, Produtos: TTecQuery;
  OrigemCalculo: TtecOrigemCalculo);
begin
  Produtos.FieldByName('natureza').AsInteger     := Natureza.FieldByName('codigo').AsInteger;

  if (produtos.findfield('codigofiscal')<>nil) and
     (Natureza.findfield('codigofiscal')<>nil) then
    Produtos.FieldByName('codigofiscal').AsInteger     := Natureza.FieldByName('codigofiscal').AsInteger;

  if (produtos.findfield('descricaocodigofiscal')<>nil) and
     (Natureza.findfield('descricaocfop')<>nil) then
    Produtos.FieldByName('descricaocodigofiscal').AsString    := Natureza.FieldByName('descricaocfop').AsString;

  if (produtos.findfield('descricaonatureza')<>nil) and
     (Natureza.findfield('descricao')<>nil) then
    Produtos.FieldByName('descricaonatureza').AsString    := Natureza.FieldByName('descricao').AsString;

  if produtos.findfield('gerarpagamento')<>nil then
    Produtos.FieldByName('gerarpagamento').AsBoolean := Natureza.FieldByName('gerarpagamento').AsBoolean;

  if produtos.findfield('naogerarcreditoicms')<>nil then
    produtos.FieldByName('naogerarcreditoicms').AsBoolean := Natureza.FieldByName('naogerarcreditoicms').Asboolean;

  if produtos.findfield('naogerarcreditoipi')<>nil then
    produtos.FieldByName('naogerarcreditoipi').AsBoolean := Natureza.FieldByName('naogerarcreditoipi').Asboolean;

  if produtos.findfield('icmssobreipi')<>nil then
    produtos.FieldByName('icmssobreipi').AsBoolean := Natureza.FieldByName('icmssobreipi').Asboolean;

  if produtos.findfield('naogerardebitoicms')<>nil then
    produtos.FieldByName('naogerardebitoicms').AsBoolean := Natureza.FieldByName('naogerardebitoicms').Asboolean;

  if produtos.findfield('naocalcularvaloresicmsdiferimento')<>nil then
    produtos.FieldByName('naocalcularvaloresicmsdiferimento').AsBoolean := Natureza.FieldByName('naocalcularvaloresicmsdiferimento').Asboolean;

  if produtos.findfield('naogerardebitoipi')<>nil then
    produtos.FieldByName('naogerardebitoipi').AsBoolean := Natureza.FieldByName('naogerardebitoipi').Asboolean;

  if produtos.findfield('naocalcularipisobrefrete')<>nil then
    produtos.FieldByName('naocalcularipisobrefrete').AsBoolean := Natureza.FieldByName('naocalcularipisobrefrete').Asboolean;

  if produtos.findfield('destacarIPI')<>nil then
    Produtos.FieldByName('destacarIPI').AsBoolean  := Natureza.FieldByName('destacaripi').AsBoolean;

  Produtos.FieldByName('operacao').AsString      := Natureza.FieldByName('operacao').AsString;
  Produtos.FieldByName('tipomovimento').AsString := Natureza.FieldByName('tipomovimento').AsString;

end;

function TdtmBasico.CondicaoIPI(cstipi: String): boolean;
begin
 result := (cstipi = ctIPIEntRecCred) or   // 00 - Entrada com recuperação de crédito
           (cstipi = ctIPIEntOutras)  or   // 49 - Outras entradas
           (cstipi = ctIPISaiTributada) or // 50 - Saída tributada
           (cstipi = ctIPISaiOutras);      // 99 - Outras saídas

end;

function TdtmBasico.CondicaoPRedBC(cst, csosn: String; CRTEmitente: Integer): boolean;
begin

{
  1 – Simples Nacional;
  2 – Simples Nacional – excesso de sublimite de receita bruta;
  3 – Regime Normal. (v2.0)
}

  result := ((CRTEmitente = 1) and
             (csosn = ctSNOutrosS)) or                   { 900 Outros }

            ((CRTEmitente <> 1) and  {não é do simples}
             ((cst = ctREDUCAOBASE             ) or    { 20 Com redução de base de cálculo}
              (cst= ctDIFERIMENTO             ) or    { 51 Diferimento}
              (cst = ctREDUCAOBASESUBSTITUICAO ) or    { 70 Com redução de base de cálculo e cobrança do ICMS por substituição tributária}
              (cst = ctOUTROS                  )))     { 90 Outros}

end;

function TdtmBasico.CondicaoBaseICMS(cst, csosn: String;
  CRTEmitente: Integer;
  naocalcularvaloresicmsdiferimento: Boolean): boolean;
begin
{
  1 – Simples Nacional;
  2 – Simples Nacional – excesso de sublimite de receita bruta;
  3 – Regime Normal. (v2.0)
}

  result := ((CRTEmitente = 1) and
             (csosn = ctSNOutrosS)) or                   { 900 Outros }

            ((CRTEmitente <> 1) and  {não é do simples}
             ((cst = ctTRIBUTADA               ) or    { 00	Tributada integralmente }
              (cst = ctTRIBUTADASUBSTITUICAO    ) or    { 10	}
              (cst = ctREDUCAOBASE) or { 20 }
              ((cst = ctDIFERIMENTO) and not naocalcularvaloresicmsdiferimento ) or    { 51	Diferimento }
              (cst = ctREDUCAOBASESUBSTITUICAO ) or    { 70	Com redução de base de cálculo e cobrança do ICMS por substituição tributária }
              (cst = ctOUTROS                  )));     { 90 Outros}
end;

function TdtmBasico.Condicaopcredsn(csosn: String;
  CRTEmitente: Integer): boolean;
begin
{
  1 – Simples Nacional;
  2 – Simples Nacional – excesso de sublimite de receita bruta;
  3 – Regime Normal. (v2.0)
}

  result := ((CRTEmitente = 1) and
             ((csosn = '900') or                   { 900 Outros }
              (csosn = '101') or                   {101	Tributada pelo Simples Nacional com permissão de crédito}
              (csosn = '201')));                    {201	Tributada pelo Simples Nacional com permissão de crédito e com cobrança do ICMS por substituição tributária}

end;

function TdtmBasico.Condicaopmvast(cst, csosn: String;
  CRTEmitente: Integer;  PessoaTipo: String; VendaConsumidorFinal: Boolean): boolean;
begin

{
  1 – Simples Nacional;
  2 – Simples Nacional – excesso de sublimite de receita bruta;
  3 – Regime Normal. (v2.0)
}

  result := (((CRTEmitente = 1) and
             ((csosn = '900') or                   { 900 Outros }
              (csosn = '201') or                   {201	Tributada pelo Simples Nacional com permissão de crédito e com cobrança do ICMS por substituição tributária}
              (csosn = '202') or                   {202	Tributada pelo Simples Nacional sem permissão de crédito e com cobrança do ICMS por substituição tributária}
              (csosn = '203')))                    {203- Isenção do ICMS nos Simples Nacional para faixa de receita bruta e com cobrança do ICMS por Substituição Tributária (v.2.0)}

              or

            ((CRTEmitente <> 1) and  {não é do simples}
             ((cst = '10'    ) or    { 10	Tributada e com cobrança do ICMS por substituição tributária }
              (cst = '30'    ) or    { 30	Isenta ou não tributada e com cobrança do ICMS por substituição tributária }
              (cst = '70'    ) or    { 70	Com redução de base de cálculo e cobrança do ICMS por substituição tributária }
              (cst = '90'    ))))     { 90 Outros}

		    and (PessoaTipo='J')
        and not VendaConsumidorFinal;

end;


function TdtmBasico.CondicaoCalcularSTCustonaEntrada(cst_nf, csosn_nf, cst_produto, csosn_produto: String;
                                                EmissaoPropria: boolean; OrigemCalculo : TtecOrigemCalculo;
                                                CFOP, CRT: Integer): boolean;
begin
  result :=   (((cst_nf <> '60') and (cst_nf <> '40') and (crt <> 1)) or ((csosn_nf <> '500') and (crt = 1))) and
               not EmissaoPropria and
               (OrigemCalculo in [NotaEntrada, NotaEntradaXML]) and
                ( eHNotaFiscalEntradaCompra(cfop) or eHNotaFiscalEntradaUsoouConsumo(cfop));

  if result then
  begin
    if (regimetributario<>1) then
      result := cst_produto = '60'
    else
      result := csosn_produto = '500';
  end;
end;


