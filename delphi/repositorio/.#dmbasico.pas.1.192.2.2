SQLSubstituicao =
{Saida : UF cliente/Forn   Entrada: UF Filial}
' SELECT cast(:produto as bigint) as codigo,                               '+
'        coalesce((select eipi.fatorsubstituicao                           '+
'                  FROM  produtos p                                        '+
'                        join caracteristicas c                            '+
'                             join ipi                                     '+
'                                  join estadosipi eipi                    '+
'                                  on ipi.codigo = eipi.ipi                '+
'                                     and eipi.estado = :UF_CliForSaida_ou_FilialEntrada '+
'                             on c.ipi = ipi.codigo                        '+
'                         on p.caracteristica = c.codigo                   '+
'                  WHERE p.caracteristica = c.codigo                       '+
'                    and c.ipi = ipi.codigo                                '+
'                    and eipi.estado = :UF_CliForSaida_ou_FilialEntrada    '+
'                    and ipi.codigo = eipi.ipi                             '+
'                    and p.codigo = :produto                               '+
'                    and :TipoPessoa=''J''                                 '+
'                    and eipi.ativo), 0.0000) as fatorsubstituicao,        '+
'                                                                          '+

{Saida : UF cliente/Forn   Entrada: UF Filial
é sempre a aliquota do estado de destino}

' Selecionar_AliquotaIcms(:UF_CliForSaida_ou_FilialEntrada,:UF_CliForSaida_ou_FilialEntrada,:TipoPessoa,cast(:produto as bigint)) as AliquotaIcmsst ';
{
'        coalesce((select eicms.valor                                      '+
'                  from produtos p                                         '+
'                       join caracteristicas c                             '+
'                            join icms                                     '+
'                                 join estadosicms eicms                   '+
'                                   on icms.codigo = eicms.icms            '+
'                                      and eicms.estado = :UF_CliForSaida_ou_FilialEntrada'+
'                            on c.icms = icms.codigo                       '+
'                       on p.caracteristica = c.codigo                     '+
'                   WHERE p.caracteristica = c.codigo                      '+
'                     and c.icms = icms.codigo                             '+
'                     and icms.codigo = eicms.icms                         '+
'                     and eicms.estado = :UF_CliForSaida_ou_FilialEntrada  '+
'                     and p.codigo = :produto                              '+
'                     and :TipoPessoa = ''J''),0.00) as aliquotaicmsst     ';}


SQLValoresSTRetidosCusto =
