  function icmsbasecalculost: Currency;
  var
    vAjusteMVA, vEqualizacao: Currency;
    v_icmsbasecalculo_custo, V_fatorsubstituicao: Currency;

    (*------------------------------------------------------------------------------
     A Secretaria de Estado da Fazenda de Santa Catarina publicou o Decreto nº 306,
     de 14 de junho de 2011, o qual regulamentou, no território catarinense, o
     benefício de que trata o Convênio ICMS nº 35/2011, segundo o qual nas operações
     interestaduais, com destino a SC, se o fornecedor do outro Estado for optante
     pelo Simples Nacional, o ICMS a recolher por substituição tributária para SC
     será recolhido com a utilização da MVA Original prevista no RICMS-SC/01 para a
     mercadoria, e não com a MVA Ajustada, independentemente de a empresa adquirente
     de SC ser, ou não, optante pelo Simples Nacional.

     Esse benefício entra em vigor, no território catarinense, com efeitos
     retroativos a 1º de junho de 2011, e poderá ser utilizado juntamente com o
     benefício de redução da MVA em 70%, mas isso desde que a empresa adquirente, de
     SC, seja optante pelo Simples Nacional (Decreto nº 3.467/2010).

     Então, via de regra:

     a) se o fornecedor for do Simples Nacional e empresa adquirente não for:
        utiliza-se a a MVA Original, sem redução em 70%;

     b) se o fornecedor for do Simples Nacional e empresa adquirente também:
        utiliza-se a MVA Original reduzida em 70%;

     c) se o fornecedor não for do Simples Nacional e empresa adquirente também não for:
         utiliza-se a MVA Ajustada, sem a redução em 70%;

     d) se o fornecedor não for do Simples Nacional, e empresa adquirente é do
        Simples Nacional: utiliza-se a MVA Ajustada reduzida em 70%.
     ------------------------------------------------------------------------------*)
  begin
    result := 0;
    if  produtos.FieldByName('fatorsubstituicao').AsFloat <> 0 then
    begin
      result := ArredondarouTruncar((ifthen(produtos.FieldByName('icmsbasecalculo').AsCurrency<>0,
                                produtos.FieldByName('icmsbasecalculo').AsCurrency,
                                icmsbasecalculo(produtos)) + produtos.fieldbyname('valoripi').AsCurrency) *
                          produtos.FieldByName('fatorsubstituicao').AsFloat, -2);

      if (estadofilialbase <> notas.fieldbyname('estado').asstring) and
         (produtos.FieldByName('aliquotaicmsst').AsCurrency > produtos.FieldByName('aliquotaicms').AsCurrency) and
         not NoSimples then
        result := ArredondarouTruncar(result * (1 - produtos.FieldByName('aliquotaicms').AsCurrency/100) / (1 -produtos.FieldByName('aliquotaicmsst').AsCurrency/100),-2);
    end;
  end;

  function icmsbasecalculost_custo: Currency;
  var
    vAjusteMVA, vEqualizacao: Currency;
    v_icmsbasecalculo_custo, V_fatorsubstituicao: Currency;
  begin
    result := 0;
    if  produtos.FieldByName('fatorsubstituicao_custo').AsFloat <> 0 then
    begin
      if (produtos.FindField('aliquotaicms_custo')<>nil) then
      begin

        if RegimeTributario = 1 then
           vAjusteMVA := 1.00 - 0.70
        else
           vAjusteMVA := 1.00;

        if (notas.fieldbyname('estado').asstring = estadofilialbase)
        then vEqualizacao:= 1
        else vEqualizacao:= (1 - produtos.FieldByName('aliquotaicms_custo').AsCurrency/100) / (1 -produtos.FieldByName('aliquotaicmsst_custo').AsCurrency/100);



        v_icmsbasecalculo_custo := produtos.FieldByName('icmsbasecalculo_custo').AsCurrency;
        V_fatorsubstituicao := produtos.FieldByName('fatorsubstituicao_custo').AsFloat;


        result := ArredondarouTruncar((ifthen(produtos.FieldByName('icmsbasecalculo_custo').AsCurrency<>0,
                                  produtos.FieldByName('icmsbasecalculo_custo').AsCurrency,
                                  icmsbasecalculo(produtos,false)) + produtos.fieldbyname('valoripi').AsCurrency) *
                            ((1+ (produtos.FieldByName('fatorsubstituicao_custo').AsFloat - 1) * vAjusteMVA) * vEqualizacao), -2);


      end;
    end;
  end;

