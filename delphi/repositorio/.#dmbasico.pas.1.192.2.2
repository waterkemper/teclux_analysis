  Function AbrirTabelaCompostos: Boolean;
  begin
    result := false;

    if (Produtos.FindField('composto') <> nil) and
       (Produtos.FindField('discriminarcomposto') <> nil) and
       (Produtos.FindField('discriminarpreco') <> nil) then
    result :=  Produtos.FieldByName('composto').AsBoolean and                      // QDO FOR COMPOSTO,
              ((Produtos.FieldByName('discriminarcomposto').AsString = 'S') or    // DISCRIMINAR OS COMPONENTES,
               ((Produtos.FieldByName('discriminarcomposto').AsString = 'C') and  // COM OS PRECOS
                 Produtos.FieldByName('discriminarpreco').AsBoolean));
