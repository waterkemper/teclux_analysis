class function TdtmBasico.VerificarFiliais: Boolean;
var
  qryVerificarFiliais: TtecQuery;
begin
  qryVerificarFiliais := TtecQuery.Create(nil);
  qryVerificarFiliais.Database := dtmTecSoft.Database;
  if (ParSistema.RelatorioSomenteFiliaisAutorizadas) then
  begin
    qryVerificarFiliais.Sql.Text := verificarFiliaisUsuarioSQL;
    qryVerificarFiliais.Params[0].AsInteger := UsuarioLogin.CodigoUsuario;
  end
  else
    qryVerificarFiliais.Sql.Text := verificarFiliaisSQL;

  qryVerificarFiliais.Open;
  Result := qryVerificarFiliais.RecordCount > 0;
  ListaFiliais := TStringList.Create;

  ListaFiliaisLiberada := '';
  ListaFiliaisLiberada2 := '';
  qryVerificarFiliais.first;
  while not qryVerificarFiliais.Eof do
  begin
    ListaFiliais.AddObject(
    format('%3s',[qryverificarFiliais.fieldbyname('codigo').AsString])+'. '
      + qryVerificarFiliais.fieldbyname('nome').AsString,
        Pointer(qryVerificarFiliais.fieldbyname('codigo').AsInteger));
    ListaFiliaisLiberada := ListaFiliaisLiberada + '''' + qryverificarFiliais.fieldbyname('codigo').AsString + ''',';
    ListaFiliaisLiberada2 := ListaFiliaisLiberada2 + '''' + qryverificarFiliais.fieldbyname('codigo').AsString + ''''',''';
    qryVerificarFiliais.Next;
  end;
  if ListaFiliaisLiberada<>'' then
    ListaFiliaisLiberada := copy(ListaFiliaisLiberada,1,length(ListaFiliaisLiberada)-1);
  if ListaFiliaisLiberada2<>'' then
    ListaFiliaisLiberada2 := copy(ListaFiliaisLiberada2,1,length(ListaFiliaisLiberada2)-1);
  qryVerificarFiliais.Close;
end;

