  Procedure CalcularRateios;
  begin
    {APAGAR VALORES RATEADOS}
    if not HeImportacao then
    begin
      t:= 0;
      produtos.First;
      while not produtos.Eof do
      begin
        if EfetuarCalculosNosProdutos then
        begin
          EditarProdutos;

          if ratearfrete or
            ((numeroregistrofretealterado <> produtos.FieldByName('numero').asinteger) and
              not fretedigitado and (produtos.FieldByName('frete').asfloat<>0)) then
          begin
            Produtos.fieldbyname('frete').Clear;
            if produtos.findfield('fretedigitado')<> nil then
              produtos.fieldbyname('fretedigitado').AsBoolean := false;
          end;

          if rateardesconto or
            ((numeroregistrodescontoalterado <> produtos.FieldByName('numero').asinteger) and
              not descontodigitado and (produtos.FieldByName('desconto').asfloat<>0)) then
          begin
            Produtos.fieldbyname('desconto').Clear;
            if produtos.findfield('descontodigitado')<> nil then
              produtos.fieldbyname('descontodigitado').AsBoolean := false;
          end;

          Produtos.fieldbyname('seguro').Clear;
          Produtos.fieldbyname('acrescimo').Clear;

          if not ((OrigemCalculo = NotaAvulsa) and
                   RequerNFEntrada and
                   eHNotaFiscalSaidaDevolucao(notas.fieldbyname('codigofiscal').Asinteger, true)) then
            Produtos.fieldbyname('despesasacessorias').Clear;

          if OrigemCalculo = NotaEntrada then
          begin
            {Na nota de entrada o valor é rateado}
            Produtos.fieldbyname('icmsvalorst').Clear;
            Produtos.fieldbyname('icmsBaseCalculost').Clear;
          end;
          produtos.post;
          t := t + 1;
        end;
        produtos.next;
      end;

      {RATEAR VALORES}

      if not HeComponente then
      begin
        FreteRateado     := notas.fieldbyname(CampoNotaTotalFrete).AsCurrency;
        DescontoRateado  := notas.fieldbyname('desconto').AsCurrency;
        SeguroRateado    := notas.fieldbyname('seguro').AsCurrency;
        AcrescimoRateado := CampoNotaTotalAcrescimo;

        if not ((OrigemCalculo = NotaAvulsa) and
                RequerNFEntrada and
                eHNotaFiscalSaidaDevolucao(notas.fieldbyname('codigofiscal').Asinteger, true)) then
          DespesaRateada   := notas.fieldbyname('despesasacessorias').AsCurrency
        else
          DespesaRateada := 0;
      end
      else
      begin
        {Esta pegando dos produtoscompostos que na verdade e produtosdadosfiscais/produtoscontratos
         é o composto do componente}
        FreteRateado     := ProdutosCompostos.fieldbyname('frete').AsCurrency;
        DescontoRateado  := ProdutosCompostos.fieldbyname('desconto').AsCurrency;
        SeguroRateado    := ProdutosCompostos.fieldbyname('seguro').AsCurrency;
        AcrescimoRateado := ProdutosCompostos.fieldbyname('acrescimo').AsCurrency;
        if not ((OrigemCalculo = NotaAvulsa) and
                 RequerNFEntrada and
                 eHNotaFiscalSaidaDevolucao(notas.fieldbyname('codigofiscal').Asinteger, true)) then
          DespesaRateada   := ProdutosCompostos.fieldbyname('despesasacessorias').AsCurrency
        else
          DespesaRateada := 0;
      end;

      produtos.First;

      if ((FreteRateado     <> 0) and ratearfrete) or
         ((DescontoRateado  <> 0) and rateardesconto) or
         (SeguroRateado    <> 0) or
         (AcrescimoRateado <> 0) or
         (DespesaRateada   <> 0) then

      begin

        i := 1;
        while i <= T do
        begin

          {O composto não entra, somente os componentes e os não compostos,
           caso contrario duplicaria os valores entre composto x componentes,
           necessário optar pelos componentes devido ao fato que os impostos devem
           ser calculados por eles}

          if EfetuarCalculosNosProdutos then
          begin

            EditarProdutos;
            if (FreteRateado  > 0) and ratearfrete then
            begin
              if (i = t) then
                Produtos.fieldbyname('frete').AsCurrency := FreteRateado
              else
              begin
                if HeComponente then
                  Produtos.fieldbyname('frete').AsCurrency := ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                      ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                      produtos.fieldbyname('quantidade').AsFloat *
                                                                      ProdutosCompostos.fieldbyname('frete').AsCurrency /
                                                             (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                else
                  Produtos.fieldbyname('frete').AsCurrency := ArredondarouTruncar(PrecoUnitario(produtos) *
                                                                      Produtos.fieldbyname('quantidade').AsFloat *
                                                                      notas.fieldbyname(CampoNotaTotalFrete).AsCurrency /
                                                                      (floattocurr(TotalProdutos) + floattocurr(TotalBrinde)),-2);

                FreteRateado := FreteRateado - Produtos.fieldbyname('frete').AsCurrency;
              end;
            end;

            if SeguroRateado > 0 then
            begin
              if (i = t) then
                Produtos.fieldbyname('seguro').AsCurrency := SeguroRateado
              else
              begin
                if HeComponente then
                  Produtos.fieldbyname('seguro').AsCurrency := ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                      ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                      produtos.fieldbyname('quantidade').AsFloat *
                                                                      ProdutosCompostos.fieldbyname('seguro').AsCurrency /
                                                             (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                else
                  Produtos.fieldbyname('seguro').AsCurrency := ArredondarouTruncar(PrecoUnitario(produtos) *
                                                        Produtos.fieldbyname('quantidade').AsFloat *
                                                        notas.fieldbyname('seguro').AsCurrency /
                                                        (Floattocurr(TotalProdutos) + floattoCurr(TotalBrinde)),-2);

                SeguroRateado := SeguroRateado - Produtos.fieldbyname('seguro').AsCurrency;
              end;
            end;

            if AcrescimoRateado > 0 then
            begin
              if (i = t) then
                Produtos.fieldbyname('acrescimo').AsCurrency := AcrescimoRateado
              else
              begin
                if HeComponente then
                  Produtos.fieldbyname('acrescimo').AsCurrency := ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                      ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                      Produtos.fieldbyname('quantidade').AsFloat *
                                                                      ProdutosCompostos.fieldbyname('acrescimo').AsCurrency /
                                                            (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                else
                  Produtos.fieldbyname('acrescimo').AsCurrency := ArredondarouTruncar(PrecoUnitario(produtos) *
                                                           Produtos.fieldbyname('quantidade').AsFloat *
                                                           CampoNotaTotalAcrescimo /
                                                           (FloattoCurr(TotalProdutos) + FloattoCurr(TotalBrinde)),-2);

                AcrescimoRateado := AcrescimoRateado - Produtos.fieldbyname('acrescimo').AsCurrency;
              end;
            end;

            if (DescontoRateado > 0) and rateardesconto then
            begin
              if (i = t) then
                Produtos.fieldbyname('desconto').AsCurrency := DescontoRateado
              else
              begin
                if HeComponente then
                  Produtos.fieldbyname('desconto').AsCurrency := ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                      ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                      Produtos.fieldbyname('quantidade').AsFloat *
                                                                      ProdutosCompostos.fieldbyname('desconto').AsCurrency /
                                                            (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                else
                  Produtos.fieldbyname('desconto').AsCurrency := ArredondarouTruncar(PrecoUnitario(produtos) *
                                                                   Produtos.fieldbyname('quantidade').AsFloat *
                                                                   Notas.fieldbyname('desconto').AsCurrency /
                                                                   (FloattoCurr(TotalProdutos) + FloattoCurr(TotalBrinde)),-2);

                DescontoRateado := DescontoRateado - Produtos.fieldbyname('desconto').AsCurrency;
              end;
            end;

            if DespesaRateada > 0 then
            begin
              if (i = t) then
                Produtos.fieldbyname('despesasacessorias').AsCurrency := DespesaRateada
              else
              begin
                if HeComponente then
                  Produtos.fieldbyname('despesasacessorias').AsCurrency := ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                      ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                      Produtos.fieldbyname('quantidade').AsFloat *
                                                                      ProdutosCompostos.fieldbyname('despesasacessorias').AsCurrency /
                                                            (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                else
                  Produtos.fieldbyname('despesasacessorias').AsCurrency := ArredondarouTruncar(PrecoUnitario(produtos) *
                                                                   Produtos.fieldbyname('quantidade').AsFloat *
                                                                   notas.fieldbyname('despesasacessorias').AsCurrency /
                                                                   (FloattoCurr(TotalProdutos) + FloattoCurr(TotalBrinde)),-2);
                DespesaRateada := DespesaRateada - Produtos.fieldbyname('despesasacessorias').AsCurrency;
              end;
            end;


            Produtos.Post;

            i := i + 1;

          end;

          Produtos.Next;

        end;
      end;
    end;
  end;

begin
  result := true;
  if (produtos.fieldbyname(campoproduto).Asinteger<>0) and  ProdutoOK then
  begin

    {Totalizadores dos valores das notas fiscais}
    vBaseICMS  := 0;
    vValorICMS := 0;

    vBaseICMSST  := 0;
    vValorICMSST := 0;

    vBaseICMSSTCusto  := 0;
    vValorICMSSTCusto := 0;

    vValorIPI := 0;
    vQtdeProdutos := 0;

    vValorPIS := 0;
    vValorCOFINS := 0;

    vCredICMSSN := 0;

    vICMSSTRet := 0;
    vBCSTRet   := 0;

    vICMSBaseCalculo_dev:= 0;
    vICMSValor_dev := 0;


    vCalculosICMSBase := 0;  vCalculosICMSValor := 0; vCalculosICMSSTValor := 0; vCalculosICMSIsentas := 0;  vCalculosICMSOutras := 0;
    vCalculosIPIBase := 0;  vCalculosIPIValor := 0;  vCalculosIPIIsentas := 0;  vCalculosIPIOutras := 0;

    vvalortotalimpostoibt := 0;

    vListanotas := '';

    RegistroAtual := produtos.GetBookmark;
    EstadoProdutos := Produtos.State;
    produtos.DisableControls;

    try

    HeImportacao := false;
    if lowercase(produtos.Name) = 'qryprodutosnotafiscal' then

       {
       HeImportacao := (produtos.fieldbyname('codigofiscal').asinteger - (produtos.fieldbyname('codigofiscal').asinteger mod 1000) = 3000) and
                       (((copy(produtos.fieldbyname('codigofiscal').asString,2,1)='1') and not parsistema.ControlesVoltadosparaIndustria) or
                        (parsistema.ControlesVoltadosparaIndustria and PossuiNDI)) ;}

       HeImportacao := PossuiNDI;


    {CALCULAR TOTAL PRODUTOS}
    TotalProdutos := 0;
//    TotalProdutosST := 0;
    TotalBrinde := 0;
    vTotalPeso := 0;
    vTotalVolumes := 0;

    if calculos <> nil then
    begin
      calculos.First;
      while not calculos.Eof do
        calculos.Delete;
    end;

    EstadoNotaFiscal := notas.State;

    if not HeComponente then
    begin
      produtos.First;
      while not produtos.eof do
      begin
        if HeImportacao then
          TotalProdutos := TotalProdutos +
                           ArredondarouTruncar(
                           produtos.fieldbyname('produtototal').AsFloat,-2)
        else
        begin
          TotalProdutos := TotalProdutos +
                          ArredondarouTruncar(
                          (produtos.fieldbyname('quantidade').asfloat * PrecoUnitario(produtos)) -
                          ValorDescontoItem,-2) ;

        end;

        vTotalPeso := vTotalPeso + (produtos.fieldbyname('quantidade').asfloat * PesoProdutos(produtos));
        vTotalVolumes := vTotalVolumes + (produtos.fieldbyname('quantidade').AsInteger * VolumesProdutos(produtos));

        if lowercase(produtos.name)='qryprodutoscontratos' then
          if produtos.FieldByName('brinde').asboolean then
             TotalBrinde := TotalBrinde + (produtos.fieldbyname('quantidade').asfloat * PrecoUnitario(produtos));

        produtos.Next;
      end;

//      TotalProdutos   := ArredondarouTruncar(TotalProdutos, -2);
//      TotalProdutosST := ArredondarouTruncar(TotalProdutosST, -2);
      TotalBrinde     := ArredondarouTruncar(TotalBrinde, -2);

      if not (EstadoNotaFiscal in [dsedit, dsinsert]) then
        notas.Edit;

      if PermiteAlterarDadosICMS then
        notas.fieldbyname('valorprodutos').AsCurrency := FloatToCurr(TotalProdutos) - Floattocurr(TotalBrinde);


      if notas.FindField('peso') <> nil then
        notas.fieldbyname('peso').AsFloat :=  vTotalPeso;

      if notas.FindField('volumes') <> nil then
        notas.fieldbyname('volumes').AsInteger :=  vTotalVolumes;

      if (notas.FindField('peso') <> nil) and
         (notas.FindField('volumes') <> nil) then
        if assigned(chamadaprocedimento) then
          chamadaProcedimento;


      if notas.FindField('TotalBrindes') <> nil then
        notas.fieldbyname('TotalBrindes').AsCurrency :=  TotalBrinde;

      if (lowercase(notas.name)='qrycontratos') and
         (lowercase(produtos.name)='qryprodutoscontratos') then
        notas.fieldbyname('valoricmssubstituicao').clear
      else
      begin

        if OrigemCalculo <> NotaEntrada then
        begin
          notas.fieldbyname('baseicms').clear;
          notas.fieldbyname('valoricms').clear;

          notas.fieldbyname('totalbaseicmssubstituicao').clear;
          notas.fieldbyname('totalvaloricmssubstituicao').clear;

          notas.fieldbyname('valoripi').clear;
        end
        else
        begin
          notas.fieldbyname('baseicmscalculada').clear;
          notas.fieldbyname('valoricmscalculada').clear;

          notas.fieldbyname('baseicmssubstituicaocalculada').clear;
          notas.fieldbyname('valoricmssubstituicaocalculada').clear;

          notas.fieldbyname('valoripicalculada').clear;
        end;

        notas.fieldbyname('totalvalorpis').clear;
        notas.fieldbyname('totalvalorcofins').clear;

        notas.fieldbyname('totalprodutos').clear;


        if notas.FindField('TotalQtdeProdutos')<> nil  then
           notas.fieldbyname('TotalQtdeProdutos').clear;

        notas.fieldbyname('valorvista').clear;

        notas.fieldbyname(CampoValorNota).clear;

        notas.fieldbyname('vcredicmssn').clear;
        notas.fieldbyname('vcredicmssn').clear;

        if notas.FindField('vICMSSTRet')<>nil then
          notas.FieldByName('vICMSSTRet').clear;

        if notas.FindField('vBCSTRet')<>nil then
          notas.FieldByName('vBCSTRet').clear;

        if notas.FindField('icmsbasecalculo_dev')<>nil then
          notas.FieldByName('icmsbasecalculo_dev').clear;

        if notas.FindField('icmsvalor_dev')<>nil then
          notas.FieldByName('icmsvalor_dev').clear;


      end;

      if not (EstadoNotaFiscal in [dsedit, dsinsert]) then
        notas.post;

    end;

    if PermiteAlterarDadosICMS then
      CalcularRateios;


    if NFSaidaouEntradaPelaEmpresa then
      if not qryTributosICMSObrigacoes.Active then
        qryTributosICMSObrigacoes.Open;

    produtos.first;
    while not produtos.Eof do
    begin
      if EfetuarCalculosNosProdutos then
      begin
        if AbrirTabelaCompostos then
        begin
          if lowercase(produtos.Name) = 'qryprodutoscontratos' then
          begin
            {quando for pelo produtocontrato é aberta a consulta abaixo de compostos}
            ReFazConsultaPorNome(ProdutosCompostos, ['estadofilialbase',
                                                      'estadocfo',
                                                      'tipopessoa',
                                                      'filial',
                                                      'composto'],
                                                      [EstadoFilialBase,
                                                       notas.fieldbyname('estado').asstring,
                                                       notas.fieldbyname('pessoatipo').AsString,
                                                       produtos.fieldbyname('filial').AsString,
                                                       produtos.fieldbyname('produto').AsString]);
            CalcularImpostos(produtoscompostos,notas,true,true,true,nil,produtos,true,Contrato);
          end
          else
            {Quando for produtosdadosfiscais é utilizada a propria tabela ja alimentada}
            CalcularImpostos(produtoscompostos,notas,true,true,true,nil,produtos,true,NotaContrato);
        end;

        EditarProdutos;

        {Lei 12.741/2012 - Transparência}

        if produtos.FindField('valorimpostoimportado')<>nil then
          produtos.Fieldbyname('valorimpostoimportado').clear;

        if produtos.FindField('valorimpostonacional')<>nil then
          produtos.Fieldbyname('valorimpostonacional').clear;

        if parsistema.Lei12741_2012_Transparencia and
           (produtos.findfield('codigofiscal')<>nil) and
           eHNotaFiscalSaidaVenda(produtos.fieldbyname('codigofiscal').Asinteger) and
           (origemCalculo <> FrentedeCaixa) then
        begin
          if ehOrigemNacional then
          begin
            if (produtos.FindField('aliqnacional')<>nil) and
               (produtos.FindField('valorimpostonacional')<>nil) then

              produtos.Fieldbyname('valorimpostonacional').AsCurrency := ArredondarouTruncar(produtos.Fieldbyname('aliqnacional').AsCurrency *
			            ArredondarouTruncar(ArredondarouTruncar(Produtos.fieldbyname('quantidade').AsFloat * precounitario(produtos),-2)
                        - Produtos.FieldByName('valordescontoitem').AsCurrency
                        - Produtos.FieldByName('desconto').AsCurrency
                        + Produtos.FieldByName('acrescimo').AsCurrency
                        + Produtos.FieldByName('frete').AsCurrency
                        + Produtos.FieldByName('seguro').AsCurrency
                        { + tProdutos.FieldByName('valoripi').AsCurrency }
                       { + tprodutos.FieldByName(CampoICMSValorST).AsCurrency   }
                        + Produtos.FieldByName('despesasacessorias').AsCurrency ,-2) / 100, 2)

          end
          else
          if ehOrigemImportado then
          begin
            if (produtos.FindField('aliqimportado')<>nil) and
               (produtos.FindField('valorimpostoimportado')<>nil) then
              produtos.Fieldbyname('valorimpostoimportado').AsCurrency := ArredondarouTruncar(produtos.Fieldbyname('aliqimportado').AsCurrency *
			            ArredondarouTruncar(ArredondarouTruncar(Produtos.fieldbyname('quantidade').AsFloat * precounitario(produtos),-2)
                        - Produtos.FieldByName('valordescontoitem').AsCurrency
                        - Produtos.FieldByName('desconto').AsCurrency
                        + Produtos.FieldByName('acrescimo').AsCurrency
                        + Produtos.FieldByName('frete').AsCurrency
                        + Produtos.FieldByName('seguro').AsCurrency
                        { + tProdutos.FieldByName('valoripi').AsCurrency }
                       { + tprodutos.FieldByName(CampoICMSValorST).AsCurrency   }
                        + Produtos.FieldByName('despesasacessorias').AsCurrency ,-2) / 100, 2);

          end;
        end;

          //IPI

        { 00     | Entrada com recuperação de crédito
          49     | Outras entradas
          50     | Saída tributada
          99     | Outras saídas
        }

        if contribipi and
           (ipicst='') and
           (OrigemCalculo <> Contrato)  then
        begin
          result := false;
          MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname(campoproduto).asstring,
                        'IPI CST - Tributação do IPI']));
          break;
        end
        else
        begin
          if (ipicst = '00') or
             (ipicst = '49') or
             (ipicst = '50') or
             (ipicst = '99') then
          begin
            if not (produtos.state in [dsinsert, dsedit]) then
              produtos.Edit;

            produtos.FieldByName('ipioutras').clear;
            produtos.FieldByName('ipiisentas').clear;

            if HeImportacao then
            begin
             { SERÁ O PRÓPRIO VALOR CALCULADO }

              if NaoGerarCreditoIPI or NaoGerarDebitoIPI then
                produtos.FieldByName('ipioutras').asfloat := produtos.FieldByName('ipibasecalculo').Asfloat +
                                                                         produtos.FieldByName('valoripi').Asfloat;
            end
            else
            begin
              if not ValorIPIDigitado then
              begin
                if PermiteAlterarDadosIPI then
                begin
                  if produtos.FieldByName('aliquotaipi').AsCurrency<>0 then
                  begin

                    produtos.FieldByName('ipibasecalculo').AsCurrency :=  IPIBaseCalculo(produtos);
                    produtos.FieldByName('valoripi').AsCurrency :=
                      ArredondarouTruncar((produtos.FieldByName('ipibasecalculo').AsCurrency *
                               produtos.FieldByName('aliquotaipi').AsCurrency)/100,-2);
                  end;
                end;
              end;

              if NaoGerarCreditoIPI or NaoGerarDebitoIPI or (produtos.FieldByName('ipibasecalculo').AsCurrency=0) then
              begin
                if produtos.FieldByName('ipibasecalculo').AsCurrency=0 then
                  produtos.FieldByName('ipioutras').ascurrency := IPIBaseCalculo(produtos)
                else
                  produtos.FieldByName('ipioutras').ascurrency := ArredondarouTruncar(produtos.FieldByName('ipibasecalculo').AsCurrency +
                                                                         produtos.FieldByName('valoripi').AsCurrency,-2);
              end;

              produtos.FieldByName('ipioutras').ascurrency := produtos.FieldByName('ipioutras').ascurrency +
                                                              {produtos.FieldByName('despesasacessorias').asfloat +}
                                                              produtos.fieldbyname('acrescimo').asfloat +
                                                              ifthen(NaoCalcularIPISobreFrete,Produtos.FieldByName('frete').AsCurrency,0);

            end;
          end
          else
          {
          01     | Entrada tributada com alíquota zero
          02     | Entrada isenta
          03     | Entrada não-tributada
          04     | Entrada imune
          05     | Entrada com suspensão
          51     | Saída tributada com alíquota zero
          52     | Saída isenta
          53     | Saída não-tributada
          54     | Saída imune
          55     | Saída com suspensão
          }

          if (ipicst = '01') or
             (ipicst = '02') or
             (ipicst = '03') or
             (ipicst = '04') or
             (ipicst = '05') or
             (ipicst = '51') or
             (ipicst = '52') or
             (ipicst = '53') or
             (ipicst = '54') or
             (ipicst = '55') or
             (ipicst = '') then
          begin
            if not (produtos.state in [dsinsert, dsedit]) then
              produtos.Edit;

            produtos.FieldByName('ipioutras').clear;
            produtos.FieldByName('ipiisentas').clear;


            if HeImportacao then
              produtos.FieldByName('ipioutras').asfloat := produtos.FieldByName('ipibasecalculo').Asfloat +
                                                           produtos.FieldByName('valoripi').Asfloat
            else
            begin
              if produtos.FieldByName('ipibasecalculo').AsCurrency<>0 then
                produtos.FieldByName('ipioutras').ascurrency := ArredondarouTruncar(produtos.FieldByName('ipibasecalculo').AsCurrency +
                                                                         produtos.FieldByName('valoripi').AsCurrency,-2)
              else
                produtos.FieldByName('ipioutras').ascurrency :=  IPIBaseCalculo(produtos);

              produtos.FieldByName('ipioutras').ascurrency := produtos.FieldByName('ipioutras').ascurrency +
                                                              {produtos.FieldByName('despesasacessorias').asfloat +}
                                                              produtos.fieldbyname('acrescimo').asfloat +
                                                              ifthen(NaoCalcularIPISobreFrete,Produtos.FieldByName('frete').AsCurrency,0);
            end;

            if PermiteAlterarDadosIPI then
            begin
              produtos.FieldByName('ipibasecalculo').clear;
              //produtos.FieldByName('aliquotaipi').clear;
              produtos.FieldByName('valoripi').clear;
            end;

          end;

          if HeImportacao then
          begin
            produtos.FieldByName('ipioutras').AsCurrency := ArredondarouTruncar(
              produtos.FieldByName('ipioutras').AsCurrency +
              Produtos.fieldbyname('naotribipi').asCurrency +
              Produtos.fieldbyname('despesasacessorias').asCurrency -
              Produtos.fieldbyname('embalagem').asCurrency -
              Produtos.fieldbyname('thc').asCurrency, -2);

            produtos.FieldByName('ipiisentas').AsCurrency :=
              produtos.FieldByName('ipiisentas').AsCurrency +
              Produtos.fieldbyname('icmsvalor').asCurrency;
          end;
        end;

        //ICMS

        if ((crt = 1) and
            ((csosn_nf='') or
            (NFSaidaouEntradaPelaEmpresa and (qryTributosICMSObrigacoes.FindField('SN'+csosn_nf) = nil)))) then
        begin
          result := false;
          if NFSaidaouEntradaPelaEmpresa then
            MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname(campoproduto).asstring,
                          'ICMS CSOSN - Tributação no simples nacional']));
          break;
        end
        else
        if ((crt <> 1) and
          ((cst_nf='') or
          (NFSaidaouEntradaPelaEmpresa and (qryTributosICMSObrigacoes.FindField('CST'+cst_nf) = nil)))) then
        begin
          result := false;
          if NFSaidaouEntradaPelaEmpresa then
            MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname(campoproduto).asstring,
                          'ICMS CST - Tributação do icms ']));
          break;
        end
        else
        begin

          if not icmsoutrasDigitado then
            produtos.FieldByName('icmsoutras').clear;

          produtos.FieldByName('icmsisentas').clear;

          if not ValorICMSDigitado then
          begin
            if CondicaoPRedBC(cst_nf,
                              csosn_nf,
                              crt) then
            begin
              if PermiteAlterarDadosICMS then
              begin
                produtos.fieldbyname(CampoValorReducaoBase).AsCurrency   := reducaobase;
                if produtos.fieldbyname('percentualreducaobase').IsNull then
                  produtos.fieldbyname('percentualreducaobase').AsCurrency := 0;
              end;

              if produtos.findfield('valorreducaobase_custo')<>nil then
                produtos.fieldbyname('valorreducaobase_custo').AsCurrency   := reducaobase_custo;

              if produtos.findfield('percentualreducaobase_custo')<>nil then
                if produtos.fieldbyname('percentualreducaobase_custo').IsNull then
                  produtos.fieldbyname('percentualreducaobase_custo').AsCurrency := 0;

            end
            else
            begin
              if PermiteAlterarDadosICMS then
              begin
                produtos.fieldbyname(CampoValorReducaoBase).clear;
                produtos.fieldbyname('percentualreducaobase').clear;
              end;

              if produtos.findfield('valorreducaobase_custo')<>nil then
                produtos.fieldbyname('valorreducaobase_custo').AsCurrency   := reducaobase_custo;

              if produtos.findfield('percentualreducaobase_custo')<>nil then
                if produtos.fieldbyname('percentualreducaobase_custo').IsNull then
                  produtos.fieldbyname('percentualreducaobase_custo').AsCurrency := 0;
            end;


            if PermiteAlterarDadosICMS then
            begin
              if CondicaoBaseICMS(cst_nf,
                                  csosn_nf,
                                  crt, naocalcularvaloresicmsdiferimento) then
              begin
                produtos.FieldByName('icmsbasecalculo').AsCurrency  := icmsbasecalculo(produtos);
                if produtos.FieldByName('icmsbasecalculo').AsCurrency <> 0 then
                  produtos.FieldByName('icmsbasecalculo').AsCurrency   := icmsbasecalculo(produtos) - produtos.fieldbyname(CampoValorReducaoBase).AsCurrency;

                produtos.FieldByName('icmsvalor').AsCurrency         := icmsvalor;
                if produtos.FieldByName('aliquotaicms').IsNull then
                  produtos.FieldByName('aliquotaicms').AsCurrency := 0;
              end
              else
              begin
                produtos.FieldByName('icmsbasecalculo').clear;
                produtos.FieldByName('icmsvalor').clear;
              end;
            end;
          end;


          if NFSaidaouEntradaPelaEmpresa then
          begin
            if Condicaopcredsn(csosn_nf, RegimeTributario) then
            begin
              produtos.FieldByName('pCredSN').AsCurrency     := AliquotaICMSSN;
              produtos.FieldByName('vCredICMSSN').AsCurrency := CredICMSSN;
            end
            else
            begin
              produtos.FieldByName('vCredICMSSN').clear;
              produtos.FieldByName('pCredSN').clear;
            end;
          end;

          if not ValorICMSSTDigitado then
          begin
            if CondicaopMVAST(cst_nf,
                              csosn_nf,
                              crt,PessoaTipo,VendaConsumidorFinal) then
            begin
              if  PermiteAlterarDadosICMS then
              begin
                produtos.FieldByName('fatorsubstituicao').AsFloat := FatorSubstituicao(EstadoSubstituicao);

                if not saida then
                  if produtos.FieldByName('fatorsubstituicao').AsFloat <= 1 then
                    MensagemErro(format('O produto %s não possui o percentual do MVA para o cálculo do valor da st.',[produtos.FieldByName(campoprodutovisual).AsString]));

                produtos.FieldByName('AliquotaICMSST').AsCurrency := AliquotaICMSST(EstadoSubstituicao);
                if produtos.findfield('pmvast')<>nil then
                begin
                  if produtos.FieldByName('fatorsubstituicao').AsFloat > 1 then
                    Produtos.fieldbyname('pmvast').AsCurrency := abs((1 - produtos.FieldByName('fatorsubstituicao').AsFloat) * 100)
                  else
                    Produtos.fieldbyname('pmvast').AsCurrency := 0;
                end;

                produtos.fieldbyname('reducaobasest').AsCurrency     := ReducaoBaseST;
                produtos.FieldByName('ICMSBaseCalculoST').AsCurrency := icmsbasecalculost - produtos.fieldbyname('reducaobasest').AsCurrency;
                produtos.FieldByName('ICMSValorST').AsCurrency    := IcmsValorST;

                if produtos.fieldbyname('pRedBCST').IsNull then
                  produtos.fieldbyname('pRedBCST').AsCurrency := 0;

                if produtos.FieldByName('ICMSValorST').AsCurrency > 0 then
                    produtos.FieldByName('ICMSValorST').AsCurrency       := produtos.FieldByName('ICMSValorST').AsCurrency - produtos.FieldByName('icmsvalor').AsCurrency;
              end;


            end
            else
            begin
              if PermiteAlterarDadosICMS then
              begin
                produtos.FieldByName('fatorsubstituicao').AsCurrency := 0;
                if produtos.findfield('pmvast')<>nil then
                  Produtos.fieldbyname('pmvast').AsCurrency := 0;

                produtos.FieldByName('AliquotaICMSST').AsCurrency    := 0;

                if produtos.fieldbyname('pRedBCST').IsNull then
                  produtos.fieldbyname('pRedBCST').AsCurrency := 0;

                produtos.fieldbyname('reducaobasest').AsCurrency     := 0;

                produtos.FieldByName('ICMSBaseCalculoST').AsCurrency := 0;
                produtos.FieldByName('ICMSValorST').AsCurrency       := 0;
              end;
            end;

            if (OrigemCalculo in [NotaEntrada, NotaEntradaXML]) and
                CondicaoCalcularSTCustonaEntrada(cst_nf, csosn_nf, cst_produto, csosn_produto, EmissaoPropria, OrigemCalculo, produtos.fieldbyname('codigofiscal').asinteger, crt) then
            begin
              produtos.FieldByName('fatorsubstituicao_custo').AsFloat := FatorSubstituicao(EstadoSubstituicao);

              if produtos.FieldByName('fatorsubstituicao_custo').AsFloat <= 1 then
                MensagemErro(format('O produto %s não possui o percentual do MVA para o cálculo do valor da st do custo.',[produtos.FieldByName(campoprodutovisual).AsString]));

              produtos.FieldByName('aliquotaicmsst_custo').AsCurrency := AliquotaICMSST(EstadoSubstituicao);
              if produtos.FieldByName('icmsbasecalculo').AsCurrency<>0 then
                produtos.FieldByName('icmsbasecalculo_custo').AsCurrency   := produtos.FieldByName('icmsbasecalculo').AsCurrency
              else
              begin
                produtos.FieldByName('icmsbasecalculo_custo').AsCurrency   := icmsbasecalculo(produtos, false);
                if produtos.FieldByName('icmsbasecalculo_custo').AsCurrency <> 0 then
                  produtos.FieldByName('icmsbasecalculo_custo').AsCurrency   := icmsbasecalculo(produtos, false) - produtos.fieldbyname('valorreducaobase_custo').AsCurrency;
              end;

              if produtos.FieldByName('aliquotaicms').AsCurrency<>0 then
                produtos.FieldByName('aliquotaicms_custo').AsCurrency := produtos.FieldByName('aliquotaicms').AsCurrency
              else
                produtos.FieldByName('aliquotaicms_custo').AsCurrency := AliquotaICMS(notas.fieldbyname('estado').asstring,EstadoFilialBase);

              produtos.FieldByName('icmsvalor_custo').AsCurrency := ArredondarouTruncar((produtos.FieldByName('icmsbasecalculo_custo').AsCurrency *
                                                                             produtos.FieldByName('aliquotaicms_custo').AsCurrency)/100,-2);

              if (produtos.findfield('aliquotaicmsst_custo')<>nil) and
                ((notas.fieldbyname('estado').asstring = EstadoFilialBase) and
                 (produtos.FieldByName('AliquotaICMSST_custo').AsCurrency <> produtos.FieldByName('AliquotaICMS_custo').AsCurrency)) or
                ((notas.fieldbyname('estado').asstring <> EstadoFilialBase) and
                 (produtos.FieldByName('AliquotaICMSST_custo').AsCurrency < produtos.FieldByName('AliquotaICMS_custo').AsCurrency)) then
              begin
                if msgDifAliquotaICMS then
                  MensagemAviso(format('A discrepância entre as alíquotas de ICMS da NF e do cadastro do produto %s'+#13+
                                       'Será considerada a alíquota da NF',[produtos.FieldByName('produto').AsString]));

                 produtos.FieldByName('AliquotaICMSST_custo').AsCurrency := produtos.FieldByName('AliquotaICMS_custo').AsCurrency;

              end;

              produtos.fieldbyname('valorreducaobasest_custo').AsCurrency     := ReducaoBaseST_Custo;
              produtos.FieldByName('ICMSBaseCalculoSTcusto').AsCurrency := icmsbasecalculost_custo - produtos.fieldbyname('valorreducaobasest_custo').AsCurrency;
              produtos.FieldByName('ICMSValorSTCusto').AsCurrency    := IcmsValorST_Custo;

              if produtos.FieldByName('ICMSValorSTCusto').AsCurrency > 0 then
              begin
                vValor1 := produtos.FieldByName('ICMSValorSTCusto').AsCurrency;
                vValor2 := produtos.FieldByName('icmsvalor_custo').AsCurrency;
                produtos.FieldByName('ICMSValorSTCusto').AsCurrency       := produtos.FieldByName('ICMSValorSTCusto').AsCurrency - produtos.FieldByName('icmsvalor_custo').AsCurrency;
              end;

            end
            else
            begin
                {Existindo o cálculo da st na nota fiscal ou o emissor não deveria emitir st caso o estado
                 destino não tenha st ou o cadastro de produtos esta errado pois deveria estar 500 ou 60}

              if (OrigemCalculo in [NotaEntrada, NotaEntradaXML]) and
                 CondicaopMVAST(cst_nf,
                                csosn_nf,
                                crt,PessoaTipo,VendaouCompraConsumidorFinal) then
              begin
                if ((regimetributario = 1) and (csosn_produto <> '500')) or
                   ((regimetributario <> 1) and (cst_produto <> '60')) then
                begin
                  MensagemErro(format('O produto %s está com ST na nota fiscal, mas não no seu cadastro',[produtos.fieldbyname(campoprodutovisual).asstring]));
                  result := false;
                  break;
                end;
              end;

              if produtos.FindField('fatorsubstituicao_custo')<>nil then
                produtos.FieldByName('fatorsubstituicao_custo').AsCurrency := 0;

              if produtos.findfield('aliquotaicmsst_custo')<>nil then
                produtos.FieldByName('aliquotaicmsst_custo').AsCurrency := 0;

              if produtos.findfield('pRedBCST_custo')<>nil then
                produtos.fieldbyname('pRedBCST_custo').AsCurrency := 0;

              if produtos.FindField('valorreducaobasest_custo')<>nil then
                produtos.fieldbyname('valorreducaobasest_custo').AsCurrency     := 0;

              if produtos.FindField('ICMSBaseCalculoSTCusto')<>nil then
                produtos.FieldByName('ICMSBaseCalculoSTCusto').AsCurrency := 0;

              if produtos.FindField('ICMSValorSTCusto')<>nil then
                produtos.FieldByName('ICMSValorSTCusto').AsCurrency := 0;

              if produtos.FindField('aliquotaicms_custo')<>nil then
                produtos.FieldByName('aliquotaicms_custo').AsCurrency := 0;

              if produtos.FindField('icmsbasecalculo_custo')<>nil then
                produtos.FieldByName('icmsbasecalculo_custo').AsCurrency   := 0;

              if produtos.FindField('icmsvalor_custo')<>nil then
                produtos.FieldByName('icmsvalor_custo').AsCurrency := 0;
            end;
          end;

          if CondicaovBCSTRet(cst_nf,
                              csosn_nf,
                              crt) and NFSaidaouEntradaPelaEmpresa  then
          begin
            if PermiteAlterarDadosICMS then
              AtribuirValoresRetidosST
          end
          else
          if NFSaidaouEntradaPelaEmpresa then
          begin
            if PermiteAlterarDadosICMS then
            begin
              if produtos.FindField('vBCSTRet')<>nil then
                produtos.FieldByName('vBCSTRet').clear;

              if produtos.FindField('vICMSSTRet')<>nil then
                produtos.FieldByName('vICMSSTRet').clear;
            end;

            if produtos.FindField('icmsbasecalculo_dev')<>nil then
              produtos.FieldByName('icmsbasecalculo_dev').clear;

            if produtos.FindField('icmsvalor_dev')<>nil then
              produtos.FieldByName('icmsvalor_dev').clear;
          end;

         if (OrigemCalculo = NotaAvulsa) and RequerNFEntrada then
            if pos(produtos.fieldbyname('NumeroNotaFiscalEntrada').AsString, vListanotas)=0 then
               vListanotas := vListanotas + ifthen(vListanotas<>'','/','') + produtos.fieldbyname('NumeroNotaFiscalEntrada').AsString;


          if not icmsoutrasDigitado then
          begin
            {
            if ((csosn_empresa <> '900') and (crt=1)) or
               ((csosn_empresa = '900') and not CondicaoBaseICMS(cst_nf, csosn_nf, crt, naocalcularvaloresicmsdiferimento)) or

               ((((cst_empresa = ctDIFERIMENTO) and  not NFSaidaouEntradaPelaEmpresa ) or  // 51
                 ((cst_empresa = ctDIFERIMENTO) and Saida and naocalcularvaloresicmsdiferimento) or
                 (cst_empresa = ctSUSPENSAO          ) or // 50
                 (cst_empresa = ctCOBRADOSUSTITUICAO)) and (crt<>1)) or

