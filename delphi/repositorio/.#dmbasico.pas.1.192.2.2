        MensagemErro(format(ctCONTAPADRAONAOVINCULADA,[FilialContasEntradas[tipo]]));
      end;
    end;
  end;

begin
  vRegistroAtualDuplicata := qryDuplicatas.GetBookmark;
  result := true;
  LancamentosContas := nil;
  if ParSistema.GeracaoAutomaticadoImpostoRetido then
  begin
    if not previsao then
    begin

      ReFazConsulta(qryVenctosImpostosRetidosEntradas,[0],
                    [qryDocumentosPag.FieldByName('filialemissao').AsVariant]);

      if (qrydocumentospag.FindField('documentopagorigem') = nil) or
         (qryDocumentosPag.FieldByName('documentopagorigem').isnull) then
      begin

       ReFazConsulta(qryContasEntradasFiliais,[0,1],
          [qryDocumentosPag.fieldbyname('fornecedorparaiss').Asinteger,
           qryDocumentosPag.fieldbyname('filialemissao').Asinteger]);

        if (qryVenctosImpostosRetidosEntradas.Locate('descricao','ISS retido',[])) then
          if qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').IsNull then
            if qryDocumentosPag.fieldbyname('fornecedorparaiss').asinteger<>0 then
            begin
              qryVenctosImpostosRetidosEntradas.Edit;
              qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').AsInteger := qryDocumentosPag.fieldbyname('fornecedorparaiss').asinteger;
              qryVenctosImpostosRetidosEntradas.FieldByName('tipofornecedor').AsString := 'F';
              qryVenctosImpostosRetidosEntradas.post;
            end;

        valorimpostorateado := 0;

        qryduplicatas.First;
        while not qryduplicatas.Eof do
        begin
          result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('irretido').AsCurrency, lceIRRetido);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('inssretido').AsCurrency, lceINSSRetido);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('issretido').AsCurrency, lceISSRetido);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('pisretido').AsCurrency, lcePISRetido);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('cofinsretido').AsCurrency, lceCOFINSretida);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('csllretido').AsCurrency, lceCSLLretida);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('piscofinscsllretido').AsCurrency, lcePIS_COFINS_CSLL);

          if result then
            qryduplicatas.Next
          else
            break;
        end;



        if result and (origem = CadastroDuplicatas) then
        begin
          result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('irretido').AsCurrency, lceIRRetido);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('inssretido').AsCurrency, lceINSSRetido);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('issretido').AsCurrency, lceISSRetido);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('pisretido').AsCurrency, lcePISRetido);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('cofinsretido').AsCurrency, lceCOFINSretida);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('csllretido').AsCurrency, lceCSLLretida);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('piscofinscsllretido').AsCurrency, lcePIS_COFINS_CSLL);
        end;
      end
      else
      begin
        if Situacao = VALIDAR then
        begin
          if (qryVenctosImpostosRetidosEntradas.Locate('descricao',qryDocumentospag.fieldbyname('referencia').AsString,[])) then
             if qryDocumentospag.FieldByName('fatogerador').AsString <> qryVenctosImpostosRetidosEntradas.FieldByName('ocasiao').AsString then
                result := MensagemConfirmacao(
                    format('O documento gerado ''%s - %s'' esta inconsistente com os parâmetros do sistema.'+#10#13+
                           'Fato gerador atual: ''No lançto da NF'''+#10#13+
                           'Fato gerador configurado: ''No pagamento da duplicata'''+#10#13+
                           'Sugestão: desquite este pagamento e gere novamente acessando o documento original.',
                           [qryDocumentosPag.fieldbyname('numero').asstring,
                            qryDocumentospag.fieldbyname('referencia').AsString])) = smbOK;
        end;
      end;
    end
    else
    begin
      if situacao = GRAVAR then
      begin
        qryDocumentosPagImpostosRetidos.First;
        while not qryDocumentosPagImpostosRetidos.Eof do
          qryDocumentosPag.Delete;
      end;
    end;
  end;
  qryduplicatas.GotoBookmark(vRegistroAtualDuplicata);
  qryduplicatas.FreeBookmark(vRegistroAtualDuplicata);
end;

function TdtmBasico.RetornaZero: currency;
begin
  result := 0;
end;

class procedure TdtmBasico.ShowProcessando(Mensagem: String = '');
begin
  if mensagem = '' then
  begin
    if Assigned(frmProcessando) then
    begin
      frmProcessando.Close;
      frmProcessando.free;
    end;
  end
  else
  begin
    if not Assigned(frmProcessando) then
      frmProcessando := TfrmProcessando.Create(Application);

    frmProcessando.Mensagem := Mensagem;
    frmProcessando.Show;
    Application.ProcessMessages;
  end;
end;

procedure TdtmBasico.LimparTabela(ds: TZDataSet);
begin
  ds.disablecontrols;
  ds.First;
  while not ds.eof do
    ds.delete;
  ds.enablecontrols;
end;

function TdtmBasico.ValidarImpostosRetidosSaidas(irretido, inssretido,
  issretido, pisretido, cofinsretido, csllretido: Currency;
  TabelaLancamentos, TabelaLanctosFiliais, TabelaLanctosNatureza: TtecQuery): boolean;

  function ValidarValor(Tipo: TtecLancamentosContasSaidas):boolean;
  var
   descricaoconta : String;
  begin
    result := false;
    descricaoconta := FilialContasSaidas[Tipo];
    if TabelaLanctosFiliais.Locate('descricao',descricaoconta,[]) then
    begin
      result := true;
      if TabelaLanctosFiliais.fieldbyname('regime').asstring = 'COMPETÊNCIA' then
      begin
        if TabelaLanctosFiliais.fieldbyname('contacontabil').AsInteger <> 0 then
        begin
          descricaoconta := TabelaLanctosFiliais.fieldbyname('descricaocontacontabil').Asstring;
          if TabelaLancamentos.Locate('contacontabil', TabelaLanctosFiliais.fieldbyname('contacontabil').AsInteger, []) then
            result := TabelaLancamentos.FieldByName('valordebito').ascurrency<>0;
          if not result then
            MensagemErro(format(ctLANCAMENTOOBRIGATORIO,[ANSIUpperCase(descricaoconta),ANSIUpperCase(ctDEBITO)]));
        end
        else
          MensagemErro(format(ctCONTAPADRAONAOVINCULADA,[ANSIUpperCase(descricaoconta)]));
      end;
    end;
  end;

  function ValidarValorISS(tipo: TtecLancamentosNaturezas):boolean;
  var
   descricaoconta : String;
  begin
    result := false;
    descricaoconta := vstrLancamentosNaturezas[Tipo];
    if TabelaLanctosNatureza.Locate('descricao',descricaoconta ,[]) then
    begin
      descricaoconta := TabelaLanctosNatureza.fieldbyname('descricaocontacontabil').Asstring;
      if TabelaLancamentos.Locate('contacontabil', TabelaLanctosNatureza.fieldbyname('contacontabil').AsInteger, []) then
        result := TabelaLancamentos.FieldByName('valordebito').ascurrency<>0;
      if not result then
        MensagemErro(format(ctLANCAMENTOOBRIGATORIO,[ANSIUpperCase(descricaoconta),ANSIUpperCase(ctDEBITO)]));
    end
    else
      MensagemErro(format(ctCONTAPADRAOISSNAOVINCULADA,[ANSIUpperCase(descricaoconta)]));
  end;


begin
  result := true;
  if irretido<>0 then
    result := ValidarValor(lcsIRRFaCompensar);

  if result then
    if inssretido<>0 then
      result := ValidarValor(lcsINSSacompensar);

  if result then
    if pisretido<>0 then
      result := ValidarValor(lcsPISaCompensar);

  if result then
    if cofinsretido<>0 then
      result := ValidarValor(lcsCOFINSacompensar);

  if result then
    if csllretido<>0 then
      result := ValidarValor(lcsCSLLacompensar);

  if result then
    if issretido<>0 then
      result := ValidarValorISS(lnDespesasISS);

end;

