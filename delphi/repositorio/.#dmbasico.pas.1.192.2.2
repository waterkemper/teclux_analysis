end;

function  TdtmBasico.NotaNormal(Incidencia: String): Boolean;
begin
  Result:= ((Incidencia = ctTRIBUTADA)    or
            (Incidencia = ctREDUCAOBASE)  or
            (Incidencia = ctISENTA)       or
            (Incidencia = ctNAOTRIBUTADA) or
            (Incidencia = ctSUSPENSAO)    or
            (Incidencia = ctDIFERIMENTO));
end;


function  TdtmBasico.NotaSubstituicao(Incidencia: String; Entrada: Boolean = True): Boolean;
begin
  if regimetributario = 1 then
    result := (incidencia = ctSNTributadaSNCPCCST) or // '201' Tributada pelo Simples Nacional com permissão de crédito e com cobrança do ICMS por substituição tributária
              (incidencia = ctSNTributadaSNSPCCST) or // '202' Tributada pelo Simples Nacional sem permissão de crédito e com cobrança do ICMS por substituição tributária
              (incidencia = ctSNIsencaoSNFRBCST  ) or // '203' Isenção do ICMS no Simples Nacional para faixa de receita bruta e com cobrança do ICMS por substituição tributária
              ((incidencia = ctSNICMSCobAntST) and Entrada) or // '500' ICMS cobrado anteriormente por substituição tributária (substituído) ou por antecipação
              (incidencia = ctSNOutrosS)  // '900' Outros

  else
    Result:= (Incidencia = ctTRIBUTADASUBSTITUICAO) or      {10}
             (Incidencia = ctISENTASUBSTITUICAO)    or      {30}
             ((Incidencia = ctCOBRADOSUSTITUICAO) and Entrada)    or      {60}
             (Incidencia = ctREDUCAOBASESUBSTITUICAO) or    {70}
             (Incidencia = ctOUTROS);                      {90}
end;



function TdtmBasico.GetNDiasLimiteLancto: integer;
begin
  if ParSistema.DataContabilString<>'' then
    result := DaysBetween(DataLocal,ParSistema.DataContabil) - 1
  else
    result := ParSistema.DiasNotaRetroativa;
end;

