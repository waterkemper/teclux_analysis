function TdtmBasico.NdiasLimiteData(DataInicial: String): Integer;
var
  NDias : Integer;
begin
  result := NDiasLimiteEmissao;
  if DataInicial<>'' then
  begin
    Ndias := DaysBetween(DataServidor, strtodate(DataInicial));
