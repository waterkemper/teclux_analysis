       qryDuplicatasImpostosRetidos.FieldByName('documentopag').AsInteger := qryDocumentosPagImpostosRetidos.FieldByName('numero').AsInteger;
       qryDuplicatasImpostosRetidos.FieldByName('datavencto').AsDateTime :=
