class function TdtmBasico.Estoques_Preco(produto: String; filial: integer;
  Markup: Currency): Currency;
var
  qryEstoques_Preco: TtecQuery;
begin
  qryEstoques_Preco := TtecQuery.Create(nil);
  qryEstoques_Preco.Database := dtmTecSoft.Database;
  qryEstoques_Preco.Sql.Text := 'select estoques_preco(cast(:produto as bigint), :filial, :Markup) as preco';
  qryEstoques_Preco.ParamByName('produto').asString := produto;
  qryEstoques_Preco.ParamByName('filial').asinteger := filial;
  qryEstoques_Preco.ParamByName('Markup').asCurrency := Markup;
  qryEstoques_Preco.Open;
  Result := qryEstoques_Preco.Fields[0].AsCurrency;
  qryEstoques_Preco.free;
end;

