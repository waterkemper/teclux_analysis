    DataSet.Cancel
end;

function TdtmBasico.ExisteCodigo(Tabela: TZDataSet; NomeCampo, Codigo: String;
  Parcial: Boolean = True; Sensivel: Boolean = True): boolean;
var
  Opcoes: TLocateOptions;
  Encontrou: Boolean;
  valor : String;
  RegistroAtual: TBookMark;
begin
  try
    Encontrou := False;
    Opcoes := [];
    if Parcial then
      Opcoes := Opcoes + [loPartialKey];
    if Sensivel then
      Opcoes := Opcoes + [loCaseInsensitive];
    case tabela.FieldByName(NomeCampo).DataType of
      ftDateTime, ftDate:
      begin
        RegistroAtual := tabela.GetBookmark;
        Tabela.First;
        while not tabela.Eof do
        begin
          valor := copy(tabela.fieldbyname(NomeCampo).AsString,0,length(trim(codigo)));
          if valor = trim(codigo) then
          begin
            encontrou := true;
            break;
          end
          else
            tabela.Next;
        end;

        if encontrou then
          result := true
        else
        begin
          tabela.GotoBookmark(RegistroAtual);
          result := false;
        end;
        tabela.FreeBookmark(RegistroAtual);

//        Tabela.Locate(NomeCampo, StrtoDateTime(Codigo), Opcoes);
      end;
    else
      Result := Tabela.Locate(NomeCampo, Codigo, Opcoes);
    end
  except
    Result := False
  end
end;

