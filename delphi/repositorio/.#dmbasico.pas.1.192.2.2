function TdtmBasico.ValidarImpostosRetidos(irretido, inssretido,
                                 issretido, pisretido,
                                 cofinsretido, csllretido, piscofinscsllretido: Currency;
                                 TabelaLancamentos,
                                 TabelaLanctosFiliais: TtecQuery): boolean;

  function ValidarValor(Tipo: TtecLancamentosContasEntradas):boolean;
  var
   descricaoconta : String;
  begin
    result := false;
    descricaoconta := FilialContasEntradas[Tipo];
    if TabelaLanctosFiliais.Locate('descricao',descricaoconta ,[]) then
    begin
      descricaoconta := TabelaLanctosFiliais.fieldbyname('descricaocontacontabil').Asstring;

      if descricaoconta='' then
        descricaoconta := FilialContasEntradas[Tipo];

      if TabelaLancamentos.Locate('contacontabil', TabelaLanctosFiliais.fieldbyname('contacontabil').AsInteger, []) then
        result := TabelaLancamentos.FieldByName('valorcredito').ascurrency<>0;
      if not result then
        MensagemErro(format(ctLANCAMENTOOBRIGATORIO,[ANSIUpperCase(descricaoconta),ANSIUpperCase(ctcredito)]));
    end
    else
      MensagemErro(format(ctCONTAPADRAONAOVINCULADA,[ANSIUpperCase(descricaoconta)]));
  end;

begin
  result := true;
  if irretido<>0 then
    result := ValidarValor(lceIRRetido);

  if result then
    if inssretido<>0 then
      result := ValidarValor(lceINSSRetido);

  if result then
    if issretido<>0 then
      result := ValidarValor(lceISSRetido);

  if result then
    if pisretido<>0 then
      result := ValidarValor(lcePISRetido);

  if result then
    if cofinsretido<>0 then
      result := ValidarValor(lceCOFINSretida);

  if result then
    if csllretido<>0 then
      result := ValidarValor(lceCSLLretida);

  if result then
    if piscofinscsllretido<>0 then
      result := ValidarValor(lcePIS_COFINS_CSLL);

end;

function TdtmBasico.CalcularVenctoImpostoRetidoEntrada(Data: TDateTime;
         quinzenal: boolean; Ate_noDia: String; dia: integer;
         periodo: String;Filial: integer): TDateTime;
const
  SQL = 'select PrimeiroDiaUtil(%s, cast(%s as date), %s, %s)';
var
  vdata: TDateTime;
  qryDiaUtil: TtecQuery;
begin
  vdata := Data;
  if quinzenal then
  begin
    if periodo = 'Quinzena atual' then
    begin
      if dayof(data) <= 15 then
        vdata := encodeDate(yearof(Data),MonthOf(Data),15)
      else
        vdata := encodeDate(yearof(Data),MonthOf(Data),DaysInMonth(Data));
    end
    else
    if periodo = 'Quinzena seguinte' then
    begin
      if dayof(data) <= 15 then
        vdata := encodeDate(yearof(Data), MonthOf(Data), DaysInMonth(Data))
      else
        vdata := encodeDate(yearof(incMonth(Data,1)),monthof(IncMonth(data,1)),15);
    end
  end
  else
  begin
    if periodo = 'Mês atual' then
      vdata := encodeDate(yearof(Data), MonthOf(Data), dia)
    else
    if periodo = 'Mês seguinte' then
      vdata := encodeDate(yearof(incMonth(Data)), MonthOf(incMonth(Data)), dia);
  end;
  qryDiaUtil := TtecQuery.Create(nil);
  qryDiaUtil.Database := dtmTecSoft.Database;

  if Ate_noDia = 'Até o dia' then
    qryDiaUtil.Sql.Text := Format(SQL,[inttostr(Filial),quotedstr(datetostr(vdata)), quotedstr('P'), quotedstr('-')])
  else
  if Ate_noDia = 'No dia' then
    qryDiaUtil.Sql.Text := Format(SQL,[inttostr(Filial),quotedstr(datetostr(vdata)), quotedstr('P'), quotedstr('+')]);

  qryDiaUtil.Open;
  vdata := qryDiaUtil.Fields[0].AsDateTime;
  qryDiaUtil.Free;
  result := vdata;
end;


function TdtmBasico.VerificarImpostosRetidos(previsao: Boolean;
                                      Situacao: SituacaoImpostosRetidos;
                                      qryDocumentosPagImpostosRetidos,
                                      qryDuplicatasImpostosRetidos,
                                      qryContasEntradasFiliais,
                                      qryVenctosImpostosRetidosEntradas,
                                      qrydocumentosPag,
                                      qryDuplicatas,
                                      spcDocumentosPagProximo: TtecQuery;
                                      Origem: TOrigemImpostosRetidos): boolean;
var
  valorimpostorateado: Currency;
  LancamentosContas: TtecLancamentos;
  vRegistroAtualDuplicata : TBookMark;

  function ExistePagamento_DuplicatasImpostosRetido: boolean;
  begin
    result := false;
    qryDuplicatasImpostosRetidos.First;
    while not qryDuplicatasImpostosRetidos.Eof do
    begin
      if (qryDocumentosPagImpostosRetidos.FieldByName('numero').AsInteger =
          qryDuplicatasImpostosRetidos.FieldByName('documentopag').AsInteger) and
         not qryduplicatasImpostosRetidos.FieldByName('datapagto').IsNull then
      begin
        result := true;
        break;
      end;
      qryDuplicatasImpostosRetidos.Next;
    end;
  end;

  function VerificarImpostosRetidosnaDuplicata(ValorImposto: Currency; Tipo: TtecLancamentosContasEntradas): boolean;
  var
    HouveMudancaFatoGeradoreComQuitacao: Boolean;
    HouveMudancaFatoGeradoreSemQuitacao: Boolean;

    function LocalizarDocumentosPagImpostosRetidosDuplicata: Boolean;
    begin
       result := true;
       HouveMudancaFatoGeradoreComQuitacao := false;
       HouveMudancaFatoGeradoreSemQuitacao := false;

       {Verificar se houve mudança nos parâmetros do fato gerador:
        de pagamento duplicata p/ lançamento na nota fiscal}
       qryDocumentosPagImpostosRetidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
       begin
         if (qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo]) then
         begin
           if qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').IsNull then
           begin
             if ExistePagamento_DuplicatasImpostosRetido then
             begin
               HouveMudancaFatoGeradoreSemQuitacao := false;
               HouveMudancaFatoGeradoreComQuitacao := true;
               Result := false;
               break;
             end
             else
             begin
               HouveMudancaFatoGeradoreSemQuitacao := true;
               result := true;
             end;
           end
         end;
         qryDocumentosPagImpostosRetidos.Next;
       end;

       if Result then
       begin
         result := false;
         qryDocumentosPagImpostosRetidos.First;
         while not qryDocumentosPagImpostosRetidos.Eof do
         begin
           if (qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo]) then
           begin
             if not qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').IsNull then
             begin
               if ExistePagamento_DuplicatasImpostosRetido then
               begin
                 result := false;
                 break;
               end
               else
                 result := true;
             end;
           end;
           qryDocumentosPagImpostosRetidos.Next;
         end;
       end;

    end;

     procedure ApagarDocumentosPagImpostosRetidosDuplicata;
     begin
       qryDocumentosPagImpostosRetidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
       begin
         if qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo] then
         begin
           if (qryDocumentosPagImpostosRetidos.FieldByName('datavenctoorigem').AsDateTime =
               qryDuplicatas.FieldByName('DataVenctooriginal').asdatetime) and
              (qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').AsInteger =
               qryduplicatas.FieldByName('numero').Asinteger) and
              (qryDocumentosPagImpostosRetidos.FieldByName('documentopagorigem').AsInteger =
               qryduplicatas.FieldByName('documentopag').Asinteger) then
             qryDocumentosPagImpostosRetidos.Delete
           else
             if HouveMudancaFatoGeradoreSemQuitacao and
               (qryDocumentosPagImpostosRetidos.FieldByName('documentopagorigem').AsInteger =
                qryduplicatas.FieldByName('documentopag').Asinteger) and
                qryDocumentosPagImpostosRetidos.FieldByName('datavenctoorigem').isnull and
                qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').isnull then
               qryDocumentosPagImpostosRetidos.Delete
             else
               qryDocumentosPagImpostosRetidos.Next;
         end
         else
           qryDocumentosPagImpostosRetidos.Next;
       end;
     end;

     procedure AtribuirDocumentosPag;
     begin
       qryDocumentosPagImpostosRetidos.FieldByName('fornecedor').AsInteger := qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('tipofornecedor').AsString := qryVenctosImpostosRetidosEntradas.FieldByName('tipofornecedor').AsString;
       qryDocumentosPagImpostosRetidos.FieldByName('creditar').clear;
       if qryContasEntradasFiliais.Locate('Descricao', FilialContasEntradas[tipo],[]) then
         if qryContasEntradasFiliais.FieldByName('contacontabil').AsInteger <> 0 then
            qryDocumentosPagImpostosRetidos.FieldByName('creditar').AsInteger := qryContasEntradasFiliais.FieldByName('contacontabil').AsInteger;

       qryDocumentosPagImpostosRetidos.FieldByName('emissao').AsDateTime := qryDocumentosPag.FieldByName('emissao').AsDateTime;
       qryDocumentosPagImpostosRetidos.FieldByName('datalancto').AsDateTime := qryDocumentosPag.FieldByName('datalancto').AsDateTime;
       qryDocumentosPagImpostosRetidos.FieldByName('evento').Asvariant := qryDocumentosPag.FieldByName('Evento').AsVariant;
       qryDocumentosPagImpostosRetidos.FieldByName('filialemissao').AsInteger := qryDocumentosPag.FieldByName('filialemissao').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('filialcontabil').AsInteger := qryDocumentosPag.FieldByName('filialcontabil').AsInteger;


       qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString := FilialContasEntradas[tipo];

       qryDocumentosPagImpostosRetidos.FieldByName('valor').AsCurrency := valorimpostorateado;
       qryDocumentosPagImpostosRetidos.FieldByName('documentopagorigem').AsInteger := qryDocumentosPag.FieldByName('Numero').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('datavenctoorigem').AsDateTime  := qryDuplicatas.FieldByName('DataVencto').AsDateTime;
       qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').AsInteger := qryDuplicatas.FieldByName('Numero').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('complemento').AsString := qryDocumentosPag.FieldByName('complemento').AsString;
       qryDocumentosPagImpostosRetidos.FieldByName('previsao').AsBoolean := false;
       qryDocumentosPagImpostosRetidos.FieldByName('fatogerador').AsString := qryVenctosImpostosRetidosEntradas.FieldByName('ocasiao').AsString;
     end;

     procedure AtribuirDuplicatas;
     begin
       qryDuplicatasImpostosRetidos.fieldbyname('documentopag').AsInteger := qryDocumentosPagImpostosRetidos.fieldbyname('numero').AsInteger;
       if qryDuplicatas.fieldByName('datapagto').IsNull then
         qryDuplicatasImpostosRetidos.FieldByName('datavencto').AsDateTime :=
