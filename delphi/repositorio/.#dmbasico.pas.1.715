function TdtmBasico.CalcularImpostos_(var ProdutosItens, Notas: TtecQuery;
  CalcularIPI, CalcularTodos, Saida: Boolean; Calculos,
  ProdutosCompostos: TTecQuery; FiltrarComponentedoComposto: Boolean;
  OrigemCalculo: TtecOrigemCalculo; VendaConsumidorFinal,
  ContribICMS: Boolean; Servicos: TtecQuery; NotaFiscalVinculada,
  msgDifAliquotaICMS, ReverAliquota: boolean;
  AlteracaoEspecifica: tpAlteracaoEspecifica;
  VerificarAcertoCentavos: boolean; qrynfe: TtecQuery;
  Produtos: TClientDataSet): boolean;
type
tLocalAlteracao = (tpAltNotas, tpAltProdutos, tpAltICMSOutras, tpAltICMSIsentas);

var

  fREsponsavelDifal, fBaseDupla, fCSOSNSaida  : String;
  fdatainiciodifal : TDateTime;

  HeImportacao : Boolean;
  RegistroAtual, RegistroAtualServico : TBookMark;

  TotalDescontoItem, TotalDescontoFinanceiro, TotalLiquidoProdutos, TotalProdutos, TotalBrinde{, TotalProdutosST }: Real;
  TotalDescontoItemFreteDigitado, TotalDescontoItemDespesasAcessoriasDigitada,
  TotalLiquidoProdutosFreteDigitado, TotalLiquidoProdutosDespesasAcessoriasDigitada,
  TotalProdutosFreteDigitado, TotalProdutosDespesasAcessoriasDigitada: Real;
  TotalDescontoItemDescontoDigitado, TotalLiquidoProdutosDescontoDigitado, TotalProdutosDescontoDigitado: Real;

  vTotalPeso : Real;
  vTotalVolumes : integer;

  vTotalFreteDigitado : Currency;
  vTotalDescontoDigitado : Currency;
  vTotalDespesasAcessoriasDigitada : Currency;


  EstadoNotaFiscal, EstadoProdutos : TDataSetState;

  i, t: Integer;
  FreteRateado,
  DescontoRateado,
  SeguroRateado,
  AcrescimoRateado,
  DespesaRateada,
  ValorICMSSTRateada,
  BaseICMSSTRateada,

  Total{, TotalAcrescimo,
    TotalDesconto}: Currency;

  UltimoProdutoBaseICMSST,
  UltimoProdutoValorICMSST, vListanotas : String;

  vBaseICMS,
  vValorICMS, vValorICMS_SemST,
  vBaseICMSST,
  vValorICMSST,
  vBaseICMSSTCusto,
  vValorICMSSTCusto,
  vValorIPI, vValorFrete, vValorDesconto, vValorDescontoItem, vDespesasAcessorias,
  vQtdeProdutos : Currency;

  vValorPIS,
  vValorCOFINS : Currency;

  vValorPIS_Servicos,
  vValorCOFINS_SErvicos : Currency;


  vCredICMSSN : Currency;

  vICMSSTRet, vICMSSTRetDesp, vBCSTRet, vBCSTRetDesp, vICMSBaseCalculo_dev, vICMSValor_dev : Currency;

  vCalculosICMSBase, vCalculosICMSValor, vCalculosICMSSTValor, vCalculosICMSIsentas, vCalculosICMSOutras : Currency;
  vCalculosIPIBase, vCalculosIPIValor, vCalculosIPIIsentas, vCalculosIPIOutras, vvalortotalimpostoibt: Currency;
  vvalorimpostonacional,vvalorimpostoestadual,vvalorimpostomunicipal: Currency;

  vCalculosISSBase, vCalculosISSValor, vCalculosISSIsentas, vCalculosISSOutras : Currency;

  vDiferenca : Currency;

  vValor1, vValor2, vValor3 : Currency;
  vValorL1 : Boolean;

  vFCPUFDest, vICMSUFDest, vICMSUFRemet : Currency;
  vFCP, vFCPST, vFCPSTRet : Currency;

  vVendaConsumidorFinalAux : boolean;

  function ObservacoesDifal: String;
  begin
    if (notas.FieldByName('vICMSUFDest').asCurrency<>0) and
       (notas.FieldByName('vFCPUFDest').asCurrency<>0) and
       (notas.FieldByName('vICMSUFRemet').asCurrency<>0) then
      result := ' Valores totais do ICMS Interestadual: DIFAL da UF Destino '+
               formatfloat('R$ ###,##0.00',notas.FieldByName('vICMSUFDest').asCurrency) + ' FCP ' +
               formatfloat('R$ ###,##0.00',notas.FieldByName('vFCPUFDest').asCurrency) + ' DIFAL da UF Origem ' +
               formatfloat('R$ ###,##0.00',notas.FieldByName('vICMSUFRemet').asCurrency)
    else
    if (notas.FieldByName('vICMSUFDest').asCurrency<>0) and
       (notas.FieldByName('vFCPUFDest').asCurrency=0) and
       (notas.FieldByName('vICMSUFRemet').asCurrency<>0) then
      result := ' Valores totais do ICMS Interestadual: DIFAL da UF Destino '+
               formatfloat('R$ ###,##0.00',notas.FieldByName('vICMSUFDest').asCurrency)+ ' DIFAL da UF Origem ' +
               formatfloat('R$ ###,##0.00',notas.FieldByName('vICMSUFRemet').asCurrency)
    else
    if (notas.FieldByName('vICMSUFDest').asCurrency<>0) and
       (notas.FieldByName('vFCPUFDest').asCurrency<>0) and
       (notas.FieldByName('vICMSUFRemet').asCurrency=0) then
      result := ' Valores totais do ICMS Interestadual: DIFAL da UF Destino '+
               formatfloat('R$ ###,##0.00',notas.FieldByName('vICMSUFDest').asCurrency) + ' FCP ' +
               formatfloat('R$ ###,##0.00',notas.FieldByName('vFCPUFDest').asCurrency)
    else
    if (notas.FieldByName('vICMSUFDest').asCurrency<>0) and
       (notas.FieldByName('vFCPUFDest').asCurrency=0) and
       (notas.FieldByName('vICMSUFRemet').asCurrency=0) then
      result := ' DIFAL da UF Destino '+formatfloat('R$ ###,##0.00',notas.FieldByName('vICMSUFDest').asCurrency);

  end;

  function IPINCM: integer;
  begin
    result := 0;
    if (origemCalculo = NotaEntrada) and parsistema.AtualizarNCMNotaEntrada then
    begin
      if Produtos.findfield('ipi')<>nil then
