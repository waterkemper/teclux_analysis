function TdtmBasico.NotaSemICMS(Incidencia: String): Boolean;
begin
    Result:= (Incidencia = ctISENTA) or              // '40'
             (Incidencia = ctNAOTRIBUTADA)    or     //'41'
             (Incidencia = ctSUSPENSAO);             //'50'

    if result then
      result := regimetributario <> 1;  // ver c/ Joao pois caso acima se aplica ao regime normal
end;

function TdtmBasico.AliquotaFCP(produto, EstadoDestino: String): Currency;
begin
  qryDadosProdutos_.sql.text := SQLDadosProdutosOutros;
  qryDadosProdutos_.parambyname('produto').asString := produto;
  qryDadosProdutos_.parambyname('estadodestino').asString := EstadoDestino;
  qryDadosProdutos_.close;
  qryDadosProdutos_.Open;
  result := qryDadosProdutos_.fieldbyname('percfcp').asCurrency;
end;

