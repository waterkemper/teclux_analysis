function TdtmBasico.calcularValorParcial(vlVencto, vlPagto,
  vlDebito: real): real;
begin
  Result := SimpleRoundTo(((vlVencto * VlPagto)/vlDebito),-2);
end;

class function TdtmBasico.Filial_Estoque_(filial: integer): variant;
var
  DadosFilial : TVariantArray;
begin
  result := filial;
  if filial = ffilialbase then
  begin
    if ftipofilial = 'V' then
      result := FFilialEstoque
  end
  else
  begin
    DadosFilial := ValorCampodaTabela('filiais', ['codigo'], [inttostr(filial)], ['tipofilial', 'filial_estoque']);
    if DadosFilial[0]='V' then
      result := DadosFilial[1]
  end;
end;

