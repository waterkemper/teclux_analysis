function TdtmBasico.VerificarBloqueiodaTabela(Tabela:TTecquery; CampoChave,
  CampoComparacao, TabelaBanco: String): boolean;

var
  vEstadoTabela : TDataSetState;
begin
  if tabela.state = dsinsert then
    result := true
  else
    result := Tabela.fieldbyname(CampoComparacao).asDateTime >=
              VartoDateTime(ValorCampodaTabela(TabelaBanco, [CampoChave], [Tabela.fieldbyname(CampoChave).asString], [CampoComparacao])[0]);

  if not result then
    mensagemErro('As informações alteradas serão descartadas pois os dados já foram atualizados por outro usuario')
  else
  begin
    vEstadoTabela := tabela.state;

    if not (tabela.state in [dsinsert, dsedit]) then
      tabela.edit;

    tabela.fieldbyname(CampoComparacao).asDateTime := DataHoraServidor;

    if not (vEstadoTAbela in [dsinsert, dsedit]) then
      tabela.post;

  end
end;

function TdtmBasico.CondicaoICMSInterPart(cst_nf, csosn_nf: String; crtEmitente: integer): boolean;
begin

{
  1 – Simples Nacional;
  2 – Simples Nacional – excesso de sublimite de receita bruta;
  3 – Regime Normal. (v2.0)
}

  result := false;

  if (CRTEmitente <> 1) then  {Não e do simples nacional}
    result := not (cst_nf = '40') and    {não é isentas}
              not (cst_nf = '41');       {não é não tributada}


{

http://www.oobj.com.br/bc/article/rejei%C3%A7%C3%A3o-694-n%C3%A3o-informado-o-grupo-de-icms-para-a-uf-de-destino-como-resolver-361.html
A regra de validação 694 não se aplica nas operações isentas (CST = 40-Isenta ou CSOSN = 103-Isento), imunes ou não tributadas (CST = 41-Não tributada, ou CSOSN = 300-Imune, ou CSOSN = 400-Não tributada pelo Simples Nacional);


}

end;

procedure TdtmBasico.IniciarTempo;
begin
  vTempoInicial := Ticks64;
end;

function TdtmBasico.TempoEsgotado: boolean;
  function TempoAtual : DWORD;
  begin
    result := Ticks64;
  end;
begin
  if  (TempoAtual >= vTempoInicial) and ((TempoAtual - vTempoInicial) < 15000) then
    result := false
  else
    result := true;
end;

class function TdtmBasico.VerificarDadosFilial(filial: String = ''): boolean;
begin
  if not assigned(qryDadosFilial_) then
  begin
    qryDadosFilial_    := TTecQuery.Create(nil);
    qryDadosFilial_.Database := dtmTecSoft.Database;
    qryDadosFilial_.Transaction := dtmTecSoft.tstTecSoft;

    qryDadosFilial_.CachedUpdates := true;
    qryDadosFilial_.requestlive := true;

    if filial = '' then
      qryDadosFilial_.Sql.Text := Format(VerificarFilialBaseSQL, ['0 or true'])
    else
      qryDadosFilial_.Sql.Text := Format(VerificarFilialBaseSQL, [filial+ ' or true']);
    qryDadosFilial_.Open;
  end;

  if filial <> '' then
    result := qryDadosFilial_.locate('codigo', filial, [])
  else
    Result := qryDadosFilial_.RecordCount > 0;
end;

