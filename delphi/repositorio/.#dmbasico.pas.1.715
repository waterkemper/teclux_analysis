  function IcmsBaseCalculo(tProdutos :TTecQuery;
                           ConsiderarBaseFixa: boolean = true;
                           ConsiderarNotaFiscalVinculadaaoCupomFiscal: Boolean = False;
                           ConsiderarICMSSobre: Boolean = true): Real;
  var
    Calcular : Boolean;
  begin
    result := 0.00;

    Calcular := True;

    if ConsiderarNotaFiscalVinculadaaoCupomFiscal then
      Calcular := True
    else
      if NotaFiscalVinculada then
        Calcular := False;

    if Calcular then
    begin
      if HeImportacao or
        (OrigemCalculo = NotaAcrescimoFinanceiro) then
        result := tProdutos.FieldByName('icmsbasecalculo').Asfloat
      else
      begin
        if (tProdutos.findfield('baseicms')<>nil) and
           (tProdutos.fieldbyname('baseicms').ascurrency<>0) and ConsiderarBaseFixa and saida then
            result := ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * tProdutos.fieldbyname('baseicms').ascurrency,-2)
        else
        begin

          if tProdutos.FindField('valordescontoitem') <> nil then
          begin
            if (tProdutos.FindField('produtototal') <> nil) and not PermiteAlterarDadosICMS then
              result := ArredondarouTruncar(tProdutos.FieldByName('produtototal').ascurrency
                                - tProdutos.FieldByName('valordescontoitem').AsCurrency
                                - tProdutos.FieldByName('desconto').AsCurrency
                                {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                                + tProdutos.FieldByName('frete').AsCurrency
                                + tProdutos.FieldByName('seguro').AsCurrency
                                + ifthen(ICMSSobreIPI(tProdutos) and ConsiderarICMSSobre, tprodutos.fieldbyname('valoripi').ascurrency,0)
                                + ifthen(ICMSSobreDespesasAcessorias(tProdutos) and ConsiderarICMSSobre, tprodutos.fieldbyname('despesasacessorias').ascurrency,0), -2)
            else
              result := ArredondarouTruncar(ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * precounitario(produtos),-2)
                                - tProdutos.FieldByName('valordescontoitem').AsCurrency
                                - tProdutos.FieldByName('desconto').AsCurrency
                                {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                                + tProdutos.FieldByName('frete').AsCurrency
                                + tProdutos.FieldByName('seguro').AsCurrency
                                + ifthen(ICMSSobreIPI(tProdutos) and ConsiderarICMSSobre, tprodutos.fieldbyname('valoripi').ascurrency,0)
                                + ifthen(ICMSSobreDespesasAcessorias(tProdutos) and ConsiderarICMSSobre, tprodutos.fieldbyname('despesasacessorias').ascurrency,0),-2);
          end
          else
          begin
            if (tProdutos.FindField('produtototal') <> nil) and not PermiteAlterarDadosICMS then
              result := ArredondarouTruncar(tProdutos.FindField('produtototal').ascurrency
                                      - tProdutos.FieldByName('desconto').AsCurrency
                                      {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                                      + tProdutos.FieldByName('frete').AsCurrency
                                      + tProdutos.FieldByName('seguro').AsCurrency
                                      + ifthen(ICMSSobreIPI(tProdutos) and ConsiderarICMSSobre, tprodutos.fieldbyname('valoripi').ascurrency,0)
                                      + ifthen(ICMSSobreDespesasAcessorias(tProdutos) and ConsiderarICMSSobre, tprodutos.fieldbyname('despesasacessorias').ascurrency,0),-2)
            else
              result := ArredondarouTruncar(ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * precounitario(produtos), -2)
                                      - tProdutos.FieldByName('desconto').AsCurrency
                                      {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                                      + tProdutos.FieldByName('frete').AsCurrency
                                      + tProdutos.FieldByName('seguro').AsCurrency
                                      + ifthen(ICMSSobreIPI(tProdutos) and ConsiderarICMSSobre, tprodutos.fieldbyname('valoripi').ascurrency,0)
                                      + ifthen(ICMSSobreDespesasAcessorias(tProdutos) and ConsiderarICMSSobre, tprodutos.fieldbyname('despesasacessorias').ascurrency,0)
                                      {+ tProdutos.FieldByName('despesasacessorias').AsCurrency} ,-2);
          end;
       end;
      end;
    end;
  end;

  function Condicaorequernfentrada: boolean;
  begin
   result := false;
   if OrigemCalculo = NotaAvulsa then
    result := ((Notas.FindField('requernfentrada')<>nil) and
               (notas.fieldbyname('requernfentrada').AsBoolean)) or
              ((produtos.FindField('codigonota')<>nil) and
               (produtos.fieldbyname('codigonota').Asinteger<>0)) ;
  end;


  function IPIBaseCalculo(tProdutos :TTecQuery; ConsiderarBaseFixa: boolean = true): Real;
  begin
    result := 0.00;
    if HeImportacao or
      (OrigemCalculo = NotaAcrescimoFinanceiro) then
      result := tProdutos.FieldByName('icmsbasecalculo').Asfloat
    else
    begin
      if (OrigemCalculo = NotaAvulsa) and
         CondicaoRequerNFEntrada  and
         eHNotaFiscalSaidaDevolucao(produtos.fieldbyname('codigofiscal').Asinteger, true) then
      begin
        qryValoresSTRetidosCusto_.Sql.Text := SQLValoresSTRetidosCustoDevolucaoCompra;
        RefazConsultaPorNome(qryValoresSTRetidosCusto_,
             ['produto','codigonota'], [produtos.fieldbyname(campoproduto).asstring,
                                        produtos.fieldbyname('codigonota').asstring]);
        result := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('ipibasecalculo').ascurrency *
                                      Produtos.fieldbyname('quantidade').AsFloat, -2);
      end
      else
      if (tProdutos.findfield('baseicms')<>nil) and
         (tProdutos.fieldbyname('baseicms').ascurrency<>0) and ConsiderarBaseFixa and saida then
          result := ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * tProdutos.fieldbyname('baseicms').ascurrency,-2)
      else
      begin
        if tProdutos.FindField('valordescontoitem') <> nil then
        begin
          if (tProdutos.FindField('produtototal') <> nil) and not PermiteAlterarDadosIPI then
            result := tProdutos.FindField('produtototal').ascurrency
                              - tProdutos.FieldByName('valordescontoitem').AsCurrency
                              - tProdutos.FieldByName('desconto').AsCurrency
                              {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                              + ifthen(NaoCalcularIPISobreFrete,0,tProdutos.FieldByName('frete').AsCurrency)
                              + tProdutos.FieldByName('seguro').AsCurrency
          else
            result := ArredondarouTruncar(ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * precounitario(produtos),-2)
                              - tProdutos.FieldByName('valordescontoitem').AsCurrency
                              - tProdutos.FieldByName('desconto').AsCurrency
                              {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                              + ifthen(NaoCalcularIPISobreFrete,0,tProdutos.FieldByName('frete').AsCurrency)
                              + tProdutos.FieldByName('seguro').AsCurrency
                              {+ tProdutos.FieldByName('despesasacessorias').AsCurrency} ,-2);
        end
        else
        begin
          if (tProdutos.FindField('produtototal') <> nil) and not PermiteAlterarDadosIPI then
            result :=              tProdutos.FindField('produtototal').ascurrency
                                    - tProdutos.FieldByName('desconto').AsCurrency
                                    {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                                    + ifthen(NaoCalcularIPISobreFrete,0,tProdutos.FieldByName('frete').AsCurrency)
                                    + tProdutos.FieldByName('seguro').AsCurrency
          else
            result := ArredondarouTruncar(ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * precounitario(produtos), -2)
                                    - tProdutos.FieldByName('desconto').AsCurrency
                                    {+ tProdutos.FieldByName('acrescimo').AsCurrency}
                                    + ifthen(NaoCalcularIPISobreFrete,0,tProdutos.FieldByName('frete').AsCurrency)
                                    + tProdutos.FieldByName('seguro').AsCurrency
                                    {+ tProdutos.FieldByName('despesasacessorias').AsCurrency} ,-2);
        end;
     end;
    end;
  end;

  function ValorIPI: Currency;
  begin
    if (OrigemCalculo = NotaAvulsa) and
       CondicaoRequerNFEntrada  and
       eHNotaFiscalSaidaDevolucao(produtos.fieldbyname('codigofiscal').Asinteger, true) then
    begin
      qryValoresSTRetidosCusto_.Sql.Text := SQLValoresSTRetidosCustoDevolucaoCompra;
      RefazConsultaPorNome(qryValoresSTRetidosCusto_,
           ['produto','codigonota'], [produtos.fieldbyname(campoproduto).asstring,
                                      produtos.fieldbyname('codigonota').asstring]);
      result := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('valoripi').ascurrency *
                                    Produtos.fieldbyname('quantidade').AsFloat, -2);
    end
    else
      result := ArredondarouTruncar((produtos.FieldByName('ipibasecalculo').AsCurrency *
                      produtos.FieldByName('aliquotaipi').AsCurrency)/100,-2);
  end;


  function PISCOFINSBaseCalculo_Servicos(tServicos : TTecQuery): Real;
  begin
    result := ArredondarouTruncar(tServicos.fieldbyname('quantidade').AsFloat * tServicos.fieldbyname('valorservico').AsFloat,-2);
  end;

  function PISCOFINSBaseCalculo(tProdutos : TTecQuery): Real;
  begin
    result := ArredondarouTruncar(ArredondarouTruncar(tProdutos.fieldbyname('quantidade').AsFloat * precounitario(produtos),-2)
                      - ifthen(tProdutos.FindField('valordescontoitem') <> nil, tProdutos.FieldByName('valordescontoitem').AsCurrency, 0)
                      - tProdutos.FieldByName('desconto').AsCurrency
                      + tProdutos.FieldByName('acrescimo').AsCurrency
                      + tProdutos.FieldByName('frete').AsCurrency
                      + tProdutos.FieldByName('seguro').AsCurrency
                      + tProdutos.FieldByName('valoripi').AsCurrency
                     { + tprodutos.FieldByName(CampoICMSValorST).AsCurrency   }
                     { + ValorProdutos_vicmsstretdesp(tprodutos) }
                        + tProdutos.FieldByName('despesasacessorias').AsCurrency ,-2);

    if ExcluirICMSdePISeCOFINS then
    begin
      result := result - tProdutos.FieldByName('icmsvalor').AsCurrency;
      if 0 > result then
        result := 0;
    end;
{
   if not saida and contribipi and (tProdutos.FieldByName('valoripi').AsCurrency<>0) then
     result := result + ArredondarouTruncar(tProdutos.FieldByName('valoripi').AsCurrency, -2);
}

{
O ICMS-ST não integra o valor das aquisições de mercadoria para revenda, para fins de cálculo do credito pis e cofins.
IN SRF nº 635/2006 - artigo 23º - § 4º.
Solução de Consulta nº 84 de 23/04/2007
}
  end;



  function IcmsValor: Currency;
  begin
    if HeImportacao or
      (OrigemCalculo = NotaAcrescimoFinanceiro) then
      result := produtos.fieldbyname('icmsvalor').ascurrency
    else
      result := ArredondarouTruncar((produtos.FieldByName('icmsbasecalculo').AsCurrency *
                       produtos.FieldByName('aliquotaicms').AsCurrency)/100,-2);
  end;

  function IcmsValorfcp(basefcp: Currency): Currency;
  begin
    result := ArredondarouTruncar((basefcp * produtos.FieldByName('pfcp').AsCurrency)/100,-2);
  end;

  function IcmsValorfcpst(basefcpst: Currency): Currency;
  begin
    result := ArredondarouTruncar((basefcpst * produtos.FieldByName('pfcpst').AsCurrency)/100,-2);
  end;

  function IcmsValorfcpstRet(basefcpstRet: Currency): Currency;
  begin
    result := ArredondarouTruncar((basefcpstRet * produtos.FieldByName('pfcpstret').AsCurrency)/100,-2);
  end;




  {
  function IcmsValorCalculadoSimples: Currency;
  var
    vAliquotaICMS : Currency;
  begin
    if HeImportacao then
      result := produtos.fieldbyname('icmsvalor').ascurrency
    else
    begin

      if (qryICMSTAbela_.active and
         (qryICMSTAbela_.fieldbyname('codigo').asstring <> produtos.fieldbyname(campoproduto).asstring)) or
         (qryICMSTAbela_.parambyname('Estadocfo').asstring <> notas.fieldbyname('estado').AsString) or
         (qryICMSTAbela_.parambyname('TipoPessoa').asstring <> PessoaTipo) or
         not qryICMSTAbela_.active then
        RefazConsultaPorNome(qryICMSTAbela_,
           ['EstadoFilialBase','Estadocfo','TipoPessoa','produto'],
           [EstadoFilialBase,
            notas.fieldbyname('estado').AsString,
            PessoaTipo,
            produtos.fieldbyname(campoproduto).asString]);

      vAliquotaICMS := qryICMSTAbela_.fieldbyname('AliquotaICMS').AsCurrency;

      result := truncar((icmsbasecalculo * vAliquotaICMS)/100,2);

    end
  end;
  }

  function CredICMSSN: Currency;
  begin
    result := ArredondarouTruncar((icmsbasecalculo(produtos) *
                     produtos.FieldByName('pCredSN').AsCurrency)/100,-2);
  end;

  function ReducaoBase: Currency;
  begin
    result := ArredondarouTruncar(IcmsBaseCalculo(produtos)
                      * produtos.fieldbyname('percentualreducaobase').AsCurrency/ 100,-2);
  end;

  function ReducaoBase_Custo: Currency;
  begin
    result := ArredondarouTruncar(IcmsBaseCalculo(produtos)
                      * produtos.fieldbyname('percentualreducaobase_custo').AsCurrency/ 100,-2);
  end;


  function EstadoSubstituicao: String;
  begin
    result := ifthen(Saida, notas.fieldbyname('estado').asstring, EstadoFilialBase);
  end;

  function EstadoDestino: String;
  begin
    result := ifthen(Saida,notas.fieldbyname('estado').asstring, EstadoFilialBase);
  end;


  {
  function FatorSubstituicao(EstadoSubstituicao: String): Currency;
  begin
    if VendaConsumidorFinal then
    begin
      result := 1;
      if (Estadofilialbase <>  EstadoSubstituicao) and
         (PessoaTipo = 'J') and ContribICMS then
      begin
        RefazConsultaPorNome(qryFatorSubstituicao,
           ['UF_CliForSaida_ou_FilialEntrada','produto','TipoPessoa'],
           [EstadoSubstituicao,
            produtos.fieldbyname(campoproduto).asString,
            PessoaTipo]);
        vCalcularDiferencaAliquotaInterEstadual := qryFatorSubstituicao.FieldByName('fatorsubstituicao').AsFloat > 1;
      end;
    end
    else
    begin
        RefazConsultaPorNome(qryFatorSubstituicao,
           ['UF_CliForSaida_ou_FilialEntrada','produto','TipoPessoa'],
           [EstadoSubstituicao,
            produtos.fieldbyname(campoproduto).asString,
            PessoaTipo]);
      result := qryFatorSubstituicao.FieldByName('fatorsubstituicao').AsFloat;
    end;
  end;
  }

  function PercReducaoMVA(EstadoSubstituicao: String; IPINCM: integer): Currency;
  begin
    if IPINCM<>0 then
    begin
      RefazConsultaPorNome(qryPercReducaoMVAIPI_,
         ['UF_CliForSaida_ou_FilialEntrada','IPINCM'],
         [EstadoSubstituicao,
          IPINCM]);

      result := qryPercReducaoMVAIPI_.FieldByName('PercReducaoMVA').AsFloat;
    end
    else
    begin
      RefazConsultaPorNome(qryPercReducaoMVA_,
         ['UF_CliForSaida_ou_FilialEntrada','produto','TipoPessoa'],
         [EstadoSubstituicao,
          produtos.fieldbyname(campoproduto).asString,
          PessoaTipo]);

      result := qryPercReducaoMVA_.FieldByName('PercReducaoMVA').AsFloat;
    end;
  end;

  Function ContribuinteOrigem: Boolean;
  begin
    result := true;
    if notas.findfield('contribicmsemitente')<> nil then
      result := notas.fieldByName('contribicmsemitente').asBoolean;

    if OrigemCalculo = NotaEntrada then
      result := notas.fieldByName('clientecontribicms').asBoolean;

  end;

  Function ContribuinteDestino: Boolean;
  begin
    result := False;
    if notas.Name = 'qryContratos' then
    begin
      if notas.findfield('contribicms')<> nil then
        result := notas.fieldByName('contribicms').asBoolean;
    end
    else
      if notas.name = 'qryDadosFiscais' then
      begin
        if notas.findfield('clientecontribicms')<> nil then
          result := notas.fieldByName('clientecontribicms').asBoolean;
      end;

    if OrigemCalculo = NotaEntrada then
      result := contribicms;

  end;

  Function VendaConsumidorFinal_: Boolean;
  begin
    result := VendaConsumidorFinal;
    if notas.findfield('VendaConsumidorFinal')<> nil then
      result := notas.fieldByName('VendaConsumidorFinal').asBoolean
    else
    if notas.findfield('ConsumidorFinal')<> nil then
      result := notas.fieldByName('ConsumidorFinal').asBoolean
  end;

  function AliquotaICMS(EstadoOrigem, EstadoDestino: String; AliquotaInternadoEstadodeDestino: boolean = false): Currency;
  begin
      RefazConsultaPorNome(qryICMSTAbela_,
         ['produto','EstadoOrigem','EstadoDestino',
          'TipoPessoa','AliquotaInternadoEstadodeDestino',
          'pContribuinteOrigem',
          'pContribuinteDestino',
          'pVendaConsumidorFinal'],
         [produtos.fieldbyname(campoproduto).asString,
          EstadoOrigem, EstadoDestino,'J',AliquotaInternadoEstadodeDestino,
          ContribuinteOrigem, ContribuinteDestino, VendaConsumidorFinal_]);


    result := qryICMSTAbela_.fieldbyname('aliquotaicms').AsCurrency;
  end;


  function AliquotaICMSST(EstadoSubstituicao: String): Currency;
  begin
        RefazConsultaPorNome(qryAliquotaIcmsST_,
           ['UF_CliForSaida_ou_FilialEntrada','produto','TipoPessoa',
            'pContribuinteOrigem', 'pContribuinteDestino', 'pVendaConsumidorFinal'],
           [EstadoSubstituicao,
            produtos.fieldbyname(campoproduto).asString,
            PessoaTipo,
            ContribuinteOrigem, ContribuinteDestino, VendaConsumidorFinal_]);
      result := qryAliquotaIcmsST_.fieldbyname('aliquotaicmsst').AsCurrency;
  end;


  Function NoSimples: boolean;
  begin
    result := false;
    if saida then
    begin
      if (notas.FindField('regimetributario')<>nil) then
        result := notas.FindField('regimetributario').AsInteger = 1
      else
      if ((notas.name='qryContratos') and (Regimetributario=1)) then
        result := Regimetributario=1;
    end
    else
    begin
      if notas.FindField('nosimples')<> nil then
        result := notas.FieldByName('nosimples').AsBoolean;
    end;
  end;

  Function ClienteNoSimples: boolean;
  begin
    result := false;
    if (notas.FindField('nosimples')<>nil) then
      result := notas.FindField('nosimples').AsBoolean;
  end;

  Function OrgaoPublico: boolean;
  begin
    result := false;

    if (notas.FindField('orgaopublico')<>nil) then
      result := notas.FindField('orgaopublico').AsBoolean;
  end;





      (*------------------------------------------------------------------------------
     A Secretaria de Estado da Fazenda de Santa Catarina publicou o Decreto nº 306,
     de 14 de junho de 2011, o qual regulamentou, no território catarinense, o
     benefício de que trata o Convênio ICMS nº 35/2011, segundo o qual nas operações
     interestaduais, com destino a SC, se o fornecedor do outro Estado for optante
     pelo Simples Nacional, o ICMS a recolher por substituição tributária para SC
     será recolhido com a utilização da MVA Original prevista no RICMS-SC/01 para a
     mercadoria, e não com a MVA Ajustada, independentemente de a empresa adquirente
     de SC ser, ou não, optante pelo Simples Nacional.

     Esse benefício entra em vigor, no território catarinense, com efeitos
     retroativos a 1º de junho de 2011, e poderá ser utilizado juntamente com o
     benefício de redução da MVA em 70%, mas isso desde que a empresa adquirente, de
     SC, seja optante pelo Simples Nacional (Decreto nº 3.467/2010).

     Então, via de regra:

     a) se o fornecedor for do Simples Nacional e empresa adquirente não for:
        utiliza-se a a MVA Original, sem redução em 70%;

     b) se o fornecedor for do Simples Nacional e empresa adquirente também:
        utiliza-se a MVA Original reduzida em 70%;

     c) se o fornecedor não for do Simples Nacional e empresa adquirente também não for:
         utiliza-se a MVA Ajustada, sem a redução em 70%;

     d) se o fornecedor não for do Simples Nacional, e empresa adquirente é do
        Simples Nacional: utiliza-se a MVA Ajustada reduzida em 70%.
     ------------------------------------------------------------------------------*)

  function icmsbasecalculost: Currency;
  var
    vAjusteMVA, vEqualizacao: Currency;
    v_icmsbasecalculo, v_icmsvalor, V_fatorsubstituicao: Currency;
    v_PercReducaoMVA, v_aliquotaicms, v_aliquotaicmsst, v_valoripi: Currency;
    v_Estado : String;
    v_crt : integer;

  begin
    v_PercReducaoMVA := produtos.fieldByname('PercReducaoMVA').AsFloat;
    v_icmsbasecalculo := produtos.FieldByName('icmsbasecalculo').AsCurrency;
    if v_icmsbasecalculo = 0 then
      v_icmsbasecalculo := icmsbasecalculo(produtos,false, false, false)
    else
      v_icmsbasecalculo := v_icmsbasecalculo - ValoricmssSobreIPI(produtos) - ValoricmsSobreDespesasAcessorias(produtos);

    v_icmsvalor := produtos.FieldByName('icmsvalor').AsCurrency;
    if v_icmsvalor = 0 then
      v_icmsvalor := ArredondarouTruncar((v_icmsbasecalculo * produtos.FieldByName('aliquotaicms').AsCurrency)/100,-2);

    V_fatorsubstituicao := produtos.FieldByName('fatorsubstituicao').AsFloat;
    v_estado := notas.fieldbyname('estado').asstring;
    v_aliquotaicms := produtos.FieldByName('aliquotaicms').AsCurrency;
    v_aliquotaicmsst := produtos.FieldByName('aliquotaicmsst').AsCurrency;
    v_valoripi := produtos.fieldbyname('valoripi').AsCurrency;


    result := 0;
    if  (V_fatorsubstituicao > 0)  then
    begin
      if not BaseDupla then
      begin
        vAjusteMVA := 1.00;
        if RegimeTributario = 1 then // simples
          if v_PercReducaoMVA <> 0 then
            vAjusteMVA := 1.00 - (v_PercReducaoMVA/100);

        if NFSaidaouEntradaPelaEmpresa then
          v_crt := RegimeTributario
        else
          v_crt := crt;


        if ((v_estado = estadofilialbase) or ((v_crt = 1) AND not saida))

            {
        or
           (VendaConsumidorFinal and
            ((estadofilialbase <> EstadoDestino)  and
             (ContribICMS and responsaveldifal)))
             }

{ A SEGUNDA CONDIÇÃO ESTAVA EM COMENTARIO...EM 23/05/2018 A PEDIDO DA INFOTEC POIS O VALOR NÃO ESTAVA SENDO CALCULADO
  CORRETAMENTE NO CONTRATO 300020896, SEGUNDO A CONTABILIDADE DEVE SER SOMENTE A DIFERENÇA ENTRE OS VALORES DO ICMS - ICMSST
  SEM EQUALIZAÇÃO ASSIM A BASE DE CALCULO DA ST PERMANECE A MESMA
  }

      or  ((v_crt = 1) and saida)  then

      {
        Acrescentado regra de acordo o manual
        http://help.tecsoft.com.br/centraldeajuda/calculo-substituicao-tributaria/

      }



            vEqualizacao := 1
        else
          vEqualizacao := (1 - v_aliquotaicms/100) / (1 - v_aliquotaicmsst /100);

        result := ArredondarouTruncar((v_icmsbasecalculo + v_valoripi) * ((1+ (V_fatorsubstituicao - 1) * vAjusteMVA) * vEqualizacao), -2);
      end
      else
//        result :=  (v_icmsbasecalculo + v_valoripi - v_icmsvalor)/(1 - v_aliquotaicmsst/100);
        result :=  (v_icmsbasecalculo + v_valoripi)/(1 - v_aliquotaicmsst/100);
    end;
  end;

  function icmsbasecalculost_custo: Currency;
  var
    vAjusteMVA, vEqualizacao: Currency;
    v_icmsbasecalculo_custo, V_fatorsubstituicao: Currency;
    v_crt : integer;
  begin
    result := 0;

    if NFSaidaouEntradaPelaEmpresa then
      v_crt := RegimeTributario
    else
      v_crt := crt;

    if  (produtos.FieldByName('fatorsubstituicao_custo').AsFloat >= 1) {or vCalcularDiferencaAliquotaInterEstadual} then
    begin
      if (produtos.FindField('aliquotaicms_custo')<>nil) then
      begin
        vAjusteMVA := 1.00;
        if RegimeTributario = 1 then // simples
          if produtos.fieldByname('PercReducaoMVA').AsFloat <> 0 then
            vAjusteMVA := 1.00 - (produtos.fieldByname('PercReducaoMVA').AsFloat/100);

        if (notas.fieldbyname('estado').asstring = estadofilialbase) or ((v_crt = 1) and not saida)
        then vEqualizacao:= 1
        else vEqualizacao:= (1 - produtos.FieldByName('aliquotaicms_custo').AsCurrency/100) / (1 -produtos.FieldByName('aliquotaicmsst_custo').AsCurrency/100);



        v_icmsbasecalculo_custo := produtos.FieldByName('icmsbasecalculo_custo').AsCurrency;
        V_fatorsubstituicao := produtos.FieldByName('fatorsubstituicao_custo').AsFloat;


        result := ArredondarouTruncar((ifthen(produtos.FieldByName('icmsbasecalculo_custo').AsCurrency<>0,
                                  produtos.FieldByName('icmsbasecalculo_custo').AsCurrency,
                                  icmsbasecalculo(produtos,false,false,false)) + produtos.fieldbyname('valoripi').AsCurrency) *
                            ((1+ (produtos.FieldByName('fatorsubstituicao_custo').AsFloat - 1) * vAjusteMVA) * vEqualizacao), -2);


      end;
    end;
  end;

  function ReducaoBaseST: Currency;
  begin
    result :=  ArredondarouTruncar( icmsbasecalculost *
                      produtos.fieldbyname('pRedBCST').ascurrency/100,-2);
  end;

  function ReducaoBaseST_Custo: Currency;
  begin
    result :=  ArredondarouTruncar( icmsbasecalculost_custo *
                      produtos.fieldbyname('pRedBCST_custo').ascurrency/100,-2);
  end;


  function IcmsValorST: Currency;
  begin
    if not baseDupla then
      result := ArredondarouTruncar((produtos.FieldByName('ICMSBaseCalculoST').AsCurrency *
                         produtos.FieldByName('aliquotaicmsst').AsCurrency)/100 ,-2)
    else
      if ((produtos.FieldByName('aliquotaicmsst').AsCurrency - produtos.FieldByName('aliquotaicms').AsCurrency) /100) > 0 then
        result := ArredondarouTruncar(produtos.FieldByName('ICMSBaseCalculoST').AsCurrency *
                           ((produtos.FieldByName('aliquotaicmsst').AsCurrency - produtos.FieldByName('aliquotaicms').AsCurrency) /100) ,-2)
      else
        result := 0;
  end;

  function IcmsValorST_Custo: Currency;
  begin
    result := ArredondarouTruncar((produtos.FieldByName('ICMSBaseCalculoSTCusto').AsCurrency *
                       produtos.FieldByName('aliquotaicmsst_custo').AsCurrency)/100 ,-2);
  end;

  procedure EditarProdutos;
  begin
    if not (produtos.state in [dsinsert, dsedit]) then
      produtos.Edit;
  end;

  function EmissaoPropria: boolean;
  begin
    result := ((Notas.FindField('permitirimprimir')<>nil) and
               (notas.fieldbyname('permitirimprimir').AsBoolean));
  end;

  function ValorICMSSTDigitado: boolean;
  begin
    result := false;
    if produtos.FindField('valorICMSSTdigitado')<>nil then
      result := produtos.Fieldbyname('valorICMSSTdigitado').AsBoolean;
  end;

  function ValorICMSDigitado: boolean;
  begin
    result := false;
    if produtos.FindField('valorICMSdigitado')<>nil then
      result := produtos.Fieldbyname('valorICMSdigitado').AsBoolean;
  end;

  procedure AtribuirValoresRetidosST;
  var
   vFatorSubstituicao: Currency;
   vReducaoBaseST: Currency;
   valiquotaicmsst: Currency;

   vAliquotaICMSProprio : Currency;
   vValorICMSProprio : Currency;

   vicmsBaseCalculo, vicmsvalor : Currency;

  begin
    if (OrigemCalculo = NotaAvulsa) and
       CondicaoRequerNFEntrada  and
       eHNotaFiscalSaidaDevolucao(produtos.fieldbyname('codigofiscal').Asinteger, true) then
    begin
      if not valoricmsstdigitado then
      begin
          qryValoresSTRetidosCusto_.Sql.Text := SQLValoresSTRetidosCustoDevolucaoCompra;
          RefazConsultaPorNome(qryValoresSTRetidosCusto_,
               ['produto','codigonota'], [produtos.fieldbyname(campoproduto).asstring,
                                          produtos.fieldbyname('codigonota').asstring]);

        produtos.FieldByName('vBCSTRet').ascurrency   := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('icmsbasecalculost').ascurrency *
                                                         Produtos.fieldbyname('quantidade').AsFloat, -2);

        produtos.FieldByName('vBCSTRetDesp').ascurrency := produtos.FieldByName('vBCSTRet').ascurrency;

        produtos.FieldByName('vICMSSTRet').AsCurrency := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('icmsvalorst').ascurrency*
                                                         Produtos.fieldbyname('quantidade').AsFloat, -2);

        produtos.Fieldbyname('vICMSSTRetDesp').ascurrency := produtos.FieldByName('vICMSSTRet').AsCurrency;

        produtos.fieldbyname('icmsbasecalculo').clear;
        produtos.fieldbyname('icmsvalor').clear;
        produtos.fieldbyname('aliquotaicms').clear;
        produtos.fieldbyname('icmsbasecalculost').clear;
        produtos.fieldbyname('icmsvalorst').clear;
        produtos.fieldbyname('aliquotaicmsst').clear;
        produtos.fieldbyname('icmsbasecalculo_dev').clear;
        produtos.fieldbyname('icmsvalor_dev').clear;

      end
      else
      begin
        produtos.FieldByName('vBCSTRetDesp').ascurrency := produtos.FieldByName('vBCSTRet').ascurrency;
        produtos.Fieldbyname('vICMSSTRetDesp').ascurrency := produtos.FieldByName('vICMSSTRet').AsCurrency;
      end;

      if not valoricmsdigitado then
      begin
          qryValoresSTRetidosCusto_.Sql.Text := SQLValoresSTRetidosCustoDevolucaoCompra;
          RefazConsultaPorNome(qryValoresSTRetidosCusto_,
               ['produto','codigonota'], [produtos.fieldbyname(campoproduto).asstring,
                                          produtos.fieldbyname('codigonota').asstring]);

        produtos.FieldByName('icmsbasecalculo_dev').ascurrency   := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('icmsbasecalculo').ascurrency *
                                                         Produtos.fieldbyname('quantidade').AsFloat, -2);

        produtos.FieldByName('icmsvalor_dev').AsCurrency := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('icmsvalor').ascurrency*
                                                         Produtos.fieldbyname('quantidade').AsFloat, -2);
      end;

      qryValoresSTRetidosCusto_.Close;
    end
    else
    if ((OrigemCalculo in [NotaEntrada, Devolucao, Troca]) and
        CondicaoRequerNFSaida and
        eHNotaFiscalEntradaDevolucao(produtos.fieldbyname('codigofiscal').Asinteger))
        or ((OrigemCalculo = NotaEntrada) and CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, Produtos)) then
    begin
      if not valoricmsstdigitado then
      begin

        qryValoresSTRetidosCusto_.Sql.Text := SQLValoresSTRetidosCustoDevolucaoVenda;
        RefazConsultaPorNome(qryValoresSTRetidosCusto_,
               ['produto','dadofiscal'], [produtos.fieldbyname(campoproduto).asstring,
                                          produtos.fieldbyname('dadofiscal').asstring]);

        if ((OrigemCalculo = NotaEntrada) and CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, Produtos)) then
        begin
          produtos.FieldByName('vBCSTRet').ascurrency   := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('vBCSTRet').ascurrency *
                                                           Produtos.fieldbyname('quantidade').AsFloat, -2);

          produtos.FieldByName('vBCSTRetDesp').ascurrency := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('vBCSTRetDesp').ascurrency *
                                                           Produtos.fieldbyname('quantidade').AsFloat, -2);

          produtos.FieldByName('vICMSSTRet').AsCurrency :=  ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('vICMSSTRet').ascurrency *
                                                           Produtos.fieldbyname('quantidade').AsFloat, -2);

          produtos.Fieldbyname('vICMSSTRetDesp').ascurrency :=  ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('vICMSSTRetDesp').ascurrency *
                                                           Produtos.fieldbyname('quantidade').AsFloat, -2);
        end
        else
        begin
          produtos.FieldByName('vBCSTRet').ascurrency   := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('icmsbasecalculost').ascurrency *
                                                           Produtos.fieldbyname('quantidade').AsFloat, -2);
          produtos.FieldByName('vBCSTRetDesp').ascurrency := produtos.FieldByName('vBCSTRet').ascurrency;
          produtos.FieldByName('vICMSSTRet').AsCurrency := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('icmsvalorst').ascurrency*
                                                           Produtos.fieldbyname('quantidade').AsFloat, -2);
          produtos.Fieldbyname('vICMSSTRetDesp').ascurrency := produtos.FieldByName('vICMSSTRet').AsCurrency;
        end;
      end
      else
      begin
        produtos.FieldByName('vBCSTRetDesp').ascurrency := produtos.FieldByName('vBCSTRet').ascurrency;
        produtos.Fieldbyname('vICMSSTRetDesp').ascurrency := produtos.FieldByName('vICMSSTRet').AsCurrency;
      end;

      if not valoricmsdigitado then
      begin
          qryValoresSTRetidosCusto_.Sql.Text := SQLValoresSTRetidosCustoDevolucaoVenda;
          RefazConsultaPorNome(qryValoresSTRetidosCusto_,
               ['produto','dadofiscal'], [produtos.fieldbyname(campoproduto).asstring,
                                          produtos.fieldbyname('dadofiscal').asstring]);

        produtos.FieldByName('icmsbasecalculo_dev').ascurrency   := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('icmsbasecalculo').ascurrency *
                                                         Produtos.fieldbyname('quantidade').AsFloat, -2);

        produtos.FieldByName('icmsvalor_dev').AsCurrency := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('icmsvalor').ascurrency*
                                                         Produtos.fieldbyname('quantidade').AsFloat, -2);
      end;

      qryValoresSTRetidosCusto_.Close;

    end
    else
    if CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, Produtos) then
    begin
      produtos.FieldByName('vBCSTRetDesp').ascurrency := produtos.FieldByName('vBCSTRet').ascurrency;
      produtos.Fieldbyname('vICMSSTRetDesp').ascurrency := produtos.FieldByName('vICMSSTRet').AsCurrency;
    end
    else
    begin

      produtos.FieldByName('vBCSTRet').ascurrency := 0;

      if produtos.FindField('vBCSTRetDesp')<>nil then
        produtos.FieldByName('vBCSTRetDesp').ascurrency := 0;

      produtos.FieldByName('vICMSSTRet').AsCurrency := 0;

      if produtos.FindField('vICMSSTRetDesp')<>nil then
        produtos.FieldByName('vICMSSTRetDesp').AsCurrency := 0;

      if contribicms and
         ParSistema.DestacarSubstituicaoTributariaVendaContribuintesICMS and
         not (OrigemCalculo in [Devolucao,Troca, NotaAcrescimoFinanceiro]) then
      begin
        if (ParSistema.MarkupSubstituicao<>0) then
        begin
          if (produtos.FieldByName('ipi').AsInteger <> 0) and
             ((fatorsubstituicao[EstadoSubstituicao, produtos.fieldbyname(CampoProduto).AsString, PessoaTipo, VendaConsumidorFinal_, ContribICMS, IPINCM ]  >= 1)) then
          begin
            if EstadoSubstituicao = EstadoFilialBase then
              vAliquotaICMSProprio := ParSistema.ICMSaDestacarDentroEstado
            else
              vAliquotaICMSProprio := ParSistema.ICMSaDestacarForaEstado;

            vValorICMSProprio    := icmsbasecalculo(produtos) * vAliquotaICMSProprio;
            produtos.FieldByName('vBCSTRet').ascurrency := (icmsbasecalculo(produtos) / (1 + ParSistema.MarkupSubstituicao / 100)) * ffatorsubstituicao;
            produtos.FieldByName('vICMSSTRet').AsCurrency := (produtos.FieldByName('vBCSTRet').ascurrency * ParSistema.ICMSaDestacarDentroEstado);
            if vValorICMSProprio < produtos.FieldByName('vICMSSTRet').AsCurrency then
              produtos.FieldByName('vICMSSTRet').AsCurrency := produtos.FieldByName('vICMSSTRet').AsCurrency - vValorICMSProprio;

          end;
        end
        else
        begin
          {
          if qryValoresSTRetidosCusto_.Active and
             (qryValoresSTRetidosCusto_.parambyname('produto').asstring <> produtos.fieldbyname('produto').asstring)  or
             not qryValoresSTRetidosCusto_.active then
          }
            RefazConsultaPorNome(qryValoresSTRetidosCusto_,
               ['produto'{,'filial'}],
               [produtos.fieldbyname(campoproduto).asstring{,
                produtos.fieldbyname('filial').asinteger}]);

          produtos.FieldByName('vBCSTRet').ascurrency   := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('icmsbasecalculostcusto').ascurrency *
                                                           Produtos.fieldbyname('quantidade').AsFloat, -2);

          produtos.FieldByName('vICMSSTRet').AsCurrency := ArredondarouTruncar(qryValoresSTRetidosCusto_.fieldbyname('icmsvalorstcusto').ascurrency*
                                                           Produtos.fieldbyname('quantidade').AsFloat, -2);

          {deveria encontrar os custos da subst. na entrada da nota fiscal,
          caso não encontrar faz-se uma pesquisa do último produto comprado e calcula-se o icmsst}

          if (produtos.FieldByName('vBCSTRet').ascurrency=0) or
             (produtos.FieldByName('vICMSSTRet').AsCurrency=0) then
          begin
            {
            if qryValoresUltimaCompra_.Active and
               (qryValoresUltimaCompra_.parambyname('produto').asstring <> produtos.fieldbyname('produto').asstring)  or
               not qryValoresUltimaCompra_.active then
            }

              RefazConsultaPorNome(qryValoresUltimaCompra_, ['produto'], [produtos.fieldbyname(campoproduto).asstring]);

            if CondicaopMVAST(qryValoresUltimaCompra_.fieldbyname('incidencia').asString,
                              qryValoresUltimaCompra_.fieldbyname('csosn').asString,
                              crt {,PessoaTipo,VendaConsumidorFinal}) then

            begin
               vFatorSubstituicao := fatorsubstituicao[estadofilialbase, produtos.fieldbyname(CampoProduto).AsString, PessoaTipo, VendaConsumidorFinal_, ContribICMS , IPINCM];


              if qryValoresUltimaCompra_.fieldbyname('icmsbasecalculo').ascurrency <> 0 then
                vicmsBaseCalculo := (qryValoresUltimaCompra_.fieldbyname('icmsbasecalculo').ascurrency +
                                     qryValoresUltimaCompra_.fieldbyname('valoripi').ascurrency) /
                                     qryValoresUltimaCompra_.fieldbyname('quantidade').asFloat *
                                     produtos.fieldbyname('quantidade').asFloat
              else
                vicmsBaseCalculo := (IcmsBaseCalculo(qryValoresUltimaCompra_) +
                                     qryValoresUltimaCompra_.fieldbyname('valoripi').ascurrency) /
                                     qryValoresUltimaCompra_.fieldbyname('quantidade').asFloat *
                                     produtos.fieldbyname('quantidade').asFloat;

              vReducaoBaseST := ArredondarouTruncar(vicmsBaseCalculo * vFatorSubstituicao *
                                  qryValoresUltimaCompra_.fieldbyname('pRedBCST').ascurrency /100,-2);

              produtos.FieldByName('vBCSTRet').AsCurrency := ArredondarouTruncar(vicmsBaseCalculo * vFatorSubstituicao, -2) - vReducaoBaseST;


              {OS "SUPOSTOS RETIDOS ANTERIORMENTE":}

              valiquotaicmsst := AliquotaICMSST(estadofilialbase);
              produtos.FieldByName('vICMSSTRet').AsCurrency  := ArredondarouTruncar((produtos.FieldByName('vBCSTRet').AsCurrency *
                           valiquotaicmsst)/100,-2);

              {dúvida: a equalização na saida deve ser comparada com qual aliquota de icms da entrada ou saida ?}
              if (estadofilialbase <> notas.fieldbyname('estado').asstring) and
                 (valiquotaicmsst > qryValoresUltimaCompra_.FieldByName('aliquotaicms').AsCurrency) and
                 not NoSimples then
                produtos.FieldByName('vICMSSTRet').AsCurrency := ArredondarouTruncar(produtos.FieldByName('vICMSSTRet').AsCurrency *
                    (1 - qryValoresUltimaCompra_.FieldByName('aliquotaicms').AsCurrency/100) / (1 -valiquotaicmsst/100),-2);


              if qryValoresUltimaCompra_.fieldbyname('icmsvalor').ascurrency <> 0 then
                 vicmsvalor := (qryValoresUltimaCompra_.fieldbyname('icmsvalor').ascurrency /
                                qryValoresUltimaCompra_.fieldbyname('quantidade').asFloat *
                                produtos.fieldbyname('quantidade').asFloat)
              else
                vicmsvalor := ArredondarouTruncar((vicmsBaseCalculo *
                                 qryValoresUltimaCompra_.FieldByName('aliquotaicms').AsCurrency)/100,-2);

              if vicmsvalor < produtos.FieldByName('vICMSSTRet').AsCurrency then
                produtos.FieldByName('vICMSSTRet').AsCurrency := produtos.FieldByName('vICMSSTRet').AsCurrency -
                                                                 vicmsvalor;

            end;
          end;
        end;
      end;
    end;
  end;

  function ProdutoOK: boolean;
  begin
    result := true;
    if (lowercase(produtos.Name) = 'qryprodutoscontratos') or
       (lowercase(produtos.Name) = 'qryprodutosorcamentos') or
       (lowercase(produtos.Name) = 'qryprodutoscompostos') or
       (lowercase(produtos.Name) = 'qryprodutosdadosfiscaiscompostos') then
      result := true
    else
    begin
      if produtos.findfield('produtook')<>nil then
        result := produtos.fieldbyname('produtook').asboolean;
    end;    
  end;

  Function AbrirTabelaCompostos: Boolean;
  begin
    result := false;

    if (Produtos.FindField('composto') <> nil) and
       (Produtos.FindField('discriminarcomposto') <> nil) and
       (Produtos.FindField('discriminarpreco') <> nil) then
    result :=  Produtos.FieldByName('composto').AsBoolean and                      // QDO FOR COMPOSTO,
              ((Produtos.FieldByName('discriminarcomposto').AsString = 'S') or    // DISCRIMINAR OS COMPONENTES,
               ((Produtos.FieldByName('discriminarcomposto').AsString = 'C') and  // COM OS PRECOS
                 Produtos.FieldByName('discriminarpreco').AsBoolean));

    if result and
      (OrigemCalculo in [TransferenciaSaida, TransferenciaEntrada, DevolucaoPorTransferencia]) then
      result := false;
  end;

  function CampoNotaTotalFrete: String;
  begin
    result := 'valorfrete';
   if (lowercase(notas.Name) = 'qrycontratos') or
      (lowercase(notas.Name) = 'qryorcamentos') then
     result := 'frete'
   else
   if OrigemCalculo in [devolucao, troca, NotaEntrada, notaEntradaXML, TransferenciaEntrada, NotaAcrescimoFinanceiro, CadastroPedidos] then
     result := 'freteinterno';
  end;

  function CampoNotaTotalAcrescimo: currency;
  begin
   result := 0;
   if OrigemCalculo in [devolucao, troca, NotaEntrada, NotaAcrescimoFinanceiro, TransferenciaEntrada, CadastroPedidos] then
     result := notas.fieldbyname('acrescimo').ascurrency
   else
   if (lowercase(notas.Name) = 'qrycontratos') or
      (lowercase(notas.Name) = 'qryorcamentos') then
   begin
     if (notas.fieldbyname('valorprazo').AsCurrency <> 0) and (notas.fieldbyname('valorvista').AsCurrency <> 0) then
       result := notas.fieldbyname('valorprazo').AsCurrency - notas.fieldbyname('valorvista').AsCurrency
   end
   else
     result := notas.fieldbyname('acrescimofinanceiro').ascurrency
  end;

  function CampoNotavaloricmssubstituicao: Currency;
  begin
    result := 0;
    if (origemcalculo in [NotaEntrada, CadastroPedidos, TransferenciaEntrada]) then
      result := notas.fieldbyname('valoricmssubstituicaocalculada').AsCurrency
    else
    if (origemcalculo in [Devolucao, Troca]) then
      result := notas.fieldbyname('valoricmssubstituicao').AsCurrency
    else
      result := notas.fieldbyname('totalvaloricmssubstituicao').AsCurrency;
  end;

  function EfetuarCalculosNosProdutos: Boolean;
  begin
    {qdo FiltrarComponentedoComposto = false o produto não é composto}
    {para os compostos retorna verdadeiro pois FiltrarComponentedoComposto = False}
    result := not FiltrarComponentedoComposto;
    if FiltrarComponentedoComposto then
    {Os Calculos dos componentes são somente aos vinculados ao composto}
      result := produtos.fieldbyname('composto').asstring = ProdutosCompostos.FieldByName('produto').AsString;

  end;

  function CampoValorNota: String;
  begin
    result := 'valortotal';
    if OrigemCalculo in [NotaContrato, NotaAvulsa] then
      result := 'valortotal'
    else
    if OrigemCalculo in [devolucao, troca, NotaAcrescimoFinanceiro] then
      result := 'valornota'
    else
    if OrigemCalculo in [NotaEntrada, TransferenciaEntrada, CadastroPedidos] then
      result := 'valornotacalculada'
  end;

  function CampoValorReducaoBase: String;
  begin
    result := 'reducaobase';
    if OrigemCalculo in [devolucao, troca, NotaEntrada, CadastroPedidos, TransferenciaEntrada, NotaAcrescimoFinanceiro] then
      result := 'valorreducaobase';
  end;

  function CampoObservacoes: String;
  begin
    result := 'observacoesicmssubstituido';
    if OrigemCalculo in [devolucao, troca, NotaEntrada, CadastroPedidos, TransferenciaEntrada, NotaAcrescimoFinanceiro] then
      result := 'infcomplementar';
  end;

