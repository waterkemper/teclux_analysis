      fContaCaixaAutenticacoes      := qryVerificarFilialBase.Fieldbyname('contacaixa').AsInteger;
      fContaContabilCreditarPagamento := qryVerificarFilialBase.Fieldbyname('ContaContabilCreditarPagamento').AsInteger;
      {
      fclient_id_nfse               := qryVerificarFilialBase.Fieldbyname('client_id_nfse').AsString;
      fclient_secret_nfse           := qryVerificarFilialBase.Fieldbyname('client_secret_nfse').AsString;
      furlauth_nfse                 := qryVerificarFilialBase.Fieldbyname('urlauth_nfse').AsString;
      fsite_nfse                    := qryVerificarFilialBase.Fieldbyname('site_nfse').AsString;
      furlprocessamento_simplificada:= qryVerificarFilialBase.Fieldbyname('urlprocessamento_simplificada').AsString;
      furlprocessamento_normal      := qryVerificarFilialBase.Fieldbyname('urlprocessamento_normal').AsString;
      fusuario_nfse                 := qryVerificarFilialBase.Fieldbyname('usuario_nfse').AsString;
      fsenha_nfse                   := qryVerificarFilialBase.Fieldbyname('senha_nfse').AsString;
      }

      fsenhaemail_filialbase        := qryVerificarFilialBase.Fieldbyname('senhaemail').AsString;
      fusuarioemail_filialbase      := qryVerificarFilialBase.Fieldbyname('usuarioemail').AsString;
      femailenvio_filialbase        := qryVerificarFilialBase.Fieldbyname('emailenvio').AsString;
      fhostsmtp_filialbase          := qryVerificarFilialBase.Fieldbyname('hostsmtp').AsString;
      fportasmtp_filialbase         := qryVerificarFilialBase.Fieldbyname('portasmtp').AsString;
      fautenticarsmtp_filialbase    := qryVerificarFilialBase.Fieldbyname('autenticarsmtp').AsBoolean;
      fsmtprequerssl_filialbase     := qryVerificarFilialBase.Fieldbyname('smtprequerssl').AsBoolean;
      fsmtprequertls_filialbase     := qryVerificarFilialBase.Fieldbyname('smtprequertls').AsBoolean;

      fnaturezajuridica             := qryVerificarFilialBase.Fieldbyname('naturezajuridica').AsString;

      valor := qryVerificarFilialBase.Fieldbyname('tipoemissaonfeservico').AsInteger ;
      if valor <> 0 then
        ftipoemissaonfeservico        := TTectipoemissaonfeservico(valor-1)
      else
        ftipoemissaonfeservico        := TTectipoemissaonfeservico(0);

      AEDFFatura                    := qryVerificarFilialBase.Fieldbyname('aedffatura').AsString;
      ind_ativ                      := qryVerificarFilialBase.Fieldbyname('ind_ativ').AsString;
      regimecontabil                := qryVerificarFilialBase.Fieldbyname('regimecontabil').Asinteger;


      ContribuinteIPI := fcontribipi;

      AtribuirParametrosBaseRelatorio;

      if Assigned(ImpChequePadrao) then begin
        ImpChequePadrao.Favorecido := FRazaoFilialBase;
        ImpChequePadrao.NomeCidade := FCidadeFilialBase;
      end
    end;
  end;
  qryVerificarFilialBase.Close;

//  VerificarDadosFilial;
end;


class function TdtmBasico.VerificarFiliais: Boolean;
var
  qryVerificarFiliais: TtecQuery;
begin
  qryVerificarFiliais := TtecQuery.Create(nil);
  qryVerificarFiliais.Database := dtmTecSoft.Database;
  if (ParSistema.RelatorioSomenteFiliaisAutorizadas) then
  begin
    qryVerificarFiliais.Sql.Text := verificarFiliaisUsuarioSQL;
    qryVerificarFiliais.Params[0].AsInteger := UsuarioLogin.CodigoUsuario;
  end
  else
    qryVerificarFiliais.Sql.Text := verificarFiliaisSQL;

  qryVerificarFiliais.Open;
  Result := qryVerificarFiliais.RecordCount > 0;
  ListaFiliais := TStringList.Create;

  ListaFiliaisLiberada := '';
  ListaFiliaisLiberada2 := '';
  qryVerificarFiliais.first;
  while not qryVerificarFiliais.Eof do
  begin
    ListaFiliais.AddObject(
    format('%3s',[qryverificarFiliais.fieldbyname('codigo').AsString])+'. '
      + qryVerificarFiliais.fieldbyname('nome').AsString,
        Pointer(qryVerificarFiliais.fieldbyname('codigo').AsInteger));
    ListaFiliaisLiberada := ListaFiliaisLiberada + '''' + qryverificarFiliais.fieldbyname('codigo').AsString + ''',';
    ListaFiliaisLiberada2 := ListaFiliaisLiberada2 + '''' + qryverificarFiliais.fieldbyname('codigo').AsString + ''''',''';
    qryVerificarFiliais.Next;
  end;
  if ListaFiliaisLiberada<>'' then
    ListaFiliaisLiberada := copy(ListaFiliaisLiberada,1,length(ListaFiliaisLiberada)-1);
  if ListaFiliaisLiberada2<>'' then
    ListaFiliaisLiberada2 := copy(ListaFiliaisLiberada2,1,length(ListaFiliaisLiberada2)-1);
  qryVerificarFiliais.Close;
end;

