procedure TdtmBasico.ShowProgress(Sender: TObject; Stage: TZProgressStage; Proc: TZProgressProc; Position,
  Max: Integer; var Cancel: Boolean);
begin
{
  if Position = max then
  begin
    if Assigned(frmProgresso) then
    begin
      frmProgresso.free;
      frmProgresso := nil;
    end
  end
  else
  if not Assigned(frmProgresso) then
  begin
     frmProgresso := TfrmProgresso.Create(Application);
     frmProgresso.pgbAndamento.Min := 0;
     frmProgresso.pgbAndamento.Max := Max;
     frmProgresso.Show;
  end
  else
  begin
    frmProgresso.pgbAndamento.Position := Position;
//    frmProgresso.Refresh;
//    Cancel := frmProgresso.ModalResult = mrCancel;
  end;
  }
end;

function TdtmBasico.GetTotalizarValores(ds: TZDataSet; Campo: TFloatField; CampoMultiplicador: TField): Real;
var
  Total: Real;
  vRegistroAtual : TBookMark;
begin
  Total:= 0;
  if ds.Active and not ds.IsEmpty then begin
    try
      vRegistroAtual := ds.getbookmark;
      ds.DisableControls;
      ds.First;
      while not ds.Eof do
      begin
        if CampoMultiplicador <> nil then
          Total:= Total + (Campo.AsCurrency * CampoMultiplicador.ascurrency)
        else
          Total:= Total + Campo.AsCurrency;

        ds.Next;
      end;
    finally
      ds.gotobookmark(vregistroatual);
      ds.freebookmark(vregistroatual);

//      ds.First;
      ds.EnableControls;
    end;
  end;
  Result:= Total;
end;

