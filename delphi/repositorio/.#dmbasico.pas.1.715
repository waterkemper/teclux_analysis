                Append('</td>');
                Append('</tr>');
                Append('</table>');
             end;

             if f_Textos_finais.text <> '' then
             begin
//               Append('<table>');

               for i:=0 to f_Textos_finais.Count -1 do
                  Append('<br>'+ CamposSubst(f_Textos_finais[i]) );


                {
                Append('<tr>');
                Append('<td><font class="fontnormal">Preço Orçado:</font></td>');
                Append('<td><font class="fontnormal">Impostos inclusos nos preços de peças ofertados;</font></td>');
                Append('</tr>');

                Append('<tr>');
                Append('<td><font class="fontnormal">Prazo de Entrega:</font></td>');
                Append('<td><font class="fontnormal">Entrega Estimada relacionada com dias úteis;</font></td>');
                Append('</tr>');

                Append('<tr>');
                Append('<td><font class="fontnormal">Condição de Pagamento:</font></td>');
                Append('<td><font class="fontnormal">28 dias para peças;</font></td>');
                Append('</tr>');

                Append('<tr>');
                Append('<td><font class="fontnormal">Validade:</font></td>');
                Append('<td><font class="fontnormal">15 dias;</font></td>');
                Append('</tr>');
                }
             end;

//                Append('</table>');




                Append('<br><br>');
                Append('<font class="fontnormal">'+'_CONCLUSAO_'+' ');
                Append('<br>');
                Append('</font>');

      Append('</BODY>');
    Append('</HTML>');
            end;
   Result:= Html;

//   result.savetofile('c:\contrato.html');
end;


