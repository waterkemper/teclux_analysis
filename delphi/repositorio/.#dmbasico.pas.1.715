              produtos.FieldByName('pisbasecalculo').clear;
              produtos.FieldByName('pisvalor').clear;
  //            produtos.FieldByName('pisaliquota').clear; {não pode zerar pois num recalculo perde-se o valor}
  //            produtos.FieldByName('pisisentas').AsCurrency := PISCOFINSBaseCalculo(produtos);
            end;
  //          end;
          end;

