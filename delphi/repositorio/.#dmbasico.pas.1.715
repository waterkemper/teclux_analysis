  frxGlobalVariables.Variables['EstadoFilialBase']:= FEstadoFilialBase;
  frxGlobalVariables.Variables['FoneFilialBase']  := FormatarFone(FDDDFilialBase, FFoneFilialBase);
  frxGlobalVariables.Variables['FaxFilialBase']   := FormatarFone(FDDDFilialBase, FFaxFilialBase);
  frxGlobalVariables.Variables['CNPJFilialBase']  := FormatarCPFouCGC(FCNPJFilialBase);
  frxGlobalVariables.Variables['IEFilialBase']  := FInscricaoEstadualFilialBase;
  frxGlobalVariables.Variables['IMFilialBase']  := FInscricaoMunicipalFilialBase;

  frxGlobalVariables.Variables['Razao']  := FRazaoFilialBase;
  frxGlobalVariables.Variables['CNPJ']   := FormatarCPFouCGC(FCNPJFilialBase);
  frxGlobalVariables.Variables['InscricaoEstadual']:= FInscricaoEstadualFilialBase;
  frxGlobalVariables.Variables['InscricaoMunicipal']  := FInscricaoMunicipalFilialBase;
  frxGlobalVariables.Variables['Rua']   := FRuaFilialBase;
  frxGlobalVariables.Variables['Bairro']:= FBairroFilialBase;
  frxGlobalVariables.Variables['Cep']:= FormatarCEP(FCepFilialBase);
  frxGlobalVariables.Variables['Cidade']:= FCidadeFilialBase;
  frxGlobalVariables.Variables['Estado']:= FEstadoFilialBase;
  frxGlobalVariables.Variables['Junta']:= FJuntaFilialBase;
