//    view.BandAlign := baTop;
  end
  else
  if (view.Name = 'mmoCNPJ') or
     (view.Name = 'mmoCNPJ2') then
    view.SetBounds(169,66,150,10)
  else
  if (view.Name = 'mmoIE') or
     (view.Name = 'mmoIE2') then
    view.SetBounds(169,77,150,10)
  else

  if (view.Name = 'mmoTITULO') or
     (view.Name = 'mmoTITULO2') then
  begin
    view.SetBounds(340,46,306,42);
//    view.BandAlign := baTop;
  end
  else
  if (view.Name = 'mmoSUBTITULO') or
     (view.Name = 'mmoSUBTITULO2') then
    view.SetBounds(340,66,306,42)
