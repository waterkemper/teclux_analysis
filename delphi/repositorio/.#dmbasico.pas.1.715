          if (OrigemCalculo in [NotaEntrada,  CadastroPedidos, TransferenciaEntrada]) and not PermiteAlterarDadosICMS then
          begin
            vDiferenca := notas.fieldbyname('valoricmssubstituicao').ascurrency - vvaloricmsst;
            if (abs(vDiferenca) <= 0.1) and (abs(vDiferenca)<>0) then
            begin
              produtos.last;
              while not produtos.Bof do
              begin
                if produtos.fieldbyname('icmsvalorst').AsCurrency <> 0 then
                begin
                  produtos.edit;
                  produtos.fieldbyname('icmsvalorst').AsCurrency := produtos.fieldbyname('icmsvalorst').AsCurrency + vDiferenca;
                  produtos.post;
                  vValorICMSST := notas.fieldbyname('valoricmssubstituicao').ascurrency;
                  break;
                end;
                produtos.prior;
              end;
            end;
          end;

