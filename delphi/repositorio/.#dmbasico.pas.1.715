  function PrecoComponente(tProdutos: TClientDataSet): String;
  begin
    result := 'precovenda';
    if lowercase(tprodutos.Name) = 'qryprodutoscompostos' then result := 'preco'
    else
    if lowercase(tprodutos.Name) = 'qryprodutosdadosfiscaiscompostos' then result := 'precovenda'
  end;
                               
  function HeComponente: boolean;
  begin
    result := (lowercase(produtos.Name)='qryprodutoscompostos') or
              (lowercase(produtos.Name) = 'qryprodutosdadosfiscaiscompostos');
  end;

  function CampoProduto: String;
  begin
    result := 'produto';
    if (lowercase(produtos.Name) = 'qryprodutoscompostos') or
       (lowercase(produtos.Name) = 'qryprodutosdadosfiscaiscompostos') then
      result := 'componente'
    else
    if OrigemCalculo in [NotaAcrescimoFinanceiro] then
    begin
      if Produtos.FindField('codigovisual')<>nil then
        result := 'codigovisual'
      else
        result := 'produto';
    end
    else
    if OrigemCalculo in [NotaEntrada, NotaEntradaXML, TransferenciaEntrada, Devolucao, Troca] then
      result  := 'produto';

  end;

  function CampoProdutoVisual: String;
  begin
    result := 'codigovisual';
    if (lowercase(produtos.Name) = 'qryprodutoscompostos') or
       (lowercase(produtos.Name) = 'qryprodutosdadosfiscaiscompostos') then
      result := 'componente'
    else
    if (lowercase(produtos.Name) = 'qryprodutoscontratos') or
       (lowercase(produtos.Name) = 'qryprodutosorcamentos') or
       (origemCalculo in [Contrato, NotaContrato, NotaAvulsa, CadastroPedidos]) then
      result := 'produtovisual'
    else
//    if OrigemCalculo in [devolucao, troca, NotaAcrescimoFinanceiro, NotaEntrada, NotaEntradaXML, TransferenciaEntrada] then
    begin
      if Produtos.FindField('codigovisual')<>nil then
        result := 'codigovisual'
      else
        result := 'produto';
    end;

  end;

  function PrecoUnitario(tProdutos: TClientDataSet): Real;
  begin
    if (OrigemCalculo in [CadastroPedidos]) then
      result := tprodutos.FieldByName('preco').AsFloat
    else
    if not Saida or (tprodutos.Name='qryProdutosNotaFiscal') or (OrigemCalculo in [Devolucao, Troca, NotaAcrescimoFinanceiro]) then
      result := tprodutos.FieldByName('precounitario').AsFloat
    else
    begin
      if hecomponente then
        result := tprodutos.fieldbyname(precocomponente(tProdutos)).AsFloat
      else
        result := tprodutos.FieldByName('precovenda').AsFloat;
    end;
  end;

