  function CondicaoRequerNFSaida: boolean;
  begin
    result := false;
    if (OrigemCalculo in  [NotaEntrada, Devolucao, Troca]) then
      result := ((Notas.FindField('requernfsaida')<>nil) and
                 (notas.fieldbyname('requernfsaida').AsBoolean)) or

                ((produtos.findfield('dadofiscal')<>nil) and
                 (produtos.FieldByName('dadofiscal').asinteger<>0));
  end;


  function PermiteAlterarDadosIPI: boolean;
  begin
    result := True;
    if not saida then
    begin
      if OrigemCalculo = TransferenciaEntrada then
        result := false
      else
      begin

        if (produtos.FindField('numerosequencianfe')<>nil) then
          result := produtos.fieldbyname('numerosequencianfe').asinteger=0;

        if result then
           if (notas.findField('tipo')<>nil) then
              result := not ((Notas.fieldbyname('tipo').asString = 'CTe') or
                             (Notas.fieldbyname('tipo').asString = 'NFe') or
                             (Notas.fieldbyname('tipo').asString = 'NFCe'));

        if result then
          result := not CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos);

      end;
    end
    else
    begin
      if OrigemCalculo = NotaAvulsa then
        result := not CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos);
    end;
  end;

  function PermiteAlterarDadosICMS(LocalAlteracao: tLocalAlteracao = tpAltProdutos): boolean;
  var
    veHCancelamento : Boolean;

  begin
                {
    if OrigemCalculo = cadastropedidos then
      result := false
    else
    }
      result := True;

    if not saida then
    begin
      if (OrigemCalculo = TransferenciaEntrada) then
        result := false
      else
      begin
        if LocalAlteracao = tpAltNotas then
          result := true
        else
        if CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos) then
          result := false
        else
        if (LocalAlteracao in [tpAltICMSOutras, tpAltICMSIsentas]) then
          result := true
        else
        begin

          if produtos.FindField('numerosequencianfe')<>nil then
            result := produtos.fieldbyname('numerosequencianfe').asinteger=0;

          if result then
             if (notas.findField('tipo')<>nil) then
                result := not ((Notas.fieldbyname('tipo').asString = 'CTe') or
                               (Notas.fieldbyname('tipo').asString = 'NFe') or
                               (Notas.fieldbyname('tipo').asString = 'NFCe'));

        end;
      end;
    end
    else
    if (OrigemCalculo = DevolucaoPorTransferencia) then
    begin
      case LocalAlteracao of
        tpAltProdutos : result := false;
        tpAltNotas : result := true;
      end
    end
    else
    if OrigemCalculo = NotaAvulsa then
    begin
      if not CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos) then
      begin
        if LocalAlteracao = tpAltNotas then
          result := true
        else
        if LocalAlteracao = tpAltICMSIsentas then
          result := true
        else
        if LocalAlteracao = tpAltICMSOutras then
          result := true;
      end
      else
        result := true;

      {
      result := not CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos);
      if not result then
        if LocalAlteracao = tpAltNotas then
          result := true
        else
        if LocalAlteracao = tpAltICMSIsentas then
          result := true
        else
        if LocalAlteracao = tpAltICMSOutras then
          result := true;
       }

    end;
    {
    else
    if (OrigemCalculo in [Devolucao,Troca]) and requernfsaida then
      result := false
      }


  end;


