  function ResponsavelDifal: boolean;
  var
    ArrayDadosFiscais : TVariantArray;
  begin
    result := false;
    if saida then
    begin
      if fREsponsavelDifal <> '' then
        result := StrToBool(fREsponsavelDifal)
      else
      begin
      {
        if (notas.findfield('responsaveldifal') <> nil) then
          result := notas.fieldbyname('responsaveldifal').asBoolean
        else
        }
        if (notas.findfield('estado') <> nil) and
           (notas.fieldbyname('estado').asString<>'') then
          ArrayDadosFiscais := ValorCampodaTabela('estados', ['codigo'], [notas.fieldbyname('estado').asString], ['responsaveldifal','datainiciodifal'])
        else
          ArrayDadosFiscais := ValorCampodaTabela('estados', ['codigo'], [estadofilialbase], ['responsaveldifal','datainiciodifal']);

        result := ArrayDadosFiscais[0];

        fREsponsavelDifal := BoolToStr(ArrayDadosFiscais[0]);
        if ArrayDadosFiscais[1] <> null then
          fdatainiciodifal := ArrayDadosFiscais[1]
        else
          fdatainiciodifal := 0;

      end;
    end;
  end;

  function datainiciodifal: TDateTime;
  begin
    result := fdatainiciodifal;
  end;

