function TdtmBasico.ExibirFichacliente(cliente:integer;tipocliente,nomecliente,FormOrigem:String): Boolean;
var
  vNao_RestringirFichaCliente, FichaExibida: Boolean;
  qryClienteMensagem: TtecQuery;
  vGotoDebitPanel: Boolean;

  procedure ExibirFicha(msg : String; pParcelaAtrasada, pChequeDevolvido, pclientesparcelasfuturaemaberto, pcheques_futuroemaberto : boolean);
  var
    vDescricaoMensagem: String;

  begin
     if parsistema.CLIENTE_INADIMPLENTE_SO_COM_ANALISTA_DE_CREDITO then
       SituacaoLiberacaoInadimplentes :=  NAOLIBERADO;

    if ParSistema.PerguntarAntesExibirFicha then
    begin
      vDescricaoMensagem := '';

      if pParcelaAtrasada  then
        vDescricaoMensagem := 'PARCELAS EM ATRASO, ';

      if pChequeDevolvido then
        vDescricaoMensagem := vDescricaoMensagem + 'CHEQUE DEVOLVIDO, ';

      if pclientesparcelasfuturaemaberto then
        vDescricaoMensagem := vDescricaoMensagem + 'PARCELAS FUTURAS EM ABERTO, ';

      if pcheques_futuroemaberto then
        vDescricaoMensagem := vDescricaoMensagem + 'CHEQUES FUTUROS EM ABERTO, ';

      if vDescricaoMensagem <> '' then
      begin
        vDescricaoMensagem := copy(vDescricaoMensagem, 1, length(vDescricaoMensagem)-2);
//        vDescricaoMensagem := AnsiReverseString(vDescricaoMensagem);
        vDescricaoMensagem := StringReplace(vDescricaoMensagem, ', ', ' e ', []);
//        vDescricaoMensagem := AnsiReverseString(vDescricaoMensagem);

        if MensagemConfirmacao(format(msg,[NomeCliente, vDescricaoMensagem]), MB_DEFBUTTON2, Parsistema.Fechamento_da_tela_de_avisos_do_cliente_somente_com_mouse ) = smbOK then
        begin

          TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([Cliente,
                                                                           TipoCliente, FormOrigem, false, vGotoDebitPanel], 'TfrmFichaFinanceira', True);
          FichaExibida := true;
        end;

      end
      else
      begin
        if MensagemConfirmacao(format(msg,[NomeCliente]), MB_DEFBUTTON2, Parsistema.Fechamento_da_tela_de_avisos_do_cliente_somente_com_mouse) = smbOK then
        begin
          TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([Cliente,
                                                                           TipoCliente, FormOrigem, false, vGotoDebitPanel], 'TfrmFichaFinanceira', True);
          FichaExibida := true;
        end;
      end;
    end
    else
    begin
      TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([Cliente,
                                                                       TipoCliente, FormOrigem, false, vGotoDebitPanel], 'TfrmFichaFinanceira', True);
      FichaExibida := true;
    end;
  end;

  function ObterAutorizacaoAnalistaCredito_LiberarFicha: Boolean;
  begin
    result := False;
    if UsuarioLogin.AnalistaCredito then
      UsuarioAutAux := ObterAutorizacao(taSENHA, 'Liberar visualização da ficha do cliente', 'Analista de Crédito', 'Usuário logado é analista, confirme a senha!')
    else;
      UsuarioAutAux := ObterAutorizacao(taLOGIN, 'Liberar visualização da ficha do cliente', 'Analista de Crédito', 'Liberação somente com um analista de crédito!');

    if Assigned(UsuarioAutAux) then
    begin
      if UsuarioAutAux.AnalistaCredito then
        result := true
      else
      begin
        result := false;
        MensagemAviso('A Autorização requer um Analista de Crédito.');
      end;
      freeandnil(UsuarioAutAux);
    end
    else
    begin
      result := false;
      MensagemAviso('A Autorização requer um Analista de Crédito.');
    end;
  end;

begin
  FichaExibida := false;
  qryClienteMensagem := TtecQuery.Create(nil);
  qryClienteMensagem.Database := dtmTecSoft.Database;
  qryClienteMensagem.Sql.Text := VerificarClienteAtrasado;

  ReFazConsultaporNome(qryClienteMensagem,['cliente','tipocliente'], [cliente,tipocliente]);

  if (qryClienteMensagem.Fieldbyname('FichaAlerta').AsString<>'') then
    MensagemAviso(qryClienteMensagem.Fieldbyname('FichaAlerta').AsString, parsistema.Fechamento_da_tela_de_avisos_do_cliente_somente_com_mouse);

  if (qryClienteMensagem.Fieldbyname('AlertaAtendimentosAbertos').AsString<>'') then
    MensagemAviso(qryClienteMensagem.Fieldbyname('AlertaAtendimentosAbertos').AsString, parsistema.Fechamento_da_tela_de_avisos_do_cliente_somente_com_mouse);


  vGotoDebitPanel := qryClienteMensagem.Fieldbyname('clienteatrasado').AsBoolean or
                     qryClienteMensagem.Fieldbyname('chequedevolvido').AsBoolean or
                     qryClienteMensagem.Fieldbyname('clientesparcelasfuturaemaberto').AsBoolean or
                     qryClienteMensagem.Fieldbyname('cheques_futuroemaberto').AsBoolean;


  if not qryClienteMensagem.Fieldbyname('naoexibirfichafinanceira').AsBoolean then
  begin

    vNao_RestringirFichaCliente :=  not UsuarioLogin.RestringirFichaCliente;

    if UsuarioLogin.RestringirFichaCliente and
       parsistema.CLIENTE_INADIMPLENTE_SO_COM_ANALISTA_DE_CREDITO and
       vGotoDebitPanel then
      vNao_RestringirFichaCliente := ObterAutorizacaoAnalistaCredito_LiberarFicha;


    if (ParSistema.MostrarFichaSomenteAtraso in [1,2]) then  { 1 - mostrar somente com atraso   |   2 - mostrar somente com atraso ou valores em aberto }
    begin

      if vGotoDebitPanel then
      begin
        if vNao_RestringirFichaCliente then

          ExibirFicha(ctCLIENTEPOSSUIATRASO,
                      qryClienteMensagem.Fieldbyname('clienteatrasado').AsBoolean,
                      qryClienteMensagem.Fieldbyname('chequedevolvido').AsBoolean,
                      qryClienteMensagem.Fieldbyname('clientesparcelasfuturaemaberto').AsBoolean,
                      qryClienteMensagem.Fieldbyname('cheques_futuroemaberto').AsBoolean);
      end;

    end
    else  {0 - Sempre mostrar ficha }
    if vNao_RestringirFichaCliente then
    begin

      if vGotoDebitPanel then

         ExibirFicha(ctCLIENTEPOSSUIATRASO,
                    qryClienteMensagem.Fieldbyname('clienteatrasado').AsBoolean,
                    qryClienteMensagem.Fieldbyname('chequedevolvido').AsBoolean,
                    qryClienteMensagem.Fieldbyname('clientesparcelasfuturaemaberto').AsBoolean,
                    qryClienteMensagem.Fieldbyname('cheques_futuroemaberto').AsBoolean)
       else
         ExibirFicha(ctVISUALIZARFICHAFINANCEIRA, qryClienteMensagem.Fieldbyname('clienteatrasado').AsBoolean,
                                                  qryClienteMensagem.Fieldbyname('chequedevolvido').AsBoolean,
                                                  qryClienteMensagem.Fieldbyname('clientesparcelasfuturaemaberto').AsBoolean,
                                                  qryClienteMensagem.Fieldbyname('cheques_futuroemaberto').AsBoolean );

    end;
  end;

  result := FichaExibida;
end;

function TdtmBasico.ClienteCartaDevolvida(Cliente: Integer; TipoCliente, NomeCliente, FormOrigem: String): Boolean;
var
  CadastroAberto: Boolean;
  procedure AbrirConsulta;
  begin
    qryClienteEnderecoDesatualizado := TtecQuery.Create(nil);
    qryClienteEnderecoDesatualizado.Database := dtmTecSoft.Database;
    qryClienteEnderecoDesatualizado.Sql.Text := VerificarClienteCartaDevolvida;
    RefazConsulta(qryClienteEnderecoDesatualizado, [0,1], [Cliente, TipoCliente]);
  end;
begin
  CadastroAberto := false;
  if not assigned(qryClienteEnderecoDesatualizado) then
    AbrirConsulta
  else
  if (qryClienteEnderecoDesatualizado.Fields[0].Asinteger <> cliente) or
     (qryClienteEnderecoDesatualizado.Fields[1].AsString <> tipocliente) then
    RefazConsulta(qryClienteEnderecoDesatualizado, [0,1], [Cliente, TipoCliente]);

  if qryClienteEnderecoDesatualizado.Fields[2].AsBoolean then
  begin
    if FormOrigem = 'TfrmCadastroContratos' then begin
      if MensagemConfirmacao(Format(ctENDERECODESATUALIZADO, [NomeCliente])) = smbOK then
        CadastroAberto := True;
    end
    else if FormOrigem = 'TfrmCadastroClientes' then
      CadastroAberto := True
    else
    begin
      if MensagemConfirmacao(Format(ctENDERECODESATUALIZADO, [NomeCliente])) = smbOK then begin
        TfrmPrincipalBasico(Application.MainForm).MostrarFormRegistrado([Cliente, TipoCliente, FormOrigem], 'TfrmCadastroClientes', True);
        CadastroAberto := true;
      end;
    end;
  end;

  Result := CadastroAberto;
end;

procedure TdtmBasico.GuardarRegistroAtual(Tabela: TtecQuery; DesligarControles: Boolean);
begin
 FRegistroAtual := Tabela.GetBookmark;
 if DesligarControles then
   Tabela.DisableControls;
end;

procedure TdtmBasico.VoltarRegistroAtual(Tabela: TtecQuery);
begin
  Tabela.GotoBookmark(FRegistroAtual);
  Tabela.FreeBookmark(FRegistroAtual);
  tabela.EnableControls;
end;

