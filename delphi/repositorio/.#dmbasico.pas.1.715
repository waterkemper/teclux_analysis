        (* NÃO FAZ MAIS SENTIDO RATEAR ST NOS PRODUTOS

        if PermiteAlterarDadosICMS then
        begin

          if (OrigemCalculo in [NotaEntrada,  CadastroPedidos,  TransferenciaEntrada]) and
             (((notas.fieldbyname('baseicmssubstituicao') .AsCurrency<>0) and (vBaseICMSSTCusto <>0)) or
              ((notas.fieldbyname('valoricmssubstituicao').AsCurrency<>0) and (vValorICMSSTCusto<>0))) then
          begin
            BaseICMSSTRateada  := 0;
            ValorICMSSTRateada := 0;
            produtos.First;
            while not produtos.Eof do
            begin
              if CondicaopMVAST(cst_nf,
                                csosn_nf,
                                crt) and not heimportacao then
              begin
                if vBaseICMSSTCusto<>0 then
                begin
                  EditarProdutos;
                  produtos.fieldbyname('ICMSBaseCalculoST').AsCurrency :=  ArredondarouTruncar(produtos.fieldbyname('ICMSBaseCalculoSTCusto').AsCurrency +
                                                                           produtos.fieldbyname('ICMSBaseCalculoSTCusto').AsCurrency *
                                                                                 (notas.fieldbyname('baseicmssubstituicao') .AsCurrency -
                                                                                  vBaseICMSSTCusto)/
                                                                                 vBaseICMSSTCusto, -2);
                  BaseICMSSTRateada  := BaseICMSSTRateada + produtos.fieldbyname('ICMSBaseCalculoST').AsCurrency;
                  UltimoProdutoBaseICMSST := produtos.fieldbyname(campoproduto).asstring;
                  vBaseICMSST  := vBaseICMSST + produtos.fieldbyname('icmsbasecalculoST').AsCurrency;
                end;

                if vValorICMSSTCusto<>0 then
                begin
                  EditarProdutos;
                  produtos.fieldbyname('ICMSValorST').AsCurrency :=  ArredondarouTruncar(produtos.fieldbyname('ICMSValorSTCusto').AsCurrency +
                                                                     produtos.fieldbyname('ICMSValorSTCusto').AsCurrency *
                                                                           (notas.fieldbyname('valoricmssubstituicao') .AsCurrency -
                                                                            vValorICMSSTCusto)/
                                                                           vValorICMSSTCusto, -2);
                  ValorICMSSTRateada  := ValorICMSSTRateada + produtos.fieldbyname('ICMSValorST').AsCurrency;
                  UltimoProdutoValorICMSST := produtos.fieldbyname(campoproduto).asstring;
                  vValorICMSST := vValorICMSST + produtos.fieldbyname('icmsvalorST').AsCurrency;
                end;
              end;
              produtos.next;
            end;

            if (BaseICMSSTRateada <> notas.fieldbyname('baseicmssubstituicao').AsCurrency) then
            begin
              if produtos.Locate(campoproduto, UltimoProdutoBaseICMSST,[]) then
              begin
                vBaseICMSST  := vBaseICMSST - produtos.fieldbyname('icmsbasecalculoST').AsCurrency;
                EditarProdutos;
                produtos.fieldbyname('ICMSBaseCalculoST').AsCurrency := produtos.fieldbyname('ICMSBaseCalculoST').AsCurrency +
                                                                       (notas.fieldbyname('baseicmssubstituicao').AsCurrency -
                                                                        BaseICMSSTRateada);
                produtos.Post;
                vBaseICMSST  := vBaseICMSST + produtos.fieldbyname('icmsbasecalculoST').AsCurrency;
              end;
            end;

            if (ValorICMSSTRateada <> notas.fieldbyname('valoricmssubstituicao').AsCurrency) then
            begin
              if produtos.Locate(campoproduto, UltimoProdutoValorICMSST,[]) then
              begin
                vValorICMSST := vValorICMSST - produtos.fieldbyname('icmsvalorST').AsCurrency;
                EditarProdutos;
                produtos.fieldbyname('ICMSValorST').AsCurrency := produtos.fieldbyname('ICMSValorST').AsCurrency +
                                                                       (notas.fieldbyname('valoricmssubstituicao').AsCurrency -
                                                                        ValorICMSSTRateada);
                produtos.Post;
                vValorICMSST := vValorICMSST + produtos.fieldbyname('icmsvalorST').AsCurrency;
              end;
            end;
          end;
        end;
        *)


        AtualizarClientDataSet_to_TTecQuery(produtos, produtositens);


        if (calculos <> nil) and calculos.active then
        begin
          produtos.First;
          while not produtos.Eof do
          begin
            if regimeTributario = 1 then
            begin
              if calculos.Locate('tipo;incidencia;codigofiscal;aliquota',
                                  VarArrayof(['ICMS',
                                  produtos.fieldbyname('origem').asString+
                                  produtos.FieldByName('csosn').asstring,
                                  produtos.FieldByName('codigofiscal').asstring,
                                  {produtos.fieldbyname('aliquotaicms').AsCurrency} 0.00]),[]) then
                Calculos.Edit
              else
              begin
                calculos.Append;
                if calculos.FindField('codigonota')<>nil then
                  calculos.fieldbyname('codigonota').AsInteger := notas.fieldbyname('codigo').AsInteger;
              end;

              Calculos.fieldbyname('incidencia').asstring    := produtos.fieldbyname('origem').asString+
                                                                produtos.FieldByName('csosn').asstring;
            end
            else
            begin
              if calculos.Locate('tipo;incidencia;codigofiscal;aliquota',
                                  VarArrayof(['ICMS',
                                  produtos.fieldbyname('origem').asString+
                                  produtos.FieldByName('incidencia').asstring,
                                  produtos.FieldByName('codigofiscal').asstring,
                                  produtos.fieldbyname('aliquotaicms').AsCurrency]),[]) then
                Calculos.Edit
              else
              begin
                calculos.Append;
                if calculos.FindField('codigonota')<>nil then
                  calculos.fieldbyname('codigonota').AsInteger := notas.fieldbyname('codigo').AsInteger;
              end;

              Calculos.fieldbyname('incidencia').asstring    := produtos.fieldbyname('origem').asString+
                                                                produtos.FieldByName('incidencia').asstring;
            end;
            Calculos.fieldbyname('tipo').asstring := 'ICMS';

            Calculos.FieldByName('codigofiscal').asstring  := produtos.FieldByName('codigofiscal').asstring;

            if  regimeTributario = 1 then
              Calculos.FieldByName('aliquota').AsCurrency    := 0.00
            else
              Calculos.FieldByName('aliquota').AsCurrency    := produtos.fieldbyname('aliquotaicms').AsCurrency;

               {tem condicao de base)}

            if ((CondicaoBaseICMS(cst_nf, csosn_nf, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and not saida) and
                (CondicaoBaseICMS(cst_empresa, csosn_empresa, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and not saida)) or
                (CondicaoBaseICMS(cst_empresa, csosn_empresa, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and saida and not NotaFiscalVinculada) then

            begin
              if  not naoGerarCreditoICMS and (regimetributario<>1) then
              begin

                Calculos.FieldByName('basecalculo').AsCurrency := Calculos.FieldByName('basecalculo').AsCurrency +
                                                                  produtos.fieldbyname('icmsbasecalculo').AsCurrency;
                vCalculosICMSBase  := vCalculosICMSBase   + produtos.fieldbyname('icmsbasecalculo').AsCurrency;
                Calculos.FieldByName('valor').AsCurrency := Calculos.FieldByName('valor').AsCurrency +
                                                            produtos.fieldbyname('icmsvalor').AsCurrency;
                vCalculosICMSValor := vCalculosICMSValor  + produtos.fieldbyname('icmsvalor').AsCurrency;
              end
              else
              begin
                Calculos.FieldByName('outras').AsCurrency := Calculos.FieldByName('outras').AsCurrency +
                                                             produtos.fieldbyname('icmsbasecalculo').AsCurrency;
                vCalculosICMSOutras := vCalculosICMSOutras + produtos.fieldbyname('icmsbasecalculo').AsCurrency
              end;
            end
            else
            if ((CondicaoBaseICMS(cst_nf, csosn_nf, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and not saida) and
                not (CondicaoBaseICMS(cst_empresa, csosn_empresa, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and not saida)) and
                (regimetributario<>1) then
            begin
              Calculos.FieldByName('outras').AsCurrency := Calculos.FieldByName('outras').AsCurrency +
                                                           produtos.fieldbyname('icmsbasecalculo').AsCurrency;
              vCalculosICMSOutras := vCalculosICMSOutras + produtos.fieldbyname('icmsbasecalculo').AsCurrency
            end;


            Calculos.FieldByName('valorst').AsCurrency := Calculos.FieldByName('valorst').AsCurrency +
                                                          produtos.fieldbyname('icmsvalorst').AsCurrency;
            vCalculosICMSSTValor := vCalculosICMSSTValor + produtos.fieldbyname('icmsvalorst').AsCurrency;

            Calculos.FieldByName('isentas').AsCurrency := Calculos.FieldByName('isentas').AsCurrency +
                                                          produtos.fieldbyname('icmsisentas').AsCurrency;
            vCalculosICMSIsentas := vCalculosICMSIsentas + produtos.fieldbyname('icmsisentas').AsCurrency;


            If not Heimportacao then
            begin

              Calculos.FieldByName('outras').AsCurrency := Calculos.FieldByName('outras').AsCurrency +
                                                           produtos.fieldbyname('icmsoutras').AsCurrency +
                                                           produtos.fieldbyname(CampoValorReducaoBase).AsCurrency +
                                                           {produtos.fieldbyname('reducaobasest').AsCurrency +}
                                                           ifthen(ICMSSobreIPI(Produtos), 0, produtos.fieldbyname('valoripi').ascurrency) +
                                                           {ifthen(ICMSSobreDespesasAcessorias(Produtos), 0, produtos.fieldbyname('despesasacessorias').ascurrency) +}
                                                           produtos.FieldByName('IcmsValorST').ascurrency;

              vCalculosICMSOutras := vCalculosICMSOutras + produtos.fieldbyname('icmsoutras').AsCurrency +
                                                           produtos.fieldbyname(CampoValorReducaoBase).AsCurrency +
                                                           {produtos.fieldbyname('reducaobasest').AsCurrency +}
                                                           ifthen(ICMSSobreIPI(Produtos), 0, produtos.fieldbyname('valoripi').ascurrency) +
                                                           {ifthen(ICMSSobreDespesasAcessorias(Produtos), 0, produtos.fieldbyname('despesasacessorias').ascurrency) +}
                                                           produtos.FieldByName('IcmsValorST').ascurrency;
            end
            else
            begin
              Calculos.FieldByName('outras').AsCurrency := Calculos.FieldByName('outras').AsCurrency +
                                                           produtos.fieldbyname('icmsoutras').AsCurrency +
                                                           produtos.fieldbyname(CampoValorReducaoBase).AsCurrency +
                                                          { produtos.fieldbyname('reducaobasest').AsCurrency +}
                                                           produtos.FieldByName('IcmsValorST').ascurrency;

              vCalculosICMSOutras := vCalculosICMSOutras + produtos.fieldbyname('icmsoutras').AsCurrency +
                                                           produtos.fieldbyname(CampoValorReducaoBase).AsCurrency +
                                                           {produtos.fieldbyname('reducaobasest').AsCurrency +}
                                                           produtos.FieldByName('IcmsValorST').ascurrency;
            end;

            Calculos.Post;
            produtos.Next;
          end;

          calculos.Append;
          Calculos.fieldbyname('tipo').asstring := 'TOTAL ICMS';
          Calculos.FieldByName('codigofiscal').clear;
          Calculos.FieldByName('aliquota').clear;
          Calculos.FieldByName('basecalculo').AsCurrency := vCalculosICMSBase;
          Calculos.FieldByName('valor').AsCurrency := vCalculosICMSValor;
          Calculos.FieldByName('valorst').AsCurrency := vCalculosICMSSTValor;
          Calculos.FieldByName('isentas').AsCurrency := vCalculosICMSIsentas;
          Calculos.FieldByName('outras').AsCurrency := vCalculosICMSOutras;
          calculos.FieldByName('total').AsCurrency := vCalculosICMSBase + vCalculosICMSIsentas + vCalculosICMSOutras;
          if calculos.FindField('codigonota')<>nil then
            calculos.fieldbyname('codigonota').AsInteger := notas.fieldbyname('codigo').AsInteger;

          Calculos.Post;

          if contribipi then
          begin
            produtos.First;
            while not produtos.Eof do
            begin
              if calculos.Locate('tipo;incidencia;codigofiscal;aliquota',
                                  VarArrayof(['IPI',
                                  produtos.fieldbyname('origem').asString+
                                  produtos.FieldByName('ipicst').asstring,
                                  produtos.FieldByName('codigofiscal').asstring,
                                  ifthen(NaoGerarCreditoIPI or NaoGerarDebitoIPI,0.00,produtos.fieldbyname('aliquotaipi').AsCurrency)]),[]) then
                Calculos.Edit
              else
              begin
                calculos.Append;
                if calculos.FindField('codigonota')<>nil then
                  calculos.fieldbyname('codigonota').AsInteger := notas.fieldbyname('codigo').AsInteger;
              end;

              Calculos.fieldbyname('incidencia').asstring    := produtos.fieldbyname('origem').asString+
                                                                produtos.fieldbyname('ipicst').asstring;

              Calculos.fieldbyname('tipo').asstring := 'IPI';

              Calculos.FieldByName('codigofiscal').asstring  := produtos.FieldByName('codigofiscal').asstring;

              Calculos.FieldByName('aliquota').AsCurrency    := ifthen(NaoGerarCreditoIPI or NaoGerarDebitoIPI,0.00,produtos.fieldbyname('aliquotaipi').AsCurrency);

              if not (NaoGerarCreditoIPI or NaoGerarDebitoIPI) then
              begin
                Calculos.FieldByName('basecalculo').AsCurrency := Calculos.FieldByName('basecalculo').AsCurrency +
                                                                  ifthen(heImportacao, produtos.fieldbyname('ipibasecalculo').Asfloat,
                                                                   produtos.fieldbyname('ipibasecalculo').AsCurrency);
                vCalculosIPIBase := vCalculosIPIBase + ifthen(heImportacao, produtos.fieldbyname('ipibasecalculo').Asfloat,
                                                                   produtos.fieldbyname('ipibasecalculo').AsCurrency);

                Calculos.FieldByName('valor').AsCurrency := Calculos.FieldByName('valor').AsCurrency +
                                                              produtos.fieldbyname('valoripi').AsCurrency;
                vCalculosIPIValor := vCalculosIPIValor + produtos.fieldbyname('valoripi').AsCurrency;
              end;

              Calculos.FieldByName('outras').AsCurrency := Calculos.FieldByName('outras').AsCurrency +
                                                           produtos.fieldbyname('ipioutras').AsCurrency+
                                                           ifthen(HeImportacao, 0, produtos.fieldbyname('despesasacessorias').AsCurrency)+
                                                           produtos.FieldByName('IcmsValorST').ascurrency +
                                                           ValorProdutos_vicmsstretdesp(produtos);


              vCalculosIPIOutras := vCalculosIPIOutras + produtos.fieldbyname('ipioutras').AsCurrency+
                                                         ifthen(HeImportacao, 0, produtos.fieldbyname('despesasacessorias').AsCurrency)+
                                                           produtos.FieldByName('IcmsValorST').ascurrency +
                                                           ValorProdutos_vicmsstretdesp(produtos);

              Calculos.FieldByName('isentas').AsCurrency := Calculos.FieldByName('isentas').AsCurrency +
                                                            produtos.fieldbyname('ipiisentas').AsCurrency;

              vCalculosIPIIsentas := vCalculosIPIIsentas + produtos.fieldbyname('ipiisentas').AsCurrency;


              Calculos.Post;
              produtos.Next;
            end;

            calculos.Append;
            Calculos.fieldbyname('tipo').asstring := 'TOTAL IPI';
            Calculos.FieldByName('codigofiscal').clear;
            Calculos.FieldByName('aliquota').clear;
            Calculos.FieldByName('basecalculo').AsCurrency := vCalculosIPIBase;
            Calculos.FieldByName('valor').AsCurrency := vCalculosIPIValor;
            Calculos.FieldByName('valorst').clear;
            Calculos.FieldByName('isentas').AsCurrency := vCalculosIPIIsentas;
            Calculos.FieldByName('outras').AsCurrency := vCalculosIPIOutras;
            calculos.FieldByName('total').AsCurrency := vCalculosIPIBase + vCalculosIPIValor + vCalculosIPIIsentas + vCalculosIPIOutras;
            if calculos.FindField('codigonota')<>nil then
              calculos.fieldbyname('codigonota').AsInteger := notas.fieldbyname('codigo').AsInteger;

            Calculos.Post;
          end;

        end;


        produtos.GotoBookmark(RegistroAtual);
        produtos.FreeBookmark(RegistroAtual);
        produtos.EnableControls;

  {      if calculos <> nil then
          calculos.SortByField('tipo,incidencia,codigofiscal,aliquota');}

        if not (EstadoNotaFiscal in [dsedit, dsinsert]) then
          notas.Edit;

        if (lowercase(notas.name)='qrycontratos') or
           (lowercase(notas.name)='qryorcamentos')  then
        begin
          if notas.findfield('vICMSUFDest')<>nil then
            notas.fieldbyname('vICMSUFDest').AsCurrency := notas.fieldbyname('vICMSUFDest').AsCurrency + vICMSUFDest;

          if notas.findfield('vICMSUFRemet')<>nil then
            notas.fieldbyname('vICMSUFRemet').AsCurrency := notas.fieldbyname('vICMSUFRemet').AsCurrency + vICMSUFRemet;

          notas.fieldbyname('valoricmssubstituicao').AsCurrency := notas.fieldbyname('valoricmssubstituicao').AsCurrency + vValorICMSST;
          notas.fieldbyname('totalipi').AsCurrency := notas.fieldbyname('totalipi').AsCurrency + vValorIPI;

          if origemCalculo = CalculoMargem then
          begin
            notas.fieldbyname('PisValorProdutos').AsCurrency := notas.fieldbyname('PisValorProdutos').AsCurrency + vValorPIS;
            notas.fieldbyname('CofinsValorProdutos').AsCurrency := notas.fieldbyname('CofinsValorProdutos').AsCurrency + vValorCOFINS;
            notas.fieldbyname('valoricms').AsCurrency := notas.fieldbyname('valoricms').AsCurrency + vValorICMS_semSt;
          end;

        end
        else
        begin

          if (OrigemCalculo in [NotaEntrada,  CadastroPedidos, TransferenciaEntrada]) then
          begin
            notas.fieldbyname('baseicmscalculada').AsCurrency := notas.fieldbyname('baseicmscalculada').AsCurrency + vbaseicms;
            notas.fieldbyname('valoricmscalculada').AsCurrency := notas.fieldbyname('valoricmscalculada').AsCurrency + vValorICMS;
            notas.fieldbyname('baseicmssubstituicaocalculada').AsCurrency := notas.fieldbyname('baseicmssubstituicaocalculada').AsCurrency + vBaseICMSST;
            notas.fieldbyname('valoricmssubstituicaocalculada').AsCurrency := notas.fieldbyname('valoricmssubstituicaocalculada').AsCurrency + vValorICMSST;
            notas.fieldbyname('valoripicalculada').AsCurrency := notas.fieldbyname('valoripicalculada').AsCurrency + vValorIPI;

          end
          else
          if (OrigemCalculo in [Devolucao,Troca]) then
          begin
            notas.fieldbyname('baseicms').AsCurrency := notas.fieldbyname('baseicms').AsCurrency + vbaseicms;
            notas.fieldbyname('valoricms').AsCurrency := notas.fieldbyname('valoricms').AsCurrency + vValorICMS;
            notas.fieldbyname('baseicmssubstituicao').AsCurrency := notas.fieldbyname('baseicmssubstituicao').AsCurrency + vBaseICMSST;
            notas.fieldbyname('valoricmssubstituicao').AsCurrency := notas.fieldbyname('valoricmssubstituicao').AsCurrency + vValorICMSST;
            notas.fieldbyname('valoripi').AsCurrency := notas.fieldbyname('valoripi').AsCurrency + vValorIPI;
          end
          else
          begin
            // em 06/06/2016 Jr solicitou que fosse atribuido o valor na nota destacando para notas de devolução os valores

            if saida and (regimetributario_ = 1) and
            //not eHNotaFiscalSaidaDevolucao(notas.fieldbyname('codigofiscal').Asinteger, false)
            (OrigemCalculo in [Contrato, CalculoMargem, NotaContrato, FrentedeCaixa]) then
            begin
              notas.fieldbyname('baseicms').clear;
              notas.fieldbyname('valoricms').clear;
            end
            else
            begin
              notas.fieldbyname('baseicms').AsCurrency := notas.fieldbyname('baseicms').AsCurrency + vbaseicms;
              notas.fieldbyname('valoricms').AsCurrency := notas.fieldbyname('valoricms').AsCurrency + vValorICMS;
            end;

            notas.fieldbyname('totalbaseicmssubstituicao').AsCurrency := notas.fieldbyname('totalbaseicmssubstituicao').AsCurrency + vBaseICMSST;
            notas.fieldbyname('totalvaloricmssubstituicao').AsCurrency := notas.fieldbyname('totalvaloricmssubstituicao').AsCurrency + vValorICMSST;
            notas.fieldbyname('valoripi').AsCurrency := notas.fieldbyname('valoripi').AsCurrency + vValorIPI;

          end;

          if OrigemCalculo = CadastroPedidos then
          begin
            notas.fieldbyname(CampoNotaTotalFrete).AsCurrency := {notas.fieldbyname(CampoNotaTotalFrete).AsCurrency +} vValorfrete;
            notas.fieldbyname('descontoitem').AsCurrency := {notas.fieldbyname('descontoitem').AsCurrency +} vValorDescontoitem;
          end
          else
          if CondicaoRequerNFEntrada or CondicaoRequerNFSaida then
          begin
            notas.fieldbyname(CampoNotaTotalFrete).AsCurrency := {notas.fieldbyname(CampoNotaTotalFrete).AsCurrency +} vValorfrete;
            notas.fieldbyname('desconto').AsCurrency := {notas.fieldbyname('desconto').AsCurrency +} vValorDesconto;
            notas.fieldbyname('descontoitem').AsCurrency := {notas.fieldbyname('descontoitem').AsCurrency +} vValorDescontoitem;
          end;

          notas.fieldbyname('totalvalorpis').AsCurrency := notas.fieldbyname('totalvalorpis').AsCurrency + vValorPIS;
          notas.fieldbyname('totalvalorcofins').AsCurrency := notas.fieldbyname('totalvalorcofins').AsCurrency + vValorCOFINS;

          if CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos) and not (AlteracaoEspecifica = tpAltEsp_DespesasAcessoriasNota) then
            notas.fieldbyname('despesasacessorias').AsCurrency := notas.fieldbyname('despesasacessorias').AsCurrency + vDespesasAcessorias;

          if origemCalculo = CadastroPedidos then
            notas.fieldbyname('totalproduto').AsCurrency := ValorTotalProdutos
          else
            notas.fieldbyname('totalprodutos').AsCurrency := ValorTotalProdutos;

          if notas.findfield('vFCP')<>nil then
            notas.fieldbyname('vFCP').AsCurrency := notas.fieldbyname('vFCP').AsCurrency + vFCP;

          if notas.findfield('vFCPST')<>nil then
            notas.fieldbyname('vFCPST').AsCurrency := notas.fieldbyname('vFCPST').AsCurrency + vFCPST;

          if notas.findfield('vFCPSTRet')<>nil then
            notas.fieldbyname('vFCPSTRet').AsCurrency := notas.fieldbyname('vFCPSTRet').AsCurrency + vFCPSTRet;


          if notas.findfield('vFCPUFDest')<>nil then
            notas.fieldbyname('vFCPUFDest').AsCurrency := notas.fieldbyname('vFCPUFDest').AsCurrency + vFCPUFDest;

          if notas.findfield('vICMSUFDest')<>nil then
            notas.fieldbyname('vICMSUFDest').AsCurrency := notas.fieldbyname('vICMSUFDest').AsCurrency + vICMSUFDest;

          if notas.findfield('vICMSUFRemet')<>nil then
            notas.fieldbyname('vICMSUFRemet').AsCurrency := notas.fieldbyname('vICMSUFRemet').AsCurrency + vICMSUFRemet;

          if notas.FindField('TotalQtdeProdutos')<> nil  then
            notas.fieldbyname('TotalQtdeProdutos').AsCurrency := notas.fieldbyname('TotalQtdeProdutos').AsCurrency + vQtdeProdutos;

          if notas.FindField('vBCSTRet')<>nil then
            notas.FieldByName('vBCSTRet').asCurrency := notas.FieldByName('vBCSTRet').asCurrency + vBCSTRet;

          if notas.FindField('vBCSTRetDesp')<>nil then
              notas.FieldByName('vBCSTRetDesp').asCurrency := notas.FieldByName('vBCSTRetDesp').asCurrency + vBCSTRetDesp;

          if notas.FindField('vICMSSTRet')<>nil then
            notas.FieldByName('vICMSSTRet').asCurrency := notas.FieldByName('vICMSSTRet').asCurrency + vICMSSTRet;

          if notas.FindField('vICMSSTRetDesp')<>nil then
              notas.FieldByName('vICMSSTRetDesp').asCurrency := notas.FieldByName('vICMSSTRetDesp').asCurrency + vICMSSTRetDesp;

          if notas.FindField('icmsbasecalculo_dev')<>nil then
            notas.FieldByName('icmsbasecalculo_dev').asCurrency := notas.FieldByName('icmsbasecalculo_dev').asCurrency + vicmsbasecalculo_dev;

          if notas.FindField('icmsvalor_dev')<>nil then
            notas.FieldByName('icmsvalor_dev').asCurrency := notas.FieldByName('icmsvalor_dev').asCurrency + vicmsvalor_dev;

          if notas.findfield('valorvista')<> nil then
          begin
            notas.fieldbyname('valorvista').AsCurrency :=  ValorVista;
                                                {
                           (notas.fieldbyname('totalprodutos').AsCurrency -
                           CampoNotaTotalAcrescimo +
                           CampoNotavaloricmssubstituicao +
                           notas.fieldbyname(CampoNotaTotalFrete).AsCurrency +
                           notas.fieldbyname('seguro').AsCurrency +
                           notas.fieldbyname('despesasacessorias').AsCurrency +
                           notas.fieldbyname('valorservicos').AsCurrency +
                           notas.fieldbyname(ifthen((not (origemcalculo in [NotaEntrada,TransferenciaEntrada])),'valoripi','valoripicalculada')).AsCurrency);
                           }

            if notas.findfield('vICMSSTRetDesp')<>nil then
              notas.fieldbyname('valorvista').AsCurrency := notas.fieldbyname('valorvista').AsCurrency + notas.fieldbyname('vICMSSTRetDesp').AsCurrency;

            if HeImportacao then
              notas.fieldbyname('valorvista').AsCurrency := notas.fieldbyname('valorvista').AsCurrency +
                                                         notas.fieldbyname('valoricms').AsCurrency;

            notas.fieldbyname(CampoValorNota).AsCurrency := notas.fieldbyname('valorvista').AsCurrency + CampoNotaTotalAcrescimo;
          end
          else
          if OrigemCalculo = CadastroPedidos then
            notas.fieldbyname(CampoValorNota).AsCurrency := ValorVista + CampoNotaTotalAcrescimo;

          if CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos) and
             not (((OrigemCalculo in [Devolucao,Troca]) and Condicaorequernfsaida) or
                  ((OrigemCalculo in [NotaAvulsa]) and CondicaorequernfEntrada)) then
          begin

            notas.fieldbyname('baseicms').ascurrency := notas.fieldbyname('baseicmscalculada').ascurrency;
            notas.fieldbyname('valoricms').ascurrency := notas.fieldbyname('valoricmscalculada').ascurrency;

            notas.fieldbyname('baseicmssubstituicao').ascurrency := notas.fieldbyname('baseicmssubstituicaocalculada').ascurrency;
            notas.fieldbyname('valoricmssubstituicao').ascurrency := notas.fieldbyname('valoricmssubstituicaocalculada').ascurrency;

            notas.fieldbyname('valoripi').ascurrency := notas.fieldbyname('valoripicalculada').ascurrency;
            notas.fieldbyname('valornota').ascurrency := notas.fieldbyname('valornotacalculada').ascurrency;


          end;


          if (OrigemCalculo in [NotaEntrada]) then
          begin
            if CondicaoRequerNFSaida then
            begin

              notas.fieldbyname('baseicms').ascurrency := notas.fieldbyname('baseicmscalculada').ascurrency;
              notas.fieldbyname('valoricms').ascurrency := notas.fieldbyname('valoricmscalculada').ascurrency;

              notas.fieldbyname('baseicmssubstituicao').ascurrency := notas.fieldbyname('baseicmssubstituicaocalculada').ascurrency;
              notas.fieldbyname('valoricmssubstituicao').ascurrency := notas.fieldbyname('valoricmssubstituicaocalculada').ascurrency;

              notas.fieldbyname('valoripi').ascurrency := notas.fieldbyname('valoripicalculada').ascurrency;
              notas.fieldbyname('valornota').ascurrency := notas.fieldbyname('valornotacalculada').ascurrency;
              notas.fieldbyname('despesasacessorias').AsCurrency := vDespesasAcessorias;
            end;
          end;

          if notas.findfield('vcredicmssn')<> nil then
            notas.fieldbyname('vcredicmssn').asCurrency := notas.fieldbyname('vcredicmssn').asCurrency + vCredICMSSN;

          {if (origemCalculo <> FrentedeCaixa) then}
          begin
            if notas.FindField('valortotalimpostoibt')<>nil then
              notas.FieldByName('valortotalimpostoibt').asCurrency := vvalortotalimpostoibt;
            if notas.FindField('valorimpostonacional')<>nil then
              notas.FieldByName('valorimpostonacional').asCurrency := vvalorimpostonacional;
           if notas.FindField('valorimpostoestadual')<>nil then
              notas.FieldByName('valorimpostoestadual').asCurrency := vvalorimpostoestadual;
          end;


          if notas.FindField(CampoObservacoes)<>nil then
          begin
            if (notas.findfield('vcredicmssn')<>nil) and (notas.fieldbyname('vcredicmssn').asCurrency <> 0) then
              notas.FieldByName(CampoObservacoes).AsString := format(ctLC123,[vCredICMSSN,AliquotaICMSSN])
            else
              notas.FieldByName(CampoObservacoes).clear;
          end;

          if (OrigemCalculo = NotaAvulsa) or
             (OrigemCalculo in [NotaEntrada, TransferenciaEntrada, Devolucao, Troca]) then
          begin

            if ((CondicaoRequerNFEntrada and eHNotaFiscalSaidaDevolucao(notas.fieldbyname('codigofiscal').Asinteger)) or
                (CondicaoRequerNFSaida and eHNotaFiscalEntradaDevolucao(notas.fieldbyname('codigofiscal').Asinteger)) or
                 CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos))

              and ((notas.FieldByName('vICMSSTRetDesp').asCurrency<>0) or
                   (notas.FieldByName('icmsvalor_dev').asCurrency<>0) or
                   ((notas.fieldByName('valoripi').ascurrency<>0) and not contribipi)) then
            begin
              // notas.FieldByName('despesasacessorias').asCurrency := notas.FieldByName('vICMSSTRet').asCurrency;
              if (notas.FindField('naoutilizarobsautomaticas') <> nil) and
                 not notas.Fieldbyname('naoutilizarobsautomaticas').AsBoolean then
              begin
                if (notas.FieldByName('vICMSSTRetDesp').asCurrency=0) and
                   ((notas.fieldByName('valoripi').ascurrency<>0) and not contribipi) then
                  notas.FieldByName('observacoes').asString := format(ctIPINAODESTACADO,
                          [vListanotas, notas.FieldByName('valoripi').asCurrency])
                else
                if (notas.FieldByName('vICMSSTRetDesp').asCurrency<>0) and
                   (notas.fieldByName('valoripi').ascurrency=0) then
                  notas.FieldByName('observacoes').asString := format(ctRICMSSC01_b,
                          [vListanotas, notas.FieldByName('icmsbasecalculo_dev').asCurrency, notas.FieldByName('icmsvalor_dev').asCurrency,
                                        notas.FieldByName('vBCSTRetDesp').asCurrency, notas.FieldByName('vICMSSTRetDesp').asCurrency])
                else
                  notas.FieldByName('observacoes').asString := format(ctRICMSSC01_b_comIPI,
                          [vListanotas, notas.FieldByName('icmsbasecalculo_dev').asCurrency, notas.FieldByName('icmsvalor_dev').asCurrency,
                                        notas.FieldByName('valoripi').asCurrency,
                                        notas.FieldByName('vBCSTRetDesp').asCurrency, notas.FieldByName('vICMSSTRetDesp').asCurrency]);

                notas.FieldByName('observacoes').asString := notas.FieldByName('observacoes').asString + ' DEV. SUA(S) NF(S) ' + vListanotas;
              end;
            end;
          end;

          if (produtos.FindField('pICMSInterPart')<>nil) and
              saida and
              VendaConsumidorFinal and OperacaoInterestadual  and
              (not contribicms OR (ContribICMS and responsaveldifal)) 
              and ((datainiciodifal = 0) or (datainiciodifal <= DatadaNota))
              and ((notas.FieldByName('vICMSUFDest').asCurrency<>0) or
                   (notas.FieldByName('vFCPUFDest').asCurrency<>0) or
                   (notas.FieldByName('vICMSUFRemet').asCurrency<>0)) then

              if not eHNotaComplementar then
                notas.FieldByName('observacoes').asString := notas.FieldByName('observacoes').asString + ObservacoesDifal;

          if (vICMSSTRet <> 0) and
             contribicms and
             ParSistema.DestacarSubstituicaoTributariaVendaContribuintesICMS and
             not eHNotaFiscalSaidaDevolucao(notas.fieldbyname('codigofiscal').Asinteger) then

            notas.FieldByName(CampoObservacoes).AsString := notas.FieldByName(CampoObservacoes).AsString + slinebreak +
                                                             format(ctRICMSSC01,[vBCSTRet, vICMSSTRet]);


        end;

        if not (EstadoNotaFiscal in [dsedit, dsinsert]) then
          notas.post;

        if (EstadoProdutos in [dsedit,dsinsert]) then
           Produtos.edit;

      end;
    end;

    if servicos <> nil then
    begin

      if servicos.RecordCount <> 0 then
      begin
        servicos.First;
        while not servicos.Eof do
        begin

          //PIS e COFINS
          {
             01     | Operação Tributável com Alíquota Básica
             02     | Operação Tributável com Alíquota Diferenciada
             03     | Operação Tributável com Alíquota por Unidade de Medida de Produto
             05     | Operação Tributável por Substituição Tributária
             49     | Outras Operações de Saída
             50     | Operação com Direito a Crédito - Vinculada Exclusivamente a Receita Tributada no Mercado Interno
             51     | Operação com Direito a Crédito  Vinculada Exclusivamente a Receita Não Tributada no Mercado Interno
             52     | Operação com Direito a Crédito - Vinculada Exclusivamente a Receita de Exportação
             53     | Operação com Direito a Crédito - Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno
             54     | Operação com Direito a Crédito - Vinculada a Receitas Tributadas no Mercado Interno e de Exportação
             55     | Operação com Direito a Crédito - Vinculada a Receitas Não-Tributadas no Mercado Interno e de Exportação
             56     | Operação com Direito a Crédito - Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno, e de Exportação
             60     | Crédito Presumido - Operação de Aquisição Vinculada Exclusivamente a Receita Tributada no Mercado Interno
             61     | Crédito Presumido - Operação de Aquisição Vinculada Exclusivamente a Receita Não-Tributada no Mercado Interno
             62     | Crédito Presumido - Operação de Aquisição Vinculada Exclusivamente a Receita de Exportação
             63     | Crédito Presumido - Operação de Aquisição Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno
             64     | Crédito Presumido - Operação de Aquisição Vinculada a Receitas Tributadas no Mercado Interno e de Exportação
             65     | Crédito Presumido - Operação de Aquisição Vinculada a Receitas Não-Tributadas no Mercado Interno e de Exportação
             66     | Crédito Presumido - Operação de Aquisição Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno, e de Exportação
             67     | Crédito Presumido - Outras Operações
             75     | Operação de Aquisição por Substituição Tributária
             98     | Outras Operações de Entrada
             99     | Outras Operações

          }

          if (servicos.FieldByName('piscst').AsString='') then
          begin
            if (CondicaoEmissorNFE or Sped_pis_cofins)  and (not Assigned(ECFPadrao) or NotaFiscalVinculada) then
            begin
              result := false;
              CancelarAtualizacoes([]);
              MensagemErro(format(msgErroincidencia_faltante, [servicos.fieldbyname('servico').asstring,
                            'PIS CST - Tributação do PIS']));
              break;
            end;
          end
          else
          if (servicos.FieldByName('piscst').AsString = '01') or
             (servicos.FieldByName('piscst').AsString = '02') or

             {codigo não presentes na nfe ainda: ficam como 99}

             (servicos.FieldByName('piscst').AsString = '05') or

             (servicos.FieldByName('piscst').AsString = '49') or
             (servicos.FieldByName('piscst').AsString = '50') or
             (servicos.FieldByName('piscst').AsString = '51') or
             (servicos.FieldByName('piscst').AsString = '52') or
             (servicos.FieldByName('piscst').AsString = '53') or
             (servicos.FieldByName('piscst').AsString = '54') or
             (servicos.FieldByName('piscst').AsString = '55') or
             (servicos.FieldByName('piscst').AsString = '56') or

             (servicos.FieldByName('piscst').AsString = '60') or
             (servicos.FieldByName('piscst').AsString = '61') or
             (servicos.FieldByName('piscst').AsString = '62') or
             (servicos.FieldByName('piscst').AsString = '63') or
             (servicos.FieldByName('piscst').AsString = '64') or
             (servicos.FieldByName('piscst').AsString = '65') or
             (servicos.FieldByName('piscst').AsString = '66') or
             (servicos.FieldByName('piscst').AsString = '67') or

             (servicos.FieldByName('piscst').AsString = '75') or
             (servicos.FieldByName('piscst').AsString = '98') or
             (servicos.FieldByName('piscst').AsString = '99') then


          begin
            if HeImportacao then
              {NÃO HÁ CALCULO PARA PIS NA NF DE IMPORTAÇÃO }
            else
            begin
  //            if not ValorPISDigitado then
              begin
                if not (servicos.state in [dsinsert, dsedit]) then
                  servicos.Edit;

               {Para importação este cálculo deve ser revisto}
                if servicos.FieldByName('aliquotapis').ascurrency = 0 then
                  servicos.FieldByName('aliquotapis').AsCurrency := parsistema.AliquotaPIS;

                servicos.FieldByName('pisbasecalculo').AsCurrency := PISCOFINSBaseCalculo_Servicos(servicos);
                servicos.FieldByName('pisvalor').AsCurrency :=
                      ArredondarouTruncar((servicos.FieldByName('pisbasecalculo').AsCurrency *
                               servicos.FieldByName('aliquotapis').AsCurrency)/100,-2);
              end;

            end;
          end
          else
          if (servicos.FieldByName('piscst').AsString = '03') then
          begin
            if CondicaoEmissorNFE and not Assigned(ECFPadrao) then
            begin
              result := false;
              CancelarAtualizacoes([]);
              MensagemErro('Código não preparado para PIS CST = 03');
              break;
            end;
          end
          else

          {
           04 - Operação Tributável (tributação monofásica (alíquota zero))
           06 - Operação Tributável (alíquota zero)
           08 - Operação Sem Incidência da Contribuição
           09 - Operação com Suspensão da Contribuição
           70     | Operação de Aquisição sem Direito a Crédito
           72     | Operação de Aquisição com Suspensão
           73     | Operação de Aquisição a Alíquota Zero
           74     | Operação de Aquisição sem Incidência da Contribuição
          }

          if (servicos.FieldByName('piscst').AsString = '04') or
             (servicos.FieldByName('piscst').AsString = '06') or
             (servicos.FieldByName('piscst').AsString = '08') or
             (servicos.FieldByName('piscst').AsString = '09') or
             (servicos.FieldByName('piscst').AsString = '70') or
             (servicos.FieldByName('piscst').AsString = '72') or
             (servicos.FieldByName('piscst').AsString = '73') or
             (servicos.FieldByName('piscst').AsString = '74') then
          begin
            {if HeImportacao then

            else
            begin}
  //            if not ValorPISDigitado then
              begin
                if not (servicos.state in [dsinsert, dsedit]) then
                  servicos.Edit;
                servicos.FieldByName('pisbasecalculo').clear;
                servicos.FieldByName('pisvalor').clear;
                servicos.FieldByName('aliquotapis').clear;
  //              servicos.FieldByName('pisoutras').AsCurrency := PISCOFINSBaseCalculo(produtos);
              end;

  //          end;
          end
          else
          {
           07 - Operação Isenta da Contribuição
           71     | Operação de Aquisição com Isenção
          }
          if (servicos.FieldByName('piscst').AsString = '07') or
             (servicos.FieldByName('piscst').AsString = '71') then
          begin
            {if HeImportacao then

            else
            begin}
  //          if not ValorPISDigitado then
            begin

              if not (servicos.state in [dsinsert, dsedit]) then
                servicos.Edit;
              servicos.FieldByName('pisbasecalculo').clear;
              servicos.FieldByName('pisvalor').clear;
              servicos.FieldByName('aliquotapis').clear;
  //            servicos.FieldByName('pisisentas').AsCurrency := PISCOFINSBaseCalculo(produtos);
            end;
  //          end;
          end;

          if (servicos.FieldByName('cofinscst').AsString='') then
          begin
            if (CondicaoEmissorNFE or Sped_pis_cofins)  and (not Assigned(ECFPadrao) or NotaFiscalVinculada) then
            begin
              result := false;
              CancelarAtualizacoes([]);
              MensagemErro(format(msgErroincidencia_faltante, [servicos.fieldbyname('servico').asstring,
                            'COFINS CST - Tributação do COFINS']));
              break;
            end;
          end
          else
          if (servicos.FieldByName('cofinscst').AsString = '01') or
             (servicos.FieldByName('cofinscst').AsString = '02') or

             {codigo não presentes na nfe ainda: ficam como 99}

             (servicos.FieldByName('cofinscst').AsString = '05') or

             (servicos.FieldByName('cofinscst').AsString = '49') or
             (servicos.FieldByName('cofinscst').AsString = '50') or
             (servicos.FieldByName('cofinscst').AsString = '51') or
             (servicos.FieldByName('cofinscst').AsString = '52') or
             (servicos.FieldByName('cofinscst').AsString = '53') or
             (servicos.FieldByName('cofinscst').AsString = '54') or
             (servicos.FieldByName('cofinscst').AsString = '55') or
             (servicos.FieldByName('cofinscst').AsString = '56') or

             (servicos.FieldByName('cofinscst').AsString = '60') or
             (servicos.FieldByName('cofinscst').AsString = '61') or
             (servicos.FieldByName('cofinscst').AsString = '62') or
             (servicos.FieldByName('cofinscst').AsString = '63') or
             (servicos.FieldByName('cofinscst').AsString = '64') or
             (servicos.FieldByName('cofinscst').AsString = '65') or
             (servicos.FieldByName('cofinscst').AsString = '66') or
             (servicos.FieldByName('cofinscst').AsString = '67') or

             (servicos.FieldByName('cofinscst').AsString = '75') or
             (servicos.FieldByName('cofinscst').AsString = '98') or
             (servicos.FieldByName('cofinscst').AsString = '99') then
          begin
            if HeImportacao then

            else
            begin
  //            if not ValorCOFINSDigitado then
              begin

                if not (servicos.state in [dsinsert, dsedit]) then
                servicos.Edit;

               {Para importação este cálculo deve ser revisto}
                if servicos.FieldByName('aliquotacofins').ascurrency = 0 then
                  servicos.FieldByName('aliquotacofins').AsCurrency := parsistema.AliquotaCofins;

                servicos.FieldByName('cofinsbasecalculo').AsCurrency := PISCOFINSBaseCalculo_Servicos(servicos);
                servicos.FieldByName('cofinsvalor').AsCurrency :=
                      ArredondarouTruncar((servicos.FieldByName('cofinsbasecalculo').AsCurrency *
                               servicos.FieldByName('aliquotacofins').AsCurrency)/100,-2);
              end;
            end;
          end
          else
          if (servicos.FieldByName('cofinscst').AsString = '03') then
          begin
            if CondicaoEmissorNFE and not Assigned(ECFPadrao) then
            begin
              result := false;
              CancelarAtualizacoes([]);
              MensagemErro('Código não preparado para cofins CST = 03');
              break;
            end;
          end
          else
          { 04 - Operação Tributável (tributação monofásica (alíquota zero));}
          { 06 - Operação Tributável (alíquota zero);}
          { 07 - Operação Isenta da Contribuição}
          { 08 - Operação Sem Incidência da Contribuição}
          { 09 - Operação com Suspensão da Contribuição}
          if (servicos.FieldByName('cofinscst').AsString = '04') or
             (servicos.FieldByName('cofinscst').AsString = '06') or
             (servicos.FieldByName('cofinscst').AsString = '08') or
             (servicos.FieldByName('cofinscst').AsString = '09') or
             (servicos.FieldByName('cofinscst').AsString = '70') or
             (servicos.FieldByName('cofinscst').AsString = '72') or
             (servicos.FieldByName('cofinscst').AsString = '73') or
             (servicos.FieldByName('cofinscst').AsString = '74') then

          begin
            {if HeImportacao then

            else
            begin}
  //            if not ValorCOFINSDigitado then
              begin
                if not (servicos.state in [dsinsert, dsedit]) then
                  servicos.Edit;
                servicos.FieldByName('cofinsbasecalculo').clear;
                servicos.FieldByName('cofinsvalor').clear;
                servicos.FieldByName('aliquotacofins').clear;
  //              servicos.FieldByName('cofinsoutras').AsCurrency := PISCOFINSBaseCalculo(produtos);
              end;

  //          end;
          end
          else
          {
           07 - Operação Isenta da Contribuição
           71     | Operação de Aquisição com Isenção
          }
          if (servicos.FieldByName('cofinscst').AsString = '07') or
             (servicos.FieldByName('cofinscst').AsString = '71') then
          begin
            {if HeImportacao then

            else
            begin}
  //          if not ValorCOFINSDigitado then
            begin
              if not (servicos.state in [dsinsert, dsedit]) then
                servicos.Edit;
              servicos.FieldByName('cofinsbasecalculo').clear;
              servicos.FieldByName('cofinsvalor').clear;
              servicos.FieldByName('aliquotacofins').clear;
  //            servicos.FieldByName('cofinsisentas').AsCurrency := PISCOFINSBaseCalculo(produtos);
            end;

  //          end;
          end;

          servicos.Next;
        end;

        if calculos <> nil then
        begin
          calculos.First;
          while not calculos.Eof do
          begin
            if Calculos.fieldbyname('tipo').asstring = 'ISS' then
              calculos.Delete
            else
              calculos.next;
          end;
        end;

        EstadoNotaFiscal := notas.State;

        RegistroAtualServico := servicos.GetBookmark;
        try
          vCalculosISSValor := 0;
          vCalculosISSIsentas := 0;
          vCalculosISSOutras := 0;

          vValorPIS_Servicos := 0;
          vValorCOFINS_Servicos := 0;

          Servicos.First;
          while Not Servicos.Eof do
          begin
            vValorPIS_Servicos := vValorPIS_Servicos + servicos.fieldbyname('pisvalor').AsCurrency;
            vValorCOFINS_Servicos := vValorCOFINS_Servicos + servicos.fieldbyname('cofinsvalor').AsCurrency;

            if calculos <> nil then
            begin
              if calculos.Locate('tipo;codigofiscal;aliquota',
                                  VarArrayof(['ISS',
                                  servicos.FieldByName('codigofiscal').asstring,
                                  servicos.fieldbyname('aliquotaissqn').AsCurrency]),[]) then
                Calculos.Edit
              else
              begin
                calculos.Append;
                if calculos.FindField('codigonota')<>nil then
                  calculos.fieldbyname('codigonota').AsInteger := notas.fieldbyname('codigo').AsInteger;
              end;

              Calculos.fieldbyname('tipo').asstring := 'ISS';
              Calculos.FieldByName('codigofiscal').asstring  := servicos.FieldByName('codigofiscal').asstring;
              Calculos.FieldByName('aliquota').AsCurrency    := servicos.fieldbyname('aliquotaissqn').AsCurrency;
            end;

            if servicos.fieldbyname('aliquotaissqn').AsCurrency=0 then
            begin
              if calculos <> nil then
                Calculos.FieldByName('isentas').AsCurrency := Calculos.FieldByName('isentas').AsCurrency +
                                                               (servicos.fieldbyname('quantidade').asFloat *
                                                                servicos.fieldbyname('valorservico').AsCurrency);

              vCalculosISSIsentas := vCalculosISSIsentas + (servicos.fieldbyname('quantidade').asFloat *
                                                            servicos.fieldbyname('valorservico').AsCurrency);
            end
            else
            begin
              if calculos <> nil then
                Calculos.FieldByName('basecalculo').AsCurrency := Calculos.FieldByName('basecalculo').AsCurrency +
                                                               (servicos.fieldbyname('quantidade').asFloat *
                                                                servicos.fieldbyname('valorservico').AsCurrency);

              vCalculosISSBase := vCalculosISSBase + (servicos.fieldbyname('quantidade').asFloat *
                                                      servicos.fieldbyname('valorservico').AsCurrency);
            end;

            if calculos <> nil then
            begin
              Calculos.FieldByName('valor').AsCurrency := Calculos.FieldByName('valor').AsCurrency +
                                                         servicos.fieldbyname('valorissqn').AsCurrency;
              Calculos.Post;
            end;

            vCalculosISSValor := vCalculosISSValor + servicos.fieldbyname('valorissqn').AsCurrency;
            servicos.Next;
          end;


          if calculos <> nil then
          begin
            calculos.Append;
            Calculos.fieldbyname('tipo').asstring := 'TOTAL ISS';
            Calculos.FieldByName('codigofiscal').clear;
            Calculos.FieldByName('aliquota').clear;
            Calculos.FieldByName('basecalculo').AsCurrency := vCalculosISSBase;
            Calculos.FieldByName('valor').AsCurrency := vCalculosISSValor;
            Calculos.FieldByName('valorst').clear;
            Calculos.FieldByName('isentas').AsCurrency := vCalculosISSIsentas;
            Calculos.FieldByName('outras').AsCurrency := vCalculosISSOutras;
            calculos.FieldByName('total').AsCurrency := vCalculosISSBase + vCalculosISSIsentas + vCalculosISSOutras;
            if calculos.FindField('codigonota')<>nil then
              calculos.fieldbyname('codigonota').AsInteger := notas.fieldbyname('codigo').AsInteger;
            Calculos.Post;
          end;
        finally
          servicos.GotoBookmark(RegistroAtualServico);
          servicos.FreeBookmark(RegistroAtualServico);
        end;

        if not (EstadoNotaFiscal in [dsedit, dsinsert]) then
          notas.Edit;

        notas.fieldbyname('ValorISSQN').AsCurrency := vCalculosISSValor;
        notas.fieldbyname('issqnbasecalculo').AsCurrency := vCalculosISSBase;

        notas.fieldbyname('totalvalorpis_servicos').AsCurrency := vValorPIS_Servicos;
        notas.fieldbyname('totalvalorcofins_servicos').AsCurrency := vValorCOFINS_Servicos;

        if not (EstadoNotaFiscal in [dsedit, dsinsert]) then
          notas.post;

      end;
    end;

  finally
    pCalculandoImpostos := False;
  end;

  lst_prod_calc_Imp := '';

end;

function TdtmBasico.CondicaoCancelamentoDadoFiscalReferenciado(
  OrigemCalculo: TtecOrigemCalculo; Notas: TtecQuery;
  produtos: TClientDataSet): boolean;
  function RequerNF: boolean;
  begin
    result := false;
    if (OrigemCalculo in  [NotaEntrada, Devolucao, Troca]) then
      result := ((Notas.FindField('requernfsaida')<>nil) and
                 (notas.fieldbyname('requernfsaida').AsBoolean)) or

                ((produtos.findfield('dadofiscal')<>nil) and
                 (produtos.FieldByName('dadofiscal').asinteger<>0))
    else
    if (OrigemCalculo in  [NotaAvulsa]) then
      result := ((produtos.findfield('codigonota')<>nil) and
                 (produtos.FieldByName('codigonota').asinteger<>0));

  end;

begin
 result := false;
 if OrigemCalculo = NotaEntrada then
  result :=  ((Notas.fieldbyname('dadofiscalreferenciado').asinteger <> 0) and
                 Notas.fieldbyname('cancelamentonfforaprazolegal').asBoolean)
 else
 if (OrigemCalculo in [Devolucao,Troca{, NotaAvulsa}]) and requernf then
    result := true
 else
 if (OrigemCalculo in [NotaAvulsa]) then
 begin
  if (Notas.findField('codigonotareferenciado') <> nil) and
     (Notas.findField('cancelamentonfforaprazolegal') <> nil) then
    result :=  (   (Notas.fieldbyname('codigonotareferenciado').asinteger <> 0) and
                   Notas.fieldbyname('cancelamentonfforaprazolegal').asBoolean  );

  if not result then

      result := ((Notas.FindField('requernfentrada')<>nil) and
               (notas.fieldbyname('requernfentrada').AsBoolean)) or
              ((produtos.FindField('codigonota')<>nil) and
               (produtos.fieldbyname('codigonota').Asinteger<>0)) ;

 end

end;

procedure TdtmBasico.MontarInfComplementar(qryDadosFiscais: tTecQuery);
begin

    if qrydadosfiscais.FindField('obsimpostosretidos') <> nil then
      qryDadosFiscais.FieldByName('obsimpostosretidos').AsString := ObterImpostosRetidos(qryDadosFiscais);


    qryDadosFiscais.fieldbyname('infcomplementar').clear;  
    if (Parsistema.CodigoMD5<>'') then
        qryDadosFiscais.fieldbyname('infcomplementar').asString := 'MD5 ' + ParSistema.CodigoMD5+ ' ' +  sLineBreak;

    qryDadosFiscais.fieldbyname('infcomplementar'). asString := qryDadosFiscais.fieldbyname('infcomplementar').asString +
                                                                qryDadosFiscais.fieldbyname('observacoes').AsString + ' ' +
                                                                qryDadosFiscais.fieldbyname('observacoesicmssubstituido').AsString;

    if qrydadosfiscais.FindField('obsimpostosretidos') <> nil then
      qryDadosFiscais.fieldbyname('infcomplementar'). asString := qryDadosFiscais.fieldbyname('infcomplementar').asString + chr(13) +
      qryDadosFiscais.FieldByName('obsimpostosretidos').AsString;

   {Impostos retidos conforme legislação: PIS - R$ 5,00 ** COF}

    if (regimetributario = 1) and //simples
       (parsistema.obsnfeClientesnoSimples <> '') then
      qryDadosFiscais.fieldbyname('infcomplementar').AsString := qryDadosFiscais.fieldbyname('infcomplementar').AsString +
                                                                parsistema.obsnfeClientesnoSimples;

    if (regimetributario = 3) and //normal
       (parsistema.obsnfeClientesnoRegimeNormal.text <> '') then
      qryDadosFiscais.fieldbyname('infcomplementar').AsString := qryDadosFiscais.fieldbyname('infcomplementar').AsString + chr(13) +
                                                                parsistema.obsnfeClientesnoRegimeNormal.text;

end;

function TdtmBasico.ehnotafiscalsaidatransferencia(
  CodigoFiscal: integer): boolean;
var
 vAbrirConsulta : Boolean;
begin
  vAbrirConsulta := True;
  if not assigned(qryCodigosFiscaisFuncao) then
  begin
    qryCodigosFiscaisFuncao := TTecQuery.Create((nil));
    qryCodigosFiscaisFuncao.Database  := dtmTecSoft.Database;
    vAbrirConsulta := True;
  end
  else
    vAbrirConsulta :=  (pCodigoFiscal_ehnotafiscalsaidatransferencia <> CodigoFiscal);

  if vAbrirConsulta then
  begin
    pCodigoFiscal_ehnotafiscalsaidatransferencia := CodigoFiscal;
    qryCodigosFiscaisFuncao.sql.text  := 'select ehnotafiscalsaidatransferencia(:CodigoFiscal) as ehnotafiscalsaidatransferencia';
    ReFazConsulta(qryCodigosFiscaisFuncao,[0],[CodigoFiscal]);
    result := qryCodigosFiscaisFuncao.fieldByName('ehnotafiscalsaidatransferencia').asboolean;

    pResult_ehnotafiscalsaidatransferencia := result;

  end
  else
    result := pResult_ehnotafiscalsaidatransferencia;

end;

function TdtmBasico.GetqryGravarxml: TtecQuery;
begin
  if not assigned(fqryGravarxml)  then
  begin
    fqryGravarxml := TtecQuery.Create(nil);
    fqryGravarxml.Database := dtmTecSoft.Database;
    fqryGravarxml.CachedUpdates := true;
    fqryGravarxml.RequestLive := true;
  end;
  Result := fqryGravarxml;
end;


