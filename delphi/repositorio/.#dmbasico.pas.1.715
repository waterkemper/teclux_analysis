  function icmsoutrasDigitado: boolean;
  begin
    result := false;
    if produtos.FindField('icmsoutrasDigitado')<>nil then
      result := produtos.fieldbyname('icmsoutrasDigitado').asboolean;
  end;

  function PossuiNDI: boolean;
  begin
    result := false;
    if notas.FindField('ndi')<>nil then
      result := not notas.fieldbyname('ndi').IsNull;
  end;

  function ehOrigemNacional: boolean;
  begin
    result := (produtos.FindField('origem')<>nil) and
              (produtos.fieldbyname('origem').asInteger = 0);
  end;

  function ehOrigemImportado: boolean;
  begin
    result := (produtos.FindField('origem')<>nil) and
              (produtos.fieldbyname('origem').asInteger in [1,2,3,4,5,6,7]);
  end;

  function naocalcularvaloresicmsdiferimento: boolean;
  begin
    result := (produtos.FindField('naocalcularvaloresicmsdiferimento')<>nil) and
              produtos.fieldbyname('naocalcularvaloresicmsdiferimento').asboolean;
  end;

  function VendaouCompraConsumidorFinal: boolean;
  begin
    result := false;
    if not saida then
      result := eHNotaFiscalEntradaUsoouConsumo(produtos.fieldbyname('codigofiscal').asinteger)
    else
      result := VendaConsumidorFinal;
  end;

  function numeroregistrodescontoalterado: integer;
  begin
    result := 0;
    if notas.findfield('numeroregistrodescontoalterado')<> nil then
      result := notas.fieldbyname('numeroregistrodescontoalterado').AsInteger;
  end;

  function rateardesconto: boolean;
  begin
    result := numeroregistrodescontoalterado <> produtos.fieldbyname('numero').asinteger;
  end;

  function descontodigitado: boolean;
  begin
    result := false;
    if produtos.findfield('descontodigitado')<> nil then
      result := produtos.fieldbyname('descontodigitado').AsBoolean;
  end;

  {
  function numeroregistrofretealterado: integer;
  begin
    result := 0;
    if notas.findfield('numeroregistrofretealterado')<> nil then
      result := notas.fieldbyname('numeroregistrofretealterado').AsInteger;
  end;
  }

  {
  function ratearfrete: boolean;
  begin
    result := numeroregistrofretealterado <> produtos.fieldbyname('numero').asinteger;
  end;
  }

  function fretedigitado: boolean;
  begin
    result := false;
    if produtos.findfield('fretedigitado')<> nil then
      result := produtos.fieldbyname('fretedigitado').AsBoolean;
  end;

  function DespesasAcessoriasdigitada: boolean;
  begin
    result := false;
    if produtos.findfield('despesasacessoirasdigitada')<> nil then
      result := produtos.fieldbyname('despesasacessoriasdigitada').AsBoolean;
  end;


  function CondicaoDevolucaoTransferencia: Boolean;
  begin
   result :=  OrigemCalculo = DevolucaoporTransferencia;
  end;

  function CondicaoNotaSaidaReferenciada: boolean;
  begin
    result := false;
    if OrigemCalculo = NotaAvulsa then
      result := (Notas.FindField('dadofiscalreferenciado') <> nil) and
                (notas.fieldbyname('dadofiscalreferenciado').Asinteger <> 0);
  end;

  function CondicaoTransferenciaEntrada: boolean;
  begin
   result := false;
   if (OrigemCalculo in [TransferenciaEntrada]) then
    result := ((produtos.fieldbyname('dadofiscal').asinteger <> 0) and
               (produtos.fieldbyname('numeroprodutotabela').asinteger <> 0));
  end;

  function NotaRelacionadaComOutra: Boolean;
  begin
    result := Condicaorequernfentrada or
              CondicaoDevolucaoTransferencia or
              CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos) or
              CondicaoRequerNFSaida or
              CondicaoNotaSaidaReferenciada or
              CondicaoTransferenciaEntrada;
  end;


  Procedure CalcularRateioDespesasAcessorias;
  begin

    {RATEIO DAS DESPESAS ACESSORIA}
    if not HeImportacao then
    begin

      t:= 0;
      produtos.First;
      while not produtos.Eof do
      begin

        if EfetuarCalculosNosProdutos then
        begin

          if not DespesasAcessoriasDigitada
             and ( not NotaRelacionadaComOutra or (AlteracaoEspecifica = tpAltEsp_DespesasAcessoriasNota)) then
          begin

            AtribuirDados(produtos, [produtos.FieldByName('despesasacessorias')],
               [null],
               [produtos.FieldByName('despesasacessorias')],
               [null],
               ['<>'],
               false,
               true);

{
            if (Produtos.fieldbyname('despesasacessorias').asCurrency <> 0) then
            begin
              EditarProdutos;
              Produtos.fieldbyname('despesasacessorias').Clear;
              produtos.post;
            end;
}

            t := t + 1;
          end;

        end;

        produtos.next;
      end;

      if not HeComponente then
      begin
        DespesaRateada     := notas.fieldbyname('despesasacessorias').AsCurrency - vTotalDespesasAcessoriasDigitada;
        if DespesaRateada < 0 then
           DespesaRateada := 0;
      end
      else
      begin
        if ProdutosCompostos.findfield('despesasacessorias')<>nil then
          DespesaRateada     := ProdutosCompostos.fieldbyname('despesasacessorias').AsCurrency;
      end;

      produtos.First;

      if (DespesaRateada  > 0) then
      begin

        i := 1;
        while i <= T do
        begin

          {O composto não entra, somente os componentes e os não compostos,
           caso contrario duplicaria os valores entre composto x componentes,
           necessário optar pelos componentes devido ao fato que os impostos devem
           ser calculados por eles}

          if EfetuarCalculosNosProdutos then
          begin
            if (DespesaRateada  > 0)   then
            begin
              if not DespesasAcessoriasDigitada then
              begin

//                EditarProdutos;

                if (i = t)  then
                begin
                  {
                  EditarProdutos;
                  Produtos.fieldbyname('despesasacessorias').AsCurrency := DespesaRateada;
                  Produtos.Post;
                  }
                  AtribuirDados(produtos, [produtos.FieldByName('despesasacessorias')],
                     [DespesaRateada],
                     [produtos.FieldByName('despesasacessorias')],
                     [DespesaRateada],
                     ['<>'],
                     false,
                     true);
                  DespesaRateada := 0;
                end
                else
                begin
                  if HeComponente then
                    AtribuirDados(produtos, [produtos.FieldByName('despesasacessorias')],
                       [ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                          ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                        produtos.fieldbyname('quantidade').AsFloat *
                                                                        ProdutosCompostos.fieldbyname('despesasacessorias').AsCurrency /
                                                               (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)],
                       [produtos.FieldByName('despesasacessorias')],

                       [ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                          ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                        produtos.fieldbyname('quantidade').AsFloat *
                                                                        ProdutosCompostos.fieldbyname('despesasacessorias').AsCurrency /
                                                               (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)],
                       ['<>'],
                       false,
                       true)



                    {
                    Produtos.fieldbyname('despesasacessorias').AsCurrency := ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                        ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                        produtos.fieldbyname('quantidade').AsFloat *
                                                                        ProdutosCompostos.fieldbyname('despesasacessorias').AsCurrency /
                                                               (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                    }
                  else

                    AtribuirDados(produtos, [produtos.FieldByName('despesasacessorias')],

                       [ArredondarouTruncar(PrecoUnitario(produtos) *
                                                                        Produtos.fieldbyname('quantidade').AsFloat *
                                                                        (notas.fieldbyname('despesasacessorias').AsCurrency - vTotaldespesasacessoriasDigitada) /
                                                                        (floattocurr(TotalLiquidoProdutos) - floattocurr(TotalLiquidoProdutosdespesasacessoriasDigitada) + floattocurr(TotalBrinde)),-2)],

                       [produtos.FieldByName('despesasacessorias')],

                       [ArredondarouTruncar(PrecoUnitario(produtos) *
                                                                        Produtos.fieldbyname('quantidade').AsFloat *
                                                                        (notas.fieldbyname('despesasacessorias').AsCurrency - vTotaldespesasacessoriasDigitada) /
                                                                        (floattocurr(TotalLiquidoProdutos) - floattocurr(TotalLiquidoProdutosdespesasacessoriasDigitada) + floattocurr(TotalBrinde)),-2)],
                       ['<>'],
                       false,
                       true);
                           {

                    Produtos.fieldbyname('despesasacessorias').AsCurrency := ArredondarouTruncar(PrecoUnitario(produtos) *
                                                                        Produtos.fieldbyname('quantidade').AsFloat *
                                                                        (notas.fieldbyname('despesasacessorias').AsCurrency - vTotaldespesasacessoriasDigitada) /
                                                                        (floattocurr(TotalLiquidoProdutos) - floattocurr(TotalLiquidoProdutosdespesasacessoriasDigitada) + floattocurr(TotalBrinde)),-2);
                       }
                  DespesaRateada := DespesaRateada - Produtos.fieldbyname('despesasacessorias').AsCurrency;

                  if DespesaRateada < 0 then
                    AtribuirDados(produtos, [produtos.FieldByName('despesasacessorias')],
                     [Produtos.fieldbyname('despesasacessorias').AsCurrency + DespesaRateada],
                     [produtos.FieldByName('despesasacessorias')],
                     [Produtos.fieldbyname('despesasacessorias').AsCurrency + DespesaRateada],
                     ['<>'],
                     false,
                     true);

                  {  Produtos.fieldbyname('despesasacessorias').AsCurrency := Produtos.fieldbyname('despesasacessorias').AsCurrency + DespesaRateada; }

                end;

//                Produtos.Post;
                i := i + 1;

              end;
            end
            else
              break;
          end;

          Produtos.Next;

        end;
      end;
    end;
  end;

  Procedure CalcularRateios;
  begin
    {RATEIO DO DESCONTO}
    if not HeImportacao then
    begin

      t:= 0;
      produtos.First;
      while not produtos.Eof do
      begin

        if EfetuarCalculosNosProdutos then
        begin

          if not descontodigitado
             and ( not NotaRelacionadaComOutra or (AlteracaoEspecifica = tpAltEsp_ValorDescontoNota)) then
          begin

//            EditarProdutos;
//            Produtos.fieldbyname('desconto').Clear;
//            produtos.post;

              AtribuirDados(produtos, [produtos.FieldByName('desconto')],
                 [null],
                 [produtos.FieldByName('desconto')],
                 [null],
                 ['<>'],
                 false,
                 true);


            t := t + 1;
          end;
        end;

        produtos.next;
      end;

      if not HeComponente then
      begin
        DescontoRateado     := Notas.Fieldbyname('desconto').asCurrency - vTotalDescontoDigitado;
        if DescontoRateado < 0 then
          DescontoRateado := 0;
      end
      else
        DescontoRateado     := ProdutosCompostos.fieldbyname('Desconto').AsCurrency;

      produtos.First;

      if (DescontoRateado  > 0) then
      begin

        i := 1;
        while i <= T do
        begin

          {O composto não entra, somente os componentes e os não compostos,
           caso contrario duplicaria os valores entre composto x componentes,
           necessário optar pelos componentes devido ao fato que os impostos devem
           ser calculados por eles}

          if EfetuarCalculosNosProdutos then
          begin
            if (DescontoRateado  > 0)   then
            begin
              if not Descontodigitado then
              begin

//                EditarProdutos;

                if (i = t)  then
                begin
//                  Produtos.fieldbyname('Desconto').AsCurrency := DescontoRateado;

                  AtribuirDados(produtos, [produtos.FieldByName('Desconto')],
                     [DescontoRateado],
                     [produtos.FieldByName('Desconto')],
                     [DescontoRateado],
                     ['<>'],
                     false,
                     true);

                  DescontoRateado := 0;
                end
                else
                begin
                  if HeComponente then

                    {
                    Produtos.fieldbyname('Desconto').AsCurrency := ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                        ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                        produtos.fieldbyname('quantidade').AsFloat *
                                                                        ProdutosCompostos.fieldbyname('Desconto').AsCurrency /
                                                               (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                    }

                    AtribuirDados(produtos, [produtos.FieldByName('Desconto')],
                     [

                      ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                        ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                        produtos.fieldbyname('quantidade').AsFloat *
                                                                        ProdutosCompostos.fieldbyname('Desconto').AsCurrency /
                                                               (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)

                     ],
                     [produtos.FieldByName('Desconto')],

                     [
                      ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                        ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                        produtos.fieldbyname('quantidade').AsFloat *
                                                                        ProdutosCompostos.fieldbyname('Desconto').AsCurrency /
                                                               (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                     ],
                     ['<>'],
                     false,
                     true)



                  else

                    AtribuirDados(produtos, [produtos.FieldByName('Desconto')],
                     [

                      ArredondarouTruncar(PrecoUnitario(produtos) *
                                                                        Produtos.fieldbyname('quantidade').AsFloat *
                                                                        (notas.fieldbyname('desconto').AsCurrency - vTotalDescontoDigitado) /
                                                                        (floattocurr(TotalLiquidoProdutos) - floattocurr(TotalLiquidoProdutosDescontoDigitado) + floattocurr(TotalBrinde)),-2)
                     ],
                     [produtos.FieldByName('Desconto')],

                     [
                      ArredondarouTruncar(PrecoUnitario(produtos) *
                                                                        Produtos.fieldbyname('quantidade').AsFloat *
                                                                        (notas.fieldbyname('desconto').AsCurrency - vTotalDescontoDigitado) /
                                                                        (floattocurr(TotalLiquidoProdutos) - floattocurr(TotalLiquidoProdutosDescontoDigitado) + floattocurr(TotalBrinde)),-2)
                     ],
                     ['<>'],
                     false,
                     true);
                                                          {

                    Produtos.fieldbyname('Desconto').AsCurrency := ArredondarouTruncar(PrecoUnitario(produtos) *
                                                                        Produtos.fieldbyname('quantidade').AsFloat *
                                                                        (notas.fieldbyname('desconto').AsCurrency - vTotalDescontoDigitado) /
                                                                        (floattocurr(TotalLiquidoProdutos) - floattocurr(TotalLiquidoProdutosDescontoDigitado) + floattocurr(TotalBrinde)),-2);
                                                                        }

                  DescontoRateado := DescontoRateado - Produtos.fieldbyname('Desconto').AsCurrency;

                  if DescontoRateado < 0 then
                    AtribuirDados(produtos, [produtos.FieldByName('Desconto')],
                     [Produtos.fieldbyname('Desconto').AsCurrency + DescontoRateado],
                     [produtos.FieldByName('Desconto')],
                     [Produtos.fieldbyname('Desconto').AsCurrency + DescontoRateado],
                     ['<>'],
                     false,
                     true);

//                    Produtos.fieldbyname('Desconto').AsCurrency := Produtos.fieldbyname('Desconto').AsCurrency + DescontoRateado;

                end;

//                Produtos.Post;
                i := i + 1;

              end;
            end
            else
              break;
          end;

          Produtos.Next;

        end;
      end;
    end;

    {RATEIO DAS DESPESAS ACESSORIA}
    CalcularRateioDespesasAcessorias;

    {APAGAR VALORES RATEADOS}
    if not HeImportacao then
    begin
      t:= 0;
      produtos.First;
      while not produtos.Eof do
      begin
        if EfetuarCalculosNosProdutos then
        begin
          EditarProdutos;

          Produtos.fieldbyname('seguro').Clear;
          Produtos.fieldbyname('acrescimo').Clear;
//          Produtos.fieldbyname('despesasacessorias').Clear;

{NÃO FAZ SENTIDO RATEAR ST NOS PRODUTOS}
(*
          if (OrigemCalculo in [NotaEntrada, CadastroPedidos, TransferenciaEntrada])
          and not CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos) then
          begin
            {Na nota de entrada o valor é rateado}
            Produtos.fieldbyname('icmsvalorst').Clear;
            Produtos.fieldbyname('icmsBaseCalculost').Clear;
          end;
*)


          produtos.post;
          t := t + 1;
        end;
        produtos.next;
      end;

      {RATEAR VALORES}

      if not HeComponente then
      begin

        SeguroRateado    := notas.fieldbyname('seguro').AsCurrency;
        AcrescimoRateado := CampoNotaTotalAcrescimo;
//        DespesaRateada   := notas.fieldbyname('despesasacessorias').AsCurrency;

      end
      else
      begin
        SeguroRateado    := ProdutosCompostos.fieldbyname('seguro').AsCurrency;
        AcrescimoRateado := ProdutosCompostos.fieldbyname('acrescimo').AsCurrency;
      end;

      produtos.First;

      if (SeguroRateado    <> 0) or
         (AcrescimoRateado <> 0) then

      begin

        i := 1;
        while i <= T do
        begin

          {O composto não entra, somente os componentes e os não compostos,
           caso contrario duplicaria os valores entre composto x componentes,
           necessário optar pelos componentes devido ao fato que os impostos devem
           ser calculados por eles}

          if EfetuarCalculosNosProdutos then
          begin

            EditarProdutos;

            if SeguroRateado > 0 then
            begin
              if (i = t) then
                Produtos.fieldbyname('seguro').AsCurrency := SeguroRateado
              else
              begin
                if HeComponente then
                  Produtos.fieldbyname('seguro').AsCurrency := ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                      ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                      produtos.fieldbyname('quantidade').AsFloat *
                                                                      ProdutosCompostos.fieldbyname('seguro').AsCurrency /
                                                             (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                else
                  Produtos.fieldbyname('seguro').AsCurrency := ArredondarouTruncar(PrecoUnitario(produtos) *
                                                        Produtos.fieldbyname('quantidade').AsFloat *
                                                        notas.fieldbyname('seguro').AsCurrency /
                                                        (Floattocurr(TotalLiquidoProdutos) + floattoCurr(TotalBrinde)),-2);

                SeguroRateado := SeguroRateado - Produtos.fieldbyname('seguro').AsCurrency;

                if SeguroRateado < 0 then
                  Produtos.fieldbyname('seguro').AsCurrency := Produtos.fieldbyname('seguro').AsCurrency + SeguroRateado;

              end;
            end;

            if AcrescimoRateado > 0 then
            begin
              if (i = t) then
                Produtos.fieldbyname('acrescimo').AsCurrency := AcrescimoRateado
              else
              begin
                if HeComponente then
                  Produtos.fieldbyname('acrescimo').AsCurrency := ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                      ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                      Produtos.fieldbyname('quantidade').AsFloat *
                                                                      ProdutosCompostos.fieldbyname('acrescimo').AsCurrency /
                                                            (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                else
                  Produtos.fieldbyname('acrescimo').AsCurrency := ArredondarouTruncar(PrecoUnitario(produtos) *
                                                           Produtos.fieldbyname('quantidade').AsFloat *
                                                           CampoNotaTotalAcrescimo /
                                                           (FloattoCurr(TotalLiquidoProdutos) + FloattoCurr(TotalBrinde)),-2);

                AcrescimoRateado := AcrescimoRateado - Produtos.fieldbyname('acrescimo').AsCurrency;
                if AcrescimoRateado < 0 then
                  Produtos.fieldbyname('acrescimo').AsCurrency := Produtos.fieldbyname('acrescimo').AsCurrency + AcrescimoRateado;

              end;
            end;

            Produtos.Post;

            i := i + 1;

          end;

          Produtos.Next;

        end;
      end;
    end;

    {RATEIO DO FRETE}

    if not HeImportacao then
    begin

      t:= 0;
      produtos.First;
      while not produtos.Eof do
      begin

        if EfetuarCalculosNosProdutos then
        begin

          if not fretedigitado
             and ( not NotaRelacionadaComOutra or (AlteracaoEspecifica = tpAltEsp_ValorFreteNota)) then
          begin
            EditarProdutos;
            Produtos.fieldbyname('frete').Clear;
            if produtos.findfield('fretedigitado')<> nil then
               produtos.fieldbyname('fretedigitado').AsBoolean := false;

            t := t + 1;


             {O cadastro de pedidos é um percentual ctr
              ou nf aplicado sobre o valor liquido do produto, portanto
             deve ser calculado depois do rateio do desconto e acrescimo}
            if OrigemCalculo = CadastroPedidos then
            begin
              Produtos.fieldbyname('frete').AsCurrency :=

                (((PrecoUnitario(produtos) *
                  Produtos.fieldbyname('quantidade').AsFloat) -
                  Produtos.fieldbyname('desconto').AsFloat -
                  Produtos.fieldbyname('valordescontoitem').AsFloat +
                  Produtos.fieldbyname('acrescimo').AsFloat) *

                  (notas.fieldbyname('fretectr').asFloat/100)) +

                (((PrecoUnitario(produtos) *
                  Produtos.fieldbyname('quantidade').AsFloat) -
                  Produtos.fieldbyname('desconto').AsFloat -
                  Produtos.fieldbyname('valordescontoitem').AsFloat +
                  Produtos.fieldbyname('acrescimo').AsFloat) *

                  (notas.fieldbyname('fretenota').asFloat/100));

            end;

            produtos.post;

          end;

        end;

        produtos.next;
      end;

      if OrigemCalculo <> CadastroPedidos then
      begin

        if not HeComponente then
        begin
          FreteRateado     := notas.fieldbyname(CampoNotaTotalFrete).AsCurrency - vTotalFreteDigitado;
          if freteRateado < 0 then
             FreteRateado := 0;
        end
        else
          FreteRateado     := ProdutosCompostos.fieldbyname('frete').AsCurrency;

        produtos.First;

        if (FreteRateado  > 0) then
        begin

          i := 1;
          while i <= T do
          begin

            {O composto não entra, somente os componentes e os não compostos,
             caso contrario duplicaria os valores entre composto x componentes,
             necessário optar pelos componentes devido ao fato que os impostos devem
             ser calculados por eles}

            if EfetuarCalculosNosProdutos then
            begin
              if (FreteRateado  > 0)   then
              begin
                if not fretedigitado then
                begin

                  EditarProdutos;

                  if (i = t)  then
                  begin
                    Produtos.fieldbyname('frete').AsCurrency := FreteRateado;
                    FreteRateado := 0;
                  end
                  else
                  begin
                    if HeComponente then
                      Produtos.fieldbyname('frete').AsCurrency := ArredondarouTruncar(produtos.fieldbyname(precocomponente(produtos)).ascurrency *
                                                                          ProdutosCompostos.fieldbyname('quantidade').AsFloat *
                                                                          produtos.fieldbyname('quantidade').AsFloat *
                                                                          ProdutosCompostos.fieldbyname('frete').AsCurrency /
                                                                 (ProdutosCompostos.fieldbyname('quantidade').AsFloat * ProdutosCompostos.fieldbyname('precovenda').AsCurrency),-2)
                    else
                      Produtos.fieldbyname('frete').AsCurrency := ArredondarouTruncar(PrecoUnitario(produtos) *
                                                                          Produtos.fieldbyname('quantidade').AsFloat *
                                                                          (notas.fieldbyname(CampoNotaTotalFrete).AsCurrency - vTotalFreteDigitado) /
                                                                          (floattocurr(TotalLiquidoProdutos) - floattocurr(TotalLiquidoProdutosFreteDigitado) + floattocurr(TotalBrinde)),-2);

                    FreteRateado := FreteRateado - Produtos.fieldbyname('frete').AsCurrency;

                    if FreteRateado < 0 then
                      Produtos.fieldbyname('frete').AsCurrency := Produtos.fieldbyname('frete').AsCurrency + FreteRateado;

                  end;

                  Produtos.Post;
                  i := i + 1;

                end;
              end
              else
                break;
            end;

            Produtos.Next;

          end;
        end;
      end;

    end;

  end;


  function CondicaoEmissorNFE: boolean;
  begin
    result := Parsistema.EmissorNfe;
    if result then
    begin
      if notas.findfield('modelodocto')<> nil then
        result := (notas.fieldbyname('modelodocto').asstring = '55') or
                  (notas.fieldbyname('modelodocto').asstring = '57') or
                  (notas.fieldbyname('modelodocto').asstring = '65')
      else
        result := (ModeloDoctoFiscal = '55') or
                  (ModeloDoctoFiscal = '57') or
                  (ModeloDoctoFiscalNFCe = '65');
    end;
  end;

  function eHNotaComplementar: boolean;
  begin
    result := false;
    if notas.findfield('finalidadenf')<> nil then
      result := notas.fieldbyname('finalidadenf').asinteger = 2;

  end;

  procedure ZerarDadosST;
  begin
    produtos.FieldByName('fatorsubstituicao').AsCurrency := 0;
    if produtos.findfield('pmvast')<>nil then
      Produtos.fieldbyname('pmvast').AsCurrency := 0;

    produtos.FieldByName('AliquotaICMSST').AsCurrency    := 0;

    if produtos.fieldbyname('pRedBCST').IsNull then
      produtos.fieldbyname('pRedBCST').AsCurrency := 0;

    produtos.fieldbyname('reducaobasest').AsCurrency     := 0;

    produtos.FieldByName('ICMSBaseCalculoST').AsCurrency := 0;
    produtos.FieldByName('ICMSValorST').AsCurrency       := 0;
  end;

  function ValorICMSInterPart: Currency;
  var
   vAno : word;
  begin
    if notas.findField('datasaida')<>nil then
    begin
      if notas.fieldbyname('datasaida').isnull then
        vAno := yearof(notas.fieldbyname('data').asDateTime)
      else
        vAno := YearOf(notas.fieldbyname('datasaida').asDateTime);
    end
    else
      vAno := yearof(notas.fieldbyname('data').asDateTime);


    {Percentual de partilha para a UF do destinatário: - 40% em 2016; - 60% em 2017; - 80% em 2018; - 100% a partir de 2019}
    result := 0;
    if vAno = 2016 then result := 40
    else if vAno = 2017 then result := 60
    else if vAno = 2018 then result := 80
    else if vano >= 2019 then result := 100;
  end;

  function ValorVista: Currency;
  var
    vlTotalProdutos, vlTotalAcrescimo, vlaloricmssubstituicao,
    vlTotalFrete, vlSeguro, vldespesasacessorias, vlvalorservicos,
    vlvaloripi: Currency;
  begin

    if origemCalculo = CadastroPedidos then
     vlTotalProdutos        := notas.fieldbyname('totalproduto').AsCurrency
    else
      vlTotalProdutos        := notas.fieldbyname('totalprodutos').AsCurrency;

    vlTotalAcrescimo       := CampoNotaTotalAcrescimo;
    vlaloricmssubstituicao := CampoNotavaloricmssubstituicao;
    vlTotalFrete           := notas.fieldbyname(CampoNotaTotalFrete).AsCurrency;
    vlSeguro               := notas.fieldbyname('seguro').AsCurrency;
    vldespesasacessorias   := notas.fieldbyname('despesasacessorias').AsCurrency;
    if notas.findfield('valorservicos')<> nil then
      vlvalorservicos        := notas.fieldbyname('valorservicos').AsCurrency
    else
      vlvalorservicos := 0;

    vlvaloripi             := notas.fieldbyname(ifthen((not (origemcalculo in [NotaEntrada, CadastroPedidos, TransferenciaEntrada])),'valoripi','valoripicalculada')).AsCurrency;

    result := vlTotalProdutos -
              vlTotalAcrescimo +
              vlaloricmssubstituicao +
              vlTotalFrete +
              vlSeguro +
              vldespesasacessorias +
              vlvalorservicos +
              vlvaloripi;
  end;

  function ValorTotalProdutos: Currency;
  var
    vlValorProdutos, vlTotalAcrescimo, vlDesconto, vlDescontoItem: Currency;
  begin
    vlValorProdutos   := notas.fieldbyname('valorprodutos').AsCurrency;
    vlTotalAcrescimo  := CampoNotaTotalAcrescimo;
    vlDesconto        := notas.fieldbyname('desconto').AsCurrency;

    if notas.findfield('descontoitem') <> nil then
      vldescontoItem := notas.fieldbyname('descontoitem').AsCurrency
    else
      vldescontoItem := 0;

    result := vlValorProdutos +
              vlTotalAcrescimo -
              vlDesconto - vlDescontoItem;
  end;

  function ModeloDocto: String;
  begin
    result := '';
    if notas.findfield('modelodocto')<> nil then
      result := notas.fieldbyname('modelodocto').asstring;
  end;

  function OperacaoInterEstadual: boolean;
  begin
    result := (estadofilialbase <> EstadoDestino);
  end;

  function Condicao_ICMSUFDest: boolean;
  begin
    result := saida and VendaConsumidorFinal and OperacaoInterestadual  and
              (not contribicms OR (ContribICMS and ResponsavelDifal))  
              and ((datainiciodifal = 0) or (datainiciodifal <= DatadaNota))
              and (modelodocto = '55')
              and eHNotaFiscalSaidaVenda(produtos.fieldByname('codigofiscal').Asinteger,false,false) and
              CondicaoICMSInterPart(cst_nf, csosn_nf, crt);
  end;

  function Condicao_Venda: boolean;
  begin
    result := saida {and VendaConsumidorFinal and OperacaoInterestadual  and
              (not contribicms OR (ContribICMS and ResponsavelDifal))}  and
              (modelodocto = '55') and
              eHNotaFiscalSaidaVenda(produtos.fieldByname('codigofiscal').Asinteger,false,false);
  end;


begin
  result := true;

  try
    pCalculandoImpostos := true;


    if (produtos.fieldbyname(campoproduto).Asinteger<>0) and  ProdutoOK then
    begin


      lst_prod_calc_Imp := '';
      qryDadosProdutos_.Sql.clear;

      {Totalizadores dos valores das notas fiscais}
      vBaseICMS  := 0;
      vValorICMS := 0;
      vValorICMS_SemST := 0;

      vBaseICMSST  := 0;
      vValorICMSST := 0;

      vBaseICMSSTCusto  := 0;
      vValorICMSSTCusto := 0;

      vValorIPI := 0;
      vDespesasAcessorias := 0;
      vValorFrete := 0;
      vValorDesconto := 0;
      vValorDescontoItem := 0;

      vQtdeProdutos := 0;

      vValorPIS := 0;
      vValorCOFINS := 0;

      vCredICMSSN := 0;

      vICMSSTRet := 0;
      vICMSSTRetDesp := 0;

      vBCSTRet   := 0;
      vBCSTRetDesp   := 0;

      vICMSBaseCalculo_dev:= 0;
      vICMSValor_dev := 0;


      vCalculosICMSBase := 0;  vCalculosICMSValor := 0; vCalculosICMSSTValor := 0; vCalculosICMSIsentas := 0;  vCalculosICMSOutras := 0;
      vCalculosIPIBase := 0;  vCalculosIPIValor := 0;  vCalculosIPIIsentas := 0;  vCalculosIPIOutras := 0;

      vvalortotalimpostoibt := 0;
      vvalorimpostonacional:=0;
      vvalorimpostoestadual:=0;
      vvalorimpostomunicipal:=0;

      vFCPUFDest := 0; vICMSUFDest := 0; vICMSUFRemet := 0;

      vFCP := 0; vFCPST := 0; vFCPSTRet := 0;

      vListanotas := '';

      RegistroAtual := produtos.GetBookmark;
      EstadoProdutos := Produtos.State;
      produtos.DisableControls;

      try

      HeImportacao := false;
      if lowercase(produtos.Name) = 'qryprodutosnotafiscal' then

         {
         HeImportacao := (produtos.fieldbyname('codigofiscal').asinteger - (produtos.fieldbyname('codigofiscal').asinteger mod 1000) = 3000) and
                         (((copy(produtos.fieldbyname('codigofiscal').asString,2,1)='1') and not parsistema.ControlesVoltadosparaIndustria) or
                          (parsistema.ControlesVoltadosparaIndustria and PossuiNDI)) ;}

         HeImportacao := PossuiNDI or (saida and (OrigemCalculo = NotaAvulsa) and ((produtos.fieldbyname('codigofiscal').asInteger div 1000) = 7))


      else
         HeImportacao := (saida and (OrigemCalculo = NotaAvulsa) and ((produtos.fieldbyname('codigofiscal').asInteger div 1000) = 7));


      {CALCULAR TOTAL PRODUTOS}
      TotalLiquidoProdutos := 0;
      TotalProdutos := 0;
      TotalDescontoItem := 0;
      TotalDescontoFinanceiro := 0;

      TotalLiquidoProdutosFreteDigitado := 0;
      TotalLiquidoProdutosDespesasAcessoriasDigitada := 0;
      TotalProdutosFreteDigitado := 0;

      TotalProdutosDespesasAcessoriasDigitada := 0;

      TotalDescontoItemFreteDigitado := 0;
      TotalDescontoItemDespesasAcessoriasDigitada := 0;

      vTotalFreteDigitado := 0;

      vTotalDespesasAcessoriasDigitada := 0;


      TotalLiquidoProdutosDescontoDigitado := 0;
      TotalProdutosDescontoDigitado := 0;
      TotalDescontoItemDescontoDigitado := 0;
      vTotalDescontoDigitado := 0;



  //    TotalProdutosST := 0;
      TotalBrinde := 0;
      vTotalPeso := 0;
      vTotalVolumes := 0;

      if calculos <> nil then
      begin
        if Calculos.active then
        begin
          calculos.First;
          while not calculos.Eof do
            calculos.Delete;
        end;    
      end;

      EstadoNotaFiscal := notas.State;

      if not HeComponente then
      begin
        if origemcalculo = CadastroPedidos then
        begin
{
          TotalProdutos  := cdsProdutos.Aggregates.Find('TotalProdutos').Value;
          TotalDescontoItem := cdsProdutos.Aggregates.Find('TotalDescontoItem').value;
          TotalProdutosFreteDigitado := cdsProdutos.Aggregates.Find('TotalProdutosFreteDigitado').value;
          TotalDescontoItemFreteDigitado := cdsProdutos.Aggregates.Find('TotalDescontoItemFreteDigitado').value;
          vTotalFreteDigitado := cdsProdutos.Aggregates.Find('vTotalFreteDigitado').value;

          TotalProdutosDescontoDigitado := cdsProdutos.Aggregates.Find('TotalProdutosDescontoDigitado').value;
          TotalDescontoItemDescontoDigitado := cdsProdutos.Aggregates.Find('TotalDescontoItemDescontoDigitado').value;
          vTotalDescontoDigitado := cdsProdutos.Aggregates.Find('vTotalDescontoDigitado').value;
          }

          TotalProdutos  := 0;
          if produtos.AggFields.FieldByName('TotalProdutos').asString<>'' then
            TotalProdutos  := produtos.AggFields.FieldByName('TotalProdutos').Value;

          TotalDescontoItem := 0;
          if produtos.AggFields.FieldByName('TotalDescontoItem').asString<>'' then
            TotalDescontoItem := produtos.AggFields.FieldByName('TotalDescontoItem').value;

          TotalProdutosFreteDigitado := 0;
          if produtos.AggFields.FieldByName('TotalProdutosFreteDigitado').asString<>'' then
            TotalProdutosFreteDigitado := produtos.AggFields.FieldByName('TotalProdutosFreteDigitado').value;

          TotalDescontoItemFreteDigitado := 0;
          if produtos.AggFields.FieldByName('TotalDescontoItemFreteDigitado').asString<>'' then
            TotalDescontoItemFreteDigitado := produtos.AggFields.FieldByName('TotalDescontoItemFreteDigitado').value;

          vTotalFreteDigitado := 0;
          if produtos.AggFields.FieldByName('vTotalFreteDigitado').asString<>'' then
            vTotalFreteDigitado := produtos.AggFields.FieldByName('vTotalFreteDigitado').value;

          TotalProdutosDescontoDigitado := 0;
          if produtos.AggFields.FieldByName('TotalProdutosDescontoDigitado').asString<>'' then
            TotalProdutosDescontoDigitado := produtos.AggFields.FieldByName('TotalProdutosDescontoDigitado').value;

          TotalDescontoItemDescontoDigitado := 0;
          if produtos.AggFields.FieldByName('TotalDescontoItemDescontoDigita').asString<>'' then
            TotalDescontoItemDescontoDigitado := produtos.AggFields.FieldByName('TotalDescontoItemDescontoDigita').value;

          vTotalDescontoDigitado := 0;
          if produtos.AggFields.FieldByName('vTotalDescontoDigitado').asString<>'' then
            vTotalDescontoDigitado := produtos.AggFields.FieldByName('vTotalDescontoDigitado').value;

        end
        else
        if ehNFeEletronica and false then
        begin
          TotalProdutos := notas.fieldbyname('valorprodutos').asCurrency;
          TotalDescontoItem := notas.fieldbyname('desconto').asCurrency;
        end
        else

        begin

          produtos.First;
          while not produtos.eof do
          begin

            if HeImportacao then
            begin
              if saida then
                TotalProdutos := TotalProdutos +
                                 produtos.fieldbyname('produtototal').AsFloat
              else
                TotalProdutos := TotalProdutos +
                                 ArredondarouTruncar(
                                 produtos.fieldbyname('produtototal').AsFloat,-2);

              TotalDescontoItem := 0;


              if fretedigitado then
                if produtos.findField('frete') <> nil then
                begin
                  if saida then
                    TotalProdutosFreteDigitado := TotalProdutosFreteDigitado +
                                     produtos.fieldbyname('produtototal').AsFloat
                  else
                    TotalProdutosFreteDigitado := TotalProdutosFreteDigitado +
                                     ArredondarouTruncar(
                                     produtos.fieldbyname('produtototal').AsFloat,-2);
                  TotalDescontoItemFreteDigitado := 0;
                  vTotalFreteDigitado := vTotalFreteDigitado + produtos.fieldbyname('frete').asCurrency;
                end;

              if despesasacessoriasdigitada then
                if produtos.findField('despesasacessorias') <> nil then
                begin
                  if saida then
                    TotalProdutosdespesasacessoriasdigitada := TotalProdutosdespesasacessoriasdigitada +
                                     produtos.fieldbyname('produtototal').AsFloat
                  else
                    TotalProdutosdespesasacessoriasdigitada := TotalProdutosdespesasacessoriasdigitada +
                                     ArredondarouTruncar(
                                     produtos.fieldbyname('produtototal').AsFloat,-2);
                  TotalDescontoItemdespesasacessoriasdigitada := 0;
                  vTotaldespesasacessoriasdigitada := vTotaldespesasacessoriasdigitada + produtos.fieldbyname('despesasacessorias').asCurrency;
                end;


              if Descontodigitado then
                if produtos.findField('Desconto') <> nil then
                begin
                  if saida then
                    TotalProdutosDescontoDigitado := TotalProdutosDescontoDigitado +
                                     produtos.fieldbyname('produtototal').AsFloat
                  else
                    TotalProdutosDescontoDigitado := TotalProdutosDescontoDigitado +
                                     ArredondarouTruncar(
                                     produtos.fieldbyname('produtototal').AsFloat,-2);
                  TotalDescontoItemDescontoDigitado := 0;
                  vTotalDescontoDigitado := vTotalDescontoDigitado + produtos.fieldbyname('Desconto').asCurrency;
                end;


            end
            else
            begin
              TotalProdutos := TotalProdutos +
                              ArredondarouTruncar(
                              (produtos.fieldbyname('quantidade').asfloat * PrecoUnitario(produtos)),-2) ;

              TotalDescontoItem := TotalDescontoItem + ValorDescontoItem;

              if fretedigitado then
                if produtos.findField('frete') <> nil then
                begin
                  TotalProdutosFreteDigitado := TotalProdutosFreteDigitado +
                                  ArredondarouTruncar(
                                  (produtos.fieldbyname('quantidade').asfloat * PrecoUnitario(produtos)),-2) ;

                  TotalDescontoItemFreteDigitado := TotalDescontoItemFreteDigitado + ValorDescontoItem;
                  vTotalFreteDigitado := vTotalFreteDigitado + produtos.fieldbyname('frete').asCurrency;
                end;

              if despesasacessoriasdigitada then
                if produtos.findField('despesasacessorias') <> nil then
                begin
                  TotalProdutosdespesasacessoriasdigitada := TotalProdutosdespesasacessoriasdigitada +
                                  ArredondarouTruncar(
                                  (produtos.fieldbyname('quantidade').asfloat * PrecoUnitario(produtos)),-2) ;

                  TotalDescontoItemdespesasacessoriasdigitada := TotalDescontoItemdespesasacessoriasdigitada + ValorDescontoItem;
                  vTotaldespesasacessoriasdigitada := vTotaldespesasacessoriasdigitada + produtos.fieldbyname('despesasacessorias').asCurrency;
                end;


              if Descontodigitado then
                if produtos.findField('Desconto') <> nil then
                begin
                  TotalProdutosDescontoDigitado := TotalProdutosDescontoDigitado +
                                  ArredondarouTruncar(
                                  (produtos.fieldbyname('quantidade').asfloat * PrecoUnitario(produtos)),-2) ;

                  TotalDescontoItemDescontoDigitado := TotalDescontoItemDescontoDigitado + ValorDescontoItem;
                  vTotalDescontoDigitado := vTotalDescontoDigitado + produtos.fieldbyname('Desconto').asCurrency;
                end;


            end;


            vTotalPeso := vTotalPeso + (produtos.fieldbyname('quantidade').asfloat * PesoProdutos(produtos));
            vTotalVolumes := vTotalVolumes + (produtos.fieldbyname('quantidade').AsInteger * VolumesProdutos(produtos));


            if (lowercase(produtos.name)='qryprodutoscontratos') then
              if produtos.FieldByName('brinde').asboolean then
                 TotalBrinde := TotalBrinde + (produtos.fieldbyname('quantidade').asfloat * PrecoUnitario(produtos));

            lst_prod_calc_Imp := lst_prod_calc_Imp + produtos.fieldbyname(CampoProduto).asString +',';

            produtos.Next;
          end;
        end;

        if lst_prod_calc_Imp <> '' then
          delete(lst_prod_calc_Imp, length(lst_prod_calc_Imp), 1);

        TotalLiquidoProdutos := TotalProdutos - TotalDescontoItem;
        TotalLiquidoProdutosFreteDigitado := TotalProdutosFreteDigitado - TotalDescontoItemFreteDigitado;
        TotalLiquidoProdutosDespesasAcessoriasDigitada := TotalProdutosDespesasAcessoriasDigitada - TotalDescontoItemDespesasAcessoriasDigitada;
        TotalLiquidoProdutosDescontoDigitado := TotalProdutosDescontoDigitado - TotalDescontoItemDescontoDigitado;


        TotalBrinde     := ArredondarouTruncar(TotalBrinde, -2);

        if not (EstadoNotaFiscal in [dsedit, dsinsert]) then
          notas.Edit;

        if PermiteAlterarDadosICMS(tpAltNotas) then
        begin
          notas.fieldbyname('valorprodutos').AsCurrency := FloatToCurr(TotalProdutos) - Floattocurr(TotalBrinde);
          if notas.findfield('descontoitem') <> nil then
            notas.fieldbyname('descontoitem').AsCurrency := TotalDescontoItem;
        end;


        if notas.FindField('peso') <> nil then
          notas.fieldbyname('peso').AsFloat :=  vTotalPeso;

        if notas.FindField('volumes') <> nil then
          notas.fieldbyname('volumes').AsInteger :=  vTotalVolumes;

        if (notas.FindField('peso') <> nil) and
           (notas.FindField('volumes') <> nil) then
          if assigned(chamadaprocedimento) then
            chamadaProcedimento;


        if notas.FindField('TotalBrindes') <> nil then
          notas.fieldbyname('TotalBrindes').AsCurrency :=  TotalBrinde;

        if ((lowercase(notas.name)='qrycontratos') and
            (lowercase(produtos.name)='qryprodutoscontratos')) or

           ((lowercase(notas.name)='qryorcamentos') and
            (lowercase(produtos.name)='qryprodutosorcamentos')) then
        begin
          notas.fieldbyname('valoricmssubstituicao').clear;
          notas.fieldbyname('totalipi').clear;

          if origemCalculo = CalculoMargem then
          begin
            notas.fieldbyname('PisValorProdutos').clear;
            notas.fieldbyname('CofinsValorProdutos').clear;
            notas.fieldbyname('valoricms').clear;
          end;

        end
        else
        begin

          if (OrigemCalculo in [NotaEntrada, CadastroPedidos, TransferenciaEntrada]) then
          begin
            notas.fieldbyname('baseicmscalculada').clear;
            notas.fieldbyname('valoricmscalculada').clear;
            notas.fieldbyname('baseicmssubstituicaocalculada').clear;
            notas.fieldbyname('valoricmssubstituicaocalculada').clear;
            notas.fieldbyname('valoripicalculada').clear;

            if CondicaoRequerNFSaida then
            begin
              notas.fieldbyname('baseicms').clear;
              notas.fieldbyname('valoricms').clear;
              notas.fieldbyname('baseicmssubstituicao').clear;
              notas.fieldbyname('valoricmssubstituicao').clear;
              notas.fieldbyname('valoripi').clear;
              notas.fieldbyname('valornota').clear;
              notas.fieldbyname('despesasacessorias').clear;
            end;

          end
          else
          if (OrigemCalculo in [Devolucao,Troca]) then
          begin
            notas.fieldbyname('baseicms').clear;
            notas.fieldbyname('valoricms').clear;
            notas.fieldbyname('baseicmssubstituicao').clear;
            notas.fieldbyname('valoricmssubstituicao').clear;
            notas.fieldbyname('valoripi').clear;
          end
          else
          begin

            notas.fieldbyname('baseicms').clear;
            notas.fieldbyname('valoricms').clear;

            notas.fieldbyname('totalbaseicmssubstituicao').clear;
            notas.fieldbyname('totalvaloricmssubstituicao').clear;

            notas.fieldbyname('valoripi').clear;
            if CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, Produtos) and not (AlteracaoEspecifica = tpAltEsp_DespesasAcessoriasNota) then
              notas.fieldbyname('despesasacessorias').clear;


  {          if Condicaorequernfentrada then
              notas.fieldbyname('valorfrete').clear;}

          end;

          if notas.findfield('vFCP')<>nil then
            notas.fieldbyname('vFCP').clear;

          if notas.findfield('vFCPST')<>nil then
            notas.fieldbyname('vFCPST').clear;

          if notas.findfield('vFCPSTRet')<>nil then
            notas.fieldbyname('vFCPSTRet').clear;



          if notas.findfield('vFCPUFDest')<>nil then
            notas.fieldbyname('vFCPUFDest').clear;

          if notas.findfield('vICMSUFDest')<>nil then
            notas.fieldbyname('vICMSUFDest').clear;

          if notas.findfield('vICMSUFRemet')<>nil then
            notas.fieldbyname('vICMSUFRemet').clear;

          notas.fieldbyname('totalvalorpis').clear;
          notas.fieldbyname('totalvalorcofins').clear;

          if origemCalculo = CadastroPedidos then
            notas.fieldbyname('totalproduto').clear
          else
            notas.fieldbyname('totalprodutos').clear;


          if notas.FindField('TotalQtdeProdutos')<> nil  then
             notas.fieldbyname('TotalQtdeProdutos').clear;

          if notas.findfield('valorvista')<> nil then
            notas.fieldbyname('valorvista').clear;

          notas.fieldbyname(CampoValorNota).clear;

          if notas.findField('vcredicmssn')<>nil then
            notas.fieldbyname('vcredicmssn').clear;

          if notas.FindField('vICMSSTRet')<>nil then
            notas.FieldByName('vICMSSTRet').clear;

          if notas.FindField('vICMSSTRetDesp')<>nil then
            notas.FieldByName('vICMSSTRetDesp').clear;

          if notas.FindField('vBCSTRet')<>nil then
            notas.FieldByName('vBCSTRet').clear;

          if notas.FindField('vBCSTRetDesp')<>nil then
            notas.FieldByName('vBCSTRetDesp').clear;

          if notas.FindField('icmsbasecalculo_dev')<>nil then
            notas.FieldByName('icmsbasecalculo_dev').clear;

          if notas.FindField('icmsvalor_dev')<>nil then
            notas.FieldByName('icmsvalor_dev').clear;


        end;

        if not (EstadoNotaFiscal in [dsedit, dsinsert]) then
          notas.post;

      end;

      if (alteracaoespecifica = tpAltEsp_ValorFreteNota) then
         CalcularRateios
      else
      if PermiteAlterarDadosICMS then
        CalcularRateios
      else
      if (alteracaoespecifica = tpAltEsp_DespesasAcessoriasNota) then
         CalcularRateioDespesasAcessorias;

      if not ehNFeEletronica or CalcularTodos then
        produtos.first;

      while not produtos.Eof do
      begin

        if EfetuarCalculosNosProdutos then
        begin
          if AbrirTabelaCompostos then
          begin

            if lowercase(produtos.Name) = 'qryprodutoscontratos' then
            begin
              {quando for pelo produtocontrato é aberta a consulta abaixo de compostos}
              ReFazConsultaPorNome(ProdutosCompostos, ['estadofilialbase',
                                                        'estadocfo',
                                                        'tipopessoa',
                                                        'filial',
                                                        'composto'],
                                                        [EstadoFilialBase,
                                                         notas.fieldbyname('estado').asstring,
                                                         notas.fieldbyname('pessoatipo').AsString,
                                                         produtos.fieldbyname('filial').AsString,
                                                         produtos.fieldbyname(campoproduto).AsString]);

              CalcularImpostos(produtoscompostos,notas,true,true,true,nil,produtosItens,true, OrigemCalculo);
            end
            else
            begin
              {Quando for produtosdadosfiscais é utilizada a propria tabela ja alimentada}
              if produtoscompostos <> nil then
                CalcularImpostos(produtoscompostos,notas,true,true,true,nil,produtosItens,true,NotaContrato, VendaConsumidorFinal, ContribICMS);
            end;

          end;

          EditarProdutos;

          {Lei 12.741/2012 - Transparência}
                                              {
          if produtos.FindField('valorimpostoimportado')<>nil then
            if not produtos.Fieldbyname('valorimpostoimportado').IsNull then
              produtos.Fieldbyname('valorimpostoimportado').clear;
              }

          if produtos.FindField('valorimpostonacional')<>nil then
            if not produtos.Fieldbyname('valorimpostonacional').isnull then
              produtos.Fieldbyname('valorimpostonacional').clear;

          if produtos.FindField('valorimpostoestadual')<>nil then
            if not produtos.Fieldbyname('valorimpostoestadual').isnull then
              produtos.Fieldbyname('valorimpostoestadual').clear;

          if parsistema.Lei12741_2012_Transparencia and
             (produtos.findfield('codigofiscal')<>nil) and
             eHNotaFiscalSaidaVenda(produtos.fieldbyname('codigofiscal').Asinteger, True, false) and
             (origemCalculo <> FrentedeCaixa) then
          begin


            if ehOrigemNacional then
            begin
              if (produtos.FindField('nacionalfederal')<>nil) and
                 (produtos.FindField('valorimpostonacional')<>nil) then

                produtos.Fieldbyname('valorimpostonacional').AsCurrency := ArredondarouTruncar(produtos.Fieldbyname('nacionalfederal').AsCurrency *
                                      ArredondarouTruncar(ArredondarouTruncar(Produtos.fieldbyname('quantidade').AsFloat * precounitario(produtos),-2)
                          - Produtos.FieldByName('valordescontoitem').AsCurrency
                          - Produtos.FieldByName('desconto').AsCurrency
                          + Produtos.FieldByName('acrescimo').AsCurrency
                          + Produtos.FieldByName('frete').AsCurrency
                          + Produtos.FieldByName('seguro').AsCurrency
                          { + tProdutos.FieldByName('valoripi').AsCurrency }
                         { + tprodutos.FieldByName(CampoICMSValorST).AsCurrency   }
                          + Produtos.FieldByName('despesasacessorias').AsCurrency ,-2) / 100, 2)

            end
            else
            if ehOrigemImportado then
            begin
              if (produtos.FindField('importadosfederal')<>nil) and
                 (produtos.FindField('valorimpostonacional')<>nil) then
                produtos.Fieldbyname('valorimpostonacional').AsCurrency := ArredondarouTruncar(produtos.Fieldbyname('importadosfederal').AsCurrency *
                                      ArredondarouTruncar(ArredondarouTruncar(Produtos.fieldbyname('quantidade').AsFloat * precounitario(produtos),-2)
                          - Produtos.FieldByName('valordescontoitem').AsCurrency
                          - Produtos.FieldByName('desconto').AsCurrency
                          + Produtos.FieldByName('acrescimo').AsCurrency
                          + Produtos.FieldByName('frete').AsCurrency
                          + Produtos.FieldByName('seguro').AsCurrency
                          { + tProdutos.FieldByName('valoripi').AsCurrency }
                         { + tprodutos.FieldByName(CampoICMSValorST).AsCurrency   }
                          + Produtos.FieldByName('despesasacessorias').AsCurrency ,-2) / 100, 2);

            end;

            if (produtos.FindField('cargaestadual')<>nil) and
                 (produtos.FindField('valorimpostoestadual')<>nil) then
            begin
                produtos.Fieldbyname('valorimpostoestadual').AsCurrency := ArredondarouTruncar(produtos.Fieldbyname('cargaestadual').AsCurrency *
                                      ArredondarouTruncar(ArredondarouTruncar(Produtos.fieldbyname('quantidade').AsFloat * precounitario(produtos),-2)
                          - Produtos.FieldByName('valordescontoitem').AsCurrency
                          - Produtos.FieldByName('desconto').AsCurrency
                          + Produtos.FieldByName('acrescimo').AsCurrency
                          + Produtos.FieldByName('frete').AsCurrency
                          + Produtos.FieldByName('seguro').AsCurrency
                          { + tProdutos.FieldByName('valoripi').AsCurrency }
                         { + tprodutos.FieldByName(CampoICMSValorST).AsCurrency   }
                          + Produtos.FieldByName('despesasacessorias').AsCurrency ,-2) / 100, 2);
                //valorimposto nacional continua sendo a soma do estadual com o nacional
                if (produtos.FindField('valorimpostonacional')<>nil) then
                    produtos.Fieldbyname('valorimpostonacional').AsCurrency := produtos.Fieldbyname('valorimpostonacional').AsCurrency+produtos.Fieldbyname('valorimpostoestadual').AsCurrency;

            end;
          end;


            //IPI

          { 00     | Entrada com recuperação de crédito
            49     | Outras entradas
            50     | Saída tributada
            99     | Outras saídas
          }

          if contribipi and
             (ipicst='') and
             (OrigemCalculo <> Contrato)  then
          begin

            result := false;
            CancelarAtualizacoes([]);
            MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname(campoprodutovisual).asstring, 'IPI CST - Tributação do IPI']));
            break;
          end
          else
          begin
            if (ipicst = '00') or
               (ipicst = '49') or
               (ipicst = '50') or
               (ipicst = '99') then
            begin
              if not (produtos.state in [dsinsert, dsedit]) then
                produtos.Edit;

              produtos.FieldByName('ipioutras').clear;
              produtos.FieldByName('ipiisentas').clear;

              if HeImportacao then
              begin
               { SERÁ O PRÓPRIO VALOR CALCULADO }

                if NaoGerarCreditoIPI or NaoGerarDebitoIPI then
                  produtos.FieldByName('ipioutras').asfloat := produtos.FieldByName('ipibasecalculo').Asfloat +
                                                                           produtos.FieldByName('valoripi').Asfloat;
              end
              else
              begin
                if not ValorIPIDigitado then
                begin
                  if PermiteAlterarDadosIPI then
                  begin
                    if produtos.FieldByName('aliquotaipi').AsCurrency<>0 then
                    begin

                      produtos.FieldByName('ipibasecalculo').AsCurrency :=  IPIBaseCalculo(produtos);
                      produtos.FieldByName('valoripi').AsCurrency :=  ValorIPI;
  {                      ArredondarouTruncar((produtos.FieldByName('ipibasecalculo').AsCurrency *
                                 produtos.FieldByName('aliquotaipi').AsCurrency)/100,-2);}
                    end;
                  end;
                end;

                                if NaoGerarCreditoIPI or NaoGerarDebitoIPI or (produtos.FieldByName('ipibasecalculo').AsCurrency=0) then
                begin
                  if produtos.FieldByName('ipibasecalculo').AsCurrency=0 then
                    produtos.FieldByName('ipioutras').ascurrency := IPIBaseCalculo(produtos)
                  else
                    produtos.FieldByName('ipioutras').ascurrency := ArredondarouTruncar(produtos.FieldByName('ipibasecalculo').AsCurrency +
                                                                           produtos.FieldByName('valoripi').AsCurrency,-2);
                end;

                produtos.FieldByName('ipioutras').ascurrency := produtos.FieldByName('ipioutras').ascurrency +
                                                                {produtos.FieldByName('despesasacessorias').asfloat +}
                                                                produtos.fieldbyname('acrescimo').asfloat +
                                                                ifthen(NaoCalcularIPISobreFrete,Produtos.FieldByName('frete').AsCurrency,0);

              end;
            end
            else
            {
            01     | Entrada tributada com alíquota zero
            02     | Entrada isenta
            03     | Entrada não-tributada
            04     | Entrada imune
            05     | Entrada com suspensão
            51     | Saída tributada com alíquota zero
            52     | Saída isenta
            53     | Saída não-tributada
            54     | Saída imune
            55     | Saída com suspensão
            }

            if (ipicst = '01') or
               (ipicst = '02') or
               (ipicst = '03') or
               (ipicst = '04') or
               (ipicst = '05') or
               (ipicst = '51') or
               (ipicst = '52') or
               (ipicst = '53') or
               (ipicst = '54') or
               (ipicst = '55') or
               (ipicst = '') then
            begin
              if not (produtos.state in [dsinsert, dsedit]) then
                produtos.Edit;

              produtos.FieldByName('ipioutras').clear;
              produtos.FieldByName('ipiisentas').clear;


              if HeImportacao then
                produtos.FieldByName('ipioutras').asfloat := produtos.FieldByName('ipibasecalculo').Asfloat +
                                                             produtos.FieldByName('valoripi').Asfloat
              else
              begin
                if produtos.FieldByName('ipibasecalculo').AsCurrency<>0 then
                  produtos.FieldByName('ipioutras').ascurrency := ArredondarouTruncar(produtos.FieldByName('ipibasecalculo').AsCurrency +
                                                                           produtos.FieldByName('valoripi').AsCurrency,-2)
                else
                  produtos.FieldByName('ipioutras').ascurrency :=  IPIBaseCalculo(produtos);

                produtos.FieldByName('ipioutras').ascurrency := produtos.FieldByName('ipioutras').ascurrency +
                                                                {produtos.FieldByName('despesasacessorias').asfloat +}
                                                                produtos.fieldbyname('acrescimo').asfloat +
                                                                ifthen(NaoCalcularIPISobreFrete,Produtos.FieldByName('frete').AsCurrency,0);
              end;

              if PermiteAlterarDadosIPI then
              begin
                produtos.FieldByName('ipibasecalculo').clear;
                //produtos.FieldByName('aliquotaipi').clear;
                produtos.FieldByName('valoripi').clear;
              end;

            end;

            if HeImportacao then
            begin
              if saida then
                produtos.FieldByName('ipioutras').AsCurrency := ArredondarouTruncar(
                 produtos.FieldByName('ipioutras').AsCurrency +
                 Produtos.fieldbyname('despesasacessorias').asCurrency, -2)
              else
                produtos.FieldByName('ipioutras').AsCurrency := ArredondarouTruncar(
                  produtos.FieldByName('ipioutras').AsCurrency +
                  Produtos.fieldbyname('naotribipi').asCurrency +
                  Produtos.fieldbyname('despesasacessorias').asCurrency -
                  Produtos.fieldbyname('embalagem').asCurrency -
                  Produtos.fieldbyname('thc').asCurrency, -2);

               produtos.FieldByName('ipiisentas').AsCurrency :=
                  produtos.FieldByName('ipiisentas').AsCurrency +
                  Produtos.fieldbyname('icmsvalor').asCurrency;
            end;
          end;

          //ICMS


          if ((crt = 1) and
              ((csosn_nf='') or
              (NFSaidaouEntradaPelaEmpresa and (qryTributosICMSObrigacoes_.FindField('SN'+csosn_nf) = nil)))) then
          begin
            result := false;
            CancelarAtualizacoes([]);
            if NFSaidaouEntradaPelaEmpresa then
              MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname(campoprodutovisual).asstring,
                            'ICMS CSOSN - Tributação no simples nacional']));
            break;
          end
          else
          if ((crt <> 1) and
              ((cst_nf='') or
               (NFSaidaouEntradaPelaEmpresa and (qryTributosICMSObrigacoes_.FindField('CST'+cst_nf) = nil)))) then
          begin
            result := false;
            CancelarAtualizacoes([]);
            if NFSaidaouEntradaPelaEmpresa then
              MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname(campoprodutovisual).asstring,
                            'ICMS CST - Tributação do icms ']));
            break;
          end
          else
          begin
            if not CondicaoNotasSimplesFaturamentoemVendaFutura then
            begin

              if ReverAliquota then {Situacao existe somente na saida,
                                     quando impresso cupom fiscal p/ outro estado a aliquota deve ser para dentro do estado,
                                     isto só é verificado no momento da impresão do cupom fiscal, pois até então estaria valendo a aliquota interestadual}
                produtos.FieldByName('aliquotaicms').AsCurrency := AliquotaICMS(EstadoFilialBase,EstadoFilialBase);

              if saida and (OrigemCalculo in [Contrato, CalculoMargem, NotaContrato, FrentedeCaixa]) {and not NotaFiscalVinculada} then
              begin

                // Comentado a linha abaixo em 19/10/20 para atender o requisito 4993

                vVendaConsumidorFinalAux := VendaConsumidorFinal;
                (*
                if vVendaConsumidorFinalAux then
                  if OperacaoInterestadual  and
                     ((ContribICMS and responsaveldifal) or

                      (Contribicms and not responsaveldifal and VendaConsumidorFinal and
                       (fatorsubstituicao[EstadoSubstituicao, produtos.fieldbyname(CampoProduto).AsString, PessoaTipo, VendaConsumidorFinal, ContribICMS, ResponsavelDifal]=0))) then
                    vVendaConsumidorFinalAux := false;

                        { AQUI E AGORA SE SIMPLES FATURAMENTO }

                if vVendaConsumidorFinalAux then
                begin
                  if OperacaoInterestadual and ContribICMS  {AND CONTRIBICMS - JR 27/12}
                   then
                  begin
                    if crt = 1 then
                    begin
                     { produtos.fieldbyname('csosn').asstring := '900'  rever com Lúcio}
                      if produtos.fieldbyname('csosn').asstring = '500' then
                        produtos.fieldbyname('csosn').asstring := '202'  {27/11/2019 Situação Gama Weg Amazonas}
                    end
                    else
                      produtos.fieldbyname('incidencia').asstring := '00';
                  end
                  //acrescentado JR 19/07 - PRIMELUB CSOSN 101 .. VENDENDO PARA DENTRO DO ESTADO CONSUMIDOR FINAL NAO CONTRIBUINTE .. DEVE SAIR 102.
                  //nao deixei o CST_SAIDA PQ A TROCA DE 60 PARA 10 PARA CONSUMIDOR FINAL DA ERRO!!
                  else  if not ContribICMS then
                  begin
                    if crt = 1 then
                    begin
                      fCSOSNSaida := CSOSNSaida(EstadoSubstituicao, produtos.fieldbyname(campoproduto).asstring, PessoaTipo, vVendaConsumidorFinalAux, contribicms, responsaveldifal);
                      if produtos.fieldbyname('csosn').asstring <> fCSOSNSaida then
                        produtos.fieldbyname('csosn').asstring := fCSOSNSaida;
                    end;
                  end;
                end
                else
                begin
                  if crt = 1 then
                    produtos.fieldbyname('csosn').asstring := CSOSNSaida(EstadoSubstituicao, produtos.fieldbyname(campoproduto).asstring, PessoaTipo, vVendaConsumidorFinalAux, contribicms, responsaveldifal)
                  else
                    produtos.fieldbyname('incidencia').asstring := CSTSaida(EstadoSubstituicao, produtos.fieldbyname(campoproduto).asstring, PessoaTipo, vVendaConsumidorFinalAux, Contribicms,responsaveldifal);
                end;

                *)

                if (crt = 1) or      //simples
                   (crt = 2)  then   // simple excesso sublimite

                  produtos.fieldbyname('csosn').asstring :=
                     CSOSNSaida(EstadoSubstituicao, produtos.fieldbyname(campoproduto).asstring,
                                PessoaTipo, vVendaConsumidorFinalAux,
                                contribicms, {responsaveldifal,}
                                ClientenoSimples, OrgaoPublico, IPINCM)
                else
                  produtos.fieldbyname('incidencia').asstring :=
                     CSTSaida(EstadoSubstituicao, produtos.fieldbyname(campoproduto).asstring,
                              PessoaTipo, vVendaConsumidorFinalAux,
                              Contribicms, {, responsaveldifal}
                              ClientenoSimples, OrgaoPublico, IPINCM);

              end;
            end;

            {Verificar se icms sobre despesasacessorias}
            if CondicaoBaseICMS(cst_nf,
                                  csosn_nf, csosn_produto,
                                  crt, naocalcularvaloresicmsdiferimento)
               and not ICMSSobreDespesasAcessorias(produtos)
               and (produtos.fieldbyname('despesasacessorias').ascurrency <> 0)
               and (produtos.findfield('icmssobredespesasacessorias')<>nil) then
            begin
              vDiferenca := abs((produtos.fieldbyname('icmsbasecalculo').ascurrency -
                            FloatToCurr(icmsbasecalculo(produtos))));

              if vDiferenca >= 0.01 then
              begin
                vDiferenca := abs(vDiferenca - produtos.fieldbyname('despesasacessorias').ascurrency);
                produtos.fieldbyname('icmssobredespesasacessorias').asboolean := vdiferenca <= 0.01
              end
              else
                produtos.fieldbyname('icmssobredespesasacessorias').asboolean := false;

            end
            else
            {Verificar se icms sobre ipi}
            if CondicaoBaseICMS(cst_nf,
                                  csosn_nf, csosn_produto,
                                  crt, naocalcularvaloresicmsdiferimento)
               and not icmssobreipi(produtos)
               and (produtos.fieldbyname('valoripi').ascurrency <> 0) then
            begin
              vDiferenca := abs((produtos.fieldbyname('icmsbasecalculo').ascurrency -
                            FloatToCurr(icmsbasecalculo(produtos))));

              if vDiferenca >= 0.01 then
              begin
                vDiferenca := abs(vDiferenca - produtos.fieldbyname('valoripi').ascurrency);
                if produtos.findfield('icmssobreipi')<>nil then
                  produtos.fieldbyname('icmssobreipi').asboolean := vdiferenca <= 0.01
              end
              else
                if produtos.findfield('icmssobreipi')<>nil then
                  produtos.fieldbyname('icmssobreipi').asboolean := false;
            end
            else
            {Verificar se icms sobre ipi e depesas acessorias}
            if CondicaoBaseICMS(cst_nf,
                                  csosn_nf, csosn_produto,
                                  crt, naocalcularvaloresicmsdiferimento)
               and not icmssobreipi(produtos)
               and not ICMSSobreDespesasAcessorias(produtos)
               and (produtos.fieldbyname('valoripi').ascurrency <> 0)
               and (produtos.fieldbyname('despesasacessorias').ascurrency <> 0)
               and (produtos.findfield('icmssobredespesasacessorias')<>nil) then
            begin

              vDiferenca := abs((produtos.fieldbyname('icmsbasecalculo').ascurrency -
                            FloatToCurr(icmsbasecalculo(produtos))));

              if vDiferenca >= 0.01 then
              begin
                vDiferenca := abs(vDiferenca - (produtos.fieldbyname('despesasacessorias').ascurrency + produtos.fieldbyname('valoripi').ascurrency));
                produtos.fieldbyname('icmssobredespesasacessorias').asboolean := vdiferenca <= 0.01;
                if produtos.findfield('icmssobreipi')<>nil then
                  produtos.fieldbyname('icmssobreipi').asboolean := vdiferenca <= 0.01;
              end
              else
              begin
                produtos.fieldbyname('icmssobredespesasacessorias').asboolean := false;
                if produtos.findfield('icmssobreipi')<>nil then
                  produtos.fieldbyname('icmssobreipi').asboolean := false;
              end;
            end;

            if not icmsoutrasDigitado then
              if PermiteAlterarDadosICMS(tpAltICMSOutras) then
                produtos.FieldByName('icmsoutras').clear;

            if PermiteAlterarDadosICMS(tpAltICMSIsentas) then
              produtos.FieldByName('icmsisentas').clear;

            if not ValorICMSDigitado then
            begin
              if CondicaoPRedBC(cst_nf,
                                csosn_nf,
                                crt) then
              begin
                if PermiteAlterarDadosICMS then
                begin
                  produtos.fieldbyname(CampoValorReducaoBase).AsCurrency   := reducaobase;
                  if produtos.fieldbyname('percentualreducaobase').IsNull then
                    produtos.fieldbyname('percentualreducaobase').AsCurrency := 0;
                end;

                if produtos.findfield('valorreducaobase_custo')<>nil then
                  produtos.fieldbyname('valorreducaobase_custo').AsCurrency   := reducaobase_custo;

                if produtos.findfield('percentualreducaobase_custo')<>nil then
                  if produtos.fieldbyname('percentualreducaobase_custo').IsNull then
                    produtos.fieldbyname('percentualreducaobase_custo').AsCurrency := 0;

              end
              else
              begin
                if PermiteAlterarDadosICMS then
                begin
                  produtos.fieldbyname(CampoValorReducaoBase).clear;
                  produtos.fieldbyname('percentualreducaobase').clear;
                end;

                if produtos.findfield('valorreducaobase_custo')<>nil then
                  produtos.fieldbyname('valorreducaobase_custo').AsCurrency   := reducaobase_custo;

                if produtos.findfield('percentualreducaobase_custo')<>nil then
                  if produtos.fieldbyname('percentualreducaobase_custo').IsNull then
                    produtos.fieldbyname('percentualreducaobase_custo').AsCurrency := 0;
              end;


              if PermiteAlterarDadosICMS then
              begin
                if CondicaoBaseICMS(cst_nf,
                                    csosn_nf, csosn_produto,
                                    crt, naocalcularvaloresicmsdiferimento) then
                begin
                  produtos.FieldByName('icmsbasecalculo').AsCurrency  := icmsbasecalculo(produtos);
                  if produtos.FieldByName('icmsbasecalculo').AsCurrency <> 0 then
                    produtos.FieldByName('icmsbasecalculo').AsCurrency   := icmsbasecalculo(produtos) - produtos.fieldbyname(CampoValorReducaoBase).AsCurrency;

                  if (produtos.findfield('pdif')<>nil) and (produtos.fieldbyname('pdif').ascurrency <> 0) then
                  begin
                    produtos.FieldByName('vicmsop').AsCurrency         := icmsvalor;
                    produtos.FieldByName('vicmsdif').AsCurrency := roundto((produtos.FieldByName('vicmsop').AsCurrency * produtos.fieldbyname('pdif').ascurrency)/100,-2);
                    produtos.FieldByName('icmsvalor').AsCurrency         := produtos.FieldByName('vicmsop').AsCurrency - produtos.FieldByName('vicmsdif').AsCurrency;
                  end
                  else
                    produtos.FieldByName('icmsvalor').AsCurrency         := icmsvalor;

                  if produtos.FieldByName('aliquotaicms').IsNull then
                    produtos.FieldByName('aliquotaicms').AsCurrency := 0;

                  if (crt <> 1) then                         //não é do simples
                  begin

                    if Condicao_Venda then
                    begin
                      if (cst_nf = ctTRIBUTADASUBSTITUICAO) or // 10 Tributada e com cobrança do ICMS por substituição tributária
                         (cst_nf = ctREDUCAOBASESUBSTITUICAO) or // 70 Tributação ICMS com redução de base de cálculo e cobrança do ICMS por substituição tributária
                         (cst_nf = ctOUTROS)  then             // 90 Tributação ICMS: Outros
                        produtos.FieldByName('pFCP').AsCurrency := AliquotaFCP(produtos.fieldbyname(CampoProduto).AsString, EstadoFilialBase)
                      else
                        produtos.FieldByName('pFCP').AsCurrency := AliquotaFCP(produtos.fieldbyname(CampoProduto).AsString, estadoDestino);

                      if (cst_nf = ctTRIBUTADA) then     //00 Tributada integralmente
                        produtos.FieldByName('vFCP').AsCurrency  := icmsvalorfcp(produtos.FieldByName('icmsbasecalculo').AsCurrency)
                      else
                      if (cst_nf = ctTRIBUTADASUBSTITUICAO) or // 10 Tributada e com cobrança do ICMS por substituição tributária
                         (cst_nf = ctREDUCAOBASE) or           // 20 Tributação com redução de base de cálculo
                         (cst_nf = ctDIFERIMENTO) or           // 51 Tributação com Diferimento (a exigência do preenchimento das informações do ICMS diferido fica a critério de cada UF).
                         (cst_nf = ctREDUCAOBASESUBSTITUICAO) or // 70 Tributação ICMS com redução de base de cálculo e cobrança do ICMS por substituição tributária
                         (cst_nf = ctOUTROS)  then             // 90 Tributação ICMS: Outros
                      begin
                        if produtos.FieldByName('pFCP').AsCurrency <> 0 then
                          produtos.FieldByName('vBCFCP').asCurrency := produtos.FieldByName('icmsbasecalculo').AsCurrency
                        else
                          produtos.FieldByName('vBCFCP').asCurrency := 0;
                        produtos.FieldByName('vFCP').AsCurrency  := icmsvalorfcp(produtos.FieldByName('vBCFCP').asCurrency);
                      end;
                    end;

                  end
                  else
                  begin
                     //simples nacional
                   { produtos.FieldByName('pFCP').clear;
                    produtos.FieldByName('vBCFCP').Clear;
                    produtos.FieldByName('vFCP').Clear;}
                  end;
                end
                else
                begin
                  produtos.FieldByName('icmsbasecalculo').Clear;
                  produtos.FieldByName('icmsvalor').Clear;
                 { produtos.FieldByName('vBCFCP').Clear;
                  produtos.FieldByName('vFCP').Clear;}
                end;

              end;
            end;


            if NFSaidaouEntradaPelaEmpresa then
            begin
              if Condicaopcredsn(csosn_nf, RegimeTributario) then
              begin
                produtos.FieldByName('pCredSN').AsCurrency     := AliquotaICMSSN;
                produtos.FieldByName('vCredICMSSN').AsCurrency := CredICMSSN;
              end
              else
              begin
                if produtos.Findfield('vCredICMSSN')<> nil then
                  produtos.FieldByName('vCredICMSSN').clear;

                if produtos.Findfield('pCredSN')<> nil then
                  produtos.FieldByName('pCredSN').clear;
                
              end;
            end;

            if not ValorICMSSTDigitado and not CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos) then
            begin
              if CondicaopMVAST(cst_nf,
                                csosn_nf,
                                crt) and not heimportacao then
              begin
                if  PermiteAlterarDadosICMS then
                begin
                  produtos.FieldByName('fatorsubstituicao').AsFloat := fatorsubstituicao[EstadoSubstituicao, produtos.fieldbyname(CampoProduto).AsString, PessoaTipo, VendaConsumidorFinal, ContribICMS, IPINCM ];
                  produtos.fieldByname('PercReducaoMVA').AsFloat := PercReducaoMVA(EstadoSubstituicao, IPINCM);

                  if not saida then
                    if produtos.FieldByName('fatorsubstituicao').AsFloat <= 1 then
                      MensagemAutoClose('Alerta', format('O produto %s não possui o percentual do MVA para o cálculo do valor da ST.',[produtos.FieldByName(campoprodutovisual).AsString]),7);

                  produtos.FieldByName('AliquotaICMSST').AsCurrency := AliquotaICMSST(EstadoSubstituicao);
                  if produtos.findfield('pmvast')<>nil then
                  begin
                    if produtos.FieldByName('fatorsubstituicao').AsFloat > 1 then
                      Produtos.fieldbyname('pmvast').AsCurrency := abs((1 - produtos.FieldByName('fatorsubstituicao').AsFloat) * 100)
                    else
                      Produtos.fieldbyname('pmvast').AsCurrency := 0;
                  end;

                  produtos.fieldbyname('reducaobasest').AsCurrency     := ReducaoBaseST;
                  produtos.FieldByName('ICMSBaseCalculoST').AsCurrency := icmsbasecalculost - produtos.fieldbyname('reducaobasest').AsCurrency;
                  produtos.FieldByName('ICMSValorST').AsCurrency    := IcmsValorST;

                  if produtos.fieldbyname('pRedBCST').IsNull then
                    produtos.fieldbyname('pRedBCST').AsCurrency := 0;

                  if (produtos.FieldByName('ICMSValorST').AsCurrency > 0) and not baseDupla then
                      produtos.FieldByName('ICMSValorST').AsCurrency       := produtos.FieldByName('ICMSValorST').AsCurrency - produtos.FieldByName('icmsvalor').AsCurrency;

                  if Condicao_Venda then
                  begin
                    produtos.FieldByName('pFCPST').AsCurrency := AliquotaFCP(produtos.fieldbyname(CampoProduto).AsString, estadoDestino);

                    if produtos.FieldByName('pFCPST').AsCurrency <> 0 then
                      produtos.FieldByName('vBCFCPST').asCurrency := produtos.FieldByName('ICMSBaseCalculoST').AsCurrency
                    else
                      produtos.FieldByName('vBCFCPST').asCurrency := 0;

                    produtos.FieldByName('vFCPST').AsCurrency  := IcmsValorfcpst(produtos.FieldByName('vBCFCPST').asCurrency);
                    if produtos.FieldByName('vFCPST').AsCurrency > 0 then
                      produtos.FieldByName('vFCPST').AsCurrency  := produtos.FieldByName('vFCPST').AsCurrency - produtos.FieldByName('vFCP').AsCurrency;
                  end;

                end;
              end
              else
              begin
                if PermiteAlterarDadosICMS then
                  ZerarDadosST;

                if produtos.FindField('pICMSInterPart')<>nil then
                begin
                  {
                  if saida and VendaConsumidorFinal and OperacaoInterestadual  and
                    (not contribicms OR (ContribICMS and ResponsavelDifal))  and
                    (modelodocto = '55') and
                    eHNotaFiscalSaidaVenda(produtos.fieldByname('codigofiscal').Asinteger,false,false) and
                    CondicaoICMSInterPart(cst_nf, csosn_nf, crt) then
                  }

                  ResponsavelDifal;

                  if Condicao_ICMSUFDest then
                  begin

                    produtos.FieldByName('pFCP').clear;
                    produtos.FieldByName('vBCFCP').clear;
                    produtos.FieldByName('vFCP').clear;

                    produtos.FieldByName('pFCPST').clear;
                    produtos.FieldByName('vBCFCPST').clear;
                    produtos.FieldByName('vFCPST').clear;

                    produtos.FieldByName('pFCPSTRet').clear;
                    produtos.FieldByName('vBCFCPSTRet').clear;
                    produtos.FieldByName('vFCPSTRet').clear;

                    //se for producao propria deve ser 6107
                    if produtos.fieldByname('codigofiscal').AsString='6101' then
                      produtos.fieldByname('codigofiscal').asString := '6107'
                    else if produtos.fieldByname('codigofiscal').AsString='6102' then
                            produtos.fieldByname('codigofiscal').asString := '6108'
                    else if produtos.fieldByname('codigofiscal').AsString='6403' then {Acrescentado segundo instruções da TecPlan para atender a Infotec}
                            produtos.fieldByname('codigofiscal').asString := '6108'
                    else if produtos.fieldByname('codigofiscal').AsString='6116' then
                         begin

                           if ( (notas.findfield('dadofiscalsimplesfaturamento')<>nil) and
                                (notas.fieldbyname('dadofiscalsimplesfaturamento').asinteger = 0) ) or
                               (notas.findfield('dadofiscalsimplesfaturamento')=nil) then
                           produtos.fieldByname('codigofiscal').asString := '6107'
                         end
                    else if produtos.fieldByname('codigofiscal').AsString='6117' then
                         begin

                            if ( (notas.findfield('dadofiscalsimplesfaturamento')<>nil) and
                                (notas.fieldbyname('dadofiscalsimplesfaturamento').asinteger = 0) ) or
                               (notas.findfield('dadofiscalsimplesfaturamento')=nil) then
                            produtos.fieldByname('codigofiscal').asString := '6108';
                         end;

                    if produtos.FieldByName('icmsbasecalculo').AsCurrency<> 0 then
                      produtos.FieldByName('vBCUFDest').asCurrency := produtos.FieldByName('icmsbasecalculo').AsCurrency
                    else
                      produtos.FieldByName('vBCUFDest').asCurrency := icmsbasecalculo(produtos, false, false, false);

                    produtos.FieldByName('pICMSUFDest').asCurrency := AliquotaICMS(estadofilialbase, estadoDestino, true);  {aliquota interno do estado de destino}
                    produtos.FieldByName('pICMSInter').asCurrency := produtos.FieldByName('aliquotaicms').AsCurrency;  {aliquota interestadual}

                    produtos.FieldByName('pFCPUFDest').asCurrency := AliquotaFCP(produtos.fieldbyname(CampoProduto).AsString, estadoDestino);
                    if produtos.FieldByName('pFCPUFDest').asCurrency <> 0 then
                      produtos.FieldByName('vBCFCPUFDest').AsCurrency := produtos.FieldByName('vBCUFDest').asCurrency
                    else
                      produtos.FieldByName('vBCFCPUFDest').AsCurrency := 0;

                    {Cliente é contribuinte de icms e esta adquirindo para imobilizado ou uso e consumo}
                    if ((ContribICMS and not vendaconsumidorfinal) and responsaveldifal {notas.fieldbyname('responsaveldifal').asBoolean}) then
                      produtos.FieldByName('pICMSInterPart').asCurrency := 100
                    else
                      produtos.FieldByName('pICMSInterPart').asCurrency := ValorICMSInterPart;

                    produtos.FieldByName('vFCPUFDest').asCurrency := produtos.FieldByName('vBCFCPUFDest').asCurrency * produtos.FieldByName('pFCPUFDest').asCurrency/100;

                    if produtos.FieldByName('pICMSUFDest').asCurrency > produtos.FieldByName('pICMSInter').asCurrency then
                    begin
                      if BaseDupla then
                      begin
                        produtos.FieldByName('vICMSUFDest').asCurrency :=  roundto((((produtos.FieldByName('vBCUFDest').asCurrency * produtos.FieldByName('pICMSUFDest').asCurrency/100) -
                                              (((produtos.FieldByName('vBCUFDest').asCurrency - (produtos.FieldByName('vBCUFDest').asCurrency * produtos.FieldByName('pICMSUFDest').asCurrency/100)) /
                                                ((100-produtos.FieldByName('pICMSInter').asCurrency)/100)) * produtos.FieldByName('pICMSInter').asCurrency/100)) *
                                                                                       produtos.FieldByName('pICMSInterPart').asCurrency/100), -2);

                       produtos.FieldByName('vICMSUFRemet').asCurrency :=  roundto((((produtos.FieldByName('vBCUFDest').asCurrency * produtos.FieldByName('pICMSUFDest').asCurrency/100) -
                                                      (((produtos.FieldByName('vBCUFDest').asCurrency - (produtos.FieldByName('vBCUFDest').asCurrency * produtos.FieldByName('pICMSUFDest').asCurrency/100)) /
                                                        ((100-produtos.FieldByName('pICMSInter').asCurrency)/100)) * produtos.FieldByName('pICMSInter').asCurrency/100)) *
                                                                                               (100 - produtos.FieldByName('pICMSInterPart').asCurrency)/100), -2);
                      end
                      else
                      begin
                        produtos.FieldByName('vICMSUFDest').asCurrency :=  roundto(((produtos.FieldByName('vBCUFDest').asCurrency * produtos.FieldByName('pICMSUFDest').asCurrency/100) -
                                                                            (produtos.FieldByName('vBCUFDest').asCurrency * produtos.FieldByName('pICMSInter').asCurrency/100)) *
                                                                            produtos.FieldByName('pICMSInterPart').asCurrency/100, -2);

                        produtos.FieldByName('vICMSUFRemet').asCurrency := roundto(((produtos.FieldByName('vBCUFDest').asCurrency * produtos.FieldByName('pICMSUFDest').asCurrency/100) -
                                                                            (produtos.FieldByName('vBCUFDest').asCurrency * produtos.FieldByName('pICMSInter').asCurrency/100)) *
                                                                            (100 - produtos.FieldByName('pICMSInterPart').asCurrency)/100, -2);
                      end;

                    end
                    else
                    begin
                      produtos.FieldByName('vICMSUFDest').asCurrency := 0;
                      produtos.FieldByName('vICMSUFRemet').asCurrency := 0;
                    end;

                  end
                  else
                  begin

                    produtos.FieldByName('pFCPUFDest').clear;
                    produtos.FieldByName('pICMSInter').clear;
                    produtos.FieldByName('pICMSInterPart').clear;
                    produtos.FieldByName('vFCPUFDest').clear;
                    produtos.FieldByName('vICMSUFDest').clear;
                    produtos.FieldByName('vICMSUFRemet').clear;
                    produtos.FieldByName('vBCFCPUFDest').clear;
                    produtos.FieldByName('vBCUFDest').Clear;

                    if saida and VendaConsumidorFinal and OperacaoInterestadual  and
                       not contribicms  and
                      (modelodocto = '55') and
                      eHNotaFiscalSaidaVenda(produtos.fieldByname('codigofiscal').Asinteger,false,false) then
                    begin
                    (*
                      if produtos.fieldByname('codigofiscal').AsString='6101' then
                        produtos.fieldByname('codigofiscal').asString := '6101'
                      else if produtos.fieldByname('codigofiscal').AsString='6102' then
                              produtos.fieldByname('codigofiscal').asString := '6102'
                      else if produtos.fieldByname('codigofiscal').AsString='6403' then
                              produtos.fieldByname('codigofiscal').asString := '6102'
                      else if produtos.fieldByname('codigofiscal').AsString='6404' then
                              produtos.fieldByname('codigofiscal').asString := '6102';
                     *)

                      if produtos.fieldByname('codigofiscal').AsString='6101' then
                        produtos.fieldByname('codigofiscal').asString := '6107'
                      else if produtos.fieldByname('codigofiscal').AsString='6102' then
                              produtos.fieldByname('codigofiscal').asString := '6108'
                      else if produtos.fieldByname('codigofiscal').AsString='6403' then
                              produtos.fieldByname('codigofiscal').asString := '6108'
                      else if produtos.fieldByname('codigofiscal').AsString='6404' then
                              produtos.fieldByname('codigofiscal').asString := '6108'
                      else if produtos.fieldByname('codigofiscal').AsString='6116' then
                           begin
                             if ( (notas.findfield('dadofiscalsimplesfaturamento')<>nil) and
                                  (notas.fieldbyname('dadofiscalsimplesfaturamento').asinteger = 0) ) or
                                (notas.findfield('dadofiscalsimplesfaturamento')=nil) then
                               produtos.fieldByname('codigofiscal').asString := '6107';

                           end
                      else if produtos.fieldByname('codigofiscal').AsString='6117' then
                           begin
                             if ( (notas.findfield('dadofiscalsimplesfaturamento')<>nil) and
                                  (notas.fieldbyname('dadofiscalsimplesfaturamento').asinteger = 0) ) or
                                (notas.findfield('dadofiscalsimplesfaturamento')=nil) then
                              produtos.fieldByname('codigofiscal').asString := '6108';
                           end;

                    end;

                  end;
                end;
              end;

              if (OrigemCalculo in [NotaEntrada, NotaEntradaXML, TransferenciaEntrada, CadastroPedidos]) and
                  CondicaoCalcularSTCustonaEntrada(cst_nf, csosn_nf, cst_produto, csosn_produto, EmissaoPropria, OrigemCalculo, produtos.fieldbyname('codigofiscal').asinteger, crt) then
              begin
                produtos.FieldByName('fatorsubstituicao_custo').AsFloat := fatorsubstituicao[EstadoSubstituicao, produtos.fieldbyname(CampoProduto).AsString, PessoaTipo, VendaConsumidorFinal, ContribICMS, IPINCM ];
                produtos.fieldByname('PercReducaoMVA').AsFloat := PercReducaoMVA(EstadoSubstituicao, IPINCM);

                if (produtos.FieldByName('fatorsubstituicao_custo').AsFloat <= 1) and
                ((produtos.FindField('msgfatorsubstituicao_custo')<>nil) and not produtos.FieldByName('msgfatorsubstituicao_custo').AsBoolean) and
                msgDifAliquotaICMS then
                begin
                  MensagemAutoClose('Alerta', format('O produto %s não possui o percentual do MVA para o cálculo do valor da st do custo.',[produtos.FieldByName(campoprodutovisual).AsString]), 7);
                  produtos.FieldByName('msgfatorsubstituicao_custo').AsBoolean := true;
                end;

                produtos.FieldByName('aliquotaicmsst_custo').AsCurrency := AliquotaICMSST(EstadoSubstituicao);

                if produtos.FieldByName('icmsbasecalculo').AsCurrency<>0 then
                  produtos.FieldByName('icmsbasecalculo_custo').AsCurrency   := produtos.FieldByName('icmsbasecalculo').AsCurrency - ValoricmssSobreIPI(produtos) - ValoricmsSobreDespesasAcessorias(produtos)
                else
                begin
                  produtos.FieldByName('icmsbasecalculo_custo').AsCurrency   := icmsbasecalculo(produtos, false, false, false);
                  if produtos.FieldByName('icmsbasecalculo_custo').AsCurrency <> 0 then
                    produtos.FieldByName('icmsbasecalculo_custo').AsCurrency   := icmsbasecalculo(produtos, false, false, false) - produtos.fieldbyname('valorreducaobase_custo').AsCurrency;
                end;

                if produtos.FieldByName('aliquotaicms').AsCurrency<>0 then
                  produtos.FieldByName('aliquotaicms_custo').AsCurrency := produtos.FieldByName('aliquotaicms').AsCurrency
                else
                 produtos.FieldByName('aliquotaicms_custo').AsCurrency := AliquotaICMS(notas.fieldbyname('estado').asstring,EstadoFilialBase);

                produtos.FieldByName('icmsvalor_custo').AsCurrency := ArredondarouTruncar((produtos.FieldByName('icmsbasecalculo_custo').AsCurrency *
                                                                               produtos.FieldByName('aliquotaicms_custo').AsCurrency)/100,-2);

                if (produtos.findfield('aliquotaicmsst_custo')<>nil) and

                {Em 30/MAI/2019, na reunião do Alto  Comando
                 das situações para ICMS ST resolveu comentar
                 o trecho abaixo porque o calculo do ICMS ST
                 na Apolônia, NF 93 1 63.055 não fechava */

                 {((notas.fieldbyname('estado').asstring = EstadoFilialBase) and
                   (produtos.FieldByName('AliquotaICMSST_custo').AsCurrency <> produtos.FieldByName('AliquotaICMS_custo').AsCurrency)) or}

                  ((notas.fieldbyname('estado').asstring <> EstadoFilialBase) and
                   (produtos.FieldByName('AliquotaICMSST_custo').AsCurrency < produtos.FieldByName('AliquotaICMS_custo').AsCurrency)) then

                begin
                  if msgDifAliquotaICMS then
                    MensagemAutoClose('Alerta', format('A discrepância entre as alíquotas de ICMS da NF e do cadastro do produto %s'+#13+
                                         'Será considerada a alíquota da NF',[produtos.FieldByName(campoprodutovisual).AsString]),7);

                   produtos.FieldByName('AliquotaICMSST_custo').AsCurrency := produtos.FieldByName('AliquotaICMS_custo').AsCurrency;

                end;

                produtos.fieldbyname('valorreducaobasest_custo').AsCurrency     := ReducaoBaseST_Custo;
                produtos.FieldByName('ICMSBaseCalculoSTcusto').AsCurrency := icmsbasecalculost_custo - produtos.fieldbyname('valorreducaobasest_custo').AsCurrency;
                produtos.FieldByName('ICMSValorSTCusto').AsCurrency    := IcmsValorST_Custo;

                if produtos.FieldByName('ICMSValorSTCusto').AsCurrency > 0 then
                begin
                  vValor1 := produtos.FieldByName('ICMSValorSTCusto').AsCurrency;
                  vValor2 := produtos.FieldByName('icmsvalor_custo').AsCurrency;
                  produtos.FieldByName('ICMSValorSTCusto').AsCurrency       := produtos.FieldByName('ICMSValorSTCusto').AsCurrency - produtos.FieldByName('icmsvalor_custo').AsCurrency;
                end;

              end
              else
              begin
                  {Existindo o cálculo da st na nota fiscal ou o emissor não deveria emitir st caso o estado
                   destino não tenha st ou o cadastro de produtos esta errado pois deveria estar 500 ou 60}

                if (OrigemCalculo in [NotaEntrada, CadastroPedidos, NotaEntradaXML, TransferenciaEntrada]) and
                    CondicaopMVAST(cst_nf,
                                  csosn_nf,
                                  crt {,PessoaTipo,VendaouCompraConsumidorFinal}) and not heimportacao and
                   not ((( (crt = 1) and (csosn_nf = '900') and (produtos.FieldByName('icmsvalorst').AsCurrency = 0) ) or
                         ( (crt <> 1) and (cst_nf = '90') and (produtos.FieldByName('icmsvalorst').AsCurrency = 0) )) and
                         not PermiteAlterarDadosICMS) then
                begin
                  if ((regimetributario = 1) and (csosn_produto <> '500')) or
                     ((regimetributario <> 1) and (cst_produto <> '60')) then
                  begin
                    if regimetributario = 1 then
                      MensagemAutoclose('Alerta',format('O produto %s está com ST na nota fiscal, mas não no seu cadastro, o csosn deve ser 500.',[produtos.fieldbyname(campoprodutovisual).asstring]),7)
                    else
                      MensagemAutoClose('Alerta',format('O produto %s está com ST na nota fiscal, mas não no seu cadastro, o cst deve ser 60.',[produtos.fieldbyname(campoprodutovisual).asstring]),7);

                      {
                    result := false;
                    break;
                    }

                  end;
                end;

                if produtos.FindField('fatorsubstituicao_custo')<>nil then
                  produtos.FieldByName('fatorsubstituicao_custo').AsCurrency := 0;

                if produtos.findfield('aliquotaicmsst_custo')<>nil then
                  produtos.FieldByName('aliquotaicmsst_custo').AsCurrency := 0;

                if produtos.findfield('pRedBCST_custo')<>nil then
                  produtos.fieldbyname('pRedBCST_custo').AsCurrency := 0;

                if produtos.FindField('valorreducaobasest_custo')<>nil then
                  produtos.fieldbyname('valorreducaobasest_custo').AsCurrency     := 0;

                if produtos.FindField('ICMSBaseCalculoSTCusto')<>nil then
                  produtos.FieldByName('ICMSBaseCalculoSTCusto').AsCurrency := 0;

                if produtos.FindField('ICMSValorSTCusto')<>nil then
                  produtos.FieldByName('ICMSValorSTCusto').AsCurrency := 0;

                if produtos.FindField('aliquotaicms_custo')<>nil then
                  produtos.FieldByName('aliquotaicms_custo').AsCurrency := 0;

                if produtos.FindField('icmsbasecalculo_custo')<>nil then
                  produtos.FieldByName('icmsbasecalculo_custo').AsCurrency   := 0;

                if produtos.FindField('icmsvalor_custo')<>nil then
                  produtos.FieldByName('icmsvalor_custo').AsCurrency := 0;
              end;
            end;

            if CondicaovBCSTRet(cst_nf,
                                csosn_nf,
                                crt) and NFSaidaouEntradaPelaEmpresa  then
            begin
              if PermiteAlterarDadosICMS then
              begin
                AtribuirValoresRetidosST;

                produtos.FieldByName('pST').asCurrency := AliquotaICMSST(EstadoSubstituicao) +  AliquotaFCP(produtos.fieldbyname(CampoProduto).AsString, estadoDestino);
                produtos.FieldByName('pFCPSTRet').asCurrency := AliquotaFCP(produtos.fieldbyname(CampoProduto).AsString, estadoDestino);
                if produtos.FieldByName('pFCPSTRet').asCurrency<>0 then
                  produtos.FieldByName('vBCFCPSTRet').asCurrency := produtos.FieldByName('vBCSTRet').ascurrency
                else
                  produtos.FieldByName('vBCFCPSTRet').asCurrency := 0;
                produtos.FieldByName('vFCPSTRet').AsCurrency := IcmsValorfcpstRet(produtos.FieldByName('vBCFCPSTRet').asCurrency);
              end;
            end
            else
            if NFSaidaouEntradaPelaEmpresa then
            begin

              if PermiteAlterarDadosICMS then
              begin
                if produtos.FindField('vBCSTRet')<> nil      then produtos.FieldByName('vBCSTRet').clear;
                if produtos.FindField('vBCSTRetDesp')<>nil   then produtos.FieldByName('vBCSTRetDesp').clear;
                if produtos.FindField('vICMSSTRet')<>nil     then produtos.FieldByName('vICMSSTRet').clear;
                if produtos.FindField('vICMSSTRetDesp')<>nil then produtos.FieldByName('vICMSSTRetDesp').clear;
                if produtos.FindField('pST')<>nil            then produtos.FieldByName('pST').Clear;
                if produtos.FindField('vBCFCPSTRet')<>nil    then produtos.FieldByName('vBCFCPSTRet').Clear;
                if produtos.FindField('pFCPSTRet')<>nil      then produtos.FieldByName('pFCPSTRet').Clear;
                if produtos.FindField('vFCPSTRet')<>nil      then produtos.FieldByName('vFCPSTRet').Clear;
              end;

              if produtos.FindField('icmsbasecalculo_dev')<>nil then produtos.FieldByName('icmsbasecalculo_dev').clear;
              if produtos.FindField('icmsvalor_dev')<>nil       then produtos.FieldByName('icmsvalor_dev').clear;
            end;

            if (OrigemCalculo = NotaAvulsa) and CondicaoRequerNFEntrada and
               (pos(produtos.fieldbyname('NumeroNotaFiscalEntrada').AsString, vListanotas)=0) then
                 vListanotas := vListanotas + ifthen(vListanotas<>'','/','') + produtos.fieldbyname('NumeroNotaFiscalEntrada').AsString
            else
            if (OrigemCalculo in [NotaEntrada, Devolucao, Troca]) and CondicaoRequerNFSaida and
               (pos(produtos.fieldbyname('NumeroNotaFiscalSaida').AsString, vListanotas)=0) then
                 vListanotas := vListanotas + ifthen(vListanotas<>'','/','') + produtos.fieldbyname('NumeroNotaFiscalSaida').AsString;

            if not icmsoutrasDigitado then
            begin
              {
              if ((csosn_empresa <> '900') and (crt=1)) or
                 ((csosn_empresa = '900') and not CondicaoBaseICMS(cst_nf, csosn_nf, crt, naocalcularvaloresicmsdiferimento)) or

                 ((((cst_empresa = ctDIFERIMENTO) and  not NFSaidaouEntradaPelaEmpresa ) or  // 51
                   ((cst_empresa = ctDIFERIMENTO) and Saida and naocalcularvaloresicmsdiferimento) or
                   (cst_empresa = ctSUSPENSAO          ) or // 50
                   (cst_empresa = ctCOBRADOSUSTITUICAO)) and (crt<>1)) or

                  NotaFiscalVinculada then
                  }

              if (not CondicaoBaseICMS(cst_nf, csosn_nf, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and not saida) or
                 (CondicaoBaseICMS(cst_nf, csosn_nf, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and not saida and
                  ((produtos.FieldByName('icmsbasecalculo').AsCurrency = 0)  or
                   not (CondicaoBaseICMS(cst_empresa, csosn_empresa, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and not saida) )) or
                 (not CondicaoBaseICMS(cst_empresa, csosn_empresa, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and saida)  or
                 (CondicaoBaseICMS(cst_empresa, csosn_empresa, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and saida and NotaFiscalVinculada) then
              begin

                if ((cst_empresa = ctISENTA) or   { 40 }
                    (cst_empresa = ctNAOTRIBUTADA)) { 41 }
                    and (crt <> 1) then
                begin
                  if produtos.FieldByName('icmsbasecalculo').AsCurrency<>0 then
                  begin
                    if (regimetributario = 1) then
                      if not CondicaoBaseICMS(cst_empresa, csosn_empresa, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and not saida and PermiteAlterarDadosICMS(tpAltICMSIsentas) then
                          produtos.FieldByName('icmsisentas').AsCurrency := produtos.FieldByName('icmsbasecalculo').AsCurrency;
                    vDiferenca := ( FloatToCurr(IcmsBaseCalculo(produtos)) -
                                   produtos.fieldbyname(CampoValorReducaoBase).AsCurrency -
                                   produtos.FieldByName('icmsbasecalculo').AsCurrency);

  //                  if (vDiferenca > 0.01) and not CondicaoPRedBC(cst_nf, csosn_nf, crt) then
                    if (vDiferenca <> 0) and not CondicaoPRedBC(cst_nf, csosn_nf, crt) and PermiteAlterarDadosICMS(tpAltICMSOutras) then
                        produtos.FieldByName('icmsoutras').AsCurrency := produtos.FieldByName('icmsoutras').AsCurrency +
                                                                         vDiferenca;
                  end
                  else
                    if PermiteAlterarDadosICMS(tpAltICMSIsentas) then
                      produtos.FieldByName('icmsisentas').AsCurrency := IcmsBaseCalculo(produtos, false, True);
                end
                else
                begin
                  if produtos.FieldByName('icmsbasecalculo').AsCurrency <> 0 then
                  begin
                    if (regimetributario = 1) then
                      if not CondicaoBaseICMS(cst_empresa, csosn_empresa, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and not saida and PermiteAlterarDadosICMS(tpAltICMSOutras) then
                        produtos.FieldByName('icmsoutras').AsCurrency := produtos.FieldByName('icmsbasecalculo').AsCurrency;
                    vDiferenca := ( FloatToCurr(IcmsBaseCalculo(produtos)) -
                                   produtos.fieldbyname(CampoValorReducaoBase).AsCurrency -
                                   produtos.FieldByName('icmsbasecalculo').AsCurrency);

  //                  if (vDiferenca > 0.01) and not CondicaoPRedBC(cst_nf, csosn_nf, crt) then

                    if (vDiferenca <> 0) and not CondicaoPRedBC(cst_nf, csosn_nf, crt) and PermiteAlterarDadosICMS(tpAltICMSOutras) then
                        produtos.FieldByName('icmsoutras').AsCurrency := produtos.FieldByName('icmsoutras').AsCurrency +
                                                                         vDiferenca;
                  end
                  else
                    if PermiteAlterarDadosICMS(tpAltICMSOutras) then
                    begin
                      produtos.FieldByName('icmsoutras').AsCurrency := IcmsBaseCalculo(produtos,false, True);
                      produtos.FieldByName('icmsoutras').AsCurrency := produtos.FieldByName('icmsoutras').AsCurrency +
                         ifthen(ICMSSobreDespesasAcessorias(Produtos), 0, produtos.fieldbyname('despesasacessorias').ascurrency) +
                         produtos.fieldbyname('acrescimo').asfloat  -
                         ValorProdutos_vicmsstretdesp(produtos);
                    end;
                end;

                if NotaFiscalVinculada then
                begin
                  produtos.FieldByName('icmsbasecalculo').clear;
                  produtos.FieldByName('icmsvalor').clear;
                end;
              end
              else
              begin

                {Exemplo abaixo: tendo cst '00' (CondicaoBaseICMS) e na nota de entrada o produto tiver icmsbasecalculo porem este este não alcançar
                 o valor da base calculado pelo sistema pela função IcmsBaseCalculo(produtos) a diferença e atribuida em 'icmsoutras' fazendo assim o fechamento
                 dos calculos que devem fechar com o total da nota sendo base + isentas + outras = totaldanota}

                if CondicaoBaseICMS(cst_nf, csosn_nf, csosn_produto, crt, naocalcularvaloresicmsdiferimento) and not saida
                   and (produtos.FieldByName('icmsbasecalculo').AsCurrency <> 0) then
                begin
                  vDiferenca := ( FloatToCurr(IcmsBaseCalculo(produtos)) -
                                 produtos.fieldbyname(CampoValorReducaoBase).AsCurrency -
                                 produtos.FieldByName('icmsbasecalculo').AsCurrency);

                  if (vDiferenca <> 0) and not CondicaoPRedBC(cst_nf, csosn_nf, crt) and PermiteAlterarDadosICMS(tpAltICMSOutras) then
                      produtos.FieldByName('icmsoutras').AsCurrency := produtos.FieldByName('icmsoutras').AsCurrency + vDiferenca;
                end;

                if not HeImportacao then
                begin
                  if PermiteAlterarDadosICMS(tpAltICMSOutras) then
                    produtos.FieldByName('icmsoutras').ascurrency := produtos.FieldByName('icmsoutras').ascurrency +
                                                                   ifthen(ICMSSobreDespesasAcessorias(produtos), 0, produtos.FieldByName('despesasacessorias').asfloat) +
                                                                   produtos.fieldbyname('acrescimo').asfloat -
                                                                 {  produtos.fieldbyname('desconto').asfloat  +}
                                                                   ValorProdutos_vicmsstretdesp(produtos);
                end;
              end;
            end;

            {
            if (csosn = '300') or
               (csosn = '400') then
              produtos.FieldByName('icmsisentas').AsCurrency := IcmsBaseCalculo;
              }

            if (crt = 1) then
            begin
              if saida and (CondicaoEmissorNFE or Sped_pis_cofins or sped_fiscal) and not Assigned(ECFPadrao) then
              begin
                qryTributosICMSObrigacoes_.First;
                while not qryTributosICMSObrigacoes_.Eof do
                begin
                  if qryTributosICMSObrigacoes_.fieldbyname('campoteclux').asstring<>'' then
                    if CampoNFECSOSNNecessario and
                       (lowercase(produtos.name)<>'qryprodutoscontratos') and
                       (lowercase(produtos.name)<>'qryprodutosorcamentos') and
                       (lowercase(produtos.name)<>'qryprodutoscompostos') and

                       (produtos.FieldByName(ifthen(qryTributosICMSObrigacoes_.fieldbyname('campoteclux').asstring='incidencia','csosn',
                                                    qryTributosICMSObrigacoes_.fieldbyname('campoteclux').asstring)).AsString='') then

                    begin
                      result := false;
                      CancelarAtualizacoes([]);
                      MensagemErro(format(msgErroicms_faltante, [produtos.fieldbyname(campoprodutovisual).asstring,
                                                                 csosn_nf,
                                                                 qryTributosICMSObrigacoes_.fieldbyname('descricao').asstring]));
                      break;
                    end;

                  qryTributosICMSObrigacoes_.Next;
                end;
              end;

              if not HeImportacao then
              begin
                if ValorICMSDigitado and
                   (csosn_nf = '900') { and

                   ((not NaoGerarCreditoICMS and not saida) or
                    (not NaoGerarDebitoICMS and saida)) Gedovar 04/07/13} then

                begin
                  if ((produtos.FieldByName('icmsbasecalculo').AsCurrency  = 0) or
                     (produtos.FieldByName('icmsvalor').AsCurrency = 0)) and
                     not eHNotaComplementar then
                  begin
                    result := false;
                    CancelarAtualizacoes([]);
                    if (produtos.FieldByName('icmsbasecalculo').AsCurrency  = 0) then
                      MensagemErro(format(msgErroicms_faltante, [produtos.fieldbyname(campoprodutovisual).asstring,
                                                                 csosn_nf,
                                                                 'BASE DE CÁLCULO DO ICMS']))
                    else
                      MensagemErro(format(msgErroicms_faltante, [produtos.fieldbyname(campoprodutovisual).asstring,
                                                                 csosn_nf,
                                                                 'VALOR DO ICMS']));

                    break;
                  end;
                  (*
                  else
                  begin
                    {coloca em outras o valor da diferenca do icms digitado quando este for maior que 0,01}
                    if not icmsoutrasDigitado then
                      if ( FloatToCurr(IcmsBaseCalculo(produtos)) - produtos.fieldbyname(CampoValorReducaoBase).AsCurrency - produtos.FieldByName('icmsbasecalculo').AsCurrency) > 0.01 then
                         produtos.FieldByName('icmsoutras').AsCurrency := produtos.FieldByName('icmsoutras').AsCurrency +
                                                                         FloattoCurr(IcmsBaseCalculo(produtos)) -
                                                                         produtos.fieldbyname(CampoValorReducaoBase).AsCurrency -
                                                                         produtos.FieldByName('icmsbasecalculo').AsCurrency;

                  end;
                  *)
                end
                else
                begin
                  if not ValorICMSDigitado and saida and
                     (csosn_nf = '900') {and
                     ((not NaoGerarCreditoICMS and not saida) or
                      (not NaoGerarDebitoICMS and saida)) Gedovar 04/04/13} and

                     ((produtos.FindField('baseicms')<>nil) and
                      (produtos.Fieldbyname('baseicms').AsCurrency <>0) and
                      (produtos.Fieldbyname('baseicms').AsCurrency < icmsbasecalculo(produtos,false))) and PermiteAlterarDadosICMS(tpAltICMSIsentas) then

                    produtos.fieldbyname('icmsisentas').ascurrency := icmsbasecalculo(produtos,false) -
                                                                      ArredondarouTruncar(Produtos.fieldbyname('quantidade').AsFloat * Produtos.fieldbyname('baseicms').ascurrency,-2);
                end;
              end;

            end
            else
            begin
              if saida and (CondicaoEmissorNFE or Sped_pis_cofins or sped_fiscal) and ((not Assigned(ECFPadrao)) or NotaFiscalVinculada) then
              begin
                qryTributosICMSObrigacoes_.First;
                while not qryTributosICMSObrigacoes_.Eof do
                begin
                  if qryTributosICMSObrigacoes_.fieldbyname('campoteclux').asstring<>'' then
                    if CampoNFENecessario and
                      (lowercase(produtos.name)<>'qryprodutoscontratos') and
                      (lowercase(produtos.name)<>'qryprodutosorcamentos') and
                      (lowercase(produtos.name)<>'qryprodutoscompostos') and
                      (produtos.FieldByName(qryTributosICMSObrigacoes_.fieldbyname('campoteclux').asstring).AsString='') then
                    begin
                      result := false;
                      CancelarAtualizacoes([]);
                      MensagemErro(format(msgErroicms_faltante, [produtos.fieldbyname(campoprodutovisual).asstring,
                                                                 cst_nf,
                                                                 qryTributosICMSObrigacoes_.fieldbyname('descricao').asstring]));
                      break;
                    end;

                  qryTributosICMSObrigacoes_.Next;
                end;
              end;

              if not HeImportacao then
              begin
                if ValorICMSDigitado and
                   not ((cst_nf = ctCOBRADOSUSTITUICAO) or { 60}
                        (cst_nf = ctNAOTRIBUTADA) or
                        (cst_nf = ctSUSPENSAO) {or
                        NaoGerarCreditoICMS  or
                        NaoGerarDebitoICMS Gedovar 04/07/13}) then
                begin
                  if ((produtos.FieldByName('icmsbasecalculo').AsCurrency  = 0) or
                      (produtos.FieldByName('icmsvalor').AsCurrency        = 0)) and
                     not eHNotaComplementar then
                  begin
                    result := false;
                    CancelarAtualizacoes([]);
                    if (produtos.FieldByName('icmsbasecalculo').AsCurrency  = 0) then
                      MensagemErro(format(msgErroicms_faltante, [produtos.fieldbyname(campoprodutovisual).asstring,
                                                                 cst_nf,
                                                                 'BASE DE CÁLCULO DO ICMS']))
                    else
                      MensagemErro(format(msgErroicms_faltante, [produtos.fieldbyname(campoprodutovisual).asstring,
                                                                 cst_nf,
                                                                 'VALOR DO ICMS']));

                    break;
                  end;
                  (*
                  else
                  begin
                    {coloca em outras o valor da diferenca do icms digitado quando este for maior que 0,01}
                    if not icmsoutrasDigitado then
                    begin
                      vDiferenca := ( FloatToCurr(IcmsBaseCalculo(produtos)) -
                          produtos.fieldbyname(CampoValorReducaoBase).AsCurrency -
                          produtos.FieldByName('icmsbasecalculo').AsCurrency);

                      if vDiferenca > 0.01 then
                        produtos.FieldByName('icmsoutras').AsCurrency := produtos.FieldByName('icmsoutras').AsCurrency +
                                                                         FloattoCurr(IcmsBaseCalculo(produtos)) -
                                                                         produtos.fieldbyname(CampoValorReducaoBase).AsCurrency -
                                                                         produtos.FieldByName('icmsbasecalculo').AsCurrency;
                    end;
                  end;
                  *)
                end
                else
                begin
                  if not ValorICMSDigitado and saida and

  {                   (cst = '60') and}

                     {((not NaoGerarCreditoICMS and not saida) or
                      (not NaoGerarDebitoICMS and saida)) and Gedovar 04/07/13}

                     ((produtos.FindField('baseicms')<>nil) and
                      (produtos.Fieldbyname('baseicms').AsCurrency <>0) and
                      (produtos.Fieldbyname('baseicms').AsCurrency < icmsbasecalculo(produtos,false))) and PermiteAlterarDadosICMS(tpAltICMSIsentas) then

                    produtos.fieldbyname('icmsisentas').ascurrency := produtos.fieldbyname('icmsisentas').ascurrency +
                                                                      icmsbasecalculo(produtos,false) -
                                                                      ArredondarouTruncar(Produtos.fieldbyname('quantidade').AsFloat * Produtos.fieldbyname('baseicms').ascurrency,-2);
                end;
              end;
            end;

            if saida then
              if produtos.FindField('codigofiscal')<>nil then
                if (produtos.fieldbyname('codigofiscal').asinteger = 5102) then
                  if not Assigned(ECFPadrao) then
                    if (crt = 1) and
                       (produtos.fieldbyname('csosn').asString = '500') then
                     begin
                       result := false;
                       MensagemErro(format('O produto %s deve ser revisto pois possui CFOP 5102 e CSOSN 500',[produtos.fieldbyname(CampoProdutoVisual).asString]));
                       break;
                     end;
          end;





          //PIS e COFINS
          {
             01     | Operação Tributável com Alíquota Básica
             02     | Operação Tributável com Alíquota Diferenciada
             03     | Operação Tributável com Alíquota por Unidade de Medida de Produto
             05     | Operação Tributável por Substituição Tributária
             49     | Outras Operações de Saída
             50     | Operação com Direito a Crédito - Vinculada Exclusivamente a Receita Tributada no Mercado Interno
             51     | Operação com Direito a Crédito  Vinculada Exclusivamente a Receita Não Tributada no Mercado Interno
             52     | Operação com Direito a Crédito - Vinculada Exclusivamente a Receita de Exportação
             53     | Operação com Direito a Crédito - Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno
             54     | Operação com Direito a Crédito - Vinculada a Receitas Tributadas no Mercado Interno e de Exportação
             55     | Operação com Direito a Crédito - Vinculada a Receitas Não-Tributadas no Mercado Interno e de Exportação
             56     | Operação com Direito a Crédito - Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno, e de Exportação
             60     | Crédito Presumido - Operação de Aquisição Vinculada Exclusivamente a Receita Tributada no Mercado Interno
             61     | Crédito Presumido - Operação de Aquisição Vinculada Exclusivamente a Receita Não-Tributada no Mercado Interno
             62     | Crédito Presumido - Operação de Aquisição Vinculada Exclusivamente a Receita de Exportação
             63     | Crédito Presumido - Operação de Aquisição Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno
             64     | Crédito Presumido - Operação de Aquisição Vinculada a Receitas Tributadas no Mercado Interno e de Exportação
             65     | Crédito Presumido - Operação de Aquisição Vinculada a Receitas Não-Tributadas no Mercado Interno e de Exportação
             66     | Crédito Presumido - Operação de Aquisição Vinculada a Receitas Tributadas e Não-Tributadas no Mercado Interno, e de Exportação
             67     | Crédito Presumido - Outras Operações
             75     | Operação de Aquisição por Substituição Tributária
             98     | Outras Operações de Entrada
             99     | Outras Operações

          }

          if (produtos.FieldByName('piscst').AsString='') then
          begin
            if (CondicaoEmissorNFE or Sped_pis_cofins)  and (not Assigned(ECFPadrao) or NotaFiscalVinculada) then
            begin
              result := false;
              CancelarAtualizacoes([]);
              MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname(campoprodutovisual).asstring,
                            'PIS CST - Tributação do PIS']));
              break;
            end;
          end
          else
          if (produtos.FieldByName('piscst').AsString = '01') or
             (produtos.FieldByName('piscst').AsString = '02') or

             {codigo não presentes na nfe ainda: ficam como 99}

             (produtos.FieldByName('piscst').AsString = '05') or

             (produtos.FieldByName('piscst').AsString = '49') or
             (produtos.FieldByName('piscst').AsString = '50') or
             (produtos.FieldByName('piscst').AsString = '51') or
             (produtos.FieldByName('piscst').AsString = '52') or
             (produtos.FieldByName('piscst').AsString = '53') or
             (produtos.FieldByName('piscst').AsString = '54') or
             (produtos.FieldByName('piscst').AsString = '55') or
             (produtos.FieldByName('piscst').AsString = '56') or

             (produtos.FieldByName('piscst').AsString = '60') or
             (produtos.FieldByName('piscst').AsString = '61') or
             (produtos.FieldByName('piscst').AsString = '62') or
             (produtos.FieldByName('piscst').AsString = '63') or
             (produtos.FieldByName('piscst').AsString = '64') or
             (produtos.FieldByName('piscst').AsString = '65') or
             (produtos.FieldByName('piscst').AsString = '66') or
             (produtos.FieldByName('piscst').AsString = '67') or

             (produtos.FieldByName('piscst').AsString = '75') or
             (produtos.FieldByName('piscst').AsString = '98') or
             (produtos.FieldByName('piscst').AsString = '99') then


          begin
            if HeImportacao then
              {NÃO HÁ CALCULO PARA PIS NA NF DE IMPORTAÇÃO }
            else
            begin

              if not ValorPISDigitado then
              begin
                if not (produtos.state in [dsinsert, dsedit]) then
                  produtos.Edit;

               {Para importação este cálculo deve ser revisto}

                if produtos.FieldByName('pisaliquota').isnull then
                  produtos.FieldByName('pisaliquota').AsCurrency := 0;

                produtos.FieldByName('pisbasecalculo').AsCurrency := PISCOFINSBaseCalculo(produtos);
                produtos.FieldByName('pisvalor').AsCurrency :=
                      ArredondarouTruncar((produtos.FieldByName('pisbasecalculo').AsCurrency *
                               produtos.FieldByName('pisaliquota').AsCurrency)/100,-2);
              end;

            end;
          end
          else
          if (produtos.FieldByName('piscst').AsString = '03') then
          begin
            if CondicaoEmissorNFE and not Assigned(ECFPadrao) then
            begin
              result := false;
              CancelarAtualizacoes([]);
              MensagemErro('Código não preparado para PIS CST = 03');
              break;
            end;
          end
          else

          {
           04 - Operação Tributável (tributação monofásica (alíquota zero))
           06 - Operação Tributável (alíquota zero)
           08 - Operação Sem Incidência da Contribuição
           09 - Operação com Suspensão da Contribuição
           70     | Operação de Aquisição sem Direito a Crédito
           72     | Operação de Aquisição com Suspensão
           73     | Operação de Aquisição a Alíquota Zero
           74     | Operação de Aquisição sem Incidência da Contribuição
          }

          if (produtos.FieldByName('piscst').AsString = '04') or
             (produtos.FieldByName('piscst').AsString = '06') or
             (produtos.FieldByName('piscst').AsString = '08') or
             (produtos.FieldByName('piscst').AsString = '09') or
             (produtos.FieldByName('piscst').AsString = '70') or
             (produtos.FieldByName('piscst').AsString = '72') or
             (produtos.FieldByName('piscst').AsString = '73') or
             (produtos.FieldByName('piscst').AsString = '74') then
          begin
            {if HeImportacao then

            else
            begin}
