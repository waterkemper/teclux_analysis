Procedure GerarAnexo_X_PAF_ECF;
var Arquivo : TextFile;
    NomeArq, ArqTexto, aMD5 : String;
    F: TSearchRec;
    Ret,i, NArquivos: Integer;
    Arquivos: Array[0..14] of String;
    ACBrEad : TACBrEad;
    dmmenufiscal: TdtmMenuFiscal;

begin
     {Gerar o anexo X do PAF ECF : arquivo contendo o md5 dos .exe e .bpl e demais informações}
   {REGISTRO TIPO N1
   Nº Denominação do Campo Conteúdo Tamanho Posição Formato
   01 Tipo de registro “N1” 02 1 2 X
   02 CNPJ CNPJ do desenvolvedor do PAF-ECF 14 3 16 N
   03 Inscrição Estadual Inscrição Estadual do desenvolvedor 14 17 30 X
   04 Inscrição Municipal Inscrição Municipal do desenvolvedor 14 31 44 X
   05 Razão Social Razão Social do desenvolvedor 50 45 94 X}

    // Apaga arquivo anterior
    ArqTexto := ExtractFilePath(Application.ExeName)+'Anexo_X.txt';

    if FileExists(ArqTexto) then
       sysUtils.DeleteFile(ArqTexto);
    // cria o arquivo TXT na mesma pasta do sistema
    AssignFile(Arquivo,ArqTexto);
    ReWrite(Arquivo);
    WriteLn(Arquivo,
            'N1' + preenchestring(ParSistema.CNPJDesenvolvedora,'0',14,False)+
                   preenchestring(ParSistema.IEDesenvolvedora  ,' ',14,True )+
                   preenchestring(ParSistema.IMDesenvolvedora  ,' ',14,True )+
                   preenchestring(ParSistema.NomeEmpresaDesenvolvedora,' ',50,True ));
{
 7.2 - REGISTRO TIPO N2 - IDENTIFICAÇÃO DO PAF-ECF:
        Nº Denominação do Campo Conteúdo Tamanho Posição Formato
        01 Tipo de registro “N2” 02 1 2 X
        02 Laudo do PAF-ECF Número do Laudo de Análise Funcional 10 3 12 X
        03 Nome do PAF-ECF Nome do aplicativo indicado no Laudo de Análise Técnica 50 13 62 X
        04 Versão do PAF-ECF  Versão atual do aplicativo indicado no Laudo de Análise  Técnica 10 63 72 X
}

    WriteLn(Arquivo,
            'N2' + preenchestring(ParSistema.LaudoPAFECF,'0',10,True)+
                   preenchestring(ParSistema.NomeComercialSistema ,' ',50,True )+
                   preenchestring(ParSistema.VersaoPAFECF,' ',10,True ));
{
7.3 - REGISTRO TIPO N3 - RELAÇÃO DOS EXECUTÁVEIS E SEUS CÓDIGOS DE AUTENTICAÇÃO (MD5):
Nº Denominação do Campo  Conteúdo Tamanho Posição Formato
01 Tipo de registro “N3” 02 1 2 X
02 Nome do arquivo Nome do arquivo executável 50 3 52 X
03 Código de autenticação (MD-5) Código de autenticação (MD-5) 32 53 84 X
}

    NArquivos := 0;
    // lista todos os arquivo exe da pasta do aplicativo e gera o MF5
    Arquivos_PAF[0]:='ADMINSISTEMA.BPL';
	Arquivos_PAF[1]:='AUTOMACAO.BPL';
	Arquivos_PAF[2]:='BANCOS.BPL';
	Arquivos_PAF[3]:='BEMAFI32.DLL';
    Arquivos_PAF[4]:='BEMAMFD.DLL';
    Arquivos_PAF[5]:='BEMAMFD2.DLL';
    Arquivos_PAF[6]:='BEMATECH.DLL';
	Arquivos_PAF[7]:='CADASTROCLIENTES.BPL';
    Arquivos_PAF[8]:='CADASTROCONTRATOS.BPL';
	Arquivos_PAF[9]:='CAIXA.BPL';
	Arquivos_PAF[10]:='COBRANCA.BPL';
	Arquivos_PAF[11]:='CONFIGURACOESECF.BPL';
	Arquivos_PAF[12]:='CONSULTAESTOQUE.BPL';
	Arquivos_PAF[13]:='CONSULTANOTASFISCAISSAIDA.BPL';
	Arquivos_PAF[14]:='CONTABIL.BPL';
	Arquivos_PAF[15]:='CONTASARECEBER.BPL';
	Arquivos_PAF[16]:='CONTASPAGAR.BPL';
	Arquivos_PAF[17]:='DAO350.DLL';
    Arquivos_PAF[18]:='DARUMAFRAMEWORK.DLL';
	Arquivos_PAF[19]:='DLLEECFC.DLL';
 	Arquivos_PAF[20]:='DLLG2.DLL';
  Arquivos_PAF[21]:='DLL_LEITURAMFDBIN.DLL';
	Arquivos_PAF[22]:='ECF32M.DLL';
	Arquivos_PAF[23]:='EECF.DLL';
	Arquivos_PAF[24]:='EECF2.DLL';
	Arquivos_PAF[25]:='ENTREGA.BPL';
	Arquivos_PAF[26]:='ESTOQUE.BPL';
	Arquivos_PAF[27]:='FICHAFINANCEIRA.BPL';
	Arquivos_PAF[28]:='FINANCEIRO.BPL';
	Arquivos_PAF[29]:='IMOVEIS.BPL';
    Arquivos_PAF[30]:='INTERFACEEPSON.DLL';
	Arquivos_PAF[31]:='INTERLOJAS.BPL';
    Arquivos_PAF[32]:='LEBIN.DLL';
	Arquivos_PAF[33]:='LEITURA.DLL';
    Arquivos_PAF[34]:='LEITURAMFDBIN.DLL';
	Arquivos_PAF[35]:='LIVROSFISCAIS.BPL';
	Arquivos_PAF[36]:='MONTAGENS.BPL';
	Arquivos_PAF[37]:='PRODUCAO.BPL';
	Arquivos_PAF[38]:='REPOSITORIO.BPL';
	Arquivos_PAF[39]:='SAC.BPL';
	Arquivos_PAF[40]:='SWMFD.DLL';
	Arquivos_PAF[41]:='TECLUX.EXE';
	Arquivos_PAF[42]:='UNINFE.EXE';
	Arquivos_PAF[43]:='VENDAS.BPL';
	Arquivos_PAF[44]:='ZPDLL.DLL';

    ACBrEad := TACBrEAD.Create(ACBrEad);

    for i := 0 to High(Arquivos_PAF) do
    begin
      if(FileExists(Arquivos_PAF[i])) then
      begin
        aMD5 := ACBrEad.MD5FromFile(Arquivos_PAF[i]);
        WriteLn(Arquivo, 'N3'+  preenchestring(Arquivos_PAF[i], ' ', 50, True) + aMD5);
        inc(NArquivos);
      end;
    end;

{    Ret := FindFirst(ExtractFilePath(Application.ExeName)+'*.exe', faAnyFile, F);
    try
      while Ret = 0 do
      begin
        if F.Attr and faDirectory <> faDirectory then
        begin
          NomeArq := ExtractFilePath(Application.ExeName)+F.Name;
          aMD5 := ACBrEad.MD5FromFile(NomeArq);
          WriteLn(Arquivo, 'N3'+  preenchestring(ExtractFileName(UpperCase(NomeArq)), ' ', 50, True) + aMD5);
          inc(NArquivos);
        end;
        Ret := FindNext(F);
      end;

    finally
      FindClose(F);
    end;
}

    WriteLn(Arquivo,
        'N9' + preenchestring(ParSistema.CNPJDesenvolvedora,'0',14,False)+
               preenchestring(ParSistema.IEDesenvolvedora  ,' ',14,True )+
               preenchestring(inttostr(narquivos),'0',6,False ));

    Closefile(Arquivo);
    ACBrEad.OnGetChavePrivada:=dtmMenuFiscal.ACBrEAD1GetChavePrivada;
    ACBrEad.AssinarArquivoComEAD(ArqTexto);
    ParSistema.CodigoMD5 :=  ACBrEad.MD5FromFile(ArqTexto);;

end;

function DefinirPastasNFE: Boolean;
var
  ArquivoCFG: TIniFile;
  vArquivoXMLUninfe: String;
  Barra, strTrabalhaComoProducao: String;

  Arq: TextFile;

  Linha,
  Conteudo, Tag: String;
  PosI, PosF: Integer;


begin
  result := true;

  Barra := '\';

  if ParamCount >= 1 then
    NomeArquivoCFG  := ParamStr(1) + Barra + ctNomeArquivoCFG
  else
    NomeArquivoCFG  := ExtractFilePath(Application.ExeName)+ ctNomeArquivoCFG;

  if FileExists(NomeArquivoCFG) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try


      if ArquivoCFG.SectionExists(NFeEntradaSection) then
        FNFeDirNotasEntrada := ArquivoCFG.ReadString(NFeEntradaSection, 'DirNotasEntrada'    , ExtractFilePath(Application.ExeName) + 'NFeEntradaXML');

      if ArquivoCFG.SectionExists(NFeSection) then
      begin

        if fileExists(FNFeExecNFe) then
        begin

          vArquivoXMLUninfe := Extractfilepath(FNFeExecNFe)+fcnpjfilialbase+'\UniNfeConfig.xml';

          if fileExists(vArquivoXMLUninfe) then
          begin
            AssignFile(Arq, vArquivoXMLUninfe);
            FileMode := 0;
            Reset(Arq);
            repeat
              Readln(Arq, Linha);
              Conteudo := Conteudo + Linha;
            until Eof(Arq);
            CloseFile(Arq);

            Tag := 'PastaXmlEnvio';
            PosI := Pos('<'+Tag+'>',Conteudo)+Length(Tag)+2;
            PosF := Pos('</'+Tag+'>',Conteudo);
            FNFeDirEnvio := Copy(Conteudo,PosI,PosF-PosI);

            Tag := 'PastaXmlRetorno';
            PosI := Pos('<'+Tag+'>',Conteudo)+Length(Tag)+2;
            PosF := Pos('</'+Tag+'>',Conteudo);
            FNFeDirRetorno := Copy(Conteudo,PosI,PosF-PosI);

            Tag := 'PastaXmlEnviado';
            PosI := Pos('<'+Tag+'>',Conteudo)+Length(Tag)+2;
            PosF := Pos('</'+Tag+'>',Conteudo);
            FNFeDirEnviados := Copy(Conteudo,PosI,PosF-PosI);
            if FNFeDirEnviados <> '' then
              FNFeDirEnviados := FNFeDirEnviados + '\Autorizados';

            Tag := 'PastaXmlErro';
            PosI := Pos('<'+Tag+'>',Conteudo)+Length(Tag)+2;
            PosF := Pos('</'+Tag+'>',Conteudo);
            FNFeDirErros := Copy(Conteudo,PosI,PosF-PosI);

          end;

          if parsistema.emissornfe OR
             parsistema.Emissor_de_NFC_e then
            if (not fileExists(vArquivoXMLUninfe)) or
               (FNFeDirEnvio='') or
               (FNFeDirRetorno='') or
               (FNFeDirEnviados='') or
               (FNFeDirErros='') or
               (FNFeDirCompartilha='') then
            begin

              if MensagemConfirmacao('Atenção entre em contato com o suporte!' + chr(13) +
                         'A definição das pastas no UNINFE não estão configuradas corretamente para o CNPJ: '+fcnpjfilialbase) = smbOK then
                result := true
              else
                result := false;
            end;
        end
        else
        begin

          FNFeDirEnvio        := ArquivoCFG.ReadString (NFeSection, 'DirEnvio'    , ExtractFilePath(Application.ExeName) + 'envio');
          FNFeDirRetorno      := ArquivoCFG.ReadString (NFeSection, 'DirRetorno'  , ExtractFilePath(Application.ExeName) + 'retorno');
          FNFeDirEnviados     := ArquivoCFG.ReadString (NFeSection, 'DirEnviados' , ExtractFilePath(Application.ExeName) + 'enviados');
          FNFeDirErros        := ArquivoCFG.ReadString (NFeSection, 'DirErros'    , ExtractFilePath(Application.ExeName) + 'erros');

        end;
      end;

    finally
      ArquivoCFG.Free
    end;

  end
  else
  begin
    MensagemErro(Format(ctERRORARQUIVOCFGNAOENCONTRADO, [NomeArquivoCFG]));
    Result := False
  end;

end;

function LerArquivoCFG(NotificarSplash: TtecProcParametroString = nil;
               PacotesBasicos: boolean = false): Boolean;
var
  ArquivoCFG: TIniFile;
  strFilialBase,
  Host,
  Banco,
  Porta,
  ModeloImpCheque,
  TipoPorta,
  NumeroPorta,
  strFrenteCaixa {,
  vArquivoXMLUninfe}: String;
  Pacotes: TStringList;
  ImpChequeClass: TtecImpressoraChequePadraoClass;
  Barra, strTrabalhaComoProducao: String;
{  Arq: TextFile;}

  {
  Linha,
  Conteudo, Tag: String;
  PosI, PosF: Integer;
  }


begin
{$IFDEF LINUX}
  Barra := '/';
{$ELSE }
  Barra := '\';
{$ENDIF}

  RegisterClasses([{TtecECFBematech, TtecECFMecaf, TtecECFDaruma, TtecECFElgin,
                   TtecECFSweda, TtecECFEpson,}
                   TtecImpChequeBematech, TtecImpChequeTSP]);

  if ParamCount >= 1 then
  begin
    NomeArquivoCFG  := ParamStr(1) + Barra + ctNomeArquivoCFG;
    NomeArquivoECFs := ParamStr(1) + Barra + ctNomeArquivoECFs;
  end
  else
  begin
    NomeArquivoCFG  := ExtractFilePath(Application.ExeName) + ctNomeArquivoCFG;
    NomeArquivoECFs := ExtractFilePath(Application.ExeName) + ctNomeArquivoECFs;
  end;

  if FileExists(NomeArquivoCFG) then
  begin
    ArquivoCFG := TIniFile.Create(NomeArquivoCFG);
    try
{$IFDEF LINUX}
      ArquivoCFG.CaseSensitive := False;
{$ENDIF}
      Pacotes := TStringList.Create;
      try


       if ArquivoCFG.SectionExists(BlocoXSection)  then
         ParSistema.TransmitirBlocoX := ArquivoCFG.ReadBool(BlocoXSection, 'TransmitirBlocoX',False);

       if ArquivoCFG.SectionExists(AutenticacaoSection)  then
       begin
         ParSistema.AutenticarECF := ArquivoCFG.ReadBool(AutenticacaoSection, 'autenticarecf',False);
         ParSistema.Autenticadora := ArquivoCFG.ReadInteger(AutenticacaoSection, 'autenticadora',3);
       end;

       if ArquivoCFG.SectionExists(ImpressoraSection) then
       begin
         ParSistema.ImpressaoCarneECF      := ArquivoCFG.ReadBool(ImpressoraSection, 'imprimircarneecf',False);
         ParSistema.ImprimirLineFeednaImpressoraMatricial := ArquivoCFG.ReadBool(ImpressoraSection, 'imprimirlinefeednaimpressoramatricial',False);
         ParSistema.ImprimirRecibospeloFastReport := ArquivoCFG.ReadBool(ImpressoraSection, 'Imprimir recibos pelo FastReport',False);
         parsistema.NomeImpressoraNotaMercadorias     := ArquivoCFG.ReadString(ImpressoraSection, 'notafiscal', '');
         parsistema.NomeImpressoraNFCe     := ArquivoCFG.ReadString(ImpressoraSection, 'NFCe', '');
         parsistema.NomeImpressoraNotaServicos     := ArquivoCFG.ReadString(ImpressoraSection, 'notafiscalservicos', '');

         parsistema.NomeImpressoraContrato := ArquivoCFG.ReadString(ImpressoraSection, 'contrato', '');
         parsistema.NomeImpressoraCarne    := ArquivoCFG.ReadString(ImpressoraSection, 'carne', '');
         parsistema.NomeImpressoraBoleto   := ArquivoCFG.ReadString(ImpressoraSection, 'boleto', '');
         ParSistema.NomeImpressoraFechamentoCaixa := ArquivoCFG.ReadString(ImpressoraSection, 'fechamentocaixa', '');

         ParSistema.NomeImpressoraOSP := ArquivoCFG.ReadString(ImpressoraSection, 'OSP', '');
         ParSistema.NomeImpressoraSetupProcesso := ArquivoCFG.ReadString(ImpressoraSection, 'SetupProcesso', '');
         ParSistema.NomeImpressoraControleProcesso := ArquivoCFG.ReadString(ImpressoraSection, 'ControleProcesso', '');
       end
       else
       begin
         ParSistema.ImpressaoCarneECF      := False;
         parsistema.NomeImpressoraNotaMercadorias     := ctImpDefault;
         parsistema.NomeImpressoraNFCe     := ctImpDefault;
         parsistema.NomeImpressoraNotaServicos     := ctImpDefault;
         parsistema.NomeImpressoraContrato := ctImpDefault;
         parsistema.NomeImpressoraCarne    := ctImpDefault;
         parsistema.NomeImpressoraBoleto   := ctImpDefault;
         ParSistema.NomeImpressoraFechamentoCaixa := ctImpDefault;
         ParSistema.NomeImpressoraOSP := ctImpDefault;
         ParSistema.NomeImpressoraSetupProcesso := ctImpDefault;
         ParSistema.NomeImpressoraControleProcesso := ctImpDefault;
       end;

       {Parâmetros utilizados pelo PAF-ECF}
       if ArquivoCFG.SectionExists(Empresa_DesenvolvedoraSection) then
       begin
         ParSistema.NomeEmpresaDesenvolvedora :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'NomeEmpresaDesenvolvedora', ''));

         ParSistema.CNPJDesenvolvedora        :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'CNPJDesenvolvedora', ''));

         ParSistema.IEDesenvolvedora          :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'IEDesenvolvedora', ''));

         ParSistema.IMDesenvolvedora          :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'IMDesenvolvedora', ''));

         ParSistema.NomeComercialSistema      :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'NomeComercialSistema', ''));

         ParSistema.VersaoPAFECF              := '3.00';
         {Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'VersaoPAFECF', ''));}

//         ParSistema.CodigoMD5                 :=
//           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'CodigoMD5', ''));

         Parsistema.NumeroCredenciamento      := '1806900016467'; //'1806900016211';
//           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'NumeroCredenciamento',''));

         ParSistema.LaudoPAFECF               := 'UNS0532018'; 
           {Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'LaudoPAFECF', ''));}

          try
          ParSistema.DataLaudoPAFECF               := strtodatetime('06/12/2018/');
          
         {ParSistema.DataLaudoPAFECF               :=
           strtodatetime(Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'DataLaudoPAFECF','')));}
          except
          end;

         ParSistema.Endereco1Desenvolvedora   :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'Endereco1', ''));

         ParSistema.Endereco2Desenvolvedora   :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'Endereco2', ''));

         ParSistema.TelefoneDesenvolvedora    :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'Telefone', ''));

         ParSistema.ContatoDesenvolvedora     :=
           Descriptografar(ArquivoCFG.ReadString(Empresa_DesenvolvedoraSection, 'Contato', ''));
       end;


        if ArquivoCFG.SectionExists(TipoImpEtiquetaSection) then begin
          parsistema.TipoImpressoraEtiqueta := ArquivoCFG.ReadString(TipoImpEtiquetaSection, 'tipo', '');
          parsistema.NomeImpressoraEtiqueta := ArquivoCFG.ReadString(TipoImpEtiquetaSection, 'impressora', '');
          parsistema.intensidadeimpressaozebra := ArquivoCFG.ReadInteger(TipoImpEtiquetaSection, 'Intensidade de impressão zebra', 0);
        end
        else begin
          parsistema.TipoImpressoraEtiqueta := ctNENHUMA;
          parsistema.NomeImpressoraEtiqueta := ''; //ctImpDefault;
          parsistema.intensidadeimpressaozebra := 0;
        end;

        ImpChequePadrao := nil;
        if ArquivoCFG.SectionExists(IMPCHQSection) then begin
          ModeloImpCheque := ArquivoCFG.ReadString(IMPCHQSection, 'marca', '');
          TipoPorta       := ArquivoCFG.ReadString(IMPCHQSection, 'tipoporta', '0');
          NumeroPorta     := ArquivoCFG.ReadString(IMPCHQSection, 'numeroporta', '');
          ImpChequeClass := TtecImpressoraChequePadraoClass(GetClass('TtecImpCheque'+ModeloImpCheque));
          if Assigned(ImpChequeClass) then begin
            ImpChequePadrao := ImpChequeClass.Create;
            if uppercase(TipoPorta) = 'SERIAL' then
              ImpChequePadrao.PortaImpressao := pisSERIAL
            else if uppercase(TipoPorta) = 'PARALELA' then
              ImpChequePadrao.PortaImpressao := pisPARALELA;
            ImpChequePadrao.NumeroPorta := StrToInt(NumeroPorta);
          end
        end;
        if ArquivoCFG.SectionExists(FrenteCaixaSection) then begin
          strFrenteCaixa := ArquivoCFG.ReadString(FrenteCaixaSection, 'trabalharcomo', '');
          ehFrenteCaixa    := strFrenteCaixa = 'sim';
        end;

        if ArquivoCFG.SectionExists(NFeSection) then
        begin
          FNFeAmbiente        := ArquivoCFG.ReadInteger(NFeSection, 'Ambiente'    , 2);
          FNFeTipoEmissao     := ArquivoCFG.ReadInteger(NFeSection, 'TipoEmissao' , 1);

          FNFeNVias           := ArquivoCFG.ReadInteger(NFeSection, 'NumVias'     , 1);

          FNFeExecDANFE       := ArquivoCFG.ReadString (NFeSection, 'ExecDANFE', 'c:\unimake\uninfe\unidanfe.exe');
          FNFeModeloDANFE     := ArquivoCFG.ReadString (NFeSection, 'ModeloDANFE', '');
          FNFeVisualizarDANFE := ArquivoCFG.ReadInteger(NFeSection, 'Visualizar'  , 0) = 1;//ArquivoCFG.ReadBool(NFeSection, 'Visualizar', False);
          FNFeVisualizarDANFEVendasOperacoes := ArquivoCFG.ReadInteger(NFeSection, 'VisualizarVendasOperações'  , 0) = 1;//ArquivoCFG.ReadBool(NFeSection, 'Visualizar', False);
          FSimplificada       :=  ArquivoCFG.ReadInteger(NFeSection, 'Simplificada'  , 0) = 1;

          FNFeLogotipoDANFE   := ArquivoCFG.ReadString (NFeSection, 'Logotipo'    , '');
          FNFeExecNFe         := ArquivoCFG.ReadString (NFeSection, 'ExecNFe', '');

          {
          vArquivoXMLUninfe := Extractfilepath(FNFeExecNFe)+fcnpjfilialbase+'\UniNfeConfig.xml';

          if fileExists(vArquivoXMLUninfe) then
          begin
            AssignFile(Arq, vArquivoXMLUninfe);
            FileMode := 0;
            Reset(Arq);
            repeat
              Readln(Arq, Linha);
              Conteudo := Conteudo + Linha;
            until Eof(Arq);
            CloseFile(Arq);

            Tag := 'PastaXmlEnvio';
            PosI := Pos('<'+Tag+'>',Conteudo)+Length(Tag)+2;
            PosF := Pos('</'+Tag+'>',Conteudo);
            FNFeDirEnvio := Copy(Conteudo,PosI,PosF-PosI);

            Tag := 'PastaXmlRetorno';
            PosI := Pos('<'+Tag+'>',Conteudo)+Length(Tag)+2;
            PosF := Pos('</'+Tag+'>',Conteudo);
            FNFeDirRetorno := Copy(Conteudo,PosI,PosF-PosI);

            Tag := 'PastaXmlEnviado';
            PosI := Pos('<'+Tag+'>',Conteudo)+Length(Tag)+2;
            PosF := Pos('</'+Tag+'>',Conteudo);
            FNFeDirEnviados := Copy(Conteudo,PosI,PosF-PosI);
            if FNFeDirEnviados <> '' then
              FNFeDirEnviados := FNFeDirEnviados + '\Autorizados';

            Tag := 'PastaXmlErro';
            PosI := Pos('<'+Tag+'>',Conteudo)+Length(Tag)+2;
            PosF := Pos('</'+Tag+'>',Conteudo);
            FNFeDirErros := Copy(Conteudo,PosI,PosF-PosI);

            Tag := 'PastaBackup';
            PosI := Pos('<'+Tag+'>',Conteudo)+Length(Tag)+2;
            PosF := Pos('</'+Tag+'>',Conteudo);
            FNFeDirCompartilha := Copy(Conteudo,PosI,PosF-PosI);

          end
          else
          begin
            if parsistema.emissornfe then
              MensagemErro('Atenção entre em contato com o suporte!'+chr(13)+
                           'A definição das pastas no UNINFE não estão configuradas corretamente para o CNPJ: '+fcnpjfilialbase);
          end;

          }
          {
          FNFeDirEnvio        := ArquivoCFG.ReadString (NFeSection, 'DirEnvio'    , ExtractFilePath(Application.ExeName) + 'envio');
          FNFeDirRetorno      := ArquivoCFG.ReadString (NFeSection, 'DirRetorno'  , ExtractFilePath(Application.ExeName) + 'retorno');
          FNFeDirEnviados     := ArquivoCFG.ReadString (NFeSection, 'DirEnviados' , ExtractFilePath(Application.ExeName) + 'enviados');
          FNFeDirErros        := ArquivoCFG.ReadString (NFeSection, 'DirErros'    , ExtractFilePath(Application.ExeName) + 'erros');
          }

          FNFeDirCompartilha  := ArquivoCFG.ReadString (NFeSection, 'DirComp'     , ExtractFilePath(Application.ExeName) + 'compartilhamento');

        end;

        if ArquivoCFG.SectionExists('NFCe') then
        begin
          ParSistema.DataHoraInicialContingenciaNFCe   := ArquivoCFG.ReadString(NFeSection, 'DataHoraInicialContingenciaNFCe', '');
          ParSistema.RazaoContingenciaNFCe   := ArquivoCFG.ReadString(NFeSection, 'RazaoContingenciaNFCe', '');
          Parsistema.TempoEsperaNFCe := ArquivoCFG.ReadInteger(NFeSection, 'TempoEsperaNFCe', 15);
        end;

        if ArquivoCFG.SectionExists(NFeEntradaSection) then
          FNFeDirNotasEntrada := ArquivoCFG.ReadString(NFeEntradaSection, 'DirNotasEntrada'    , ExtractFilePath(Application.ExeName) + 'NFeEntradaXML');


        if ArquivoCFG.SectionExists(ReinfSection) then
          FReinfAmbiente        := ArquivoCFG.ReadInteger(ReinfSection, 'Ambiente'    , 2);

        if ArquivoCFG.SectionExists(PAFECFSetion) then
        begin
          fCertificadoDigital := ArquivoCFG.ReadString (PAFECFSetion, 'Certificado', '');
        end;

        if ArquivoCFG.SectionExists(NFSeSection) then
        begin
          FNFSeAmbiente        := ArquivoCFG.ReadInteger(NFSeSection, 'Ambiente'    , 2);

//          FNFeTipoEmissao     := ArquivoCFG.ReadInteger(NFeSection, 'TipoEmissao' , 1);

//          FNFeNVias           := ArquivoCFG.ReadInteger(NFeSection, 'NumVias'     , 1);

//          FNFeDirEnvio        := ArquivoCFG.ReadString (NFeSection, 'DirEnvio'    , ExtractFilePath(Application.ExeName) + 'envio');
//          FNFeDirRetorno      := ArquivoCFG.ReadString (NFeSection, 'DirRetorno'  , ExtractFilePath(Application.ExeName) + 'retorno');

          FNFSeDirEnvio        := ArquivoCFG.ReadString (NFSeSection, 'DirEnvio'    , ExtractFilePath(Application.ExeName) + 'envio');
          FNFSeDirRetorno      := ArquivoCFG.ReadString (NFSeSection, 'DirRetorno'  , ExtractFilePath(Application.ExeName) + 'retorno');
          FNFSeDirErro        := ArquivoCFG.ReadString (NFSeSection, 'DirErros'    , ExtractFilePath(Application.ExeName) + 'erros');
          fCertificadoDigitalNFSe := ArquivoCFG.ReadString (NFSeSection, 'CertificadoNFSe', '');

//          FNFeDirEnviados     := ArquivoCFG.ReadString (NFeSection, 'DirEnviados' , ExtractFilePath(Application.ExeName) + 'enviados');
//          FNFeDirErros        := ArquivoCFG.ReadString (NFeSection, 'DirErros'    , ExtractFilePath(Application.ExeName) + 'erros');

          FNFeDirCompartilha  := ArquivoCFG.ReadString (NFeSection, 'DirComp'     , ExtractFilePath(Application.ExeName) + 'compartilhamento');
//          FNFeLogotipoDANFE   := ArquivoCFG.ReadString (NFeSection, 'Logotipo'    , '');
//          FNFeExecNFe         := ArquivoCFG.ReadString (NFeSection, 'ExecNFe'  , 'c:\unimake\uninfe\uninfe.exe');

          FNFSeExecNFSe       := ArquivoCFG.ReadString (NFSeSection, 'ExecNFSe', '');

          FNFSeExecDANFE       := ArquivoCFG.ReadString (NFSeSection, 'ExecDANFE', 'c:\unimake\uninfse\unidanfe.exe');
          FNFSeVisualizarDANFE := ArquivoCFG.ReadInteger(NFSeSection, 'Visualizar'  , 0) = 1;//ArquivoCFG.ReadBool(NFeSection, 'Visualizar', False);
        end;


        if ArquivoCFG.SectionExists(PCPSection) then
          FPCPDirExportacao   := ArquivoCFG.ReadString (PCPSection, 'DirExp'      , ExtractFilePath(Application.ExeName) + 'Saidas');

        if ArquivoCFG.SectionExists(SpedSection) then
        begin
          FSpedFiscalDir      := ArquivoCFG.ReadString(SpedSection, 'DirSpedFiscal',       ExtractFilePath(Application.ExeName) + 'Saidas');
          FSpedContabilDir    := ArquivoCFG.ReadString(SpedSection, 'DirSpedContabil',     ExtractFilePath(Application.ExeName) + 'Saidas');
          FSpedFContDir       := ArquivoCFG.ReadString(SpedSection, 'DirSpedFCont',        ExtractFilePath(Application.ExeName) + 'Saidas');
          FEFDContribuicoesDir:= ArquivoCFG.ReadString(SpedSection, 'DirEFDContribuições', ExtractFilePath(Application.ExeName) + 'Saidas');
        end;

        if ArquivoCFG.SectionExists(ExportacaoSection) then
          fExportacaoDir   := ArquivoCFG.ReadString (ExportacaoSection, 'DirExportação', ExtractFilePath(Application.ExeName) + 'Saidas');

        if FPCPDirExportacao='' then
          FPCPDirExportacao   := ExtractFilePath(Application.ExeName) + 'Saidas';

        Notificar(NotificarSplash, '');
        ArquivoCFG.ReadSectionValues(ModulosSection, Pacotes);
        if Not CarregarModulos(Pacotes, PacotesBasicos) then
          MensagemErro(Format(ctERROTECSOFTLOCAL, [ANSIUpperCase(NomeArquivoCFG)]));
      finally
        Pacotes.Free;
      end;

      if PacotesBasicos then
      begin
        UsuarioPadrao := ArquivoCFG.ReadString(LoginSection, 'UsuarioPadraoSefaz', '');
        SenhaPadrao   := Descriptografar(ArquivoCFG.ReadString(LoginSection, 'SenhaPadraoSefaz', ''));

        if (UsuarioPadrao='') and (SenhaPadrao='') then
        begin
          UsuarioPadrao := ArquivoCFG.ReadString(LoginSection, 'UsuarioPadrao', '');
          SenhaPadrao   := ArquivoCFG.ReadString(LoginSection, 'SenhaPadrao', '');
        end;

        ArquivoCFG.DeleteKey(LoginSection, 'UsuarioPadraoSefaz');
        ArquivoCFG.DeleteKey(LoginSection, 'SenhaPadraoSefaz');
      end
      else
      begin
        UsuarioPadrao := ArquivoCFG.ReadString(LoginSection, 'UsuarioPadrao', '');
        SenhaPadrao   := ArquivoCFG.ReadString(LoginSection, 'SenhaPadrao', '');

        {Uso temporario quando o sistema é reinicializado pela perda da conexao}

        if (UsuarioPadrao='') and (SenhaPadrao='') then
        begin
          UsuarioPadrao := ArquivoCFG.ReadString(LoginSection, 'UsuarioPadraoSefaz', '');
          SenhaPadrao   := Descriptografar(ArquivoCFG.ReadString(LoginSection, 'SenhaPadraoSefaz', ''));
          ArquivoCFG.DeleteKey(LoginSection, 'UsuarioPadraoSefaz');
          ArquivoCFG.DeleteKey(LoginSection, 'SenhaPadraoSefaz');
        end;


      end;


      Host          := ArquivoCFG.ReadString(LoginSection, 'Host', '');
      Banco         := ArquivoCFG.ReadString(LoginSection, 'Banco', '');
      vLogHabilitado := ArquivoCFG.ReadBool(LoginSection, 'LogHabilitado', false);
      vLogEcf := ArquivoCFG.ReadBool(LoginSection, 'LogEcf', false);
      vLogMessageFrenteCaixa := ArquivoCFG.ReadBool(LoginSection, 'LogMessageFrenteCaixa', false);
      Porta         := ArquivoCFG.ReadString(LoginSection, 'Porta', '5432');
      strFilialBase := ArquivoCFG.ReadString(LoginSection, 'FilialBase', '');
      FComUsuario   := ANSIUpperCase(ArquivoCFG.ReadString(LoginSection, 'usuario', '')) = 'SIM';
      ParSistema.MaxColAutenticadora := ArquivoCFG.ReadInteger(LoginSection, 'MaxColAutenticadora', 48);

      if (strFilialBase <> '') and (Host <> '') and (Banco <> '') then
        try
          FFilialBase := StrToInt(strFilialBase);
          TdtmTecSoft.ConfigurarConexao(Host, Banco, Porta);
          Result := True
        except
          Result := False
        end
      else begin
        MensagemErro(Format(ctERRORARQUIVOCFGINVALIDO, [NomeArquivoCFG]));
        Result := False
      end

    finally
      ArquivoCFG.Free
    end;
  end else begin
    MensagemErro(Format(ctERRORARQUIVOCFGNAOENCONTRADO, [NomeArquivoCFG]));
    Result := False
  end;

end;


