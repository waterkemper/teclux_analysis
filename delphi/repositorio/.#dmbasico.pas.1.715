                  produtos.fieldbyname('icmsbasecalculo').AsCurrency := produtos.fieldbyname('icmsbasecalculo').AsCurrency + vDiferenca;
                  produtos.post;
                  vbaseicms := notas.fieldbyname('baseicms').ascurrency;
                  break;
                end;
                produtos.prior;
              end;
            end;
