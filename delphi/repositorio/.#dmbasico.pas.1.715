  qrylogotipos.First;
  if not qryLogotipos.IsEmpty then
    result := ParSistema.DiretorioImagens+qrylogotipos.Fields[0].AsString
  else
    result := ParSistema.DiretorioImagens+'tecsoft.bmp';
  if not FileExists(result) then
    result := ExtractFilePath(application.exename)+'tecsoft.bmp';
  qryLogotipos.Close;
end;
}

