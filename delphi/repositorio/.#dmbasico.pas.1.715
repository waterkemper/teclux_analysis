                  Append('<td align=right class=linhameio><font class="fontnormal">' +
                           FormatFloat('#0,' + ThousandSeparator + '00',
                                              (qryServicosContratos.FieldByName('quantidade').AsInteger * qryServicosContratos.FieldByName('valorservico').AsCurrency)) + '</font></td>');
                  Append('</tr>');

                  Soma:= Soma + (qryServicosContratos.FieldByName('quantidade').AsInteger * qryServicosContratos.FieldByName('valorservico').AsCurrency);
                  qryServicosContratos.Next;
                end;

                Append('<tr height=0>');
