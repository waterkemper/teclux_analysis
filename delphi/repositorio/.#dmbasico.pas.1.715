class procedure TdtmBasico.AtribuirParametrosBaseRelatorio(
  Filial: String);
var
  SQL: String;
  qryVerificarFilialBase: TtecQuery;
  rua: String;
begin
  if filial = inttostr(FFilialBase) then
     AtribuirParametrosBaseRelatorio
  else
  begin
    qryVerificarFilialBase := TtecQuery.Create(nil);
    qryVerificarFilialBase.Database := dtmTecSoft.Database;
    SQL := Format(VerificarFilialBaseSQL, [Filial]);
    qryVerificarFilialBase.Sql.Text := SQL;
    qryVerificarFilialBase.Open;
    if qryVerificarFilialBase.RecordCount > 0 then begin
      frVariables['RazaoFilialBase'] := qryVerificarFilialBase.Fieldbyname('razao').AsString;
      Rua := qryVerificarFilialBase.Fieldbyname('rua').AsString;

      if qryVerificarFilialBase.Fieldbyname('numero').AsString<>'' then
        rua := rua + ', '+qryVerificarFilialBase.Fieldbyname('numero').AsString;
      if qryVerificarFilialBase.Fieldbyname('complemento').AsString<>'' then
        rua := rua + ', '+qryVerificarFilialBase.Fieldbyname('complemento').AsString;


      frVariables['RuaFilialBase']   := rua;
      frVariables['BairroFilialBase']:= qryVerificarFilialBase.Fieldbyname('NomeBairro').AsString;
      frVariables['CepFilialBase']   := FormatarCEP(qryVerificarFilialBase.Fieldbyname('cep').AsString);
      frVariables['CidadeFilialBase']:= qryVerificarFilialBase.Fieldbyname('NomeCidade').AsString;
      frVariables['EstadoFilialBase']:= qryVerificarFilialBase.Fieldbyname('estado').AsString;
      frVariables['FoneFilialBase']  := qryVerificarFilialBase.Fieldbyname('fonenumero').AsString;
      frVariables['CNPJFilialBase']  := FormatarCPFouCGC(qryVerificarFilialBase.Fieldbyname('cnpj').AsString);
      frVariables['IEFilialBase']  := qryVerificarFilialBase.Fieldbyname('inscricaoestadual').AsString;
      frVariables['IMFilialBase']  := qryVerificarFilialBase.Fieldbyname('inscricaomunicipal').AsString;

      frVariables['Razao']  := qryVerificarFilialBase.Fieldbyname('razao').AsString;
      frVariables['CNPJ']   := FormatarCPFouCGC(qryVerificarFilialBase.Fieldbyname('cnpj').AsString);
      frVariables['InscricaoEstadual']:= qryVerificarFilialBase.Fieldbyname('inscricaoestadual').AsString;
      frVariables['InscricaoMunicipal']  := qryVerificarFilialBase.Fieldbyname('inscricaomunicipal').AsString;

      frVariables['Rua']   := rua;
      frVariables['Bairro']:= qryVerificarFilialBase.Fieldbyname('NomeBairro').AsString;
      frVariables['Cep']:= FormatarCEP(qryVerificarFilialBase.Fieldbyname('cep').AsString);
//    frVariables['Cidade']:= FormatarCEP(qryVerificarFilialBase.Fieldbyname('cep').AsString)+' - '+qryVerificarFilialBase.Fieldbyname('NomeCidade').AsString+ ' - ' + qryVerificarFilialBase.Fieldbyname('estado').AsString;
      frVariables['Cidade']:= qryVerificarFilialBase.Fieldbyname('NomeCidade').AsString;
      frVariables['Estado']:= qryVerificarFilialBase.Fieldbyname('estado').AsString;
      frVariables['Junta']:= qryVerificarFilialBase.Fieldbyname('junta').AsString;
      frVariables['JuntaData']:= qryVerificarFilialBase.Fieldbyname('juntadata').AsString;
    end;
    qryVerificarFilialBase.Close
  end;
end;

function TdtmBasico.FiltrarComposto(Composto: Boolean;
  Situacao: TtecComposicao): boolean;
begin
  Result := Composto;
  case situacao of
    stCOMPOSTO    : result := composto;
    stNAOCOMPOSTO : result := not composto;
  end;
end;



function TdtmBasico.ValidarImpostosRetidos(irretido, inssretido,
                                 issretido, pisretido,
                                 cofinsretido, csllretido, piscofinscsllretido: Currency;
                                 TabelaLancamentos,
                                 TabelaLanctosFiliais: TtecQuery): boolean;

  function ValidarValor(Tipo: TtecLancamentosContasEntradas):boolean;
  var
   descricaoconta : String;
  begin
    result := false;
    descricaoconta := FilialContasEntradas[Tipo];
    if TabelaLanctosFiliais.Locate('descricao',descricaoconta ,[]) then
    begin
      descricaoconta := TabelaLanctosFiliais.fieldbyname('descricaocontacontabil').Asstring;

      if descricaoconta='' then
        descricaoconta := FilialContasEntradas[Tipo];

      if TabelaLancamentos.Locate('contacontabil', TabelaLanctosFiliais.fieldbyname('contacontabil').AsInteger, []) then
        result := TabelaLancamentos.FieldByName('valorcredito').ascurrency<>0;
      if not result then
        MensagemErro(format(ctLANCAMENTOOBRIGATORIO,[ANSIUpperCase(descricaoconta),ANSIUpperCase(ctcredito)]));
    end
    else
      MensagemErro(format(ctCONTAPADRAONAOVINCULADA,[ANSIUpperCase(descricaoconta)]));
  end;

begin
  result := true;
  if irretido<>0 then
    result := ValidarValor(lceIRRetido);

  if result then
    if inssretido<>0 then
      result := ValidarValor(lceINSSRetido);

  if result then
    if issretido<>0 then
      result := ValidarValor(lceISSRetido);

  if result then
    if pisretido<>0 then
      result := ValidarValor(lcePISRetido);

  if result then
    if cofinsretido<>0 then
      result := ValidarValor(lceCOFINSretida);

  if result then
    if csllretido<>0 then
      result := ValidarValor(lceCSLLretida);

  if result then
    if piscofinscsllretido<>0 then
      result := ValidarValor(lcePIS_COFINS_CSLL);

end;

function TdtmBasico.CalcularVenctoImpostoRetidoEntrada(Data: TDateTime;
         quinzenal: boolean; Ate_noDia: String; dia: integer;
         periodo: String;Filial: integer): TDateTime;
const
  SQL = 'select PrimeiroDiaUtil(%s, cast(%s as date), %s, %s)';
var
  vdata: TDateTime;
  qryDiaUtil: TtecQuery;
begin
  vdata := Data;
  if quinzenal then
  begin
    if periodo = 'Quinzena atual' then
    begin
      if dayof(data) <= 15 then
        vdata := encodeDate(yearof(Data),MonthOf(Data),15)
      else
        vdata := encodeDate(yearof(Data),MonthOf(Data),DaysInMonth(Data));
    end
    else
    if periodo = 'Quinzena seguinte' then
    begin
      if dayof(data) <= 15 then
        vdata := encodeDate(yearof(Data), MonthOf(Data), DaysInMonth(Data))
      else
        vdata := encodeDate(yearof(incMonth(Data,1)),monthof(IncMonth(data,1)),15);
    end
  end
  else
  begin
    if periodo = 'Mês atual' then
      vdata := encodeDate(yearof(Data), MonthOf(Data), dia)
    else
    if periodo = 'Mês seguinte' then
      vdata := encodeDate(yearof(incMonth(Data)), MonthOf(incMonth(Data)), dia);
  end;
  qryDiaUtil := TtecQuery.Create(nil);
  qryDiaUtil.Database := dtmTecSoft.Database;

  if Ate_noDia = 'Até o dia' then
    qryDiaUtil.Sql.Text := Format(SQL,[inttostr(Filial),quotedstr(datetostr(vdata)), quotedstr('P'), quotedstr('-')])
  else
  if Ate_noDia = 'No dia' then
    qryDiaUtil.Sql.Text := Format(SQL,[inttostr(Filial),quotedstr(datetostr(vdata)), quotedstr('P'), quotedstr('+')]);

  qryDiaUtil.Open;
  vdata := qryDiaUtil.Fields[0].AsDateTime;
  qryDiaUtil.Free;
  result := vdata;
end;


function TdtmBasico.VerificarImpostosRetidos(previsao: Boolean;
                                      Situacao: SituacaoImpostosRetidos;
                                      qryDocumentosPagImpostosRetidos,
                                      qryDuplicatasImpostosRetidos,
                                      qryContasEntradasFiliais,
                                      qryVenctosImpostosRetidosEntradas,
                                      qrydocumentosPag,
                                      qryDuplicatas,
                                      spcDocumentosPagProximo: TtecQuery;
                                      Origem: TOrigemImpostosRetidos): boolean;
var
  valorimpostorateado: Currency;
  LancamentosContas: TtecLancamentos;
  vRegistroAtualDuplicata : TBookMark;

  function ExistePagamento_DuplicatasImpostosRetido: boolean;
  begin
    result := false;
    qryDuplicatasImpostosRetidos.First;
    while not qryDuplicatasImpostosRetidos.Eof do
    begin
      if (qryDocumentosPagImpostosRetidos.FieldByName('numero').AsInteger =
          qryDuplicatasImpostosRetidos.FieldByName('documentopag').AsInteger) and
         not qryduplicatasImpostosRetidos.FieldByName('datapagto').IsNull then
      begin
        result := true;
        break;
      end;
      qryDuplicatasImpostosRetidos.Next;
    end;
  end;

  function VerificarImpostosRetidosnaDuplicata(ValorImposto: Currency; Tipo: TtecLancamentosContasEntradas): boolean;
  var
    HouveMudancaFatoGeradoreComQuitacao: Boolean;
    HouveMudancaFatoGeradoreSemQuitacao: Boolean;

    function LocalizarDocumentosPagImpostosRetidosDuplicata: Boolean;
    begin
       result := true;
       HouveMudancaFatoGeradoreComQuitacao := false;
       HouveMudancaFatoGeradoreSemQuitacao := false;

       {Verificar se houve mudança nos parâmetros do fato gerador:
        de pagamento duplicata p/ lançamento na nota fiscal}
       qryDocumentosPagImpostosRetidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
       begin
         if (qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo]) then
         begin
           if qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').IsNull then
           begin
             if ExistePagamento_DuplicatasImpostosRetido then
             begin
               HouveMudancaFatoGeradoreSemQuitacao := false;
               HouveMudancaFatoGeradoreComQuitacao := true;
               Result := false;
               break;
             end
             else
             begin
               HouveMudancaFatoGeradoreSemQuitacao := true;
               result := true;
             end;
           end
         end;
         qryDocumentosPagImpostosRetidos.Next;
       end;

       if Result then
       begin
         result := false;
         qryDocumentosPagImpostosRetidos.First;
         while not qryDocumentosPagImpostosRetidos.Eof do
         begin
           if (qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo]) then
           begin
             if not qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').IsNull then
             begin
               if ExistePagamento_DuplicatasImpostosRetido then
               begin
                 result := false;
                 break;
               end
               else
                 result := true;
             end;
           end;
           qryDocumentosPagImpostosRetidos.Next;
         end;
       end;

    end;

     procedure ApagarDocumentosPagImpostosRetidosDuplicata;
     begin
       qryDocumentosPagImpostosRetidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
       begin
         if qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo] then
         begin
           if (qryDocumentosPagImpostosRetidos.FieldByName('datavenctoorigem').AsDateTime =
               qryDuplicatas.FieldByName('DataVenctooriginal').asdatetime) and
              (qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').AsInteger =
               qryduplicatas.FieldByName('numero').Asinteger) and
              (qryDocumentosPagImpostosRetidos.FieldByName('documentopagorigem').AsInteger =
               qryduplicatas.FieldByName('documentopag').Asinteger) then
             qryDocumentosPagImpostosRetidos.Delete
           else
             if HouveMudancaFatoGeradoreSemQuitacao and
               (qryDocumentosPagImpostosRetidos.FieldByName('documentopagorigem').AsInteger =
                qryduplicatas.FieldByName('documentopag').Asinteger) and
                qryDocumentosPagImpostosRetidos.FieldByName('datavenctoorigem').isnull and
                qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').isnull then
               qryDocumentosPagImpostosRetidos.Delete
             else
               qryDocumentosPagImpostosRetidos.Next;
         end
         else
           qryDocumentosPagImpostosRetidos.Next;
       end;
     end;

     procedure AtribuirDocumentosPag;
     begin
       qryDocumentosPagImpostosRetidos.FieldByName('fornecedor').AsInteger := qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('tipofornecedor').AsString := qryVenctosImpostosRetidosEntradas.FieldByName('tipofornecedor').AsString;
       qryDocumentosPagImpostosRetidos.FieldByName('creditar').clear;
       if qryContasEntradasFiliais.Locate('Descricao', FilialContasEntradas[tipo],[]) then
         if qryContasEntradasFiliais.FieldByName('contacontabil').AsInteger <> 0 then
            qryDocumentosPagImpostosRetidos.FieldByName('creditar').AsInteger := qryContasEntradasFiliais.FieldByName('contacontabil').AsInteger;

       qryDocumentosPagImpostosRetidos.FieldByName('emissao').AsDateTime := qryDocumentosPag.FieldByName('emissao').AsDateTime;
       qryDocumentosPagImpostosRetidos.FieldByName('datalancto').AsDateTime := qryDocumentosPag.FieldByName('datalancto').AsDateTime;
       qryDocumentosPagImpostosRetidos.FieldByName('evento').Asvariant := qryDocumentosPag.FieldByName('Evento').AsVariant;
       qryDocumentosPagImpostosRetidos.FieldByName('filialemissao').AsInteger := qryDocumentosPag.FieldByName('filialemissao').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('filialcontabil').AsInteger := qryDocumentosPag.FieldByName('filialcontabil').AsInteger;


       qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString := FilialContasEntradas[tipo];

       qryDocumentosPagImpostosRetidos.FieldByName('valor').AsCurrency := valorimpostorateado;
       qryDocumentosPagImpostosRetidos.FieldByName('documentopagorigem').AsInteger := qryDocumentosPag.FieldByName('Numero').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('datavenctoorigem').AsDateTime  := qryDuplicatas.FieldByName('DataVencto').AsDateTime;
       qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').AsInteger := qryDuplicatas.FieldByName('Numero').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('complemento').AsString := qryDocumentosPag.FieldByName('complemento').AsString;
       qryDocumentosPagImpostosRetidos.FieldByName('previsao').AsBoolean := false;
       qryDocumentosPagImpostosRetidos.FieldByName('fatogerador').AsString := qryVenctosImpostosRetidosEntradas.FieldByName('ocasiao').AsString;
     end;

     procedure AtribuirDuplicatas;
     begin
       qryDuplicatasImpostosRetidos.fieldbyname('documentopag').AsInteger := qryDocumentosPagImpostosRetidos.fieldbyname('numero').AsInteger;
       if qryDuplicatas.fieldByName('datapagto').IsNull then
         qryDuplicatasImpostosRetidos.FieldByName('datavencto').AsDateTime :=
            CalcularVenctoImpostoRetidoEntrada(qryDuplicatas.FieldByName('DataVencto').AsDateTime,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('quinzenal').asboolean,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('parametro_inicial').asstring,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('dia').AsInteger,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('parametro_final').asstring,
                                               qryDocumentosPag.FieldByName('filialemissao').AsInteger
                                               )
       else
         qryDuplicatasImpostosRetidos.FieldByName('datavencto').AsDateTime :=
            CalcularVenctoImpostoRetidoEntrada(qryDuplicatas.FieldByName('datapagto').AsDateTime,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('quinzenal').asboolean,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('parametro_inicial').asstring,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('dia').AsInteger,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('parametro_final').asstring,
                                               qryDocumentosPag.FieldByName('filialemissao').AsInteger
                                               );
       qryDuplicatasImpostosRetidos.FieldByName('numero').AsInteger := 1;
       qryDuplicatasImpostosRetidos.FieldByName('valorvencto').AsCurrency := valorimpostorateado;
       qryDuplicatasImpostosRetidos.FieldByName('evento').AsVariant := qryDocumentosPag.FieldByName('Evento').AsVariant;
       qryDuplicatasImpostosRetidos.FieldByName('tipojuros').AsString := qryDuplicatas.FieldByName('tipojuros').AsString;
       qryDuplicatasImpostosRetidos.FieldByName('tipomulta').AsString := qryDuplicatas.FieldByName('tipomulta').AsString;
       qryDuplicatasImpostosRetidos.FieldByName('autorizado').AsBoolean := qryDuplicatas.FieldByName('autorizado').AsBoolean;
     end;

     function CalcularImpostoRateado(ValorImposto: Currency;
                                     Tipo: TtecLancamentosContasEntradas):Currency;

     var
       valor : currency;
       i: integer;
       TipoNaoCadastrado : Boolean;
     begin
       {
       valor := ValorDoPercentualSobreTotal(ValorImposto,
                                     PercentualDoValorSobreTotal(
                                     qryDocumentosPag.FieldByName('ValorLiquido').AsCurrency,
                                     qryDuplicatas.FieldByName('ValorVencto').AsCurrency));}

       valor := (ValorImposto * qryDuplicatas.FieldByName('ValorVencto').AsCurrency)/qryDocumentosPag.FieldByName('ValorLiquido').AsCurrency;

       TipoNaoCadastrado := true;
       for i := 0 to length(Lancamentoscontas)-1 do
         if tipo = LancamentosContas[i].Lancamento then
         begin
           TipoNaoCadastrado := false;
           LancamentosContas[i].Valor := LancamentosContas[i].Valor + valor;
           if ((ValorImposto - LancamentosContas[i].Valor) <= 0.01) then
              valor  := ValorImposto - LancamentosContas[i].Valor + valor;
         end;

       if TipoNaoCadastrado then
       begin
         i := length(Lancamentoscontas)+1;
         SetLength(Lancamentoscontas, i);
         LancamentosContas[i-1].Lancamento := tipo;
         LancamentosContas[i-1].Valor := valor;
       end;
       result := valor;
     end;

     function posicionarDocumentospagimpostosretidos: Boolean;
     begin
       result := false;
       qryDocumentospagimpostosretidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
         if (qryDocumentosPagImpostosRetidos.FieldByName('datavenctoorigem').AsDateTime =
             qryDuplicatas.FieldByName('DataVenctooriginal').asdatetime) and
            (qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').AsInteger =
             qryduplicatas.FieldByName('numero').Asinteger) and
            (qryDocumentosPagImpostosRetidos.FieldByName('documentopagorigem').AsInteger =
             qryduplicatas.FieldByName('documentopag').Asinteger) and
            (qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString =
             FilialContasEntradas[tipo]) then
         begin
           result := true;
           break;
         end
         else
           qryDocumentospagimpostosretidos.Next;
     end;
  begin
    result := true;
    HouveMudancaFatoGeradoreComQuitacao := false;
    if qryVenctosImpostosRetidosEntradas.Locate('descricao', FilialContasEntradas[tipo], []) then
    begin
      if qryVenctosImpostosRetidosEntradas.FieldByName('ocasiao').AsString = 'No pagto da duplicata' then
      begin
        if qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').AsInteger <> 0 then
        begin

          case situacao of
            VALIDAR:
            begin
              LocalizarDocumentosPagImpostosRetidosDuplicata;
              if HouveMudancaFatoGeradoreComQuitacao then
                result := MensagemConfirmacao(
                    format('O documento gerado ''%s - %s'' esta inconsistente com os parâmetros do sistema.'+#10#13+
                           'Fato gerador configurado: ''No pagamento da duplicata'''+#10#13+
                           'Fato gerador atual: ''No lançto da NF'''+#10#13+
                           'Sugestão: desquite este pagamento e gere novamente acessando o documento original.',
                           [qryDocumentosPagImpostosRetidos.fieldbyname('numero').asstring,
                            FilialContasEntradas[tipo]])) = smbOK;
            end;

            GRAVAR:
            begin
              {Verifica se não existe pagamento para o tipo específico}
              if LocalizarDocumentosPagImpostosRetidosDuplicata then
                {visto que não há pagamentos,
                 Efetua a exclusao para todos do tipo específico
                 dos documentospagimpostosretidos para serem refeitos}
                ApagarDocumentosPagImpostosRetidosDuplicata;

              if not HouveMudancaFatoGeradoreComQuitacao then
              begin
                valorimpostorateado := CalcularImpostoRateado(ValorImposto, Tipo);
                if posicionarDocumentospagimpostosretidos then
                begin
                  if valorimpostorateado <> 0 then
                  begin
                    if  not ExistePagamento_DuplicatasImpostosRetido then
                    begin
                      qryDocumentosPagImpostosRetidos.Edit;
                      AtribuirDocumentosPag;
                      qryDocumentosPagImpostosRetidos.post;
                      qryDuplicatasImpostosRetidos.Edit;
                      AtribuirDuplicatas;
                      qryDuplicatasImpostosRetidos.Post;
                    end;
                  end
                  else
                    qryDocumentosPagImpostosRetidos.Delete;
                end
                else
                begin
                  if valorimpostorateado <> 0 then
                  begin
                    qryDocumentosPagImpostosRetidos.Append;
                    spcDocumentosPagProximo.Open;
                    qryDocumentosPagImpostosRetidos.FieldByName('numero').AsInteger := spcDocumentosPagProximo.FieldByName('codigo').AsInteger;
                    spcDocumentosPagProximo.Close;
                    AtribuirDocumentosPag;
                    qryDocumentosPagImpostosRetidos.Post;
                    qryDuplicatasImpostosRetidos.Append;
                    AtribuirDuplicatas;
                    qryDuplicatasImpostosRetidos.Post;
                  end;
                end;
              end;
            end;

          end;
        end
        else
        begin
          if valorimposto <> 0  then
          begin
            result := false;
            MensagemErro(format(ctFORNECEDORPADRAONAOVINCULADO,[FilialContasEntradas[tipo]]));
          end;
        end;
      end;
    end
    else
    begin
      if valorimposto <> 0  then
      begin
        result := false;
        MensagemErro(format(ctCONTAPADRAONAOVINCULADA,[FilialContasEntradas[tipo]]));
      end;
    end;
  end;

  function VerificarImpostosRetidosnaNotaFiscal(ValorImposto: Currency; Tipo: TtecLancamentosContasEntradas): boolean;
  var
    HouveMudancaFatoGeradoreComQuitacao: Boolean;
    function LocalizarDocumentosPagImpostosRetidosNota: Boolean;

    begin
       result := true;
       HouveMudancaFatoGeradoreComQuitacao := false;

       {Verificar se houve mudança nos parâmetros do fato gerador:
        de lançamento na nota fiscal p/ pagamento duplicata}

       qryDocumentosPagImpostosRetidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
       begin
         if (qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo]) then
         begin
           if not qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').IsNull then
           begin
             if ExistePagamento_DuplicatasImpostosRetido then
             begin
               HouveMudancaFatoGeradoreComQuitacao := true;
               result := false;
               break;
             end
             else
               Result := true;
           end;
         end;
         qryDocumentosPagImpostosRetidos.Next;
       end;

       if result then
       begin
         qryDocumentosPagImpostosRetidos.First;
         while not qryDocumentosPagImpostosRetidos.Eof do
         begin
           if (qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo]) then
           begin
             if qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').IsNull then
             begin
               if ExistePagamento_DuplicatasImpostosRetido then
               begin
                 result := false;
                 break;
               end
               else
                 result := true;
             end
           end;
           qryDocumentosPagImpostosRetidos.Next;
         end;
       end;

    end;


     procedure ApagarDocumentosPagImpostosRetidosNota;
     begin
       qryDocumentosPagImpostosRetidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
       begin
         if qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString = FilialContasEntradas[tipo] then
           qryDocumentosPagImpostosRetidos.Delete
         else
           qryDocumentosPagImpostosRetidos.Next;
       end;
     end;

     procedure AtribuirDocumentosPag;
     begin
       qryDocumentosPagImpostosRetidos.FieldByName('fornecedor').AsInteger := qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('tipofornecedor').AsString := qryVenctosImpostosRetidosEntradas.FieldByName('tipofornecedor').AsString;
       qryDocumentosPagImpostosRetidos.FieldByName('creditar').clear;
       if qryContasEntradasFiliais.Locate('Descricao', FilialContasEntradas[tipo],[]) then
         if qryContasEntradasFiliais.FieldByName('contacontabil').AsInteger <> 0 then
            qryDocumentosPagImpostosRetidos.FieldByName('creditar').AsInteger := qryContasEntradasFiliais.FieldByName('contacontabil').AsInteger;

       qryDocumentosPagImpostosRetidos.FieldByName('emissao').AsDateTime := qryDocumentosPag.FieldByName('emissao').AsDateTime;
       qryDocumentosPagImpostosRetidos.FieldByName('datalancto').AsDateTime := qryDocumentosPag.FieldByName('datalancto').AsDateTime;
       qryDocumentosPagImpostosRetidos.FieldByName('evento').Asvariant := qryDocumentosPag.FieldByName('Evento').AsVariant;
       qryDocumentosPagImpostosRetidos.FieldByName('filialemissao').AsInteger := qryDocumentosPag.FieldByName('filialemissao').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('filialcontabil').AsInteger := qryDocumentosPag.FieldByName('filialcontabil').AsInteger;

       qryDocumentosPagImpostosRetidos.FieldByName('referencia').AsString := FilialContasEntradas[tipo];
       qryDocumentosPagImpostosRetidos.FieldByName('valor').AsCurrency := valorimpostorateado;
       qryDocumentosPagImpostosRetidos.FieldByName('documentopagorigem').AsInteger := qryDocumentosPag.FieldByName('Numero').AsInteger;
       qryDocumentosPagImpostosRetidos.FieldByName('datavenctoorigem').clear;
       qryDocumentosPagImpostosRetidos.FieldByName('numeroorigem').clear;
       qryDocumentosPagImpostosRetidos.FieldByName('complemento').AsString := qryDocumentosPag.FieldByName('complemento').AsString;
       qryDocumentosPagImpostosRetidos.FieldByName('previsao').AsBoolean := false;
       qryDocumentosPagImpostosRetidos.FieldByName('fatogerador').AsString := qryVenctosImpostosRetidosEntradas.FieldByName('ocasiao').AsString;
     end;

     procedure AtribuirDuplicatas;
     begin
       qryDuplicatasImpostosRetidos.FieldByName('documentopag').AsInteger := qryDocumentosPagImpostosRetidos.FieldByName('numero').AsInteger;
       qryDuplicatasImpostosRetidos.FieldByName('datavencto').AsDateTime :=
            CalcularVenctoImpostoRetidoEntrada(qryDocumentosPag.FieldByName('datalancto').AsDateTime,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('quinzenal').asboolean,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('parametro_inicial').asstring,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('dia').AsInteger,
                                               qryVenctosImpostosRetidosEntradas.FieldByName('parametro_final').asstring,
                                               qryDocumentosPag.FieldByName('filialemissao').AsInteger
                                               );
       qryDuplicatasImpostosRetidos.FieldByName('numero').AsInteger := 1;
       qryDuplicatasImpostosRetidos.FieldByName('valorvencto').AsCurrency := valorimpostorateado;
       qryDuplicatasImpostosRetidos.FieldByName('evento').AsVariant := qryDocumentosPag.FieldByName('Evento').AsVariant;
       qryDuplicatasImpostosRetidos.FieldByName('tipojuros').AsString := qryDuplicatas.FieldByName('tipojuros').AsString;
       qryDuplicatasImpostosRetidos.FieldByName('tipomulta').AsString := qryDuplicatas.FieldByName('tipomulta').AsString;
       qryDuplicatasImpostosRetidos.FieldByName('autorizado').AsBoolean := qryDuplicatas.FieldByName('autorizado').AsBoolean;
     end;

     function posicionardocumentospagimpostosretidos: boolean;
     begin
       result := false;
       qryDocumentosPagImpostosRetidos.First;
       while not qryDocumentosPagImpostosRetidos.Eof do
       begin
         if qryDocumentosPagImpostosRetidos.FieldByName('referencia').asstring = FilialContasEntradas[tipo] then
         begin
           result  := true;
           break;
         end
         else
           qryDocumentosPagImpostosRetidos.Next;
       end;
     end;
  begin
    result := true;
    if qryVenctosImpostosRetidosEntradas.Locate('descricao', FilialContasEntradas[tipo], []) then
    begin
      if qryVenctosImpostosRetidosEntradas.FieldByName('ocasiao').AsString = 'No lançto da NF' then
      begin
        if qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').AsInteger <> 0 then
        begin

          case situacao of
            VALIDAR:
            begin
              LocalizarDocumentosPagImpostosRetidosNota;
              if HouveMudancaFatoGeradoreComQuitacao then
                result := MensagemConfirmacao(
                    format('O documento gerado ''%s - %s'' esta inconsistente com os parâmetros do sistema.'+#10#13+
                           'Fato gerador atual: ''No lançto da NF'''+#10#13+
                           'Fato gerador configurado: ''No pagamento da duplicata'''+#10#13+
                           'Sugestão: desquite este pagamento e gere novamente acessando o documento original.',
                           [qryDocumentosPagImpostosRetidos.fieldbyname('numero').asstring,
                            FilialContasEntradas[tipo]])) = smbOK;
            end;


            GRAVAR:
            begin

              {Verifica se não existe pagamento para o tipo específico}
              if LocalizarDocumentosPagImpostosRetidosNota then
                {visto que não há pagamentos,
                 Efetua a exclusao para todos do tipo específico
                 dos documentospagimpostosretidos para serem refeitos}
                ApagarDocumentosPagImpostosRetidosNota;

              if not HouveMudancaFatoGeradoreComQuitacao then
              begin
                valorimpostorateado :=  ValorImposto;

                if posicionardocumentospagimpostosretidos  then
                begin
                  if valorimpostorateado <> 0 then
                  begin
                    if not ExistePagamento_DuplicatasImpostosRetido then
                    begin
                      qryDocumentosPagImpostosRetidos.Edit;
                      AtribuirDocumentosPag;
                      qryDocumentosPagImpostosRetidos.post;
                      qryDuplicatasImpostosRetidos.Edit;
                      AtribuirDuplicatas;
                      qryDuplicatasImpostosRetidos.Post;
                    end;
                  end
                  else
                    qryDocumentosPagImpostosRetidos.Delete;
                end
                else
                begin
                  if valorimpostorateado <> 0 then
                  begin
                    qryDocumentosPagImpostosRetidos.Append;
                    spcDocumentosPagProximo.Open;
                    qryDocumentosPagImpostosRetidos.FieldByName('numero').AsInteger := spcDocumentosPagProximo.FieldByName('codigo').AsInteger;
                    spcDocumentosPagProximo.Close;
                    AtribuirDocumentosPag;
                    qryDocumentosPagImpostosRetidos.Post;
                    qryDuplicatasImpostosRetidos.Append;
                    AtribuirDuplicatas;
                    qryDuplicatasImpostosRetidos.Post;
                  end;
                end
              end;
            end;
          end;
        end
        else
        begin
          if ValorImposto <> 0 then
          begin
            result := false;
            MensagemErro(format(ctFORNECEDORPADRAONAOVINCULADO,[FilialContasEntradas[tipo]]));
          end;
        end;
      end;
    end
    else
    begin
      if ValorImposto <> 0 then
      begin
        result := false;
        MensagemErro(format(ctCONTAPADRAONAOVINCULADA,[FilialContasEntradas[tipo]]));
      end;
    end;
  end;

begin
  vRegistroAtualDuplicata := qryDuplicatas.GetBookmark;
  result := true;
  LancamentosContas := nil;
  if ParSistema.GeracaoAutomaticadoImpostoRetido then
  begin
    if not previsao then
    begin

      ReFazConsulta(qryVenctosImpostosRetidosEntradas,[0],
                    [qryDocumentosPag.FieldByName('filialemissao').AsVariant]);

      if (qrydocumentospag.FindField('documentopagorigem') = nil) or
         (qryDocumentosPag.FieldByName('documentopagorigem').isnull) then
      begin

       ReFazConsulta(qryContasEntradasFiliais,[0,1],
          [qryDocumentosPag.fieldbyname('fornecedorparaiss').Asinteger,
           qryDocumentosPag.fieldbyname('filialemissao').Asinteger]);

        if (qryVenctosImpostosRetidosEntradas.Locate('descricao','ISS retido',[])) then
          if qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').IsNull then
            if qryDocumentosPag.fieldbyname('fornecedorparaiss').asinteger<>0 then
            begin
              qryVenctosImpostosRetidosEntradas.Edit;
              qryVenctosImpostosRetidosEntradas.FieldByName('fornecedor').AsInteger := qryDocumentosPag.fieldbyname('fornecedorparaiss').asinteger;
              qryVenctosImpostosRetidosEntradas.FieldByName('tipofornecedor').AsString := 'F';
              qryVenctosImpostosRetidosEntradas.post;
            end;

        valorimpostorateado := 0;

        qryduplicatas.First;
        while not qryduplicatas.Eof do
        begin
          result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('irretido').AsCurrency, lceIRRetido);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('inssretido').AsCurrency, lceINSSRetido);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('issretido').AsCurrency, lceISSRetido);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('pisretido').AsCurrency, lcePISRetido);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('cofinsretido').AsCurrency, lceCOFINSretida);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('csllretido').AsCurrency, lceCSLLretida);
          if result then
            result := VerificarImpostosRetidosnaDuplicata(qryDocumentosPag.FieldByName('piscofinscsllretido').AsCurrency, lcePIS_COFINS_CSLL);

          if result then
            qryduplicatas.Next
          else
            break;
        end;



        if result and (origem = CadastroDuplicatas) then
        begin
          result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('irretido').AsCurrency, lceIRRetido);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('inssretido').AsCurrency, lceINSSRetido);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('issretido').AsCurrency, lceISSRetido);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('pisretido').AsCurrency, lcePISRetido);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('cofinsretido').AsCurrency, lceCOFINSretida);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('csllretido').AsCurrency, lceCSLLretida);
          if result then
            result := VerificarImpostosRetidosnaNotaFiscal(qryDocumentosPag.FieldByName('piscofinscsllretido').AsCurrency, lcePIS_COFINS_CSLL);
        end;
      end
      else
      begin
        if Situacao = VALIDAR then
        begin
          if (qryVenctosImpostosRetidosEntradas.Locate('descricao',qryDocumentospag.fieldbyname('referencia').AsString,[])) then
             if qryDocumentospag.FieldByName('fatogerador').AsString <> qryVenctosImpostosRetidosEntradas.FieldByName('ocasiao').AsString then
                result := MensagemConfirmacao(
                    format('O documento gerado ''%s - %s'' esta inconsistente com os parâmetros do sistema.'+#10#13+
                           'Fato gerador atual: ''No lançto da NF'''+#10#13+
                           'Fato gerador configurado: ''No pagamento da duplicata'''+#10#13+
                           'Sugestão: desquite este pagamento e gere novamente acessando o documento original.',
                           [qryDocumentosPag.fieldbyname('numero').asstring,
                            qryDocumentospag.fieldbyname('referencia').AsString])) = smbOK;
        end;
      end;
    end
    else
    begin
      if situacao = GRAVAR then
      begin
        qryDocumentosPagImpostosRetidos.First;
        while not qryDocumentosPagImpostosRetidos.Eof do
          qryDocumentosPag.Delete;
      end;
    end;
  end;
  qryduplicatas.GotoBookmark(vRegistroAtualDuplicata);
  qryduplicatas.FreeBookmark(vRegistroAtualDuplicata);
end;

function TdtmBasico.RetornaZero: currency;
begin
  result := 0;
end;

class procedure TdtmBasico.ShowProcessando(Mensagem: String = '');
begin
  if mensagem = '' then
  begin
    if Assigned(frmProcessando) then
    begin
      frmProcessando.Close;
      frmProcessando.free;
    end;
  end
  else
  begin
    if not Assigned(frmProcessando) then
      frmProcessando := TfrmProcessando.Create(Application);

    frmProcessando.Mensagem := Mensagem;
    frmProcessando.Show;
    Application.ProcessMessages;
  end;
end;

procedure LimparTabela(ds: TZDataSet; Inversa: boolean);
begin
  if ds.Active then
  begin
    ds.disablecontrols;
    if Inversa then
    begin
      ds.last;
      while not ds.bof do
        ds.delete;
    end
    else
    begin
      ds.First;
      while not ds.eof do
        ds.delete;
    end;
    ds.enablecontrols;
  end;
end;

procedure LigarDesligarLog_;
begin
  if vLogHabilitado then
  begin
    dtmTecSoft.ZMonitor1.Transaction := dtmTecSoft.tstTecSoft;
    dtmTecSoft.ZMonitor1.Enabled := true;
    dtmTecSoft.ZMonitor1.OnMonitorEvent := dtmTecSoft.ZMonitor1MonitorEvent;
  end
  else
  begin
    dtmTecSoft.ZMonitor1.Transaction := nil;
    dtmTecSoft.ZMonitor1.Enabled := false;
    dtmTecSoft.ZMonitor1.OnMonitorEvent := nil;
  end;
end;

function TdtmBasico.ValidarImpostosRetidosSaidas(irretido, inssretido,
  issretido, pisretido, cofinsretido, csllretido: Currency;
  TabelaLancamentos, TabelaLanctosFiliais, TabelaLanctosNatureza: TtecQuery): boolean;

  function ValidarValor(Tipo: TtecLancamentosContasSaidas):boolean;
  var
   descricaoconta : String;
  begin
    result := false;
    descricaoconta := FilialContasSaidas[Tipo];
    if TabelaLanctosFiliais.Locate('descricao',descricaoconta,[]) then
    begin
      result := true;
      if TabelaLanctosFiliais.fieldbyname('regime').asstring = 'COMPETÊNCIA' then
      begin
        if TabelaLanctosFiliais.fieldbyname('contacontabil').AsInteger <> 0 then
        begin
          descricaoconta := TabelaLanctosFiliais.fieldbyname('descricaocontacontabil').Asstring;
          if TabelaLancamentos.Locate('contacontabil', TabelaLanctosFiliais.fieldbyname('contacontabil').AsInteger, []) then
            result := TabelaLancamentos.FieldByName('valordebito').ascurrency<>0;
          if not result then
            MensagemErro(format(ctLANCAMENTOOBRIGATORIO,[ANSIUpperCase(descricaoconta),ANSIUpperCase(ctDEBITO)]));
        end
        else
          MensagemErro(format(ctCONTAPADRAONAOVINCULADA,[ANSIUpperCase(descricaoconta)]));
      end;
    end;
  end;

  function ValidarValorISS(tipo: TtecLancamentosNaturezas):boolean;
  var
   descricaoconta : String;
  begin
    result := false;
    descricaoconta := vstrLancamentosNaturezas[Tipo];
    if TabelaLanctosNatureza.Locate('descricao',descricaoconta ,[]) then
    begin
      descricaoconta := TabelaLanctosNatureza.fieldbyname('descricaocontacontabil').Asstring;
      if TabelaLancamentos.Locate('contacontabil', TabelaLanctosNatureza.fieldbyname('contacontabil').AsInteger, []) then
        result := TabelaLancamentos.FieldByName('valordebito').ascurrency<>0;
      if not result then
        MensagemErro(format(ctLANCAMENTOOBRIGATORIO,[ANSIUpperCase(descricaoconta),ANSIUpperCase(ctDEBITO)]));
    end
    else
      MensagemErro(format(ctCONTAPADRAOISSNAOVINCULADA,[ANSIUpperCase(descricaoconta)]));
  end;


begin
  result := true;
  if irretido<>0 then
    result := ValidarValor(lcsIRRFaCompensar);

  if result then
    if inssretido<>0 then
      result := ValidarValor(lcsINSSacompensar);

  if result then
    if pisretido<>0 then
      result := ValidarValor(lcsPISaCompensar);

  if result then
    if cofinsretido<>0 then
      result := ValidarValor(lcsCOFINSacompensar);

  if result then
    if csllretido<>0 then
      result := ValidarValor(lcsCSLLacompensar);

  if result then
    if issretido<>0 then
      result := ValidarValorISS(lnDespesasISS);

end;

procedure TdtmBasico.AcertarCasasDecimais(Campo: TFloatField);
begin
//  Campo.Precision := ParSistema.PrecoUnitarioCasasDecimais;

  case ParSistema.PrecoUnitarioCasasDecimais of
    2: Campo.DisplayFormat:= '###,###,##0.00';
    3: Campo.DisplayFormat:= '###,###,##0.000';
    4: Campo.DisplayFormat:= '###,###,##0.0000';
    5: Campo.DisplayFormat:= '###,###,##0.00000';
    6: Campo.DisplayFormat:= '###,###,##0.000000';
    7: Campo.DisplayFormat:= '###,###,##0.0000000';
    8: Campo.DisplayFormat:= '###,###,##0.00000000';
    9: Campo.DisplayFormat:= '###,###,##0.000000000';
    10: Campo.DisplayFormat:= '###,###,##0.0000000000';

  end;

  {
  case ParSistema.PrecoUnitarioCasasDecimais of
    2: Campo.EditFormat := '###,###,##0.00';
    3: Campo.EditFormat:= '###,###,##0.000';
    4: Campo.EditFormat:= '###,###,##0.0000';
    5: Campo.EditFormat:= '###,###,##0.00000';
    6: Campo.EditFormat:= '###,###,##0.000000';
    7: Campo.EditFormat:= '###,###,##0.0000000';
    8: Campo.EditFormat:= '###,###,##0.00000000';
    9: Campo.EditFormat:= '###,###,##0.000000000';
    10: Campo.EditFormat:= '###,###,##0.0000000000';

  end;
  }
  
end;

