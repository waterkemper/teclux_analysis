  end;
end;

function TdtmBasico.CopiarRegistros(QueryOrigem, QueryDestino: TtecQuery;
     Todos: Boolean = True;
     DesligarControlesOrigem: Boolean = True;
     DesligarControlesDestino: Boolean = True;
     CopyIfReadOnly: Boolean = True;
     EditarRegistro: boolean = false;
     VeficarSeCamposIguais: boolean = true): boolean;
var
  a: Integer;
  ControlesJaDesabilitadosOrigem,
  ControlesJaDesabilitadosDestino : Boolean;
  ReadOnlyAnt : Boolean;
begin
  result := true;

  try

    ControlesJaDesabilitadosOrigem := QueryOrigem.ControlsDisabled;
    if not ControlesJaDesabilitadosOrigem then
     if DesligarControlesOrigem then
       QueryOrigem.DisableControls;

    ControlesJaDesabilitadosDestino := QueryDestino.ControlsDisabled;
    if not ControlesJaDesabilitadosDestino then
     if DesligarControlesDestino then
       QueryDestino.DisableControls;

    ReadOnlyAnt := QueryDestino.readonly;

    if QueryOrigem.RecordCount <> 0 then
    begin
      if todos then
        QueryOrigem.First;

      while not QueryOrigem.Eof do
      begin

        if CopyIfReadOnly then
          QueryDestino.readonly := False;

        if EditarRegistro and not todos then
          QueryDestino.edit
        else
          QueryDestino.Append;

        for a := 0 to QueryOrigem.FieldCount - 1 do
        begin

          if (VeficarSeCamposIguais and
              (QueryDestino.FindField(QueryOrigem.fields[a].fieldname)<>nil) and
              (QueryOrigem.fields[a].fieldname = QueryDestino.fields[a].fieldname)
              ) or

             not VeficarSeCamposIguais then
          begin

            if (CopyIfReadOnly or not QueryDestino.Fields[a].readonly) then
            begin

              if QueryOrigem.Fields[a].IsNull then
                QueryDestino.Fields[a].clear
              else
              begin

                case QueryOrigem.Fields[a].datatype of
                  ftBoolean  : begin
                                 if (QueryDestino.Fields[a].AsBoolean <> QueryOrigem.Fields[a].AsBoolean) or
                                    QueryDestino.Fields[a].IsNull then
                                   QueryDestino.Fields[a].AsBoolean := QueryOrigem.Fields[a].AsBoolean;

                               end;
                  ftLargeint,
                  ftString,
                  ftDate,
                  ftDateTime : begin
                                 if QueryDestino.Fields[a].AsString <> QueryOrigem.Fields[a].AsString then
                                   QueryDestino.Fields[a].AsString := QueryOrigem.Fields[a].AsString;
                               end;
                else
                  if QueryDestino.Fields[a].value <> QueryOrigem.Fields[a].value then
                    QueryDestino.Fields[a].value := QueryOrigem.Fields[a].value;
                end;
              end;
            end;
          end;
        end;

        QueryDestino.post;

        if todos then
          QueryOrigem.Next
        else
          break;
      end;
    end;

    if not ControlesJaDesabilitadosOrigem then
      if DesligarControlesOrigem then
        QueryOrigem.EnableControls;

    if not ControlesJaDesabilitadosDestino then
      if DesligarControlesDestino then
        QueryDestino.EnableControls;

    QueryDestino.readonly := ReadOnlyAnt;



  except
  on E:Exception do
        begin
          MensagemErro(E.Message);
              result := false;

        end;
  end;

end;


class function TdtmBasico.VerificarFilialBase: Boolean;
var
  SQL: String;
  qryVerificarFilialBase: TtecQuery;
  valor : integer;
begin
  qryVerificarFilialBase := TtecQuery.Create(nil);
  qryVerificarFilialBase.Database := dtmTecSoft.Database;
  SQL := Format(VerificarFilialBaseSQL, [inttostr(GetFilialBase)]);
  qryVerificarFilialBase.Sql.Text := SQL;
  qryVerificarFilialBase.Open;

  Result := qryVerificarFilialBase.RecordCount > 0;
  if Result then
  begin
    if qryVerificarFilialBase.locate('codigo', GetFilialBase, []) then
    begin

      FFilialContabil               := qryVerificarFilialBase.Fieldbyname('filialcontabil').Asinteger;
      FFilialEstoque                := qryVerificarFilialBase.Fieldbyname('filial_estoque').Asinteger;

      FNomeFilialBase               := qryVerificarFilialBase.Fieldbyname('nome').AsString;
      FRazaoFilialBase              := qryVerificarFilialBase.Fieldbyname('razao').AsString;
      fMnemonicoFilialBase          := qryVerificarFilialBase.Fieldbyname('mnemonico').AsString;
      FRuaFilialBase                := qryVerificarFilialBase.Fieldbyname('rua').AsString;
      FNumeroFilialBase             := qryVerificarFilialBase.Fieldbyname('numero').AsString;
      FComplementoFilialBase        := qryVerificarFilialBase.Fieldbyname('complemento').AsString;
      FRuaSemNumeroFilialBase       := FRuaFilialBase;
      if qryVerificarFilialBase.Fieldbyname('numero').AsString<>'' then
        FRuaFilialBase := FRuaFilialBase + ', '+qryVerificarFilialBase.Fieldbyname('numero').AsString;

      if qryVerificarFilialBase.Fieldbyname('complemento').AsString<>'' then
        FRuaFilialBase := FRuaFilialBase + ', '+qryVerificarFilialBase.Fieldbyname('complemento').AsString;

      FEstadoFilialBase             := qryVerificarFilialBase.Fieldbyname('estado').AsString;
      FCodigoCidadeFilialBase       := qryVerificarFilialBase.Fieldbyname('cidade').AsString;
      FCidadeFilialBase             := qryVerificarFilialBase.Fieldbyname('nomecidade').AsString;
      FCodigoBairroFilialBase       := qryVerificarFilialBase.Fieldbyname('bairro').AsString;
      FBairroFilialBase             := qryVerificarFilialBase.Fieldbyname('nomebairro').AsString;
      FCEPFilialBase                := qryVerificarFilialBase.Fieldbyname('cep').AsString;
      FFoneFilialBase               := qryVerificarFilialBase.Fieldbyname('fonenumero').AsString;
      FCNPJFilialBase               := qryVerificarFilialBase.fieldbyname('cnpj').AsString;
      FSerieSugestao                := qryVerificarFilialBase.fieldbyname('seriesugestao').AsString;
      FSerieSugestaoServicos        := qryVerificarFilialBase.fieldbyname('seriesugestaoservicos').AsString;
      FSerieSugestaoNFCe            := qryVerificarFilialBase.fieldbyname('seriesugestaonfce').AsString;
