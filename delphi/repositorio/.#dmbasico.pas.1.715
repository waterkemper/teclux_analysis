function TdtmBasico.csosn_produto(produto:String): String;
begin
  if not qryDadosProdutos_.active and
     (lst_prod_calc_Imp<>'') then
  begin
    qryDadosProdutos_.Sql.text := ' select p.codigo, c.csosn as csosn_produto '+
                                 ' from produtos p join caracteristicas c on p.caracteristica = c.codigo '+
                                 ' where p.caracteristica = c.codigo and p.codigo in ('+ lst_prod_calc_Imp +') order by p.codigo';
    qryDadosProdutos_.open;

  end;

  if qryDadosProdutos_.active and
     (qryDadosProdutos_.findfield('codigo') <> nil) and
     (qryDadosProdutos_.findfield('csosn_produto') <> nil) and
     qryDadosProdutos_.Locate('codigo', produto, []) then
  begin
    result := qryDadosProdutos_.fieldbyname('csosn_produto').asString;
  end
  else
  begin
    qryDadosProdutos_.Sql.text := ' select c.csosn as csosn_produto '+
                               ' from produtos p join caracteristicas c on p.caracteristica = c.codigo '+
                               ' where p.caracteristica = c.codigo and p.codigo = '+ produto ;
    qryDadosProdutos_.open;
    result := qryDadosProdutos_.fieldbyname('csosn_produto').asString;
  end;

 // result := '500';

end;

{
function TdtmBasico.FatorSubstituicao(EstadoSubstituicao, produto, PessoaTipo: String; VendaConsumidorFinal, ContribICMS: Boolean): Currency;
begin
  vCalcularDiferencaAliquotaInterEstadual := false;
  if VendaConsumidorFinal then
  begin
    result := 1;
    if (Estadofilialbase <>  EstadoSubstituicao) and
       (PessoaTipo = 'J') and ContribICMS then
    begin
      RefazConsultaPorNome(qryFatorSubstituicao,
         ['UF_CliForSaida_ou_FilialEntrada','produto','TipoPessoa'],
         [EstadoSubstituicao,
          produtos.fieldbyname(campoproduto).asString,
          PessoaTipo]);
      vCalcularDiferencaAliquotaInterEstadual := qryFatorSubstituicao.FieldByName('fatorsubstituicao').AsFloat > 1;
    end;
  end
  else
  begin
      RefazConsultaPorNome(qryFatorSubstituicao,
         ['UF_CliForSaida_ou_FilialEntrada','produto','TipoPessoa'],
         [EstadoSubstituicao,
          produtos.fieldbyname(campoproduto).asString,
          PessoaTipo]);
    result := qryFatorSubstituicao.FieldByName('fatorsubstituicao').AsFloat;
  end;
end;
}

function TdtmBasico.cst_produto(produto:String): String;
begin
{
  qryDadosProdutos_.Sql.text := ' select t.valor as cst_produto '+
                               ' from tributosicms t, caracteristicas c, produtos p '+
                               ' where t.codigo = c.incidencia and p.caracteristica = c.codigo and p.codigo = ' + produto;
  qryDadosProdutos_.Close;
  qryDadosProdutos_.open;
  result := qryDadosProdutos_.fieldbyname('cst_produto').asString;
  }

  if not qryDadosProdutos_.active and
     (lst_prod_calc_Imp<>'') then
  begin
    qryDadosProdutos_.Sql.text := ' select p.codigo,  t.valor as cst_produto, c.csosn as csosn_produto '+
                                 ' from tributosicms t, produtos p, caracteristicas c '+
                                 ' where t.codigo = c.incidencia and p.caracteristica = c.codigo and p.codigo in ('+ lst_prod_calc_Imp +') order by p.codigo';


    qryDadosProdutos_.open;

  end;

  if qryDadosProdutos_.active and
     (qryDadosProdutos_.findfield('codigo')<>nil) and
     (qryDadosProdutos_.findfield('cst_produto') <> nil) and
     qryDadosProdutos_.Locate('codigo', produto, []) then
  begin
    result := qryDadosProdutos_.fieldbyname('cst_produto').asString;
  end
  else
  begin
  {
    qryDadosProdutos_.Sql.text := ' select c.csosn as csosn_produto '+
                               ' from produtos p join caracteristicas c on p.caracteristica = c.codigo '+
                               ' where p.caracteristica = c.codigo and p.codigo = '+ produto ;
}

    qryDadosProdutos_.Sql.text := ' select t.valor as cst_produto, c.csosn as csosn_produto '+
                                 ' from tributosicms t, produtos p, caracteristicas c '+
                                 ' where t.codigo = c.incidencia and p.caracteristica = c.codigo and p.codigo = '+ produto ;

    qryDadosProdutos_.open;
    result := qryDadosProdutos_.fieldbyname('cst_produto').asString;
  end;

end;

function TdtmBasico.CSOSNSaida(EstadoDestino, Produto, PessoaTipo : String;
   VendaConsumidorFinal, ContribICMS: Boolean;
   ClienteNoSimples: Boolean;
   OrgaoPublico: boolean;
   IPINCM: integer): String;
var
  pFilial     : INTEGER;
  pProduto    : String;
  pCSOSN      : String;
  pCRTDestino : INTEGER;
  pUFDestino  : String;

begin

  pFilial := FilialBase;
  pProduto := Produto;
  pCSOSN := csosn_produto(produto);
  if ClienteNoSimples then
    pCRTDestino := 1
  else
    pCRTDestino := 3;
  pUFDestino := EstadoDestino;

   {

   /*---------------------------------------------------------------- Código de Regime Tributário --
    1 - Simples Nacional
    2 - Simples Nacional - excesso de sublimite da receita bruta
    3 - Regime Normal

    NOTAS EXPLICATIVAS:

           O código 1 será preenchido pelo contribuinte quando for optante pelo Simples Nacional.

           O código 2 será preenchido pelo contribuinte optante pelo Simples Nacional, mas que tiver
     ultrapassado o sublimite de receita bruta  fixado pelo estado/DF e estiver impedido de recolher
     o ICMS/ISS por esse regime, conforme arts. 19 e 20 da LC 123/06.

           O código 3 será preenchido pelo contribuinte que não estiver na situação 1 ou 2.
   -----------------------------------------------------------------------------------------------*/

   SELECT f.* INTO rF FROM Filiais f WHERE f.Codigo = COALESCE(pFilial, 0);
   IF NOT FOUND
   THEN RAISE NOTICE 'A filial "%" não está cadastrada.', pFilial;
   END IF;

   IF COALESCE(rF.RegimeTributario, 0) <> 1
   THEN RAISE NOTICE 'O regime tributário da filial "%" não é SIMPLES NACIONAL', pFilial;
   END IF;


   /*-------------------------------------------------------------------------------------- CSOSN --
    101 - Tributada pelo Simples Nacional com permissão de crédito
          Classificam-se neste código as operações  que permitem a indicação da alíquota do ICMS de-
          vido no Simples Nacional e o valor do crédito correspondente.

    102 - Tributada pelo Simples Nacional sem permissão de crédito
          Classificam-se neste código as operações  que não permitem a indicação da alíquota do ICMS
          devido pelo Simples Nacional e do valor do crédito, e não estejam abrangidas nas hipóteses
          dos códigos 103, 203, 300, 400, 500 e 900.

    103 - Isenção do ICMS no Simples Nacional para faixa de receita bruta
          Classificam-se neste  código as operações  praticadas por  optantes pelo  Simples Nacional
          contemplados com isenção concedida  para faixa de  receita bruta nos termos da Lei Comple-
          mentar nº 123, de 2006.

    201 - Tributada pelo Simples Nacional COM permissão de crédito e com  cobrança do ICMS por subs-
          tituição tributária
          Classificam-se neste código as operações que  permitem a indicação da alíquota do ICMS de-
          vido pelo Simples Nacional e do valor  do crédito, e com cobrança do ICMS por substituição
          tributária.

    202 - Tributada pelo Simples Nacional SEM permissão  de crédito e com cobrança do ICMS por subs-
          tituição tributária
          Classificam-se neste código as operações que não  permitem a indicação da alíquota do ICMS
          devido pelo Simples Nacional e do valor do crédito, e não estejam abrangidas nas hipóteses
          dos códigos 103, 203, 300, 400, 500 e 900,  e com cobrança do ICMS por substituição tribu-
          tária.

    203 - Isenção do ICMS no Simples Nacional para faixa de receita bruta e com cobrança do ICMS por
          substituição tributária
          Classificam-se neste  código as  operações praticadas  por optantes  pelo Simples Nacional
          contemplados com isenção para faixa de receita bruta nos termos da Lei Complementar nº 123,
          de 2006, e com cobrança do ICMS por substituição tributária.

    300 - Imune (EXPORTAÇÕES)
          Classificam-se neste  código as  operações praticadas  por optantes  pelo Simples Nacional
          contempladas com imunidade do ICMS.

    400 - Não tributada pelo Simples Nacional
          Classificam-se neste código as operações praticadas por optantes pelo Simples Nacional não
          sujeitas à tributação pelo ICMS dentro do Simples Nacional.

    500 - ICMS cobrado anteriormente por substituição tributária (substituído) ou por antecipação
          Classificam-se neste código as operações sujeitas exclusivamente ao regime de substituição
          tributária na condição de substituído tributário ou no caso de antecipações.

    900 - Outros (NORMALMENTE, DEVOLUÇÕES)
          Classificam-se neste código as demais operações que não se enquadrem nos códigos 101, 102,
          103, 201, 202, 203, 300, 400 e 500.
   -----------------------------------------------------------------------------------------------*/

   }

   IF (pCSOSN='103') or
      (pCSOSN='203') or
      (pCSOSN='300') or
      (pCSOSN='400') or
      (pCSOSN='900') or   // ---------------------- O CSOSN não será alterado

      ((regimetributario<>1) and           // não esta no regime simples nacional 1-Simple 2-simples excesso 3-Normal
       (regimetributario<>2))

   THEN begin
         result := pCSOSN;
         exit;
        end;


{
   SELECT c.* INTO rC FROM Caracteristicas c
      WHERE c.Codigo = (SELECT p.Caracteristica FROM Produtos p
                           WHERE p.Codigo = pProduto);
   IF NOT FOUND
   THEN RAISE NOTICE 'O produto "%" não foi achado.', pProduto;
   END IF;


   --------------------------------------------------------- TRATAMENTO PARA SUBSTITUIÇÃO TRIBUTÁRIA
   SELECT ei.* INTO rEI FROM EstadosIPI ei
      WHERE ei.IPI    = rC.IPI AND
            ei.Estado = pUFDestino;
   IF NOT FOUND
   THEN RAISE NOTICE 'Não há informações de ST do produto "%" no estado "%"', pProduto, pUFDestino;
   END IF;
   }



//   IF NOT COALESCE(rEI.Ativo, FALSE) ----------------------------------- SEM SUBSTITUIÇÃO TRIBUTÁRIA

//   {chama a função para atribuir o valor a fFatorSubstituicao}
//   FatorSubstituicao[EstadoDestino, produto, PessoaTipo, VendaConsumidorFinal, ContribICMS, ResponsavelDifal];
     sem_st[EstadoDestino, produto, IPINCM];

   if {(fFatorSubstituicao=0) or (fFatorSubstituicao=1)}

       fsem_st THEN
   begin

        IF (pCRTDestino = 1) or OrgaoPublico or not ContribICMS // ---------------------------------------- Destinatário do Simples nacional ou Órgão público
        THEN                                                    // ou não contribuinte
               result := '102'

        ELSE
        begin
          case regimecontabil of
          1 : result := '101';  //Regime contábil de competência
          2 : result := '102';  //Regime contábil de Caixa
          end;
        end;        // ------------- Se o destinatário for normal, o CSOSN dependerá do regime
                                //         -- contábil da  empresa emitente. Se for regime  de caixa, o
                                //        -- CSOSN será '102'.  Sendo regime de competência, '101' e a
                                //        -- alíquota é a do Simples Nacional do mês anterior.

   END
   ELSE  // ---------------------------------------------------------------- COM SUBSTITUIÇÂO TRIBUTÁRIA
   BEGIN
//        IF rF.Ind_Ativ = '0' -- Atividade Industrial
        IF Ind_Ativ = '0' // -- Atividade Industrial
        THEN //------------------------------------- Deve-se informar base cálculo ST, MVA do produto,
        begin                                  // -- e valor do ICMS ST.
             IF pCRTDestino = 1 // -------------------------------- Destinatário é do SIMPLES NACIONAL?
             THEN
                   result := '202'
             ELSE
                    result := '201';
        END

        ELSE
        begin
             IF (EstadoFilialBase = pUFDestino) then
               result := pCSOSN
             else
             begin

               IF not ContribICMS or
                  VendaConsumidorFinal THEN
                 result := '500'   //------------- Deve-se informar o valor retido informado na compra
                                  //         -- (Caso não esteja disponível, informar 0,00) .

               ELSE      //----------------- Deve-se informar MVA do produto e alíquota do estado de destino.
               begin     //-- Levar uma GNRE para acompanhar o trânsito da mercadoria.
                    IF pCRTDestino = 1 //--------------------------- Destinatário é do SIMPLES NACIONAL?
                    THEN
                           result := '202'


                    ELSE
                           result := '201';
               END;
             end;
        END;
   END;







(*
  result := csosn_produto(produto);
  if contribicms then
  begin
    if (result = '500') and
       (Estadofilialbase <> EstadoDestino) and
       ((FatorSubstituicao[EstadoDestino, produto, PessoaTipo, VendaConsumidorFinal, ContribICMS, ResponsavelDifal] > 1)) then
{       result := '900'    //o correto seria 202 porém a alteração seria maior}
        result := '202' {27/11/2019 probelam Gama Weg Amazonas}
    else
    if (result = '500') and
       (Estadofilialbase <> EstadoDestino) and
       ((FatorSubstituicao[EstadoDestino, produto, PessoaTipo, VendaConsumidorFinal, ContribICMS, ResponsavelDifal] = 0)) then
       result := '102';
  end
  else
  begin

    if (result <> '102') and
       (result <> '103') and
       (result <> '300') and
       (result <> '400') and
       (result <> '500') then
      result := '102';
  end;
*)



end;

function TdtmBasico.CSTSaida(EstadoDestino, Produto, PessoaTipo : String; VendaConsumidorFinal, ContribICMS, ClienteNoSimples: Boolean;
                      OrgaoPublico: boolean = false;
                      IPINCM : integer = 0): String;

var
  pFilial     : INTEGER;
  pProduto    : String;
  pCST : String;
  pCRTDestino : INTEGER;
  pUFDestino  : String;
begin


  pFilial := FilialBase;
  pProduto := Produto;
  pCST := cst_produto(produto);

  if ClienteNoSimples then
    pCRTDestino := 1
  else
    pCRTDestino := 3;
  pUFDestino := EstadoDestino;



   {csosn 103}
   IF //(pCST='00') or // Tributada Integralmente
      //(pCST='20') or // Com redução de Base de Calculo
      (pCST='40') or // Isenta
      (pCST='41') or // Não tributada
      (pCST='50') or // Suspensão
      (pCST='51') or // Diferimento
      (pCST='90') or // Outras
      (regimetributario<>3)   // não esta no regime normal

      (*
   IF (pCSOSN='103') or
      (pCSOSN='203') or
      (pCSOSN='300') or
      (pCSOSN='400') or
      (pCSOSN='900') or   // ---------------------- O CSOSN não será alterado

      (regimetributario<>1)   // não esta no regime simples nacional
      *)

   THEN begin
         //result := pCSOSN;
         result := pCST;
         exit;
        end;


  if (pCST = '60') and
     (Estadofilialbase <> EstadoDestino) and
     ((FatorSubstituicao[EstadoDestino, produto, PessoaTipo, VendaConsumidorFinal, ContribICMS, 0] > 1)) then
     pCST := '10'
  else
  if (pCST = '60') and
     (Estadofilialbase <> EstadoDestino) and
     ((FatorSubstituicao[EstadoDestino, produto, PessoaTipo, VendaConsumidorFinal, ContribICMS, 0] = 0)) then
     pCST := '00';



//  sem_st[EstadoDestino, produto, IPINCM];

   result := pCST;

   (*
   if {(fFatorSubstituicao=0) or (fFatorSubstituicao=1)}

       fsem_st THEN
   begin

        IF {(pCRTDestino = 1) or
           (pCRTDestino = 2) or} OrgaoPublico {or not ContribICMS} // ---------------------------------------- Destinatário do Simples nacional ou Órgão público
        THEN

        {Correlativos para 102:

        40 Isenta
        41 Não tributada
        50 Suspensão
        51 Diferimento
        }                                    // ou não contribuinte
//               result := '102'
         result := '40'

        (*
        ELSE
        begin
          result := pCST;
          (*
          case regimecontabil of
          1 : result := '00' {'101'};  //Regime contábil de competência
          2 : result := '40'; {'102'};  //Regime contábil de Caixa
          end;

        end;*)        // ------------- Se o destinatário for normal, o CSOSN dependerá do regime
                                //         -- contábil da  empresa emitente. Se for regime  de caixa, o
                                //        -- CSOSN será '102'.  Sendo regime de competência, '101' e a
                                //        -- alíquota é a do Simples Nacional do mês anterior.
   (*
   END
   ELSE  // ---------------------------------------------------------------- COM SUBSTITUIÇÂO TRIBUTÁRIA
   BEGIN
   *)



   (*
//        IF rF.Ind_Ativ = '0' -- Atividade Industrial
        IF Ind_Ativ = '0' // -- Atividade Industrial
        THEN //------------------------------------- Deve-se informar base cálculo ST, MVA do produto,
        begin                                  // -- e valor do ICMS ST.
             IF pCRTDestino = 1 // -------------------------------- Destinatário é do SIMPLES NACIONAL?
             THEN
                   result := '10' {'202'}
             ELSE
                    result := '10' {'201'};
        END

        ELSE
        begin
             IF (EstadoFilialBase = pUFDestino) then
               result := pCST {pCSOSN}
             else
             begin

               IF not ContribICMS or
                  VendaConsumidorFinal THEN
                 result := '60' {'500'}   //------------- Deve-se informar o valor retido informado na compra
                                  //         -- (Caso não esteja disponível, informar 0,00) .

               ELSE      //----------------- Deve-se informar MVA do produto e alíquota do estado de destino.
               begin     //-- Levar uma GNRE para acompanhar o trânsito da mercadoria.
                    IF pCRTDestino = 1 //--------------------------- Destinatário é do SIMPLES NACIONAL?
                    THEN
                           result := '202'


                    ELSE
                           result := '201';
               END;
             end;
        END;
   END;
*)


end;

function TdtmBasico.CondicaopmvastForaEstado(cst, csosn: String;
  CRTEmitente: Integer; EstadoDestinatario: String): boolean;
begin
{
  1 – Simples Nacional;
  2 – Simples Nacional – excesso de sublimite de receita bruta;
  3 – Regime Normal. (v2.0)
}

  result := (EstadoDestinatario <> EstadoFilialBase) and
            (((CRTEmitente = 1) and (csosn = '500'))  or
             ((CRTEmitente <> 1) and (cst = '60')));
end;

function TdtmBasico.exigenotareferenciada(CodigoFiscal: integer): boolean;
begin
  if not assigned(qryCodigosFiscais) then
  begin
    qryCodigosFiscais := TTecQuery.Create((nil));
    qryCodigosFiscais.Database  := dtmTecSoft.Database;
    qryCodigosFiscais.sql.text  := 'select * from codigosfiscais where codigo = :codigofiscal';
  end;
  ReFazConsulta(qryCodigosFiscais,[0],[CodigoFiscal]);
  result := qryCodigosFiscais.fieldByName('exigenotareferenciada').asBoolean;
end;

