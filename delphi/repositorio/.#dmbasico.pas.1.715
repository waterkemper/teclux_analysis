procedure TdtmBasico.Abre(Grupo: Integer);
var
  a: Integer;
begin
  for a := 0 to ComponentCount - 1 do
  begin
    if (Components[a] is TdtmBasico) then
      TdtmBasico(Components[a]).Abre(Grupo);

    if (Components[a] is TDataSet) and (Components[a].Tag = Grupo) then
    begin
      if Not TDataSet(Components[a]).Active then
      begin
        try
           TDataSet(Components[a]).Open;
        except
                on E: Exception do ShowMessage(E.Message);
        end;
      end;
    end
  end;
end;

procedure TdtmBasico.AfterConstruction;
var
  a: Integer;
begin
  inherited AfterConstruction;
  if Tag = 0 then
    for a := 0 to ComponentCount - 1 do
      if Components[a].Tag = ctTabelas  then
        if Components[a] is TDataSet then
          if Not TDataSet(Components[a]).Active then
            TDataSet(Components[a]).Open;
end;

procedure TdtmBasico.BeforeDelete(DataSet: TDataSet);
begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, [ctINFORMACAO])) = smbCancel then
    Abort
end;

procedure TdtmBasico.BeforeDestruction;
var
  a: Integer;
begin
  if Tag = 0 then
    for a := 0 to ComponentCount - 1 do
      if Components[a] is TDataSet and TDataSet(Components[a]).Active then begin
        if TDataSet(Components[a]).State in [dsEdit, dsInsert] then
          TDataSet(Components[a]).Cancel;
        TDataSet(Components[a]).Close;
      end;
  inherited BeforeDestruction;
end;

class function TdtmBasico.CancelarAtualizacoes(ds: array of TZDataSet): Boolean;
var
  a: Integer;
begin
  try
    for a := 0 to High(ds) do
      if ds[a] is TZDataSet then
        if ds[a].UpdatesPending and ds[a].Active then begin
          ds[a].RevertRecord;
          ds[a].CancelUpdates;
        end;
    dtmTecSoft.tstTecSoft.Rollback;
    Result := True;
  except
    raise
  end;
end;

function TdtmBasico.CancelarOperacaoRelatorio(Query: TZDataSet): Boolean;
begin
  Result := False
end;

procedure TdtmBasico.ErroPadraoDeSalvar(DataSet: TDataSet; E: EDatabaseError;
  var Action: TDataAction);
begin
  if DataSet.State = dsEdit then
    DataSet.Cancel
end;

function TdtmBasico.ExisteCodigo(Tabela: TZDataSet; NomeCampo, Codigo: String;
  Parcial: Boolean = True; Sensivel: Boolean = True): boolean;
var
  Opcoes: TLocateOptions;
  Encontrou: Boolean;
  valor : String;
  RegistroAtual: TBookMark;
begin
  try
    Encontrou := False;
    Opcoes := [];
    if Parcial then
      Opcoes := Opcoes + [loPartialKey];
    if Sensivel then
      Opcoes := Opcoes + [loCaseInsensitive];
    case tabela.FieldByName(NomeCampo).DataType of
      ftDateTime, ftDate:
      begin
        RegistroAtual := tabela.GetBookmark;
        Tabela.First;
        while not tabela.Eof do
        begin
          valor := copy(tabela.fieldbyname(NomeCampo).AsString,0,length(trim(codigo)));
          if valor = trim(codigo) then
          begin
            encontrou := true;
            break;
          end
          else
            tabela.Next;
        end;

        if encontrou then
          result := true
        else
        begin
          tabela.GotoBookmark(RegistroAtual);
          result := false;
        end;
        tabela.FreeBookmark(RegistroAtual);

//        Tabela.Locate(NomeCampo, StrtoDateTime(Codigo), Opcoes);
      end;
    else
      Result := Tabela.Locate(NomeCampo, Codigo, Opcoes);
    end
  except
    Result := False
  end
end;

procedure TdtmBasico.Fecha(Grupo: Integer);
var
  a: Integer;
begin
  for a := 0 to ComponentCount - 1 do
  begin
    if (Components[a] is TdtmBasico) then
      TdtmBasico(Components[a]).Fecha(Grupo);

    if (Components[a] is TDataSet) and (Components[a].Tag = Grupo) then begin
      if TDataSet(Components[a]).Active then
        TDataSet(Components[a]).Close;
    end

  end;
end;

