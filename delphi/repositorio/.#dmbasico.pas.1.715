function TdtmBasico.CalcularImpostos(Var Produtos, Notas: TtecQuery;
       CalcularIPI, CalcularTodos: boolean; Saida : Boolean = True;
       Calculos : TtecQuery = nil;
       ProdutosCompostos : TTecQuery = nil;
       FiltrarComponentedoComposto: Boolean = false;
       OrigemCalculo : TtecOrigemCalculo = NotaAvulsa;
       VendaConsumidorFinal : Boolean = False;
       ContribICMS : Boolean = True;
       Servicos : TtecQuery = nil;
       NotaFiscalVinculada : boolean = false;
       msgDifAliquotaICMS: boolean = true;
       ReverAliquota : boolean = false;
       AlteracaoEspecifica: tpAlteracaoEspecifica = tpAltEsp_Nenhuma;
       VerificarAcertoCentavos: Boolean = True;
       qrynfe: TtecQuery = nil;
       cdsProdutos: TClientDataSet = nil): boolean;
type
tLocalAlteracao = (tpAltNotas, tpAltProdutos, tpAltICMSOutras, tpAltICMSIsentas);

var

  fREsponsavelDifal, fBaseDupla, fCSOSNSaida  : String;
  fdatainiciodifal : TDateTime;

  HeImportacao : Boolean;
  RegistroAtual, RegistroAtualServico : TBookMark;

