function TdtmBasico.eHNotaFiscalEntradaCompra(
  CodigoFiscal: integer): boolean;
var
 vAbrirConsulta : Boolean;
begin
  vAbrirConsulta := True;
  if not assigned(qryCodigosFiscais) then
  begin
    qryCodigosFiscais := TTecQuery.Create((nil));
    qryCodigosFiscais.Database  := dtmTecSoft.Database;
    vAbrirConsulta := True;
  end
  else
    vAbrirConsulta :=  (pCodigoFiscal_eHNotaFiscalEntradaCompra <> CodigoFiscal);

  if vAbrirConsulta then
  begin
    pCodigoFiscal_eHNotaFiscalEntradaCompra := CodigoFiscal;
    qryCodigosFiscais.sql.text  := 'select * from codigosfiscais where codigo = :codigofiscal and coalesce(VendasouCompras,false) and (codigo - mod(codigo,1000)) < 5000';
    ReFazConsulta(qryCodigosFiscais,[0],[CodigoFiscal]);
    result := (qryCodigosFiscais.RecordCount = 1);

    pResult_eHNotaFiscalEntradaCompra := result;

  end
  else
    result := pResult_eHNotaFiscalEntradaCompra;

  (*
  if result then
    if not ComExportacoes then
      result := qqryCodigosFiscais.fieldbyname('codigo').asInteger < 7000;

    result := (CodigoFiscal mod 1000  = 101) or  // Compra para industrialização
              (CodigoFiscal mod 1000  = 102) or  // Compra para comercialização
              (CodigoFiscal mod 1000  = 401) or  // COMPRA INDUSTRIALIZACAO MERC. SUBST.TRIBUTARIA
              (CodigoFiscal mod 1000  = 403);  // COMPRA COMERCIALIZACAO MERC. SUBST. TRIBUTARIA
  *)

end;

function TdtmBasico.eHNotaFiscalEntradaUsoouConsumo(
  CodigoFiscal: integer): boolean;
var
 vAbrirConsulta : Boolean;
begin
  vAbrirConsulta := True;
  if not assigned(qryCodigosFiscais) then
  begin
    qryCodigosFiscais := TTecQuery.Create((nil));
    qryCodigosFiscais.Database  := dtmTecSoft.Database;
    vAbrirConsulta := True;
  end
  else
    vAbrirConsulta :=  (pCodigoFiscal_eHNotaFiscalEntradaUsoouConsumo <> CodigoFiscal);

  if vAbrirConsulta then
  begin
    pCodigoFiscal_eHNotaFiscalEntradaUsoouConsumo := CodigoFiscal;
    qryCodigosFiscais.sql.text  := 'select * from codigosfiscais where codigo = :codigofiscal and coalesce(UsoouConsumo,false) and (codigo - mod(codigo,1000)) < 5000';
    ReFazConsulta(qryCodigosFiscais,[0],[CodigoFiscal]);
    result := (qryCodigosFiscais.RecordCount = 1);

    pResult_eHNotaFiscalEntradaUsoouConsumo := result;

  end
  else
    result := pResult_eHNotaFiscalEntradaUsoouConsumo;

  (*
    result := (CodigoFiscal mod 1000  = 407);   //  COMPRA USO MERC. SUBST. TRIBUTARIA
    *)
end;

