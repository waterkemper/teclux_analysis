      FModeloDoctoFiscalNFCe        := qryVerificarFilialBase.fieldbyname('modelodoctofiscalnfce').AsString;
      FModeloDoctoFiscalservico     := qryVerificarFilialBase.fieldbyname('modelodoctofiscalservico').AsString;
      FInscricaoEstadualFilialBase  := qryVerificarFilialBase.fieldbyname('inscricaoestadual').AsString;
      FInscricaoMunicipalFilialBase := qryVerificarFilialBase.fieldbyname('inscricaomunicipal').AsString;
