function TdtmBasico.TipoPlanoReferencial_(NomedoCampo: String): variant;
begin
 if fTipoPlanoReferencial_ = nil then
 begin
   fTipoPlanoReferencial_           := TTecQuery.Create((nil));
   fTipoPlanoReferencial_.Database  := dtmTecSoft.Database;
   fTipoPlanoReferencial_.sql.text  := format('select * from TiposPlanosReferenciais where TipoPlano = %s',[parsistema.TiposPlanosReferenciais]);
   fTipoPlanoReferencial_.open;
 end;
 result := fTipoPlanoReferencial_.fieldbyname(NomedoCampo).asVariant;
end;

function TdtmBasico.ValorCreditoTrocaEntreFiliais(FilialOrigemCredito, FilialDestinoCredito: integer): Currency;
var
  SQL: String;
  qryProdutosTrocados: TtecQuery;
  valor : integer;
begin
  qryProdutosTrocados := TtecQuery.Create(nil);
  qryProdutosTrocados.Database := dtmTecSoft.Database;
  SQL := ' select (coalesce((select sum(pc.valor) '+
    		 ' from produtostrocados pc '+
		     ' where pc.cliente = '+inttostr(FilialDestinoCredito) +
		      ' and pc.tipocliente = ''L'' '+
			    ' and pc.filial = '+inttostr(FilialOrigemCredito) +
  		    ' and pc.tipo = ''E''),0) - ' +

         ' coalesce((select sum(pc.valor) '+
		     ' from produtostrocados pc '+
		     ' where pc.cliente = '+inttostr(FilialDestinoCredito) +
		       ' and pc.tipocliente = ''L'' '+
			     ' and pc.filial = '+inttostr(FilialOrigemCredito) +
       		 'and pc.tipo = ''S''),0)) as saldo' ;

  qryProdutosTrocados.Sql.Text := SQL;
  qryProdutosTrocados.Open;

  result := qryProdutosTrocados.fieldByName('saldo').asCurrency;

end;

function TdtmBasico.GetFatorSubstituicao(EstadoSubstituicao, produto,
  PessoaTipo: String;
  VendaConsumidorFinal, ContribICMS: Boolean;
  IPINCM: integer): Currency;
begin

  fFatorSubstituicao := 1;

  if ContribICMS and not VendaConsumidorFinal then
  begin
    if IPINCM <> 0 then
    begin
      RefazConsultaPorNome(qryFatorSubstituicaoIPI,
           ['UF_CliForSaida_ou_FilialEntrada','IPINCM'],
           [EstadoSubstituicao,
            IPINCM]);
      fFatorSubstituicao := qryFatorSubstituicaoIPI.FieldByName('fatorsubstituicao').AsFloat;
    end
    else
    begin
      RefazConsultaPorNome(qryFatorSubstituicao,
           ['UF_CliForSaida_ou_FilialEntrada','produto','TipoPessoa'],
           [EstadoSubstituicao,
            produto,
            PessoaTipo]);
      fFatorSubstituicao := qryFatorSubstituicao.FieldByName('fatorsubstituicao').AsFloat;
    end;
  end
  else
  if ContribICMS and VendaConsumidorFinal {and not ResponsavelDifal} then
  begin
    if IPINCM <> 0 then
    begin
      RefazConsultaPorNome(qryFatorSubstituicaoIPI,
           ['UF_CliForSaida_ou_FilialEntrada','IPINCM'],
           [EstadoSubstituicao,
            IPINCM]);
      fFatorSubstituicao := qryFatorSubstituicaoIPI.FieldByName('fatorsubstituicao').AsFloat;
    end
    else
    begin
      RefazConsultaPorNome(qryFatorSubstituicao,
           ['UF_CliForSaida_ou_FilialEntrada','produto','TipoPessoa'],
           [EstadoSubstituicao,
            produto,
            PessoaTipo]);
      fFatorSubstituicao := qryFatorSubstituicao.FieldByName('fatorsubstituicao').AsFloat;
    end;

    if fFatorSubstituicao <> 0 then
      fFatorSubstituicao := 1;
  end;

  result := fFatorSubstituicao;
end;


