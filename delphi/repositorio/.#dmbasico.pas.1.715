procedure TdtmBasico.DataModuleCreate(Sender: TObject);
begin
{
  if vLogHabilitado then
  begin
     ZMonitor.onMonitorEvent := ZMonitorMonitorEvent;
     ZMonitor.Transaction := dtmTecSoft.tstTecSoft;
     MensagemAviso('Atenção! Log do banco de dados habilitado! O sistema ficará mais lento.');
  end;
  }
  ApplicationHandleException := ApplicationHandleException_;
  ApplicationShowException := ApplicationShowException_;


end;

function TdtmBasico.getqry_Estados_: TtecQuery;
begin
  if fqry_Estados_ = nil then
  begin
   fqry_Estados_             := TTecQuery.Create(nil);
   fqry_Estados_ .Database    := dtmTecSoft.Database;
   fqry_Estados_.sql.text := SQLEstados;
  end;
  result := fqry_Estados_;
end;

{
function TdtmBasico.DifalNaOrigem(EstadoSubstituicao: String): boolean;
begin
  RefazConsultaPorNome(qryEstados, ['estado'], [EstadoSubstituicao]);
  fDifalnaOrigem := qryEstados.fieldByname('responsaveldifal').asBoolean;
  fBaseDupla := qryEstados.fieldByname('basedupla').asBoolean;
end;
}

function TdtmBasico.AutorizacaoAnalistaCredito(RequerSenhaQualidadeVenda: Boolean;
                                        CodigoQualidadeVenda: Integer;
                                        Numero: String;
                                        TipoQualidadeVenda : tpQualidadeVenda): Boolean;
var
//  UsrAut: TtecUsuarios;
  SQL: String;
  qryTabela: TtecQuery;

begin
  result := false;

  qryTabela := TtecQuery.Create(nil);
  qryTabela.Database := dtmTecSoft.Database;
  qryTabela.CachedUpdates := true;
  qryTabela.RequestLive := true;

  case TipoQualidadeVenda of
    tpQVOrcamento : qryTabela.sql.text := 'select o.codigo, o.qualidade_venda, o.analistacredito from orcamentos o where o.codigo = '+numero;
    tpQVContrato,
    tpQVContratoFaturamento
      : qryTabela.sql.text := 'select ct.numero, ct.qualidade_venda, ct.analistacredito from contratos ct where ct.numero = '+quotedstr(numero);
  end;
  qryTabela.Open;

  if RequerSenhaQualidadeVenda and
    (CodigoQualidadeVenda <>  //Calculado no momento
     qryTabela.fieldbyname('qualidade_venda').asInteger) then //gravado anteriormente
  begin

    UsuarioAutAux := ObterAutorizacao(taLOGIN, 'Qualidade da Venda', 'Analista de Crédito', '');

    if Assigned(UsuarioAutAux) then
    begin

      if UsuarioAutAux.AnalistaCredito then
      begin
        result := true;
        qryTabela.edit;
        qryTabela.fieldbyname('qualidade_venda').asInteger := CodigoQualidadeVenda;
        qryTabela.fieldbyname('analistacredito').asInteger := UsuarioAutAux.CodigoUsuario;
        qryTabela.post;
        perpetrar([qryTabela]);
      end
      else
      begin
        result := false;
        MensagemAviso('A Autorização requer um Analista de Crédito.');
      end;

      case TipoQualidadeVenda of
        tpQVOrcamento,
        tpQVContrato : freeandnil(UsuarioAutAux);
      end;

    end
    else
    begin
      result := false;
      MensagemAviso('A Autorização requer um Analista de Crédito.');
    end;

  end
  else
    result := true;
end;

procedure TdtmBasico.AtualizarHashJ(dadofiscal: integer);
var
  qryAtualizarHashJ: TtecQuery;
begin
{
  qryAtualizarHashJ := TtecQuery.Create(nil);
  qryAtualizarHashJ.Database := dtmTecSoft.Database;
  qryAtualizarHashJ.Sql.Text := 'select IncluirRegistros_J(' + inttostr(dadofiscal) + ')';
  qryAtualizarHashJ.Open;

  qryAtualizarHashJ.Sql.Text := 'select hash_paf_registro_j(' + inttostr(dadofiscal) + ')';
  qryAtualizarHashJ.Open;

  AtualizaHashInclusaoExclusao;
  }

end;



function TdtmBasico.GerarNotaEletronica(qryDadosFiscais,
  qryDadosFiscaisRef, qryProdutosDadosFiscais,
  qryProdutosDadosFiscaisCompostos, qryServicosDadosFiscais,
  qryVenctosDadosFiscais, qryVolumesDadosFiscais, qryLacresDadosFiscais,
  qryImportacoes, qryAdicoes, qryImpostosRetidosDadosFiscais: TtecQuery; SerieSugestao, Tipo: String;
  qryCupons: TTecQuery; Regerando: boolean; qryContatos,
  qryTotaisRecebimentos: TTecQuery; Procedimento: TtecProcedimento;
  Validando: Boolean; qryContratos, qryNotas,
  qrymovimentos: TtecQuery;
  somenteatualizarnfse : Boolean;
  VendasOperacoes: Boolean;
  NFCe: Boolean): Boolean;
var
  ChaveAcesso, LoteNFe, ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, xMotivo: String;
  qryDadosFiscaisstateinicial : TDataSetState;
  vListaNFeEmailValidos, vListaBoletoEmailValidos, vListaNFeTranspEmailValidos : String;
  vListaBoletos, vListaBoletosAux : TStringList;

  function CondicaoNFeServico: boolean;
  begin
    result := (qryServicosDadosFiscais <> nil) and (qryServicosDadosFiscais.recordcount <> 0)
  end;


  function CondicaoGerarNfe: boolean;
  begin
    result := true;
    if qryContratos<>nil then
    begin
      result := (qryContratos.fieldbyname('situacao').asString = 'F') or
                (qryContratos.fieldbyname('situacao').asString = 'N') or
                (qryContratos.fieldbyname('situacao').asString = 'P');

    end;
  end;

  Function SituacaoContrato: String;
  begin
    result := 'N';
    if qryContratos<>nil then
      result := qryContratos.fieldbyname('situacao').asString;
  end;

  procedure SetarInformacoesDadosFiscais;
  begin
    qryDadosFiscais.Edit;
    qryDadosFiscais.fieldbyname('nrdocumento').AsInteger   := qryNotas.fieldbyname('numero').AsInteger;

    if qryDadosFiscais.fieldbyname('modelodocto').IsNull then
      qryDadosFiscais.fieldbyname('modelodocto').AsString  := '55';


    MontarInfComplementar(qryDadosFiscais);


    if (ftipoemissaonfeservico in [Florianopolis_SoftPlan, Palhoca_IPM]) and CondicaoNFeServico then
    begin
      qryDadosFiscais.fieldbyname('versaolayout').AsCurrency := 2.0;
//      qryDadosFiscais.fieldbyname('ambiente').AsInteger      := NFSeAmbiente;
      qryDadosFiscais.fieldbyname('ambientenfs').AsInteger      := NFSeAmbiente;
      qryDadosFiscais.fieldbyname('versaoteclux').AsString   := VersaoTecLUX;

//      {Ao enviar a nfse já seta o status como enviada, para que fique pendente no controle caso o envio não ocorra} esqueçe...
{
      case ftipoemissaonfeservico of
        Florianopolis_SoftPlan : qryDadosFiscais.FieldByName('statusnfse').AsString := '0';
        Palhoca_IPM : qryDadosFiscais.FieldByName('statusnfse').AsString := '1';
      end;
}
      
    end
    else
    begin
      qryDadosFiscais.fieldbyname('codaleatorio').AsInteger  := Aleatorio(qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('nrdocumento').asString);

      qryDadosFiscais.fieldbyname('versaolayout').AsCurrency := 3.10;
      { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
      qryDadosFiscais.fieldbyname('formapagto').AsInteger    := 2;

      if not NFCe then
      begin
        { 1-Retrato/ 2-Paisagem 4 (danfe-nfce) e 5 (danfe-nfce-mensagem-eletrônica) }
        qryDadosFiscais.fieldbyname('formatodanfe').AsInteger  := 1;
        {1-Normal/ 2-Contingência}
        qryDadosFiscais.fieldbyname('formaemissao').AsInteger  := NFeTipoEmissao;
      end
      else
        { 1-Retrato/ 2-Paisagem 4 (danfe-nfce) e 5 (danfe-nfce-mensagem-eletrônica) }
         qryDadosFiscais.fieldbyname('formatodanfe').AsInteger  := 4;


      ChaveAcesso := copy(CodigoCidadeIBGEFilialBase,1,2)+                       // 2
                     FormatDateTime('YYMM',qryDadosFiscais.fieldbyname('data').AsDateTime)+      // 4
    //                                   ifthen(NFeAmbiente=2,'99999999000198',preencheString(CNPJFilialBase,'0',14,false))+  // 14
                     preencheString(CNPJFilialBase,'0',14,false)+  // 14
                     preencheString(qryDadosFiscais.fieldbyname('modelodocto').AsString,'0',2,false)+ // 2
                     preencheString(SerieSugestao,'0',3,false)+                  // 3
                     preencheString(qryDadosFiscais.fieldbyname('nrdocumento').Asstring,'0',9,false) + // 9
                     qryDadosFiscais.fieldbyname('formaemissao').Asstring + // 1
                     preencheString(qryDadosFiscais.fieldbyname('codaleatorio').Asstring,'0',8,false); //8


      qryDadosFiscais.fieldbyname('digchaveacesso').AsString := Modulo11(ChaveAcesso);
      qryDadosFiscais.fieldbyname('chv_nfe').AsString := ChaveAcesso + qryDadosFiscais.fieldbyname('digchaveacesso').AsString;

    //             modulo11(ChaveAcesso,'98765432',false);

      {1 - PRODUÇÃO 2 - HOMOLOGAÇÃO}
      qryDadosFiscais.fieldbyname('ambiente').AsInteger      := NFeAmbiente;// '2';


      //sem este IF NÃO ESTAVA SENDO POSSIVEL FAZER NOTA DE DEVOLUCAO A FORNECEDOR ........ JR 29/12
      {1 - normal 2 - compelementar}
      if (qryDadosFiscais.findfield('dadofiscalcomplementar')<>nil) and
         (qryDadosFiscais.fieldByName('dadofiscalcomplementar').asInteger<>0) then
        qryDadosFiscais.fieldbyname('finalidadenf').AsInteger  := 2
      else
      if ((qryDadosFiscais.fieldbyname('finalidadenf').IsNull) or
          (qryDadosFiscais.fieldbyname('finalidadenf').AsInteger=0)) then
         qryDadosFiscais.fieldbyname('finalidadenf').AsInteger  := 1;

      qryDadosFiscais.fieldbyname('procemissao').AsString    := '0';
      qryDadosFiscais.fieldbyname('versaoteclux').AsString   := VersaoTecLUX;

    end;

    qryDadosFiscais.post;
    perpetrar([qryDadosFiscais]);

  end;

  procedure SetarInformacoesNfe;
  begin

//    NFe.Executavel           := NFeExecNFe;
//    NFe.DiretorioEnvioNFSe    := NFSeDirEnvio;
//    NFe.DiretorioRetornoNFSe  := NFSeDirRetorno;
//    NFe.DiretorioErroNFSe  := NFSeDirErro;


//    NFe.DiretorioEnvio       := fNFeDirEnvio;
//    NFe.DiretorioEnviado     := fNFeDirEnviados;
//    NFe.DiretorioRetorno     := fNFeDirRetorno;
//    NFe.DiretorioCompartilha := fNfeDirCompartilha;

        // EMITENTE
    NFe.Emit_Documento := CNPJFilialBase;
    NFe.Emit_Nome      := RazaoFilialBase;
    NFe.Emit_Rua       := RuaSemNumeroFilialBase;
    NFe.Emit_Nro       := NumeroFilialBase;
    NFe.Emit_Compl     := ComplementoFilialBase;
    NFe.Emit_Bairro    := BairroFilialBase;
    NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
    NFe.Emit_Mun       := CidadeFilialBase;
    NFe.Emit_UF        := EstadoFilialBase;
    NFe.Emit_CEP       := CEPFilialBase;
    NFe.Emit_Fone      := DDDFilialBase+fFoneFilialBase;
    NFe.Emit_IE        := InscricaoEstadualFilialBase;
    NFe.Emit_IM        := InscricaoMunicipalFilialBase;
    NFe.Emit_CNAE      := CNAEFiscalFilialBase;
    NFe.Emit_CRT       := RegimeTributario;

    // DESTINATARIO

    if (SituacaoContrato[1] in ['N', 'P']) then
    begin
      NFe.Dest_TipoPessoa := qryDadosFiscais.fieldbyname('pessoatipo').AsString;
      NFe.Dest_Documento := qryDadosFiscais.fieldbyname('pessoanumero').AsString;
      NFe.Dest_Nome      := qryDadosFiscais.fieldbyname('nome').AsString;

      NFe.Dest_Rua       := qryDadosFiscais.fieldbyname('rua').AsString;
      NFe.Dest_Nro       := qryDadosFiscais.fieldbyname('endnumero').AsString;
      NFe.Dest_Compl     := qryDadosFiscais.fieldbyname('endcomplemento').AsString;
      NFe.Dest_Bairro    := qryDadosFiscais.fieldbyname('nomebairro').AsString;
      NFe.Dest_CodMun    := qryDadosFiscais.fieldbyname('cidadeibge').AsString;
      NFe.Dest_Mun       := qryDadosFiscais.fieldbyname('nomecidade').AsString;
      NFe.Dest_UF        := qryDadosFiscais.fieldbyname('estado').AsString;
      NFe.Dest_CEP       := qryDadosFiscais.fieldbyname('cep').AsString;
      NFe.Dest_CodPais   := qryDadosFiscais.fieldbyname('pais').AsInteger;
      NFe.Dest_Pais      := qryDadosFiscais.fieldbyname('nomepais').AsString;

      if (qryDadosFiscais.fieldbyname('foneddd').AsString <> '') and
         (qryDadosFiscais.fieldbyname('fonenumero').AsString <> '') then
        NFe.Dest_Fone      := qryDadosFiscais.fieldbyname('foneddd').AsString+qryDadosFiscais.fieldbyname('fonenumero').AsString
     else
        NFe.Dest_Fone      := '';

      NFe.Dest_IE        := qryDadosFiscais.fieldbyname('documento').AsString;
//      NFe.Dest_ISUF      := qryDadosFiscais.fieldbyname('iesubsttributario').AsString;
      NFe.Dest_ISUF      := qryDadosFiscais.fieldbyname('suframa').AsString;

      // ENTREGA

      NFe.Entrega_TipoPessoa := qryDadosFiscais.fieldbyname('localentrega_pessoatipo').AsString;
      NFe.Entrega_Documento := qryDadosFiscais.fieldbyname('localentrega_cnpj').AsString;

      if qryDadosFiscais.findfield('entnomedestinatario') <> nil then
        nfe.Entrega_Nome      := qryDadosFiscais.fieldbyname('entnomedestinatario').AsString;

      NFe.Entrega_Rua       := qryDadosFiscais.fieldbyname('localentrega_rua').AsString;
      NFe.Entrega_Nro       := qryDadosFiscais.fieldbyname('localentrega_numero').AsString;
      NFe.Entrega_Compl     := qryDadosFiscais.fieldbyname('localentrega_complemento').AsString;
      NFe.Entrega_Bairro    := qryDadosFiscais.fieldbyname('localentrega_nomebairro').AsString;
      NFe.Entrega_CodMun    := qryDadosFiscais.fieldbyname('localentrega_cidadeibge').AsString;
      NFe.Entrega_Mun       := qryDadosFiscais.fieldbyname('localentrega_nomecidade').AsString;
      NFe.Entrega_UF        := qryDadosFiscais.fieldbyname('localentrega_estado').AsString;
      NFe.Entrega_CEP       := qryDadosFiscais.fieldbyname('localentrega_cep').AsString;

    end
    else
    begin
      NFe.Dest_TipoPessoa := qryContratos.FieldByName('pessoatipo').AsString;
      NFe.Dest_Documento := qryContratos.FieldByName('pessoanumero').AsString;
      NFe.Dest_Nome      := qryContratos.FieldByName('nome').AsString;
      NFe.Dest_Rua       := qryContratos.FieldByName('rua').AsString;
      NFe.Dest_Nro       := qryContratos.FieldByName('endnumero').AsString;
      NFe.Dest_Compl     := qryContratos.FieldByName('endcomplemento').AsString;

      if qryContratos.FieldByName('estado').AsString = '.' then
      begin
        NFe.Dest_CodPais := qryContratos.FieldByName('codigoibgecidadedest').AsInteger;
        NFe.Dest_Pais  := qryContratos.FieldByName('nomecidade').AsString;
        NFe.Dest_Mun  := qryContratos.FieldByName('nomebairro').AsString;
        NFe.Dest_Bairro := '';
        NFe.Dest_CodMun := '';
        NFe.Dest_CEP := '';
      end
      else
      begin
        NFe.Dest_CodPais  := 1058;
        NFe.Dest_Pais := 'Brasil';
        NFe.Dest_Mun := qryContratos.FieldByName('nomecidade').AsString;
        NFe.Dest_Bairro := qryContratos.FieldByName('nomebairro').AsString;
        NFe.Dest_CodMun := qryContratos.FieldByName('codigoibgecidadedest').AsString;
        NFe.Dest_CEP := qryContratos.FieldByName('cep').AsString;
      end;
      NFe.Dest_UF        := qryContratos.FieldByName('estado').AsString;
      if (qryContratos.FieldByName('foneddd').AsString<>'') and
         (qryContratos.FieldByName('fonenumero').AsString<>'') then
         NFe.Dest_Fone      := qryContratos.FieldByName('foneddd').AsString+qryContratos.FieldByName('fonenumero').AsString
      else
         NFe.Dest_Fone := '';

      NFe.Dest_IE        := qryContratos.FieldByName('iddocumento').AsString;
//        NFe.Dest_ISUF      := qryDadosFiscais.fieldbyname('iesubsttributario').AsString;
      NFe.Dest_ISUF      := qryContratos.fieldbyname('suframa').AsString;

      // ENTREGA

      NFe.Entrega_TipoPessoa := qryContratos.FieldByName('pessoatipo').AsString;
      NFe.Entrega_Documento := qryContratos.FieldByName('pessoanumero').AsString;
      if qryContratos.Findfield('entnomedestinatario')<> nil then
        nfe.Entrega_Nome      := qryContratos.FieldByName('entnomedestinatario').AsString;

      NFe.Entrega_Rua       := qryContratos.FieldByName('entrua').AsString;
      NFe.Entrega_Nro       := qryContratos.FieldByName('entnumero').AsString;
      NFe.Entrega_Compl     := qryContratos.FieldByName('entcomplemento').AsString;
      NFe.Entrega_Bairro    := qryContratos.FieldByName('nomebairroentrega').AsString;
      NFe.Entrega_CodMun    := qryContratos.FieldByName('codigoibgecidadeentrega').AsString;
      NFe.Entrega_Mun       := qryContratos.FieldByName('nomecidadeentrega').AsString;
      NFe.Entrega_UF        := qryContratos.FieldByName('entestado').AsString;
      NFe.Entrega_CEP       := qryContratos.FieldByName('entcep').AsString;

    end;

  end;

begin
  vListaNFeEmailValidos := '';
  vListaNFeTranspEmailValidos := '';

  vListaBoletoEmailValidos := '';
  vListaBoletos := TSTringList.create;

  try

    if CondicaoGerarNfe then
    begin
      qryDadosFiscaisstateinicial := qryDadosFiscais.state;

      if not assigned(NFE) then
        NFE := TTecNotaFiscalEletronica.create;

      nfe.codigoVerificacao_NFPSe := '';
      nfe.numeroSerie_NFPSe := '';
      nfe.status_NFPSe := '';
      nfe.DataHoraProcessamento_NFPSe := '';
      nfe.link_nfse := '';
      nfe.DataEmissao_NFPSe := '';
      nfe.dataCancelamento_NFPSe := '';


      nfe.Validando := Validando;

      if validando then
        NFE.CriarListaErro(dtmTecSoft.Database);

      if not Validando then
        SetarInformacoesDadosFiscais;

      SetarInformacoesNfe;

      try

        try
          if not Validando then
          begin
            ShowProcessando('Gerando o arquivo da NF-e!');
            Sleep(500);
          end;

          result := true;

          if (ftipoemissaonfeservico in [Florianopolis_SoftPlan {, Palhoca_IPM}]) and CondicaoNFeServico then
            result := ValidarAliquotaGrade(qryDadosFiscais, qryServicosDadosFiscais);

          if result then
          begin
          
            Result := NFe.GerarNFe(qryDadosFiscais,qryDadosFiscaisRef,qryProdutosDadosFiscais, qryProdutosDadosFiscaisCompostos,
                         qryServicosDadosFiscais, qryVenctosDadosFiscais, qryVolumesDadosFiscais,
                         qryLacresDadosFiscais, qryImportacoes, qryAdicoes, SerieSugestao,'S',qryCupons, false, qrycontatos, qryTotaisRecebimentos,
                         Procedimento, qryNotas, qryImpostosRetidosDadosFiscais );
          end;

          ShowProcessando;


          if result and (ftipoemissaonfeservico in [Palhoca_IPM]) and CondicaoNFeServico and somenteatualizarnfse then
          begin
            result := AtualizaSituacaoNFPSe(qryDadosFiscais, qryNotas);
            nfe.Validando := false;
            if Docxml <> nil then
              Docxml := nil;
          end;

          if Result and not Validando then
          begin

            if (ftipoemissaonfeservico in [Florianopolis_SoftPlan, Palhoca_IPM]) and CondicaoNFeServico then
            begin
              result := AtualizaSituacaoNFPSe(qryDadosFiscais, qryNotas);


              if result then
                result := ImprimirNotafiscalServico_(qryDadosFiscais.fieldbyname('numero').asInteger,
                             nfe.NomedoArquivoCompartilhado);

              if result then
              begin

                if (UsuarioLogin.PortaSmtp  <> '') and
                   (UsuarioLogin.HostSmtp   <> '') and
                   (UsuarioLogin.Email      <> '') and
                   (UsuarioLogin.SenhaEmail <> '') then
                begin

                  ListaStringEmailValido(ListadeEmails('DF', qryDadosFiscais.fieldbyname('numero').AsInteger, false), vListaNFeEmailValidos, true);
                  ListaStringEmailValido(ListadeEmails('DF', qryDadosFiscais.fieldbyname('numero').AsInteger, true), vListaNFeTranspEmailValidos, true);

                  if (ValorCampodaTabela('planos',['codigo'],[qryDadosFiscais.fieldbyname('plano').asString], ['enviarboletoemail'])[0]<>Null) and
                     (ValorCampodaTabela('planos',['codigo'],[qryDadosFiscais.fieldbyname('plano').asString], ['enviarboletoemail'])[0]) then
                  begin
                    if ListaStringEmailValido(ListadeEmailsBoleto('DF', qryDadosFiscais.fieldbyname('numero').AsInteger), vListaBoletoEmailValidos, true) then
                    begin
                      if vListaBoletoEmailValidos<>'' then
                        TdtmImprimeBoleto.GerarBoletoPDF(qryDadosFiscais.fieldbyname('contrato').AsString, vListaBoletos);
                    end;
                  end;

                  if (vListaNFeEmailValidos = vListaBoletoEmailValidos) then
                     vListaBoletosAux := vListaBoletos
                  else
                     vListaBoletosAux := nil;

                  if vListaNFeEmailValidos<>'' then
                  begin
                    ShowProcessando('Enviando email da NFe para o cliente');
                    try
                      if not NFe.EnviarEmail(UsuarioLogin.Email, vListaNFeEmailValidos,
                                          qryNotas.FieldByName('numero').AsString, qryNotas.fieldbyname('serie').AsString, IntToStr(fFilialBase),
                                          qryDadosFiscais.fieldbyname('contrato').asString,
                                          fNomeFilialBase, fRazaoFilialBase, fCNPJFilialBase, fDDDFilialBase, fFoneFilialBase,
                                          fDDDFaxFilialBase, fFaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                                          UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                          qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('valortotal').AsCurrency,
                                          UsuarioLogin.AutenticarSMTP, qryDadosFiscais.fieldbyname('data').AsDateTime,  vListaBoletosAux,
                                          false, false, true ) then

                            MensagemAviso('Ocorreu um erro inesperado no envio do email da nfe');

                    finally
                      ShowProcessando;
                    end;
                  end;

                  if vListaNFeTranspEmailValidos<>'' then
                  begin
                    ShowProcessando('Enviando email da NFe para a transportadora');
                    try
                      if not NFe.EnviarEmail(UsuarioLogin.Email, vListaNFeTranspEmailValidos,
                                          qryNotas.FieldByName('numero').AsString, qryNotas.fieldbyname('serie').AsString, IntToStr(fFilialBase),
                                          qryDadosFiscais.fieldbyname('contrato').asString,
                                          fNomeFilialBase, fRazaoFilialBase, fCNPJFilialBase, fDDDFilialBase, fFoneFilialBase,
                                          fDDDFaxFilialBase, fFaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                                          UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                          qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('valortotal').AsCurrency,
                                          UsuarioLogin.AutenticarSMTP, qryDadosFiscais.fieldbyname('data').AsDateTime, nil,
                                          false, false, true, true) then

                            MensagemAviso('Ocorreu um erro inesperado no envio do email da nfe');

                    finally
                      ShowProcessando;
                    end;
                  end;



                  if ((vListaNFeEmailValidos <> vListaBoletoEmailValidos) and
                      (vListaBoletoEmailValidos<>'') and
                      (vListaBoletos.count<>0)) then
                  begin
                    ShowProcessando('Enviando email dos boletos para o cliente');
                    try

                      if not NFe.EnviarEmail(UsuarioLogin.Email, vListaBoletoEmailValidos,
                                          qryNotas.FieldByName('numero').AsString, qryNotas.fieldbyname('serie').AsString, IntToStr(fFilialBase),
                                          qryDadosFiscais.fieldbyname('contrato').asString,
                                          fNomeFilialBase, fRazaoFilialBase, fCNPJFilialBase, fDDDFilialBase, fFoneFilialBase,
                                          fDDDFaxFilialBase, fFaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                                          UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                          qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('valortotal').AsCurrency,
                                          UsuarioLogin.AutenticarSMTP, qryDadosFiscais.fieldbyname('data').AsDateTime, vListaBoletos, true ) then

                            MensagemAviso('Ocorreu um erro inesperado no envio do email dos boletos');

                    finally
                      ShowProcessando;
                    end;

                  end;
                end;


              end;

              if Docxml <> nil then
                Docxml := nil;

            end
            else
            begin

              if ((NFeTipoEmissao in [1,3]) and not NFCe) or

                 ({(qryDadosFiscais.fieldbyname('formaemissao').AsString = '1')}
                  (NFE.Tipo_de_Emissao_UniNfe = '1') and NFCe) then

              begin

                ShowProcessando;
                ShowProcessando('Verificando status do serviço NF-e!');
                Sleep(500);

                if ((NFeTipoEmissao in [1,3]) and not NFCe) then
                begin
                  Result := NFe.VerificarStatusServico(IntToStr(fNFeAmbiente));
                  if Result then
                  begin
                    ShowProcessando;
                    ShowProcessando('Processando o arquivo de envio da NF-e!');
                    Sleep(500);
                    Result := NFe.EnviarNFe(ChaveAcesso + qryDadosFiscais.FieldByName('digchaveacesso').AsString, LoteNFe, ReciboNFe);
                    if Result then
                    begin
                      qryDadosFiscais.Edit;
                      qryDadosFiscais.FieldByName('numlotenfe').AsString   := LoteNFe;
                      qryDadosFiscais.FieldByName('numrecibonfe').AsString := ReciboNFe;
                      qryDadosFiscais.Post;
                      Result := perpetrar([qryDadosFiscais]);
                      if Result then
                      begin
                        ShowProcessando;
                        ShowProcessando('Consultando o arquivo de retorno da NF-e!');
                        Sleep(500);
                        Result := NFe.ConsultarSituacaoLote(ReciboNFe, ProtocoloNFe, status, DataHoraProcessamento, IntToStr(fNFeAmbiente));

                        if Result then
                        begin
                          qryDadosFiscais.Edit;
                          qryDadosFiscais.FieldByName('numprotocolonfe').AsString := ProtocoloNFe;
                          qryDadosFiscais.FieldByName('statusnfe').AsString := status;
                          qryDadosFiscais.FieldByName('dhprocnfe').Asdatetime := FormatarTimeStamp(DataHoraProcessamento);
                          qryDadosFiscais.Post;
                        end;
                      end;
                    end;
                  end;
                end
                else
                if ({(qryDadosFiscais.fieldbyname('formaemissao').AsString = '1')}
                    (NFE.Tipo_de_Emissao_UniNfe = '1') and NFCe) then
                begin

                  vTtecRetornoEnvioNFCe := NFe.EnviarNFCe(ChaveAcesso + qryDadosFiscais.FieldByName('digchaveacesso').AsString, LoteNFe, ReciboNFe, ProtocoloNFe, status, xMotivo, DataHoraProcessamento);
                  case vTtecRetornoEnvioNFCe of

                    ArquivosRetornados :
                    begin
                      qryDadosFiscais.Edit;
                      qryDadosFiscais.fieldbyname('numlotenfe').AsString   := LoteNFe;
                      qryDadosFiscais.fieldbyname('numrecibonfe').AsString := ReciboNFe;
                      qryDadosFiscais.fieldbyname('numprotocolonfe').AsString := ProtocoloNFe;
                      qryDadosFiscais.fieldbyname('statusnfe').AsString := status;
                      qryDadosFiscais.fieldbyname('dhprocnfe').AsDateTime :=  FormatarTimeStamp(DataHoraProcessamento);

                      qryDadosFiscais.Post;
                      Result := Perpetrar([qryDadosFiscais]);
                    end;

                    EntraremContingencia:
                    begin
                      parsistema.RazaoContingenciaNFCe := 'TEMPO MÁXIMO DE ESPERA ESGOTADO';
                      result := false;
                    end;

                  else
                    result := false;
                  end;

                end
                else
                if {(qryDadosFiscais.fieldbyname('formaemissao').AsString = '9')}
                   (NFE.Tipo_de_Emissao_UniNfe = '9') then
                begin
                  try

                    if NFe.RetornoValidacaoAssinatura then
                    begin
                      Result := Perpetrar([qryDadosFiscais]);
                      vTtecRetornoEnvioNFCe := xmlcontigenciagerado;

                      {if not NFeVisualizarDANFE then
                        MensagemAviso('Impressão da Nota Fiscal será iniciada.');}

                      try

                        NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                        qryDadosFiscais.fieldbyname('filialemissao').AsString,
                                        qryNotas.fieldbyname('Serie').asString,
                                        qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                                        qryDadosFiscais.fieldbyname('localentrega_cep').AsString,
                                        qryDadosFiscais.fieldbyname('email').AsString,
                                        IntToStr(NFeNVias), NFeLogotipoDANFE,
                                        ParSistema.NomeImpressoraNFCe, NFeVisualizarDANFE,
                                        qryDadosFiscais.fieldbyname('data').AsDateTime,
                                        qryProdutosDadosFiscais, NFeExecDANFE, Procedimento, 'S', 0, false,
                                        qryDadosFiscais.fieldbyname('modelodocto').asString);

                      except
                        on E: Exception do
                        begin
                          MensagemAviso(E.Message + 'Erro ao Imprimir a DANFE');
                          result := false;
                          ShowProcessando;
                        end;
                      end;

                    end
                    else
                    begin
                      vTtecRetornoEnvioNFCe := ErroValidacaoXMLContigencia;
                      result := false;
                    end;

                  except
                    on E: Exception do
                    begin
                      vTtecRetornoEnvioNFCe := ErroValidacaoXMLContigencia;
                      result :=false;
//                      vMensagemExcessao := E.Message;
                    end;
                  end;
                  ShowProcessando;
                end;


                if (qryDadosFiscais.FieldByName('statusnfe').AsString = '301') or
                   (qryDadosFiscais.FieldByName('statusnfe').AsString = '302') then
                begin
                  LimparCampos(qryProdutosDadosFiscais, [qryProdutosDadosFiscais.fieldbyname('movimento')]);
                  qryDadosFiscais.Edit;
                  qryDadosFiscais.FieldByName('situacao').AsString := 'D';
                  qryDadosFiscais.Post;

//                        VoltarSituacaoContrato(SituacaoAtual, false);

                  LimparTabela(qrymovimentos);
                  Result := Perpetrar([qryProdutosDadosFiscais, qryMovimentos, qryDadosFiscais]);
                  MensagemAviso('Nota fiscal em uso denegado.');
                end
                else
                begin
                  Perpetrar([qryDadosFiscais]);
                  if Result then
                  begin

                    ShowProcessando;
                    ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
                    Sleep(500);
                    result := NFe.CompartilharXML(ChaveAcesso+qryDadosFiscais.fieldbyname('digchaveacesso').AsString,
                                        ReciboNFe, qryDadosFiscais.fieldbyname('filialemissao').AsString,
                                        SerieSugestao, qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                                        qryDadosFiscais.fieldbyname('data').AsDateTime, LoteNFe);
                    if result then
                      SalvarConteudoxml(tipo, qryDadosFiscais.fieldbyname('numero').asString);

                    ShowProcessando;


                   { if not VendasOperacoes then }
                     {if not fNFeVisualizarDANFE then
                        MensagemAviso('Impressão da Nota Fiscal será iniciada.'); }

                    NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                      qryDadosFiscais.fieldbyname('filialemissao').AsString,
                                      SerieSugestao,
                                      qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                                      qryDadosFiscais.fieldbyname('localentrega_cep').AsString,
                                      qryDadosFiscais.fieldbyname('email').AsString,
                                      IntToStr(fNFeNVias), fNFeLogotipoDANFE,

                                      IfThen_(NFCe, ParSistema.NomeImpressoraNFCe, ParSistema.NomeImpressoraNotaMercadorias),

                                      ifThen_(VendasOperacoes, FNFeVisualizarDANFEVendasOperacoes, fNFeVisualizarDANFE),
                                      qryDadosFiscais.fieldbyname('data').AsDateTime,
                                      qryProdutosDadosFiscais,
                                      fNFeExecDANFE,
                                      Enviar, 'S', 0, VendasOperacoes,
                                      qryDadosFiscais.fieldbyname('modelodocto').asString);


                    ShowProcessando;

                    if (UsuarioLogin.PortaSmtp  <> '') and
                       (UsuarioLogin.HostSmtp   <> '') and
                       (UsuarioLogin.Email      <> '') and
                       (UsuarioLogin.SenhaEmail <> '') then
                    begin

                      ListaStringEmailValido(ListadeEmails('DF', qryDadosFiscais.fieldbyname('numero').AsInteger), vListaNFeEmailValidos, true);
                      ListaStringEmailValido(ListadeEmails('DF', qryDadosFiscais.fieldbyname('numero').AsInteger, true), vListaNFeTranspEmailValidos, true);

                      vListaBoletosAux := nil;
                      if (qryDadosFiscais.findfield('plano')<>nil)
                         and (qryDadosFiscais.fieldbyname('plano').asString<>'')
                         and eHNotaFiscalSaidaVenda(qryDadosFiscais.fieldbyname('codigofiscal').asinteger) then
                      begin

                        if (ValorCampodaTabela('planos',['codigo'],[qryDadosFiscais.fieldbyname('plano').asString], ['enviarboletoemail'])[0]<>Null) and
                           (ValorCampodaTabela('planos',['codigo'],[qryDadosFiscais.fieldbyname('plano').asString], ['enviarboletoemail'])[0]) then

                        begin
                          if ListaStringEmailValido(ListadeEmailsBoleto('DF', qryDadosFiscais.fieldbyname('numero').AsInteger), vListaBoletoEmailValidos, true) then
                          begin
                            if vListaBoletoEmailValidos<>'' then
                              TdtmImprimeBoleto.GerarBoletoPDF(qryDadosFiscais.fieldbyname('contrato').AsString, vListaBoletos);
                          end;
                        end;

                        if (vListaNFeEmailValidos = vListaBoletoEmailValidos) then
                           vListaBoletosAux := vListaBoletos
                        else
                           vListaBoletosAux := nil;

                      end;


                      if vListaNFeEmailValidos<>'' then
                      begin
                        ShowProcessando('Enviando email da NFe para o cliente');
                        try
                          if not NFe.EnviarEmail(UsuarioLogin.Email, vListaNFeEmailValidos,

                                              qryDadosFiscais.fieldbyname('nrdocumento').AsString, SerieSugestao, IntToStr(fFilialBase),
                                              qryDadosFiscais.fieldbyname('contrato').asString,
                                              fNomeFilialBase, fRazaoFilialBase, fCNPJFilialBase, fDDDFilialBase, fFoneFilialBase,
                                              fDDDFaxFilialBase, fFaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                                              UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                              qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('valortotal').AsCurrency,
                                              UsuarioLogin.AutenticarSMTP, qryDadosFiscais.fieldbyname('data').AsDateTime, vListaBoletosAux) then
                            MensagemAviso('Ocorreu um erro inesperado no envio do email da nfe');

                        finally
                          ShowProcessando;
                        end;
                      end;

                      if vListaNFeTranspEmailValidos<>'' then
                      begin
                        ShowProcessando('Enviando email da NFe para a transportadora');
                        try
                          if not NFe.EnviarEmail(UsuarioLogin.Email, vListaNFeTranspEmailValidos,

                                              qryDadosFiscais.fieldbyname('nrdocumento').AsString, SerieSugestao, IntToStr(fFilialBase),
                                              qryDadosFiscais.fieldbyname('contrato').asString,
                                              fNomeFilialBase, fRazaoFilialBase, fCNPJFilialBase, fDDDFilialBase, fFoneFilialBase,
                                              fDDDFaxFilialBase, fFaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                                              UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                              qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('valortotal').AsCurrency,
                                              UsuarioLogin.AutenticarSMTP, qryDadosFiscais.fieldbyname('data').AsDateTime, nil, false, false, false, true) then
                            MensagemAviso('Ocorreu um erro inesperado no envio do email da nfe');

                        finally
                          ShowProcessando;
                        end;
                      end;



                      if ((vListaNFeEmailValidos <> vListaBoletoEmailValidos) and (vListaBoletoEmailValidos<>'')) then
                      begin

                        ShowProcessando('Enviando email dos boletos para o cliente');
                        try

                          if not NFe.EnviarEmail(UsuarioLogin.Email, vListaBoletoEmailValidos,

                                              qryDadosFiscais.fieldbyname('nrdocumento').AsString, SerieSugestao, IntToStr(fFilialBase),
                                              qryDadosFiscais.fieldbyname('contrato').asString,
                                              fNomeFilialBase, fRazaoFilialBase, fCNPJFilialBase, fDDDFilialBase, fFoneFilialBase,
                                              fDDDFaxFilialBase, fFaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                                              UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                                              qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('valortotal').AsCurrency,
                                              UsuarioLogin.AutenticarSMTP, qryDadosFiscais.fieldbyname('data').AsDateTime, vListaBoletos, true) then

                                MensagemAviso('Ocorreu um erro inesperado no envio do email dos boletos');

                        finally
                          ShowProcessando;
                        end;

                      end;

                    end;


                  end
                  else
                    ShowProcessando;

                end;

              end
              else
              if nfce then
              begin

                if {(qryDadosFiscais.FieldByName('formaemissao').AsString = '9')}
                   (NFE.Tipo_de_Emissao_UniNfe = '9')  {Casos em que gerou normal e entrou em contigencia ex. perda comunicação}

                then
                begin
                  try

                    if NFe.RetornoValidacaoAssinatura then
                    begin
                      Result := Perpetrar([qryDadosFiscais]);
                      vTtecRetornoEnvioNFCe := xmlcontigenciagerado;

                       {
                      if not NFeVisualizarDANFE then
                        MensagemAviso('Impressão da Nota Fiscal será iniciada.');
                        }

                      try

                        NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                        qryDadosFiscais.FieldByName('filialemissao').AsString,
                                        qryNotas.FieldByName('Serie').asString,
                                        qryDadosFiscais.FieldByName('nrdocumento').AsString,
                                        qryDadosFiscais.FieldByName('localentrega_cep').AsString,
                                        qryDadosFiscais.FieldByName('email').AsString,
                                        IntToStr(NFeNVias), NFeLogotipoDANFE,
                                        ParSistema.NomeImpressoraNFCe, NFeVisualizarDANFE,
                                        qryDadosFiscais.FieldByName('data').AsDateTime,
                                        qryProdutosDadosFiscais, NFeExecDANFE, Procedimento, 'S',
                                        0, false, qryDadosFiscais.fieldbyname('modelodocto').asString
                                        );

                      except
                        on E: Exception do
                        begin
                          MensagemAviso(E.Message + 'Erro ao Imprimir a DANFE');
                          result := false;
                          ShowProcessando;
                        end;
                      end;

                    end
                    else
                    begin
                      result := true;
                      vTtecRetornoEnvioNFCe := ErroValidacaoXMLContigencia;
                    end;

                  except
                    on E: Exception do
                    begin

                      vTtecRetornoEnvioNFCe := ErroValidacaoXMLContigencia;
                      result := false;
//                      vMensagemExcessao := E.Message;
                    end;
                  end;
                  ShowProcessando;
                end;

              end
              else
              begin
               {
                if not VendasOperacoes then
                   if not NFeVisualizarDANFE then
                     MensagemAviso('Impressão da Nota Fiscal será iniciada.');}

                NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                                  qryDadosFiscais.fieldbyname('filialemissao').AsString,
                                  SerieSugestao,
                                  qryDadosFiscais.fieldbyname('nrdocumento').AsString,
                                  qryDadosFiscais.fieldbyname('localentrega_cep').AsString,
                                  qryDadosFiscais.fieldbyname('email').AsString,
                                  IntToStr(NFeNVias), NFeLogotipoDANFE,
                                  ParSistema.NomeImpressoraNotaMercadorias,

                                  ifThen_(VendasOperacoes, FNFeVisualizarDANFEVendasOperacoes, fNFeVisualizarDANFE),

                                  qryDadosFiscais.fieldbyname('data').AsDateTime,
                                  qryProdutosDadosFiscais, NFeExecDANFE, Enviar, 'S', 0, VendasOperacoes,
                                  qryDadosFiscais.fieldbyname('modelodocto').asString);
              end;

              if not result and (qryDadosFiscais.state = dsedit) and
                 (qryDadosFiscaisstateinicial <> dsedit) then
                qryDadosFiscais.cancel;

              if Docxml <> nil then
                Docxml := nil;

            end;

          end
          else
          begin
            if Validando then
            begin
              if not Result then
                vTtecRetornoEnvioNFCe := Erro
              else
                vTtecRetornoEnvioNFCe := TesteValidacaoOK;
            end
            else
            begin
              if not result then
                vTtecRetornoEnvioNFCe := Erro;
              result := True;
            end;

                  {
            if Validando and not Result then
            begin
              vTtecRetornoEnvioNFCe := Erro;
              result := false
            end
            else
            if validando and Result then
            begin
              vTtecRetornoEnvioNFCe := TesteValidacaoOK;
              result := true;
            end
            else
            if not result then
              vTtecRetornoEnvioNFCe := Erro;
              }

          end;
        except
           on E : Exception do
           begin
              MensagemAviso(E.ClassName + ' erro na emissão da NFE: ' + E.Message);
              Result := False;
           end;
        end;

      finally
      {
        if not validando then
          FreeAndNil(NFe);
          }
      end;

    end;
  finally
    vListaBoletos.free;
  end;
end;


procedure TdtmBasico.RecuperarArquivoxml(tipo, chave, nomedoarquivo: string;  Cancelamento_ou_Inutilizacao: boolean = false; CartaCorrecao: boolean = false);
var
  SQL: String;
  qryRecuperarxml: TtecQuery;
begin
  qryRecuperarxml := TtecQuery.Create(nil);
  qryRecuperarxml.Database := dtmTecSoft.Database;

  if Cancelamento_ou_Inutilizacao then
  begin
    if tipo = 'S' then
      SQL := 'select numero, xmlnfe_canc_inut from dadosfiscais where numero = ' + chave
    else
    if tipo = 'E' then
      SQL := 'select codigo, xmlnfe_canc_inut from notaspag where codigo = ' + chave;
  end
  else
  if CartaCorrecao then
    SQL := 'select codigo, xmlnfecc from cartas_correcao where codigo = ' + chave
  else
  begin
    if tipo = 'S' then
      SQL := 'select numero, xmlnfe from dadosfiscais where numero = ' + chave
    else
    if tipo = 'E' then
      SQL := 'select codigo, xmlnfe from notaspag where codigo = ' + chave;
  end;

  qryRecuperarxml.Sql.Text := SQL;

  qryRecuperarxml.open;
  if Cancelamento_ou_Inutilizacao then
    tMemoField(qryRecuperarxml.fieldbyname('xmlnfe_canc_inut')).savetofile(nomedoarquivo)
  else
  if CartaCorrecao then
    tMemoField(qryRecuperarxml.fieldbyname('xmlnfecc')).savetofile(nomedoarquivo)
  else
    tMemoField(qryRecuperarxml.fieldbyname('xmlnfe')).savetofile(NomedoArquivo);
end;

procedure TdtmBasico.SalvarConteudoxml(tipo, Chave: String; Cancelamento_ou_Inutilizacao: boolean; CartaCorrecao: boolean);
var
  SQL: String;
//  qryGravarxml: TtecQuery;
begin
  if fileexists(nfe.NomedoArquivoCompartilhado) then
  begin
  {
    qryGravarxml := TtecQuery.Create(nil);
    qryGravarxml.Database := dtmTecSoft.Database;
    qryGravarxml.CachedUpdates := true;
    qryGravarxml.RequestLive := true;
    }

    if Cancelamento_ou_Inutilizacao then
    begin
      if tipo = 'S' then
        SQL := 'select numero, xmlnfe_canc_inut from dadosfiscais where numero = ' + chave
      else
      if tipo = 'E' then
        SQL := 'select codigo, xmlnfe_canc_inut from notaspag where codigo = ' + chave;
    end
    else
    if CartaCorrecao then
      SQL := 'select codigo, xmlnfecc from cartas_correcao where codigo = ' + chave
    else
    begin
      if tipo = 'S' then
        SQL := 'select numero, xmlnfe from dadosfiscais where numero = ' + chave
      else
      if tipo = 'E' then
        SQL := 'select codigo, xmlnfe from notaspag where codigo = ' + chave;
    end;

    qryGravarxml.Sql.Text := SQL;

    qryGravarxml.open;
    qryGravarxml.edit;
    if Cancelamento_ou_Inutilizacao then
      tMemoField(qryGravarxml.fieldbyname('xmlnfe_canc_inut')).loadfromfile(nfe.NomedoArquivoCompartilhado)
    else
    if CartaCorrecao then

      tMemoField(qryGravarxml.fieldbyname('xmlnfecc')).loadfromfile(nfe.NomedoArquivoCompartilhado)
    else
      tMemoField(qryGravarxml.fieldbyname('xmlnfe')).loadfromfile(nfe.NomedoArquivoCompartilhado);

    qryGravarxml.post;
    perpetrar([qryGravarxml]);

//    qryGravarxml.free;
  end
{  else
    MensagemAviso('Arquivo: ' + nfe.NomedoArquivoCompartilhado + ' não encontrado')};

end;

{
function TdtmBasico.ExigeNumeroSerie(Produto: String): boolean;
begin
  if not assigned(qryCaracteristas) then
  begin
    qryCaracteristas := TTecQuery.Create((nil));
    qryCaracteristas.Database  := dtmTecSoft.Database;
    qryCaracteristas.sql.text  := 'select c.* from caracteristicas c where c.codigo = (select p.caracteristica from produtos p where p.codigo = :produto');
  end;

  ReFazConsultaPorNome(qryCaracteristas,['produto'],[Produto]);
  result := qryCodigosFiscais.fieldByName('ExigeNumeroSerie').asBoolean;
end;
}

