function TdtmBasico.SelecionarDadosNaturezaPadrao(Descricao: String; Natureza,
   Produtos, Nota: TTecQuery; OrigemCalculo : TtecOrigemCalculo = NotaAvulsa;
   EstadoDestino: String = ''; ReajustarCodigoFiscal: Boolean = True): boolean;

  procedure PreencherValoresInfComplementar;
  var
     ArrayDadosFiscais : TVariantArray;
     ArrayNotas : TVariantArray;

  begin
    if ehNotaFiscalSaidaSimplesRemessa(qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger) then
      if nota.fieldbyname('infcomplementar').AsString <> '' then
        if nota.findfield('dadofiscalsimplesfaturamento') <> nil then
          if nota.fieldbyname('dadofiscalsimplesfaturamento').asInteger <> 0 then
          begin

            ArrayDadosFiscais := ValorCampodaTabela('dadosfiscais', ['numero'],
               [nota.fieldbyname('dadofiscalsimplesfaturamento').asString], ['modelodocto','data', 'valortotal']);

            ArrayNotas := ValorCampodaTabela('notas', ['dadofiscal'],
               [nota.fieldbyname('dadofiscalsimplesfaturamento').asString], ['serie','numero']);


            nota.fieldbyname('infcomplementar').AsString := Trocar(nota.fieldbyname('infcomplementar').AsString, '<modelo>', ArrayDadosFiscais[0]);
            nota.fieldbyname('infcomplementar').AsString := Trocar(nota.fieldbyname('infcomplementar').AsString, '<data>', formatDateTime('dd/mm/yyyy', ArrayDadosFiscais[1]));
            nota.fieldbyname('infcomplementar').AsString := Trocar(nota.fieldbyname('infcomplementar').AsString, '<valortotalnota>', formatfloat('###,##0.00', ArrayDadosFiscais[2]));
            nota.fieldbyname('infcomplementar').AsString := Trocar(nota.fieldbyname('infcomplementar').AsString, '<serie>', ArrayNotas[0]);
            nota.fieldbyname('infcomplementar').AsString := Trocar(nota.fieldbyname('infcomplementar').AsString, '<numero>', ArrayNotas[1]);


          end;
  end;
begin
  result := True;

  if ((descricao <> '') and qryNaturezasPadrao_.Locate('descricao',descricao,[])) or
      ((OrigemCalculo = CadastroPedidos) and qryNaturezasPadrao_.Locate('natureza', Produtos.fieldbyname('natureza').asinteger,[]) )  then
  begin
    vNaturezaPadraoAtribuida := true;

    if produtos <> nil then
      SelecionarDadosNatureza(qryNaturezasPadrao_, Produtos);

    if (Nota <> nil) then
    begin
      if Nota.Findfield('naoutilizarobsautomaticas')<>nil then
        Nota.FieldByName('naoutilizarobsautomaticas').AsBoolean := qryNaturezasPadrao_.FieldByName('naoutilizarobsautomaticas').AsBoolean;

      if Nota.Findfield('natureza')<>nil then
        Nota.FieldByName('natureza').AsString := qryNaturezasPadrao_.FieldByName('descricaonatureza').AsString;
    end;

    case OrigemCalculo of
      Contrato:
      begin
        if (produtos = nil) and (Nota <> nil) then
        begin
          Nota.fieldbyname('codigonatureza').asinteger := qryNaturezasPadrao_.fieldbyname('natureza').AsInteger;
          Nota.fieldbyname('codigofiscal').AsInteger   := qryNaturezasPadrao_.fieldbyname('codigofiscal').AsInteger;
          nota.fieldbyname('infcomplementar').AsString := qryNaturezasPadrao_.fieldbyname('infcomplementar').AsString;

          PreencherValoresInfComplementar;

          if (qryNaturezasPadrao_.FieldByName('tipo').AsString = 'S') or
             (qryNaturezasPadrao_.FieldByName('tipo').AsString = 'R') then  {E Entrada S Saída R Serviços}
            if not ((qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger = 8000) or
                    (qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger = 5929)) then

              if not (nota.fieldbyname('estado').asstring = EstadoFilialBase) then
                if HeUnidadeFederacao(nota.fieldbyname('estado').asstring) then
                begin
                  if qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger = ctVENDASUBSTITUIDODENTROESTADO then
                    nota.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+999
                  else
                    nota.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+1000;
                end
                else
                  nota.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+2000;
        end
        else
        begin
          if (produtos <> nil) and (Nota <> nil) then

            if ehNotaFiscalSaidaSimplesFaturamento(qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger) or
               ehNotaFiscalSaidaSimplesRemessa(qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger) then
            begin
              {Simples Faturamento:
               Nesta modadlidade, simples faturamento, o icms somente na entrega ou seja na simples remessa;
               sendo revenda para terceiros, não contém ipi,
               sendo revenda para terceiros, o pis/cofins se dá no simples faturamento

               Simples Remessa: neste item vai o icms e o ipi acumulado ao valor do preço visto que já foi efetuado no simples faturamento }

              if qryNaturezasPadrao_.FieldByName('icmscst').AsString <> '' then
                produtos.fieldbyname('incidencia').asstring := qryNaturezasPadrao_.FieldByName('icmscst').AsString;
              {Simples Faturamento: normalmente vai assumir o que esta na natureza, forçando uma não tributação}
              {Simples Remessa: normalmente vai assumir o que esta no cadastro de produtos seguindo uma venda normal }

              if qryNaturezasPadrao_.FieldByName('csosn').AsString <> '' then
                produtos.fieldbyname('csosn').AsString      := qryNaturezasPadrao_.FieldByName('csosn').AsString;
              {Simples Faturamento: normalmente vai assumir o que esta na natureza, forçando uma não tributação}
              {Simples Remessa: normalmente vai assumir o que esta no cadastro de produtos seguindo uma venda normal }

              if qryNaturezasPadrao_.FieldByName('ipicst').AsString <> '' then
                produtos.fieldbyname('ipicst').AsString     := qryNaturezasPadrao_.FieldByName('ipicst').AsString;
              {Simples Faturamento: normalmente vai assumir o que esta no cadastro de produtos, se tributado ou não, (não temos clientes com IPI}
              {Simples Remessa: normalmente vai assumir o que esta na natureza visto que assumimos o ipi no simples faturamento }

              if qryNaturezasPadrao_.FieldByName('piscst').AsString <> '' then
                produtos.fieldbyname('piscst').AsString     := qryNaturezasPadrao_.FieldByName('piscst').AsString;
              {Simples Faturamento: normalmente vai assumir o que esta no cadastro de produtos, nossos casos, revenda para terceiros}
              {Simples Remessa: normalmente vai assumir o que esta na natureza visto que assumimos o pis no simples faturamento }

              if qryNaturezasPadrao_.FieldByName('cofinscst').AsString <> ''  then
                produtos.fieldbyname('cofinscst').AsString  := qryNaturezasPadrao_.FieldByName('cofinscst').AsString;
              {Simples Faturamento: normalmente vai assumir o que esta no cadastro de produtos, nossos casos, revenda para terceiros}
              {Simples Remessa:normalmente vai assumir o que esta na natureza visto que assumimos o cofins no simples faturamento }

            end;

            if (qryNaturezasPadrao_.FieldByName('tipo').AsString = 'S') or
               (qryNaturezasPadrao_.FieldByName('tipo').AsString = 'R') then  {E Entrada S Saída R Serviços}

               if not ((qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger = 8000) or
                       (qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger = 5929)) then

                if not (nota.fieldbyname('estado').asstring = EstadoFilialBase) then
                  if HeUnidadeFederacao(nota.fieldbyname('estado').asstring) then
                  begin
                    if qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger = ctVENDASUBSTITUIDODENTROESTADO then
                      produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+999
                    else
                      produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+1000;
                  end
                  else
                    produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+2000;
        end;
      end;

      NotaAvulsa, OrdemdeServico :
      begin
        if Natureza <> nil then
        begin
          Natureza.MacroByName('CodigoNaturezaPadrao').AsString := 'and n.codigo = '+Produtos.FieldByName('natureza').AsString;
          Natureza.ParamByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger;
        end;

        if not ((qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger = 8000) or
                (qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger = 5929)) then

          if not (nota.fieldbyname('estadocfo').asstring = EstadoFilialBase) then
            if HeUnidadeFederacao(nota.fieldbyname('estadocfo').asstring) then
            begin
              if qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger = ctVENDASUBSTITUIDODENTROESTADO then
                Produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+999
              else
                Produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+1000;
            end
            else
              Produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+2000;

        if Natureza <> nil then
          Natureza.ParamByName('codigofiscal').AsInteger := Produtos.FieldByName('codigofiscal').AsInteger;

        if OrigemCalculo = OrdemdeServico then
        begin
          Nota.Fieldbyname('codigofiscal').AsInteger := Produtos.FieldByName('codigofiscal').AsInteger;
          Nota.Fieldbyname('codigonatureza').AsInteger := Produtos.FieldByName('natureza').AsInteger;
          Nota.Fieldbyname('natureza').AsString := descricao;
        end;
      end;

      TransferenciaSaida :
      begin
        if qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger <> 8000 then
          if not (EstadoDestino = EstadoFilialBase) then
            if HeUnidadeFederacao(EstadoDestino) then
            begin
              if qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger = ctVENDASUBSTITUIDODENTROESTADO then
                Produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+999
              else
                Produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+1000;
            end
            else
              Produtos.FieldByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger+2000;
      end;

      TransferenciaEntrada :
      begin
        if produtos<>nil then
        begin
          if HeUnidadeFederacao(nota.fieldbyname('estado').asString) then
          begin
            if nota.fieldbyname('estado').asstring = EstadoFilialBase then
              Produtos.FieldByName('codigofiscal').AsInteger := 1000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000
            else
              Produtos.FieldByName('codigofiscal').AsInteger := 2000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000;
          end
          else
            Produtos.FieldByName('codigofiscal').AsInteger := 3000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000;
        end;

        if nota<>nil then
        begin
          nota.FieldByName('codigonatureza').asinteger := qryNaturezasPadrao_.FieldByName('natureza').AsInteger;
          nota.FieldByName('natureza').asString := qryNaturezasPadrao_.FieldByName('descricao').AsString;

          if HeUnidadeFederacao(nota.fieldbyname('estado').asString) then
          begin
            if nota.fieldbyname('estado').asstring = EstadoFilialBase then
              nota.FieldByName('codigofiscal').AsInteger := 1000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000
            else
              nota.FieldByName('codigofiscal').AsInteger := 2000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000;
          end
          else
            nota.FieldByName('codigofiscal').AsInteger := 3000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000;
        end;
      end;


      NotaEntrada, NotaEntradaXML, Troca, Devolucao:
      begin
        if Natureza <> nil then
        begin
          Natureza.MacroByName('CodigoNaturezaPadrao').AsString := 'and naturezas.codigo = '+Produtos.FieldByName('natureza').AsString;
          Natureza.ParamByName('codigofiscal').AsInteger := qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger;
        end;

        if ReajustarCodigoFiscal then
        begin
          if HeUnidadeFederacao(nota.fieldbyname('estado').asString) then
          begin
            if nota.fieldbyname('estado').asstring = EstadoFilialBase then
              Produtos.FieldByName('codigofiscal').AsInteger := 1000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000
            else
              Produtos.FieldByName('codigofiscal').AsInteger := 2000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000;
          end
          else
            Produtos.FieldByName('codigofiscal').AsInteger := 3000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000;
        end
        else
          Produtos.FieldByName('codigofiscal').AsInteger := 1000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000;


        if (produtos.findfield('descricaocodigofiscal')<>nil) then
          Produtos.FieldByName('descricaocodigofiscal').AsString    := qryNaturezasPadrao_.FieldByName('descricaocodigofiscal').AsString;

        if (produtos.findfield('descricaonatureza')<>nil) then
          Produtos.FieldByName('descricaonatureza').AsString    := qryNaturezasPadrao_.FieldByName('descricaonatureza').AsString;

        if Natureza <> nil then
          Natureza.ParamByName('codigofiscal').AsInteger := Produtos.FieldByName('codigofiscal').AsInteger;

        if (OrigemCalculo in [Troca, Devolucao]) then
        begin
          Produtos.fieldbyname('ipicst').asstring := qryNaturezasPadrao_.fieldbyname('ipicst').AsString;
          Produtos.fieldbyname('cofinscst').AsString := qryNaturezasPadrao_.fieldbyname('cofinscst').AsString;
          Produtos.fieldbyname('piscst').AsString := qryNaturezasPadrao_.fieldbyname('piscst').AsString;
        end;

      end;

      CadastroPedidos :
      begin
        if Natureza <> nil then
        begin
          if Natureza.Params.FindParam('natureza')<>nil then
            Natureza.Parambyname('natureza').Asinteger := Produtos.FieldByName('natureza').AsInteger;

          if Natureza.Params.FindParam('codigofiscal')<>nil then
            Natureza.ParamByName('codigofiscal').AsInteger := Produtos.FieldByName('codigofiscal').AsInteger;

          Natureza.close;
          Natureza.Open;

        end;

        if HeUnidadeFederacao(nota.fieldbyname('estado').asString) or (nota.fieldbyname('estado').asstring='') then
        begin
          if (nota.fieldbyname('estado').asstring = EstadoFilialBase) or (nota.fieldbyname('estado').asString='') then
            Produtos.FieldByName('codigofiscal').AsInteger := 1000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000
          else
            Produtos.FieldByName('codigofiscal').AsInteger := 2000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000;
        end
        else
          Produtos.FieldByName('codigofiscal').AsInteger := 3000 + qryNaturezasPadrao_.FieldByName('codigofiscal').AsInteger mod 1000;

        if (produtos.findfield('descricaocodigofiscal')<>nil) then
          Produtos.FieldByName('descricaocodigofiscal').AsString    := qryNaturezasPadrao_.FieldByName('descricaocodigofiscal').AsString;

        if (produtos.findfield('descricaonatureza')<>nil) then
          Produtos.FieldByName('descricaonatureza').AsString    := qryNaturezasPadrao_.FieldByName('descricaonatureza').AsString;


         {
        if (OrigemCalculo in [Troca, Devolucao]) then
        begin
          Produtos.fieldbyname('ipicst').asstring := qryNaturezasPadrao_.fieldbyname('ipicst').AsString;
          Produtos.fieldbyname('cofinscst').AsString := qryNaturezasPadrao_.fieldbyname('cofinscst').AsString;
          Produtos.fieldbyname('piscst').AsString := qryNaturezasPadrao_.fieldbyname('piscst').AsString;
        end;
        }
      end;

    end;

    if Natureza <> nil then
    begin
      if OrigemCalculo <> CadastroPedidos then
      begin
        Natureza.close;
        Natureza.Open;
        Natureza.MacroByName('CodigoNaturezaPadrao').AsString := '';
      end;

      if natureza.IsEmpty then
      begin
        result := False;
        CancelarAtualizacoes([]);
        MensagemErro('CÓDIGO FISCAL VINCULADO A NATUREZA NÃO ENCONTRADO');
      end;
    end;

  end
  else
  begin
    result := False;
    CancelarAtualizacoes([]);
    MensagemErro('NATUREZA PADRÃO NÃO ENCONTRADA');
  end;
end;


function TdtmBasico.AtribuirDadosCalculosImpostos(qryNotaFiscal, qryProcuraProdutoNotaFiscal, qryProcuraNaturezasProduto: TtecQuery;
                                                  var qryProdutosNotaFiscal: TTecQuery; OrigemCalculo : TtecOrigemCalculo;
                                                  ReverNatureza: boolean;
                                                  DescricaoNatureza: String = '';
                                                  EstadoDestino: String = ''
                                                  ): Boolean;
var
  vAuxregimetributario : integer;
{  DadosFilial : TVariantArray;}
  vQueryNatureza : TTecQuery;

  function PossuiNDI: boolean;
  begin
    result := false;
    if (qryNotaFiscal<>nil) and (qryNotaFiscal.FindField('ndi')<>nil) then
      result := not qryNotaFiscal.fieldbyname('ndi').IsNull;
  end;

  function cancelamentonfforaprazolegal: boolean;
  begin
   result := false;
     if (OrigemCalculo in [NotaEntrada, Devolucao, Troca]) then
      result := (qryNotaFiscal.FindField('cancelamentonfforaprazolegal')<>nil) and
                 (qryNotaFiscal.fieldbyname('cancelamentonfforaprazolegal').AsBoolean)

  end;

  function ValorCSTICMS: String;
  begin
    result := qryProcuraProdutoNotaFiscal.fieldbyname('incidencia').AsString;
  end;

  function ValorCSOSNICMS: String;
  begin
    result := qryProcuraProdutoNotaFiscal.fieldbyname('csosn').AsString;
  end;



begin
  vNaturezaPadraoAtribuida := false;

  case OrigemCalculo of

    NotaAvulsa :
    begin
      if ReverNatureza then
      begin
        if (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 202) //Devolução sem st e entrou c/ st
           and NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao('DEVOLUÇÃO COMPRA COMERCIALIZAÇÃO SUBST. TRIB.', qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 411) //Devolução st mas não entrou com st
           and not NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao('DEVOLUÇÃO DE COMPRA PARA COMERCIALIZAÇÃO', qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
          SelecionarDadosNatureza(qryProcuraNaturezasProduto, qryProdutosNotaFiscal);
      end
      else
        SelecionarDadosNatureza(qryProcuraNaturezasProduto, qryProdutosNotaFiscal);
    end;

    NotaEntrada, NotaEntradaXML, Devolucao, Troca :
    begin
      if ReverNatureza then
      begin
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 202)) or //Devolução de venda de mercadoria adquirida ou recebida de terceiros
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 202))
           and NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS, ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIASUBSTTRIB, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 411)) or //Devolução de venda de mercadoria adquirida ou recebida de terceiros st
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 411))
           and not NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIA, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 201)) or //Devolução de venda de produção do estabelecimento   ADICIONAR NP
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 201))
           and NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noDEVMERCPRODPROPRIA, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 410)) or //Devolução de venda de produção do estabelecimento em operação com produto sujeito ao regime de substituição tributária  ADICIONAR NP
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 410))
           and not NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noDEVMERCPRODPROPRIAST, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 101)) or //Compra para industrialização
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 101))
           and NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noCOMPRAINDSUBSTTRIBUT, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 401)) or //Compra para industrializacao st  ADICIONAR NP
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 401))
           and not NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noCOMPRAIND, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 102))  or //Compra para comercialização  ADICIONAR NP
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 102))
           and NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noCOMPRACOMERCSUBSTTRIBUT, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 403)) or //Compra para comercialização st
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 403))
           and not NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noCOMPRACOMERC, qryProcuraNaturezasProduto, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
          SelecionarDadosNatureza(qryProcuraNaturezasProduto, qryProdutosNotaFiscal);
      end
      else
        SelecionarDadosNatureza(qryProcuraNaturezasProduto, qryProdutosNotaFiscal);
    end;

    CadastroPedidos :
    begin
     { DadosFilial := ValorCampodaTabela('filiais', ['codigo'], [qryNotaFiscal.fieldbyname('filialfatura').asstring], ['regimetributario']);}

{      if DadosFilial[0]<>null then}
      if qryNotaFiscal.fieldbyname('regimetributario').asinteger <> 0 then
        vAuxRegimetributario := qryNotaFiscal.fieldbyname('regimetributario').asinteger
      else
        vAuxRegimetributario := regimetributario;

      if qryProcuraNaturezasProduto <> nil then
        vQueryNatureza := qryProcuraNaturezasProduto
      else
      begin
        vQueryNatureza := qryNaturezasPadrao_;
        if not qryNaturezasPadrao_.Locate('natureza', qryProdutosNotaFiscal.fieldbyname('natureza').asinteger,[]) then
        begin
          result := false;
          MensagemAutoClose('Natureza Padrão', format('Código da natureza %s não foi encontrado',[qryProdutosNotaFiscal.fieldbyname('natureza').asString]), 10);
        end;

      end;

      if ReverNatureza then
      begin

        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 202)) or //Devolução de venda de mercadoria adquirida ou recebida de terceiros
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 202))
           and NotaSubstituicao(ifthen(vAuxRegimetributario=1,ValorCSOSNICMS,ValorCSTICMS), True, vAuxRegimetributario) then
          SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIASUBSTTRIB, vQueryNatureza, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 411)) or //Devolução de venda de mercadoria adquirida ou recebida de terceiros st
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 411))
           and not NotaSubstituicao(ifthen(vAuxRegimetributario=1,ValorCSOSNICMS,ValorCSTICMS), True, vAuxRegimetributario) then
          SelecionarDadosNaturezaPadrao(noDEVOLUCAOMERCADORIA, vQueryNatureza, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)

        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 201)) or //Devolução de venda de produção do estabelecimento   ADICIONAR NP
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 201))
           and NotaSubstituicao(ifthen(vAuxRegimetributario=1,ValorCSOSNICMS,ValorCSTICMS), True, vAuxRegimetributario) then
          SelecionarDadosNaturezaPadrao(noDEVMERCPRODPROPRIA, vQueryNatureza, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 410)) or //Devolução de venda de produção do estabelecimento em operação com produto sujeito ao regime de substituição tributária  ADICIONAR NP
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 410))
           and not NotaSubstituicao(ifthen(vAuxRegimetributario=1,ValorCSOSNICMS,ValorCSTICMS), True, vAuxRegimetributario) then
          SelecionarDadosNaturezaPadrao(noDEVMERCPRODPROPRIAST, vQueryNatureza, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)

        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 101)) or //Compra para industrialização
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 101))
           and NotaSubstituicao(ifthen(vAuxRegimetributario=1,ValorCSOSNICMS,ValorCSTICMS), True, vAuxRegimetributario) then
          SelecionarDadosNaturezaPadrao(noCOMPRAINDSUBSTTRIBUT, vQueryNatureza, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 401)) or //Compra para industrializacao st  ADICIONAR NP
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 401))
           and not NotaSubstituicao(ifthen(vAuxRegimetributario=1,ValorCSOSNICMS,ValorCSTICMS), True, vAuxRegimetributario) then
          SelecionarDadosNaturezaPadrao(noCOMPRAIND, vQueryNatureza, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)

        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 102))  or //Compra para comercialização  ADICIONAR NP
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 102))
           and NotaSubstituicao(ifthen(vAuxRegimetributario=1,ValorCSOSNICMS,ValorCSTICMS), True, vAuxRegimetributario) then
          SelecionarDadosNaturezaPadrao(noCOMPRACOMERCSUBSTTRIBUT, vQueryNatureza, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
        if (((qryNotaFiscal.findfield('codigofiscal')<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 403)) or //Compra para comercialização st
            (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 403))
           and not NotaSubstituicao(ifthen(vAuxRegimetributario=1,ValorCSOSNICMS,ValorCSTICMS), True, vAuxRegimetributario) then
          SelecionarDadosNaturezaPadrao(noCOMPRACOMERC, vQueryNatureza, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo)
        else
          SelecionarDadosNatureza(vQueryNatureza, qryProdutosNotaFiscal);
      end
      else
        SelecionarDadosNatureza(vQueryNatureza, qryProdutosNotaFiscal);
    end;

    TransferenciaSaida :
    begin
      SelecionarDadosNaturezaPadrao(DescricaoNatureza, nil, qryProdutosNotaFiscal, nil, OrigemCalculo, EstadoDestino );
      if ReverNatureza then
      begin
        if (((qryNotaFiscal<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 102)) or //VENDAS DE MERCADORIAS
            ((qryProdutosNotaFiscal<>nil) and (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 102)))
           and NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noVENDAS_TRANSFERENCIA_ENTRE_EMPRESAST, nil, qryProdutosNotaFiscal, nil, OrigemCalculo, EstadoDestino)
        else
        if (((qryNotaFiscal<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 405)) or //VENDAS ICMS SUBSTITUIÇÃO
            ((qryProdutosNotaFiscal<>nil) and (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 405)))
           and not NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noVENDAS_TRANSFERENCIA_ENTRE_EMPRESA, nil, qryProdutosNotaFiscal, nil, OrigemCalculo, EstadoDestino)
        else
        if (((qryNotaFiscal<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 202)) or //DEVOLUÇÃODE MERCADORIAS
            ((qryProdutosNotaFiscal<>nil) and (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 202)))
           and NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noSAIDADEVOLUCAO_TRANSFERENCIA_ENTRE_EMPRESAST, nil, qryProdutosNotaFiscal, nil, OrigemCalculo, EstadoDestino)
        else
        if (((qryNotaFiscal<>nil) and (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 411)) or //DEVOLUÇÃODE MERCADORIAS ST
            ((qryProdutosNotaFiscal<>nil) and (qryProdutosNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 411)))
           and not NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
          SelecionarDadosNaturezaPadrao(noSAIDADEVOLUCAO_TRANSFERENCIA_ENTRE_EMPRESA, nil, qryProdutosNotaFiscal, nil, OrigemCalculo, EstadoDestino);

      end;
    end;

    TransferenciaEntrada :
    begin
      if (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 102) or       //Compra para comercialização
         (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 403) then     //Compra para comercialização st
      begin
        if NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
           SelecionarDadosNaturezaPadrao(noCOMPRAS_TRANSFERENCIA_ENTRE_EMPRESAST, nil, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo, EstadoDestino)
        else
           SelecionarDadosNaturezaPadrao(noCOMPRAS_TRANSFERENCIA_ENTRE_EMPRESA, nil, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo, EstadoDestino);
      end
      else
      if (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 202) or       //Devolução
         (qryNotaFiscal.fieldbyname('codigofiscal').AsInteger mod 1000 = 411) then     //Devolução st
      begin
        if NotaSubstituicao(ifthen(regimetributario=1,ValorCSOSNICMS,ValorCSTICMS)) then
           SelecionarDadosNaturezaPadrao(noENTRADADEVOLUCAO_TRANSFERENCIA_ENTRE_EMPRESAST, nil, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo, EstadoDestino)
        else
           SelecionarDadosNaturezaPadrao(noENTRADADEVOLUCAO_TRANSFERENCIA_ENTRE_EMPRESA, nil, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo, EstadoDestino);
      end
      else
        SelecionarDadosNaturezaPadrao(noTRANSFERENCIAMERCADORIASENTRADA, nil, qryProdutosNotaFiscal, qryNotaFiscal, OrigemCalculo, EstadoDestino);
    end;
  end;


  // obedecer primeiro a natureza da nota se:
  if not cancelamentonfforaprazolegal then
  begin

    if PossuiNDI then
    begin
      qryProdutosNotaFiscal.FieldbyName('incidencia').AsString := '00';
      qryProdutosNotaFiscal.FieldbyName('csosn').AsString := '900';
    end
    else
    if (qryProcuraNaturezasProduto<>nil) and
       (((regimetributario=1) and (qryProcuraNaturezasProduto.fieldbyname('csosn').AsString <> '')) or     //eh do simples e tem csosn na natureza do produto
        ((regimetributario<>1) and (qryProcuraNaturezasProduto.fieldbyname('icmscst').AsString <> ''))) then   // não eh do simples e tem cst na natureza do produto
    begin
      qryProdutosNotaFiscal.FieldbyName('incidencia').AsString := qryProcuraNaturezasProduto.fieldbyname('icmscst').AsString;
      qryProdutosNotaFiscal.FieldbyName('csosn').AsString := qryProcuraNaturezasProduto.fieldbyname('csosn').AsString;
    end
    else
    if  vNaturezaPadraoAtribuida and
       (((regimetributario=1) and (qryNaturezasPadrao_.fieldbyname('csosn').AsString <> '')) or     //eh do simples e tem csosn na natureza do produto
        ((regimetributario<>1) and (qryNaturezasPadrao_.fieldbyname('icmscst').AsString <> ''))) then   // não eh do simples e tem cst na natureza do produto
    begin
      qryProdutosNotaFiscal.FieldbyName('incidencia').AsString := qryNaturezasPadrao_.fieldbyname('icmscst').AsString;
      qryProdutosNotaFiscal.FieldbyName('csosn').AsString := qryNaturezasPadrao_.fieldbyname('csosn').AsString;
    end
    else
    // senão obedecer o cadastro do produto se:
    if ((regimetributario=1) and (ValorCSOSNICMS <> '')) or   //eh do simples e tem csosn no cadastro do produto
       ((regimetributario<>1) and (ValorCSTICMS <> '')) then // não eh do simples e tem cst no cadastro do produto
    begin
      qryProdutosNotaFiscal.FieldbyName('incidencia').AsString := ValorCSTICMS;
      qryProdutosNotaFiscal.FieldbyName('csosn').AsString      := ValorCSOSNICMS;
    end;

    if (qryProcuraNaturezasProduto<>nil) and (qryProcuraNaturezasProduto.FieldByName('ipicst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
      qryProdutosNotaFiscal.FieldByName('ipicst').AsString    := qryProcuraNaturezasProduto.FieldByName('ipicst').AsString
    else
    if vNaturezaPadraoAtribuida and (qryNaturezasPadrao_.FieldByName('ipicst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
      qryProdutosNotaFiscal.FieldByName('ipicst').AsString    := qryNaturezasPadrao_.FieldByName('ipicst').AsString
    else
    if qryProcuraProdutoNotaFiscal.FieldByName('ipicst').AsString <> '' then  // VALOR DO IPICST NO CADASTRO DO PRODUTO
      qryProdutosNotaFiscal.FieldByName('ipicst').AsString := qryProcuraProdutoNotaFiscal.FieldByName('ipicst').AsString;

    if (qryProcuraNaturezasProduto<>nil) and (qryProcuraNaturezasProduto.FieldByName('piscst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
      qryProdutosNotaFiscal.FieldByName('piscst').AsString    := qryProcuraNaturezasProduto.FieldByName('piscst').AsString
    else
    if vNaturezaPadraoAtribuida and (qryNaturezasPadrao_.FieldByName('piscst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
      qryProdutosNotaFiscal.FieldByName('piscst').AsString    := qryNaturezasPadrao_.FieldByName('piscst').AsString
    else
    if qryProcuraProdutoNotaFiscal.FieldByName('piscst').AsString <> '' then  // VALOR DO PISCST NO CADASTRO DO PRODUTO
      qryProdutosNotaFiscal.FieldByName('piscst').AsString := qryProcuraProdutoNotaFiscal.FieldByName('piscst').AsString;

    if (qryProcuraNaturezasProduto<>nil) and (qryProcuraNaturezasProduto.FieldByName('cofinscst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
      qryProdutosNotaFiscal.FieldByName('cofinscst').AsString    := qryProcuraNaturezasProduto.FieldByName('cofinscst').AsString
    else
    if vNaturezaPadraoAtribuida and (qryNaturezasPadrao_.FieldByName('cofinscst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
      qryProdutosNotaFiscal.FieldByName('cofinscst').AsString    := qryNaturezasPadrao_.FieldByName('cofinscst').AsString
    else
    if qryProcuraProdutoNotaFiscal.FieldByName('cofinscst').AsString <> '' then  // VALOR DO IPICST NO CADASTRO DO PRODUTO
      qryProdutosNotaFiscal.FieldByName('cofinscst').AsString := qryProcuraProdutoNotaFiscal.FieldByName('cofinscst').AsString;
  end;
end;


function TdtmBasico.AtribuirDadosProdutos(var Produtos: TtecQuery;
  Notas, CodigoFiscalProduto: TtecQuery; IPISuspenso:Boolean = false;
  OrigemCalculo : TtecOrigemCalculo = NotaAvulsa;
  EstadoDestino: String = ''): Boolean;


type
   TipoAtribuicao = (tpSQLDadosProdutosNotasEntradas, tpSQLDadosProdutosNotasSaidas, tpSQLDadosProdutosPedidos, tpSQLDadosProdutos);

  var
   vTipoAtribuicao : TipoAtribuicao;
   vTeste : Boolean;
   vValorTeste : String;

  function RegimeTributario_: integer;
  begin
    result := RegimeTributario;
    if OrigemCalculo = CadastroPedidos then
      result := notas.Fieldbyname('regimetributario').asinteger;
  end;

  procedure EditarProdutos;
  begin
    if not (produtos.state in [dsinsert, dsedit]) then
      produtos.Edit;
  end;

  function Condicaorequernfentrada: boolean;
  begin
   result := false;
   if OrigemCalculo = NotaAvulsa then
    result := ((Notas.FindField('requernfentrada')<>nil) and
               (notas.fieldbyname('requernfentrada').AsBoolean)) or
              ((produtos.FindField('codigonota')<>nil) and
               (produtos.fieldbyname('codigonota').Asinteger<>0)) ;
  end;

  function CondicaoDevolucaoTransferencia: Boolean;
  begin
   result :=  OrigemCalculo = DevolucaoporTransferencia;
  end;

  function CondicaoRequerNFSaida: boolean;
  begin
   result := false;
   if (OrigemCalculo in [NotaEntrada, Devolucao, Troca]) then
    result := ((Notas.FindField('requernfsaida')<>nil) and
               (notas.fieldbyname('requernfsaida').AsBoolean)) or

               ((produtos.fieldbyname('dadofiscal').asinteger <> 0) and
                (produtos.fieldbyname('numeroprodutotabela').asinteger <> 0))

  end;

  function cancelamentonfforaprazolegal: boolean;
  begin
   result := false;
     if (OrigemCalculo in [NotaEntrada, Devolucao, Troca]) then
      result := (Notas.FindField('cancelamentonfforaprazolegal')<>nil) and
                 (notas.fieldbyname('cancelamentonfforaprazolegal').AsBoolean)

  end;

  function CondicaoTransferenciaEntrada: boolean;
  begin
   result := false;
   if (OrigemCalculo in [TransferenciaEntrada]) then
    result := ((produtos.fieldbyname('dadofiscal').asinteger <> 0) and
               (produtos.fieldbyname('numeroprodutotabela').asinteger <> 0));
  end;


  function CondicaoPedido: boolean;
  begin
   result := false;
   if (OrigemCalculo in [NotaEntrada, NotaEntradaxml]) then
    result := ((Produtos.FindField('pedido')<>nil) and
               ((Produtos.fieldbyname('pedido').AsInteger)<>0));

   if result and (OrigemCalculo in [NotaEntradaxml]) then
     if produtos.name = 'qryProdutosNotasPagNFEItems' then
       result := produtos.fieldbyname('pedidook').asBoolean;
  end;

  function Saida: Boolean;
  begin
    result := not (OrigemCalculo in [CadastroPedidos, NotaEntrada,NotaEntradaXML,Devolucao, Troca]);
  end;

  function PossuiNDI: boolean;
  begin
    result := false;

    if (notas <> nil) and (notas.FindField('ndi')<>nil) then
      result := not notas.fieldbyname('ndi').IsNull;
  end;

  function CondicaoNotaSaidaReferenciada: boolean;
  begin
    result := false;
    if OrigemCalculo = NotaAvulsa then
      result := (Notas.FindField('dadofiscalreferenciado') <> nil) and
                (notas.fieldbyname('dadofiscalreferenciado').Asinteger <> 0);
  end;

  function NFSaidaouEntradaPelaEmpresa: boolean;
  begin
    result := saida or ((Notas.FindField('permitirimprimir')<>nil) and
                        (notas.fieldbyname('permitirimprimir').AsBoolean));
  end;

  procedure IncluirProdutonoEstoque;
  begin
    if not assigned(qryEstoques) then
    begin
      qryEstoques           := TTecQuery.Create((nil));
      qryEstoques.Database  := dtmTecSoft.Database;
      qryEstoques.sql.text  := 'select * from estoques where produto = :produto and filial = :filial';
      qryEstoques.CachedUpdates := true;
      qryEstoques.RequestLive := true;
    end;

    ReFazConsulta(qryEstoques,[0,1],[ produtos.fieldbyname('produto').asstring, FilialBase]);
    if qryEstoques.IsEmpty then
    begin
      qryEstoques.Insert;
      qryEstoques.fieldbyname('produto').AsString      := produtos.fieldbyname('produto').asstring;
      qryEstoques.fieldbyname('filial').AsInteger        := FilialBase;
      qryEstoques.fieldbyname('emestoque').AsCurrency     := 0;
      qryEstoques.fieldbyname('reservado').AsCurrency     := 0;
      qryEstoques.fieldbyname('transito').AsCurrency      := 0;
      qryEstoques.fieldbyname('demonstracao').AsCurrency  := 0;
      qryEstoques.fieldbyname('conserto').AsCurrency      := 0;
      qryEstoques.fieldbyname('futuro').AsCurrency        := 0;
      qryEstoques.fieldbyname('danificada').AsCurrency    := 0;
      qryEstoques.fieldbyname('estoquefisico').AsCurrency := 0;
      qryEstoques.fieldbyname('reservaprevia').AsCurrency := 0;
      qryEstoques.fieldbyname('acabados').AsCurrency := 0;
      qryEstoques.fieldbyname('semiacabados').AsCurrency := 0;

      qryEstoques.Post;
      Perpetrar([qryEstoques]);
    end;
  end;

  function AtribuirDadosNotasRelacionadas: boolean;
  begin
    result := true;
    produtos.fieldbyname('icmsbasecalculo').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('icmsbasecalculo').AsFloat -
                                                                      qryDadosProdutos_.fieldbyname('icmsbasecalculo_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('icmsvalor').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('icmsvalor').AsFloat - qryDadosProdutos_.fieldbyname('icmsvalor_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('aliquotaicms').AsFloat := qryDadosProdutos_.fieldbyname('aliquotaicms').AsFloat;

    produtos.fieldbyname('fatorsubstituicao').AsCurrency := qryDadosProdutos_.fieldbyname('fatorsubstituicao').AsCurrency;

    produtos.fieldbyname('icmsbasecalculost').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('icmsbasecalculost').AsFloat - qryDadosProdutos_.fieldbyname('icmsbasecalculost_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('icmsvalorst').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('icmsvalorst').AsFloat - qryDadosProdutos_.fieldbyname('icmsvalorst_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('aliquotaicmsst').AsFloat := qryDadosProdutos_.fieldbyname('aliquotaicmsst').AsFloat;

    produtos.fieldbyname('icmsbasecalculo_dev').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('icmsbasecalculo_dev').AsFloat - qryDadosProdutos_.fieldbyname('icmsbasecalculo_dev_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('icmsvalor_dev').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('icmsvalor_dev').AsFloat - qryDadosProdutos_.fieldbyname('icmsvalor_dev_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('vBCSTRet').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('vBCSTRet').AsFloat - qryDadosProdutos_.fieldbyname('vBCSTRet_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('vICMSSTRet').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('vICMSSTRet').AsFloat - qryDadosProdutos_.fieldbyname('vICMSSTRet_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('despesasacessorias').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('despesasacessorias').AsFloat - qryDadosProdutos_.fieldbyname('despesasacessorias_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    if qryDadosProdutos_.findField('iivalor')<>nil then
      produtos.fieldbyname('despesasacessorias').AsFloat := produtos.fieldbyname('despesasacessorias').AsFloat +
                                                               RatearValores((qryDadosProdutos_.fieldbyname('iivalor').AsFloat - qryDadosProdutos_.fieldbyname('iivalor_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('ipibasecalculo').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('ipibasecalculo').AsFloat - qryDadosProdutos_.fieldbyname('ipibasecalculo_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('aliquotaipi').AsFloat := qryDadosProdutos_.fieldbyname('aliquotaipi').AsFloat;

    produtos.fieldbyname('valoripi').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('valoripi').AsFloat - qryDadosProdutos_.fieldbyname('valoripi_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('desconto').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('desconto').AsFloat - qryDadosProdutos_.fieldbyname('desconto_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('valordescontoitem').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('valordescontoitem').AsFloat - qryDadosProdutos_.fieldbyname('valordescontoitem_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

    produtos.fieldbyname('frete').AsCurrency := RatearValores((qryDadosProdutos_.fieldbyname('frete').AsFloat - qryDadosProdutos_.fieldbyname('frete_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);


    if (origemCalculo in [Devolucao, Troca, NotaEntrada]) and CondicaoRequerNFSaida then
    begin
      produtos.fieldbyname('incidencia').asString := qryDadosProdutos_.fieldbyname('cst_notasaida').asString;
      produtos.fieldbyname('csosn').asString := qryDadosProdutos_.fieldbyname('csosn_notasaida').asString;

      produtos.fieldbyname('pcredsn').AsFloat := qryDadosProdutos_.fieldbyname('pcredsn').AsFloat;

      produtos.fieldbyname('vcredicmssn').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('vcredicmssn').AsFloat - qryDadosProdutos_.fieldbyname('vcredicmssn_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

      produtos.fieldbyname('fatorsubstituicao').AsFloat := qryDadosProdutos_.fieldbyname('fatorsubstituicao').AsFloat;

      produtos.fieldbyname('reducaobasest').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('reducaobasest').AsFloat - qryDadosProdutos_.fieldbyname('reducaobasest_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

      produtos.fieldbyname('icmsisentas').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('icmsisentas').AsFloat - qryDadosProdutos_.fieldbyname('icmsisentas_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

      produtos.fieldbyname('icmsoutras').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('icmsoutras').AsFloat - qryDadosProdutos_.fieldbyname('icmsoutras_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

      produtos.fieldbyname('ipioutras').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('ipioutras').AsFloat - qryDadosProdutos_.fieldbyname('ipioutras_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

      produtos.fieldbyname('ipiisentas').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('ipiisentas').AsFloat - qryDadosProdutos_.fieldbyname('ipiisentas_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);
    end
    else
    if (origemCalculo in [NotaAvulsa]) and CondicaoRequerNFEntrada then
    begin
      produtos.fieldbyname('incidencia').asString := qryDadosProdutos_.fieldbyname('incidencia').asString;
      produtos.fieldbyname('csosn').asString := qryDadosProdutos_.fieldbyname('csosn').asString;

      produtos.fieldbyname('pcredsn').AsFloat := qryDadosProdutos_.fieldbyname('pcredsn').AsFloat;

      produtos.fieldbyname('vcredicmssn').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('vcredicmssn').AsFloat - qryDadosProdutos_.fieldbyname('vcredicmssn_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

      produtos.fieldbyname('fatorsubstituicao').AsFloat := qryDadosProdutos_.fieldbyname('fatorsubstituicao').AsFloat;

      produtos.fieldbyname('reducaobasest').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('reducaobasest').AsFloat - qryDadosProdutos_.fieldbyname('reducaobasest_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

      produtos.fieldbyname('icmsisentas').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('icmsisentas').AsFloat - qryDadosProdutos_.fieldbyname('icmsisentas_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

      produtos.fieldbyname('icmsoutras').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('icmsoutras').AsFloat - qryDadosProdutos_.fieldbyname('icmsoutras_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

      produtos.fieldbyname('ipioutras').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('ipioutras').AsFloat - qryDadosProdutos_.fieldbyname('ipioutras_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);

      produtos.fieldbyname('ipiisentas').AsFloat := RatearValores((qryDadosProdutos_.fieldbyname('ipiisentas').AsFloat - qryDadosProdutos_.fieldbyname('ipiisentas_devolvido').AsFloat),
                                                                        qryDadosProdutos_.fieldbyname('quantidade').AsFloat,
                                                                        produtos.fieldbyname('quantidade').AsFloat);
    end;


    if CondicaoTransferenciaEntrada then
    begin
      produtos.fieldbyname('ipibasecalculo').AsCurrency := qryDadosProdutos_.fieldbyname('ipibasecalculo').ascurrency;
      produtos.fieldbyname('aliquotaipi').AsCurrency := qryDadosProdutos_.fieldbyname('aliquotaipi').ascurrency;
      produtos.fieldbyname('valoripi').AsCurrency := qryDadosProdutos_.fieldbyname('valoripi').ascurrency;

      produtos.fieldbyname('cofinsbasecalculo').AsCurrency := qryDadosProdutos_.fieldbyname('cofinsbasecalculo').ascurrency;
      produtos.fieldbyname('cofinsaliquota').AsCurrency := qryDadosProdutos_.fieldbyname('cofinsaliquota').ascurrency;
      produtos.fieldbyname('cofinsvalor').AsCurrency := qryDadosProdutos_.fieldbyname('cofinsvalor').ascurrency;

      produtos.fieldbyname('pisbasecalculo').AsCurrency := qryDadosProdutos_.fieldbyname('pisbasecalculo').ascurrency;
      produtos.fieldbyname('pisaliquota').AsCurrency := qryDadosProdutos_.fieldbyname('pisaliquota').ascurrency;
      produtos.fieldbyname('pisvalor').AsCurrency := qryDadosProdutos_.fieldbyname('pisvalor').ascurrency;

      produtos.fieldbyname('desconto').AsCurrency  := qryDadosProdutos_.fieldbyname('desconto').AsCurrency;
      produtos.fieldbyname('valordescontoitem').AsCurrency  := qryDadosProdutos_.fieldbyname('valordescontoitem').AsCurrency;

      produtos.fieldbyname('valorreducaobase').AsCurrency  := qryDadosProdutos_.fieldbyname('reducaobase').AsCurrency;
      produtos.fieldbyname('percentualreducaobase').AsCurrency  := qryDadosProdutos_.fieldbyname('percentualreducaobase').AsCurrency;
      produtos.fieldbyname('acrescimo').AsCurrency  := qryDadosProdutos_.fieldbyname('acrescimo').AsCurrency;

      produtos.fieldbyname('frete').AsCurrency := qryDadosProdutos_.fieldbyname('frete').AsCurrency;
      produtos.fieldbyname('seguro').AsCurrency := qryDadosProdutos_.fieldbyname('seguro').AsCurrency;
      produtos.fieldbyname('despesasacessorias').AsCurrency := qryDadosProdutos_.fieldbyname('despesasacessorias').AsCurrency;

      produtos.fieldbyname('pcredsn').AsCurrency := qryDadosProdutos_.fieldbyname('pcredsn').AsCurrency;
      produtos.fieldbyname('vcredicmssn').AsCurrency := qryDadosProdutos_.fieldbyname('vcredicmssn').AsCurrency;
      produtos.fieldbyname('fatorsubstituicao').AsCurrency := qryDadosProdutos_.fieldbyname('fatorsubstituicao').AsCurrency;
      produtos.fieldbyname('reducaobasest').AsCurrency := qryDadosProdutos_.fieldbyname('reducaobasest').AsCurrency;

      produtos.fieldbyname('icmsisentas').AsCurrency := qryDadosProdutos_.fieldbyname('icmsisentas').AsCurrency;

      produtos.fieldbyname('icmsoutras').AsCurrency := qryDadosProdutos_.fieldbyname('icmsoutras').AsCurrency;
      produtos.fieldbyname('ipioutras').AsCurrency := qryDadosProdutos_.fieldbyname('ipioutras').AsCurrency;
      produtos.fieldbyname('ipiisentas').AsCurrency := qryDadosProdutos_.fieldbyname('ipiisentas').AsCurrency;

      produtos.fieldbyname('fatorconversao').AsCurrency := 1;

      produtos.fieldbyname('qtdeestoque').AsCurrency := qryDadosProdutos_.fieldbyname('quantidade').AsCurrency;
    end;
  end;

  procedure AtribuirDadosDiversos;
  begin
      if (OrigemCalculo in [Contrato, Orcamento, OrdemdeServico]) then
      begin

        if produtos.findfield('montagemoriginal') <> nil then
          produtos.fieldbyname('montagemoriginal').AsBoolean   := qryDadosProdutos_.fieldbyname('montagem').AsBoolean;

        if produtos.findfield('montagem') <> nil then
          if qryDadosProdutos_.fieldbyname('montagem').AsBoolean then
            produtos.fieldbyname('montagem').AsString   := 'S'
          else
            produtos.fieldbyname('montagem').AsString   := 'N';

        if produtos.findfield('promocao') <> nil then
          produtos.fieldbyname('promocao').AsBoolean   := qryDadosProdutos_.fieldbyname('promocao').AsBoolean;

        if produtos.findfield('deny_discount') <> nil then
          produtos.fieldbyname('deny_discount').AsBoolean   := qryDadosProdutos_.fieldbyname('deny_discount').AsBoolean;

        if produtos.findfield('brinde') <> nil then
          produtos.fieldbyname('brinde').AsBoolean   := qryDadosProdutos_.fieldbyname('brinde').AsBoolean;

        if produtos.findfield('filial') <> nil then
          produtos.fieldbyname('filial').AsInteger := qryDadosProdutos_.fieldbyname('filial').AsInteger;

        if produtos.findfield('vendasemestoque') <> nil then
          produtos.fieldByName('vendasemestoque').AsString:= qryDadosProdutos_.fieldbyname('vendasemestoque').AsString;

        if produtos.findfield('aliquotaicmsst') <> nil then
          produtos.fieldbyname('aliquotaicmsst').AsCurrency := qryDadosProdutos_.fieldbyname('aliquotaicmsst').AsCurrency;

      end;

      if produtos.findfield('tribcodigoean') <> nil then
        produtos.fieldbyname('tribcodigoean').AsString   := qryDadosProdutos_.fieldbyname('ceantrib').AsString;

      if produtos.findfield('peso') <> nil then
        produtos.fieldbyname('peso').AsFloat   := qryDadosProdutos_.fieldbyname('peso'     ).AsFloat;

      if produtos.findfield('volumes') <> nil then
        produtos.fieldbyname('volumes').Ascurrency   := qryDadosProdutos_.fieldbyname('volumes'     ).AsCurrency;

      if produtos.findfield('peso_entrega') <> nil then
        produtos.fieldbyname('peso_entrega').AsFloat   := qryDadosProdutos_.fieldbyname('peso_entrega'     ).AsFloat;

      if produtos.findfield('comprimento') <> nil then
        produtos.fieldbyname('comprimento').AsFloat   := qryDadosProdutos_.fieldbyname('comprimento'     ).AsFloat;

      if produtos.findfield('altura') <> nil then
        produtos.fieldbyname('altura').AsFloat   := qryDadosProdutos_.fieldbyname('altura'     ).AsFloat;

      if produtos.findfield('largura') <> nil then
        produtos.fieldbyname('largura').AsFloat   := qryDadosProdutos_.fieldbyname('largura'     ).AsFloat;

      if produtos.findfield('diametro') <> nil then
        produtos.fieldbyname('diametro').AsFloat   := qryDadosProdutos_.fieldbyname('diametro'     ).AsFloat;

      if produtos.findfield('formato') <> nil then
        produtos.fieldbyname('formato').AsInteger   := qryDadosProdutos_.fieldbyname('formato'     ).AsInteger;

      if produtos.findfield('cst_produto') <> nil then
        produtos.fieldbyname('cst_produto').AsString   := qryDadosProdutos_.fieldbyname('cst_produto'     ).AsString;

      if produtos.findfield('cst_produto_1') <> nil then
        produtos.fieldbyname('cst_produto_1').AsString   := qryDadosProdutos_.fieldbyname('cst_produto'     ).AsString;


      if CondicaoRequerNFSaida or CondicaoTransferenciaEntrada then
      begin

        produtos.FieldByName('cst_nf').asstring := qryDadosProdutos_.fieldbyname('cst_notasaida').AsString;
        vValorTeste := qryDadosProdutos_.fieldbyname('csosn_notasaida').AsString;
        produtos.FieldByName('csosn_nf').asstring := vValorTeste;

      end;

      if produtos.findfield('csosn_produto') <> nil then
        produtos.fieldbyname('csosn_produto').AsString   := qryDadosProdutos_.fieldbyname('csosn_produto'     ).AsString;

      if produtos.findfield('csosn_produto_1') <> nil then
        produtos.fieldbyname('csosn_produto_1').AsString   := qryDadosProdutos_.fieldbyname('csosn_produto'     ).AsString;

      if produtos.findfield('descricaoproduto') <> nil then
      begin
        if (OrigemCalculo in [contrato, orcamento, OrdemdeServico]) then
          produtos.fieldbyname('descricaoproduto').AsString   := trim(qryDadosProdutos_.fieldbyname('descricaoproduto').AsString)
        else
          produtos.fieldbyname('descricaoproduto').AsString   := trim(qryDadosProdutos_.fieldbyname('descricaoproduto').AsString + ' '+
                                                                      qryDadosProdutos_.fieldbyname('valorgrade1').AsString + ' '+
                                                                      qryDadosProdutos_.fieldbyname('valorgrade2').AsString);
        if {not qryDadosProdutos_.fieldbyname('anvisa').isnull and}
          trim(qryDadosProdutos_.fieldbyname('anvisa').asString)<>'' then
          produtos.fieldbyname('descricaoproduto').AsString := trim(produtos.fieldbyname('descricaoproduto').AsString) + ' MS - '+
                                                               qryDadosProdutos_.fieldbyname('anvisa').asString;

      end;

      if produtos.FindField('comissao_produto')<> nil then
        produtos.FindField('comissao_produto').AsCurrency := qryDadosProdutos_.fieldbyname('comissao_produto').AsCurrency;

      if produtos.FindField('comissao_grupo') <> nil then
        produtos.FindField('comissao_grupo').AsCurrency := qryDadosProdutos_.fieldbyname('comissao_grupo').AsCurrency;

      if produtos.FindField('tipocomissao_produto')<> nil then
        produtos.FindField('tipocomissao_produto').AsString := qryDadosProdutos_.fieldbyname('tipocomissao_produto').AsString;

      if produtos.FindField('tipocomissao_grupo') <> nil then
        produtos.FindField('tipocomissao_grupo').AsString := qryDadosProdutos_.fieldbyname('tipocomissao_grupo').AsString;

      if produtos.findfield('caracteristica') <> nil then
        produtos.fieldbyname('caracteristica').AsString   := qryDadosProdutos_.fieldbyname('caracteristica'     ).AsString;

      if produtos.findfield('referencia') <> nil then
        produtos.fieldbyname('referencia').AsString   := qryDadosProdutos_.fieldbyname('referencia'     ).AsString;

      if produtos.findfield('naoreplicar') <> nil then
        produtos.fieldbyname('naoreplicar').AsString   := qryDadosProdutos_.fieldbyname('naoreplicar'     ).AsString;

      if produtos.findfield('descricaocaracteristica') <> nil then
        produtos.fieldbyname('descricaocaracteristica').AsString   := qryDadosProdutos_.fieldbyname('descricaocaracteristica'     ).AsString;

      if produtos.findfield('aliquotaicmscalculopreco') <> nil then
        produtos.fieldbyname('aliquotaicmscalculopreco').AsCurrency   := qryDadosProdutos_.fieldbyname('aliquotaicmscalculopreco'     ).Ascurrency;

      if not (OrigemCalculo in [CadastroPedidos]) then
        if produtos.findfield('preco') <> nil then
          produtos.fieldbyname('preco').Asinteger   := qryDadosProdutos_.fieldbyname('codigopreco').AsInteger;

      if produtos.findfield('descricaoprecoproduto') <> nil then
        produtos.fieldbyname('descricaoprecoproduto').AsString   := qryDadosProdutos_.fieldbyname('descricaoprecoproduto'     ).AsString;

      if produtos.findfield('caracteristicavisual') <> nil then
        produtos.fieldbyname('caracteristicavisual').AsString   := qryDadosProdutos_.fieldbyname('caracteristicavisual'     ).AsString;

      if produtos.findfield('gerenciarloteevalidade') <> nil then
        produtos.fieldbyname('gerenciarloteevalidade').AsString   := qryDadosProdutos_.fieldbyname('gerenciarloteevalidade'     ).AsString;

      if (produtos.findfield('lote') <> nil) and
         (qryDadosProdutos_.findfield('lote') <> nil) then
      begin
        produtos.fieldbyname('lote').AsString := qryDadosProdutos_.fieldbyname('lote').AsString;
        produtos.fieldbyname('nrlote').AsString := qryDadosProdutos_.fieldbyname('nrlote').AsString;
        produtos.fieldbyname('validade').AsDateTime := qryDadosProdutos_.fieldbyname('validade').AsDateTime;
        produtos.fieldbyname('fabricacao').AsDateTime := qryDadosProdutos_.fieldbyname('fabricacao').AsDateTime;
      end
      else
      if (produtos.findfield('lote') <> nil) then
      begin
        if (OrigemCalculo = NotaEntradaXML) then
        begin
          if not (produtos.fieldbyname('lote').isnull and
                  not produtos.fieldbyname('nrlote').isnull) then
          begin
            produtos.fieldbyname('lote').clear;
            produtos.fieldbyname('nrlote').clear;
            produtos.fieldbyname('validade').clear;
            produtos.fieldbyname('fabricacao').clear;
          end;
        end
        else
        begin
          produtos.fieldbyname('lote').clear;
          produtos.fieldbyname('nrlote').clear;
          produtos.fieldbyname('validade').clear;
          produtos.fieldbyname('fabricacao').clear;
        end;
      end;


      if produtos.findfield('markup_produto') <> nil then
        produtos.fieldbyname('markup_produto').Ascurrency   := qryDadosProdutos_.fieldbyname('markup_produto').AsCurrency;

      if produtos.findfield('markup_grupo') <> nil then
        produtos.fieldbyname('markup_grupo').Ascurrency   := qryDadosProdutos_.fieldbyname('markup_grupo').AsCurrency;

      if produtos.findfield('markup_fornecedor') <> nil then
        produtos.fieldbyname('markup_fornecedor').Ascurrency   := qryDadosProdutos_.fieldbyname('markup_fornecedor').AsCurrency;

      if produtos.findfield('markup_produto_1') <> nil then
        produtos.fieldbyname('markup_produto_1').Ascurrency   := qryDadosProdutos_.fieldbyname('markup_produto').AsCurrency;

      if produtos.findfield('markup_grupo_1') <> nil then
        produtos.fieldbyname('markup_grupo_1').Ascurrency   := qryDadosProdutos_.fieldbyname('markup_grupo').AsCurrency;

      if produtos.findfield('markup_fornecedor_1') <> nil then
        produtos.fieldbyname('markup_fornecedor_1').Ascurrency   := qryDadosProdutos_.fieldbyname('markup_fornecedor').AsCurrency;

      if produtos.findfield('calcularpreco') <> nil then
        produtos.fieldbyname('calcularpreco').AsBoolean   := qryDadosProdutos_.fieldbyname('calcularpreco').AsBoolean;

      if produtos.findfield('grupo') <> nil then
        produtos.fieldbyname('grupo').AsString   := qryDadosProdutos_.fieldbyname('grupo'     ).AsString;

      if produtos.findfield('classe') <> nil then
        produtos.fieldbyname('classe').AsString   := qryDadosProdutos_.fieldbyname('classe'     ).AsString;

      if produtos.findfield('cest') <> nil then
        produtos.fieldbyname('cest').AsString   := qryDadosProdutos_.fieldbyname('cest'     ).AsString;

      if produtos.findfield('descricaonanf') <> nil then
        produtos.fieldbyname('descricaonanf'   ).AsString   := qryDadosProdutos_.fieldbyname('descricaonanf'  ).AsString;

      if produtos.findfield('produtovisual') <> nil then
        produtos.fieldbyname('produtovisual'   ).AsString   := qryDadosProdutos_.fieldbyname('produtovisual'  ).AsString;

      if produtos.findfield('produtodigitado') <> nil then
        if produtos.fieldbyname('produtodigitado'   ).AsString = '' then
           produtos.fieldbyname('produtodigitado'   ).AsString   := qryDadosProdutos_.fieldbyname('produtodigitado'  ).AsString;

      if produtos.findfield('codigovisual') <> nil then
      begin
        if qryDadosProdutos_.findfield('codigovisual') <> nil then
          produtos.fieldbyname('codigovisual').AsString   := qryDadosProdutos_.fieldbyname('codigovisual').AsString
        else
        if qryDadosProdutos_.findfield('produtovisual') <> nil then
          produtos.fieldbyname('codigovisual').AsString   := qryDadosProdutos_.fieldbyname('produtovisual').AsString;
      end;

      if produtos.findfield('linha') <> nil  then
        produtos.fieldbyname('linha'           ).AsString   := qryDadosProdutos_.fieldbyname('linha'         ).AsString;

      if produtos.findfield('coluna') <> nil  then
        produtos.fieldbyname('coluna'          ).AsString   := qryDadosProdutos_.fieldbyname('coluna'        ).AsString;

      if produtos.findfield('valorgrade1') <> nil  then
        produtos.fieldbyname('valorgrade1'     ).AsString   := qryDadosProdutos_.fieldbyname('valorgrade1'   ).AsString;

      if produtos.findfield('valorgrade2') <> nil  then
        produtos.fieldbyname('valorgrade2'     ).AsString   := qryDadosProdutos_.fieldbyname('valorgrade2'   ).AsString;

      if produtos.findfield('grade1') <> nil  then
        produtos.fieldbyname('grade1'     ).AsString   := qryDadosProdutos_.fieldbyname('grade1'   ).AsString;

      if produtos.findfield('grade2') <> nil  then
        produtos.fieldbyname('grade2'     ).AsString   := qryDadosProdutos_.fieldbyname('grade2'   ).AsString;

      if produtos.findfield('codigo_efd_t53') <> nil  then
      begin
        if (trim(qryDadosProdutos_.fieldbyname('codigo_efd_t53').AsString)<>'') and not assigned(ecfpadrao) then
          produtos.fieldbyname('codigo_efd_t53'     ).AsString   := qryDadosProdutos_.fieldbyname('codigo_efd_t53').AsString
        else
          produtos.fieldbyname('codigo_efd_t53'     ).clear;
      end;

      if produtos.findfield('unidade') <> nil then
        produtos.fieldbyname('unidade'         ).AsString   := qryDadosProdutos_.fieldbyname('unidade'       ).AsString;

      if (produtos.findfield('unidadenf') <> nil) then
      begin
        if (qryDadosProdutos_.findfield('unidadenf') <> nil) and
           (qryDadosProdutos_.fieldbyname('unidadenf').AsString <> '') then
          produtos.fieldbyname('unidadenf').AsString   := qryDadosProdutos_.fieldbyname('unidadenf').AsString
        else
          produtos.fieldbyname('unidadenf').AsString   := qryDadosProdutos_.fieldbyname('unidade').AsString;
      end;

      if produtos.findfield('descricaounidade') <> nil then
        produtos.fieldbyname('descricaounidade'         ).AsString   := qryDadosProdutos_.fieldbyname('descricaounidade'       ).AsString;

      if produtos.findfield('tribunidade') <> nil then
        produtos.fieldbyname('tribunidade'     ).AsString   := qryDadosProdutos_.fieldbyname('unidade'       ).AsString;

      if produtos.findfield('pn') <> nil then
        produtos.fieldbyname('pn').AsString   := qryDadosProdutos_.fieldbyname('produto').AsString;

      if produtos.findfield('genero') <> nil then
        produtos.fieldbyname('genero'          ).AsString   := qryDadosProdutos_.fieldbyname('genero'        ).AsString;

      if produtos.findfield('extipi') <> nil then
        produtos.fieldbyname('extipi'          ).AsString   := qryDadosProdutos_.fieldbyname('extipi'        ).AsString;

      if produtos.findfield('icmsmodalidade') <> nil then
        produtos.fieldbyname('icmsmodalidade'  ).AsString   := qryDadosProdutos_.fieldbyname('icmsmodalidade').AsString;

      if produtos.findfield('icmsmodsubst') <> nil then
        produtos.fieldbyname('icmsmodsubst'    ).AsString   := qryDadosProdutos_.fieldbyname('icmsmodsubst'  ).AsString;

      if produtos.findfield('pisaliquota') <> nil then
      begin
        if qryDadosProdutos_.fieldbyname('aliquotapis').AsCurrency<>0 then
          produtos.fieldbyname('pisaliquota').AsCurrency := qryDadosProdutos_.fieldbyname('aliquotapis').AsCurrency
        else
          produtos.fieldbyname('pisaliquota').clear;
      end;

      if produtos.findfield('cofinsaliquota') <> nil then
      begin
        if qryDadosProdutos_.fieldbyname('aliquotacofins').AsCurrency<>0 then
          produtos.fieldbyname('cofinsaliquota').AsCurrency := qryDadosProdutos_.fieldbyname('aliquotacofins').AsCurrency
        else
          produtos.fieldbyname('cofinsaliquota').clear;
      end;

      if produtos.findfield('localizacao') <> nil then
        produtos.fieldbyname('localizacao'     ).AsString   := qryDadosProdutos_.fieldbyname('localizacao'   ).AsString;

      if produtos.findfield('aliquotaicms') <> nil then
      begin
        if qryDadosProdutos_.fieldbyname('aliquotaicms').AsCurrency<>0 then
          produtos.fieldbyname('aliquotaicms').AsCurrency := qryDadosProdutos_.fieldbyname('aliquotaicms'  ).AsCurrency
        else
          if not assigned(ecfPadrao) then
            produtos.fieldbyname('aliquotaicms').clear;
      end;

      if produtos.findfield('tipopreco')<>nil then
      begin
        if produtos.findfield('precovenda')<>nil then
        begin
          case produtos.fieldbyname('tipopreco').AsInteger of
            0{tpnVENDA}       : produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos_.fieldbyname('precounitario').AsFloat;
            1{tpnCUSTOMEDIO}  : if qryDadosProdutos_.fieldbyname('customedio').AsFloat>0 then
                                  produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos_.fieldbyname('customedio').AsFloat
                                else if qryDadosProdutos_.fieldbyname('valorultimacompra').AsFloat>0 then
                                  produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos_.fieldbyname('valorultimacompra').AsFloat
                                else
                                  produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos_.fieldbyname('precounitario').AsFloat;

            2{tpnULTIMACOMPRA}: produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos_.fieldbyname('valorultimacompra').AsFloat;
          end
        end;
      end
      else
      if (OrigemCalculo = TransferenciaSaida) or
         (OrigemCalculo = DevolucaoporTransferencia) then
      begin
        if (qryDadosProdutos_.fieldbyname('customedio').AsFloat <> 0) then
          produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos_.fieldbyname('customedio').AsFloat
        else
        if (qryDadosProdutos_.fieldbyname('ultimocustomedio').AsFloat <> 0) then
          produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos_.fieldbyname('ultimocustomedio').AsFloat
        else
          produtos.fieldbyname('precovenda').AsFloat := qryDadosProdutos_.fieldbyname('valorultimacompra').AsFloat;
      end
      else
      if (produtos.findfield('precounitario')<>nil) and (OrigemCalculo <> NotaEntradaXML) then
        produtos.fieldbyname('precounitario').AsFloat := roundto(qryDadosProdutos_.fieldbyname('precounitario').AsFloat, -abs(parsistema.PrecoUnitarioCasasDecimais))
      else
      if (OrigemCalculo in [CadastroPedidos]) then
        produtos.fieldbyname('preco').AsFloat := roundto(qryDadosProdutos_.fieldbyname('preco_pedido').AsFloat, -abs(parsistema.PrecoUnitarioCasasDecimais));

      if (produtos.findfield('precounitariopedido')<>nil) and
         (qryDadosProdutos_.findfield('precounitariopedido')<>nil) then
        produtos.fieldbyname('precounitariopedido').AsFloat := qryDadosProdutos_.fieldbyname('precounitariopedido').AsFloat;

      if not (CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos) or

        CondicaoRequerNFEntrada or CondicaoDevolucaoTransferencia or
        CondicaoRequerNFSaida or
        CondicaoNotaSaidaReferenciada or
        CondicaoTransferenciaEntrada)  then

      if produtos.findfield('precovenda')<>nil then
      begin
        if not (CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos) or

          CondicaoRequerNFEntrada or CondicaoDevolucaoTransferencia or
          CondicaoRequerNFSaida or
          CondicaoNotaSaidaReferenciada or
          CondicaoTransferenciaEntrada)  then
          produtos.fieldbyname('precovenda').AsFloat :=  roundto(produtos.fieldbyname('precovenda').AsFloat, -abs(parsistema.PrecoUnitarioCasasDecimais));
      end;

      if produtos.findfield('precotabela')<>nil then
        produtos.fieldbyname('precotabela').AsCurrency  := produtos.fieldbyname('precovenda').AsCurrency;

      if produtos.findfield('tribunitario')<>nil then
      begin
        if produtos.findField('precovenda')<>nil then
          produtos.fieldbyname('tribunitario').AsCurrency  := produtos.fieldbyname('precovenda').AsCurrency
        else
        if produtos.findField('precounitario')<>nil then
          produtos.fieldbyname('tribunitario').AsCurrency  := produtos.fieldbyname('precounitario').AsCurrency;
      end;

      if Not qryDadosProdutos_.fieldbyname('icms').IsNull then
        if produtos.FindField('icms') <> nil then
          produtos.fieldbyname('icms').AsInteger   := qryDadosProdutos_.fieldbyname('icms').AsInteger;

      if produtos.FindField('percentualreducaobase') <> nil then
      begin
//        if qryDadosProdutos_.fieldbyname('percreducaobase').AsCurrency<>0 then
          produtos.fieldbyname('percentualreducaobase').AsCurrency := qryDadosProdutos_.fieldbyname('percreducaobase').AsCurrency
//        else
//          produtos.fieldbyname('percentualreducaobase').clear;
      end;

      if produtos.FindField('percentualreducaobase_produto') <> nil then
      begin
//        if qryDadosProdutos_.fieldbyname('percreducaobase').AsCurrency<>0 then
          produtos.fieldbyname('percentualreducaobase_produto').AsCurrency := qryDadosProdutos_.fieldbyname('percreducaobase').AsCurrency
//        else
//          produtos.fieldbyname('percentualreducaobase_produto').clear;
      end;

      if produtos.FindField('percentualreducaobase_custo') <> nil then
      begin
//        if qryDadosProdutos_.fieldbyname('percreducaobase').AsCurrency<>0 then
          produtos.fieldbyname('percentualreducaobase_custo').AsCurrency := qryDadosProdutos_.fieldbyname('percreducaobase').AsCurrency
//        else
//          produtos.fieldbyname('percentualreducaobase_custo').clear;
      end;

      if produtos.FindField('predbcst') <> nil then
      begin
        if qryDadosProdutos_.fieldbyname('predbcst').AsCurrency<>0 then
          produtos.fieldbyname('predbcst').AsCurrency := qryDadosProdutos_.fieldbyname('predbcst').AsCurrency
        else
          produtos.fieldbyname('predbcst').clear;
      end;

      if produtos.FindField('predbcst_custo') <> nil then
      begin
        if qryDadosProdutos_.fieldbyname('predbcst').AsCurrency<>0 then
          produtos.fieldbyname('predbcst_custo').AsCurrency := qryDadosProdutos_.fieldbyname('predbcst').AsCurrency
        else
          produtos.fieldbyname('predbcst_custo').clear;
      end;

      if produtos.FindField('aliquotaipi') <> nil then
      begin
        if (qryDadosProdutos_.fieldbyname('aliquotaipi').AsFloat<>0) and
           (contribIPI or
            CondicaoRequerNFEntrada or
            CondicaoRequerNFSaida or
            CondicaoPedido or
            (OrigemCalculo in [Contrato, orcamento, OrdemdeServico]) or
            (OrigemCalculo in [NotaEntrada, CadastroPedidos]) or
            (OrigemCalculo = TransferenciaSaida)) then
          produtos.fieldbyname('aliquotaipi').AsFloat  := qryDadosProdutos_.fieldbyname('aliquotaipi').AsFloat
        else
          produtos.fieldbyname('aliquotaipi').clear;
      end;

      if qryDadosProdutos_.fieldbyname('ipi').AsInteger<>0 then
        if produtos.findfield('ipi')<>nil then
        begin
          if (OrigemCalculo = NotaEntradaXML) and
             parsistema.AtualizarNCMNotaEntrada then
          begin
            if (produtos.Name = 'qryProdutosNotasPagNFEItems') and
               (qryDadosProdutos_.fieldbyname('classificacaofiscal').AsString=
                produtos.fieldbyname('ncmfornecedor').AsString) and

               (produtos.fieldbyname('ipi').AsInteger <>
                qryDadosProdutos_.fieldbyname('ipi').AsInteger) then
            begin
              produtos.fieldbyname('ipi').AsInteger := qryDadosProdutos_.fieldbyname('ipi').AsInteger;
              produtos.fieldbyname('descricaoipi').AsString := qryDadosProdutos_.fieldbyname('descricaoipi').AsString;
            end;
          end
          else
            produtos.fieldbyname('ipi').AsInteger := qryDadosProdutos_.fieldbyname('ipi').AsInteger;
        end;

      if (produtos.findfield('nacionalfederal')<>nil) and
         (qryDadosProdutos_.findfield('nacionalfederal')<>nil) then
          produtos.fieldbyname('nacionalfederal').AsCurrency := qryDadosProdutos_.fieldbyname('nacionalfederal').AsCurrency;

      if (produtos.findfield('importadosfederal')<>nil) and
         (qryDadosProdutos_.findfield('importadosfederal')<>nil) then
          produtos.fieldbyname('importadosfederal').AsCurrency := qryDadosProdutos_.fieldbyname('importadosfederal').AsCurrency;

      if (produtos.findfield('cargaestadual')<>nil) and
         (qryDadosProdutos_.findfield('cargaesadual')<>nil) then
          produtos.fieldbyname('cargaestadual').AsCurrency := qryDadosProdutos_.fieldbyname('cargaestadual').AsCurrency;

     if (produtos.findfield('chaveibpt')<>nil) and
         (qryDadosProdutos_.findfield('chaveibpt')<>nil) then
          produtos.fieldbyname('chaveibpt').AsString := qryDadosProdutos_.fieldbyname('chaveibpt').AsString;

      if (qryDadosProdutos_.fieldbyname('classificacaofiscal').AsString='') then
      begin
        if ((NFSaidaouEntradaPelaEmpresa and parsistema.EmissorNfe) or Sped_pis_cofins or sped_fiscal) and not Assigned(ECFPadrao) then

        begin
          if produtos.findfield('classificacaofiscal')<>nil then
            produtos.fieldbyname('classificacaofiscal').clear;

          if produtos.findfield('ncmempresa')<>nil then
            produtos.fieldbyname('ncmempresa').clear;

          if OrigemCalculo <> NotaEntradaXML then
            MensagemErro('Este item não possui o codigo do NCM, verifique no cadastro de produtos');

          result := false;
        end
      end
      else
      begin
        if produtos.findfield('classificacaofiscal')<>nil then
          produtos.fieldbyname('classificacaofiscal').AsString := qryDadosProdutos_.fieldbyname('classificacaofiscal').AsString;

        if produtos.findfield('ncmempresa')<>nil then
          produtos.fieldbyname('ncmempresa').AsString := qryDadosProdutos_.fieldbyname('classificacaofiscal').AsString;
      end;


      //TIRADO DA CONDICAO, ORIGEM - NOTAAVULSA, NAO ESTAVA ATRIBUINDO PARA NOTAS DE DEVOLUCAO A FORNCEDOR
      if (not (OrigemCalculo in [Devolucao, Troca])) or
         (vTipoAtribuicao = tpSQLDadosProdutos) {pode ser de origem troca mas não possui nota relaccionada ao ítem}
      then
      begin

        if produtos.findfield('csosn')<>nil then
        begin
          if PossuiNDI then
             Produtos.FieldByName('csosn').AsString := '900'
          else
          if (codigofiscalproduto<>nil) and (CodigoFiscalProduto.FieldByName('csosn').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
            Produtos.FieldByName('csosn').AsString := CodigoFiscalProduto.FieldByName('csosn').AsString
          else
          if (qryDadosProdutos_.FieldByName('csosn').AsString <> '') and
             (Produtos.FieldByName('csosn').AsString = '') then  // VALOR DA INCIDENCIA NO CADASTRO DO PRODUTO
            Produtos.FieldByName('csosn').AsString := qryDadosProdutos_.FieldByName('csosn').AsString;

          if (OrigemCalculo = CadastroPedidos) and (RegimeTributario_ = 1) then
          begin
            if Produtos.FieldByName('csosn').AsString = '500' then
            begin
              Produtos.FieldByName('csosn_nf').AsString := '201';
              Produtos.FieldByName('cst_nf').AsString := '10';
            end
            else
            if Produtos.FieldByName('csosn').AsString = '900' then
            begin
              Produtos.FieldByName('csosn_nf').AsString := '900';
              Produtos.FieldByName('cst_nf').AsString := '90';
            end
            else
            if Produtos.FieldByName('csosn').AsString = '400' then
            begin
              Produtos.FieldByName('csosn_nf').AsString := '400';
              Produtos.FieldByName('cst_nf').AsString := '41';
            end
            else
            if (Produtos.FieldByName('csosn').AsString = '101') or
               (Produtos.FieldByName('csosn').AsString = '102') then
            begin
              Produtos.FieldByName('csosn_nf').AsString := '101';
              Produtos.FieldByName('cst_nf').AsString := '00';
            end;
          end;
        end;

        if not cancelamentonfforaprazolegal then
        begin
          if produtos.findfield('incidencia')<>nil then
          begin
            if PossuiNDI then
               Produtos.FieldByName('incidencia').AsString := '00'
            else
            if (codigofiscalproduto<>nil) and (CodigoFiscalProduto.FieldByName('icmscst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
              Produtos.FieldByName('incidencia').AsString := CodigoFiscalProduto.FieldByName('icmscst').AsString
            else
            if (qryDadosProdutos_.FieldByName('incidencia').AsString <> '') and
               (Produtos.FieldByName('incidencia').AsString='') then  // VALOR DA INCIDENCIA NO CADASTRO DO PRODUTO
              Produtos.FieldByName('incidencia').AsString := qryDadosProdutos_.FieldByName('incidencia').AsString;

            if (OrigemCalculo = CadastroPedidos) and (RegimeTributario_ <> 1) then
            begin
            {
              Conforme Sr. Waterkemper, Lúcio
              segue...
              Definição de regras para correlção entre os cst/csosn na empresa e o que supostamente viria na NF de entrada:
              http://www.lefisc.com.br/news/CSOSNNotasExplicativas.htm
              60,70 -> 10
              90 -> 90
              40 ->  40
              41 -> 41
              00 -> 00
              20 - > 20

              60,70 -> 201
              90 -> 900
              40,41 -> 400
              00,20 -> 101

             }

              if (Produtos.FieldByName('incidencia').AsString = '60') or
                 (Produtos.FieldByName('incidencia').AsString = '70') then
              begin
                Produtos.FieldByName('csosn_nf').AsString := '201';
                Produtos.FieldByName('cst_nf').AsString := '10';
              end
              else
              if Produtos.FieldByName('incidencia').AsString = '90' then
              begin
                Produtos.FieldByName('csosn_nf').AsString := '900';
                Produtos.FieldByName('cst_nf').AsString := '90';
              end
              else
              if Produtos.FieldByName('incidencia').AsString = '40' then
              begin
                Produtos.FieldByName('csosn_nf').AsString := '400';
                Produtos.FieldByName('cst_nf').AsString := '40';
              end
              else
              if Produtos.FieldByName('incidencia').AsString = '41' then
              begin
                Produtos.FieldByName('csosn_nf').AsString := '400';
                Produtos.FieldByName('cst_nf').AsString := '41';
              end
              else
              if (Produtos.FieldByName('incidencia').AsString = '00') then
              begin
                Produtos.FieldByName('csosn_nf').AsString := '101';
                Produtos.FieldByName('cst_nf').AsString := '00';
              end
              else
              if (Produtos.FieldByName('incidencia').AsString = '20') then
              begin
                Produtos.FieldByName('csosn_nf').AsString := '101';
                Produtos.FieldByName('cst_nf').AsString := '20';
              end;

            end;


          end;
        end;

        if produtos.findfield('ipicst')<>nil then
        begin
          if ipisuspenso and (ContribIPI or  ((codigofiscalproduto<>nil) and (CodigoFiscalProduto.fieldbyname('destacaripi').AsBoolean))) then
            Produtos.fieldbyname('ipicst').AsString := '55'
          else
          begin
            if (codigofiscalproduto<>nil) and (CodigoFiscalProduto.FieldByName('ipicst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
              Produtos.FieldByName('ipicst').AsString    := CodigoFiscalProduto.FieldByName('ipicst').AsString
            else
            if (qryDadosProdutos_.FieldByName('ipicst').AsString <> '') and
               (Produtos.FieldByName('ipicst').AsString = '')  then  // VALOR DO IPICST NO CADASTRO DO PRODUTO
              Produtos.FieldByName('ipicst').AsString := qryDadosProdutos_.FieldByName('ipicst').AsString;
          end;
        end;

        if produtos.findfield('piscst')<>nil then
        begin
          if (codigofiscalproduto<>nil) and (CodigoFiscalProduto.FieldByName('piscst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
            Produtos.FieldByName('piscst').AsString    := CodigoFiscalProduto.FieldByName('piscst').AsString
          else
          if (qryDadosProdutos_.FieldByName('piscst').AsString <> '') and
             (Produtos.FieldByName('piscst').AsString = '') then  // VALOR DO PISCST NO CADASTRO DO PRODUTO
            Produtos.FieldByName('piscst').AsString := qryDadosProdutos_.FieldByName('piscst').AsString;
        end;

        if produtos.findfield('cofinscst')<>nil then
        begin
          if (codigofiscalproduto<>nil) and (CodigoFiscalProduto.FieldByName('cofinscst').AsString <> '') then  // VALOR NA NATUREZA DEFINIDA
            Produtos.FieldByName('cofinscst').AsString    := CodigoFiscalProduto.FieldByName('cofinscst').AsString
          else
          if (qryDadosProdutos_.FieldByName('cofinscst').AsString <> '') and
             (Produtos.FieldByName('cofinscst').AsString = '') then  // VALOR DO IPICST NO CADASTRO DO PRODUTO
            Produtos.FieldByName('cofinscst').AsString := qryDadosProdutos_.FieldByName('cofinscst').AsString;
        end;

        if (OrigemCalculo in [NotaAvulsa]) then
        begin
          if (CodigoFiscalProduto.fieldbyname('codigofiscal').asinteger div 1000) = 7 then //exterior : não rever cfop
            AtribuirDadosCalculosImpostos(notas, qryDadosProdutos_, codigofiscalproduto, Produtos, OrigemCalculo, false)
          else
            AtribuirDadosCalculosImpostos(notas, qryDadosProdutos_, codigofiscalproduto, Produtos, OrigemCalculo, true);
        end
        else
        if (OrigemCalculo in [TransferenciaEntrada]) then
          AtribuirDadosCalculosImpostos(notas, qryDadosProdutos_, codigofiscalproduto, Produtos, OrigemCalculo, true, 'obs.: definido na função', EstadoDestino);
      end;

      if produtos.findfield('origem')<>nil then
      begin
        if PossuiNDI then
          Produtos.FieldByName('origem').AsInteger     := 1
        else
          Produtos.FieldByName('origem').AsInteger     := qryDadosProdutos_.FieldByName('origem').AsInteger;
      end;

      if Produtos.Findfield('composto')<>nil then
        Produtos.FieldByName('composto').AsBoolean := qryDadosProdutos_.FieldByName('composto').AsBoolean;

      if (Produtos.Findfield('discriminarcomposto')<>nil) and
         (qryDadosProdutos_.Findfield('discriminarcomposto')<>nil) then
      begin
        Produtos.FieldByName('discriminarcomposto').AsString := qryDadosProdutos_.FieldByName('discriminarcomposto').AsString;
      end;

      if (Produtos.Findfield('discriminarpreco')<>nil) and
         (qryDadosProdutos_.Findfield('discriminarpreco')<>nil) then
        Produtos.FieldByName('discriminarpreco').AsBoolean := qryDadosProdutos_.FieldByName('discriminarpreco').AsBoolean;

      if produtos.findfield('baseicms')<>nil then
        Produtos.FieldByName('baseicms').AsCurrency  := qryDadosProdutos_.FieldByName('baseicms').AsCurrency;

      if RegimeTributario_=1 then // SIMPLES
      begin
        if (produtos.findfield('csosn')<>nil) and (produtos.findfield('produto')<>nil) then
        begin
          if produtos.fieldbyname('csosn').isnull then
          begin
            if (notas <> nil) and
               (notas.findfield('codigofiscal')<>nil) and
               (notas.FieldByName('codigofiscal').AsInteger<>0) then
            begin
              result := false;
              MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname('produto').asstring,
                            'ICMS CSOSN - Tributação no simples nacional']));
            end;
          end;
        end;
      end
      else
      begin
        if (produtos.findfield('incidencia')<>nil) and (produtos.findfield('produto')<>nil) then
        begin
          if produtos.FieldByName('incidencia').isnull then
          begin
            if (notas <> nil) and
               (notas.findfield('codigofiscal')<>nil) and
               (notas.FieldByName('codigofiscal').AsInteger<>0) then
            begin
              result := false;
              MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname('produto').asstring,
                                'ICMS CST - Tributação do icms ']));
            end;
          end;
        end;
      end;


      if contribipi and
         (produtos.findfield('ipicst')<>nil) and
         (produtos.findfield('produto')<>nil) and
         produtos.FieldByName('ipicst').isnull then
      begin
        if (notas <> nil) and
           (notas.findfield('codigofiscal')<>nil) and
           (notas.FieldByName('codigofiscal').AsInteger<>0) then
        begin
          result := false;
          MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname('produto').asstring,
                        'IPI CST - Tributação do IPI']));
        end
      end
      else
      if (produtos.findfield('piscst')<>nil) and
         (produtos.findfield('produto')<>nil) and
         produtos.FieldByName('piscst').isnull then
      begin
        if not Assigned(ECFPadrao) then
        begin
          if (notas <> nil) and
             (notas.findfield('codigofiscal')<>nil) and
             (notas.FieldByName('codigofiscal').AsInteger<>0) then
          begin
            result := false;
            MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname('produto').asstring,
                          'PIS CST - Tributação do PIS']));
          end;
        end;
      end
      else
      if (produtos.findfield('cofinscst')<>nil) and
         (produtos.findfield('produto')<>nil) and
         produtos.FieldByName('cofinscst').isnull then
      begin
        if not Assigned(ECFPadrao) then
        begin
          if (notas <> nil) and
             (notas.findfield('codigofiscal')<>nil) and
             (notas.FieldByName('codigofiscal').AsInteger<>0) then
          begin
            result := false;
            MensagemErro(format(msgErroincidencia_faltante, [produtos.fieldbyname('produto').asstring,
                          'COFINS CST - Tributação do COFINS']));
          end;
        end;
      end;

      if (produtos.findfield('produtototal')<>nil) then
      begin

        if (OrigemCalculo in [NotaEntrada]) then
          produtos.fieldbyname('produtototal').AsCurrency := (Produtos.fieldByname('precounitario').AsFloat * produtos.fieldByName('quantidade').AsFloat)
        else
        if (OrigemCalculo in [CadastroPedidos]) then
          produtos.fieldbyname('produtototal').AsCurrency := (Produtos.fieldByname('preco').AsFloat * produtos.fieldByName('quantidade').AsFloat)

      end;

      if (produtos.findfield('AliquotaipiOriginal')<>nil) and
         (qryDadosProdutos_.findfield('AliquotaipiOriginal')<>nil) and
         (OrigemCalculo in [NotaEntrada, NotaEntradaXML, CadastroPedidos]) then
          produtos.fieldbyname('AliquotaipiOriginal').AsCurrency := qryDadosProdutos_.fieldbyname('AliquotaipiOriginal'). AsCurrency;

      if (produtos.findfield('enquadramento')<>nil) then
          produtos.fieldbyname('enquadramento').AsString := '999';

            {
      if (produtos.findfield('pfcp')<>nil) then
          produtos.fieldbyname('pfcp').AsCurrency := qryDadosProdutos_.fieldbyname('percfcp').AsCurrency;
          }

      if produtos.findfield('produtook')<>nil then
        produtos.fieldbyname('produtook').asboolean := result;

  end;

  

begin
  result := true;

  {ATRIBUIR DADOS NOS PRODUTOS DA NOTA FISCAL}
  if ((produtos.findfield('produto') <> nil) and (produtos.fieldbyname('produto').Asinteger <> 0)) then
  begin

    IncluirProdutonoEstoque;

    if CondicaoRequerNFEntrada or CondicaoDevolucaoTransferencia then
    begin
       vTipoAtribuicao := tpSQLDadosProdutosNotasEntradas;
       qryDadosProdutos_.Sql.text := SQLDadosProdutosNotasEntradas;
       qryDadosProdutos_.ParamByName('FilialBase').AsInteger := FilialBase;
       qryDadosProdutos_.ParamByName('produto').AsString := produtos.fieldbyname('produto').asstring;
       qryDadosProdutos_.ParamByName('dadofiscal').asinteger := 0;


       if notas <> nil then
       begin
         qryDadosProdutos_.ParamByName('fornecedor').AsInteger := notas.fieldbyname('cliente').asINteger;
         qryDadosProdutos_.ParamByName('tipofornecedor').AsString := notas.fieldbyname('tipocliente').asString;
         qryDadosProdutos_.ParamByName('dadofiscal').asinteger := Notas.fieldbyName('numero').asinteger;
       end;

       qryDadosProdutos_.ParamByName('codigonota').AsInteger := produtos.fieldbyname('codigonota').asinteger;
       qryDadosProdutos_.ParamByName('NumeroProduto').asinteger := produtos.fieldbyName('numeroprodutotabela').asinteger;
       qryDadosProdutos_.ParamByName('EstadoFilialBaseCalculoPreco').AsString := EstadoFilialBase;

    end
    else
    if CondicaoRequerNFSaida  or
       CondicaoNotaSaidaReferenciada or
       CondicaoTransferenciaEntrada then
    begin
      vTipoAtribuicao := tpSQLDadosProdutosNotasSaidas;
      qryDadosProdutos_.sql.clear;
      qryDadosProdutos_.Sql.text := SQLDadosProdutosNotasSaidas;

      qryDadosProdutos_.ParamByName('FilialBase').AsInteger := FilialBase;
      qryDadosProdutos_.ParamByName('produto').AsString := produtos.fieldbyname('produto').asstring;
      qryDadosProdutos_.ParamByName('codigonota').AsInteger := 0;

      if notas <> nil then
      begin

        if (OrigemCalculo in [NotaEntrada, Devolucao, Troca, TransferenciaEntrada]) then
        begin
          qryDadosProdutos_.ParamByName('codigonota').AsInteger := notas.fieldbyname('codigo').asinteger;
          qryDadosProdutos_.ParamByName('fornecedor').AsInteger := notas.fieldbyname('fornecedor').asINteger;
          qryDadosProdutos_.ParamByName('tipofornecedor').AsString := notas.fieldbyname('tipofornecedor').asString;
        end
        else
        if OrigemCalculo = NotaAvulsa then
        begin
          qryDadosProdutos_.ParamByName('fornecedor').AsInteger := notas.fieldbyname('cliente').asINteger;
          qryDadosProdutos_.ParamByName('tipofornecedor').AsString := notas.fieldbyname('tipocliente').asString;
        end;
      end;

      if CondicaoNotaSaidaReferenciada then
      begin
        if notas <> nil then
          qryDadosProdutos_.ParamByName('dadofiscal').asinteger := Notas.fieldbyName('dadofiscalreferenciado').asinteger;
      end
      else
        qryDadosProdutos_.ParamByName('dadofiscal').asinteger := produtos.fieldbyName('dadofiscal').asinteger;

      qryDadosProdutos_.ParamByName('NumeroProduto').asinteger := produtos.fieldbyName('numeroprodutotabela').asinteger;

      qryDadosProdutos_.ParamByName('EstadoFilialBaseCalculoPreco').AsString := EstadoFilialBase;
    end
    else
    if CondicaoPedido then
    begin
       vTipoAtribuicao := tpSQLDadosProdutosPedidos;
       qryDadosProdutos_.Sql.text := SQLDadosProdutosPedidos;
       qryDadosProdutos_.ParamByName('FilialBase').AsInteger := FilialBase;
       qryDadosProdutos_.ParamByName('produto').AsString := produtos.fieldbyname('produto').asstring;
       qryDadosProdutos_.ParamByName('pedido').asinteger := produtos.fieldbyName('pedido').asinteger;
       qryDadosProdutos_.ParamByName('EstadoFilialBaseCalculoPreco').AsString := EstadoFilialBase;
       if notas <> nil then
       begin
         qryDadosProdutos_.ParamByName('fornecedor').AsInteger := notas.fieldbyname('fornecedor').asINteger;
         qryDadosProdutos_.ParamByName('tipofornecedor').AsString := notas.fieldbyname('tipofornecedor').asString;
       end;
    end
    else
    begin
      vTipoAtribuicao := tpSQLDadosProdutos;
      qryDadosProdutos_.Sql.Text := SQLDadosProdutos;

      if notas <> nil then
      begin
        qryDadosProdutos_.ParamByName('EstadoFilialBase').AsString := ifthen(Saida,EstadoFilialBase, notas.fieldbyname('estado').asstring);
        qryDadosProdutos_.ParamByName('Estadocfo').AsString  := ifthen(Saida and (OrigemCalculo <> FrentedeCaixa), notas.fieldbyname('estado').asstring, EstadoFilialBase);

        if saida then
        begin
          qryDadosProdutos_.ParamByName('fornecedor').AsInteger := notas.fieldbyname('cliente').asinteger;
          qryDadosProdutos_.ParamByName('tipofornecedor').AsString := notas.fieldbyname('tipocliente').asString;
        end
        else
        begin
          qryDadosProdutos_.ParamByName('fornecedor').AsInteger := notas.fieldbyname('fornecedor').asinteger;

          if notas.findfield('tipofornecedor')<> nil then
            qryDadosProdutos_.ParamByName('tipofornecedor').AsString := notas.fieldbyname('tipofornecedor').asString
          else
            qryDadosProdutos_.ParamByName('tipofornecedor').AsString := 'F';

        end;

        if notas.findfield('contribicmsemitente')<>nil then
        begin
          vTeste :=  notas.fieldbyname('contribicmsemitente').asBoolean;
          qryDadosProdutos_.ParamByName('pContribuinteOrigem').AsBoolean := vTeste;
        end;

        if notas.findfield('contribicms')<>nil then
          qryDadosProdutos_.ParamByName('pContribuinteDestino').AsBoolean := notas.fieldbyname('contribicms').asBoolean
        else
        if notas.findfield('clientecontribicms')<>nil then
          qryDadosProdutos_.ParamByName('pContribuinteDestino').AsBoolean := notas.fieldbyname('clientecontribicms').asBoolean;


        if notas.findfield('vendaconsumidorfinal')<>nil then
          qryDadosProdutos_.ParamByName('pVendaConsumidorFinal').AsBoolean := notas.fieldbyname('vendaconsumidorfinal').asBoolean
        else
        if notas.findfield('consumidorfinal')<>nil then
          qryDadosProdutos_.ParamByName('pVendaConsumidorFinal').AsBoolean := notas.fieldbyname('consumidorfinal').asBoolean


          {a aliquota para cupom fiscal sempre será a estadual}
      end
      else
      begin
        qryDadosProdutos_.ParamByName('EstadoFilialBase').AsString := ifthen(Saida,EstadoFilialBase, EstadoDestino);
        qryDadosProdutos_.ParamByName('Estadocfo').AsString  := ifthen(Saida and (OrigemCalculo <> FrentedeCaixa), EstadoDestino, EstadoFilialBase);
      end;

      qryDadosProdutos_.ParamByName('EstadoFilialBaseCalculoPreco').AsString := EstadoFilialBase;

      if (notas <> nil) and
         (notas.findfield('pessoatipo')<>nil) then
        qryDadosProdutos_.ParamByName('TipoPessoa').AsString  := notas.fieldbyname('pessoatipo').asstring
      else
        qryDadosProdutos_.ParamByName('TipoPessoa').AsString  := 'J';

      if (OrigemCalculo in [Contrato, Orcamento, OrdemdeServico]) then
        qryDadosProdutos_.ParamByName('FilialBase').AsInteger := ifthen(TipoFilial<>'V', FilialBase, FilialBasedaVirtual)
      else
        qryDadosProdutos_.ParamByName('FilialBase').AsInteger := FilialBase;

      qryDadosProdutos_.ParamByName('filialbaseemissaonota').AsInteger := FilialBase;

      qryDadosProdutos_.ParamByName('produto').AsString := produtos.fieldbyname('produto').asstring;
    end;

    qryDadosProdutos_.close;
    qryDadosProdutos_.Open;

    if qryDadosProdutos_.RecordCount = 1 then
    begin

      EditarProdutos;

      if CondicaoRequerNFEntrada then
      begin
        if (produtos.findfield('codigonotaoriginal') <> nil) and
           (produtos.findfield('numeroprodutooriginal') <> nil) and
           (produtos.findfield('produtooriginal') <> nil) then
        begin

          if qryDadosProdutos_.FieldByName('codigonotaoriginal').AsInteger <> 0 then
          begin
            produtos.fieldbyname('codigonotaoriginal').Asinteger := qryDadosProdutos_.FieldByName('codigonotaoriginal').AsInteger;
            produtos.fieldbyname('numeroprodutooriginal').Asinteger := qryDadosProdutos_.FieldByName('numeroprodutooriginal').AsInteger;
            produtos.fieldbyname('produtooriginal').AsString := qryDadosProdutos_.FieldByName('produtooriginal').AsString;
          end
          else
          begin
            produtos.fieldbyname('codigonotaoriginal').Asinteger := qryDadosProdutos_.FieldByName('codigonota').AsInteger;
            produtos.fieldbyname('numeroprodutooriginal').Asinteger := qryDadosProdutos_.FieldByName('numeroproduto').AsInteger;
            produtos.fieldbyname('produtooriginal').AsString := qryDadosProdutos_.FieldByName('produto').AsString;
          end;
        end;

        if (produtos.findfield('quantidadenotaorigem') <> nil) and
           (qryDadosProdutos_.findfield('quantidadenotaorigem') <> nil) then
          produtos.fieldByName('quantidadenotaorigem').asCurrency := qryDadosProdutos_.fieldByName('quantidadenotaorigem').asCurrency;
      end;

      if Produtos.findField('fatorconversao') <> nil then
        Produtos.fieldbyname('fatorconversao').AsFloat := qryDadosProdutos_.fieldbyname('fatorconversao').AsFloat;

      if CondicaoRequerNFSaida then
      begin
        if (produtos.findfield('codigonotaoriginal') <> nil) and
           (produtos.findfield('numeroprodutooriginal') <> nil) and
           (produtos.findfield('produtooriginal') <> nil) then
        begin
          if qryDadosProdutos_.FieldByName('codigonotaoriginal').AsInteger <> 0 then
          begin
            produtos.fieldbyname('codigonotaoriginal').Asinteger := qryDadosProdutos_.FieldByName('codigonotaoriginal').AsInteger;
            produtos.fieldbyname('numeroprodutooriginal').Asinteger := qryDadosProdutos_.FieldByName('numeroprodutooriginal').AsInteger;
            produtos.fieldbyname('produtooriginal').AsString := qryDadosProdutos_.FieldByName('produtooriginal').AsString;
          end
          else
          begin
            produtos.fieldbyname('codigonotaoriginal').clear;
            produtos.fieldbyname('numeroprodutooriginal').clear;
            produtos.fieldbyname('produtooriginal').clear;
          end;
        end;
      end;

      if CondicaoRequerNFEntrada then
      begin
//        if (Produtos.fieldbyname('quantidade').AsFloat > qryDadosProdutos_.fieldbyname('quantidade').AsFloat) then
        if (Produtos.fieldbyname('quantidade').AsFloat = 0) then
          Produtos.fieldbyname('quantidade').AsFloat := qryDadosProdutos_.fieldbyname('quantidade').AsFloat;

        produtos.fieldbyname('quantidadenotaentrada').AsCurrency := qryDadosProdutos_.fieldbyname('quantidade').AsFloat;
        produtos.fieldbyname('qtdeestoque').AsFloat   := Produtos.fieldbyname('quantidade').AsFloat * Produtos.fieldbyname('fatorconversao').AsFloat;

      end
      else
      if CondicaoPedido or CondicaoRequerNFSaida or CondicaoNotaSaidaReferenciada or CondicaoTransferenciaEntrada then
      begin
        if not (OrigemCalculo in [NotaEntradaXML, Devolucao, Troca]) then
          Produtos.fieldbyname('quantidade').AsFloat := qryDadosProdutos_.fieldbyname('quantidade').AsFloat;
      end;


      if CondicaoCancelamentoDadoFiscalReferenciado(OrigemCalculo, Notas, produtos) or

        CondicaoRequerNFEntrada or CondicaoDevolucaoTransferencia or
        CondicaoRequerNFSaida or
        CondicaoNotaSaidaReferenciada or
        CondicaoTransferenciaEntrada  then
          AtribuirDadosNotasRelacionadas;

      AtribuirDadosDiversos;
    end;

  end;
end;



function TdtmBasico.TipoNotaSaida(CodigoFiscal: integer): TtecTipoNotaSaida;
var
  CodFiscal: Integer;
begin
  CodFiscal := codigofiscal mod 1000;
  if (CodFiscal = ctCFOTRANSFERENCIA_150) or
     (CodFiscal = ctCFOTRANSFERENCIA_151) or
     (CodFiscal = ctCFOTRANSFERENCIA_152) or
     (CodFiscal = ctCFOTRANSFERENCIANAOTRANS) or
     (CodFiscal = ctCFOTRANSFERENCIASUBSTITUICAO)
  then
    result:= tnsTRANSFERENCIA
  else if (CodFiscal = ctCFOTRANSFERENCIACREDITOICMS) or
          (CodFiscal = ctCFOTRANSFERENCIASALDOCREDORICMS) or
          (CodFiscal = ctCFOTRANSFERENCIASALDODEVEDORICMS)
  then
    result := tnsTRANSFERENCIAICMS
  else if (CodFiscal = ctCFODEVOLUCAOSUBSTITUICAO) then
    result := tnsDEVOLUCAOFORNECEDORST
  else if (CodFiscal = ctDEVOLUCAO) then
    result := tnsDEVOLUCAOFORNECEDOR
  else
    result := tnsNORMAL;
end;

function TdtmBasico.eHNotaFiscalSaidaDevolucao(CodigoFiscal: integer; ST: boolean = false): boolean;
var
 vAbrirConsulta : Boolean;
begin
  vAbrirConsulta := True;
  if not assigned(qryCodigosFiscais) then
  begin
    qryCodigosFiscais := TTecQuery.Create((nil));
    qryCodigosFiscais.Database  := dtmTecSoft.Database;
    vAbrirConsulta := True;
  end
  else
  begin
    vAbrirConsulta :=  (pCodigoFiscal_eHNotaFiscalSaidaDevolucao <> CodigoFiscal) or
                       (pST_eHNotaFiscalSaidaDevolucao <> ST);
  end;

  if vAbrirConsulta then
  begin
    pCodigoFiscal_eHNotaFiscalSaidaDevolucao := CodigoFiscal;
    pST_eHNotaFiscalSaidaDevolucao := ST;

    if st then
      qryCodigosFiscais.sql.text  := 'select * from codigosfiscais where codigo = :codigofiscal and coalesce(st,false) and coalesce(devolucaoretorno,false) and (codigo - mod(codigo,1000)) >= 5000'
    else
      qryCodigosFiscais.sql.text  := 'select * from codigosfiscais where codigo = :codigofiscal and coalesce(devolucaoretorno,false) and (codigo - mod(codigo,1000)) >= 5000';
    ReFazConsulta(qryCodigosFiscais,[0],[CodigoFiscal]);
    result := (qryCodigosFiscais.RecordCount = 1);

    pResult_eHNotaFiscalSaidaDevolucao := result;

  end
  else
    result := pResult_eHNotaFiscalSaidaDevolucao;

(*
    if ST then
      result := (CodigoFiscal mod 1000  = 410) or  // Devolução de compra para industrialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 411) or  // Devolução de compra para comercialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 412) or  // Devolução de bem do ativo imobilizado, em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 413)     // Devolução de mercadoria destinada ao uso ou consumo, em operação com mercadoria sujeita ao regime de substituição tributária

    else
      result := (CodigoFiscal mod 1000  = 201) or  // Devolução de compra para industrialização
                (CodigoFiscal mod 1000  = 202) or  // Devolução de compra para comercialização

                (CodigoFiscal mod 1000  = 205) or  // Anulação de valor relativo a aquisição de serviço de comunicação
                (CodigoFiscal mod 1000  = 206) or  // Anulação de valor relativo a aquisição de serviço de transporte
                (CodigoFiscal mod 1000  = 207) or  // Anulação de valor relativo à compra de energia elétrica
                (CodigoFiscal mod 1000  = 208) or  // Devolução de mercadoria recebida em transferência para industrialização
                (CodigoFiscal mod 1000  = 209) or  // Devolução de mercadoria recebida em transferência para comercialização
                (CodigoFiscal mod 1000  = 210) or  // Devolução de compra para utilização na prestação de serviço

                (CodigoFiscal mod 1000  = 410) or  // Devolução de compra para industrialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 411) or  // Devolução de compra para comercialização em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 412) or  // Devolução de bem do ativo imobilizado, em operação com mercadoria sujeita ao regime de substituição tributária
                (CodigoFiscal mod 1000  = 413) or  // Devolução de mercadoria destinada ao uso ou consumo, em operação com mercadoria sujeita ao regime de substituição tributária

                (CodigoFiscal mod 1000  = 553) or  // Devolução de compra de bem para o ativo imobilizado
                (CodigoFiscal mod 1000  = 555) or  // Devolução de bem do ativo imobilizado de terceiro, recebido para uso no estabelecimento
                (CodigoFiscal mod 1000  = 556) or  // Devolução de compra de material de uso ou consumo
                (CodigoFiscal mod 1000  = 902) or  // Retorno de mercadoria utilizada na industrialização por encomenda
                (CodigoFiscal mod 1000  = 903) or  // Retorno de mercadoria recebida para industrialização e não aplicada no referido processo
                (CodigoFiscal mod 1000  = 913);    // Retorno de mercadoria recebida para demonstração

  *)

end;


function TdtmBasico.GetRuaComNumeroFilialBase: String;
begin
  result := RuaSemNumeroFilialBase;
  if NumeroFilialBase<>'' then
    result := result + ', '+ NumeroFilialBase;

  if ComplementoFilialBase<>'' then
    result := result + ', '+ ComplementoFilialBase;

end;

function TdtmBasico.GetDIMOB: integer;
begin
  result := fDIMOB
end;

function TdtmBasico.CondicaoICMS(valorST: String; Saida: Boolean; EmissaoPropria: boolean = false;
                                 naocalcularvaloresicmsdiferimento: boolean = false;
                                 Distribuidor : Boolean = false): boolean;
begin
  result := ((RegimeTributario = 1) and
              ((((valorST = '900') or
                 (valorST = '201') or
                 (valorST = '202') or
                 (valorST = '203')) and saida)
                 or not saida))                    or
(*
            ((RegimeTributario <> 1) and
               ((valorST = ctTRIBUTADA               )                  or   {00}
                ((valorST = ctTRIBUTADASUBSTITUICAO   ) and (saida or EmissaoPropria))      or   {10}
                (valorST = ctREDUCAOBASE              )                 or   {20}
                ((valorST = ctDIFERIMENTO)  and not naocalcularvaloresicmsdiferimento)                 or   {51}
                ((valorST = ctCOBRADOSUSTITUICAO      ) and not saida and not distribuidor) or   {60}
                ((valorST = ctREDUCAOBASESUBSTITUICAO ) and saida)      or   {70}
                (valorST = ctOUTROS                   )));                   {90}
*)


               ((RegimeTributario <> 1) and
               ((valorST = ctTRIBUTADA               )                  or   {00}
                (valorST = ctTRIBUTADASUBSTITUICAO   )       or   {10}
                (valorST = ctREDUCAOBASE             )                 or   {20}
                ((valorST = ctDIFERIMENTO)  and not naocalcularvaloresicmsdiferimento)                 or   {51}
                (valorST = ctREDUCAOBASESUBSTITUICAO )       or   {70}
                (valorST = ctOUTROS                   )));                   {90}


{
  1 – Simples Nacional;
  2 – Simples Nacional – excesso de sublimite de receita bruta;
  3 – Regime Normal. (v2.0)
}



end;


(*
  function CondicaoSubstituicaoTributaria: Boolean;
  begin
    if regimetributario = 1 then
       {nfe : 900}
      result :=  ((produtos.fieldbyname('csosn').AsString = '201'   ) or
                  (produtos.fieldbyname('csosn').AsString = '202'   ) or
                  (produtos.fieldbyname('csosn').AsString = '203'   ) or
                  ((produtos.fieldbyname('csosn').AsString = '500') and not saida  ) or
                  (produtos.fieldbyname('csosn').AsString = '900'   )) and
                 PermiteST
    else
            {nfe: 10, 30, 70, 90}
     result := (((produtos.fieldbyname('incidencia').AsString = ctTRIBUTADASUBSTITUICAO) and saida) or  {10}
                ((produtos.fieldbyname('incidencia').AsString = ctISENTASUBSTITUICAO) and saida) or  {30}
                ((produtos.fieldbyname('incidencia').AsString = ctREDUCAOBASESUBSTITUICAO) and saida) or  {70}
                ((produtos.fieldbyname('incidencia').AsString = ctCOBRADOSUSTITUICAO) and not saida ) or {60}
                (produtos.fieldbyname('incidencia').AsString = ctOUTROS                  )) and   {90}
                PermiteST;
  end;
*)

function TdtmBasico.CondicaoICMSST(valorST: String; Saida: Boolean;
  PessoaTipo: String; VendaConsumidorFinal: Boolean; Distribuidor : Boolean = false;
  EmissaoPropria: boolean = false): Boolean;
begin
    if regimetributario = 1 then
       {nfe : 900}
      result :=  ( (valorST  = '201' ) or
                   (valorST  = '202' ) or
                   (valorST  = '203' ) or
                   ((valorST = '500' ) and not saida  ) or
                   (valorST  = '900' )) and
                   (PessoaTipo='J') and
                   not VendaConsumidorFinal and
                   (not Distribuidor or Saida)
    else

    (*
            {nfe: 10, 30, 70, 90}
     result := (((valorST = ctTRIBUTADASUBSTITUICAO)   and (saida or EmissaoPropria)}) or      {10}
                ((valorST = ctISENTASUBSTITUICAO)      and saida) or      {30}
                ((valorST = ctREDUCAOBASESUBSTITUICAO) and saida) or      {70}
                ((valorST = ctCOBRADOSUSTITUICAO)      and not saida ) or {60}
                 (valorST = ctOUTROS                )) and               {90}
                 (PessoaTipo='J') and
                not VendaConsumidorFinal and
                (not distribuidor or Saida);
    *)


     result := (valorST = ctTRIBUTADASUBSTITUICAO)    or      {10}
               (valorST = ctISENTASUBSTITUICAO)   or      {30}
               (valorST = ctREDUCAOBASESUBSTITUICAO)  or      {70}
               (valorST = ctOUTROS                ) and               {90}
               (PessoaTipo='J') and
                not VendaConsumidorFinal and
               (not distribuidor or Saida);


end;

function TdtmBasico.ImportarArquivoTXT(NomeArquivo: String; TipoArquivo: TTipoArquivo): boolean;
var Arquivo: TextFile;
    vLinha : String;
    RBlock, x, vtam, tam: integer;
begin
  result := true;

  Try
    AssignFile(Arquivo, NomeArquivo);
    Reset(Arquivo);

    while not eof(arquivo) do
    begin
      readln(arquivo, vlinha);
      if vLinha = '-----------------------------------------------------------------------------------------------' then
      begin
        readln(arquivo);
        readln(arquivo);
        break;
      end;
    end;

    ArquivoTXT_Daico := nil;
    while not eof(arquivo) do
    begin
      readln(arquivo, vlinha);
      if vlinha = '' then
        break;
      vtam := length(ArquivoTXT_Daico)+1;
      SetLength(ArquivoTXT_Daico, vtam);
      ArquivoTXT_Daico[vtam-1].Item := strtoint(trim(copy(vLinha,1,5)));
      ArquivoTXT_Daico[vtam-1].Quantidade := strtofloat(trocar(trim(copy(vLinha,6,5)),'.',','));
      ArquivoTXT_Daico[vtam-1].Referencia := trim(copy(vLinha,11,13));
      ArquivoTXT_Daico[vtam-1].Descricao  := trim(copy(vLinha,24,45));
      ArquivoTXT_Daico[vtam-1].Dimensoes  := trim(copy(vLinha,69,19));
      ArquivoTXT_Daico[vtam-1].PrecoCT    := strtofloat(trocar(trim(copy(vLinha,88,8)),'.',','));
    end;
    CloseFile(Arquivo);


  except
  on E: Exception do
    begin
      result := false;
      Close(Arquivo);
      raise exception.create(ctERROABERTURAARQUIVOTEXTO +  NomeArquivo);
    end;
  end;

end;


