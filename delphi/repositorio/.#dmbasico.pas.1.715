 SQLDetalheDemaisDoctos = ' select * from detalhedemaisdoctos '+
                           ' where filial  = :filial     '+
                           '   and NUM_USU = :NUM_USU    '+
                           '   and CRO     = :CRO        '+
                           '   and COO     = :COO        '+
