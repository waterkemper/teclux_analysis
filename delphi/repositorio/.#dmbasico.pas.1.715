function TdtmBasico.EnderecoCliente(rua, numero, complemento, bairro,
  nomebairro, cidade, nomecidade, cep, estado: String): String;
begin
  if (cep = CEPFilialBase) and
     (rua = RuaFilialBase) and
     (numero = NumeroFilialBase) and
     (complemento = ComplementoFilialBase) and
     (bairro = CodigoBairroFilialBase) and
     (cidade = CodigoCidadeFilialBase) and
     (estado = EstadoFilialBase) then
     result := ''
  else
    result := rua + ' ' + numero + ' ' + complemento +
             ' Bairro: ' + nomebairro +
             ' Cep: ' + cep + ' - ' + nomecidade + ' - ' +
              estado;
end;

