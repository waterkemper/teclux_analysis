          begin
            vDiferenca := notas.fieldbyname('valoricms').ascurrency - vvaloricms;
            if (abs(vDiferenca) <= 0.1) and (abs(vDiferenca)<>0) then
            begin
              produtos.last;
              while not produtos.Bof do
              begin
                if produtos.fieldbyname('icmsvalor').AsCurrency <> 0 then
                begin
                  produtos.edit;
                  produtos.fieldbyname('icmsvalor').AsCurrency := produtos.fieldbyname('icmsvalor').AsCurrency + vDiferenca;
                  produtos.post;
                  vValorICMS := notas.fieldbyname('valoricms').ascurrency;
                  break;
                end;
                produtos.prior;
              end;
            end;
          end;

          if (OrigemCalculo in [NotaEntrada, CadastroPedidos, TransferenciaEntrada]) and not PermiteAlterarDadosICMS then
          begin
            vDiferenca := notas.fieldbyname('baseicmssubstituicao').ascurrency - vbaseicmsST;
            { AJUSTAR OS CENTAVOS QUANDO A NFE NÃO ESTA FECHANDO O VALOR DA BASE DO ICMS ST}
            if (abs(vDiferenca) <= 0.1) and (abs(vDiferenca)<>0) then
            begin
              produtos.last;
              while not produtos.Bof do
              begin
                if produtos.fieldbyname('icmsbasecalculost').AsCurrency <> 0 then
                begin
                  produtos.edit;
                  produtos.fieldbyname('icmsbasecalculost').AsCurrency := produtos.fieldbyname('icmsbasecalculost').AsCurrency + vDiferenca;
                  produtos.post;
                  vbaseicmsst := notas.fieldbyname('baseicmssubstituicao').ascurrency;
