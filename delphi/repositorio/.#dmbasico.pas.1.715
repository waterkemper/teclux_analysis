           07 - Operação Isenta da Contribuição
           71     | Operação de Aquisição com Isenção
          }
          if (produtos.FieldByName('piscst').AsString = '07') or
             (produtos.FieldByName('piscst').AsString = '71') then
          begin
            {if HeImportacao then

            else
            begin}
