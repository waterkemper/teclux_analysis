function TdtmBasico.ObterAutorizacao(TipoAutorizacao: TtecTipoAutorizacao): TtecUsuarios;
begin
  Result := ObterAutorizacao(TipoAutorizacao, '', '')
end;

class function TdtmBasico.ObterAutorizacao(TipoAutorizacao: TtecTipoAutorizacao; Motivo, Responsavel, Complemento: String): TtecUsuarios;
var
  Msg: String;
begin
  try
    conexao_em_excessao := true;
    Msg := Format(ctTEXTOAUTORIZACAO, [Motivo, Responsavel]) + #10#13 + Complemento;
    dtmsenhaautorizacao := TdtmSenhaAutorizacao.Create(Application.MainForm, TipoAutorizacao, Msg);
    try
      if Assigned(dtmSenhaAutorizacao) and dtmSenhaAutorizacao.Autorizado then

        try
          Result := TtecUsuarios.Create(dtmSenhaAutorizacao.dbaTecSoft)
        except
          on E:Exception do begin
            if Pos('permission denied', E.Message) > 0 then
              MensagemErro(ctERROPERMISSAONEGADA)
            else
              MensagemErro(E.Message);
            Result := nil;
          end
        end
      else
        Result := nil;
    finally
      dtmsenhaautorizacao.Free;
      dtmsenhaautorizacao := nil;
      RestaurarFoco;
    end;
  finally
    conexao_em_excessao := not parsistema.VerificarExcessaoConexao { false};
  end;
end;

function TdtmBasico.Perpetrar(ds: array of TZDataSet; FormaTerminoTransacao: TtecFormaTerminoTransacao): Boolean;
var
  a,t: Integer;
  vReadonly, vResult : Boolean;
  vOnPerpetrar : TtecVerificarDados;

  function ExisteCampoModoInclusaoRomaneio(Tabela: TZDataSet): Boolean;
  var
    i: integer;
  begin
    result := False;
    for i:=0 to Tabela.fields.count-1 do
      if Tabela.fields[i].FieldName = 'modoinclusaoromaneio' then
      begin
        result := True;
        break;
      end;
  end;

begin
  try
//    Application.ProcessMessages;
//    Screen.Cursor := crHourGlass;

    vResult := true;

    vOnPerpetrar := Normal;

    if OnPerpetrarAtivado and (FormaTerminoTransacao <> SomenteGravacao) then
    begin
      vOnPerpetrar := OnPerpetrar(ds) ;
      vResult := vOnperpetrar in [Prosseguir, Prosseguir_e_ReabrirVerificacao];
    end;

    if vResult then
    begin

      try
        for a := 0 to High(ds) do
          if ds[a] is TZDataSet then
            if ds[a].UpdatesPending then
            begin
              vReadonly := ds[a].readonly;
              if vReadonly then
                ds[a].readonly := false;
              ds[a].ApplyUpdates;
              if vReadonly then
                ds[a].readonly := true;
            end;

        case FormaTerminoTransacao of
          SomenteGravacao: dtmTecSoft.tstTecSoft.Commit;

          Simples:
          begin
            dtmTecSoft.tstTecSoft.Commit;

            if (vvTtecQuery <> nil) and (fFormaTerminoTransacao=AguardareTerminaremOutroDm) then
            begin
              for a := 0 to High(vvTtecQuery) do
                if vvTtecQuery[a] is TZDataSet then
                  if vvTtecQuery[a].CachedUpdates and vvTtecQuery[a].Active then
                    vvTtecQuery[a].CommitUpdates;

              for a := 0 to High(ds) do
                if ds[a] is TZDataSet then
                  if ds[a].CachedUpdates and ds[a].Active then
                    ds[a].CommitUpdates;

              vvTtecQuery := nil;
              fFormaTerminoTransacao := FormaTerminoTransacao;

            end
            else
            if (vvTtecQueryDm <> nil) and (fFormaTerminoTransacao=AguardareTerminarDentroDm) then
            begin
              for a := 0 to High(vvTtecQueryDm) do
                if vvTtecQueryDm[a] is TZDataSet then
                  if vvTtecQueryDm[a].CachedUpdates and vvTtecQueryDm[a].Active then
                    vvTtecQueryDm[a].CommitUpdates;

              for a := 0 to High(ds) do
                if ds[a] is TZDataSet then
                  if ds[a].CachedUpdates and ds[a].Active then
                    ds[a].CommitUpdates;

              vvTtecQueryDm := nil;
              fFormaTerminoTransacao := FormaTerminoTransacao;

            end
            else
            begin
              for a := 0 to High(ds) do
                if ds[a] is TZDataSet then
                  if ds[a].CachedUpdates and ds[a].Active then
                    ds[a].CommitUpdates;
            end;
          end;

          AguardareTerminaremOutroDm:
          begin

            for a := 0 to High(ds) do
            begin
              t := length(vvTtecQuery);
              SetLength(vvTtecQuery, t+1);
              vvTtecQuery[t] := ds[a];
            end;
            fFormaTerminoTransacao := FormaTerminoTransacao;

          end;

          AguardareTerminarDentroDm:
          begin

            for a := 0 to High(ds) do
            begin
              t := length(vvTtecQueryDm);
              SetLength(vvTtecQueryDm, t+1);
              vvTtecQueryDm[t] := ds[a];
            end;
            fFormaTerminoTransacao := FormaTerminoTransacao;

          end;
        end;

        Result := True;

      except

        on E: Exception do
        begin
          result := false;

          case FormaTerminoTransacao of

            AguardareTerminaremOutroDm:
            begin
              if vvTtecQuery <> nil then
              begin
                for a := 0 to High(vvTtecQuery) do
                  if vvTtecQuery[a] is TZDataSet then
                  begin
                    vvTtecQuery[a].RevertRecord;
                    vvTtecQuery[a].CancelUpdates;
                  end;
              end;
            end;

            AguardareTerminarDentroDm:
            begin
              if vvTtecQueryDm <> nil then
              begin
                for a := 0 to High(vvTtecQueryDm) do
                  if vvTtecQueryDm[a] is TZDataSet then
                  begin
                    vvTtecQueryDm[a].RevertRecord;
                    vvTtecQueryDm[a].CancelUpdates;
                  end;
              end;
            end;

          end;

          for a := 0 to High(ds) do
            if ds[a] is TZDataSet then
            begin
              ds[a].RevertRecord;
              ds[a].CancelUpdates;
            end;

          dtmTecSoft.tstTecSoft.Rollback;

//          result := false;

          ShowMessage(E.Message);
        end;

      end;

      if result then
      begin
        try


          for a := 0 to High(ds) do
          begin
            if ds[a] is TZDataSet then
            begin

              if (ds[a].FindField('hash_paf_registro_j1')<>nil) and

                 (ds[a].Fieldbyname('hash_paf_registro_j1').isnull) and

                 ((ds[a].FindField('modelodocto')<>nil) and

                   (((ds[a].Fieldbyname('modelodocto').asstring ='55') or
                     (ds[a].Fieldbyname('modelodocto').asstring ='65')) and
                     ((ds[a].FindField('numprotocolonfe')<>nil) and
                      (not ds[a].Fieldbyname('numprotocolonfe').isnull))) or

                   ((ds[a].Fieldbyname('modelodocto').asstring <>'55') and
                    (ds[a].Fieldbyname('modelodocto').asstring <>'65'))) then
                AtualizarHashJ(ds[a].FieldByName('numero').asinteger);
            end;
          end;


          if Parsistema.Incluir_nota_entre_filiais_automaticamente_nos_romaneios then
          begin
            for a := 0 to High(ds) do
            begin
              if (ds[a] is TZDataSet) and
                 (ds[a].Name = 'qryDadosFiscais') and
                 ExisteCampoModoInclusaoRomaneio(ds[a]) then
              begin

                if (ds[a].Fieldbyname('modoinclusaoromaneio').IsNull) and

                   ((ds[a].FindField('modelodocto')<>nil) and

                    ((((ds[a].Fieldbyname('modelodocto').asstring ='55') or
                       (ds[a].Fieldbyname('modelodocto').asstring ='65')) and
                       ((ds[a].FindField('numprotocolonfe')<>nil) and
                        (not ds[a].Fieldbyname('numprotocolonfe').isnull))) or

                     ((ds[a].Fieldbyname('modelodocto').asstring <>'55') and
                      (ds[a].Fieldbyname('modelodocto').asstring <>'65'))
                    )
                   ) and

                   (
                    ((ds[a].FindField('vendatransferencia')<>nil) and TBooleanField(ds[a].Fieldbyname('vendatransferencia')).asBoolean) or
                    ehnotafiscalsaidadevolucao(ds[a].Fieldbyname('codigofiscal').AsInteger) or
                    ehnotafiscalsaidatransferencia(ds[a].Fieldbyname('codigofiscal').AsInteger)
                   ) and

                   (ds[a].Fieldbyname('situacao').AsString = 'N') and

                   (ValorCampodaTabela('filiais', ['cnpj'], [ds[a].Fieldbyname('pessoanumero').AsString], ['cnpj'])[0] = ds[a].Fieldbyname('pessoanumero').AsString)

                   then
                begin


                  if (MensagemSimNaoOpcaoCancelar('Incluir esta Nota Fiscal em um romaneio?','Não Incluir',false, 'Existente', 'Novo') in [mrYES, mrNO]) then
                  begin

                    ds[a].edit;
                    if vMensagemSimNaoOpcaoCancelar = mrYES then
                      ds[a].Fieldbyname('modoinclusaoromaneio').asInteger := 2
                    else
                      ds[a].Fieldbyname('modoinclusaoromaneio').asInteger := 1;
                    ds[a].post;
                    ds[a].ApplyUpdates;
                    ds[a].CommitUpdates;
                    dtmTecSoft.tstTecSoft.Commit;

                  end;

                end;
              end;
            end;
          end;


          (*
         // SITUAÇÃO PARA ORÇAMENTO basenado-se no momento da gravação:
         // Perpetrar([qryClientes, qryOrcamentos, qryProdutosOrcamentos, qryServicosOrcamento, qryPlanosOrcamentos, qryParcelasPlanosOrcamentos, qryUsuarios_Site])
          if (InRange(0, Low(ds), High(ds))) and
             (InRange(1, Low(ds), High(ds))) and
             (lowercase(ds[0].Name) = 'qryclientes') and
             (lowercase(ds[1].Name) = 'qryorcamentos') then
            AcionarTelaEnquete(ds[0].FieldByName('codigo').asinteger,      //cliente
                               'C',                                        //tipocliente
                               ds[1].FieldByName('codigo').asinteger,      //orcamento
                               '')                                         //contrato
          else
         // SITUAÇÃO PARA ORÇAMENTO basenado-se no momento da gravação: (orcamento para contrato)
         // Perpetrar([qryClientes, qryContratos, qryProdutosContratos, qryServicosContratos, qryParcelas, qryOrcamentos, qryProdutosOrcamentos]);
          if (InRange(0, Low(ds), High(ds))) and
             (InRange(1, Low(ds), High(ds))) and
             (InRange(5, Low(ds), High(ds))) and

             (lowercase(ds[0].Name) = 'qryclientes') and
             (lowercase(ds[1].Name) = 'qrycontratos') and
             (lowercase(ds[5].Name) = 'qryorcamentos') then

            AcionarTelaEnquete(ds[0].FieldByName('codigo').asinteger,      //cliente
                               'C',                                        //tipocliente
                               ds[5].FieldByName('codigo').asinteger,      //orcamento
                               ds[1].FieldByName('numero').asString)       //contrato

          else
          // SITUAÇÃO PARA CONTRATO baseanado-se no momento da gravação:
          // Contrato Orçado
          //  result := Perpetrar([qryClientes, qryContratos, qryParcelas, qryRecebimentos, qryProdutosContratos,
          //                          qryServicosContratos,  qryProdutosListaCasamento, qryCopiarContrato,
          //                          qryCopiarProdutosContrato, qryImpostosRetidosContratos, qryReceitaOculos, qryUsuarios_Site]);

          if (InRange(0, Low(ds), High(ds))) and
             (InRange(1, Low(ds), High(ds))) and

             (lowercase(ds[0].Name) = 'qryclientes') and
             (lowercase(ds[1].Name) = 'qrycontratos') and
             (ds[1].FieldByName('situacao').asString = 'O') then

            AcionarTelaEnquete(ds[0].FieldByName('codigo').asinteger,      //cliente
                               'C',                                        //tipocliente
                               0,                                          //orcamento
                               ds[1].FieldByName('numero').asString)       //contrato

           else
           // SITUAÇÃO PARA CONTRATO baseanado-se no momento da gravação:
           //   faturado: via caixa:
           //   result := Perpetrar([qryConjugeAnterior, qryConjuge, qryClientes, qryContratos, qryProdutosContratos, qryProdutosListaCasamento,
           //              qryParcelas, qryRecebimentos, qryTEF, qryParcelasTEF, qryUsuarios_Site]);
           //   faturado: não via caixa
           //   result := Perpetrar([qryConjugeAnterior, qryConjuge, qryClientes, qryContratos, qryProdutosContratos, qryprodutoscontratosseries, qryProdutosListaCasamento,
           //             qryParcelas, qryRecebimentos, qryprodutostrocados, qryUsuarios_Site]);

          if (InRange(2, Low(ds), High(ds))) and
             (InRange(3, Low(ds), High(ds))) and

             (lowercase(ds[2].Name) = 'qryclientes') and
             (lowercase(ds[3].Name) = 'qrycontratos') and
             (ds[3].FieldByName('situacao').asString = 'F') then

            AcionarTelaEnquete(ds[2].FieldByName('codigo').asinteger,      //cliente
                               'C',                                        //tipocliente
                               0,                                          //orcamento
                               ds[3].FieldByName('numero').asString)       //contrato
          else

          *)



          if (vOnperpetrar in [Prosseguir_e_ReabrirVerificacao]) then
          begin
            if AfterPerpetrarAtivado then
              if (FormaTerminoTransacao <> SomenteGravacao) then
                 AfterPerpetrar
          end
              {
          else
          begin
            if AfterPerpetrarAtivado then
              if (FormaTerminoTransacao = Simples) then
                 AfterPerpetrar
          end};


        except
          on E: Exception do ShowMessage(E.Message);
        end;
      end;

    end
    else
      result := false;
  finally
//    Screen.Cursor := crDefault;
//    Application.ProcessMessages;
  end;
end;



function TdtmBasico.Perpetrar(ds: array of TZDataSet; transacao: TTecTransact; FormaTerminoTransacao: TtecFormaTerminoTransacao): Boolean;
var
  a: Integer;
  vResult : Boolean;
  vOnPerpetrar : TtecVerificarDados;
begin

  vResult := true;

  vOnPerpetrar := Normal;

  if OnPerpetrarAtivado and (FormaTerminoTransacao <> SomenteGravacao) then
  begin
    vOnPerpetrar := OnPerpetrar(ds) ;
    vResult := vOnperpetrar in [Prosseguir, Prosseguir_e_ReabrirVerificacao];
  end;

  if vResult then
  begin

    try

      for a := 0 to High(ds) do
        if ds[a] is TZDataSet then
          if ds[a].UpdatesPending then
            ds[a].ApplyUpdates;

      if (FormaTerminoTransacao in [Simples, SomenteGravacao]) then
      begin
        transacao.commit;
        for a := 0 to High(ds) do
          if ds[a] is TZDataSet then
            if ds[a].CachedUpdates and ds[a].Active then
              ds[a].CommitUpdates;
      end;

      Result := True;

    except

      on E: Exception do
      begin
        try
          for a := 0 to High(ds) do
            if ds[a] is TZDataSet then begin
               ds[a].RevertRecord;
               ds[a].CancelUpdates;
            end;
          transacao.rollback;

        finally
          MensagemErro(E.Message);
        end;
      end;
    end;


    if (vOnperpetrar in [Prosseguir_e_ReabrirVerificacao]) then
      if AfterPerpetrarAtivado then
        if (FormaTerminoTransacao <> SomenteGravacao) then
           AfterPerpetrar


  end;
end;


procedure TdtmBasico.PostError(DataSet: TDataSet; E: EDatabaseError; var Action: TDataAction);
begin
  ErroPadraoDeSalvar(DataSet, E, Action);
end;

procedure TdtmBasico.ReFazConsulta(ds: TZDataSet;
                                   Param: array of integer;
                                   Valores: array of variant;
                                   RefazerSeParametroIgual: Boolean = true);
var
  a: Integer;
  ExisteParametroDiferente: Boolean;

  procedure AbrirConsulta;
  var
    a: Integer;
  begin
    ds.DisableControls;
    ds.Close;
    for a := 0 to High(Param) do begin
      ds.Params[Param[a]].Clear;
      ds.Params[Param[a]].Value := Valores[a];
    end;
    ds.enablecontrols;
    ds.Open;
  end;

begin
  ExisteParametroDiferente := false;
  if High(Param) <> High(Valores) then
    raise Exception.Create(ctERRORREFAZCONSULTA)
  else
  begin
    if RefazerSeParametroIgual then
      AbrirConsulta
    else
    begin
      for a := 0 to High(Param) do
        if not ExisteParametroDiferente then
          ExisteParametroDiferente := ds.Params[Param[a]].Value <> Valores[a];
      if ExisteParametroDiferente or not ds.Active then
        AbrirConsulta;
    end;
  end;
end;

procedure TdtmBasico.AtualizaTotalMarcado(ValAntes, ValDepois: Real);
begin
  if FTotalMarcados > 0 then
    FTotalMarcados:= FTotalMarcados - ValAntes + ValDepois
end;



procedure TdtmBasico.MarcarRegistros(DS:             TZDataset;
                                     CampoMarcar:    TBooleanField;
                                     CampoTotalizar: TFloatField;
                                     Marcando:       Boolean;
                                     MarcarTodos:    Boolean;
                                     NCasasDecimais: Integer = 4;
                                     DesabilitarControles: Boolean = True);
var Pos: TBookmark;
    I:   Integer;


    procedure AtualizarValores;
    begin
       if CampoMarcar.AsBoolean then begin
          Inc(FQtdeMarcados);
          FTotalMarcados:= FTotalMarcados + RoundTo(CampoTotalizar.AsCurrency, -NCasasDecimais) ;
       end
       else begin
          Dec(FQtdeMarcados);
          FTotalMarcados:= FTotalMarcados - CampoTotalizar.AsCurrency;
       end;
    end;


begin
   if not DS.IsEmpty then begin
      if not MarcarTodos then
      begin
         DS.Edit;
         CampoMarcar.AsBoolean := not CampoMarcar.AsBoolean;
         DS.Post;
         AtualizarValores;
      end
      else
      begin
         FQtdeMarcados := 0;
         FTotalMarcados:= 0;
         Pos:= DS.GetBookmark;
         try
            if DesabilitarControles then
              DS.DisableControls;

            DS.First;
            for I:= 1 to DS.RecordCount do
            begin
              if     (Marcando and not CampoMarcar.AsBoolean) or
                 (not Marcando and     CampoMarcar.AsBoolean) then
              begin
                DS.Edit;
                CampoMarcar.AsBoolean:= Marcando;
                DS.Post;
              end;

              if CampoMarcar.AsBoolean then
                AtualizarValores;

              DS.Next;
            end;
         finally
            DS.GotoBookmark(Pos);
            DS.FreeBookmark(Pos);

            if DesabilitarControles then
              DS.EnableControls;
         end;
      end;
   end;
end;



procedure TdtmBasico.MarcarRegistros(DS:          TZDataset;
                                     CampoMarcar: TBooleanField;
                                     Marcando:    Boolean;
                                     MarcarTodos: Boolean;
                                     DesabilitarControles : Boolean);
var Pos: TBookmark;
    I, J:   Integer;
begin
   if not DS.IsEmpty then begin
      if not MarcarTodos then
      begin
        if DesabilitarControles then
          DS.DisableControls;

        DS.Edit;  CampoMarcar.AsBoolean:= not CampoMarcar.AsBoolean;
        DS.Post;
        if CampoMarcar.AsBoolean then Inc(FQtdeMarcados)
                                 else Dec(FQtdeMarcados);

        if DesabilitarControles then
          DS.EnableControls;

      end
      else begin
         FQtdeMarcados:= 0;
         Pos:= DS.GetBookmark;
         try
            if DesabilitarControles then
              DS.DisableControls;
            DS.First;
            for I:= 1 to DS.RecordCount do
            begin
                if     (Marcando and not CampoMarcar.AsBoolean) or
                   (not Marcando and     CampoMarcar.AsBoolean) then
                begin
                   DS.Edit;
                   CampoMarcar.AsBoolean:= Marcando;
                   DS.Post;
                end;

                if CampoMarcar.AsBoolean then Inc(FQtdeMarcados);
                DS.Next;

                (*      SOLUCIONADO ACRESCENTANDO todos os campos restantes do dbgrid ao campo ordenado
                J := ds.recno; {Solucionar um problema quando sortbyfield, apos o post avança um registro quando o campo ordenado tem o mesmo conteudo}
                if ds.state = dsedit then
                  ds.Post;


                if ds.recno = J then
                  DS.Next
                else
                begin
                  // problema encontrado: avanço da posição ao post
                  ds.Prior;
                  if     (Marcando and not CampoMarcar.AsBoolean) or
                     (not Marcando and     CampoMarcar.AsBoolean) then
                  begin
                     DS.Edit;
                     CampoMarcar.AsBoolean:= Marcando;
                     DS.Post;
                  end;

                  if CampoMarcar.AsBoolean then Inc(FQtdeMarcados);
                  ds.Next;
                end;
                *)
            end;
         finally
            DS.GotoBookmark(Pos);
            DS.FreeBookmark(Pos);
            if DesabilitarControles then
              DS.EnableControls;
         end;
      end;
   end;
end;



procedure TdtmBasico.MarcarRegistros(DS:            TZDataset;
                                     CampoMarcar:   TBooleanField;
                                     Desconsiderar: TBooleanField;
                                     Marcando:      Boolean;
                                     MarcarTodos:   Boolean;
                                     CampoTotalizar: TFloatField = nil;
                                     NCasasDecimais: Integer = 4 );
var Pos: TBookmark;
    I:   Integer;

    procedure AtualizarValores;
    begin
       if CampoMarcar.AsBoolean then begin
          Inc(FQtdeMarcados);
          FTotalMarcados:= FTotalMarcados + RoundTo(CampoTotalizar.AsCurrency, -NCasasDecimais);
       end
       else begin
          Dec(FQtdeMarcados);
          FTotalMarcados:= FTotalMarcados - CampoTotalizar.AsCurrency;
       end;
    end;
    
begin
   if not DS.IsEmpty then begin
      if not MarcarTodos then begin
         if not Desconsiderar.AsBoolean then begin
            DS.Edit;  CampoMarcar.AsBoolean:= not CampoMarcar.AsBoolean;
            DS.Post;
            if CampoMarcar.AsBoolean then Inc(FQtdeMarcados)
                                    else Dec(FQtdeMarcados);
            AtualizarValores;
         end;
      end
      else begin
         FQtdeMarcados:= 0;
         FTotalMarcados:= 0;
         Pos:= DS.GetBookmark;
         try
            DS.DisableControls;
            DS.First;
            for I:= 1 to DS.RecordCount do begin
                if not Desconsiderar.AsBoolean then begin
                   if     (Marcando and not CampoMarcar.AsBoolean) or
                      (not Marcando and     CampoMarcar.AsBoolean) then begin
                      DS.Edit;      CampoMarcar.AsBoolean:= Marcando;
                      DS.Post;
                   end;
                   if CampoMarcar.AsBoolean then
                   begin
                     Inc(FQtdeMarcados);
                     AtualizarValores;
                   end;
                end;
                DS.Next;
            end;
         finally
            DS.GotoBookmark(Pos);
            DS.FreeBookmark(Pos);
            DS.EnableControls;
         end;
      end;
   end;
end;


