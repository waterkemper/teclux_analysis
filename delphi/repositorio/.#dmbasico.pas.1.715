function TdtmBasico.AtualizaSituacaoNFPSe(
  qryDadosFiscais, qryNotas: TtecQuery): boolean;
begin
  Result := NFe.ConsultarSituacaoLoteNfse(qryDadosFiscais,qryNotas);

  if result then
  begin

    qryDadosFiscais.Edit;
    qryDadosFiscais.FieldByName('numprotocolonfse').AsString := NFe.codigoVerificacao_NFPSe;

    if NFe.status_NFPSe <> '' then
      qryDadosFiscais.FieldByName('statusnfse').AsString := NFe.status_NFPSe;

    if ((NFe.status_NFPSe = '1') and (ftipoemissaonfeservico = Florianopolis_SoftPlan)) or
       ((NFe.status_NFPSe = '2') and (ftipoemissaonfeservico = Palhoca_IPM)) then //cancelado
    begin
      qryDadosFiscais.FieldByName('situacao').asString := 'C';

      if qryDadosFiscais.FieldByName('datacancelamento').isnull then  //certos web service não fornecem a data
        qryDadosFiscais.FieldByName('datacancelamento').Asdatetime := FormatarTimeStamp(NFe.dataCancelamento_NFPSe);
    end;

//              qryDadosFiscais.FieldByName('nrdocumento').AsString := NFe.numeroSerie_NFPSe;
    if (ftipoemissaonfeservico = Florianopolis_SoftPlan) then
    begin
      qryDadosFiscais.FieldByName('dhprocnfe').Asdatetime := FormatarTimeStamp(NFe.DataHoraProcessamento_NFPSe);
      qryDadosFiscais.FieldByName('data').Asdatetime := FormatarTimeStamp(NFe.DataEmissao_NFPSe);
    end
    else
    if (ftipoemissaonfeservico = Palhoca_IPM) then
    begin
      if NFe.DataHoraProcessamento_NFPSe<>'' then
        //qryDadosFiscais.FieldByName('dhprocnfe').Asdatetime := strtodatetime(NFe.DataHoraProcessamento_NFPSe);
        qryDadosFiscais.FieldByName('dhprocnfe').Asdatetime := FormatarTimeStamp(NFe.DataHoraProcessamento_NFPSe);

      if NFe.DataEmissao_NFPSe <> '' then
//        qryDadosFiscais.FieldByName('data').Asdatetime := strtodatetime(NFe.DataEmissao_NFPSe);
        qryDadosFiscais.FieldByName('data').Asdatetime := FormatarTimeStamp(NFe.DataEmissao_NFPSe);
    end;

    if qrydadosfiscais.FindField('obsimpostosretidos') <> nil then
    begin
      if qryDadosFiscais.FieldByName('obsimpostosretidos').AsString = '' then
        qryDadosFiscais.FieldByName('obsimpostosretidos').AsString := ObterImpostosRetidos(qryDadosFiscais);

      if qryDadosFiscais.FieldByName('obsimpostosretidos').AsString <> '' then
      begin
        if qryDadosFiscais.FieldByName('observacoes').AsString <> '' then
        begin
          if pos(qryDadosFiscais.FieldByName('obsimpostosretidos').AsString,
                 qryDadosFiscais.FieldByName('observacoes').AsString)=0 then
            qryDadosFiscais.FieldByName('observacoes').AsString := qryDadosFiscais.FieldByName('observacoes').AsString + chr(13) +
                                                                   qryDadosFiscais.FieldByName('obsimpostosretidos').AsString;
        end
        else
          qryDadosFiscais.FieldByName('observacoes').AsString := qryDadosFiscais.FieldByName('obsimpostosretidos').AsString;
      end;
    end;

    qryDadosFiscais.Post;

    qryNotas.edit;
    qryNotas.fieldbyname('serie').AsString := trocar(qryNotas.fieldbyname('serie').AsString, '*', '');

    if qryNotas.findfield('serienfse') <> nil then
      qryNotas.fieldbyname('serienfse').AsString := NFe.Serie_NFPSe
    else
      MensagemAviso('Campo ''serienfse'' da tabela ''Notas'' inexistente');


    if qryNotas.findfield('link_nfse') <> nil then
      qryNotas.fieldbyname('link_nfse').AsString := NFe.link_nfse
    else
      MensagemAviso('Campo ''link_nfse'' da tabela ''Notas'' inexistente');


    if NFe.numeroSerie_NFPSe <> '' then
    begin
      qryNotas.FieldByName('numero').AsString := NFe.numeroSerie_NFPSe;
      qryDadosFiscais.FieldByName('nrdocumento').AsString := qryNotas.FieldByName('numero').AsString;

    end;


    qryNotas.post;

    Result := perpetrar([qryDadosFiscais, qryNotas]);

    if result then
      SalvarConteudoxml('S', qryDadosFiscais.fieldbyname('numero').asString);
  end;

  if result then
    if (ftipoemissaonfeservico = Palhoca_IPM) then
       if NFe.status_NFPSe = '' then   {o status não é retornado na inclusão no webservice, somente pela numero de autenticidade ou numero e serie + login e senha}
       begin
          Result := NFe.ConsultarSituacaoLoteNfse(qryDadosFiscais,qryNotas, true);
          if result then
          begin
            qryDadosFiscais.Edit;
            qryDadosFiscais.FieldByName('statusnfse').AsString := NFe.status_NFPSe;
            qryDadosFiscais.Post;
            Result := perpetrar([qryDadosFiscais]);
          end;
       end;




end;

function TdtmBasico.ValidarAliquotaGrade(qryDadosFiscais,
  qryServicosDadosFiscais: TtecQuery): boolean;

  procedure AdicionarValidacaograde_cfps_cst;
  begin
    qryValidacaograde_cfps_cst.append;
    qryValidacaograde_cfps_cst.fieldbyname('servico').asinteger := qryServicosDadosFiscais.fieldbyname('servico').asinteger;
    qryValidacaograde_cfps_cst.fieldbyname('descricaoservico').asString := qryServicosDadosFiscais.fieldbyname('descricao').asString;
    qryValidacaograde_cfps_cst.fieldbyname('cfps').asinteger := qryDadosFiscais.fieldbyname('cfps').asInteger;
    qryValidacaograde_cfps_cst.fieldbyname('cstissqn').asinteger := qryServicosDadosFiscais.fieldbyname('cstissqn').asInteger;
    qryValidacaograde_cfps_cst.fieldbyname('aliquota').asCurrency := qryServicosDadosFiscais.fieldbyname('aliquotaissqn').asCurrency;
  end;

begin

  if not assigned(qrygrade_cfps_cst) then
  begin
    qrygrade_cfps_cst := TTecQuery.Create(nil);
    qrygrade_cfps_cst.Database := dtmTecSoft.Database;
    qrygrade_cfps_cst.Sql.Text := 'select * from grade_cfps_cst where cidadeibge = :cidadeibge and exibe_cst = 1 order by cfps, cst';
    qrygrade_cfps_cst.Parambyname('cidadeibge').AsString := CodigoCidadeIBGEFilialBase;
    qrygrade_cfps_cst.close;
    qrygrade_cfps_cst.open;
  end;

  dsrValidacaograde_cfps_cst := TtecDataSource.create(nil);

  qryValidacaograde_cfps_cst := TTecQuery.Create(nil);
  qryValidacaograde_cfps_cst.Database := dtmTecSoft.Database;
  qryValidacaograde_cfps_cst.cachedupdates := true;
  qryValidacaograde_cfps_cst.requestlive := true;

  dsrValidacaograde_cfps_cst.dataset := qryValidacaograde_cfps_cst;

  qryValidacaograde_cfps_cst.Sql.Text := 'select cast(null as integer) as servico, '+
                                         '       cast(null as varchar(70)) as descricaoservico, '+
                                         '       cast(null as integer) as cfps, '+
                                         '       cast(null as integer) as cstissqn, '+
                                         '       cast(null as numeric(6,2)) as aliquota, '+
                                         '       cast(null as varchar(100)) as descricaoerro';

  qryValidacaograde_cfps_cst.close;
  qryValidacaograde_cfps_cst.open;
  qryValidacaograde_cfps_cst.delete;


  qryServicosDadosFiscais.first;
  while not qryServicosDadosFiscais.eof do
  begin

    if qrygrade_cfps_cst.locate('cfps;cst', VarArrayOf([qryDadosFiscais.fieldbyname('cfps').asInteger,qryServicosDadosFiscais.fieldbyname('cstissqn').asInteger]), []) then
    begin
      case qrygrade_cfps_cst.fieldbyname('cd_nfe').asinteger of
        {0. Alíquota fixa (tabela de CNAE) computada na base de cálculo;}
        0: begin
             if qryservicosdadosfiscais.fieldbyname('aliquotaissqn').asCurrency <>
                qryServicosDadosFiscais.fieldbyname('aliquotaissqntabelamunicipio').asCurrency then
             begin
               AdicionarValidacaograde_cfps_cst;
               qryValidacaograde_cfps_cst.fieldbyname('descricaoerro').asString := 'Alíquota difere em relação a tabela fixa de ' +
                            qryServicosDadosFiscais.fieldbyname('aliquotaissqntabelamunicipio').asString +' % ';
               qryValidacaograde_cfps_cst.post;
             end;
           end;


        {1. Alíquota variável, mín. 2% e máx. 5%, computada na base de cálculo;}
        1: begin
             if not ((qryservicosdadosfiscais.fieldbyname('aliquotaissqn').asCurrency >= 2) and
                     (qryservicosdadosfiscais.fieldbyname('aliquotaissqn').asCurrency <= 5)) then
             begin
               AdicionarValidacaograde_cfps_cst;
               qryValidacaograde_cfps_cst.fieldbyname('descricaoerro').asString := 'Alíquota variável deve estar entre 2 e 5%';
               qryValidacaograde_cfps_cst.post;
             end;
           end;

        {2. Não tem alíquota (0%), não entra em base de cálculo;}
        2: begin
             if TCurrencyField(qryservicosdadosfiscais.fieldbyname('aliquotaissqn')).asCurrency <> 0 then
             begin
               AdicionarValidacaograde_cfps_cst;
               qryValidacaograde_cfps_cst.fieldbyname('descricaoerro').asString := 'Alíquota deve ser zero ';
               qryValidacaograde_cfps_cst.post;
             end;
           end;

        {3. Alíquota fixa (tabela CNAE) computada na base de cálculo de substituição;}
        3: begin
             if qryservicosdadosfiscais.fieldbyname('aliquotaissqn').asCurrency <>
                qryServicosDadosFiscais.fieldbyname('aliquotaissqntabelamunicipio').asCurrency then
             begin
               AdicionarValidacaograde_cfps_cst;
               qryValidacaograde_cfps_cst.fieldbyname('descricaoerro').asString := 'Alíquota difere em relação a tabela fixa computada na BCST de ' +
                            qryServicosDadosFiscais.fieldbyname('aliquotaissqntabelamunicipio').asString +' % ';
               qryValidacaograde_cfps_cst.post;
             end;
           end;

      end;
    end
    else
    begin
      AdicionarValidacaograde_cfps_cst;
      qryValidacaograde_cfps_cst.fieldbyname('descricaoerro').asString := 'cfps/cst não encontrada na tabela ''grade_cfps_cst''';  //ou exibe_cst=0
      qryValidacaograde_cfps_cst.post;
    end;

    qryServicosDadosFiscais.next;
  end;

  result := true;
  if qryValidacaograde_cfps_cst.recordcount <> 0 then
  begin

    result := false;
    frmMensagemGrid := TfrmMensagemGrid.Create(frmMensagemGrid);
    frmMensagemGrid.Caption := 'Mensagem de erro';
    frmMensagemGrid.lblTitulo.Caption := 'DIFERENÇA NOS VALORES DAS ALÍQUOTAS DO ISSQN!';
    frmMensagemGrid.lblTExto.Caption := 'Verifique no quadro abaixo a mensagem na coluna descrição do erro.';
    frmMensagemGrid.dbgMensagem.DataSource := dsrValidacaograde_cfps_cst;
    frmMensagemGrid.Width := 990;

    frmMensagemGrid.ShowModal;
    frmMensagemGrid.Free;
  end;

  dsrValidacaograde_cfps_cst.free;
  qryValidacaograde_cfps_cst.free;
end;

function TdtmBasico.ObterImpostosRetidos(
  qryDadosFiscais: TtecQuery): String;
begin
  if (qryDadosFiscais.FieldByName('ValorServicos').AsCurrency  > 0) and
     ((qryDadosFiscais.FieldByName('irretido').AsCurrency     > 0) or
      (qryDadosFiscais.FieldByName('inssretido').AsCurrency   > 0) or
      (qryDadosFiscais.FieldByName('issretido').AsCurrency    > 0) or
      (qryDadosFiscais.FieldByName('cofinsretido').AsCurrency > 0) or
      (qryDadosFiscais.FieldByName('pisretido').AsCurrency    > 0) or
      (qryDadosFiscais.FieldByName('csllretido').AsCurrency   > 0) or
      (qryDadosFiscais.FieldByName('csrfretido').AsCurrency   > 0)) then
  begin
    result := 'RETENCOES: ';
    if qryDadosFiscais.FieldByName('irretido').AsCurrency > 0 then
      result := result + #10 +
        preencheString('IR     (' + Format('%5.2f',[qryDadosFiscais.FieldByName('irretido').AsCurrency*100/qryDadosFiscais.FieldByName('ValorServicos').AsCurrency]) + '%)',' ',16) +
        'R$ ' + trocar(Format('%11.2m', [qryDadosFiscais.FieldByName('irretido').AsCurrency]),'R$','');

    if qryDadosFiscais.FieldByName('inssretido').AsCurrency > 0 then
      result := result + #10 +
        preencheString('INSS   (' + Format('%5.2f',[qryDadosFiscais.FieldByName('inssretido').AsCurrency*100/qryDadosFiscais.FieldByName('ValorServicos').AsCurrency*2]) + '%)',' ',16) +
        'R$ ' + trocar(Format('%11.2m', [qryDadosFiscais.FieldByName('inssretido').AsCurrency]),'R$','');
    if qryDadosFiscais.FieldByName('issretido').AsCurrency > 0 then
      result := result + #10 +
        preencheString('ISS    (' + Format('%5.2f',[qryDadosFiscais.FieldByName('issretido').AsCurrency*100/qryDadosFiscais.FieldByName('ValorServicos').AsCurrency]) + '%)',' ',16) +
        'R$ ' + trocar(Format('%11.2m', [qryDadosFiscais.FieldByName('issretido').AsCurrency]),'R$','');
    if qryDadosFiscais.FieldByName('cofinsretido').AsCurrency > 0 then
      result := result + #10 +
        preencheString('COFINS (' + Format('%5.2f',[qryDadosFiscais.FieldByName('cofinsretido').AsCurrency*100/qryDadosFiscais.FieldByName('ValorServicos').AsCurrency]) + '%)',' ',16) +
        'R$ ' + trocar(Format('%11.2m', [qryDadosFiscais.FieldByName('cofinsretido').AsCurrency]),'R$','');
    if qryDadosFiscais.FieldByName('pisretido').AsCurrency > 0 then
      result := result + #10 +
        preencheString('PIS    (' + Format('%5.2f',[qryDadosFiscais.FieldByName('pisretido').AsCurrency*100/qryDadosFiscais.FieldByName('ValorServicos').AsCurrency]) + '%)',' ',16) +
        'R$ ' + trocar(Format('%11.2m', [qryDadosFiscais.FieldByName('pisretido').AsCurrency]),'R$','');

    if qryDadosFiscais.FieldByName('csllretido').AsCurrency > 0 then
      result := result + #10 +
        preencheString('CSLL   (' + Format('%5.2f',[qryDadosFiscais.FieldByName('csllretido').AsCurrency*100/qryDadosFiscais.FieldByName('ValorServicos').AsCurrency]) + '%)',' ',16) +
        'R$ ' + trocar(Format('%11.2m', [qryDadosFiscais.FieldByName('csllretido').AsCurrency]),'R$','');

    if qryDadosFiscais.FieldByName('CSRFretido').AsCurrency > 0 then
      result := result + #10 +
        preencheString('CSRF   (' + Format('%5.2f',[qryDadosFiscais.FieldByName('CSRFretido').AsCurrency*100/qryDadosFiscais.FieldByName('ValorServicos').AsCurrency]) + '%)',' ',16) +
        'R$ ' + trocar(Format('%11.2m', [qryDadosFiscais.FieldByName('CSRFretido').AsCurrency]),'R$','');

  end;
end;

