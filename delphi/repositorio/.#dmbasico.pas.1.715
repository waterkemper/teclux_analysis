function TdtmBasico.CondicaoCancelamentoDadoFiscalReferenciado(
  OrigemCalculo: TtecOrigemCalculo; Notas: TtecQuery; produtos: TtecQuery ): boolean;

  function RequerNF: boolean;
  begin
    result := false;
    if (OrigemCalculo in  [NotaEntrada, Devolucao, Troca]) then
      result := ((Notas.FindField('requernfsaida')<>nil) and
                 (notas.fieldbyname('requernfsaida').AsBoolean)) or

                ((produtos.findfield('dadofiscal')<>nil) and
                 (produtos.FieldByName('dadofiscal').asinteger<>0))
    else
    if (OrigemCalculo in  [NotaAvulsa]) then
      result := ((produtos.findfield('codigonota')<>nil) and
                 (produtos.FieldByName('codigonota').asinteger<>0));

  end;

begin
 result := false;
 if OrigemCalculo = NotaEntrada then
  result :=  ((Notas.fieldbyname('dadofiscalreferenciado').asinteger <> 0) and
                 Notas.fieldbyname('cancelamentonfforaprazolegal').asBoolean)
 else
 if (OrigemCalculo in [Devolucao,Troca{, NotaAvulsa}]) and requernf then
    result := true
 else
 if (OrigemCalculo in [NotaAvulsa]) then
 begin
  if (Notas.findField('codigonotareferenciado') <> nil) and
     (Notas.findField('cancelamentonfforaprazolegal') <> nil) then
    result :=  (   (Notas.fieldbyname('codigonotareferenciado').asinteger <> 0) and
                   Notas.fieldbyname('cancelamentonfforaprazolegal').asBoolean  );

  if not result then

      result := ((Notas.FindField('requernfentrada')<>nil) and
               (notas.fieldbyname('requernfentrada').AsBoolean)) or
              ((produtos.FindField('codigonota')<>nil) and
               (produtos.fieldbyname('codigonota').Asinteger<>0)) ;

 end

end;

