              vDespesasAcessorias := vDespesasAcessorias + produtos.fieldbyname('despesasacessorias').AsCurrency;

            vQtdeProdutos := vQtdeProdutos + Produtos.fieldbyname('quantidade').AsFloat;

            if produtos.FindField('pisvalor')<> nil then
              vValorPIS := vValorPIS + produtos.fieldbyname('pisvalor').AsCurrency;

            if produtos.FindField('cofinsvalor')<> nil then
              vValorcofins := vValorcofins + produtos.fieldbyname('cofinsvalor').AsCurrency;

            if produtos.findfield('vCredICMSSN')<> nil then
              vCredICMSSN := vCredICMSSN + produtos.fieldbyname('vCredICMSSN').AsCurrency;

            if produtos.FindField('vICMSSTRet')<>nil then
              vICMSSTRet := vICMSSTRet + produtos.fieldbyname('vICMSSTRet').AsCurrency;

            vICMSSTRetDesp := vICMSSTRetDesp + ValorProdutos_vICMSSTRetDesp(produtos);

            if produtos.FindField('vBCSTRet')<>nil then
             vBCSTRet   := vBCSTRet + produtos.fieldbyname('vBCSTRet').AsCurrency;

            if produtos.FindField('vBCSTRetDesp')<>nil then
             vBCSTRetDesp   := vBCSTRetDesp + produtos.fieldbyname('vBCSTRetDesp').AsCurrency;

            if produtos.FindField('icmsbasecalculo_dev')<>nil then
              vicmsbasecalculo_dev := vicmsbasecalculo_dev + produtos.fieldbyname('icmsbasecalculo_dev').AsCurrency;

            if produtos.FindField('icmsvalor_dev')<>nil then
              vicmsvalor_dev   := vicmsvalor_dev + produtos.fieldbyname('icmsvalor_dev').AsCurrency;

            if produtos.FindField('vFCPUFDest')<>nil then
              vFCPUFDest   := vFCPUFDest + produtos.fieldbyname('vFCPUFDest').AsCurrency;

            if produtos.FindField('vFCP')<>nil then
              vFCP   := vFCP + produtos.fieldbyname('vFCP').AsCurrency;

            if produtos.FindField('vFCPST')<>nil then
              vFCPST   := vFCPST + produtos.fieldbyname('vFCPST').AsCurrency;

            if produtos.FindField('vFCPSTRet')<>nil then
              vFCPSTRet   := vFCPSTRet + produtos.fieldbyname('vFCPSTRet').AsCurrency;

            if produtos.FindField('vICMSUFDest')<>nil then
              vICMSUFDest   := vICMSUFDest + produtos.fieldbyname('vICMSUFDest').AsCurrency;

            if produtos.FindField('vICMSUFRemet')<>nil then
              vICMSUFRemet   := vICMSUFRemet + produtos.fieldbyname('vICMSUFRemet').AsCurrency;

            {if (origemCalculo <> FrentedeCaixa) then}
            begin
              if produtos.FindField('valorimpostonacional')<>nil then
                vvalorimpostonacional:= vvalorimpostonacional+ produtos.fieldbyname('valorimpostonacional').AsCurrency;

              if produtos.FindField('valorimpostoestadual')<>nil then
                vvalorimpostoestadual := vvalorimpostoestadual + produtos.fieldbyname('valorimpostoestadual').AsCurrency;
                                           {
              if produtos.FindField('valorimpostoimportado')<>nil then
              begin
                vvalortotalimpostoibt := vvalortotalimpostoibt + produtos.fieldbyname('valorimpostoimportado').AsCurrency;
                vvalorimpostonacional:= vvalorimpostonacional+ produtos.fieldbyname('valorimpostoimportado').AsCurrency;
              end;
              }

              vvalortotalimpostoibt := vvalorimpostonacional + vvalorimpostoestadual;
            end;

          end;
        end;

        if result then
        begin
          if not ehNFeEletronica or CalcularTodos then
            produtos.Next
          else
            break;
        end
        else
          break;

      end;

      finally

        if VerificarAcertoCentavos then
        begin

          { AJUSTAR OS CENTAVOS QUANDO A NFE NÃO ESTA FECHANDO O VALOR DO IPI}
          if (OrigemCalculo in [NotaEntrada,  CadastroPedidos, TransferenciaEntrada]) and not PermiteAlterarDadosIPI then
          begin
            vDiferenca := notas.fieldbyname('valoripi').ascurrency - vValorIPI;
            if (abs(vDiferenca) <= 0.1) and (abs(vDiferenca)<>0) then
            begin
              produtos.last;
              while not produtos.Bof do
              begin
                if produtos.fieldbyname('valoripi').AsCurrency <> 0 then
                begin
                  produtos.edit;
                  produtos.fieldbyname('valoripi').AsCurrency := produtos.fieldbyname('valoripi').AsCurrency + vDiferenca;
                  produtos.post;
                  vValorIPI := notas.fieldbyname('valoripi').ascurrency;
                  break;
                end;
                produtos.prior;
              end;
            end;
          end;

          if (OrigemCalculo in [NotaEntrada,  CadastroPedidos, TransferenciaEntrada]) and not PermiteAlterarDadosICMS then
          begin
            vDiferenca := notas.fieldbyname('baseicms').ascurrency - vbaseicms;
            { AJUSTAR OS CENTAVOS QUANDO A NFE NÃO ESTA FECHANDO O VALOR DA BASE DO ICMS}
            if (abs(vDiferenca) <= 0.1) and (abs(vDiferenca)<>0) then
            begin
              produtos.last;
              while not produtos.Bof do
