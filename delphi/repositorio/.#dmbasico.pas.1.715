class function TdtmBasico.VersaoBanco: String;
var
  qryVersao: TtecQuery;
begin
  qryVersao := TtecQuery.Create(nil);
  qryVersao.Database := dtmTecSoft.Database;
  qryVersao.Sql.Text := VersaoSQL;
  qryVersao.Open;
  if qryVersao.RecordCount > 0 then
    Result := qryVersao.Fields[0].AsString + '.' +
              qryVersao.Fields[1].AsString + '.' +
              qryVersao.Fields[2].AsString
  else
    Result := ''
end;

class function TdtmBasico.DescricaoFilial: String;
