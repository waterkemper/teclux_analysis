begin
  ACBrEAD := TACBrEAD.Create(nil);
  result := false;
  dmbasico := TdtmBasico.Create(nil);


  with ArqIniDadosECF do
  begin

    if SectionExists('CupomFiscal') then
    begin
      vNUM_USU := ReadInteger('CupomFiscal', 'NUM_USU', 0);
      vCRO     := ReadInteger('CupomFiscal', 'CRO',0);
      vCOO     := ReadInteger('CupomFiscal', 'COO', 0);
      vnum_fab := ReadString('CupomFiscal', 'NUM_FAB', '');

      if(vnum_fab<>'') then
      begin
        qryDadosCupom := TtecQuery.Create(nil);
        qryDadosCupom.CachedUpdates := true;
        qryDadosCupom.RequestLive := true;
        qryDadosCupom.Database := dtmTecSoft.Database;
        qryDadosCupom.Sql.Text := SQLDadosCupom;

        qryDadosCupom.ParamByName('filial').AsInteger := FilialBase;
        qryDadosCupom.ParamByName('NUM_USU').AsInteger := vNUM_USU;
        qryDadosCupom.ParamByName('CRO').AsInteger := vCRO;
        qryDadosCupom.ParamByName('COO').AsInteger := vCOO;
        qryDadosCupom.ParamByName('num_fab').AsString := vnum_fab;

        qryDadosCupom.Open;

        if qryDadosCupom.IsEmpty then
          qryDadosCupom.Append
        else
          qryDadosCupom.Edit;

        qryDadosCupom.FieldByName('filial').AsInteger  := FilialBase;
        qryDadosCupom.FieldByName('NUM_USU').AsInteger := vNUM_USU;
        qryDadosCupom.FieldByName('CRO').AsInteger     := vCRO;
        qryDadosCupom.FieldByName('COO').AsInteger     := vCOO;
        qryDadosCupom.FieldByName('num_fab').AsString  := vnum_fab;
        qryDadosCupom.Post;

        qryDetalheCupom := TtecQuery.Create(nil);
        qryDetalheCupom.CachedUpdates := true;
        qryDetalheCupom.RequestLive := true;
        qryDetalheCupom.Database := dtmTecSoft.Database;
        qryDetalheCupom.Sql.Text := SQLDetalheCupom;

        qryDetalheCupom.ParamByName('filial').AsInteger := FilialBase;
        qryDetalheCupom.ParamByName('NUM_USU').AsInteger := vNUM_USU;
        qryDetalheCupom.ParamByName('CRO').AsInteger := vCRO;
        qryDetalheCupom.ParamByName('COO').AsInteger := vCOO;
        qryDetalheCupom.ParamByName('num_fab').AsString  := vnum_fab;

        qryDetalheCupom.Open;

        if qryDetalheCupom.IsEmpty then
          qryDetalheCupom.Append
        else
          qryDetalheCupom.Edit;

        qryDetalheCupom.FieldByName('filial').AsInteger  := FilialBase;
        qryDetalheCupom.FieldByName('NUM_USU').AsInteger := vNUM_USU;
        qryDetalheCupom.FieldByName('CRO').AsInteger     := vCRO;
        qryDetalheCupom.FieldByName('COO').AsInteger     := vCOO;
        qryDetalheCupom.FieldByName('num_fab').AsString  := vnum_fab;

        qryDetalheCupom.FieldByName('CCF').AsInteger     := ReadInteger('CupomFiscal', 'CCF', 0);
        qryDetalheCupom.FieldByName('CRZ').AsInteger     := ReadInteger('CupomFiscal', 'CRZ', 0);

        qryDetalheCupom.FieldByName('DT_INI').AsDateTime := ReadDateTime('CupomFiscal', 'DT_INI', now());
        qryDetalheCupom.FieldByName('SUB_DOCTO').AsCurrency := ReadFloat('CupomFiscal', 'SUB_DOCTO', 0.00);
        qryDetalheCupom.FieldByName('SUB_DESCTO').AsCurrency := ReadFloat('CupomFiscal', 'SUB_DESCTO', 0.00);
        qryDetalheCupom.FieldByName('TP_DESCTO').AsString := ReadString('CupomFiscal', 'TP_DESCTO', 'V');
        qryDetalheCupom.FieldByName('SUB_ACRES').AsCurrency := ReadFloat('CupomFiscal', 'SUB_ACRES', 0.00);
        qryDetalheCupom.FieldByName('TP_ACRES').AsString := ReadString('CupomFiscal', 'TP_ACRES', 'V');
        qryDetalheCupom.FieldByName('VL_TOT').AsCurrency := ReadFloat('CupomFiscal', 'VL_TOT', 0.00);
        qryDetalheCupom.FieldByName('CANC').AsString := ReadString('CupomFiscal', 'CANC', 'N');
        qryDetalheCupom.FieldByName('VL_CA').AsCurrency := ReadFloat('CupomFiscal', 'VL_CA', 0);
        qryDetalheCupom.FieldByName('ORDEM_DA').AsString := ReadString('CupomFiscal', 'ORDEM_DA', 'D');
        qryDetalheCupom.FieldByName('NOME_CLI').AsString := ReadString('CupomFiscal', 'NOME_CLI', '');
        qryDetalheCupom.FieldByName('CNPJ_CPF').AsString := ReadString('CupomFiscal', 'CNPJ_CPF', '');
        qryDetalheCupom.FieldByName('hash_paf_registro_r04').AsString :=  ACBrEAD.MD5FromString(qryDetalheCupom.FieldByName('num_fab').AsString +
                                                                                                 qryDetalheCupom.FieldByName('CCF').AsString +
                                                                                                 qryDetalheCupom.FieldByName('COO').AsString +
                                                                                                 Trim(Trocar(Trocar(formatarvalor(qryDetalheCupom.FieldByName('VL_TOT').AsCurrency,2),'.',''),',','.')) +
                                                                                                 qryDetalheCupom.FieldByName('CANC').AsString);

        qryDetalheCupom.Post;

        qryDadosItemCupom := TtecQuery.Create(nil);
        qryDadosItemCupom.CachedUpdates := true;
        qryDadosItemCupom.RequestLive := true;
        qryDadosItemCupom.Database := dtmTecSoft.Database;
        qryDadosItemCupom.Sql.Text := SQLDadosItemCupom;

        qryDadosItemCupom.ParamByName('filial').AsInteger := FilialBase;
        qryDadosItemCupom.ParamByName('NUM_USU').AsInteger := vNUM_USU;
        qryDadosItemCupom.ParamByName('CRO').AsInteger := vCRO;
        qryDadosItemCupom.ParamByName('COO').AsInteger := vCOO;
        qryDadosItemCupom.ParamByName('num_fab').AsString := vnum_fab;

        qryDadosItemCupom.Open;

        i:= 1;

        vVl_Tot_Item := 0;

        while true do
        begin
          if SectionExists('ItemCupomFiscal'+inttostr(i)) then
          begin
            if qryDadosItemCupom.Locate('NUM_ITEM',i,[]) then
              qryDadosItemCupom.Edit
