function TdtmBasico.SalvarConteudoxmlepdf(
  tipo, Chave: String;
  Cancelamento_ou_Inutilizacao, CartaCorrecao: boolean;
  Diretorio: String;
  SalvaremPDF : Boolean;
  SalvaremXML : Boolean;
  Exibirmsg : Boolean;
  AdvSmoothProgressBar1: TAdvSmoothProgressBar
  ): Boolean;
var
  SQL, vArquivoXml: String;
  qryGravarxml: TtecQuery;
  qryGravarxml_Aux: TtecQuery;

  vPosition : dOUBLE;
  dtmControleNotasFiscaisEletronicas_ : tdtmControleNotasFiscaisEletronicas;

begin
  try

    result := true;

    qryGravarxml := TtecQuery.Create(nil);
    qryGravarxml.Database := dtmTecSoft.Database;
    qryGravarxml.CachedUpdates := false;
    qryGravarxml.RequestLive := false;

    qryGravarxml_Aux := TtecQuery.Create(nil);
    qryGravarxml_Aux.Database := dtmTecSoft.Database;
    qryGravarxml_Aux.CachedUpdates := false;
    qryGravarxml_Aux.RequestLive := false;

    if Cancelamento_ou_Inutilizacao then
    begin
      if tipo = 'S' then
        SQL := 'select numero, xmlnfe_canc_inut from dadosfiscais where numero in ( %chave )'
      else
      if tipo = 'E' then
        SQL := 'select codigo, xmlnfe_canc_inut from notaspag where codigo in ( %chave )';
    end
    else
    if CartaCorrecao then
      SQL := 'select codigo, xmlnfecc from cartas_correcao where codigo in ( %chave  )'
    else
    begin
      if tipo = 'S' then
        SQL := ' select df.numero, df.xmlnfe, df.chv_nfe, df.cidadeIBGE, df.data,   '+
               '        f.cnpj, df.modelodocto, n.serie, n.numero as nrdocumento,   '+
               '        df.formaemissao, df.numprotocolonfse,                       '+
               ' ehnotafiscalsaidaServico(df.numero) as ehnotafiscalsaidaServico    '+
               ' from dadosfiscais df join filiais f on df.filialemissao = f.codigo '+
               '                      join notas n on df.numero = n.dadofiscal      '+
               ' where df.numero in ( %chave )'
      else
      if tipo = 'E' then
        SQL := 'select codigo, xmlnfe, chv_nfe from notaspag where codigo in ( %chave )';
    end;

    qryGravarxml.Sql.Text := SQL;
    qryGravarxml_Aux.Sql.Text := SQL;

    qryGravarxml.MacrobyName('chave').asString := chave;

    if assigned(AdvSmoothProgressBar1) then
    begin
      AdvSmoothProgressBar1.visible := true;
      AdvSmoothProgressBar1.Appearance.ValueFormat := 'Gerando o arquivo xml das notas fiscais...Aguarde buscando informações...';
      Application.ProcessMessages;
    end;

    qryGravarxml.open;

    qryGravarxml.first ;
    while not qryGravarxml.eof do
    begin

      if (qryGravarxml.FindField('ehnotafiscalsaidaServico')<>nil) and
         (qryGravarxml.FieldByName('ehnotafiscalsaidaServico').asBoolean) then
      begin
        vArquivoXml := Diretorio+'\'+TTecNotaFiscalEletronica.ChaveNFPSe(qryGravarxml, nil)+'-nfse.xml';

        if qryGravarxml.fieldbyname('xmlnfe').isnull then
        begin
          try
            dtmControleNotasFiscaisEletronicas_ := tdtmControleNotasFiscaisEletronicas.create(nil);
            dtmControleNotasFiscaisEletronicas_.SomenteGerarARquivos := True;
            if dtmControleNotasFiscaisEletronicas_.SelecionarNotas(1,3, qryGravarxml.FieldByName('numero').asInteger, False) then
              if dtmControleNotasFiscaisEletronicas_.EnviarNotasFiscais('') then
              begin
                qryGravarxml_aux.MacrobyName('chave').asString := qryGravarxml.FieldByName('numero').asString;
                qryGravarxml_aux.close;
                qryGravarxml_aux.Open;

                if not qryGravarxml_aux.fieldbyname('xmlnfe').isnull then
                begin
                  if SalvaremXML then
                    tMemoField(qryGravarxml_aux.fieldbyname('xmlnfe')).SaveToFile(vArquivoXml);

                  if SalvaremPDF then
                    ImprimirNotaFiscalServico_(qryGravarxml_aux.FieldByName('numero').asInteger,
                     vArquivoXml, false);
                end
                else
                  MensagemErro(format('Não foi possível atualizar o xml da NFSe %s',[qryGravarxml_aux.FieldByName('nrdocumento').asString]));
              end;

          finally
            dtmControleNotasFiscaisEletronicas_.SomenteGerarARquivos := False;
            dtmControleNotasFiscaisEletronicas_.free;
          end;
        end
        else
        begin
          if SalvaremXML then
            tMemoField(qryGravarxml.fieldbyname('xmlnfe')).SaveToFile(vArquivoXml);

          if SalvaremPDF then
            ImprimirNotaFiscalServico_(qryGravarxml.FieldByName('numero').asInteger,
             vArquivoXml, false);
        end;
      end
      else
      begin
        vArquivoXml := Diretorio+'\'+qryGravarxml.fieldbyname('chv_nfe').asString+'-nfe.xml';

        if qryGravarxml.fieldbyname('xmlnfe').isnull then
        begin

          try
            dtmControleNotasFiscaisEletronicas_ := tdtmControleNotasFiscaisEletronicas.create(nil);
            dtmControleNotasFiscaisEletronicas_.SomenteGerarARquivos := True;
            if dtmControleNotasFiscaisEletronicas_.SelecionarNotas(1,3, qryGravarxml.FieldByName('numero').asInteger, False) then
              if dtmControleNotasFiscaisEletronicas_.EnviarNotasFiscais('') then
              begin
                qryGravarxml_aux.MacrobyName('chave').asString := qryGravarxml.FieldByName('numero').asString;
                qryGravarxml_aux.close;
                qryGravarxml_aux.Open;

                if not qryGravarxml_aux.fieldbyname('xmlnfe').isnull then
                begin
                  if SalvaremXML then
                    tMemoField(qryGravarxml_aux.fieldbyname('xmlnfe')).SaveToFile(vArquivoXml);

                  if SalvaremPDF then
                    TTecNotaFiscalEletronica.GerarPDF(vArquivoXml);
                end
                else
                  MensagemErro(format('Não foi possível atualizar o xml da nota fiscal %s',[qryGravarxml_aux.FieldByName('nrdocumento').asString]));
              end;

          finally
            dtmControleNotasFiscaisEletronicas_.SomenteGerarARquivos := False;
            dtmControleNotasFiscaisEletronicas_.free;
          end;

        end
        else
        begin

          if SalvaremXML then
            tMemoField(qryGravarxml.fieldbyname('xmlnfe')).SaveToFile(vArquivoXml);

          if SalvaremPDF then
            TTecNotaFiscalEletronica.GerarPDF(vArquivoXml);

        end;
      end;
      qryGravarxml.next;

      if assigned(AdvSmoothProgressBar1) then
      begin
        vPosition :=  (qryGravarxml.RecNo * 100) / qryGravarxml.recordcount;

        AdvSmoothProgressBar1.visible := true;
        AdvSmoothProgressBar1.Appearance.ValueFormat := 'Gerando o arquivo xml das notas fiscais selecionados %.0f%%';
        AdvSmoothProgressBar1.Position := vPosition;

        Application.ProcessMessages;
      end;

//      qryGravarxml.free;
    end;

   if Exibirmsg then
     MensagemAutoClose('Gravação Xml/Pdf', 'Arquivo '+vArquivoXml+ ' gravado com sucesso!', 1);


    if assigned(AdvSmoothProgressBar1) then
      AdvSmoothProgressBar1.visible := False;

  except
    result := false;
  end;
end;

function TdtmBasico.GetSem_st(EstadoSubstituicao, produto: String; IPINCM: integer): Boolean;
begin

  result := True;

  if IPINCM<>0 then
  begin
    RefazConsultaPorNome(qrysemstIPI,
         ['UF_CliForSaida_ou_FilialEntrada','IPINCM'],
         [EstadoSubstituicao,
          IPINCM]);

    fsem_st := not qrysemstIPI.FieldByName('ativo').Asboolean;
  end
  else
  begin
    RefazConsultaPorNome(qrysemst,
         ['UF_CliForSaida_ou_FilialEntrada','produto'],
         [EstadoSubstituicao,
          produto]);

    fsem_st := not qrysemst.FieldByName('ativo').Asboolean;
  end;

  result := fsem_st;

end;

