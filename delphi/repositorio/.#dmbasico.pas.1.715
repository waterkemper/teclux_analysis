procedure TdtmBasico.ReFazConsultaPorNome(ds: TZDataset; Param: array of String;
  Valores: array of Variant; OpenOnlyWhenChangedParams: boolean);
var
  a, b: Integer;
  CanOpen : Boolean;
begin
 if not OpenOnlyWhenChangedParams then
 begin

  if High(Param) <> High(Valores) then
    raise Exception.Create(ctERRORREFAZCONSULTA)
  else

  begin
    ds.Close;
    ds.DisableControls;

    for a := 0 to High(Param) do
    begin
      ds.ParamByName(Param[a]).Clear;
      ds.ParamByName(Param[a]).Value := Valores[a];
    end;

    ds.enablecontrols;
    ds.Open;

  end;

 end
 else
 begin

  CanOpen := false;

  if High(Param) <> High(Valores) then
    raise Exception.Create(ctERRORREFAZCONSULTA)
  else

  begin

      if not ds.active then
        CanOpen := True
      else
      begin
        for a := 0 to High(Param) do
        begin
          if not ds.ParamByName(Param[a]).isnull and
             (Valores[a] <> null) then
          begin

            if ds.ParamByName(Param[a]).Value <> Valores[a] then
            begin
              CanOpen := True;
              break;
            end;
          end
          else
          begin
            CanOpen := True;
            break;
          end;
        end;
      end;

    if CanOpen then
    begin
      ds.Close;
      ds.DisableControls;


      for a := 0 to High(Param) do
      begin
        ds.ParamByName(Param[a]).Clear;
        ds.ParamByName(Param[a]).Value := Valores[a];
      end;

      ds.enablecontrols;
      ds.Open;
    end;
  end;
 end;
end;

function TdtmBasico.VerificarCamposRequeridos(ds:TZDataset): boolean;
begin
  result := true;

  ds.First;
  while not ds.Eof do
  begin
    if not TtecQuery(ds).CheckRequiredFields then
    begin
      result := false;
      break;
    end
    else
      ds.next;
  end;
end;

class function TdtmBasico.ValorCampodaTabela(NomedaTabela: String;
                                        Chaves: array of String;
                                        Valores: array of Variant;
                                        CamposaRetornar: array of String;
                                        Condicao: String = ''): TVariantArray;
var
  vTabela : TtecQuery;
  a: integer;
  vVariantArray : Variant;
  vDescricao: String;
  vPesquisa: String;
{       v1,v2,v3: Variant;}

begin
  vPesquisa := '';
  vVariantArray := VarArrayCreate([0,length(CamposaRetornar)-1], varVariant);

  if High(Chaves) <> High(Valores) then
    raise Exception.Create('Parâmetros ''Chaves'' e ''Valores'' estão com tamanhos diferentes')
  else
  begin

    vTabela := TTecQuery.Create(nil);
    vTabela.Database := dtmTecSoft.Database;
    vTabela.Sql.Append('select * from ' + NomedaTabela + ' Where true');
    for a := 0 to High(Chaves) do
    begin
      if Condicao <> '' then
        vTabela.Sql.Append(format(Condicao, [Chaves[a], Valores[a]]))
      else
        vTabela.Sql.Append('and '+Chaves[a]+' = '+quotedstr(Valores[a]));

      vPesquisa := vPesquisa + ' ' + Chaves[a] + ' = ' + quotedstr(Valores[a]);
    end;

    vTabela.Open;
    if vTabela.recordcount = 0 then
      MensagemErro('A pesquisa na tabela ''' + NomedaTabela + ''' com os parametros ''' + vpesquisa + ''' não foi encontrada')
    else
    begin
      for a := 0 to High(CamposaRetornar) do
        vVariantArray[a] := vTabela.fieldbyName(CamposaRetornar[a]).Value;
{
      v1 := vTabela.fieldbyName(CamposaRetornar[0]).value;
      v2 := vTabela.fieldbyName(CamposaRetornar[1]).value;
      v3 := vTabela.fieldbyName(CamposaRetornar[2]).value
}
    end;
  end;

  result := vVariantArray;


end;



procedure TdtmBasico.AtribuirChave(ds: TZDataset;
                            Chaves: array of TField;
                            Valores: array of TField;
                            DesligarControles: Boolean = true;
                            SomenteRegistroAtual: Boolean = false;
                            PercorrerTabelaAssociada: boolean = false);
var
  RegistroAtual: TBookMark;
  RegistroAtualMaster: TBookMark;

  ControlesJaDesabilitados : Boolean;

  function ExisteDiferencadeChave: boolean;
  var
    a: Integer;
  begin
    result := false;
    for a := 0 to High(Chaves) do
    begin
      if Chaves[a].Value <> Valores[a].Value then
      begin
        result := true;
        break;
      end;
    end;
  end;

  procedure Atribuir;
  Var
  a: Integer;
  begin
    if SomenteRegistroAtual then
    begin
      if ExisteDiferencadeChave then
      begin
        ds.Edit;
        for a := 0 to High(Chaves) do
          Chaves[a].Value := Valores[a].Value;
        ds.Post;
      end;
    end
    else
    begin
      ds.First;
      while not ds.Eof do
      begin
        if ExisteDiferencadeChave then
        begin
          ds.Edit;
          for a := 0 to High(Chaves) do
            Chaves[a].Value := Valores[a].Value;
          ds.Post;
        end;
        ds.Next;
      end;
    end;
  end;

begin

  if High(Chaves) <> High(Valores) then
    raise Exception.Create('Parâmetros "Chaves" e "Valores" estão com tamanhos diferentes.')
  else
  begin
    if ds.active then
    begin

      RegistroAtual := ds.GetBookmark;

      if (ds.mastersource <> nil) and PercorrerTabelaAssociada then
      begin
        RegistroAtualMaster := ds.mastersource.DataSet.GetBookmark;
        ds.mastersource.DataSet.First;
        while not ds.mastersource.DataSet.eof do
        begin
          Atribuir;
          ds.mastersource.DataSet.next;
        end;
        ds.mastersource.DataSet.GotoBookmark(RegistroAtualMaster);
        ds.mastersource.DataSet.FreeBookmark(RegistroAtualMaster);
      end
      else
      begin

        ControlesJaDesabilitados := ds.ControlsDisabled;

        if not ControlesJaDesabilitados then
          if DesligarControles then
            ds.DisableControls;

        Atribuir;


        if not ControlesJaDesabilitados then
          if DesligarControles then
            ds.EnableControls;
      end;

      ds.GotoBookmark(RegistroAtual);
      ds.FreeBookmark(RegistroAtual);
      
    end;
  end;

end;


{
function TdtmBasico.SomarValores(ds: TZDataset; Campos: array of TField;
                          CamposCondicao: Array of TField;
                          ValoresCamposCondicao: Array of String;
                          CondicaoCamposCondicao: Array of String): Real;
var
  a: Integer;
  RegistroAtual: TBookMark;
  ControlesJaDesabilitados : Boolean;
  vContinuar : Boolean;
begin
  result := 0;

  RegistroAtual := ds.GetBookmark;
  ControlesJaDesabilitados := ds.ControlsDisabled;
  if not ControlesJaDesabilitados then
    ds.DisableControls;

  ds.First;
  while not ds.Eof do
  begin
    vContinuar := true;

    if High(CamposCondicao) > -1 then
    begin
      for a:=0 to High(CamposCondicao) do
      begin
        if CondicaoCamposCondicao[a]='=' then
        begin
          if not (VarToStr(CamposCondicao[a].value) = ValoresCamposCondicao[a]) then
          begin
            vcontinuar := false;
            break;
          end;
        end
        else
        if CondicaoCamposCondicao[a]='>=' then
        begin
          if not (VartoStr(CamposCondicao[a].value) >= ValoresCamposCondicao[a]) then
          begin
            vcontinuar := false;
            break;
          end;
        end
        else
        if CondicaoCamposCondicao[a]='<=' then
        begin
          if not (VarToStr(CamposCondicao[a].value) <= ValoresCamposCondicao[a]) then
          begin
            vcontinuar := false;
            break;
          end;
        end
        else
        if CondicaoCamposCondicao[a]='<>' then
        begin
          if not (VarToStr(CamposCondicao[a].value) <> ValoresCamposCondicao[a]) then
          begin
            vcontinuar := false;
            break;
          end;
        end
        else
        if CondicaoCamposCondicao[a]='False' then
        begin
          if CamposCondicao[a].asboolean then
          begin
            vcontinuar := false;
            break;
          end;
        end
        else
        if CondicaoCamposCondicao[a]='True' then
        begin
          if not CamposCondicao[a].asboolean then
          begin
            vcontinuar := false;
            break;
          end;
        end;
      end;
    end;

    if vcontinuar then
    begin
      for a := 0 to High(Campos) do
      begin
        if not Campos[a].IsNull then
          result := result + Campos[a].value;
      end;
    end;

    ds.Next;
  end;
  ds.GotoBookmark(RegistroAtual);
  ds.FreeBookmark(RegistroAtual);

  if not ControlesJaDesabilitados then
    ds.EnableControls;
end;
}


procedure TdtmBasico.IncDecCampoTabela(ds: TZDataset;
                          Campos: array of TField;
                          OperacaoCamposIncDec: Array of String;
                          CamposCondicao: Array of TField;
                          ValoresCamposCondicao: Array of Variant;
                          CondicaoCamposCondicao: Array of String);
var
  a: Integer;
  RegistroAtual: TBookMark;
  ControlesJaDesabilitados : Boolean;
  vContinuar : Boolean;
begin

  RegistroAtual := ds.GetBookmark;
  ControlesJaDesabilitados := ds.ControlsDisabled;
  if not ControlesJaDesabilitados then
    ds.DisableControls;

  ds.First;
  while not ds.Eof do
  begin
    vContinuar := true;

    if High(CamposCondicao) > -1 then
    begin
      for a:=0 to High(CamposCondicao) do
      begin
        if CondicaoCamposCondicao[a]='=' then
        begin
          if not (VarToStr(CamposCondicao[a].value) = ValoresCamposCondicao[a]) then
          begin
            vcontinuar := false;
            break;
          end;
        end
        else
        if CondicaoCamposCondicao[a]='>=' then
        begin
          if not (VarToStr(CamposCondicao[a].value) >= ValoresCamposCondicao[a]) then
          begin
            vcontinuar := false;
            break;
          end;
        end
        else
        if CondicaoCamposCondicao[a]='<=' then
        begin
          if not (VarToStr(CamposCondicao[a].value) <= ValoresCamposCondicao[a]) then
          begin
            vcontinuar := false;
            break;
          end;
        end
        else
        if CondicaoCamposCondicao[a]='<>' then
        begin
          if not (VarToStr(CamposCondicao[a].value) <> ValoresCamposCondicao[a]) then
          begin
            vcontinuar := false;
            break;
          end;
        end;
      end;
    end;

    if vcontinuar then
    begin
      for a := 0 to High(Campos) do
      begin
        ds.edit;
        if OperacaoCamposIncDec[a] = '+' then
          ds.fieldbyname(Campos[a].fieldname).asinteger := ds.fieldbyname(Campos[a].fieldname).asinteger + 1
        else
        if OperacaoCamposIncDec[a] = '-' then
          ds.fieldbyname(Campos[a].fieldname).asinteger := ds.fieldbyname(Campos[a].fieldname).asinteger - 1;
      end;
    end;

    ds.Next;
  end;
  ds.GotoBookmark(RegistroAtual);
  ds.FreeBookmark(RegistroAtual);

  if not ControlesJaDesabilitados then
    ds.EnableControls;
end;





procedure TdtmBasico.LimparCampos(ds: TZDataset;
                           Campos: array of TField;
                           DesligarControles: Boolean = true);
var
  a: Integer;
  RegistroAtual: TBookMark;
  ControlesJaDesabilitados : Boolean;
begin
  RegistroAtual := ds.GetBookmark;

  ControlesJaDesabilitados := ds.ControlsDisabled;

  if not ControlesJaDesabilitados then
    if DesligarControles then
      ds.DisableControls;

  ds.First;
  while not ds.Eof do
  begin
    ds.edit;
    for a := 0 to High(Campos) do
      Campos[a].clear;
    ds.post;  
    ds.next;
  end;

  ds.GotoBookmark(RegistroAtual);
  ds.FreeBookmark(RegistroAtual);

  if not ControlesJaDesabilitados then
    if DesligarControles then
      ds.EnableControls;
end;


function TdtmBasico.Rollback(ds: array of TZDataSet): Boolean;
var
  a : integer;
begin
  case fFormaTerminoTransacao of
    AguardareTerminaremOutroDm:
    begin
      for a := 0 to High(vvTtecQuery) do
        if vvTtecQuery[a] is TZDataSet then
        begin
           vvTtecQuery[a].RevertRecord;
           vvTtecQuery[a].CancelUpdates;
        end;

        vvTtecQuery := nil;

    end;

    AguardareTerminarDentroDm:
    begin
      for a := 0 to High(vvTtecQueryDm) do
        if vvTtecQueryDm[a] is TZDataSet then
        begin
           vvTtecQueryDm[a].RevertRecord;
           vvTtecQueryDm[a].CancelUpdates;
        end;

        vvTtecQueryDm := nil;

    end;
  end;

  for a := 0 to High(ds) do
    if ds[a] is TZDataSet then
    begin
       ds[a].RevertRecord;
       ds[a].CancelUpdates;
    end;

  dtmTecSoft.tstTecSoft.Rollback;

{
  try
    for a := 0 to High(ds) do
      if ds[a] is TZDataSet then
        if ds[a].UpdatesPending and ds[a].Active then begin
          ds[a].RevertRecord;
          ds[a].CancelUpdates;
        end;
    dtmTecSoft.tstTecSoft.Rollback;
    Result := True;
  except
    raise
  end;
}

end;

