      Fregimesubstituicao           := qryVerificarFilialBase.fieldbyname('regimesubstituicao').AsInteger;
      FAliquotaICMSSN               := qryVerificarFilialBase.Fieldbyname('AliquotaICMSSN').AsCurrency;
      FEstadoFilialBaseIBGE         := qryVerificarFilialBase.fieldbyname('estadoIBGE').AsString;
