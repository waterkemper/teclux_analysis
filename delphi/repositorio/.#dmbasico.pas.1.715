function FilialdoFornecedor(CodigodoFornecedor: integer): integer;
var
 qryFiliais_ : TTecQuery;

begin
  qryFiliais_ := TtecQuery.Create(nil);
//  qryFiliais_.CachedUpdates := true;
//  qryFiliais_.RequestLive := true;
  qryFiliais_.Database := dtmTecSoft.Database;
  qryFiliais_.Sql.Text := 'select codigo from filiais where cnpj = (select pessoanumero from fornecedores where codigo = ' + inttostr(CodigodoFornecedor) + ' limit 1)';
  qryFiliais_.open;
  if qryFiliais_.recordcount = 1 then
    result := qryFiliais_.FieldByName('codigo').AsInteger
  else
    result := filialbase;
end;


function SalvarDadosArqECF(ArqIniDadosECF: TMemIniFile): Boolean;
var
  ACBrEAD : TACBrEAD;
const
(*
  SQLNotasVinculada = ' select notas.*, (select df.modelodocto from dadosfiscais df where df.numero = notas.dadofiscal) as modelodocto from notas '+
                      ' where dadofiscalvinculado = :dadofiscalvinculado ';
{                      '   and ((select df.modelodocto from dadosfiscais df where df.numero = notas.dadofiscal) in (''55'',''57'')) ';}


  SQLDadosFiscais = ' select * from dadosfiscais   '+
                      ' where numero = :numerodadofiscal';

  SQLProdutosTrocados = ' select * from produtostrocados where false ';

  SQLspcProdutosTrocadosProximonumero = 'select produtostrocados_proximocodigo() as numero';


