  AfterPerpetrarAtivado := false;

  if assigned(value) then
    AfterPerpetrarAtivado := true;

end;

function TdtmBasico.ListadeEmailsContrato(Contrato: String): String;
const
  SQLDF = ' ;select lista from                                         '+
          ' (                                                         '+
          ' select string_agg(email,'';'') as lista         '+
          ' from                                                      '+
          ' (                                                         '+
          '  (select ct.email                                          '+
          '   from contratos ct                                        '+
          '   where ct.numero = :contrato)                              '+

          ' union all                                                 '+
          ' (select cvf.email                                          '+
          ' from contatosvfornecedores cvf                            '+
          ' where (cvf.codigovfornecedores, cvf.tipovfornecedores)    '+
          '       in (select ct.cliente, ct.tipocliente               '+
          '           from contratos ct                            '+
          '           where ct.numero = :contrato)                  '+
          '   and coalesce(cvf.enviar_boleto,false)                      '+
          '   and cvf.email is not null order by cvf.email)                               '+
          ' ) as lista                   '+
          ' ) as lista                                                '+
          ' where lista is not null                     ';

var
  vSQL: String;
  qryLista: TtecQuery;
begin


    qryLista := TtecQuery.Create(nil);
    qryLista.Database := dtmTecSoft.Database;
    qryLista.Sql.Text := SQLDF;
    qryLista.ParamByName('contrato').asString := contrato;
    qryLista.Close;
    qryLista.Open;

    result := qryLista.fieldbyname('lista').asString;


end;


function TdtmBasico.ListadeEmails(Tipo: String;
  Documento: integer;
  SomenteTransportadora: Boolean = False): String;

const
  SQLDF = ' ;select lista from                                        '+
          ' (                                                         '+
          ' select string_agg(email,'';'') as lista                   '+
          ' from                                                      '+
          ' (                                                         '+
          '  (select df.email                                         '+
          '  from dadosfiscais df                                     '+
          '  where df.numero = :dadofiscal                            '+
          '    and df.email is NOT null )                             '+
          ' union all                                                 '+
          ' (select cvf.email                                         '+
          ' from contatosvfornecedores cvf                            '+
          ' where (cvf.codigovfornecedores, cvf.tipovfornecedores)    '+
          '       in (select df.cliente, df.tipocliente               '+
          '           from dadosfiscais df                            '+
          '           where df.numero = :dadofiscal)                  '+
          '   and coalesce(cvf.enviar_nfe,false)                      '+
          '   and cvf.email is not null order by cvf.email)           '+
          ' ) as lista                                                '+
          ' ) as lista                                                '+
          ' where lista is not null ';

  SQLDFTransp =
          ' ;select lista from                                        '+
          ' (                                                         '+
          '  select string_agg(email,'';'') as lista                  '+
          '  from                                                     '+
          '  (                                                        '+
          '   (select f.emailrecebxmlnfe as email                     '+
          '    from fornecedores f                                    '+
          '    where f.codigo = (select df.fornecedortransporte       '+
          '                      from dadosfiscais df                 '+
          '                      where df.numero = :dadofiscal)       '+
          '  and f.emailrecebxmlnfe is not null)                      '+
          '  ) as lista                                               '+
          ' ) as lista                                                '+
          ' where lista is not null ';


var
  vSQL: String;
  qryLista: TtecQuery;
begin

  if tipo = 'DF' then
  begin

    qryLista := TtecQuery.Create(nil);
    qryLista.Database := dtmTecSoft.Database;
    if SomenteTransportadora then
      qryLista.Sql.Text := SQLDFTransp
    else
      qryLista.Sql.Text := SQLDF;

    qryLista.ParamByName('dadofiscal').asInteger := Documento;
    qryLista.Close;
    qryLista.Open;

    result := qryLista.fieldbyname('lista').asString;

  end;

end;





function TdtmBasico.ListadeEmailsBoleto(Tipo: String;
  Documento: integer): String;
const
SQLDF =
' ;select lista from '+
' ( '+
' select string_agg(email,'';'') as lista '+
' from '+
' ( '+
'  select distinct email '+
'  from '+
'  ( '+
' (select df.email '+
'  from dadosfiscais df '+
'  where df.numero = :dadofiscal '+
'   and df.email is NOT null '+
'   and df.pessoatipo=''F'') '+
'   union all  '+
'   (select df.email '+
' from dadosfiscais df  '+
' where df.numero = :dadofiscal '+
'   and df.email is NOT null '+
'   and df.pessoatipo=''J'' '+
'   and not exists '+
'   (select cvf.email '+
'    from contatosvfornecedores cvf '+
'    where (cvf.codigovfornecedores, cvf.tipovfornecedores) '+
'      in (select df.cliente, df.tipocliente '+
'          from dadosfiscais df '+
'          where df.numero = :dadofiscal) '+
'           and coalesce(cvf.enviar_boleto,false) '+
'           and cvf.email is not null order by cvf.email)) '+
' union all '+
'   (select cvf.email '+
'    from contatosvfornecedores cvf '+
'    where (cvf.codigovfornecedores, cvf.tipovfornecedores) '+
'      in (select df.cliente, df.tipocliente '+
'          from dadosfiscais df '+
'          where df.numero = :dadofiscal) '+
'           and coalesce(cvf.enviar_boleto,false) '+
'           and cvf.email is not null order by cvf.email) '+
'         ) as lista '+
'         ) as lista '+
'         ) as lista '+
'         where lista is not null ';

var
  vSQL: String;
  qryLista: TtecQuery;
begin

  if tipo = 'DF' then
  begin

    qryLista := TtecQuery.Create(nil);
    qryLista.Database := dtmTecSoft.Database;
    qryLista.Sql.Text := SQLDF;
    qryLista.ParamByName('dadofiscal').asInteger := Documento;
    qryLista.Close;
    qryLista.Open;

    result := qryLista.fieldbyname('lista').asString;

  end;

end;

function TdtmBasico.AlertarAtualizacaoCadastroCliente(
  CodigoCliente: integer;
  TipoCliente: String;
  awe: Boolean;
  OpcaoNaoConferir: String): TModalResult;
var
  vUltimaAlteracao : Variant;
  vdatahoraconferenciacadastro : Variant;
  vDias : integer;
  vCliente : TVariantArray;
begin
  result := mrNone;

  vDias := 0;
  if (parSistema.DiasAvisoAtualizarCliente <> 0) and ((TipoCliente = 'C') or (TipoCliente = 'F')) then
  begin
    if (TipoCliente = 'C') then
      vCliente := ValorCampodaTabela('clientes', ['codigo'], [CodigoCliente], ['ultimaalteracao','datahoraconferenciacadastro'])
    else
      vCliente := ValorCampodaTabela('fornecedores', ['codigo'], [CodigoCliente], ['ultimaalteracao','datahoraconferenciacadastro']);


    vUltimaAlteracao := vCliente[0];
    vdatahoraconferenciacadastro := vCliente[1];

    if vUltimaAlteracao <> null then
      if vdatahoraconferenciacadastro <> null then
        vDias := DaysBetween(VarToDateTime(vdatahoraconferenciacadastro), dataservidor);

    if (vDias > parSistema.DiasAvisoAtualizarCliente) then
    begin
      if awe then
        result := MensagemSimNaoOpcaoCancelar(format('O cadastro do cliente não esta atualizado desde %s, %d dias, verifique!'+chr(13)+
        'Última conferência em : %s', [vUltimaAlteracao, vdias, vdatahoraconferenciacadastro]),OpcaoNaoConferir ,true,'Conferido','Conferir')
      else
        MensagemAviso(format('O cadastro do cliente não esta atualizado desde %s, %d dias, verifique!'+chr(13)+
        'Última conferência em : %s', [vUltimaAlteracao, vdias, vdatahoraconferenciacadastro]))
    end
    else
    if vdatahoraconferenciacadastro = null then
    begin
       if parSistema.DiasAvisoAtualizarCliente<>0 then
         vDias := parSistema.DiasAvisoAtualizarCliente;

      if awe then
        result := MensagemSimNaoOpcaoCancelar(format('O cadastro do cliente não esta atualizado a mais de %s dias, verifique!', [inttostr(vdias)]),
                 OpcaoNaoConferir,true,'Conferido','Conferir')
      else
       MensagemAviso(format('O cadastro do cliente não esta atualizado a mais de %s dias, verifique!', [inttostr(vdias)]))
    end;

  end;
end;

