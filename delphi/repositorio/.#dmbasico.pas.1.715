function TdtmBasico.eHNotaFiscalSaidaSimplesFaturamento(
  CodigoFiscal: integer): boolean;
var
 vAbrirConsulta : Boolean;
begin
  vAbrirConsulta := True;
  if not assigned(qryCodigosFiscaisFuncao) then
  begin
    qryCodigosFiscaisFuncao := TTecQuery.Create((nil));
    qryCodigosFiscaisFuncao.Database  := dtmTecSoft.Database;
    vAbrirConsulta := True;
  end
  else
    vAbrirConsulta :=  (pCodigoFiscal_eHNotaFiscalSaidaSimplesFaturamento <> CodigoFiscal);

  if vAbrirConsulta then
  begin
    pCodigoFiscal_eHNotaFiscalSaidaSimplesFaturamento := CodigoFiscal;
    qryCodigosFiscaisFuncao.sql.text  := 'select ehnotafiscalsaidasimplesfaturamento(:CodigoFiscal) as ehnotafiscalsaidasimplesfaturamento';
    ReFazConsulta(qryCodigosFiscaisFuncao,[0],[CodigoFiscal]);
    result := qryCodigosFiscaisFuncao.fieldbyname('ehnotafiscalsaidasimplesfaturamento').asBoolean;

    pResult_eHNotaFiscalSaidaSimplesFaturamento := result;

  end
  else
    result := pResult_eHNotaFiscalSaidaSimplesFaturamento;

end;

