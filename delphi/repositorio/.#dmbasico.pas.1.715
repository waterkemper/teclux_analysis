      Zebrado_Detalhe := false;
      Zebrado_SubDetalhe_1 := false;
      Zebrado_SubDetalhe_2 := true;
      Zebrado_SubDetalhe_3 := True;
    end
    else
    begin
      Relatorio.FindObject('mmoZebradoSub').FillColor := clnone;
      Zebrado_Detalhe := true;
      Zebrado_SubDetalhe_1 := true;
      Zebrado_SubDetalhe_2 := false;
      Zebrado_SubDetalhe_3 := false;
    end;
   end
   else
   if (View.Name = 'mmoZebradoSubSub') then
   begin
    if Zebrado_SubDetalhe_2 then
    begin
      Relatorio.FindObject('mmoZebradoSubSub').FillColor := TColor(strtoint(parsistema.CorZebradoRelatorio));
      Zebrado_Detalhe := false;
      Zebrado_SubDetalhe_1 := false;
      Zebrado_SubDetalhe_2 := false;
      Zebrado_SubDetalhe_3 := true;
    end
    else
    begin
      Relatorio.FindObject('mmoZebradoSubSub').FillColor := clnone;
      Zebrado_Detalhe := true;
      Zebrado_SubDetalhe_1 := true;
      Zebrado_SubDetalhe_2 := true;
      Zebrado_SubDetalhe_3 := false;
    end;
   end
   else
   if (View.Name = 'mmoZebradoSubSubSub') then
   begin
    if Zebrado_SubDetalhe_3 then
    begin
      Relatorio.FindObject('mmoZebradoSubSubSub').FillColor := TColor(strtoint(parsistema.CorZebradoRelatorio));
      Zebrado_Detalhe := false;
      Zebrado_SubDetalhe_1 := false;
      Zebrado_SubDetalhe_2 := false;
      Zebrado_SubDetalhe_3 := false;
    end
    else
    begin
      Relatorio.FindObject('mmoZebradoSubSubSub').FillColor := clnone;
      Zebrado_Detalhe := true;
      Zebrado_SubDetalhe_1 := true;
      Zebrado_SubDetalhe_2 := true;
      Zebrado_SubDetalhe_3 := true;

    end;
   end;
  end;
end;

procedure IncluirReducaoViaCalculosCuponsEmitidos;
var
  qryIncluirReducoesZFaltantes: TtecQuery;
begin
  qryIncluirReducoesZFaltantes := TtecQuery.Create(nil);
  qryIncluirReducoesZFaltantes.Database := dtmTecSoft.Database;


  qryIncluirReducoesZFaltantes.Sql.Text := 'select IncluirReducoesZFaltantes(:crz,:cro,:filial,:num_fab, true)';
  qryIncluirReducoesZFaltantes.ParamByName('crz').asinteger := strtoint(ECFPadrao.NumeroReducoes);
  qryIncluirReducoesZFaltantes.ParamByName('cro').asinteger := StrToInt(ECFPadrao.NumCRO);
  qryIncluirReducoesZFaltantes.ParamByName('filial').asinteger := FilialBase;
  qryIncluirReducoesZFaltantes.ParamByName('num_fab').asString := ECFPadrao.SerieMaquina;

  qryIncluirReducoesZFaltantes.Open;
  qryIncluirReducoesZFaltantes.close;
end;

function ItemProdutoGrade(caracteristica, valorgrade1, valorgrade2: String): String;
begin
  if not assigned(qryItemProdutoGrade) then
    qryItemProdutoGrade := TtecQuery.Create(nil);

  qryItemProdutoGrade.Database := dtmTecSoft.Database;
  qryItemProdutoGrade.Sql.Text := 'select p.codigo, p.codigovisual from produtos p where p.caracteristica = :caracteristica and p.valorgrade1 = :valorgrade1 and p.valorgrade2 = :valorgrade2';
  qryItemProdutoGrade.parambyname('caracteristica').asString := caracteristica;
  qryItemProdutoGrade.parambyname('valorgrade1').asString := valorgrade1;
  qryItemProdutoGrade.parambyname('valorgrade2').asString := valorgrade2;

  qryItemProdutoGrade.Open;
  result := qryItemProdutoGrade.fieldbyname('codigo').asString;

end;

function VerificarECF(NotificarSplash: TtecProcParametroString): Boolean;
var
  UltimaReducaoBanco: Integer;
begin
  result := true;

  try
    dtmMenuFiscal := TdtmMenuFiscal.Create(nil);

    if Assigned(ECFPadrao) then
    begin
      try
        Notificar(NotificarSplash, 'Verificando situação do emissor de Cupom Fiscal');
        if ECFPadrao.CupomAberto then
        begin
          Notificar(NotificarSplash, 'Cancelando Cupom Fiscal Aberto');
          ECFPadrao.CancelarCupom;
        end;

        Notificar(NotificarSplash, 'Verificando Ultima Redução Z-');
        UltimaReducaoBanco := dtmMenuFiscal.UltimaReducaoZEmitida;
        if {(UltimaReducaoBanco <> 0) and}
           (UltimaReducaoBanco <> strtoint(ECFPadrao.NumeroReducoes)) then
        begin
          Notificar(NotificarSplash, 'Verificando Última Redução Z--');
          dtmMenuFiscal.ReducaoZAnterior;
        end;

        Notificar(NotificarSplash, 'Cancelando Cupom Fiscal Aberto');
        UltimaReducaoBanco := dtmMenuFiscal.UltimaReducaoZEmitida;
        if {(UltimaReducaoBanco <> 0) and}
           (UltimaReducaoBanco <> strtoint(ECFPadrao.NumeroReducoes)) then
        begin
          Notificar(NotificarSplash, 'Incluindo Redução Z');
          IncluirReducaoViaCalculosCuponsEmitidos;
        end;

        Notificar(NotificarSplash, 'Redução Z Pendente');
        if ECFPadrao.RequerReducaoZ then
          dtmMenuFiscal.ReducaoZ;

        Notificar(NotificarSplash, 'Corrigindo estado de erro');
        if not ECFPadrao.ImpressoraLivre then
           ECFPadrao.CorrigeEstadoDeErro(false);

        if ecfpadrao.erro then
        begin
          MensagemErro(ECFPadrao.Mensagem);
        end
        else begin
          Notificar(NotificarSplash, 'Lendo aliquotas da ECF');
          ECFPadrao.LerAliquotasDaECF;
          if ecfpadrao.erro then
            MensagemErro(ECFPadrao.Mensagem)
          else
          begin
            Notificar(NotificarSplash, 'Indentificação PAF');
            ECFPadrao.IdentificarPAF;
          end;
        end;
      except
        on E:Exception do
        begin
          ErroECF := True;
          FreeAndNil(ECFPadrao);
          MensagemErro(E.Message);
          result := false;
        end;
      end;

      Notificar(NotificarSplash, 'Registrando as formas de pagamento no ECF');
      ECFPadrao.LerFormasPagamento;
      Notificar(NotificarSplash, '');
    end;
  finally
    Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Reduções Z');
    dtmMenuFiscal.BlocoXReducaoZ(NotificarSplash);
    Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Estoque Mensal');
    dtmMenuFiscal.BlocoXEstoqueMesAnterior(NotificarSplash);
    dtmMenuFiscal := nil;
    Notificar(NotificarSplash, '');
  end;

end;
{$IFDEF MSWINDOWS}
function PendenciasTEF(NotificarSplash: TtecProcParametroString): Boolean;
var
//  tecTEFDiscado: TtecTEFDiscado;
//  BackupTEFDiscado: TtecBackupTEFDiscado;
  Sair: Boolean;
begin
 Result := True;
 if (ParSistema.TipoTEF = tsDISCADO) then
  if (TtecTEFDiscado.ExecutavelTEF <> '') then
  begin
    Notificar(NotificarSplash, 'Resolvendo as pendências no módulo TEFDiscado.');
//    tecTEFDiscado := TtecTEFDiscado.Create(tecTEFDiscado);
    Sair := False;
    try
      repeat
//        if tecTEFDiscado.GerenciadorAtivo(False) then
        if assigned(tefpadrao) then
          if TEFPadrao.Inicializado({gpTefDial}gpPayGo) then
          begin
            TEFPadrao.CancelarTransacoesPendentes;
//            BackupTEFDiscado := TtecBackupTEFDiscado.Create;
            Sair := True;
            {
            try
              if BackupTEFDiscado.ExisteArquivo(False) then
              begin
                if (ErroECF) or not(Assigned(ECFPadrao)) then
                begin
                  if BackupTEFDiscado.QtdadeTransacoes = 0 then
                    BackupTEFDiscado.ApagarArquivo
                  else
                    MensagemErro(ctTEFERROECFNAOCANCVENDA)
                end
                else
                begin
                  try
                    BackupTEFDiscado.ExecutarBackup
                  except
                    on E:Exception do
                    begin
                      FreeAndNil(ECFPadrao);
                      MensagemErro(E.Message);
                    end;
                  end;
                end
              end
            finally
              BackupTEFDiscado.Free
            end
            }
          end

      until Sair;
    finally
//      tecTEFDiscado.Free;
      Notificar(NotificarSplash, '');
    end
  end
  else
  begin
    Result := False;
    MensagemErro('Executavel TefDiscado não definido!')
  end;
end;
{$ENDIF}

function PendenciaNFe(NotificarSplash: TtecProcParametroString): Boolean;
var
  dtmControleNotasFiscaisEletronicas_ : tdtmControleNotasFiscaisEletronicas;

begin
    Result := True;
    try
      dtmControleNotasFiscaisEletronicas_ := tdtmControleNotasFiscaisEletronicas.create(nil);
      vPendenciaVisualizacaoControleNFE := dtmControleNotasFiscaisEletronicas_.SelecionarGeral(Formatdatetime('dd/mm/yyyy', incday(DataLocal, -30)),
                      formatDateTime('dd/mm/yyyy', DataLocal), '', '', '');
    finally
      dtmControleNotasFiscaisEletronicas_.free;
    end;
end;

function TdtmBasico.ParametroRelatorio(ParName: String): Variant;
begin
 if      ANSIUpperCase(ParName) ='RAZAOFILIALBASE' then result := RazaoFilialBase
 else if ANSIUpperCase(ParName) ='NOMECONTADOR'    then result := ParSistema.NomeContador
 else if ANSIUpperCase(ParName) ='CPFCONTADOR'     then result := ParSistema.CPFContador
 else if ANSIUpperCase(ParName) ='CRCCONTADOR'     then result := ParSistema.CRCContador
 else if ANSIUpperCase(ParName) ='RESPONSAVEL1'    then result := ParSistema.ResponsavelLivros1
 else if ANSIUpperCase(ParName) ='RESPONSAVEL2'    then result := ParSistema.ResponsavelLivros2
 else if ANSIUpperCase(ParName) ='FOLHA_OU_PAGINA' then
       case ParSistema.LivrosFiscaisFolhaouPagina of
        0: result := ctFOLHA;
        1: result := ctPAGINA;
       end;
end;

function TdtmBasico.Atualizavel(Tabela:TtecQuery): Boolean;
var
 i: Integer;
begin
  Result := False;
  for i:=0 to Tabela.FieldCount -1 do  //verifica todos os campos, exceto o ultimaalteracao
      if (Tabela.Fields[i].AsString <> VarToStr(Tabela.Fields[i].OldValue)) and
         (Tabela.Fields[i].Name <> 'qryClientesultimaalteracao') and
         (Tabela.Fields[i].Name <> 'qryClientesdatahoraconferenciacadastro') then
      begin
        Result := True;
        Break;
      end;
end;

function TdtmBasico.ValorCampoAlterado(Campo: TField): boolean;
begin
  result := Campo.newValue <> Campo.OldValue;
end;

class function TdtmBasico.VerificarGrupoFiliais: Boolean;
var
  qryVerificarGrupoFiliais: TtecQuery;
begin
  qryVerificarGrupoFiliais := TtecQuery.Create(nil);
  qryVerificarGrupoFiliais.Database := dtmTecSoft.Database;
  if ParSistema.RelatorioSomenteFiliaisAutorizadas then
  begin
    qryVerificarGrupoFiliais.Sql.Text := verificarGruposFiliaisUsuariosSQL;
    qryVerificarGrupoFiliais.Params[0].AsInteger := UsuarioLogin.CodigoUsuario;
  end
  else
    qryVerificarGrupoFiliais.Sql.Text := verificarGruposFiliaisSQL;
  qryVerificarGrupoFiliais.Open;
  Result := qryVerificarGrupoFiliais.RecordCount > 0;
  ListaGrupoFiliais := TStringList.Create;
  qryVerificarGrupoFiliais.first;
  while not qryVerificarGrupoFiliais.Eof do
  begin
    ListaGrupoFiliais.AddObject(format('%3s',[qryverificarGrupoFiliais.fieldbyname('codigo').AsString])+'. '+qryVerificarGrupoFiliais.fieldbyname('descricao').AsString, Pointer(qryVerificarGrupoFiliais.fieldbyname('codigo').AsInteger));
    qryVerificarGrupoFiliais.Next;
  end;
  qryVerificarGrupoFiliais.Close;
end;


class function TdtmBasico.VerificarAtualizacaoSaldoContabil(ExibirMsg: Boolean = false): Boolean;

var
  qryAtualizarSaldosContabeis: TtecQuery;
begin
  result := true;
  if ParSistema.ReatualizarSaldosContabeis then
  begin
    qryAtualizarSaldosContabeis := TtecQuery.Create(nil);

    qryAtualizarSaldosContabeis.Database := dtmTecSoft.Database;
    if ExibirMsg then
      TdtmBasico.ShowProcessando('Reatualizando saldos contábeis.');

    qryAtualizarSaldosContabeis.Sql.Text := AtualizarSaldosContabeis;
    qryAtualizarSaldosContabeis.Open;
    qryAtualizarSaldosContabeis.ApplyUpdates;
    qryAtualizarSaldosContabeis.Transaction.Commit;
    qryAtualizarSaldosContabeis.Close;

    qryAtualizarSaldosContabeis.Database := dtmTecSoft.Database;
    qryAtualizarSaldosContabeis.Sql.Text := AtualizarParametroSaldo;
    qryAtualizarSaldosContabeis.ExecSql;
    qryAtualizarSaldosContabeis.ApplyUpdates;
    qryAtualizarSaldosContabeis.Transaction.Commit;
    qryAtualizarSaldosContabeis.Close;

    if ExibirMsg then
      TdtmBasico.ShowProcessando;

    ParSistema.ReatualizarSaldosContabeis := false;
  end;
end;


class function TdtmBasico.VerificarLogotipoFilialBase: string;
var
  SQL: String;
  qryLogotipos: TtecQuery;
begin
  qryLogotipos := TtecQuery.Create(nil);
  qryLogotipos.Database := dtmTecSoft.Database;
  SQL := Format(VerificarLogotipoSQL, [GetFilialBase]);
  qryLogotipos.Sql.Text := SQL;
  qryLogotipos.Open;
  qrylogotipos.First;
  if not qryLogotipos.IsEmpty then
    LogotipoFilialBase := ParSistema.DiretorioImagens+qrylogotipos.Fields[0].AsString
  else
    LogotipoFilialBase := ParSistema.DiretorioImagens+'tecsoft.bmp';
  if not FileExists(logotipoFilialBase) then
    LogotipoFilialBase := ExtractFilePath(application.exename)+'tecsoft.bmp';
  qryLogotipos.Close;
  result := LogotipoFilialBase;
end;

class function TdtmBasico.VerificarFiliaisEstoques: string;
var
  SQL: String;
  qryEstoquesFiliais: TtecQuery;
begin
  qryEstoquesFiliais := TtecQuery.Create(nil);
  qryEstoquesFiliais.Database := dtmTecSoft.Database;
  SQL := Format(VerificarEstoquesFiliais, [GetFilialBase]);
  qryEstoquesFiliais.Sql.Text := SQL;

  ListaEstoquesFiliais := '';

  FFilialBasedaVirtual := 0;

  qryEstoquesFiliais.Open;
  qryEstoquesFiliais.First;
  while not qryEstoquesFiliais.Eof do
  begin
    ListaEstoquesFiliais := ListaEstoquesFiliais + qryEstoquesFiliais.fieldbyname('filialestoque').AsString + ',';
    if (GetTipoFilial = 'V') and
       (GetFilialBase <> qryEstoquesFiliais.fieldbyname('filialestoque').AsInteger) then
      FFilialBasedaVirtual := qryEstoquesFiliais.fieldbyname('filialestoque').AsInteger;

    qryEstoquesFiliais.Next;
  end;

  if pos(inttostr(GetFilialBase),ListaEstoquesFiliais)=0 then
    if GetTipoFilial <> 'V' then //não pode ser virtual
      ListaEstoquesFiliais := ListaEstoquesFiliais + inttostr(GetFilialBase) + ',';

  if ListaEstoquesFiliais<>'' then
    ListaEstoquesFiliais := copy(ListaEstoquesFiliais,1,length(ListaEstoquesFiliais)-1)
  else
    ListaEstoquesFiliais := '0';

  qryEstoquesFiliais.Close;
end;

class procedure TdtmBasico.VerificarContingencias;
var
  SQL : String;
  qryContingencias: TtecQuery;
begin
  qryContingencias := TtecQuery.Create(nil);
  qryContingencias.Database := dtmTecSoft.Database;
  sql := VerificaContingencias;
  qryContingencias.Sql.Text := sql;
  qryContingencias.open;
  if qryContingencias.RecordCount > 0 then
  begin
    ParSistema.DataHoraInicialContingencia := datetimetostr(qryContingencias.fieldbyname('datahorainicial').AsDateTime);
    ParSistema.RazaoContingencia := qryContingencias.fieldbyname('razao').AsString;
  end
  else
  begin
    ParSistema.DataHoraInicialContingencia := '';
    ParSistema.RazaoContingencia := '';
  end;
  qryContingencias.Close;

end;

function ExisteInconsistenciaCCFECF: boolean;
var
 qryUltimoCupom, qryInconsistencia : TTecQuery;
 vCCF, vNUM_USU, vCRO: integer;
 vnum_fab : String;

const

  SQLUltimoCupom =
  ' select coo, ccf, canc '+
  ' from detalhecupom '+
  ' where filial  = :filial     '+
  '   and NUM_USU = :NUM_USU    '+
  '   and CRO     = :CRO        '+
  '   and  num_fab = :num_fab    '+
  ' and coo = '+
  ' ( '+
  ' select max(coo) '+
  ' from detalhecupom '+
  ' where filial  = :filial     '+
  '   and NUM_USU = :NUM_USU    '+
  '   and CRO     = :CRO        '+
  '   and num_fab = :num_fab    '+
  '   and ccf = :ccf  '+
  ' ) ';


  SQLInconsistencia = ' select c.* '                         +
                   ' from cupons c '                      +
                   ' join dadosfiscais df '               +
                   '      join produtosdadosfiscais pdf ' +
                   '      on df.numero = pdf.dadofiscal ' +
                   ' on c.dadofiscal = df.numero '        +
                   ' where df.numero = pdf.dadofiscal '   +
                   ' and c.dadofiscal = df.numero '       +
                   ' and c.filial = :filial '             +
                   ' and c.maquina = :NUM_USU '           +
                   ' and c.intervensao = :CRO '           +
                   ' and c.numeroserie = :num_fab '       +
                   ' and c.numero = :numero ';

begin
  result := false;
  qryUltimoCupom := TtecQuery.Create(nil);
  qryUltimoCupom.CachedUpdates := true;
  qryUltimoCupom.RequestLive := true;
  qryUltimoCupom.Database := dtmTecSoft.Database;
  qryUltimoCupom.Sql.Text := SQLUltimoCupom;

  vNUM_USU := StrToInt(ECFPadrao.NumeroMaquina);
  vCRO     := StrToInt(ECFPadrao.NumCRO);
  vnum_fab := ECFPadrao.SerieMaquina;
  vccf     :=strtoint( ECFPadrao.NumCCF);

  qryUltimoCupom.ParamByName('filial').AsInteger := FilialBase;
  qryUltimoCupom.ParamByName('NUM_USU').AsInteger := vNUM_USU;
  qryUltimoCupom.ParamByName('CRO').AsInteger := vCRO;
  qryUltimoCupom.ParamByName('num_fab').AsString  := vnum_fab;
  qryUltimoCupom.ParamByName('ccf').Asinteger  := vccf;

  qryUltimoCupom.open;

  if (qryUltimoCupom.recordcount = 1) and  (qryUltimoCupom.FieldByName('canc').asstring = 'N') then
  begin
    qryInconsistencia := TtecQuery.Create(nil);
    qryInconsistencia.CachedUpdates := true;
    qryInconsistencia.RequestLive := true;
    qryInconsistencia.Database := dtmTecSoft.Database;
    qryInconsistencia.Sql.Text := SQLInconsistencia;

    qryInconsistencia.ParamByName('filial').AsInteger := FilialBase;
    qryInconsistencia.ParamByName('NUM_USU').AsInteger := vNUM_USU;
    qryInconsistencia.ParamByName('CRO').AsInteger := vCRO;
    qryInconsistencia.ParamByName('num_fab').AsString  := vnum_fab;
    qryInconsistencia.ParamByName('numero').AsInteger := qryUltimoCupom.fieldbyname('coo').asinteger;
    qryInconsistencia.open;
    result := qryInconsistencia.recordcount = 0;  //deveria existir
  end;
  {

  Alterado por Gedovar 2016-10-07 para testar paf ecf  REQUISITO XIV teste 049
  Atenção!! Comentado a linha abaixa pois estava causando erro... entrada documento no caixa (suprimento)

  else
  if qryUltimoCupom.RecordCount = 0 then
    result := true;
  }
end;



function AcertarMovimentacoesAposCancelamentoCupom(cooCancelado: integer): boolean;
var
  frmAjuda: TForm;
begin

  result := false;
  dtmAcertoCupomCancelado := TdtmAcertoCupomCancelado.Create(nil);
  if dtmAcertoCupomCancelado.AcertaMovimentacoes(StrToInt(ECFPadrao.NumeroMaquina),StrToInt(ECFPadrao.Intervencao), cooCancelado, ECFPadrao.seriemaquina) then
  begin
    result := true;
    frmAjuda := FormExists('TfrmCadastroContratos');
    if Assigned(frmAjuda) then
      TfrmAjuda(frmAjuda).OperacaoPadrao([]);
  end;
  dtmAcertoCupomCancelado.Free;

end;

function NumCOOInicial_(SerieMaquina, NumeroMaquina, crz: String): TTecReducoesZ;

const
  SQL = 'SELECT coo, totalizadorgeral ' +
        'FROM reducoesz ' +
        'WHERE numerofabricacao = :numerofabricacao ' +
        '  and filial = :filial ' +
        '  and numerousuario = :numerousuario ' +
{        '  and cro = :cro ' +                    mudança Gedovar para pegar também a z anterior }
{        '  and datamovimento = :datamovimento';  mudança Gedovar para pegar também a z anterior }
        ' and crz = :crz ';

var
   dmBasico : TdtmBasico;
   qryReducoesZ: TTecQuery;
begin
  dmbasico := TdtmBasico.Create(nil);

  qryReducoesZ := TtecQuery.Create(nil);
  qryReducoesZ.Database := dtmTecSoft.Database;
  qryReducoesZ.Sql.Text := SQL;

  qryReducoesZ.ParamByName('numerofabricacao').AsString := SerieMaquina;
  qryReducoesZ.ParamByName('filial').Asinteger := FilialBase;
  qryReducoesZ.ParamByName('numerousuario').Asinteger := strtoint(NumeroMaquina);
  {qryReducoesZ.ParamByName('cro').Asinteger := strtoint(NumCRO);}
  {qryReducoesZ.ParamByName('datamovimento').AsString := formatdatetime('yyyy-mm-dd', strtodate(DataMovimento));}
  qryReducoesZ.ParamByName('crz').Asinteger := strtoint(crz);
  qryReducoesZ.Open;

  if qryReducoesZ.RecordCount = 1 then
  begin
    result.COO_Inicial := qryReducoesZ.fieldbyname('coo').asInteger;
    result.TotalizadorGeral  := qryReducoesZ.fieldbyname('totalizadorgeral').asCurrency;
  end
  else
  begin
    result.COO_Inicial := 0;
    result.TotalizadorGeral  := 0;
  end;

end;

function AcertarMovimentacoesAposCancelamentoNFCe(dadofiscal: integer): boolean;
var
