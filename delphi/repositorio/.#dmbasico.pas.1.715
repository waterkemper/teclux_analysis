    end;

  end;
end;


procedure AtualizarRegistro_a2_MeiosPagto(Data: TDateTime);
var
 qryMeiosPagtos : TTecQuery;
  dmBasico : TdtmBasico;
const
 SQLMeiosPagamento ='DELETE FROM registro_a2 where data = :data;' +
                    'INSERT INTO registro_a2 '+
                     'SELECT ecf,filial,data,tipodocto,meiopagto,sum(valor) AS valoracumulado,md5(coalesce(cast(ecf as varchar),'''')||cast(data as varchar)||cast(tipodocto as varchar)||cast(sum(valor) as varchar)) as hash_paf_registro_a2 ' +
                     'FROM ('+
{				 
                            ' (SELECT a.ecf,a.coo,a.filial,a.data,fca.valor, '+
                            '         CASE WHEN fca.tipo=''DN'' THEN CAST(''Dinheiro'' AS varchar) ELSE CAST(''CHEQUE'' AS VARCHAR) END AS meiopagto, '+
                            '         CAST(''1'' AS varchar) AS tipodocto ' +
                            '  FROM autenticacoes a JOIN frentedecaixaautenticacoes fca ON a.numero = fca.autenticacao '+
                            '  WHERE a.tipo = ''F''   '+
                            '  AND a.filial = :filialbase ' +
                            '  AND a.data = :data ' +
                            '  AND fca.tipo IN  (''DN'',''CH'')) ' +
}					
					        '(SELECT a.ecf,a.coo,a.filial,a.data, (a.valor - (select sum(a2.valor) from autenticacoes a2 where a2.transacao = a.transacao and a2.numero <> a.numero)) as valor, ' +
							'         CAST(''Dinheiro'' AS varchar) AS meiopagto, ' +
                            '         CAST(''2'' AS varchar) AS tipodocto   ' +
                            '   FROM autenticacoes a 						' +			
                            '  WHERE a.tipo = ''F''   ' +
                            '  AND a.filial = :filialbase ' +
                            '  AND a.data = :data ' +
                            '  ) ' +
                            '   UNION ALL'+
                            '  (SELECT a.ecf,a.coo,a.filial,a.data,a.valor,CAST(''Dinheiro'' AS varchar) AS meiopagto,CAST(''2'' AS varchar) AS tipodocto '+
                            '   FROM autenticacoes a  ' +
                            '   WHERE  tipo IN (''B'',''D'',''E'',''G'',''N'',''S'') '+
                            '   AND a.data = :data ' +
                            '   AND a.filial=:filialbase)'+
                            ' UNION ALL ' +
                            ' (SELECT a.ecf,a.coo,a.filial,a.data,a.valor,CAST(''CHEQUE'' as varchar) AS meiopagto,CAST(''1'' AS varchar) AS tipodocto ' +
                            '  FROM autenticacoes a '+
                            '  WHERE tipo = ''H'' AND a.filial = :filialbase'+
                            '   AND a.data = :data )' +
                            ' UNION ALL ' +
                            ' (SELECT a.ecf,a.coo,a.filial,a.data,a.valor, ' +
                            '         CAST((CASE WHEN a.tipotransacao = ''C'' THEN ''C. CREDITO '' ' +
                            '                    ELSE ''C. DEBITO ''  END'+
                            ')        || coalesce(a.administradora,'''') AS varchar) AS meiopagto, '+
                            '         CAST(''1'' AS varchar) AS tipodocto ' +
                            '  FROM autenticacoes a '+
                            ' WHERE a.tipo = ''T'' AND a.filial = :filialbase  '+
                            '  AND a.data = :data )' +
                            ' UNION ALL '+
                            ' (SELECT cast(null as integer) as ecf,n.numero,df.filialvenda,df.data,vdf.valorvencto, '+
                            '         CAST((CASE WHEN tr.tiporecebimento = ''C'' THEN ''C. CREDITO '' '+
                            '                    WHEN tr.tiporecebimento = ''B'' THEN ''C. DEBITO '' '+
                            '                    WHEN tr.tiporecebimento = ''D'' THEN ''Dinheiro'' '+
                            '                    WHEN tr.tiporecebimento = ''H'' THEN ''CHEQUE''  '+
                            '         END) AS varchar) AS meiopagto, CAST(''3'' AS varchar) AS tipodocto ' +
                            '  FROM dadosfiscais df,notas n,venctosdadosfiscais vdf,tiposrecebimentos tr '+
                            '  WHERE df.codigofiscal in (5101,5102,6101,6102,5401,5402,5403,6401,6402,6403) '+
                            '  AND df.data = :data ' +
                            '  and df.numero=n.dadofiscal  AND df.filialvenda=:filialbase '+
                            '  and df.numero=vdf.dadofiscal '+
                            '  and vdf.tiporecebimento=tr.codigo '+
                            '  and df.situacao=''N'') ' +
                          ') AS t   ' +
                          ' GROUP BY ecf,filial,tipodocto,meiopagto,data '+
                          ' ORDER BY data, meiopagto desc, tipodocto;';

begin
  qryMeiosPagtos := TtecQuery.Create(nil);
  qryMeiosPagtos.CachedUpdates:=true;
  qryMeiosPagtos.RequestLive:=true;
  qryMeiosPagtos.Database:=dtmTecSoft.Database;
  qryMeiosPagtos.Sql.Text:=SQLMeiosPagamento;
  qryMeiosPagtos.ParamByName('filialbase').AsInteger:=FilialBase;
  qryMeiosPagtos.ParamByName('data').AsDateTime := Data;
  qryMeiosPagtos.ExecSql;

//  dtmTecSoft.tstTecSoft.Commit;
  dmbasico.Perpetrar([], SomenteGravacao);

  AtualizaHashInclusaoExclusao;

end;

function SalvarECF(CodigoECF: Integer; GT: Currency; CRO: Integer): Boolean;
const
  SQLECF = 'SELECT codigo, grandetotal, ' +
           '       intervencao  ' +
           'FROM ecfs '           +
           'WHERE codigo = :codigo';
var
   dmBasico : TdtmBasico;
   qryECF: TTecQuery;
begin
  result := false;
  dmbasico := TdtmBasico.Create(nil);

  qryECF := TtecQuery.Create(nil);
  qryECF.CachedUpdates := true;
  qryECF.RequestLive := true;
  qryECF.Database := dtmTecSoft.Database;
  qryECF.Sql.Text := SQLECF;

  qryECF.ParamByName('codigo').AsInteger := CodigoECF;
  qryECF.Open;

  qryECF.Edit;

  qryECF.FieldByName('grandetotal').AsCurrency := GT;
  if CRO > 0 then
    qryECF.FieldByName('intervencao').AsInteger := CRO;
  qryECF.Post;

  result := dmbasico.perpetrar([qryECF], SomenteGravacao);
end;

function Getvdatahoraservidor: TDateTime;
begin
  Result := dtmTecSoft.DataHoraServidor;
end;

function PrimeiroDiaUtil_(Filial: integer; Data: TDateTime; Tipo: String): TDateTime;
const
  SQL = 'select PrimeiroDiaUtil(:Filial,:Data,:Tipo) as Data';
var
   dmBasico : TdtmBasico;
   qryDiaUtil: TTecQuery;
begin
  dmbasico := TdtmBasico.Create(nil);
  qryDiaUtil := TtecQuery.Create(nil);
  qryDiaUtil.Database := dtmTecSoft.Database;
  qryDiaUtil.Sql.Text := SQL;

  qryDiaUtil.ParamByName('Filial').AsInteger := Filial;
  qryDiaUtil.ParamByName('Data').AsDateTime := Data;
  qryDiaUtil.ParamByName('Tipo').AsString := quotedstr(Tipo);

  qryDiaUtil.Open;
  result := qryDiaUtil.fieldbyname('Data').asDateTime;
end;

function CalcularJurosBanco_(valorVencto: Currency; DataVencto, DataPagto: TDateTime; FilialVenda: Integer): Currency;
const
  SQL = 'select CalcularJuros(cast(:ValorVencto as numeric), Cast(:DataVencto as date), cast(:DataPagto as date), cast(:FilialVenda as smallint)) as Valor';
var
   dmBasico : TdtmBasico;
   qryJuroseMulta: TTecQuery;
begin
  dmbasico := TdtmBasico.Create(nil);
  qryJuroseMulta := TtecQuery.Create(nil);
  qryJuroseMulta.Database := dtmTecSoft.Database;
  qryJuroseMulta.Sql.Text := SQL;

  qryJuroseMulta.ParamByName('ValorVencto').AsCurrency := ValorVencto;
  qryJuroseMulta.ParamByName('DataVencto').AsDateTime := DataVencto;
  qryJuroseMulta.ParamByName('DataPagto').AsDateTime := DataPagto;
  qryJuroseMulta.ParamByName('FilialVenda').AsInteger := FilialVenda;

  qryJuroseMulta.Open;
  result := qryJuroseMulta.fieldbyname('Valor').asCurrency;
end;

function MontarOrcamento(qryContratos, qryProdutosContratos, qryServicosContratos: tTecQuery; origem: TOrigemEmail = OutrosEmail): tStringList;
var
  I: Integer;
  Soma: Real;
{  Estoque: String;}
  Classificacao: String;
  Html: TStringList;

  function f_Proposta: String;
  begin
    case origem of
      ContratosEmail    : result := 'Contrato';
      OrcamentoEmail    : result := 'Orçamento';
      OrdemServicoEmail : result := 'Ordem de Serviço';
    else result := 'Proposta';
    end;
  end;


  function f_Numero: String;
  begin
    case origem of
      ContratosEmail    : result := qryContratos.FieldByName('numero').AsString;
      OrcamentoEmail    : result := qryContratos.FieldByName('codigo').AsString;
      OrdemServicoEmail : result := qryContratos.FieldByName('numero').AsString;
    else result := qryContratos.FieldByName('numero').AsString;
    end;
  end;

  function f_Textos_finais: TStrings;
  begin
    case origem of
      ContratosEmail    : result := parsistema.Textos_finais_nos_contratos_via_email;
      OrcamentoEmail    : result := parsistema.Textos_finais_nos_orcamentos_via_email;
      OrdemServicoEmail : result := parsistema.Textos_finais_nas_ordens_de_servico_via_email;
    else
      result := nil;
    end;
  end;

  function CamposSubst(Linha: String): String;
  {
  var
    lCampoSubst: TStringList;
    function VAlorCampoValidade: String;
    begin
      result := '';
      if qryContratos.findfield(
    end;
    }
  begin
    {
    lCampoSubst := TStringList.create;
    ExtractStrings(['<campo_'], [], PChar(Linha), lCampoSubst);

    if lCampoSubst.count<>0 then
    begin
      for i:=0 to lCampoSubst.count-1 do
      begin
        result := StringReplace(Linha, '<campo_validade>', ValorCampoValidade);
      end;
    end;
    }

    result := linha;
    if pos('<campo_validade>', linha)<>0 then
    begin
      if qrycontratos.findfield('validade')<>nil then
        result := StringReplace(linha, '<campo_validade>', FormatDateTime('dd/mm/yyyy', qryContratos.fieldByname('validade').asDateTime), [rfReplaceAll])
      else
        result := StringReplace(linha, '<campo_validade>', '', [rfReplaceAll]);
    end;
  end;

  function qryProdutosContratos_FieldByName_cancelado_AsCurrency : Currency;
  begin
    result := 0;
    if qryProdutosContratos.findfield('cancelado')<>nil then
      result := qryProdutosContratos.FieldByName('cancelado').AsCurrency;
  end;

  function DiasEstoque: String;
  begin
    result := '';
    case origem of
      ContratosEmail,
      OrdemServicoEmail:
      begin
                 if ((qryProdutosContratos.FieldByName('emestoque').AsInteger >=
                     (qryProdutosContratos.FieldByName('quantidade').AsCurrency-
                      qryProdutosContratos.FieldByName('cancelado').AsCurrency)) and
                     (qryProdutosContratos.FieldByName('dias').IsNull))

                     or

                     (qryProdutosContratos.FieldByName('dias').AsString='0') then

                    result := 'Imediata'
                 else if (qryProdutosContratos.FieldByName('emestoque').AsInteger < qryProdutosContratos.FieldByName('quantidade').AsCurrency) and (qryProdutosContratos.FieldByName('dias').IsNull) then
                    result := ' - '
                 else if (qryProdutosContratos.FieldByName('dias').AsInteger = 1) then
                   result := inttostr(qryProdutosContratos.FieldByName('dias').AsInteger) +' dia'
                 else if (qryProdutosContratos.FieldByName('dias').AsInteger > 1) then
                   result := inttostr(qryProdutosContratos.FieldByName('dias').AsInteger) +' dias';
      end;

    end;
  end;





