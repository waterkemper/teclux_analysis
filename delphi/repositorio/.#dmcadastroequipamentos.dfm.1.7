    Sql.Strings = (
      'SELECT pe.Equipamento,'
      '       pe.Produto,'
      '       pe.Numero,'
      '       pe.Quantidade,'
      '       p.Descricao,'
      '      (SELECT g.Descricao'
      '          FROM Grades g, Caracteristicas c'
      '          WHERE g.Codigo = c.Grade1 AND'
      '                c.Codigo = p.Caracteristica) AS Linha,'
      '      (SELECT g.Descricao'
      '          FROM Grades g, Caracteristicas c'
      '          WHERE g.Codigo = c.Grade2 AND'
      '                c.Codigo = p.Caracteristica) AS Coluna,'
      '       p.ValorGrade1,'
      '       p.ValorGrade2,'
      '       FALSE AS Imprimir'
      ''
      
        'FROM  produtosequipamentos pe join produtos p on pe.Produto = p.' +
        'Codigo'
      ''
      'WHERE pe.Equipamento = :Equipamento'
      ''
      'ORDER BY pe.Numero')
