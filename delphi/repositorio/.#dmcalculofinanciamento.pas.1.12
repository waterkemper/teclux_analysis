function TdtmCalculoFinanciamento.ValidaValores: Boolean;
var
  Pos  : TBookmark;
  I,T  : Integer;
  aux,
  TaxaDia: Real;
  ValorParcMin,
  ValorPrimParc: Currency;
  Total: Currency;

begin
  Result := True;
  Pos:= qryCalculoFinanciamento.GetBookmark;
  qryCalculoFinanciamento.DisableControls;
  try
    Total := 0;
    T:=qryCalculoFinanciamento.RecordCount;
    qryCalculoFinanciamento.First;
    for I:= 1 to T do begin
      Total:= Total +
              (qryCalculoFinanciamentovalorvencto.AsCurrency * qryCalculoFinanciamentoparcela.AsInteger);
      if I = 1 then begin
        ValorParcMin  := (*RoundTo*)Truncar((qryPlanosPagamentoporcentagementrada.AsCurrency * Financiado / 100),2);
        TaxaDia       := tecFinanceira.TaxaDiaria(qryPlanosPagamentotaxamensaljuros.AsFloat);
        Aux           := Power(TaxaDia, DaysBetween(qryCalculoFinanciamentodatavencto.AsDateTime, StrToDate(fDataCalculo)));
        ValorPrimParc := (*RoundTo*)Truncar((qryCalculoFinanciamentovalorvencto.AsCurrency / Aux),2);
        if (ValorPrimParc < ValorParcMin) then begin
          MensagemAviso(Format(ctVALORPRIMEIRAPARCELA,[Format('%5.2f', [qryPlanosPagamentoporcentagementrada.AsFloat]) + '%']));
          Result := False;
          Break;
        end
      end;

      if qryPlanosPagamentominimoparcelaaotipodereceb.asBoolean then
      begin
        if (qryCalculoFinanciamentovalornumerorecebimentos.AsCurrency < qryPlanosPagamentovalorminimoparcela.AsCurrency) then
        begin
          MensagemAviso(Format(ctPARCELAVALOREMINIMA,
                       [Format('%8.2m', [qryCalculoFinanciamentovalornumerorecebimentos.AsCurrency]),
                        Format('%8.2m', [qryPlanosPagamentovalorminimoparcela.AsCurrency])
                       ]));

          Result := False;
          Break;
        end;
      end
      else
      begin
        if (qryCalculoFinanciamentovalorvencto.AsCurrency < qryPlanosPagamentovalorminimoparcela.AsCurrency) then
        begin
          MensagemAviso(Format(ctPARCELAVALOREMINIMA,
                       [Format('%8.2m', [qryCalculoFinanciamentovalorvencto.AsCurrency]),
                        Format('%8.2m', [qryPlanosPagamentovalorminimoparcela.AsCurrency])
                       ]));
          Result := False;
          Break;
        end;
      end;

      if ParSistema.Obrigartipoderecebimentonocalculodefinanciamento then
      begin
        if qryCalculoFinanciamentotiporecebimento.AsInteger=0 then
        begin
          MensagemAviso(ctPARCELASEMTIPODERECEBIMENTO);
          Result := False;
          Break;
        end;
      end;

      qryCalculoFinanciamento.Next;
    end;
  finally
    qryCalculoFinanciamento.GotoBookmark(Pos);
    qryCalculoFinanciamento.FreeBookmark(Pos);
    qryCalculoFinanciamento.EnableControls;
  end;
//  if Result then
//    Result:= ValidarDesconto;
end;


function TdtmCalculoFinanciamento.ValidarDesconto(RequerAutorizacao:Boolean = False): Boolean;
var
  vUsuario : TTecUsuarios;

begin

  Result:= True;

  if (Porcentagem > 0) and not PermiteDesconto  and RequerAutorizacao then
  begin
    vUsuario := ObterAutorizacao(taLOGIN, 'Liberar desconto', ctGERENTEVENDAS);

    if vUsuario <> nil then
    begin
      if not vUsuario.GerenteVendas then
      begin
        MensagemAviso(Format(ctUSUARIONAOAUTORIZADO,['Liberar desconto quando produtos em promoção ']));
        Result := false;
      end
      else
        result := true;
    end;
  end
  else
  begin
    if (Porcentagem > DescontoMaximo) then
    begin
      MensagemAviso(ctDESCONTOMAXIMOEXCEDIDO);
//      Result := False;
    end;
  end;

end;

function TdtmCalculoFinanciamento.ValorMercadoriaEhValido: Boolean;
begin
  Result:= False;
  if (FValorMercadoria < qryPlanosPagamentocompraminima.AsCurrency)   or
     ((qryPlanosPagamentocompramaxima.AsCurrency > 0)                 and
      (FValorMercadoria > qryPlanosPagamentocompramaxima.AsCurrency)) then
      MensagemAviso(Format(ctVALORCOMPRAMINIMAMAXIMA,[Format('%8.2m', [qryPlanosPagamentocompraminima.AsCurrency]),
                                                      Format('%8.2m', [qryPlanosPagamentocompramaxima.AsCurrency])]))
  else
    Result:= True;
end;

