    qryPlanosSemEntrada.Close;
    qryPlanosComEntrada.Close;
  end;
end;

function TdtmCalculoFinanciamento.PreencherValores(Calcular: Boolean;
  Plano: Integer; Parcelas: TResumosParcelas;
  Grupos, Classes: vstring): TtecTipoCalculo;
var
  a: Integer;
  ComEntrada,
  SemEntrada: Boolean;
  ParcAnt, PrestAnt: Integer;
begin
  if ParSistema.CalculoComTodosPlanos then begin
    CalcularDescontoZeroDosPLanos;
    JaFoiCalculadoTodosPlanos:=False;
    ComEntrada := qryPlanosComEntrada.Locate('codigo', Plano, []);
    SemEntrada := qryPlanosSemEntrada.Locate('codigo', Plano, []);
    JaFoiCalculadoTodosPlanos:=True;
    if ComEntrada then begin
      Result := tcCOMENTRADA;
      TipoCalculo := tcCOMENTRADA;
      ReFazConsulta(qryPlanosPagamento, [0], [Plano]);
    end else if SemEntrada then begin
      Result := tcSEMENTRADA;
      TipoCalculo := tcSEMENTRADA;
      ReFazConsulta(qryPlanosPagamento, [0], [Plano]);
    end else begin
      Result := tcNENHUM;
      TipoCalculo := tcNENHUM
    end
  end else begin
    ComEntrada := False;
    SemEntrada := False;
    Result := tcNENHUM;
    qryPlanosPagamento.Params[1].AsCurrency         := ValorMercadoria;
    qryConsultaPlanosPagamento.Params[0].AsCurrency := ValorMercadoria;
    ReFazConsulta(qryPlanosPagamento, [0], [Plano]);
    LimparTabela(qryCalculoFinanciamento)//ReFazConsulta(qryCalculoFinanciamento, [0], [0])
  end;
  if ComEntrada or SemEntrada or (Not ParSistema.CalculoComTodosPlanos and (qryPlanosPagamento.RecordCount > 0)) then begin
    PrimeiraVez := True;
    LimparTabela(qryCalculoFinanciamento);
    ParcAnt  := 1;
    PrestAnt := 0;
    FPodeInserir:= True;
    for a := 0 to High(Parcelas) do begin
      qryCalculoFinanciamento.Append;
      qryCalculoFinanciamentodatavencto.AsDateTime := Parcelas[a].Vencimento;
      qryCalculoFinanciamentovalorvencto.AsCurrency:= Parcelas[a].Valor;
      qryCalculoFinanciamentoparcela.AsInteger     := Parcelas[a].Parcelas;
      qryCalculoFinanciamentoformapagamento.AsString := Parcelas[a].FormaPagamento;
      qryCalculoFinanciamentotiporecebimento.AsInteger := Parcelas[a].TipoRecebimento;
      qryCalculoFinanciamentotiporeceb.AsString := Parcelas[a].DescricaoTipoRecebimento;

      qryCalculoFinanciamentost.AsBoolean := Parcelas[a].Substituicao;
      qryCalculoFinanciamentoprestacao.AsInteger   := ParcAnt + PrestAnt;
      qryCalculoFinanciamento.Post;
      PrestAnt := qryCalculoFinanciamentoprestacao.AsInteger;
      ParcAnt  := Parcelas[a].Parcelas;
    end;
    FPodeInserir:= False;
    PrimeiraVez := False;
    if Calcular then
    begin
      if ComEntrada then
        qryPlanosComEntradaAfterScroll(qryPlanosComEntrada)
      else if SemEntrada then
        qryPlanosSemEntradaAfterScroll(qryPlanosSemEntrada);
    end;
    qryCalculoFinanciamento.EnableControls;
  end;
end;

procedure TdtmCalculoFinanciamento.qryCalculoFinanciamentoAfterInsert(DataSet: TDataSet);
begin
  inherited;
  if not FPodeInserir then
    qryCalculoFinanciamento.Cancel;
end;

procedure TdtmCalculoFinanciamento.qryCalculoFinanciamentoBeforeInsert(DataSet: TDataSet);
begin
  inherited;
  FPodeReCalcular:= False;
end;

procedure TdtmCalculoFinanciamento.qryPlanosComEntradaAfterInsert(DataSet: TDataSet);
begin
  inherited;
  qryPlanosComEntrada.Cancel;
end;

procedure TdtmCalculoFinanciamento.qryPlanosComEntradaAfterScroll(DataSet: TDataSet);
begin
  if JaFoiCalculadoTodosPlanos then begin
    dsrCalculoFinanciamento.OnDataChange := nil;
    if qryPlanosComEntradaCodigo.AsInteger > 0 then
      ReFazConsulta(qryPlanosPagamento,[0],[qryPlanosComEntradaCodigo.AsInteger]);
    CalcularValores;

    if Assigned(FAfterScrollCalculoFinanciamento) then
      FAfterScrollCalculoFinanciamento(qryCalculoFinanciamento);
    dsrCalculoFinanciamento.OnDataChange := dsrCalculoFinanciamentoDataChange;
  end;
end;

procedure TdtmCalculoFinanciamento.qryPlanosSemEntradaAfterInsert(DataSet: TDataSet);
begin
  inherited;
  qryPlanosSemEntrada.Cancel;
end;

procedure TdtmCalculoFinanciamento.qryPlanosSemEntradaAfterScroll(DataSet: TDataSet);
begin
  if JaFoiCalculadoTodosPlanos then begin
    if qryPlanosSemEntradaCodigo.AsInteger > 0 then
      ReFazConsulta(qryPlanosPagamento,[0],[qryPlanosSemEntradaCodigo.AsInteger]);
    CalcularValores;

    if Assigned(FAfterScrollCalculoFinanciamento) then
      FAfterScrollCalculoFinanciamento(qryCalculoFinanciamento);
  end;                                                              
end;

procedure TdtmCalculoFinanciamento.ReCalcular;
var
  A       : Integer;
  Pos     : TBookmark;
  Achou   : Boolean;
  DataAux : TDateTime;
begin
  FPodeReCalcular:= False;
  ZerarVariaveis;
  Achou   := False;
  Pos:= qryCalculoFinanciamento.GetBookmark;
  qryCalculoFinanciamento.DisableControls;
  try
    if DiaFixo then
      DataAux:= ValidarData
    else begin
      if qryPlanosPagamentodiavenctoentrada.AsDateTime = 0 then begin
        if (qryPlanosPagamentoprazovenctoentrada.AsInteger = 30) and qryPlanosPagamentomestrintadias.AsBoolean then
             DataAux:= SomarDia(StrToDate(FDataCalculo),30,'S')
        else DataAux:= SomarDia(StrToDate(FDataCalculo),qryPlanosPagamentoprazovenctoentrada.AsInteger,'N');
      end
      else   DataAux:= qryPlanosPagamentodiavenctoentrada.AsDateTime;
    end;

    FPrestacao:= 1; FDataVencto:= DataAux;

    qryCalculoFinanciamento.First;
    for A:= 1 to qryCalculoFinanciamento.RecordCount do begin
      if not Achou then  begin
        qryCalculoFinanciamento.Edit;
        if (qryCalculoFinanciamento.CompareBookmarks(Pos,qryCalculoFinanciamento.GetBookmark) = 0) or
          Achou then begin
          if not Achou then BookMarkParcela:= qryCalculoFinanciamentoprestacao.AsInteger;
            qryCalculoFinanciamentoprestacao.AsInteger   := FPrestacao + FParcelas;
            qryCalculoFinanciamentoparcela.AsInteger     := (qryPlanosPagamentoquantidadeparcelas.AsInteger -
                                                            (FPrestacao + FParcelas-1));
            if qryPlanosPagamentomestrintadias.AsBoolean then
              qryCalculoFinanciamentodatavencto.AsDateTime := SomarDia(FDataVencto, (qryPlanosPagamentointervaloparcelas.AsInteger *
                                                                                     (FParcelas)),'S')
            else
              qryCalculoFinanciamentodatavencto.AsDateTime := SomarDia(FDataVencto, (qryPlanosPagamentointervaloparcelas.AsInteger *
                                                                                     (FParcelas)),'N');

            qryCalculoFinanciamentovalorvencto.AsCurrency:= (*RoundTo*)Truncar((Financiado / FTaxaAcumulada),2);
            Achou:= True;
        end;
        qryCalculoFinanciamento.Post;
      end
      else
        qryCalculoFinanciamento.Delete;

      FPrestacao  := qryCalculoFinanciamentoprestacao.AsInteger;
      FParcelas   := qryCalculoFinanciamentoparcela.AsInteger;
      FDataVencto := qryCalculoFinanciamentodatavencto.AsDateTime;
      qryCalculoFinanciamento.Next;
    end;
//    CalcularNovosValoresParcela(True,False);
  finally
    qryCalculoFinanciamento.GotoBookmark(Pos);
    qryCalculoFinanciamento.FreeBookmark(Pos);
    qryCalculoFinanciamento.EnableControls;
  end;
  CalcularNovosValoresParcela(True,False);
end;

procedure TdtmCalculoFinanciamento.ReFazConsultaPlanoPagamento;
begin
  if TipoCalculo = tcSEMENTRADA then
    ReFazConsulta(qryPlanosPagamento,[0],[qryPlanosSemEntradacodigo.AsInteger])
  else if TipoCalculo = tcCOMENTRADA then
    ReFazConsulta(qryPlanosPagamento,[0],[qryPlanosComEntradacodigo.AsInteger])
  else
    ReFazConsulta(qryPlanosPagamento, [], []);
end;

procedure TdtmCalculoFinanciamento.ResumosParcelas(var Parcelas: TResumosParcelas;
  var ValorPrazo, TaxaJurosMensal, Desconto: Real; var Plano: Integer);
var
  Pos: TBookmark;
  a: Integer;
begin
  SetLength(parcelas, qryCalculoFinanciamento.RecordCount);
  qryCalculoFinanciamento.DisableControls;
  POs := qryCalculoFinanciamento.GetBookmark;
  ValorPrazo := Futuro;
  TaxaJurosMensal  := GetTaxaJurosMensal;
  Desconto   := Self.Desconto;
  if Plano = 0 then
    Plano      := GetPlanoUsando;
  try
    a := 0;
    qryCalculoFinanciamento.First;
    while not qryCalculoFinanciamento.Eof do begin
      Parcelas[a].Parcelas   := qryCalculoFinanciamentoparcela.AsInteger;
      Parcelas[a].Vencimento := qryCalculoFinanciamentodatavencto.AsDateTime;
      Parcelas[a].Valor      := qryCalculoFinanciamentovalorvenctocomst.AsCurrency;
      Parcelas[a].FormaPagamento := qryCalculoFinanciamentoformapagamento.AsString;
      Parcelas[a].TipoRecebimento:= qryCalculoFinanciamentotiporecebimento.AsInteger;
      Parcelas[a].DescricaoTipoRecebimento:= qryCalculoFinanciamentotiporeceb.AsString;
      Parcelas[a].Substituicao   := qryCalculoFinanciamentost.AsBoolean;
      qryCalculoFinanciamento.Next;
      Inc(a)
    end
  finally
    qryCalculoFinanciamento.GotoBookmark(Pos);
    qryCalculoFinanciamento.FreeBookmark(Pos);
    qryCalculoFinanciamento.EnableControls;
  end
end;

