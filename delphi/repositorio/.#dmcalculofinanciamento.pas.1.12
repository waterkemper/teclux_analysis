procedure TdtmCalculoFinanciamento.AcertaValorParcelasSemJuros;
type
//    PParcelas = ^TParcelas;
  TParcelas = Record
     Prestacao   : Integer;
     Parcela     : Integer;
     Data        : TDateTime;
     Valor       : Currency;
     Pagamento   : String;
     Recebimento : String;
     DescricaotipoRecebimento : String;
     Substituicao: Boolean;
  end;

var
  NPsAcumulado, X, i: Integer;
  VlrAcumulado,
  SomaParcelasArray,
  Dif: Currency;
  A: Array of TParcelas;

begin
  try
    NPsAcumulado := 0;
    VlrAcumulado := 0.00;
    qryCalculoFinanciamento.DisableControls;
    qryCalculoFinanciamento.First;
    while not qryCalculoFinanciamento.Eof do
    begin
      if not qryCalculoFinanciamentost.AsBoolean then
      begin
        NPsAcumulado := NPsAcumulado + qryCalculoFinanciamentoparcela.AsInteger;
        VlrAcumulado := VlrAcumulado + (qryCalculoFinanciamentovalorvencto.AsCurrency * qryCalculoFinanciamentoparcela.AsInteger);

        if qryCalculoFinanciamento.CompareBookmarks(qryCalculoFinanciamento.GetBookmark,PosParcela) = 0 then
        begin
          qryCalculoFinanciamento.Next;
          Break;
        end;
      end;
      qryCalculoFinanciamento.Next;
    end;

    // CRIA ARRAY DE TAMANHO IGUAL AO NUMERO DE PARCELAS RESTANTES E RATEAR O VALOR RESTANTE
    X := qryPlanosPagamentoquantidadeparcelas.AsInteger - NPsAcumulado;
    if X > 0 then
    begin
      SomaParcelasArray := 0;
      SetLength(A,X);
      for i:=0 to X-1 do
      begin
        A[i].Prestacao   := qryCalculoFinanciamentoprestacao.AsInteger;
        A[i].Parcela     := qryCalculoFinanciamentoparcela.AsInteger;
        A[i].Data        := qryCalculoFinanciamentodatavencto.AsDateTime;
        A[i].Valor       := Truncar((Financiado-VlrAcumulado)/X,2);
        SomaParcelasArray:= SomaParcelasArray + A[i].Valor;
        A[i].Pagamento   := qryCalculoFinanciamentoformapagamento.AsString;
        A[i].Recebimento := qryCalculoFinanciamentotiporecebimento.AsString;
        A[i].DescricaotipoRecebimento := qryCalculoFinanciamentotiporeceb.AsString;
        A[i].Substituicao:= qryCalculoFinanciamentost.AsBoolean;
      end;

      Dif := (Financiado-VlrAcumulado) - SomaParcelasArray;
      i := 0;
      while Dif > 0 do
      begin
        A[i].Valor := A[i].Valor + 0.01;
        Dif := Dif - 0.01;
        if i = X-1 then
          i := 0
        else
          Inc(i);
      end;

      //APAGA OS REGISTROS ATE ENCONTRAR O ALTERADO
      qryCalculoFinanciamento.Last;
      while qryCalculoFinanciamento.CompareBookmarks(qryCalculoFinanciamento.GetBookmark,PosParcela) > 0 do
        qryCalculoFinanciamento.Delete;
      //COMPARA OS VALORES E GERA AS PARCELAS DE ACORDO
      FPodeInserir := True;
      for i:=0 to X-1 do
      begin
        if (a[i].Valor = qryCalculoFinanciamentovalorvencto.AsCurrency) and
           (i > 0) then
        begin
          qryCalculoFinanciamento.Edit;
          qryCalculoFinanciamentoparcela.AsInteger := A[i-1].Parcela + 1;
          A[i].Parcela := qryCalculoFinanciamentoparcela.AsInteger;
          A[i].Prestacao := qryCalculoFinanciamentoprestacao.AsInteger;
          if qryPlanosPagamentomestrintadias.AsBoolean then
            A[i].Data := SomarDia(A[i-1].Data,(qryPlanosPagamentointervaloparcelas.AsInteger),'S')
          else
            A[i].Data := SomarDia(A[i-1].Data,(qryPlanosPagamentointervaloparcelas.AsInteger),'N');
          qryCalculoFinanciamento.Post;
        end
        else
        begin
          qryCalculoFinanciamento.Append;
          qryCalculoFinanciamentoparcela.AsInteger   := 1;
          A[i].Parcela := 1;
          if i = 0 then
          begin
            qryCalculoFinanciamentoprestacao.AsInteger := a[i].Prestacao;
            qryCalculoFinanciamentodatavencto.AsDateTime := A[i].Data;
          end
          else
          begin
            qryCalculoFinanciamentoprestacao.AsInteger := a[i-1].Prestacao + a[i-1].Parcela;
            if qryPlanosPagamentomestrintadias.AsBoolean then
              qryCalculoFinanciamentodatavencto.AsDateTime := SomarDia(A[i-1].Data,(qryPlanosPagamentointervaloparcelas.AsInteger),'S')
            else
              qryCalculoFinanciamentodatavencto.AsDateTime := SomarDia(A[i-1].Data,(qryPlanosPagamentointervaloparcelas.AsInteger),'N');
          end;
          a[i].Prestacao := qryCalculoFinanciamentoprestacao.AsInteger;
          A[i].Data := qryCalculoFinanciamentodatavencto.AsDateTime;
          qryCalculoFinanciamentovalorvencto.AsCurrency := a[i].Valor;
          qryCalculoFinanciamentoformapagamento.AsString := a[i].Pagamento;
          qryCalculoFinanciamentotiporecebimento.AsString:=a[i].recebimento;
          qryCalculoFinanciamentotiporeceb.AsString := a[i].DescricaotipoRecebimento;
          qryCalculoFinanciamentost.AsBoolean := a[i].Substituicao;
          qryCalculoFinanciamento.Post;
        end;
      end;
    end;
  finally
    qryCalculoFinanciamento.GotoBookmark(PosParcela);
    qryCalculoFinanciamento.FreeBookmark(PosParcela);
    qryCalculoFinanciamento.EnableControls;
    FPodeInserir := False;
  end;
end;

procedure TdtmCalculoFinanciamento.AgruparParcelas(ReCalculandoValor, ReCalculandoData:Boolean; DifST: Double = 0);
type
  PParcelas = ^TParcelas;
  TParcelas = Record
     Prestacao   : Integer;
     Parcela     : Integer;
     Data        : TDateTime;
     Valor       : Currency;
     ValorST     : Currency;
     Pagamento   : String;
     Recebimento : String;
     DescricaoTipoRecebimento : String;
     Substituicao: Boolean;
  end;

var
  i, X : Integer;
  Dif, vDifST: Currency;
  LP: Array[1..99] of PParcelas;
begin
(*  if PrimeiraVez or ReCalculandoData or ReCalculandoValor then
  begin *)
    try
      vDifST := DifST;
//      qryCalculoFinanciamento.DisableControls;
      if not ReCalculandoValor then
      begin
        dif := Acrescimo;
        X := qryPlanosPagamentoquantidadeparcelas.AsInteger;
        qryCalculoFinanciamento.First;
        if qryCalculoFinanciamentost.AsBoolean then
          qryCalculoFinanciamento.Next;
      end
      else
      begin
        dif := -Desconto;
        X := FNrParcelaAnterior;
      end;

      if (Dif <> 0) or (vDifST <> 0) then
      begin
        for i:= low(LP) to X do
          new(LP[i]);

        for i := Low(LP) to X do
        begin
          if not ReCalculandoValor then
            if ParSistema.GerarParcelaSubstituicaoTributaria and (ValorSubstituicaoTributaria > 0) then
              LP[i]^.Prestacao := i+1
            else
              LP[i]^.Prestacao := i
          else
            LP[i]^.Prestacao := qryCalculoFinanciamentoprestacao.AsInteger;
          LP[i]^.Parcela   := 1;
          LP[i]^.Data      := qryCalculoFinanciamentodatavencto.AsDateTime;

          if dif > 0 then
          begin
            LP[i]^.Valor := qryCalculoFinanciamentovalorvencto.AsCurrency - 0.01;
            dif := dif - 0.01;
          end
          else if dif < 0 then
          begin
            LP[i]^.Valor := qryCalculoFinanciamentovalorvencto.AsCurrency + 0.01;
            dif := dif + 0.01;
          end else
            LP[i]^.Valor     := qryCalculoFinanciamentovalorvencto.AsCurrency;

          if vDifST > 0 then
          begin
            LP[i]^.ValorST := qryCalculoFinanciamentovalorsubstituicao.AsCurrency - 0.01;
            vDifST := vDifST - 0.01;
          end
          else if vDifST < 0 then
          begin
            LP[i]^.Valor := qryCalculoFinanciamentovalorsubstituicao.AsCurrency + 0.01;
            vDifST := vDifST + 0.01;
          end else
            LP[i]^.ValorST     := qryCalculoFinanciamentovalorsubstituicao.AsCurrency;

          LP[i]^.Pagamento   := qryCalculoFinanciamentoformapagamento.AsString;
          LP[i]^.Recebimento := qryCalculoFinanciamentotiporecebimento.AsString;
          LP[i]^.DescricaoTipoRecebimento := qryCalculoFinanciamentotiporeceb.AsString;
          LP[i]^.Substituicao:= qryCalculoFinanciamentost.AsBoolean;
        end;

        if ParSistema.GerarParcelaSubstituicaoTributaria and (ValorSubstituicaoTributaria > 0) then
        begin
          qryCalculoFinanciamento.first;
         { while qryCalculoFinanciamento.eofRecordCount > 1 do }
         while not qryCalculoFinanciamento.eof do
         begin
           if not qryCalculoFinanciamentost.AsBoolean then
            qryCalculoFinanciamento.Delete
           else
            qryCalculoFinanciamento.next;
         end;
        end
        else
        if not ReCalculandoValor then
          LimparTabela(qryCalculoFinanciamento);
        FPodeInserir := True;

        for i := Low(LP) to X do
        begin
          if (i = 1) and ReCalculandoValor then
          begin
            qryCalculoFinanciamento.Edit;
            qryCalculoFinanciamentoparcela.AsInteger := 1;
            qryCalculoFinanciamentovalorvencto.AsCurrency := LP[i]^.Valor;
            qryCalculoFinanciamentovalorsubstituicao.AsCurrency := LP[i]^.ValorST;
            qryCalculoFinanciamento.Post;
          end
          else
          if (i = 1) or ((lp[i]^.valor <> lp[i-1]^.Valor) or (lp[i]^.ValorST <> lp[i-1]^.ValorST)) then
          begin
            qryCalculoFinanciamento.Append;
            if not ReCalculandoValor then
              qryCalculoFinanciamentoprestacao.AsInteger := LP[i]^.Prestacao
            else
              qryCalculoFinanciamentoprestacao.AsInteger := LP[i]^.Prestacao + i-1;
            qryCalculoFinanciamentoparcela.AsInteger   := LP[i]^.Parcela;
            if i = 1 then
              qryCalculoFinanciamentodatavencto.AsDateTime := LP[i]^.Data
            else
            begin
             { if not ReCalculandoValor then
              begin }
                if qryPlanosPagamentomestrintadias.AsBoolean then
                  qryCalculoFinanciamentodatavencto.AsDateTime := SomarDia(LP[i-1]^.Data,(qryPlanosPagamentointervaloparcelas.AsInteger * (LP[i-1]^.Parcela)),'S')
                else
                  qryCalculoFinanciamentodatavencto.AsDateTime := SomarDia(LP[i-1]^.Data,(qryPlanosPagamentointervaloparcelas.AsInteger * (LP[i-1]^.Parcela)),'N');
             { end
              else
              begin
                if qryPlanosPagamentomestrintadias.AsBoolean then
                  qryCalculoFinanciamentodatavencto.AsDateTime := SomarDia(LP[i]^.Data,(qryPlanosPagamentointervaloparcelas.AsInteger * (i-1)),'S')
                else
                  qryCalculoFinanciamentodatavencto.AsDateTime := SomarDia(LP[i]^.Data,(qryPlanosPagamentointervaloparcelas.AsInteger * (i-1)),'N');
              end; }
            end;
            LP[i]^.Data := qryCalculoFinanciamentodatavencto.AsDateTime;
            qryCalculoFinanciamentovalorvencto.AsCurrency := LP[i]^.Valor;
            qryCalculoFinanciamentovalorsubstituicao.AsCurrency := LP[i]^.ValorST;

            qryCalculoFinanciamentoformapagamento.AsString := LP[i]^.Pagamento;
            qryCalculoFinanciamentotiporecebimento.AsString := LP[i]^.Recebimento;
            qryCalculoFinanciamentotiporeceb.AsString := LP[i]^.DescricaoTipoRecebimento;
            qryCalculoFinanciamentost.AsBoolean := LP[i]^.Substituicao;
            qryCalculoFinanciamento.Post;
          end
          else
          begin
            qryCalculoFinanciamento.Edit;
            qryCalculoFinanciamentoparcela.AsInteger := qryCalculoFinanciamentoparcela.AsInteger +1;
            LP[i]^.Parcela := qryCalculoFinanciamentoparcela.AsInteger;
            qryCalculoFinanciamento.Post;
          end;
        end;
        for i:= low(LP) to X do
          dispose(LP[i])
      end;
    finally
//      qryCalculoFinanciamento.EnableControls;
      FPodeInserir := False;
    end;
(*  end; *)
end;

procedure TdtmCalculoFinanciamento.SetDescontoItem(const Value: Real);
begin
  if FDescontoItem <> Value then begin
    FDescontoItem:= Value;
  end;
end;

procedure TdtmCalculoFinanciamento.qryCalculoFinanciamentoCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryCalculoFinanciamentovalorvenctocomst.ascurrency := qryCalculoFinanciamentovalorvencto.ascurrency +
                                                        qryCalculoFinanciamentovalorsubstituicao.ascurrency;

  if qryTiposRecebimentos.locate('codigo', qryCalculoFinanciamentotiporecebimento.asinteger, []) then
  begin
    qryCalculoFinanciamentonumerorecebimentos.asinteger := qryTiposRecebimentosnumerorecebimentos.asinteger;
    if qryCalculoFinanciamentonumerorecebimentos.asinteger > 0 then
      qryCalculoFinanciamentovalornumerorecebimentos.asFloat := qryCalculoFinanciamentovalorvencto.asFloat /
                                                                 qryCalculoFinanciamentonumerorecebimentos.asinteger
    else
      qryCalculoFinanciamentovalornumerorecebimentos.asFloat := 0;

  end

end;

procedure TdtmCalculoFinanciamento.qryCalculoFinanciamentoAfterOpen(
  DataSet: TDataSet);
begin
  inherited;
;
end;

function TdtmCalculoFinanciamento.GetDataCalculo: String;
begin
  if parsistema.Alterar_a_data_de_abertura_do_contrato then
    result := fDataCalculo
  else
    result := datetostr(dataServidor);
end;

procedure TdtmCalculoFinanciamento.SetarValorFinanciado;
begin
    if ParSistema.CalculoComTodosPlanos then
    begin
      qryPlanosComEntrada.Params[0].AsCurrency := {FValorMercadoria} financiado;
      qryPlanosSemEntrada.Params[0].AsCurrency := {FValorMercadoria} financiado;
    end
    else
      qryConsultaPlanosPagamento.Params[0].AsCurrency := {FValorMercadoria} financiado;

    qryPlanosPagamento.Params[1].AsCurrency := {FValorMercadoria} financiado;
end;

procedure TdtmCalculoFinanciamento.qryPlanosComEntradaCalcFields(
  DataSet: TDataSet);
begin
  inherited;

  if qryPlanosComEntradanumerorecebimentos.asInteger<>0 then
    qryPlanosComEntradavalornumerorecebimentos.asFloat :=
        qryPlanosComEntradavalorparcela.asFloat /
        qryPlanosComEntradanumerorecebimentos.asInteger
  else
    qryPlanosComEntradavalornumerorecebimentos.asFloat := 0;



end;

procedure TdtmCalculoFinanciamento.qryPlanosSemEntradaCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if qryPlanosSemEntradanumerorecebimentos.asInteger <>0 then
    qryPlanosSemEntradavalornumerorecebimentos.asFloat :=
        qryPlanosSemEntradavalorparcela.asFloat /
        qryPlanosSemEntradanumerorecebimentos.asInteger
  else
    qryPlanosSemEntradavalornumerorecebimentos.asFloat := 0;


end;

end.
