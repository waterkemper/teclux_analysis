{$R *.dfm}

constructor TdtmConsultaEnderecos.Create(AOwner: TComponent);
begin
  inherited;
  qryEstados.Tag := ctTabelasConsultaEnderecos;
  qryCidades.Tag := ctTabelasConsultaEnderecos;
  qryBairros.Tag := ctTabelasConsultaEnderecos;
  qryRegioes.Tag := ctTabelasConsultaEnderecos;
  qryRuas.Tag    := ctTabelasConsultaEnderecos;
  qryConsultaTabelaFretes.Tag := ctTabelasConsultaEnderecos;
end;


function TdtmConsultaEnderecos.ExisteBairro(campo, codigo: string): boolean;
begin
  Result := ExisteCodigo(qryBairros, campo, codigo)
end;

function TdtmConsultaEnderecos.ExisteCidade(campo, codigo: string): boolean;
begin
  Result := ExisteCodigo(qryCidades, campo, codigo)
end;

function TdtmConsultaEnderecos.ExisteCidadeBairro(campo, codigo: string; precisao: boolean): boolean;
begin
  Result := ExisteCodigo(qryCidades, campo, codigo, Not Precisao, Not Precisao);
  if Result then
    RefazConsultaBairros
end;

function TdtmConsultaEnderecos.ExisteCidadeRua(campo, codigo: string; precisao: boolean): boolean;
begin
  Result := ExisteCodigo(qryCidades, campo, codigo);
  if Result then
    RefazConsultaRuas
end;

function TdtmConsultaEnderecos.ExisteEstado(campo, codigo: String): boolean;
begin
  Result := ExisteCodigo(qryEstados, campo, codigo)
end;

function TdtmConsultaEnderecos.ExisteEstado(campo, codigo: String; precisao: boolean): boolean;
begin
  Result := ExisteCodigo(qryEstados, campo, codigo, Not precisao, Not Precisao);
  if Result then
    RefazConsultaCidades
end;

function TdtmConsultaEnderecos.ExisteFrete(campo, codigo: string): boolean;
begin
  Result := ExisteCodigo(qryConsultaTabelaFretes, campo, codigo);
end;

function TdtmConsultaEnderecos.ExisteRegiao(campo, codigo: string): boolean;
begin
  Result := ExisteCodigo(qryRegioes, campo, codigo);
end;

function TdtmConsultaEnderecos.ExisteRua(campo, codigo: string): boolean;
begin
//  Result := ExisteCodigo(qryRuas, campo, codigo);
    qryRuas.Sql[14] := ' and (Maiusculo(' + campo + ') ilike Maiusculo(''' + trim(codigo) + '%''))';
    qryRuas.Open;
    Result := qryRuas.RecordCount > 0
end;

function TdtmConsultaEnderecos.GetCEP: String;
begin
  if qryRuascep.AsString <> '' then
    Result := qryRuascep.AsString
  else if qryBairroscep.AsString <> '' then
    Result := qryBairroscep.AsString
  else
    Result := qryCidadescep.AsString
end;

