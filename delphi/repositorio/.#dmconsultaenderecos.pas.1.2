function TdtmConsultaEnderecos.PosicionarBairros(codigo: String): Boolean;
begin
  ExisteCodigo(qryBairros, 'codigo', codigo);
end;

function TdtmConsultaEnderecos.PosicionarCidade(codigo: String): Boolean;
begin
  Result := ExisteCodigo(qryCidades, 'codigo', codigo, False, False);
  if Result then
    RefazConsultaBairros
  else begin
    qryBairros.Params[0].AsString := '';
    qryBairros.Params[1].AsInteger := 0;
    ReFazConsulta(qryBairros, [], [])
  end
end;

function TdtmConsultaEnderecos.PosicionarEstado(codigo: String): Boolean;
begin
  if qryEstados.State = dsInactive then
    qryEstados.Open;
  Result := ExisteCodigo(qryEstados, 'codigo', codigo, False, False);
  if Result then
    RefazConsultaCidades
  else begin
    qryCidades.Params[0].AsString := '';
    ReFazConsulta(qryCidades,[],[])
  end
end;

function TdtmConsultaEnderecos.ProcurarCEP(CEP: Integer): Boolean;
begin
  ReFazConsulta(qryCEP,[0],[CEP]);
  if qryCEP.RecordCount = 0 then
    Result := False
  else begin
    qryRuas.Sql[14] := 'and (r.cep = ' + IntToStr(CEP) + ')';
    RefazConsulta(qryRuas,[0,1],[qryCEPestado.AsString, qryCEPCidade.AsInteger]);
    Result := qryRuas.Locate('cep',CEP,[]);
    if Result then begin
      PosicionarEstado(qryRuasestado.AsString);
      PosicionarCidade(qryRuascidade.AsString)
//      RefazConsultaCidades;
//      RefazConsultaBairros;
    end
  end
end;

procedure TdtmConsultaEnderecos.RefazConsultaBairros;
begin
  if ((qryBairros.ParamByName('estado').AsString <> qryEstadoscodigo.AsString) or
      (qryBairros.ParamByName('cidade').AsInteger <> qryCidadescodigo.AsInteger)) or
      qrybairros.IsEmpty then
    ReFazConsulta(qryBairros,[0,1],[qryEstadoscodigo.AsString, qryCidadescodigo.AsInteger]);
end;

procedure TdtmConsultaEnderecos.RefazConsultaCidades;
begin
  if ((qrycidades.ParamByName('estado').AsString) <> (qryEstadoscodigo.AsString)) or
     qrycidades.IsEmpty then
    ReFazConsulta(qryCidades,[0],[qryEstadoscodigo.AsString]);
end;

procedure TdtmConsultaEnderecos.RefazConsultaRuas;
begin
  qryRuas.Sql[14] := 'and false';
  ReFazConsulta(qryRuas,[0,1],[qryEstadoscodigo.AsString, qryCidadescodigo.AsInteger]);
end;

end.
