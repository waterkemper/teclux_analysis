    Sql.Strings = (
      'Select n.codigo,'
      '       n.fornecedor,'
      '       n.serie,'
      '       n.numero as nrdocumento,'
      '       n.tipofornecedor,'
      '       n.filial,'
      '       n.codigofiscal,'
      '       n.situacao,'
      '       n.codigonatureza,'
      '       n.natureza,'
      '       n.data,'
      '       n.emissao,'
      '       n.estado,'
      
        '      (select pessoatipo from vfornecedores where codigo=n.forne' +
        'cedor and tipo=n.tipofornecedor) as pessoatipo,'
      '       n.cnpj,'
      '       n.inscricaoestadual,'
      '       n.contrato,'
      '       n.valornota,'
      '       n.freteinterno,'
      '       n.desconto,'
      '       n.acrescimo,'
      '       n.seguro,'
      '       n.despesasacessorias,'
      '       n.baseicmssubstituicao,'
      '       n.valoricmssubstituicao,'
      '       n.documentopag,'
      '       n.fornecedorconhecimentofrete,'
      '       n.serieconhecimentofrete,'
      '       n.numeroconhecimentofrete,'
      '       n.valorconhecimentofrete,'
      '       n.icmsconhecimentofrete,'
      '       n.permitirimprimir,'
      '       n.observacoes,'
      '       n.fornecedortransporte,'
      '       n.frete,'
      '/*       n.pesobruto,'
      '       n.pesoliquido,'
      '       n.volumes,'
      '       n.numeracao,'
      '       n.marca,'
      '       n.especietransporte,'
      '*/       n.estadoplaca,'
      '       n.placa,'
      '       n.viatransporte,'
      '       (select d.Evento'
      '        from documentospag d'
      '        where n.documentopag = d.numero) as Evento,'
      
        '       (select dp.irretido from documentospag dp where dp.numero' +
        ' = n.documentopag) as irretido,'
      
        '       (select dp.issretido from documentospag dp where dp.numer' +
        'o = n.documentopag) as issretido,'
      
        '       (select dp.inssretido from documentospag dp where dp.nume' +
        'ro = n.documentopag) as inssretido,'
      
        '       (select dp.pisretido from documentospag dp where dp.numer' +
        'o = n.documentopag) as pisretido,'
      
        '       (select dp.piscofinscsllretido from documentospag dp wher' +
        'e dp.numero = n.documentopag) as piscofinscsllretido,'
      
        '       (select dp.cofinsretido from documentospag dp where dp.nu' +
        'mero = n.documentopag) as cofinsretido,'
      
        '       (select dp.csllretido from documentospag dp where dp.nume' +
        'ro = n.documentopag) as csllretido,'
      '       (select d.referencia'
      '        from documentospag d'
      '        where n.documentopag = d.numero) as referencia,'
      '       cast(0 as numeric(5,2)) as icmsfrete,'
      '       cast(0 as numeric(5,2)) as icmsseguro,'
      ''
      '       (select sum(pn.quantidade * pn.precounitario)'
      '        from produtosnotaspag pn'
      '        where pn.codigonota = n.codigo) as valorprodutos,'
      ''
      '       (select sum(pn.quantidade * pn.precounitario)'
      '        from produtosnotaspag pn'
      
        '        where pn.codigonota = n.codigo) - coalesce(n.desconto,0)' +
        ' + coalesce(n.acrescimo,0) as totalprodutos,'
      ''
      '        n.valoripi,'
      '       (select sum(pn.quantidade)'
      '        from produtosnotaspag pn'
      '        where pn.codigonota = n.codigo) as qtdeprodutos,'
      '        n.ObsLivroEntrada,'
      '        n.valorservicos,'
      '        n.baseicms,'
      '        n.valoricms,'
      '       n.nDI,'
      '       n.VersaoLayout,'
      '       n.ModeloDocto,'
      '       n.CodAleatorio,'
      '       n.FormaPagto,'
      '       n.FormatoDANFE,'
      '       n.FormaEmissao,'
      '       n.DigChaveAcesso,'
      '       n.chv_nfe,'
      '       n.Ambiente,'
      '       n.FinalidadeNF,'
      '       n.ProcEmissao,'
      '       n.VersaoTECLUX,'
      '       n.TotalImportacao,'
      '       n.TotalValorPIS,'
      '       n.TotalValorCOFINS,'
      ''
      '       n.NomeBairro,'
      '       n.NomeCidade,'
      '       n.CidadeIBGE,'
      '       n.pais,'
      '       n.NomePais,'
      ''
      '       n.LocalRetirada_CNPJ,'
      '       n.LocalRetirada_Rua,'
      '       n.LocalRetirada_Numero,'
      '       n.LocalRetirada_Complemento,'
      '       n.LocalRetirada_Bairro,'
      '       n.LocalRetirada_NomeBairro,'
      '       n.LocalRetirada_Cidade,'
      '       n.LocalRetirada_Cep,'
      '       n.LocalRetirada_NomeCidade,'
      '       n.LocalRetirada_CidadeIBGE,'
      '       n.LocalRetirada_estado,'
      ''
      '       n.LocalEntrega_CNPJ,'
      '       n.LocalEntrega_Rua,'
      '       n.LocalEntrega_Numero,'
      '       n.LocalEntrega_Complemento,'
      '       n.LocalEntrega_Bairro,'
      '       n.LocalEntrega_NomeBairro,'
      '       n.LocalEntrega_Cidade,'
      '       n.LocalEntrega_Cep,'
      '       n.LocalEntrega_NomeCidade,'
      '       n.LocalEntrega_CidadeIBGE,'
      '       n.LocalEntrega_estado,'
      ''
      '       n.Transportadora_CNPJ,'
      '       n.Transportadora_IE,'
      '       n.Transportadora_Nome,'
      '       n.Transportadora_Rua,'
      '       n.Transportadora_Bairro,'
      '       n.Transportadora_NomeBairro,'
      '       n.Transportadora_Cidade,'
      '       n.Transportadora_NomeCidade,'
      '       n.Transportadora_CidadeIBGE,'
      '       n.Transportadora_estado,'
      '       n.Transportadora_RNTC,'
      ''
      '       n.nome,'
      '       n.rua,'
      '       n.bairro,'
      '       n.cidade,'
      '       n.cep,'
      '       n.fonenumero,'
      '       n.foneddd,'
      '       n.endnumero,'
      '       n.endcomplemento,'
      '       n.InfComplementar,'
      '       n.numlotenfe,'
      '       n.numrecibonfe,'
      '       n.numprotocolonfe,'
      '       n.numcancelamentonfe,'
      '       n.numinutilizacaonfe,'
      '       '#39#39' as iesubsttributario,'
      '       '#39#39' as suframa,'
      '       n.fornecedorparaiss,'
      '       cast(null as integer) as creditar,'
      ''
      '       n.valorservicos_nt,'
      '       n.valorterceiros,'
      '       n.valorpis,'
      '       n.valorcofins,'
      '       n.datahoraemissao,'
      ''
      '       n.regimetributario,'
      ''
      '       0.00 as valorvista,'
      
        '      (select sum(pnp.vCredICMSSN) from produtosnotaspag pnp whe' +
        're pnp.codigonota = n.codigo) as vCredICMSSN,'
      
        '      (select sum(pnp.vICMSSTRet) from produtosnotaspag pnp wher' +
        'e pnp.codigonota = n.codigo) as vICMSSTRet,'
      ''
      '      n.baseicmscalculada,'
      '      n.valoricmscalculada,'
      '      n.baseicmssubstituicaocalculada,'
      '      n.valoricmssubstituicaocalculada,'
      '      n.valoripicalculada,'
      '      n.valornotacalculada,'
      '      '#39#39' as email,'
      '      false as selecionar,'
      '      n.dhprocnfe,'
      '      n.hSaiEnt'
      ''
      ''
      
        'FROM notaspag n join vfornecedores vf on n.fornecedor = vf.codig' +
        'o and n.tipofornecedor = vf.tipo'
      'WHERE n.modelodocto = '#39'55'#39
      '  AND n.ambiente = :ambiente'
      '  AND n.filial = :filial'
      '  %FORNECEDOR'
      '  %SERIE'
      '  %NUMERO'
      '  %DATA'
      '  %OPERACAO'
      '  %DOCTO'
      ''
      'ORDER BY n.numero')
