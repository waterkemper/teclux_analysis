  object qryProdutosNotasPag: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT pn.codigonota,'
      '       pn.numero,'
      '       p.codigovisual,'
      '       c.icms,'
      '       c.ipi,'
      '       0.00 as aliquotaipioriginal,'
      '       c.grade1,'
      '       c.grade2,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade1) as linha,'
      
        '       (select gr.descricao from grades gr where gr.codigo = c.g' +
        'rade2) as coluna,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '       p.caracteristica,'
      '       c.codigovisual as caracteristicavisual,'
      '       c.descricao as descricaocaracteristica,'
      '       p.preco,'
      '       (pn.precounitario * pn.quantidade) as produtototal,'
      '       c.markup as markup_produto,'
      '       g.markup as markup_grupo,'
      '       g.calcularpreco,'
      '/*       cast(0 as numeric(5,2)) as aliquotapis,'
      '       cast(0 as numeric(5,2)) as aliquotacofins,*/'
      '       cast(0 as numeric(5,2)) as aliquotaicmscalculopreco,'
      '       false as PermitirAtualizar,'
      '       cast(null as Boolean) as PermitirAtualizarDigitado,'
      '       p.codigorecolha,'
      
        '       (select cp.valor from colunasprecos cp where cp.caracteri' +
        'stica = p.caracteristica and cp.preco = p.preco and cp.coluna = ' +
        ':PrecoNormal) as ValorAtual,'
      '       c.composto,'
      '       0.00 as precovenda,'
      '       0.00 as CustoTotal,'
      '       0.00 as CustoParaVenda,'
      '       0.00 as PrecoAtual,'
      '       0.00 as PrecoAtribuido,'
      '       0.00 as PrecoDigitado,'
      '       false as PrecoDigitadoAlterado,'
      '       c.grupo,'
      '       c.classe,'
      
        '       case when g.naoreplicar then true else cl.naoreplicar end' +
        ' as naoreplicar,'
      '       (select n.tipomovimento'
      '        from naturezas n'
      '        where n.codigo = pn.natureza'
      '       ) as tipomovimento,'
      '       (select tm.operacao'
      '        from tiposmovimentos tm, naturezas n'
      '        where tm.codigo = n.tipomovimento'
      '          and n.codigo = pn.natureza'
      '       ) as operacao,'
      '       '#39#39' as localizacao,'
      '       true as produtook,'
      '       pn.*'
      ''
      ''
      
        'from produtosnotaspag pn, produtos p, caracteristicas c, grupos ' +
        'g, classes cl'
      'where (p.codigo = pn.produto)'
      '  and (p.caracteristica = c.codigo)'
      '  and (c.grupo = g.codigo)'
      '  and (c.classe = cl.codigo)'
      '  and (pn.codigonota = :Codigonota)'
      'order by pn.numero')
    RequestLive = True
    Left = 160
    Top = 104
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'PrecoNormal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigonota'
        ParamType = ptUnknown
      end>
