implementation

{$R *.dfm}

{ TdtmControleNotasFiscaisEletronicas }

constructor TdtmControleNotasFiscaisEletronicas.Create(AOwner: TComponent);
begin
  inherited create(AOwner);
//  qryProcurarCFOPPesquisa.Tag := ctTabelas;
  FTipoNotas := 'E';
  ExibirMsgNfe := true;
end;

{
   Funcao que ira atualizar situacao da nota:

     1. verifica se tem protocolo e protocolo de cancelamento
     2. Caso tenha protocolo e nao protocolo de cancelamento, situacao deve ser normal, preencher protocolo e gerar XML
     3. Caso tenha protocolo e protocolo de cancelament, situacao deve ser 'C', preencher protocolo de cancelamento e protocolo, gerar XML nota e XML cancelamento;
}
function TdtmControleNotasFiscaisEletronicas.AtualizaSituacaoNfe(var Tabela: TtecQuery;ChaveNota:String;Nfe:TTecNotaFiscalEletronica;
       regerando: boolean = false):Boolean;
var
  DataHoraProcessamento, MotivoNfe: String;
  retorno : boolean;
begin
  vChave_Nfe :=  ChaveNota;
  Result := False;
  if ((foperacao = 'RI') and (Tabela.FieldByName('numprotocolonfe').AsString = '')) or (foperacao = 'T') or (foperacao = 'CI') or regerando  then
  begin
    retorno := Nfe.ConsultarSituacaoNFe(vChave_Nfe,IntToStr(NFeAmbiente),Protocolo, status, StatusRetConsSitNFe, ProtocoloCancelamento, DataHoraProcessamento, MotivoNFe);
    if regerando then
      result := retorno;
  end;

  if((Tabela.FieldByName('numprotocolonfe').AsString='') and (Protocolo<>'')) then
  begin
    Tabela.Edit;
    Tabela.FieldByName('numprotocolonfe').AsString:=Protocolo;
    Tabela.FieldByName('statusnfe').AsString:=status;


    Tabela.FieldByName('situacao').AsString:='N';
    if (status = '301') or //denegado emitente then
       (status = '302') then // denegado destinatario
      Tabela.FieldByName('situacao').AsString:='D';

    Tabela.Post;

    result := true;

    {Atualizar a chave da nota quando enviada e perdida comunicação ...no caso quando for NFCe e dadofiscalorigem = numero}
    if Tabela.FindField('dadofiscalorigem')<>nil then
      if tabela.FieldByName('numero').asinteger = tabela.FieldByName('dadofiscalorigem').asinteger then
      begin
        tabela.edit;
        tabela.fieldbyname('chv_nfe').asString := ChaveNota;
        tabela.fieldbyname('digchaveacesso').asString := copy(Tabela.FieldByName('chv_nfe').AsString, 44, 1);
        tabela.post;

        result := perpetrar([tabela]);

      end;

  end;


  if((ProtocoloCancelamento<>'') and (Tabela.FieldByName('numcancelamentonfe').AsString='')) then
  begin
    Tabela.Edit;
    Tabela.FieldByName('numcancelamentonfe').AsString:=ProtocoloCancelamento;
    Tabela.FieldByName('situacao').AsString:='C';
    Tabela.Post;

    {Aqui chamar procedimento do objeto para demais procedimentos em um cancelamento}

    //GERA ARQUIVO DE PEDIDO DE CANCELAMENTO NO DIRETORIO DE PROCESSAMENTO
    Nfe.Recuperar_CancelarNfe(ChaveNota,Protocolo,'CANCELADA EMITIDA ERRONEAMENTE',IntToStr(NfeAmbiente),EstadoFilialBaseIBGE, CNPJFilialBase, DataHoraProcessamentoNfe, ProtocoloCancelamento);

   (*

    A Consulta da situação da nota ja esta sendo feita acima

    //COM ESTA CONSULTA DE SITUACAO DE NOTA, O UNINFE GERA O ARQUIVO DE DISTRIBUICAO DE CANCELAMENTO
    Nfe.ConsultarSituacaoNFe(ChaveNota,IntToStr(NfeAmbiente),Protocolo, status, StatusRetConsSitNFe, ProtocoloCancelamento, DataHoraProcessamento, MotivoNfe);

    *)
    //COPIA PARA O DIRETORIO DE COMPARTILHAMENTO (DATA DO CANCELAMENTO).
    Nfe.CompartilharXMLCancelamento(ChaveNota,true,Tabela.FieldByName('datacancelamento').AsDateTime);
    Result:=True;

  end;
end;

function TdtmControleNotasFiscaisEletronicas.EnviarNotasFiscais(NFE_Calculada: String = ''): Boolean;
var
//  NFe: TTecNotaFiscalEletronica;
  NumLote,
  NumRecibo,
  DataHoraProcessamento, MotivoNfe: String;

  CampoData: TDateField;
//  i: Integer;
  vSituacaoNFeAtualizada: Boolean;

  function ChaveNotaCalculada: String;
  var
  vModeloDocto : String;
  begin

    if not tabela.fieldbyname('modelodocto').isnull then
      vModelodocto := tabela.fieldbyname('modelodocto').asString
    else
      vModelodocto := '55';

    result := copy(CodigoCidadeIBGEFilialBase,1,2)+
                         FormatDateTime('YYMM', CampoData.AsDateTime)+

{                         preencheString(CNPJFilialBase,'0',14,false)+}
                         preencheString(Tabela.FieldByName('cnpjfilialemitente').Asstring,'0',14,false)+

                         vModeloDocto +
                         preencheString(Tabela.FieldByName('serie').Asstring,'0',3,false)       +
                         preencheString(Tabela.FieldByName('nrdocumento').Asstring,'0',9,false) +
                         inttostr(NFeTipoEmissao) +
                         preencheString(Tabela.FieldByName('codaleatorio').Asstring,'0',8,false);


    result := result + Modulo11(result);
  end;

  function ChaveNotaCalculadaContingencia: String;
  var
  vModeloDocto : String;
  begin

    if not tabela.fieldbyname('modelodocto').isnull then
      vModelodocto := tabela.fieldbyname('modelodocto').asString
    else
      vModelodocto := '55';

    result := copy(CodigoCidadeIBGEFilialBase,1,2)+
                         FormatDateTime('YYMM', CampoData.AsDateTime)+

{                         preencheString(CNPJFilialBase,'0',14,false)+}
                         preencheString(Tabela.FieldByName('cnpjfilialemitente').Asstring,'0',14,false)+

                         vModeloDocto +
                         preencheString(Tabela.FieldByName('serie').Asstring,'0',3,false)       +
                         preencheString(Tabela.FieldByName('nrdocumento').Asstring,'0',9,false) +
                         Tabela.FieldByName('formaemissao').Asstring +
                         preencheString(Tabela.FieldByName('codaleatorio').Asstring,'0',8,false);


    result := result + Modulo11(result);
  end;



  function ChaveNota: String;
  begin
    if (foperacao = 'RI') then
    begin
      if (Tabela.FieldByName('chv_nfe').asstring <> '') then
        result := Tabela.FieldByName('chv_nfe').asstring
      else
      begin
        if NFE_Calculada<>'' then
          result := NFE_Calculada
        else
          result := ChaveNotaCalculada;
      end;

      if (FTipoNotas = 'S') and
         (copy(result,21,2) = '65') and
         {Diferencial ao enviar e não pegar o retorno}

        (tabela.FieldByName('numero').asinteger =
         tabela.FieldByName('dadofiscalorigem').asinteger) and

        (Tabela.FieldByName('formaemissao').asstring = '9') then

        result := ChaveNotaCalculada;


    end
    else
    begin
      if Tabela.FieldByName('formaemissao').asstring = '9' then
        result := Tabela.FieldByName('chv_nfe').asstring
      else
      begin
        if NFE_Calculada<>'' then
          result := NFE_Calculada
        else
          result := ChaveNotaCalculada;
      end;
    end;
    {
      result := copy(CodigoCidadeIBGEFilialBase,1,2)+
                           FormatDateTime('YYMM', CampoData.AsDateTime)+
                           preencheString(CNPJFilialBase,'0',14,false)+
                           '55'+
                           preencheString(Tabela.FieldByName('serie').Asstring,'0',3,false)       +
                           preencheString(Tabela.FieldByName('nrdocumento').Asstring,'0',9,false) +
                           inttostr(NFeTipoEmissao) +
                           preencheString(Tabela.FieldByName('codaleatorio').Asstring,'0',8,false)+
                           Tabela.FieldByName('digchaveacesso').AsString;
}
  end;

  function CancelarNotasSelecionadas: Boolean;
  begin
    result := true;

    if tabela.fieldbyname('nfpse').asBoolean then
    begin
      CampoData := TDateField(Tabela.FieldByName('data'));
      RefazConsultaPorNome(qryNotas_,['dadofiscal'], [tabela.fieldbyname('numero').asinteger]);
      AtualizaSituacaoNFPSe(Tabela, qryNotas_);


      if ((Tabela.FieldByName('statusnfse').AsString = '0') and
          (ftipoemissaonfeservico = Florianopolis_SoftPlan)) or
         ((Tabela.FieldByName('statusnfse').AsString = '1') and
          (ftipoemissaonfeservico = Palhoca_IPM)) then

      begin
        PreencherPropriedadesNFE(true);

        if NFe.CancelarNFPSe(tabela, qryNotas_, qryServicosDadosFiscais, 'CANCELADA EMITIDA ERRONEAMENTE') then
        begin
          SalvarConteudoxml('S', tabela.fieldbyname('numero').asString, true);
          Tabela.Edit;

          Tabela.FieldByName('statusnfse').AsString := nfe.status_NFPSe;
          Tabela.FieldByName('datacancelamento').Asdatetime := FormatarTimeStamp(NFe.dataCancelamento_NFPSe);

          Tabela.FieldByName('situacao').AsString := 'C';
          Tabela.Post;

          Docxml := nil;
        end
        else
        begin
          Tabela.Edit;
          Tabela.FieldByName('situacao').AsString := 'N';
          Tabela.Post;
        end;
      end;

      Result := Perpetrar([Tabela, qryNotas_]);

      if result then
        if (FTipoNotas='S') and
           ((Tabela.FieldByName('statusnfse').AsString = '1') and
            (ftipoemissaonfeservico = Florianopolis_SoftPlan)) or
           ((Tabela.FieldByName('statusnfse').AsString = '2') and
            (ftipoemissaonfeservico = Palhoca_IPM)) then

          OpNFSaidaAposCancelamento(Tabela);
    end
    else
    begin

      if FTipoNotas = 'E' then
        CampoData := TDateField(Tabela.FieldByName('emissao'))
      else
        CampoData := TDateField(Tabela.FieldByName('data'));

      AtualizaSituacaoNfe(Tabela,ChaveNota,Nfe, true);

      if (Tabela.FieldByName('numcancelamentonfe').AsString='') then
      begin
        if NFe.CancelarNfe(ChaveNota,
                         Tabela.FieldByName('numprotocolonfe').AsString,
                         'CANCELADA EMITIDA ERRONEAMENTE',
                         Tabela.FieldByName('ambiente').AsString,
                         EstadoFilialBaseIBGE, CNPJFilialBase, DataHoraProcessamentoNfe,

                         ProtocoloCancelamento) then
        begin
          if FTipoNotas = 'E' then
            SalvarConteudoxml('E', tabela.fieldbyname('codigo').asString, true)
          else
            SalvarConteudoxml('S', tabela.fieldbyname('numero').asString, true);

          Tabela.Edit;
          Tabela.FieldByName('numcancelamentonfe').AsString := ProtocoloCancelamento;
          Tabela.FieldByName('situacao').AsString := 'C';
          Tabela.Post

          {Aqui chamar procedimento do objeto para demais procedimentos em um cancelamento}

        end
        else
        begin
          Tabela.Edit;
          Tabela.FieldByName('situacao').AsString := 'N';
          Tabela.Post;
        end;
      end;

      Result := Perpetrar([Tabela, qryNotas_]);

      if result then
        if (FTipoNotas='S') and
           ((Tabela.FieldByName('numcancelamentonfe').AsString<>'') or
            (Tabela.FieldByName('numinutilizacaonfe').AsString<>'')) then
          OpNFSaidaAposCancelamento(Tabela);

    end;
  end;

  function InutilizarNotasSelecionadas: Boolean;
  var
    ChaveNotaInutilizar : String;
    vModeloDocto : String;
  begin

    if tabela.fieldbyname('nfpse').asBoolean then
    begin
      Tabela.Edit;
      Tabela.FieldByName('statusnfse').AsString := '3'; {não existe inutilizada na nota de serviço, temos 0 gerada 1 cancelada}
      Tabela.Post;

      Result := Perpetrar([Tabela, qryNotas_]);

      if result then
        if (FTipoNotas='S') and
           (Tabela.FieldByName('statusnfse').AsString='3') then
          OpNFSaidaAposCancelamento(Tabela);

    end
    else
    begin

      if not tabela.fieldbyname('modelodocto').isnull then
        vModelodocto := tabela.fieldbyname('modelodocto').asString
      else
        vModelodocto := '55';

      ChaveNotaInutilizar := EstadoFilialBaseIBGE+
//                       formatdatetime('YY',tabela.fieldbyname('data').AsDateTime)+
                   FormatDateTime('YY',date()) +
                   preencheString(CNPJFilialBase,'0',14,false)+
                   vModelodocto +
                   preencheString(Tabela.FieldByName('serie').Asstring,'0',3,false)       +
                   preencheString(Tabela.FieldByName('nrdocumento').Asstring,'0',9,false) +
                   preencheString(Tabela.FieldByName('nrdocumento').Asstring,'0',9,false);

      if Tabela.FieldByName('chv_nfe').isnull or (not AtualizaSituacaoNfe(Tabela,Tabela.FieldByName('chv_nfe').AsString,Nfe)) then
      begin
        if NFe.InutilizarNFe(ChaveNotaInutilizar,
                             'INUTILIZADA ERRO',
                              inttostr(NFeAmbiente),
                              EstadoFilialBaseIBGE,
                              CNPJFilialBase,
                              Tabela.FieldByName('modelodocto').AsString,
                              Tabela.FieldByName('serie').AsString,
                              Tabela.FieldByName('nrdocumento').AsString,
                              ProtocoloInutilizacao) then
        begin
          if FTipoNotas = 'E' then
            SalvarConteudoxml('E', tabela.fieldbyname('codigo').asString, true)
          else
            SalvarConteudoxml('S', tabela.fieldbyname('numero').asString, true);

          Tabela.Edit;
          Tabela.FieldByName('numinutilizacaonfe').AsString := ProtocoloInutilizacao;
          Tabela.Post;

          {Aqui chamar procedimento do objeto para demais procedimentos em um cancelamento}

          Result := Perpetrar([Tabela, qryNotas_]);

          if result then
            if (FTipoNotas='S') and
               ((Tabela.FieldByName('numcancelamentonfe').AsString<>'') or
                (Tabela.FieldByName('numinutilizacaonfe').AsString<>'')) then
              OpNFSaidaAposCancelamento(Tabela);
        end;
      end;

    end;
  end;


  function GerarNFe(regerando: boolean = false): Boolean;
    var caminhonfcecontingencia, caminhonfceerro: String;

  begin

    ShowProcessando('Gerando o arquivo da NF-e!');
    // EMITENTE
    result := PreencherPropriedadesNFE(regerando);

    if result then
    begin
      if FTipoNotas = 'E' then
      begin


        nfe.Validando := true;
        nfe.CriarListaErro(dtmTecSoft.Database);
        Result := NFe.GerarNFe(Tabela, TabelaReferenciada, qryProdutosNotasPag, nil, nil,
                     qryVenctosNotasPag, qryVolumesNotasPag, qryLacresNotasPag,
                     qryImportacoes, qryAdicoes,
                     ifthen(regerando, tabela.fieldbyname('serie').asString, SerieSugestao_[Tabela.fieldbyname('modelodocto').asString]),
                     FTipoNotas, nil, regerando, nil, nil, Enviar, qryNotas_ );

        if result then
        begin
          nfe.Validando := false;
          Result := NFe.GerarNFe(Tabela, TabelaReferenciada, qryProdutosNotasPag, nil, nil,
                       qryVenctosNotasPag, qryVolumesNotasPag, qryLacresNotasPag,
                       qryImportacoes, qryAdicoes,
                       ifthen(regerando, tabela.fieldbyname('serie').asString, SerieSugestao_[Tabela.fieldbyname('modelodocto').asString]),
                       FTipoNotas, nil, regerando, nil, nil, Enviar, qryNotas_);
        end;
      end
      else
      begin
        {Situação qdo transmitida e perdeu-se a comunicação ..no caso nfce onde dadofiscalorigem = numero ...não pode gerar a nfce de novo...já foi...}
        if (tabela.fieldbyname('dadofiscalorigem').asinteger = tabela.fieldbyname('numero').asinteger) and
            (Tabela.FieldByName('numprotocolonfe').AsString <> '') then
        begin
          result := true;
          {
          caminhonfcecontingencia := StringReplace(FDirEnvio, '\Envio\','\Validar\', [rfReplaceAll, rfIgnoreCase])+'Validado\'+ChaveNotaCalculadaContingencia+'-nfe';
          caminhonfceerro := FDirErro + '\' + ChaveNotaCalculadaContingencia + '-nfe';

          result := FileExists(caminhonfcecontingencia);
          if result then
            CopyFileTo(caminhonfcecontingencia, caminhonfceerro)
            }

        end
        else
        begin
          nfe.Validando := true;

          result := true;
          if tabela.fieldbyname('nfpse').asBoolean then
            if (ftipoemissaonfeservico in [Florianopolis_SoftPlan {, Palhoca_IPM}]) then
              result := ValidarAliquotaGrade(tabela, qryServicosDadosFiscais);

          if result then
          begin
            nfe.CriarListaErro(dtmTecSoft.Database);
            Result := NFe.GerarNFe(Tabela, TabelaReferenciada, qryProdutosDadosFiscais,
                       qryProdutosDadosFiscaisCompostos, qryServicosDadosFiscais,
                       qryVenctosDadosFiscais, qryVolumesDadosFiscais,
                       qryLacresDadosFiscais, nil, nil,
                       ifthen(regerando, tabela.fieldbyname('serie').asString, SerieSugestao_[Tabela.fieldbyname('modelodocto').asString]),
                       FTipoNotas, qrycupons, regerando, nil, TotaisRecebimentos, Enviar, qryNotas_, qryImpostosRetidosDadosFiscais);
          end;

          if result then
          begin
            nfe.Validando := false;
            Result := NFe.GerarNFe(Tabela, TabelaReferenciada, qryProdutosDadosFiscais,
                         qryProdutosDadosFiscaisCompostos, qryServicosDadosFiscais,
                         qryVenctosDadosFiscais, qryVolumesDadosFiscais,
                         qryLacresDadosFiscais, nil, nil,
                         ifthen(regerando, tabela.fieldbyname('serie').asString, SerieSugestao_[Tabela.fieldbyname('modelodocto').asString]),
                         FTipoNotas, qrycupons, regerando, nil, TotaisRecebimentos, Enviar, qryNotas_, qryImpostosRetidosDadosFiscais)
          end;
        end;
      end;
    end;

    sleep(500);
    ShowProcessando
  end;

  function EnviarNFe: Boolean;
  begin
    ShowProcessando('Verificando status do serviço NF-e!');
    sleep(500);
    if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
    begin

      if tabela.FieldByName('modelodocto').asString = '65' then
      begin
        ShowProcessando;
        ShowProcessando('Processando o arquivo de envio da NF-e!');
        sleep(500);
        Result := NFe.EnviarNFCe(ChaveNota, NumLote, NumRecibo, protocolo, status, xMotivo, DataHoraProcessamento, false )=ArquivosRetornados;
        if Result then
        begin
          Tabela.Edit;
          Tabela.FieldByName('numlotenfe').AsString   := NumLote;
          Tabela.FieldByName('numrecibonfe').AsString := NumRecibo;
          Tabela.FieldByName('numprotocolonfe').AsString:=Protocolo;
          Tabela.FieldByName('dhprocnfe').AsDateTime:=FormatarTimeStamp(DataHoraProcessamento);


  //        Tabela.Post;
        end;

      end
      else
      begin

        ShowProcessando;
        ShowProcessando('Processando o arquivo de envio da NF-e!');
        sleep(500);
        Result := NFe.EnviarNFe(ChaveNota, NumLote, NumRecibo);
        if Result then
        begin
          Tabela.Edit;
          Tabela.FieldByName('numlotenfe').AsString   := NumLote;
          Tabela.FieldByName('numrecibonfe').AsString := NumRecibo;
  //        Tabela.Post;
        end;
      end;

    end;
    ShowProcessando
  end;

  function ConsultarLote(SomenteRetorno: Boolean): Boolean;
  begin
    ShowProcessando('Consultando o arquivo de retorno da NF-e!');
    sleep(500);
    Result := NFe.ConsultarSituacaoLote(Tabela.FieldByName('numrecibonfe').AsString,
                                        Protocolo, status, DataHoraProcessamento, IntToStr(NFeAmbiente), SomenteRetorno);
    if Result then
    begin
      Tabela.Edit;
      Tabela.FieldByName('numprotocolonfe').AsString:=Protocolo;
      Tabela.FieldByName('dhprocnfe').AsDateTime:=FormatarTimeStamp(DataHoraProcessamento);
//      Tabela.Post;
    end;
    ShowProcessando
  end;

  function CompartilharXML(Recuperando_XML: Boolean; Esperar: boolean = false): Boolean;
  begin
    sleep(500);
    if(Recuperando_Xml) then
    begin
      ShowProcessando('Gerando o arquivo de compartilhamento da NF-e! Recuperando_XML');
      if tabela.fieldbyname('dadofiscalorigem').asinteger =
         tabela.fieldbyname('numero').asinteger then

        Result := NFe.CompartilharXML_Recuperado(ChaveNotaCalculadaContingencia,
                                    Tabela.FieldByName('numrecibonfe').AsString,
                                    Tabela.FieldByName('filial').AsString,
                                    Tabela.FieldByName('serie').AsString,
                                    Tabela.FieldByName('nrdocumento').AsString,
                                    CampoData.AsDateTime, Esperar,
                                    Tabela.FieldByName('numprotocolonfe').AsString)
      else
        Result := NFe.CompartilharXML_Recuperado(ChaveNota,
                                    Tabela.FieldByName('numrecibonfe').AsString,
                                    Tabela.FieldByName('filial').AsString,
                                    Tabela.FieldByName('serie').AsString,
                                    Tabela.FieldByName('nrdocumento').AsString,
                                    CampoData.AsDateTime, Esperar,
                                    Tabela.FieldByName('numprotocolonfe').AsString);
    end
    else
    begin
        ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
        Result := NFe.CompartilharXML(ChaveNota,
                                  Tabela.FieldByName('numrecibonfe').AsString,
                                  Tabela.FieldByName('filial').AsString,
                                  Tabela.FieldByName('serie').AsString,
                                  Tabela.FieldByName('nrdocumento').AsString,
                                  CampoData.AsDateTime,
                                  Tabela.FieldByName('numlotenfe').AsString);

    end;

    if result then
    begin
      if FTipoNotas = 'E' then
        SalvarConteudoxml('E', tabela.fieldbyname('codigo').asString)
      else
        SalvarConteudoxml('S', tabela.fieldbyname('numero').asString)
    end;

    ShowProcessando
  end;

  procedure EnviarEmail;
  var
   vListaNFeEmailValidos : String;
  begin

    vListaNFeEmailValidos := '';
    if FTipoNotas = 'S' then
      ListaStringEmailValido(ListadeEmails('DF', qryDadosFiscais.fieldbyname('numero').AsInteger), vListaNFeEmailValidos, true)
    else
      ListaStringEmailValido(Tabela.FieldByName('email').AsString, vListaNFeEmailValidos, true);

    if (vListaNFeEmailValidos <> '')      and
       (UsuarioLogin.PortaSmtp               <> '')      and
       (UsuarioLogin.HostSmtp                <> '')      and
       (UsuarioLogin.Email                   <> '')      and
       (UsuarioLogin.SenhaEmail              <> '')    then
    begin
      ShowProcessando('Enviando email para o cliente');
      sleep(500);
      try
        if not NFe.EnviarEmail(UsuarioLogin.Email,
        vListaNFeEmailValidos,
        Tabela.FieldByName('nrdocumento').AsString,
        Tabela.FieldByName('serie').AsString,
        Tabela.FieldByName('filial').AsString,
        '',
        NomeFilialBase, RazaoFilialBase, CNPJFilialBase, DDDFilialBase, FoneFilialBase,
        DDDFaxFilialBase, FaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
        UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
        CampoData.AsDateTime, Tabela.FieldByName('valortotal').AsCurrency,
        UsuarioLogin.AutenticarSMTP, CampoData.AsDateTime) then
        if Exibirmsgnfe then
          MensagemAviso('Ocorreu um erro inesperado no envio do email');

	    finally
		    ShowProcessando;
	    end;
    end;
  end;

  procedure EnviarEmailNFPSe;
  var
   vListaNFeEmailValidos : String;
  begin
    ShowProcessando;

    vListaNFeEmailValidos := '';
    ListaStringEmailValido(ListadeEmails('DF', qryDadosFiscais.fieldbyname('numero').AsInteger), vListaNFeEmailValidos, true);

    if (vListaNFeEmailValidos <> '')      and
       (UsuarioLogin.PortaSmtp        <> '')      and
       (UsuarioLogin.HostSmtp         <> '')      and
       (UsuarioLogin.Email            <> '')      and
       (UsuarioLogin.SenhaEmail       <> '')     then
    begin
      ShowProcessando('Enviando email para o cliente');
      try
        if not NFe.EnviarEmail(UsuarioLogin.Email, vListaNFeEmailValidos,
                            qryNotas_.FieldByName('numero').AsString, qryNotas_.fieldbyname('serie').AsString, IntToStr(fFilialBase), '',
                            fNomeFilialBase, fRazaoFilialBase, fCNPJFilialBase, fDDDFilialBase, fFoneFilialBase,
                            fDDDFaxFilialBase, fFaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMTP,
                            UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
                            qryDadosFiscais.fieldbyname('data').AsDateTime, qryDadosFiscais.fieldbyname('valortotal').AsCurrency,
                            UsuarioLogin.AutenticarSMTP, qryDadosFiscais.fieldbyname('data').AsDateTime, nil, false, false, true) then
              MensagemAviso('Ocorreu um erro inesperado no envio do email')
      finally
            ShowProcessando;
      end;
    end;

  end;

  function ImprimirNFPSe: boolean;
  var
    vArquivo: String;
  begin
    result := false;
    ShowProcessando('Imprimindo o DANFE!');
    sleep(500);

    vArquivo := NFE.ArqRetornoNFSe(qryDadosFiscais, qryNotas_);

    if not FileExists(vArquivo) then
      RecuperarArquivoxml('S', qryDadosFiscais.fieldbyname('numero').asString, vArquivo);


    result := ImprimirNotafiscalServico_(qryDadosFiscais.fieldbyname('numero').asInteger, vArquivo);

    if result and (FOperacao = 'T') then
      EnviarEmailNFPSe;

    ShowProcessando
  end;


  function ImprimirDanfe(contingencia: Boolean = false): boolean;
  var
    Produtos: TtecQuery;
  begin
    result := false;
    ShowProcessando('Imprimindo o DANFE!');
    sleep(500);
    if FTipoNotas = 'E' then
    begin
      if qryProdutosnotaspag.isempty then
        RefazConsultaPorNome(qryProdutosNotasPag,['codigonota'],  [Tabela.FieldByName('codigo').AsInteger]);
      Produtos := qryProdutosNotasPag;
    end
    else
    begin
      if qryProdutosDadosFiscais.isempty then
        RefazConsultaPorNome(qryProdutosDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
      Produtos := qryProdutosDadosFiscais;
    end;

//    if FOperacao = 'T' then
//      ImpressoraDanfe := ParSistema.NomeImpressoraNotaMercadorias;

     if contingencia then {hoje somente para nfce}
     begin
       NFe.fChaveNFe := Tabela.FieldByName('chv_nfe').asString;

       NFe.ImprimirDanfe({ChaveAcesso+qryDadosFiscaisdigchaveacesso.AsString,}
                          Tabela.FieldByName('filial').AsString,
                          Tabela.FieldByName('serie').AsString,
                          Tabela.FieldByName('nrdocumento').AsString,
                          Tabela.FieldByName('localentrega_cep').AsString,
                          Tabela.FieldByName('email').AsString,
                          IntToStr(NFeNVias), NFeLogotipoDANFE,
                          ParSistema.NomeImpressoraNotaMercadorias, NFeVisualizarDANFE,
                          CampoData.AsDateTime,
                          Produtos, NFeExecDANFE, Assinar, 'S',
                          0, false, tabela.FieldByName('modelodocto').asString);
     end
     else
      result := NFe.ImprimirDanfe({ChaveNota,}
                        Tabela.FieldByName('filial').AsString,
                        Tabela.FieldByName('serie').AsString,
                        Tabela.FieldByName('nrdocumento').AsString,
                        Tabela.FieldByName('localentrega_cep').AsString,
                        Tabela.FieldByName('email').AsString,
                        IntToStr(NFeNVias), NFeLogotipoDANFE,
                        ImpressoraDanfe, NFeVisualizarDANFE,
                        CampoData.AsDateTime,
                        Produtos, NFeExecDANFE,
                        Enviar,
                        FTipoNotas,
                        0, false, tabela.FieldByName('modelodocto').asString);

    if result and (FOperacao = 'T') then
      EnviarEmail;

    ShowProcessando
  end;

  procedure ConsultaSituacaoNotaFiscal;
  begin
      {
        Consultar a situaçao da nota antes;
        Verificar se tem numero de protocolo, numero de inutilizacao e numero de cancelamento
        Setar numrecibo,numlote,numprotocolonfe,numinutilizacaonfe e numcancelamentonfe
        Caso numcancelamentofe e numinutilizacaonfe setados, tem que mudar situacao da nota para C e alimentar estes campos
        Fazer o download do XML caso exista
      }
//      NFE.ConsultarSituacaoNFe(ChaveNota,IntToStr(NFeAmbiente));
  end;


  procedure AtribuirDadosTabela;
  var
    vt: integer;

    function ContigenciaScanNFCe: Boolean;
    begin
      result := (Tabela.FieldByName('formaemissao').asstring='9') and (Tabela.FieldByName('modelodocto').asstring='65');
    end;  
      
  begin
    Tabela.Edit;

    if (Tabela.FieldByName('nrdocumento').AsString='') or
       (Tabela.FieldByName('nrdocumento').Asinteger=0)  then
      Tabela.FieldByName('nrdocumento').AsString := Tabela.FieldByName('numeronota').AsString;

    if (Tabela.FieldByName('modelodocto').AsString='') then
      Tabela.FieldByName('modelodocto').AsString := '55';

    if tabela.fieldbyname('versaoteclux').isnull then
      tabela.fieldbyname('versaoteclux').AsString   := VersaoTecLUX;

    if tabela.Name = 'qryDadosFiscais' then
      MontarInfComplementar(tabela);


    if Tabela.FieldByName('nfpse').AsBoolean then
    begin
      if (Tabela.FieldByName('ambientenfs').AsString='') or ((FOperacao='T') and not ContigenciaScanNFCe) then
        Tabela.FieldByName('ambientenfs').Asinteger := NFSeAmbiente;
    end
    else
    begin

      if (Tabela.FieldByName('codaleatorio').Asinteger=0) or ((FOperacao='T') and not ContigenciaScanNFCe) then
        Tabela.FieldByName('codaleatorio').Asinteger := Aleatorio( CampoData.AsDateTime,  Tabela.FieldByName('nrdocumento').asString);

      if (Tabela.FieldByName('chv_nfe').AsString='') or ((FOperacao='T') and not ContigenciaScanNFCe) then
      begin
        Tabela.FieldByName('chv_nfe').AsString:=ChaveNota;
        vchave_nfe := ChaveNota;
      end;

      if (Tabela.FieldByName('ambiente').AsString='') or ((FOperacao='T') and not ContigenciaScanNFCe) then
        Tabela.FieldByName('ambiente').Asinteger := NFeAmbiente;

      if (Tabela.FieldByName('formaemissao').AsString = '') or ((FOperacao='T') and not ContigenciaScanNFCe) then
        Tabela.FieldByName('formaemissao').AsInteger := NFeTipoEmissao;

      if (Tabela.FieldByName('digchaveacesso').asstring = '') or ((FOperacao='T') and not ContigenciaScanNFCe) then
        Tabela.FieldByName('digchaveacesso').asstring := copy(Tabela.FieldByName('chv_nfe').AsString, 44, 1);

      if tabela.fieldbyname('versaolayout').isnull  then
        tabela.fieldbyname('versaolayout').AsCurrency := 3.10;

      { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
      if tabela.fieldbyname('formapagto').isnull then
        tabela.fieldbyname('formapagto').AsInteger    := 2;

      { 1-Retrato/ 2-Paisagem }
      if tabela.fieldbyname('formatodanfe').isnull then
        tabela.fieldbyname('formatodanfe').AsInteger  := 1;

      {1-Normal/ 2-Contingência}
      if tabela.fieldbyname('finalidadenf').isnull then
        tabela.fieldbyname('finalidadenf').AsInteger  := 1;

      if tabela.fieldbyname('procemissao').isnull then
        tabela.fieldbyname('procemissao').AsString    := '0';

    end;

//    Tabela.post;
  end;

  procedure AtualizarDataVencto;
  begin
    if FTipoNotas = 'E' then
    begin
      RefazConsultaPorNome(qryVenctosNotasPag, ['documentopag'],[Tabela.FieldByName('documentopag').AsInteger]);
      qryVenctosNotasPag.first;
      while not qryVenctosNotasPag.Eof do
      begin
        if qryVenctosNotasPag.fieldbyname('datavencto').asDateTime < DataServidor then
        begin
          qryVenctosNotasPag.edit;
          qryVenctosNotasPag.fieldbyname('datavencto').asDateTime := DataServidor;
          qryVenctosNotasPag.post;
        end;
        qryVenctosNotasPag.Next;
      end;
      perpetrar([qryVenctosNotasPag]);
    end
    else
    begin
      RefazConsultaPorNome(qryVenctosDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
      qryVenctosDadosFiscais.first;
      while not qryVenctosDadosFiscais.Eof do
      begin
        if qryVenctosDadosFiscais.fieldbyname('datavencto').asDateTime < DataServidor then
        begin
          qryVenctosDadosFiscais.edit;
          qryVenctosDadosFiscais.fieldbyname('datavencto').asDateTime := DataServidor;
          qryVenctosDadosFiscais.post;
        end;
        qryVenctosDadosFiscais.Next;
      end;
      perpetrar([qryVenctosDadosFiscais]);
    end;
  end;

begin
  Result := True;
  NFe := TTecNotaFiscalEletronica.Create;
  nfe.ExibirMsgNfe := self.ExibirMsgNfe;

  nfe.codigoVerificacao_NFPSe := '';
  nfe.numeroSerie_NFPSe := '';
  nfe.status_NFPSe := '';
  nfe.DataHoraProcessamento_NFPSe := '';
  nfe.link_nfse := '';
  nfe.DataEmissao_NFPSe := '';
  nfe.dataCancelamento_NFPSe := '';


  {
  NFe.DiretorioEnvio       := fNFeDirEnvio;
  NFe.DiretorioEnviado     := fNFeDirEnviados;
  NFe.DiretorioRetorno     := fNFeDirRetorno;
  NFe.DiretorioCompartilha := fNfeDirCompartilha;
  nfe.DiretorioErros       := fNfeDirErros;
  NFe.Executavel           := fNFeExecNFe;
  }

  Protocolo := '';
  ProtocoloCancelamento := '';
  ProtocoloInutilizacao := '';

  if FTipoNotas = 'E' then
  begin
    Tabela := qryNotasPag;
    TabelaProdutos := qryProdutosNotasPag;
    CampoData   := TDateField(Tabela.FieldByName('emissao'))
  end
  else
  begin
    Tabela := qryDadosFiscais;
    TabelaProdutos := qryProdutosDadosFiscais;
    TabelaServicos := qryServicosDadosFiscais;
    CampoData := TDateField(Tabela.FieldByName('data'));
  end;

  if FOperacao = 'CC' then //Confirmar Cancelamento/Inutilização
     OpNFSaidaAposCancelamento(Tabela)
  else
  if FOperacao = 'RI' then //recuperar e imprimir
  begin

    try

      vchave_nfe := '';
      status := '';
      StatusRetConsSitNFe := '';

      vSituacaoNFeAtualizada := false;

      AtribuirDadosTabela;

      if Tabela.FieldByName('nfpse').AsBoolean then
      begin
        RefazConsultaPorNome(qryNotas_,['dadofiscal'], [tabela.fieldbyname('numero').asinteger]);

//        if (Tabela.FieldByName('numprotocolonfse').AsString = '') then { A situação da NF não será atualizada se for cancelada diretamente no site}
        begin
          result := AtualizaSituacaoNFPSe(Tabela, qryNotas_);

          vSituacaoNFeAtualizada := result;
          if result then
            if (FTipoNotas='S') and ( ((Tabela.FieldByName('statusnfse').AsString='1') and
                                       (ftipoemissaonfeservico = Florianopolis_SoftPlan))

                                      or

                                      ((Tabela.FieldByName('statusnfse').AsString='2') and
                                       (ftipoemissaonfeservico = Palhoca_IPM))
                                     ) then //cancelado
              OpNFSaidaAposCancelamento(Tabela);
        end;

        if Tabela.FieldByName('numprotocolonfse').AsString = '' then
        begin
           FOperacao := 'T';
           result := EnviarNotasFiscais;
           FOperacao := 'RI';
        end
        else
        if ((Tabela.FieldByName('statusnfse').AsString = '0') and (ftipoemissaonfeservico = Florianopolis_SoftPlan)) or
           ((Tabela.FieldByName('statusnfse').AsString = '1') and (ftipoemissaonfeservico = Palhoca_IPM)) then
            ImprimirNFPSe;

        Docxml := nil;

      end
      else
      begin
        if (Tabela.FieldByName('numprotocolonfe').AsString = '') then
        begin
          result := AtualizaSituacaoNfe(Tabela,ChaveNota,Nfe);
          vSituacaoNFeAtualizada := true;

          if (FTipoNotas='S') and
             ((Tabela.FieldByName('numcancelamentonfe').AsString<>'') or
              (Tabela.FieldByName('numinutilizacaonfe').AsString<>'')) then
            OpNFSaidaAposCancelamento(Tabela);
        end;

        {NÃO PODE TRANSMITIR NFE COM FILIALEMISSAO QUE NÃO SEJA A PRÓPRIA}
        if Tabela.FieldByName('numprotocolonfe').AsString = '' then
        begin
           FOperacao := 'T';
           result := EnviarNotasFiscais(NFE_Calculada);
           FOperacao := 'RI';


       //   MensagemAviso('O número do protocolo não foi recuperado. Utilize a funcionalidade em ''Estoque - Controle de Notas Fiscais Eletônicas''')
        end
        else if (Tabela.FieldByName('statusnfe').AsString = '301') or
                (Tabela.FieldByName('statusnfe').AsString = '302') then
        begin
          if ExibirMsgNFe then
            MensagemAviso('Nota fiscal em uso denegado.');

          if not CompartilharXML(true) then
          begin
             GerarNFe(true);
             vChave_Nfe := ChaveNota;
             nfe.ConsultarSituacaoNFe(vChave_Nfe, IntToStr(NFeAmbiente),Protocolo, status, StatusRetConsSitNFe, ProtocoloCancelamento, DataHoraProcessamento, MotivoNfe);
             CompartilharXML(true, true);
          end;
        end
        else
        if (Tabela.FieldByName('numcancelamentonfe').AsString = '') and
           not ImprimirDanfe then
        begin
          if not vSituacaoNFeAtualizada then
            AtualizaSituacaoNfe(Tabela,ChaveNota,Nfe, True);

          if not CompartilharXML(true) then
          begin
            IF Gerarnfe(true) then {Aqui é colocado na pasta de envio e uninfe processa colocando em processamento ou na pasta erro , capturar destas pastas e colocar na pasta de processamento}
              CompartilharXML(true, true);
          end;
          ImprimirDanfe;
        end;
      end;

      if result then
      begin
        if tabela.State = dsedit then
          tabela.Post;
      end
      else
      begin
        if tabela.State = dsedit then
          tabela.cancel;
      end;

    finally

      if vSituacaoNFeAtualizada then
        Perpetrar([Tabela, qryNotas_])
      else
        Perpetrar([Tabela,TabelaProdutos, qryNotas_]);
    end;

  end
  else
  begin
    if Tabela.FieldByName('nfpse').AsBoolean then
    begin

      if FOperacao = 'C' then
      begin
        ShowProcessando;
        ShowProcessando('Cancelando NF-e');
        sleep(500);
        RefazConsultaPorNome(qryNotas_, ['dadofiscal'], [tabela.fieldbyname('numero').asinteger]);
        Result := CancelarNotasSelecionadas;
        ShowProcessando;
      end
      else
      if FOperacao = 'I' then
      begin
        ShowProcessando;
        ShowProcessando('Inutilizando NF-e');
        sleep(500);
        Result := InutilizarNotasSelecionadas;
        ShowProcessando;
      end
      else
      if FOperacao = 'CI' then
      begin
        ShowProcessando;

        Protocolo := '';
        ProtocoloCancelamento := '';
        ProtocoloInutilizacao := '';
        vchave_nfe := '';
        status := '';
        StatusRetConsSitNFe := '';

        vSituacaoNFeAtualizada := false;

        if (Tabela.FieldByName('numprotocolonfse').AsString = '') then
        begin
          RefazConsultaPorNome(qryNotas_, ['dadofiscal'], [tabela.fieldbyname('numero').asinteger]);

          result := AtualizaSituacaoNFPSe(Tabela, qryNotas_);
          vSituacaoNFeAtualizada := true;

          if ftipoemissaonfeservico = Palhoca_IPM then
            if (Tabela.FieldByName('numprotocolonfse').AsString = '') then
            begin
               FOperacao := 'TPCI';  //transmitir para cancelar ou inutilizar,
                                   //neste caso deverá haver uma tentativa de envio de nota pois a consulta
                                   //se dá apenas pelo protocolo e não pelo identifador qryDadosFiscaisNumero
               result := EnviarNotasFiscais;
               FOperacao := 'CI';
            end;
        end;

        if Tabela.FieldByName('numprotocolonfse').AsString = '' then
        begin
          ShowProcessando('Inutilizando NFPS-e');
          sleep(500);
          Result := InutilizarNotasSelecionadas;
          ShowProcessando;
        end
        else
        if ((Tabela.FieldByName('statusnfse').AsString = '0') and
            (ftipoemissaonfeservico = Florianopolis_SoftPlan)) or
           ((Tabela.FieldByName('statusnfse').AsString = '1') and
            (ftipoemissaonfeservico = Palhoca_IPM)) then
        begin
          ShowProcessando;
          ShowProcessando('Cancelando NFPS-e');
          sleep(500);
          Result := CancelarNotasSelecionadas;
          ShowProcessando;
        end;

        Docxml := nil;

      end
      else
      if FOperacao = 'TPCI'  then  //transmitir para cancelar ou inutilizar,
      begin

        ShowProcessando;
        try

          Tabela.edit;
          Tabela.FieldByName('data').asDateTime := DataServidor;
          AtribuirDadosTabela;
//          AtualizarDataVencto;
          AbrirTabelasDiversas;

          result := GerarNotaEletronica(Tabela, nil, nil, nil, qryServicosDadosFiscais, nil, nil, nil, nil, nil, nil,
                        '', 'S',  nil, false, nil, nil, Enviar, true, nil, qrynotas_, nil, true); {olhe o último parametrozinho hehehehe}

                        {


          A grande charada: descobriu-se que ao enviar  uma nfse_teste junto com o identificador é o suficiente para pegar o protocolo,
          se não retornar nada é porque não foi enviada....



          if result then
            result := GerarNotaEletronica(Tabela, nil, nil, nil, qryServicosDadosFiscais, nil, nil, nil, nil, nil,
                          '', 'S',  nil, false, nil, nil, Enviar, false, nil, qrynotas_, nil);

                          }

          if result then
          begin
            if tabela.State = dsedit then
              tabela.Post;
          end
          else
          begin
            if tabela.State = dsedit then
              tabela.cancel;
          end;

        finally
          Perpetrar([Tabela, TabelaProdutos, qryNotas_]);
          Docxml := nil;
        end;


      end
      else  { T - Transmitir }
      begin

        ShowProcessando;
        try

          Tabela.edit;
          Tabela.FieldByName('data').asDateTime := DataServidor;
          AtribuirDadosTabela;
          AtualizarDataVencto;
          AbrirTabelasDiversas;
          if FOperacao = 'T' then
          begin

            result := GerarNotaEletronica(Tabela, nil, nil, nil, qryServicosDadosFiscais, nil, nil, nil, nil, nil, nil,
                          '', 'S',  nil, false, nil, nil, Enviar, true, nil, qrynotas_, nil);

            if result then
            begin

              result := GerarNotaEletronica(Tabela, nil, nil, nil, qryServicosDadosFiscais, nil, nil, nil, nil, nil, nil,
                            '', 'S',  nil, false, nil, nil, Enviar, false, nil, qrynotas_, nil);

              if result and (Tabela.FieldByName('numprotocolonfe').AsString <> '') then
              begin

                if ((Tabela.FieldByName('statusnfse').AsString = '0') and (ftipoemissaonfeservico = Florianopolis_SoftPlan)) or
                   ((Tabela.FieldByName('statusnfse').AsString = '1') and (ftipoemissaonfeservico = Palhoca_IPM)) then
                  ImprimirNFPSe;


                if ((Tabela.FieldByName('statusnfse').AsString='1') and (ftipoemissaonfeservico = Florianopolis_SoftPlan)) or
                   ((Tabela.FieldByName('statusnfse').AsString='2') and (ftipoemissaonfeservico = Palhoca_IPM)) then //cancelado
                  OpNFSaidaAposCancelamento(Tabela);

              end;

            end;
          end;

          if result then
          begin
            if tabela.State = dsedit then
              tabela.Post;
          end
          else
          begin
            if tabela.State = dsedit then
              tabela.cancel;
          end;

        finally
          Perpetrar([Tabela, TabelaProdutos, qryNotas_]);
          Docxml := nil;
        end;
      end;

    end
    else
    begin

      ShowProcessando('Verificando status do serviço NF-e!');
      sleep(500);
      if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
      begin

        if FOperacao = 'C' then
        begin
          ShowProcessando;
          ShowProcessando('Cancelando NF-e');
          sleep(500);
          Result := CancelarNotasSelecionadas;
          ShowProcessando;
        end
        else
        if FOperacao = 'I' then
        begin
          ShowProcessando;
          ShowProcessando('Inutilizando NF-e');
          sleep(500);
          Result := InutilizarNotasSelecionadas;
          ShowProcessando;
        end
        else
        if FOperacao = 'CI' then
        begin
          ShowProcessando;

          Protocolo := '';
          ProtocoloCancelamento := '';
          ProtocoloInutilizacao := '';
          vchave_nfe := '';
          status := '';
          StatusRetConsSitNFe := '';

          vSituacaoNFeAtualizada := false;

          AtribuirDadosTabela;

          if (Tabela.FieldByName('numprotocolonfe').AsString = '') then
          begin
            AtualizaSituacaoNfe(Tabela,ChaveNota,Nfe);
            vSituacaoNFeAtualizada := true;
          end;

          if Tabela.FieldByName('numprotocolonfe').AsString = '' then
          begin
            ShowProcessando('Inutilizando NF-e');
            sleep(500);
            Result := InutilizarNotasSelecionadas;
            ShowProcessando;
          end
          else
          if Tabela.FieldByName('numcancelamentonfe').AsString = '' then
          begin
            ShowProcessando;
            ShowProcessando('Cancelando NF-e');
            sleep(500);
            Result := CancelarNotasSelecionadas;
            ShowProcessando;
          end;

        end
        else  { T - Transmitir }
        begin
          ShowProcessando;
          try

            Protocolo := '';
            ProtocoloCancelamento := '';
            ProtocoloInutilizacao := '';
            vchave_nfe := '';
            status := '';

            if Tabela.FieldByName('formaemissao').asString <> '9' then   //ver forma mais generica para contigencia
            begin
              if FTipoNotas = 'E' then
              begin
                Tabela.Edit;
                Tabela.FieldByName('emissao').asDateTime := DataServidor;
              end
              else
              begin
                Tabela.edit;
                Tabela.FieldByName('data').asDateTime := DataServidor;
              end;
            end;

            AtribuirDadosTabela;
            AtualizarDataVencto;

            if FOperacao = 'T' then
            begin
              result := GerarNFe;

              if result then
              begin


                result := EnviarNFe;


                if Result and (tabela.fieldbyname('modelodocto').asString <> '65') then
                  result := ConsultarLote(false);

                if result Then
                  CompartilharXML(false);

                if result and (Tabela.FieldByName('numprotocolonfe').AsString <> '') then
                  ImprimirDanfe
                else
                  if {vSituacaoNFeAtualizada and}
                    (Tabela.FieldByName('numprotocolonfe').AsString = '') and
                    (Tabela.FieldByName('modelodocto').AsString = '65') and  //nfce
                    (Tabela.FieldByName('formaemissao').AsString = '9') then //contigencia
                    ImprimirDanfe(true);



              end;
            end;

            if result then
            begin
              if tabela.State = dsedit then
                tabela.Post;
            end
            else
            begin
              if tabela.State = dsedit then
                tabela.cancel;
            end;

          finally
            Perpetrar([Tabela, TabelaProdutos, qryNotas_]);
          end;
        end;
      end
      else
      if {vSituacaoNFeAtualizada and}
          (FOperacao = 'T') and
          (Tabela.FieldByName('numprotocolonfe').AsString = '') and
          (Tabela.FieldByName('modelodocto').AsString = '65') and  //nfce
          (Tabela.FieldByName('formaemissao').AsString = '9') then //contigencia
      begin
         ImprimirDanfe(true);
         ShowProcessando;         
      end
      else
        ShowProcessando;
    end;

  end;
end;

procedure TdtmControleNotasFiscaisEletronicas.FecharTabelas;
begin
  qryNotas.close;
  QtdeMarcados := 0;
  TotalMarcados:= 0;
end;

function TdtmControleNotasFiscaisEletronicas.getQtdeNotas: Integer;
begin
  Result := qryNotas.RecordCount
end;

function TdtmControleNotasFiscaisEletronicas.getValorNotas: Currency;
begin
  Result := TotalizarValores[qryNotas, qryNotasvalornota, nil]
end;

function TdtmControleNotasFiscaisEletronicas.SelecionarNotas(TipoNFe, Operacao: Integer;
  ChaveNota: Integer = 0; NotaVinculada: boolean = false): Boolean;
begin
{
  if ZerarContadores then
  begin
    QtdeMarcados := 0;
    TotalMarcados := 0;
  end;
}
  FOperacao := '';

  qryNotasPag.Close;
  qryDadosFiscais.Close;

  if TipoNFe = 0 then  // ENTRADA
  begin

    FTipoNotas := 'E';
    qryNotasPag.ParamByName('ambiente').AsInteger := NFeAmbiente;
    qryNotasPag.parambyname('ChaveNota').asInteger := ChaveNota;

    qryNotasPag.MacroByName('OPERACAO').AsString := '';

    case Operacao of

      1: // TRANSMITIR NF-e
      begin
        FOperacao := 'RI';
        qryNotasPag.MacroByName('OPERACAO').AsString := '  AND n.situacao = ''N''' +
                                                        '  AND (n.numprotocolonfe IS NULL)';
      end;

      3:  // RECUPERAR E IMPRIMIR DANFE
      begin
        FOperacao := 'RI';
        qryNotasPag.MacroByName('OPERACAO').AsString := '  AND n.situacao = ''N''';
      end;

      4:   //CANCELAR OU UNUTILIZAR
      begin
        FOperacao := 'CI';
        qryNotasPag.MacroByName('OPERACAO').AsString := '  AND n.situacao = ''C'' AND n.modelodocto in (''55'',''65'') ' +
                                                          ' AND ((n.numprotocolonfe IS NOT NULL AND n.numcancelamentonfe IS NULL) OR ' +
                                                          '      (n.numprotocolonfe IS     NULL AND n.numinutilizacaonfe IS NULL ))';
      end;
    end;
    qryNotasPag.Open;
    Result := qryNotasPag.recordcount = 1;
  end
  else  // SAÍDA
  begin
    FTipoNotas := 'S';

    qryDadosFiscais.ParamByName('NFeAmbiente').AsInteger := NFeAmbiente;
    qryDadosFiscais.ParamByName('NFSeAmbiente').AsInteger := NFSeAmbiente;
    qryDadosFiscais.ParamByName('CondicaoNFPSe').AsBoolean := (ftipoemissaonfeservico in [Eletronica_Betha_Sistemas, Florianopolis_SoftPlan, Palhoca_IPM]) and
                                                               parsistema.EmissorNFPSe;

    qryDadosFiscais.MacroByName('OPERACAO').AsString := '';

    if NotaVinculada then
      qryDadosFiscais.MacroByName('DOCTO').AsString   := ' and df.notavinculada and df.numero = (select n.dadofiscal from notas n where n.dadofiscalvinculado = :ChaveNota)'
    else
      qryDadosFiscais.MacroByName('DOCTO').AsString   := ' and df.numero = :ChaveNota';

    qryDadosFiscais.paramByName('ChaveNota').asInteger := ChaveNota;

    case Operacao of

      1:  // TRANSMITIR NF-e
      begin
        FOperacao := 'RI';

        qryDadosFiscais.MacroByName('OPERACAO').AsString := '  AND df.situacao = ''N'''+
                                                            ' and case when :CondicaoNFPSe and                              '+
                                                            '                (select count(*)                               '+
                                                            '                 from servicosdadosfiscais sdf                 '+
                                                            '                 where sdf.dadofiscal = df.numero) <> 0          '+
                                                            '           then df.numprotocolonfse is null                '+
                                                            '           else df.numprotocolonfe IS NULL '+
                                                            '      end                                                      ';

      end;

      3:  // RECUPERAR E IMPRIMIR DANFE
      begin
        FOperacao := 'RI';
        qryDadosFiscais.MacroByName('OPERACAO').AsString := '  AND df.situacao = ''N''';
      end;

      4:   //CANCELAR OU UNUTILIZAR
      begin

        FOperacao := 'CI';

        qryDadosFiscais.MacroByName('OPERACAO').AsString := ' AND df.situacao = ''C''                                      '+
                                                            ' AND df.modelodocto in (''55'',''65'',''99'')                  '+
                                                            ' and case when :CondicaoNFPSe and                              '+
                                                            '                (select count(*)                               '+
                                                            '                 from servicosdadosfiscais sdf                 '+
                                                            '                 where sdf.dadofiscal = df.numero)<>0 '+
                                                            '                   and ((coalesce(df.statusnfse,0) in (0) and f.tipoemissaonfeservico=7) or '+
                                                            '                        (coalesce(df.statusnfse,0) in (0,1) and f.tipoemissaonfeservico=8)) '+
                                                            '           then true                    '+
                                                            '           else ((df.numprotocolonfe IS NOT NULL AND df.numcancelamentonfe IS NULL) OR '+
                                                            '                 (df.numprotocolonfe IS     NULL AND df.numinutilizacaonfe IS NULL )) '+
                                                            '           end                                                 ';

      end;
      5:    //CONFIRMAR INUTILIZAÇÃO/CANCELAMENTO
      begin
        FOperacao := 'CC';
      end;
    end;
    qryDadosFiscais.Open;
    Result := qryDadosFiscais.RecordCount = 1;
  end;
end;

procedure TdtmControleNotasFiscaisEletronicas.SelecionarRegistro;
begin
    MarcarRegistros(qryNotas,
                    qryNotasselecionar,
                    qryNotasvalornota,
                    False,
                    False)
end;

procedure TdtmControleNotasFiscaisEletronicas.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
 FileName: String;
begin
  inherited;
  FileName := 'c:\teclux\nfe.sql';
  Listar := tStringlist.create;
  if fileexists(FileName) then
    Listar.loadfromfile(FileName);
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile(FileName);
  listar.free;
end;

procedure TdtmControleNotasFiscaisEletronicas.qryDadosFiscaisBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  {
  if (qryDadosFiscaisnumprotocolonfe.AsString = '') then
    qryDadosFiscaisdatahoraemissao.AsDateTime := DataHoraServidor;
    }
end;

procedure TdtmControleNotasFiscaisEletronicas.qryNotasPagBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  {
  if (qryNotasPagnumprotocolonfe.AsString = '') then
    qryNotasPagdatahoraemissao.AsDateTime := DataHoraServidor;
    }
end;

function TdtmControleNotasFiscaisEletronicas.TabelaReferenciada: TtecQuery;
begin
  if qryDadosFiscais.active then
    qryNotaEntradaRef.ParamByName('dadofiscal').asinteger := qryDadosFiscaisnumero.asinteger
  else
    qryNotaEntradaRef.ParamByName('dadofiscal').asinteger := 0;

  if qryNotasPag.Active then
    qryNotaEntradaRef.ParamByName('codigonota').asinteger := qryNotasPagcodigo.asinteger
  else
    qryNotaEntradaRef.ParamByName('codigonota').asinteger := 0;

  qryNotaEntradaRef.ParamByName('dadofiscalreferenciado').asinteger := Tabela.FieldByName('dadofiscalreferenciado').asinteger;

  if tabela.findfield('codigonotareferenciado') <> nil then
    qryNotaEntradaRef.ParamByName('codigonotareferenciado').asinteger := Tabela.FieldByName('codigonotareferenciado').AsInteger
  else
    qryNotaEntradaRef.ParamByName('codigonotareferenciado').asinteger := 0;

  qryNotaEntradaRef.Close;
  qryNotaEntradaRef.Open;

  if qryNotaEntradaRef.recordcount <> 0 then
    result := qryNotaEntradaRef
  else
    result := nil;
end;

function TdtmControleNotasFiscaisEletronicas.SelecionarGeral(DataInicial,
  DataFinal, SerieNota, NumeroNota, Cliente: String): Boolean;

begin
  QtdeMarcados := 0;
  TotalMarcados := 0;

  qrynotas.close;

  qryNotas.ParamByName('NFeAmbiente').AsInteger := NFeAmbiente;
  qryNotas.ParamByName('NFSeAmbiente').AsInteger := NFSeAmbiente;
  qryNotas.ParamByName('CondicaoNFPSe').AsBoolean := (ftipoemissaonfeservico in [Eletronica_Betha_Sistemas, Florianopolis_SoftPlan, Palhoca_IPM]) and
                                                              parsistema.EmissorNFPSe;

  qryNotas.MacroByName('FILIAL_ENTRADA').AsString   := ' AND n.filial = '+inttostr(FilialBase);

  if trim(Cliente) <> '' then
    qryNotas.MacroByName('FORNECEDOR_ENTRADA').AsString:= ' AND n.fornecedor = ' + Cliente
  else
    qryNotas.MacroByName('FORNECEDOR_ENTRADA').AsString:= '';

  if trim(SerieNota) <> '' then
    qryNotas.MacroByName('SERIE_ENTRADA').AsString     := ' AND n.serie = ''' + SerieNota + ''''
  else
    qryNotas.MacroByName('SERIE_ENTRADA').AsString     := '';

  if trim(NumeroNota) <> '' then
    qryNotas.MacroByName('NUMERO_ENTRADA').AsString    := ' AND n.numero = ' + NumeroNota
  else
    qryNotas.MacroByName('NUMERO_ENTRADA').AsString    := '';

  if (trim(DataInicial) <> '') or (trim(DataFinal) <> '') then
     qryNotas.MacroByName('DATA_ENTRADA').AsString      := MontarIntervaloData('n.emissao', DataInicial, DataFinal);

  qryNotas.parambyname('selecionar').asboolean := false;


  qryNotas.MacroByName('FILIAL_SAIDA').AsString   := 'and df.filialemissao = '+inttostr(FilialBase);

  if trim(Cliente) <> '' then
    qryNotas.MacroByName('CLIENTE_SAIDA').AsString := '  AND df.cliente = ' + Cliente
  else
    qryNotas.MacroByName('CLIENTE_SAIDA').AsString := '';

  if trim(SerieNota) <> '' then
    qryNotas.MacroByName('SERIE_SAIDA').AsString   := '  AND n.serie = ''' + SerieNota + ''''
  else
    qryNotas.MacroByName('SERIE_SAIDA').AsString   := '';

  if trim(NumeroNota) <> '' then
    qryNotas.MacroByName('NUMERO_SAIDA').AsString  := '  and df.nrdocumento = ' + NumeroNota
  else
    qryNotas.MacroByName('NUMERO_SAIDA').AsString  := '';

  if (trim(DataInicial) <> '') or (trim(DataFinal) <> '') then
    qryNotas.MacroByName('DATA_SAIDA').AsString      := MontarIntervaloData('df.data', DataInicial, DataFinal);

  qryNotas.open;
  Result := not qryNotas.IsEmpty;

end;

function TdtmControleNotasFiscaisEletronicas.EnviarGeral: boolean;
var
  vRegistroAtual : TBookMark;

  function TipoNota: byte;
  begin
    if qryNotastiponfe.asString = 'ENTRADA' then result := 0
    else result := 1;
  end;

  function Operacao: byte;
  begin
    if qryNotasoperacao.asString = 'CANCELAR' then result := 4
    else
    if qryNotasoperacao.asString = 'TRANSMITIR' then result := 1
    else
    if qryNotasoperacao.asString = 'INUTILIZAR' then result := 4
    else
    if qryNotasoperacao.asString = 'CONFIRMAÇÃO CANCELAMENTO' then result := 5

  end;

begin
  result := true;
  try
    vRegistroAtual := qryNotas.getBookMark;

    qryNotas.first;
    while not qryNotas.eof do
    begin
      if qryNotasselecionar.AsBoolean then
        if SelecionarNotas(TipoNota, Operacao, qryNotaschavenota.asInteger) then
           EnviarNotasFiscais;
      qryNotas.next;
    end;
  finally
    qryNotas.gotobookmark(vRegistroAtual);
    qryNotas.freeBookmark(vRegistroAtual);
  end;
end;

procedure TdtmControleNotasFiscaisEletronicas.MarcarNotas(Marcando,
  Todas: Boolean);
begin
  MarcarRegistros(qryNotas,
                  qryNotasselecionar,
                  qryNotasvalornota,
                  Marcando,
                  Todas);
end;


procedure TdtmControleNotasFiscaisEletronicas.AbrirTabelasDiversas;
begin
 if FTipoNotas = 'E' then
 begin
  RefazConsultaPorNome(qryProdutosNotasPag,['codigonota'],  [Tabela.FieldByName('codigo').AsInteger]);
  RefazConsultaPorNome(qryVenctosNotasPag, ['documentopag'],[Tabela.FieldByName('documentopag').AsInteger]);
  RefazConsultaPorNome(qryVolumesNotasPag, ['notapag'],     [Tabela.FieldByName('codigo').AsInteger]);
  RefazConsultaPorNome(qryLacresNotasPag,  ['notapag'],     [Tabela.FieldByName('codigo').AsInteger]);
  RefazConsultaPorNome(qryImportacoes,     ['numero'],      [Tabela.FieldByName('ndi').AsString]);
  RefazConsultaPorNome(qryAdicoes,         ['importacao'],  [qryImportacoesnumero.AsString]);
//  RefazConsultaPorNome(qryDadosFiscaisRef, ['dadofiscalreferenciado'],  [Tabela.FieldByName('dadofiscalreferenciado').AsInteger]);

  qryTotaisRecebimentosFrentedeCaixa.close;
  qryTotaisRecebimentos.close;

 end
 else
 begin
  RefazConsultaPorNome(qryProdutosDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
  RefazConsultaPorNome(qryServicosDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);

  RefazConsultaPorNome(qryVenctosDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
  RefazConsultaPorNome(qryVolumesDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
  RefazConsultaPorNome(qryLacresDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
  RefazConsultaPorNome(qryTotaisRecebimentosFrentedeCaixa, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
  RefazConsultaPorNome(qryTotaisRecebimentos, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);

  RefazConsultaPorNome(qrycupons,              ['dadofiscal'],[Tabela.FieldByName('dadofiscalvinculado').AsInteger]);
//  RefazConsultaPorNome(qryDadosFiscaisRef, ['dadofiscalreferenciado'],  [Tabela.FieldByName('dadofiscalreferenciado').AsInteger]);
//  RefazConsultaPorNome(qryNotaEntradaRef, ['codigonotareferenciado'],  [Tabela.FieldByName('codigonotareferenciado').AsInteger]);


  if ParSistema.UsaProdutoComposto then
    RefazConsultaPorNome(qryProdutosDadosFiscaisCompostos,['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);

  RefazConsultaPorNome(qryImpostosRetidosDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);

 end;
end;

function TdtmControleNotasFiscaisEletronicas.TotaisRecebimentos: TtecQuery;
begin
  if qryTotaisRecebimentosFrentedeCaixa.active and
    (qryTotaisRecebimentosFrentedeCaixa.recordcount <> 0) then
    result := qryTotaisRecebimentosFrentedeCaixa
  else
  if qryTotaisRecebimentos.active and
    (qryTotaisRecebimentos.recordcount <> 0) then
      result := qryTotaisRecebimentos
  else
    result := nil;    

end;

destructor TdtmControleNotasFiscaisEletronicas.Destroy;
begin
  inherited;
end;

function TdtmControleNotasFiscaisEletronicas.PreencherPropriedadesNFE(
  regerando: boolean): Boolean;
begin
  result := true;

  if regerando then
  begin
    NFe.Emit_Documento := tabela.fieldbyname('cnpjfilialemitente').asstring;
    NFe.Emit_Nome      := tabela.fieldbyname('razaofilialemitente').AsString;
    NFe.Emit_Rua       := tabela.fieldbyname('ruafilialemitente').AsString;
    NFe.Emit_Nro       := tabela.fieldbyname('numerofilialemitente').AsString;
    NFe.Emit_Compl     := tabela.fieldbyname('complementofilialemitente').AsString;
    NFe.Emit_Bairro    := tabela.fieldbyname('nomebairrofilialemitente').asstring;
    NFe.Emit_CodMun    := tabela.fieldbyname('cidadeibgefilialemitente').AsString;
    NFe.Emit_Mun       := tabela.fieldbyname('nomecidadefilialemitente').AsString;
    NFe.Emit_UF        := tabela.fieldbyname('estadofilialemitente').AsString;
    NFe.Emit_CEP       := tabela.fieldbyname('cepfilialemitente').AsString;
//    NFe.Emit_CodPais   := 1058;
//    NFe.Emit_Pais      := 'Brasil';
    NFe.Emit_Fone      := tabela.fieldbyname('fonedddfilialemitente').AsString+tabela.fieldbyname('fonenumerofilialemitente').AsString;
    NFe.Emit_IE        := tabela.fieldbyname('inscricaoestadualfilialemitente').AsString;
//    NFe.Emit_IEST      := '';
    NFe.Emit_IM        := tabela.fieldbyname('inscricaomunicipalfilialemitente').AsString;
    NFe.Emit_CNAE      := tabela.fieldbyname('cnaefiscalfilialemitente').asstring;
    NFe.Emit_CRT       := tabela.fieldbyname('RegimeTributario').AsInteger;
  end
  else
  begin
    if FilialBase = tabela.fieldbyname('filialemissao').asinteger then
    begin
      NFe.Emit_Documento := CNPJFilialBase;
      NFe.Emit_Nome      := RazaoFilialBase;
      NFe.Emit_Rua       := RuaSemNumeroFilialBase;
      NFe.Emit_Nro       := NumeroFilialBase;
      NFe.Emit_Compl     := ComplementoFilialBase;
      NFe.Emit_Bairro    := BairroFilialBase;
      NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
      NFe.Emit_Mun       := CidadeFilialBase;
      NFe.Emit_UF        := EstadoFilialBase;
      NFe.Emit_CEP       := CEPFilialBase;
  //    NFe.Emit_CodPais   := 1058;
  //    NFe.Emit_Pais      := 'Brasil';
      NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
      NFe.Emit_IE        := InscricaoEstadualFilialBase;
  //    NFe.Emit_IEST      := '';
      NFe.Emit_IM        := InscricaoMunicipalFilialBase;
      NFe.Emit_CNAE      := CNAEFiscalFilialBase;
      NFe.Emit_CRT       := tabela.fieldbyname('RegimeTributario').AsInteger;
    end
    else
    begin
      result := false;
      MensagemErro(format('Filial de emissão : %s' + chr(13) +
                          'Filial base: %s' + chr(13) +
                          'Para a emissão da NFE, a filial base deve ser igual a filial que gerou a nota fiscal. Acesse o sistema com a filial que gerou a nota fiscal.',
                          [tabela.fieldbyname('filialemissao').asString,
                           inttostr(filialbase)]));
    end;
  end;

  if result then
  begin
    if FTipoNotas = 'E' then
    begin

      AbrirTabelasDiversas;

    // DESTINATARIO
      NFe.Dest_TipoPessoa := qryNotaspagpessoatipo.AsString;
      NFe.Dest_Documento := qryNotasPagcnpj.AsString;
      NFe.Dest_Nome      := qryNotasPagnome.AsString;
      NFe.Dest_Rua       := qryNotasPagrua.AsString;
      NFe.Dest_Nro       := qryNotasPagendnumero.AsString;
      NFe.Dest_Compl     := qryNotasPagendcomplemento.AsString;
      NFe.Dest_Bairro    := qryNotasPagnomebairro.AsString;
      NFe.Dest_CodMun    := qryNotasPagcidadeibge.AsString;
      NFe.Dest_Mun       := qryNotasPagnomecidade.AsString;
      NFe.Dest_UF        := qryNotasPagestado.AsString;
      NFe.Dest_CEP       := qryNotasPagcep.AsString;
      NFe.Dest_CodPais   := qryNotasPagpais.AsInteger;
      NFe.Dest_Pais      := qryNotasPagnomepais.AsString;
      NFe.Dest_Fone      := qryNotasPagfoneddd.AsString+qryNotasPagfonenumero.AsString;
      NFe.Dest_IE        := qryNotasPaginscricaoestadual.AsString;
//      NFe.Dest_ISUF      := qryNotasPagiesubsttributario.AsString;
      NFe.Dest_ISUF      := qryNotasPagsuframa.AsString;

    end
    else
    begin
      AbrirTabelasDiversas;

      // DESTINATARIO
      NFe.Dest_TipoPessoa := qryDadosFiscaispessoatipo.AsString;
      NFe.Dest_Documento := qryDadosFiscaispessoanumero.AsString;
      NFe.Dest_Nome      := qryDadosFiscaisnome.AsString;
      NFe.Dest_Rua       := qryDadosFiscaisrua.AsString;
      NFe.Dest_Nro       := qryDadosFiscaisendnumero.AsString;
      NFe.Dest_Compl     := qryDadosFiscaisendcomplemento.AsString;
      NFe.Dest_Bairro    := qryDadosFiscaisnomebairro.AsString;
      NFe.Dest_CodMun    := qryDadosFiscaiscidadeibge.AsString;
      NFe.Dest_Mun       := qryDadosFiscaisnomecidade.AsString;
      NFe.Dest_UF        := qryDadosFiscaisestado.AsString;
      NFe.Dest_CEP       := qryDadosFiscaiscep.AsString;
      NFe.Dest_CodPais   := qryDadosFiscaispais.AsInteger;
      NFe.Dest_Pais      := qryDadosFiscaisnomepais.AsString;
      NFe.Dest_Fone      := qryDadosFiscaisfoneddd.AsString+qryDadosFiscaisfonenumero.AsString;
      NFe.Dest_IE        := qryDadosFiscaisdocumento.AsString;
//      NFe.Dest_ISUF      := qryDadosFiscaisiesubsttributario.AsString;
      NFe.Dest_ISUF      := qryDadosFiscaissuframa.AsString;

      // ENTREGA
      NFe.Entrega_Documento:= qryDadosFiscaislocalentrega_cnpj.AsString;
      nfe.entrega_nome     := qryDadosFiscaisentnomedestinatario.asString;
      NFe.Entrega_Rua      := qryDadosFiscaislocalentrega_rua.AsString;
      NFe.Entrega_Nro      := qryDadosFiscaislocalentrega_numero.AsString;
      NFe.Entrega_Compl    := qryDadosFiscaislocalentrega_complemento.AsString;
      NFe.Entrega_Bairro   := qryDadosFiscaislocalentrega_nomebairro.AsString;
      NFe.Entrega_CodMun   := qryDadosFiscaislocalentrega_cidadeibge.AsString;
      NFe.Entrega_Mun      := qryDadosFiscaislocalentrega_nomecidade.AsString;
      NFe.Entrega_UF       := qryDadosFiscaislocalentrega_estado.AsString;
      NFe.Entrega_CEP      := qryDadosFiscaislocalentrega_cep.AsString;

    end;
  end;

end;

procedure TdtmControleNotasFiscaisEletronicas.DataModuleCreate(
  Sender: TObject);
begin
  inherited;
  RemoveDataModule(Self);
end;

end.
