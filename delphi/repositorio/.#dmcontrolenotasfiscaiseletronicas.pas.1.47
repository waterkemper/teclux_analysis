    qryProdutosDadosFiscaisvicmsstretdesp: TFloatField;
    qryDadosFiscaisvicmsstretdesp: TFloatField;
    qryProdutosNotasPagvicmsstretdesp: TFloatField;
    qryNotasPagvicmsstretdesp: TFloatField;
    procedure ZMonitor1MonitorEvent(Sql, Result: String);
    procedure qryDadosFiscaisBeforePost(DataSet: TDataSet);
    procedure qryNotasPagBeforePost(DataSet: TDataSet);
  private
    FOperacao,
    FTipoNotas: String;
    fImpressoraDanfe: String;
    fProtocolo: String; // VARIAVEL DE CONTROLE PARA DEFINIR A QUERY UTILIZADA
    function getQtdeNotas: Integer;
    function getValorNotas: Currency;
    function TabelaReferenciada: TtecQuery;

    { Private declarations }
  public
    Protocolo, ProtocoloCancelamento, ProtocoloInutilizacao, chave_nfe, status : String;
    constructor Create(AOwner: TComponent); override;
    procedure SelecionarRegistro;
    procedure FecharTabelas;
    function SelecionarNotas(TipoNFe, Operacao: Integer;
                             DataInicial, DataFinal,
                             SerieNota, NumeroNota, Cliente: String;
                             Docto: String = ''; NotaVinculada: boolean = false): Boolean;

    function EnviarNotasFiscais(NFE_Calculada: String = '';SomenteRegistroCorrente: Boolean = false): Boolean;
    function AtualizaSituacaoNfe(var Tabela: TtecQuery;ChaveNota:String;Nfe:TTecNOtaFiscalEletronica; regerando: boolean = false):Boolean;
    property QtdeNotas        : Integer  read getQtdeNotas;
    property ValorNotas       : Currency read getValorNotas;
    property ImpressoraDanfe  : String read fImpressoraDanfe write fImpressoraDanfe;
    { Public declarations }
  end;

var
  dtmControleNotasFiscaisEletronicas: TdtmControleNotasFiscaisEletronicas;

implementation

{$R *.dfm}

{ TdtmControleNotasFiscaisEletronicas }

constructor TdtmControleNotasFiscaisEletronicas.Create(AOwner: TComponent);
begin
  inherited create(AOwner);
//  qryProcurarCFOPPesquisa.Tag := ctTabelas;
  FTipoNotas := 'E';
end;

{
   Funcao que ira atualizar situacao da nota:

     1. verifica se tem protocolo e protocolo de cancelamento
     2. Caso tenha protocolo e nao protocolo de cancelamento, situacao deve ser normal, preencher protocolo e gerar XML
     3. Caso tenha protocolo e protocolo de cancelament, situacao deve ser 'C', preencher protocolo de cancelamento e protocolo, gerar XML nota e XML cancelamento;
}
function TdtmControleNotasFiscaisEletronicas.AtualizaSituacaoNfe(var Tabela: TtecQuery;ChaveNota:String;Nfe:TTecNotaFiscalEletronica;
       regerando: boolean = false):Boolean;
var
  DataHoraProcessamento, MotivoNfe: String;
  retorno : boolean;
begin
  Result:=False;
  if ((foperacao = 'RI') and (Tabela.FieldByName('numprotocolonfe').AsString = '')) or (foperacao = 'T') or regerando then
  begin
    retorno := Nfe.ConsultarSituacaoNFe(ChaveNota,IntToStr(NFeAmbiente),Protocolo, status, ProtocoloCancelamento, DataHoraProcessamento, MotivoNFe);
    if regerando then
      result := retorno;
  end;

  if((Tabela.FieldByName('numprotocolonfe').AsString='') and (Protocolo<>'')) then
  begin
    Tabela.Edit;
    Tabela.FieldByName('numprotocolonfe').AsString:=Protocolo;
    Tabela.FieldByName('statusnfe').AsString:=status;

    Tabela.FieldByName('situacao').AsString:='N';
    if (status = '301') or //denegado emitente then
       (status = '302') then // denegado destinatario
      Tabela.FieldByName('situacao').AsString:='D';
    Result:=True;
    Tabela.Post;
  end;

  if((ProtocoloCancelamento<>'') and (Tabela.FieldByName('numcancelamentonfe').AsString='')) then
  begin
    Tabela.Edit;
    Tabela.FieldByName('numcancelamentonfe').AsString:=ProtocoloCancelamento;
    Tabela.FieldByName('situacao').AsString:='C';
    //GERA ARQUIVO DE PEDIDO DE CANCELAMENTO NO DIRETORIO DE PROCESSAMENTO
    Nfe.Recuperar_CancelarNfe(ChaveNota,Protocolo,'CANCELADA EMITIDA ERRONEAMENTE',IntToStr(NfeAmbiente),EstadoFilialBaseIBGE, CNPJFilialBase, DataHoraProcessamentoNfe, ProtocoloCancelamento);
    //COM ESTA CONSULTA DE SITUACAO DE NOTA, O UNINFE GERA O ARQUIVO DE DISTRIBUICAO DE CANCELAMENTO
    Nfe.ConsultarSituacaoNFe(ChaveNota,IntToStr(NfeAmbiente),Protocolo, status, ProtocoloCancelamento, DataHoraProcessamento, MotivoNfe);
    //COPIA PARA O DIRETORIO DE COMPARTILHAMENTO (DATA DO CANCELAMENTO).
    Nfe.CompartilharXMLCancelamento(ChaveNota,true,Tabela.FieldByName('datacancelamento').AsDateTime);
    Result:=True;
    Tabela.Post;
  end;
end;

function TdtmControleNotasFiscaisEletronicas.EnviarNotasFiscais(NFE_Calculada: String = ''; SomenteRegistroCorrente: Boolean = false): Boolean;
var
  NFe: TTecNotaFiscalEletronica;
  NumLote,
  NumRecibo,
  DataHoraProcessamento, MotivoNfe: String;

  Tabela: TtecQuery;
  CampoData: TDateField;
//  i: Integer;
  OK, vSituacaoNFeAtualizada: Boolean;

  function ChaveNotaCalculada: String;
  begin
    result := copy(CodigoCidadeIBGEFilialBase,1,2)+
                         FormatDateTime('YYMM', CampoData.AsDateTime)+
                         preencheString(CNPJFilialBase,'0',14,false)+
                         '55'+
                         preencheString(Tabela.FieldByName('serie').Asstring,'0',3,false)       +
                         preencheString(Tabela.FieldByName('nrdocumento').Asstring,'0',9,false) +
                         inttostr(NFeTipoEmissao) +
                         preencheString(Tabela.FieldByName('codaleatorio').Asstring,'0',8,false);


    result := result + Modulo11(result);
  end;


  function ChaveNota: String;
  begin
    if (foperacao = 'RI') then
    begin
      if (Tabela.FieldByName('chv_nfe').asstring <> '') then
        result := Tabela.FieldByName('chv_nfe').asstring
      else
        result := NFE_Calculada;
    end
    else
      result := ChaveNotaCalculada;
    {
      result := copy(CodigoCidadeIBGEFilialBase,1,2)+
                           FormatDateTime('YYMM', CampoData.AsDateTime)+
                           preencheString(CNPJFilialBase,'0',14,false)+
                           '55'+
                           preencheString(Tabela.FieldByName('serie').Asstring,'0',3,false)       +
                           preencheString(Tabela.FieldByName('nrdocumento').Asstring,'0',9,false) +
                           inttostr(NFeTipoEmissao) +
                           preencheString(Tabela.FieldByName('codaleatorio').Asstring,'0',8,false)+
                           Tabela.FieldByName('digchaveacesso').AsString;
}
  end;

  function CancelarNotasSelecionadas: Boolean;
  var
    i,
    Canceladas:Integer;
  begin
    result := true;
    Canceladas:=0;
    try
      GuardarRegistroAtual(tabela,true);
      tabela.First;
      while not tabela.Eof do
//      for i:=1 to Tabela.RecordCount do
      begin
        if Tabela.FieldByName('selecionar').AsBoolean then
        begin
          if FTipoNotas = 'E' then
            CampoData := TDateField(Tabela.FieldByName('emissao'))
          else
            CampoData := TDateField(Tabela.FieldByName('data'));


         if (not AtualizaSituacaoNfe(Tabela,ChaveNota,Nfe)) then
         begin
            if NFe.CancelarNfe(ChaveNota,
                             Tabela.FieldByName('numprotocolonfe').AsString,
                             'CANCELADA EMITIDA ERRONEAMENTE',
                             Tabela.FieldByName('ambiente').AsString,
                             EstadoFilialBaseIBGE, CNPJFilialBase, DataHoraProcessamentoNfe,

                             ProtocoloCancelamento) then
            begin
              Inc(Canceladas);
              Tabela.Edit;
              Tabela.FieldByName('numcancelamentonfe').AsString := ProtocoloCancelamento;
              Tabela.FieldByName('situacao').AsString := 'C';
              Tabela.Post
            end
            else
            begin
              Tabela.Edit;
              Tabela.FieldByName('situacao').AsString := 'N';
              Tabela.Post;
            end;
         end
         else
          Inc(Canceladas);
        end;
        Tabela.Next
      end
    finally
      VoltarRegistroAtual(tabela)
    end;

    Result := Perpetrar([Tabela]);
    if Canceladas <> QtdeMarcados then
      MensagemAviso('Não foi possível cancelar todas as notas selecionadas')
  end;

  function InutilizarNotasSelecionadas: Boolean;
  var
//    i,
    Inutilizadas:Integer;
    ChaveNotaInutilizar : String;
  begin
    Inutilizadas:=0;
    try
      GuardarRegistroAtual(tabela,true);
      tabela.First;
      while not tabela.Eof do
//      for i:=1 to Tabela.RecordCount do
      begin
        if Tabela.FieldByName('selecionar').AsBoolean then
        begin
          ChaveNotaInutilizar := EstadoFilialBaseIBGE+
//                       formatdatetime('YY',tabela.fieldbyname('data').AsDateTime)+
                       FormatDateTime('YY',date()) +
                       preencheString(CNPJFilialBase,'0',14,false)+
                       '55'+
                       preencheString(Tabela.FieldByName('serie').Asstring,'0',3,false)       +
                       preencheString(Tabela.FieldByName('nrdocumento').Asstring,'0',9,false) +
                       preencheString(Tabela.FieldByName('nrdocumento').Asstring,'0',9,false);

          if(not AtualizaSituacaoNfe(Tabela,Tabela.FieldByName('chv_nfe').AsString,Nfe)) then
          begin
            if NFe.InutilizarNFe(ChaveNotaInutilizar,
                                 'INUTILIZADA ERRO',
                                  inttostr(NFeAmbiente),
                                  EstadoFilialBaseIBGE,
                                  CNPJFilialBase,
                                  Tabela.FieldByName('modelodocto').AsString,
                                  Tabela.FieldByName('serie').AsString,
                                  Tabela.FieldByName('nrdocumento').AsString,
                                  ProtocoloInutilizacao) then
            begin
              Inc(Inutilizadas);
              Tabela.Edit;
              Tabela.FieldByName('numinutilizacaonfe').AsString := ProtocoloInutilizacao;
              Tabela.Post
            end
          else
            Inc(Inutilizadas);
         end;
        end;
        Tabela.Next
      end;
    finally
      VoltarRegistroAtual(tabela)
    end;
    Result := Perpetrar([Tabela]);
    if Inutilizadas <> QtdeMarcados then
      MensagemAviso('Nem todas as notas puderam ser inutilizadas.')
  end;


  function GerarNFe(regerando: boolean = false): Boolean;
  begin
    ShowProcessando('Gerando o arquivo da NF-e!');
    // EMITENTE
    if regerando then
    begin
      NFe.Emit_Documento := tabela.fieldbyname('cnpjfilialemitente').asstring;
      NFe.Emit_Nome      := tabela.fieldbyname('razaofilialemitente').AsString;
      NFe.Emit_Rua       := tabela.fieldbyname('ruafilialemitente').AsString;
      NFe.Emit_Nro       := tabela.fieldbyname('numerofilialemitente').AsString;
      NFe.Emit_Compl     := tabela.fieldbyname('complementofilialemitente').AsString;
      NFe.Emit_Bairro    := tabela.fieldbyname('nomebairrofilialemitente').asstring;
      NFe.Emit_CodMun    := tabela.fieldbyname('cidadeibgefilialemitente').AsString;
      NFe.Emit_Mun       := tabela.fieldbyname('nomecidadefilialemitente').AsString;
      NFe.Emit_UF        := tabela.fieldbyname('estadofilialemitente').AsString;
      NFe.Emit_CEP       := tabela.fieldbyname('cepfilialemitente').AsString;
  //    NFe.Emit_CodPais   := 1058;
  //    NFe.Emit_Pais      := 'Brasil';
      NFe.Emit_Fone      := tabela.fieldbyname('fonedddfilialemitente').AsString+tabela.fieldbyname('fonenumerofilialemitente').AsString;
      NFe.Emit_IE        := tabela.fieldbyname('inscricaoestadualfilialemitente').AsString;
  //    NFe.Emit_IEST      := '';
      NFe.Emit_IM        := tabela.fieldbyname('inscricaomunicipalfilialemitente').AsString;
      NFe.Emit_CNAE      := tabela.fieldbyname('cnaefiscalfilialemitente').asstring;
      NFe.Emit_CRT       := tabela.fieldbyname('RegimeTributario').AsInteger;
    end
    else
    begin
      NFe.Emit_Documento := CNPJFilialBase;
      NFe.Emit_Nome      := RazaoFilialBase;
      NFe.Emit_Rua       := RuaSemNumeroFilialBase;
      NFe.Emit_Nro       := NumeroFilialBase;
      NFe.Emit_Compl     := ComplementoFilialBase;
      NFe.Emit_Bairro    := BairroFilialBase;
      NFe.Emit_CodMun    := CodigoCidadeIBGEFilialBase;
      NFe.Emit_Mun       := CidadeFilialBase;
      NFe.Emit_UF        := EstadoFilialBase;
      NFe.Emit_CEP       := CEPFilialBase;
  //    NFe.Emit_CodPais   := 1058;
  //    NFe.Emit_Pais      := 'Brasil';
      NFe.Emit_Fone      := DDDFilialBase+FoneFilialBase;
      NFe.Emit_IE        := InscricaoEstadualFilialBase;
  //    NFe.Emit_IEST      := '';
      NFe.Emit_IM        := InscricaoMunicipalFilialBase;
      NFe.Emit_CNAE      := CNAEFiscalFilialBase;
      NFe.Emit_CRT       := tabela.fieldbyname('RegimeTributario').AsInteger;
    end;

    if FTipoNotas = 'E' then
    begin
      RefazConsultaPorNome(qryProdutosNotasPag,['codigonota'],  [Tabela.FieldByName('codigo').AsInteger]);
      RefazConsultaPorNome(qryVenctosNotasPag, ['documentopag'],[Tabela.FieldByName('documentopag').AsInteger]);
      RefazConsultaPorNome(qryVolumesNotasPag, ['notapag'],     [Tabela.FieldByName('codigo').AsInteger]);
      RefazConsultaPorNome(qryLacresNotasPag,  ['notapag'],     [Tabela.FieldByName('codigo').AsInteger]);
      RefazConsultaPorNome(qryImportacoes,     ['numero'],      [Tabela.FieldByName('ndi').AsString]);
      RefazConsultaPorNome(qryAdicoes,         ['importacao'],  [qryImportacoesnumero.AsString]);
      RefazConsultaPorNome(qryDadosFiscaisRef, ['dadofiscalreferenciado'],  [Tabela.FieldByName('dadofiscalreferenciado').AsInteger]);




      // DESTINATARIO
      NFe.Dest_TipoPessoa := qryNotaspagpessoatipo.AsString;
      NFe.Dest_Documento := qryNotasPagcnpj.AsString;
      NFe.Dest_Nome      := qryNotasPagnome.AsString;
      NFe.Dest_Rua       := qryNotasPagrua.AsString;
      NFe.Dest_Nro       := qryNotasPagendnumero.AsString;
      NFe.Dest_Compl     := qryNotasPagendcomplemento.AsString;
      NFe.Dest_Bairro    := qryNotasPagnomebairro.AsString;
      NFe.Dest_CodMun    := qryNotasPagcidadeibge.AsString;
      NFe.Dest_Mun       := qryNotasPagnomecidade.AsString;
      NFe.Dest_UF        := qryNotasPagestado.AsString;
      NFe.Dest_CEP       := qryNotasPagcep.AsString;
      NFe.Dest_CodPais   := qryNotasPagpais.AsInteger;
      NFe.Dest_Pais      := qryNotasPagnomepais.AsString;
      NFe.Dest_Fone      := qryNotasPagfoneddd.AsString+qryNotasPagfonenumero.AsString;
      NFe.Dest_IE        := qryNotasPaginscricaoestadual.AsString;
      NFe.Dest_ISUF      := qryNotasPagiesubsttributario.AsString;

      nfe.Validando := true;
      nfe.CriarListaErro(dtmTecSoft.Database);
      Result := NFe.GerarNFe(Tabela, qryDadosFiscaisRef, qryProdutosNotasPag, nil, nil,
                   qryVenctosNotasPag, qryVolumesNotasPag, qryLacresNotasPag,
                   qryImportacoes, qryAdicoes, SerieSugestao, FTipoNotas, nil, regerando, nil);

      if result then
      begin
        nfe.Validando := false;
        Result := NFe.GerarNFe(Tabela, qryDadosFiscaisRef, qryProdutosNotasPag, nil, nil,
                     qryVenctosNotasPag, qryVolumesNotasPag, qryLacresNotasPag,
                     qryImportacoes, qryAdicoes, SerieSugestao, FTipoNotas, nil, regerando, nil);
      end;
    end
    else
    begin
      RefazConsultaPorNome(qryProdutosDadosFiscais,['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
      RefazConsultaPorNome(qryVenctosDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
      RefazConsultaPorNome(qryVolumesDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
      RefazConsultaPorNome(qryLacresDadosFiscais,  ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
      RefazConsultaPorNome(qrycupons,              ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
      RefazConsultaPorNome(qryDadosFiscaisRef, ['dadofiscalreferenciado'],  [Tabela.FieldByName('dadofiscalreferenciado').AsInteger]);
      RefazConsultaPorNome(qryNotaEntradaRef, ['codigonotareferenciado'],  [Tabela.FieldByName('codigonotareferenciado').AsInteger]);


      if ParSistema.UsaProdutoComposto then
        RefazConsultaPorNome(qryProdutosDadosFiscaisCompostos,['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);

      // DESTINATARIO
      NFe.Dest_TipoPessoa := qryDadosFiscaispessoatipo.AsString;
      NFe.Dest_Documento := qryDadosFiscaispessoanumero.AsString;
      NFe.Dest_Nome      := qryDadosFiscaisnome.AsString;
      NFe.Dest_Rua       := qryDadosFiscaisrua.AsString;
      NFe.Dest_Nro       := qryDadosFiscaisendnumero.AsString;
      NFe.Dest_Compl     := qryDadosFiscaisendcomplemento.AsString;
      NFe.Dest_Bairro    := qryDadosFiscaisnomebairro.AsString;
      NFe.Dest_CodMun    := qryDadosFiscaiscidadeibge.AsString;
      NFe.Dest_Mun       := qryDadosFiscaisnomecidade.AsString;
      NFe.Dest_UF        := qryDadosFiscaisestado.AsString;
      NFe.Dest_CEP       := qryDadosFiscaiscep.AsString;
      NFe.Dest_CodPais   := qryDadosFiscaispais.AsInteger;
      NFe.Dest_Pais      := qryDadosFiscaisnomepais.AsString;
      NFe.Dest_Fone      := qryDadosFiscaisfoneddd.AsString+qryDadosFiscaisfonenumero.AsString;
      NFe.Dest_IE        := qryDadosFiscaisdocumento.AsString;
      NFe.Dest_ISUF      := qryDadosFiscaisiesubsttributario.AsString;

      // ENTREGA
      NFe.Entrega_Documento:= qryDadosFiscaislocalentrega_cnpj.AsString;
      NFe.Entrega_Rua      := qryDadosFiscaislocalentrega_rua.AsString;
      NFe.Entrega_Nro      := qryDadosFiscaislocalentrega_numero.AsString;
      NFe.Entrega_Compl    := qryDadosFiscaislocalentrega_complemento.AsString;
      NFe.Entrega_Bairro   := qryDadosFiscaislocalentrega_nomebairro.AsString;
      NFe.Entrega_CodMun   := qryDadosFiscaislocalentrega_cidadeibge.AsString;
      NFe.Entrega_Mun      := qryDadosFiscaislocalentrega_nomecidade.AsString;
      NFe.Entrega_UF       := qryDadosFiscaislocalentrega_estado.AsString;

      nfe.Validando := true;
      nfe.CriarListaErro(dtmTecSoft.Database);
      Result := NFe.GerarNFe(Tabela, TabelaReferenciada, qryProdutosDadosFiscais,
                   qryProdutosDadosFiscaisCompostos, nil,
                   qryVenctosDadosFiscais, qryVolumesDadosFiscais,
                   qryLacresDadosFiscais, nil, nil, SerieSugestao,
                   FTipoNotas, qrycupons, false);

      if result then
      begin
        nfe.Validando := false;
        Result := NFe.GerarNFe(Tabela, TabelaReferenciada, qryProdutosDadosFiscais,
                     qryProdutosDadosFiscaisCompostos, nil,
                     qryVenctosDadosFiscais, qryVolumesDadosFiscais,
                     qryLacresDadosFiscais, nil, nil, SerieSugestao,
                     FTipoNotas, qrycupons, false)
      end;

    end;
    sleep(500);
    ShowProcessando
  end;

  function EnviarNFe: Boolean;
  begin
    ShowProcessando('Verificando status do serviço NF-e!');
    sleep(500);
    if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
    begin
      ShowProcessando;
      ShowProcessando('Processando o arquivo de envio da NF-e!');
      sleep(500);
      Result := NFe.EnviarNFe(ChaveNota, NumLote, NumRecibo);
      if Result then
      begin
        Tabela.Edit;
        Tabela.FieldByName('numlotenfe').AsString   := NumLote;
        Tabela.FieldByName('numrecibonfe').AsString := NumRecibo;
        Tabela.Post;
      end;
    end;
    ShowProcessando
  end;

  function ConsultarLote(SomenteRetorno: Boolean): Boolean;
  begin
    ShowProcessando('Consultando o arquivo de retorno da NF-e!');
    sleep(500);
    Result := NFe.ConsultarSituacaoLote(Tabela.FieldByName('numrecibonfe').AsString,
                                        Protocolo, status, DataHoraProcessamento, IntToStr(NFeAmbiente), SomenteRetorno);
    if Result then
    begin
      Tabela.Edit;
      Tabela.FieldByName('numprotocolonfe').AsString:=Protocolo;
      Tabela.FieldByName('dhprocnfe').AsDateTime:=FormatarTimeStamp(DataHoraProcessamento);
      Tabela.Post;
    end;
    ShowProcessando
  end;

  function CompartilharXML(Recuperando_XML: Boolean; Esperar: boolean = false): Boolean;
  begin
    sleep(500);
    if(Recuperando_Xml) then
    begin
        ShowProcessando('Gerando o arquivo de compartilhamento da NF-e! Recuperando_XML');
        Result := NFe.CompartilharXML_Recuperado(ChaveNota,
                                  Tabela.FieldByName('numrecibonfe').AsString,
                                  Tabela.FieldByName('filial').AsString,
                                  Tabela.FieldByName('serie').AsString,
                                  Tabela.FieldByName('nrdocumento').AsString,
                                  CampoData.AsDateTime, Esperar);

    end
    else
    begin
        ShowProcessando('Gerando o arquivo de compartilhamento da NF-e!');
        Result := NFe.CompartilharXML(ChaveNota,
                                  Tabela.FieldByName('numrecibonfe').AsString,
                                  Tabela.FieldByName('filial').AsString,
                                  Tabela.FieldByName('serie').AsString,
                                  Tabela.FieldByName('nrdocumento').AsString,
                                  CampoData.AsDateTime);
    end;
    ShowProcessando
  end;

  procedure EnviarEmail;
  begin
    if (Tabela.FieldByName('email').AsString <> '')      and
       (UsuarioLogin.PortaSmpt               <> '')      and
       (UsuarioLogin.HostSmtp                <> '')      and
       (UsuarioLogin.Email                   <> '')      and
       (UsuarioLogin.SenhaEmail              <> '')      and
       EmailValido(Tabela.FieldByName('email').AsString) then
    begin
      ShowProcessando('Enviando email para o cliente');
      sleep(500);
      try
	    if NFe.EnviarEmail(UsuarioLogin.Email,
			Tabela.FieldByName('email').AsString,
			Tabela.FieldByName('nrdocumento').AsString,
			Tabela.FieldByName('serie').AsString,
			Tabela.FieldByName('filial').AsString,
			NomeFilialBase, RazaoFilialBase, CNPJFilialBase, DDDFilialBase, FoneFilialBase,
			DDDFaxFilialBase, FaxFilialBase, UsuarioLogin.NomeUsuario, UsuarioLogin.PortaSMPT,
			UsuarioLogin.HostSMTP, UsuarioLogin.UsuarioEmail, UsuarioLogin.SenhaEmail,
			CampoData.AsDateTime, Tabela.FieldByName('valortotal').AsCurrency,
			UsuarioLogin.AutenticarSMTP, CampoData.AsDateTime)then
		  MensagemAviso('Ocorreu um erro inesperado no envio do email')
	  finally
		ShowProcessando;
	  end;
    end
  end;
  

  function ImprimirDanfe: boolean;
  var
    Produtos: TtecQuery;
  begin
    result := false;
    ShowProcessando('Imprimindo o DANFE!');
    sleep(500);
    if FTipoNotas = 'E' then
      Produtos := qryProdutosNotasPag
    else
      Produtos := qryProdutosDadosFiscais;

//    if FOperacao = 'T' then
//      ImpressoraDanfe := ParSistema.NomeImpressoraNotaMercadorias;

    result := NFe.ImprimirDanfe({ChaveNota,}
                      Tabela.FieldByName('filial').AsString,
                      Tabela.FieldByName('serie').AsString,
                      Tabela.FieldByName('nrdocumento').AsString,
                      Tabela.FieldByName('localentrega_cep').AsString,
                      Tabela.FieldByName('email').AsString,
                      IntToStr(NFeNVias), NFeLogotipoDANFE,
                      ImpressoraDanfe, NFeVisualizarDANFE,
                      CampoData.AsDateTime,
                      Produtos, NFeExecDANFE);
    if result then
      EnviarEmail;

    ShowProcessando
  end;

  procedure ConsultaSituacaoNotaFiscal;
  begin
      {
        Consultar a situaçao da nota antes;
        Verificar se tem numero de protocolo, numero de inutilizacao e numero de cancelamento
        Setar numrecibo,numlote,numprotocolonfe,numinutilizacaonfe e numcancelamentonfe
        Caso numcancelamentofe e numinutilizacaonfe setados, tem que mudar situacao da nota para C e alimentar estes campos
        Fazer o download do XML caso exista
      }
//      NFE.ConsultarSituacaoNFe(ChaveNota,IntToStr(NFeAmbiente));
  end;


  procedure AtribuirDadosTabela;
  var
  vt: integer;
  begin
    Tabela.Edit;

    if (Tabela.FieldByName('nrdocumento').AsString='') then
      Tabela.FieldByName('nrdocumento').AsString := Tabela.FieldByName('numeronota').AsString;

    if Tabela.FieldByName('codaleatorio').Asinteger=0 then
      Tabela.FieldByName('codaleatorio').Asinteger := Aleatorio( Tabela.FieldByName('data').AsDateTime,  Tabela.FieldByName('nrdocumento').asString);

    if (Tabela.FieldByName('chv_nfe').AsString='') then
    begin
      Tabela.FieldByName('chv_nfe').AsString:=ChaveNota;
      chave_nfe := ChaveNota;
    end;

    if (Tabela.FieldByName('ambiente').AsString='') then
      Tabela.FieldByName('ambiente').Asinteger := NFeAmbiente;

    if (Tabela.FieldByName('modelodocto').AsString='') then
      Tabela.FieldByName('modelodocto').AsString := '55';

    if Tabela.FieldByName('nrdocumento').Asinteger=0 then
      Tabela.FieldByName('nrdocumento').Asinteger := Tabela.FieldByName('numeronota').Asinteger;

    if Tabela.FieldByName('formaemissao').AsString = '' then
      Tabela.FieldByName('formaemissao').AsInteger := NFeTipoEmissao;

    if Tabela.FieldByName('digchaveacesso').asstring = '' then
      Tabela.FieldByName('digchaveacesso').asstring := copy(Tabela.FieldByName('chv_nfe').AsString, 44, 1);

    if tabela.fieldbyname('versaolayout').isnull  then
      tabela.fieldbyname('versaolayout').AsCurrency := 3.10;

    { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
    if tabela.fieldbyname('formapagto').isnull then
      tabela.fieldbyname('formapagto').AsInteger    := 2;

    { 1-Retrato/ 2-Paisagem }
    if tabela.fieldbyname('formatodanfe').isnull then
      tabela.fieldbyname('formatodanfe').AsInteger  := 1;

    {1-Normal/ 2-Contingência}
    if tabela.fieldbyname('finalidadenf').isnull then
      tabela.fieldbyname('finalidadenf').AsInteger  := 1;

    if tabela.fieldbyname('procemissao').isnull then
      tabela.fieldbyname('procemissao').AsString    := '0';

    if tabela.fieldbyname('versaoteclux').isnull then
      tabela.fieldbyname('versaoteclux').AsString   := VersaoTecLUX;

    Tabela.post;
  end;

begin
  Result := True;
  NFe := TTecNotaFiscalEletronica.Create;
  NFe.DiretorioEnvio       := NFeDirEnvio;
  NFe.DiretorioEnviado     := NFeDirEnviados;
  NFe.DiretorioRetorno     := NFeDirRetorno;
  NFe.DiretorioCompartilha := NfeDirCompartilha;
  nfe.DiretorioErros       := NfeDirErros;
  NFe.Executavel           := NFeExecNFe;

  if FTipoNotas = 'E' then
    Tabela := qryNotasPag
  else
    Tabela := qryDadosFiscais;


  if FOperacao = 'RI' then //recuperar e imprimir
  begin
    try
      CampoData := TDateField(Tabela.FieldByName('data'));

      GuardarRegistroAtual(tabela,true);
      Tabela.First;
      while not Tabela.Eof do
      begin
        if Tabela.FieldByName('selecionar').AsBoolean then
        begin
          vSituacaoNFeAtualizada := false;

          if (Tabela.FieldByName('numprotocolonfe').AsString = '') then
          begin
            AtualizaSituacaoNfe(Tabela,ChaveNota,Nfe);
            vSituacaoNFeAtualizada := true;
          end;

          AtribuirDadosTabela;

          if Tabela.FieldByName('numprotocolonfe').AsString = '' then
          begin
             FOperacao := 'T';
             EnviarNotasFiscais(NFE_Calculada, true);
             FOperacao := 'RI';
    //         MensagemAviso('O número do protocolo não foi recuperado. Utilize a funcionalidade em ''Estoque - Controle de Notas Fiscais Eletônicas''')
          end
          else if (Tabela.FieldByName('statusnfe').AsString = '301') or
                  (Tabela.FieldByName('statusnfe').AsString = '302') then
          begin
            MensagemAviso('Nota fiscal em uso denegado.');
            if not CompartilharXML(true) then
            begin
               GerarNFe(true);
               nfe.ConsultarSituacaoNFe(ChaveNota,IntToStr(NFeAmbiente),Protocolo, status, ProtocoloCancelamento, DataHoraProcessamento, MotivoNfe);
               CompartilharXML(true, true);
            end;
          end
          else
          if (Tabela.FieldByName('numcancelamentonfe').AsString = '') and
             not ImprimirDanfe then
          begin
            if not vSituacaoNFeAtualizada then
              AtualizaSituacaoNfe(Tabela,ChaveNota,Nfe, True);

            if not CompartilharXML(true) then
            begin
              IF Gerarnfe(true) then {Aqui é colocado na pasta de envio e uninfe processa colocando em processamento ou na pasta erro , capturar destas pastas e colocar na pasta de processamento}
                CompartilharXML(true, true);
            end;
            ImprimirDanfe;
          end;

        end;
        Tabela.Next
      end;
    finally
      Perpetrar([Tabela]);
      VoltarRegistroAtual(tabela)
    end;
  end
  else
  begin

    ShowProcessando('Verificando status do serviço NF-e!');
    sleep(500);
    if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
    begin


      if FOperacao = 'C' then
      begin
        ShowProcessando;
        ShowProcessando('Cancelando NF-e');
        sleep(500);
        Result := CancelarNotasSelecionadas;
        ShowProcessando;
      end
      else
      if FOperacao = 'I' then
      begin
        ShowProcessando;
        ShowProcessando('Inutilizando NF-e');
        sleep(500);
        Result := InutilizarNotasSelecionadas;
        ShowProcessando;
      end
      else
      begin
        ShowProcessando;
        try
          if not SomenteRegistroCorrente then
          begin
//            GuardarRegistroAtual(tabela,true);
            Tabela.First;
          end;

          while not Tabela.Eof do //for i:=1 to Tabela.RecordCount do
          begin
            if Tabela.FieldByName('selecionar').AsBoolean then
            begin
              if FTipoNotas = 'E' then
                CampoData   := TDateField(Tabela.FieldByName('emissao'))
              else
                CampoData := TDateField(Tabela.FieldByName('data'));

              AtribuirDadosTabela;


              if FOperacao = 'T' then
              begin
                OK := GerarNFe;

                if OK then
                begin

                  OK := EnviarNFe;

                  if OK then
                    OK := ConsultarLote(false);

                  if OK Then
                    CompartilharXML(false);

                  if OK and (Tabela.FieldByName('numprotocolonfe').AsString <> '') then
                    ImprimirDanfe;

                end;
              end;
            end;

            if SomenteRegistroCorrente then
              break
            else
              Tabela.Next
          end
        finally
          if not SomenteRegistroCorrente then
            Perpetrar([Tabela]);
//          if not SomenteRegistroCorrente then
//            VoltarRegistroAtual(tabela)
        end
      end
    end
    else
      ShowProcessando
  end;
end;

procedure TdtmControleNotasFiscaisEletronicas.FecharTabelas;
begin
  qryNotasPag.Close;
  qryDadosFiscais.Close;
  QtdeMarcados := 0;
  TotalMarcados:= 0;
end;

function TdtmControleNotasFiscaisEletronicas.getQtdeNotas: Integer;
begin
  if FTipoNotas = 'E' then
    Result := qryNotasPag.RecordCount
  else
    Result := qryDadosFiscais.RecordCount;
end;

function TdtmControleNotasFiscaisEletronicas.getValorNotas: Currency;
begin
  if FTipoNotas = 'E' then
    Result := TotalizarValores[qryNotasPag, qryNotasPagvalornota, nil]
  else
    Result := TotalizarValores[qryDadosFiscais, qryDadosFiscaisvalortotal, nil];
end;

function TdtmControleNotasFiscaisEletronicas.SelecionarNotas(TipoNFe, Operacao: Integer;
  DataInicial, DataFinal, SerieNota, NumeroNota, Cliente: String; Docto: String = ''; NotaVinculada: boolean = false): Boolean;
begin
  QtdeMarcados := 0;
  TotalMarcados := 0;

  qryNotasPag.Close;
  qryDadosFiscais.Close;
  if TipoNFe = 0 then  // ENTRADA
  begin
    FTipoNotas := 'E';
    qryNotasPag.ParamByName('ambiente').AsInteger := NFeAmbiente;
    if Docto <> '' then
      qryNotasPag.MacroByName('DOCTO').AsString   := '  AND n.codigo = ' + Docto
    else
    begin
      qryNotasPag.MacroByName('DOCTO').AsString   := '';
      qryNotasPag.MacroByName('FILIAL').AsString   := '  AND n.filial = '+inttostr(FilialBase);

      if trim(Cliente) <> '' then
        qryNotasPag.MacroByName('FORNECEDOR').AsString:= '  AND n.fornecedor = ' + Cliente
      else
        qryNotasPag.MacroByName('FORNECEDOR').AsString:= '';

      if trim(SerieNota) <> '' then
        qryNotasPag.MacroByName('SERIE').AsString     := '  AND n.serie = ''' + SerieNota + ''''
      else
        qryNotasPag.MacroByName('SERIE').AsString     := '';

      if trim(NumeroNota) <> '' then
        qryNotasPag.MacroByName('NUMERO').AsString    := '  AND n.numero = ' + NumeroNota
      else
        qryNotasPag.MacroByName('NUMERO').AsString    := '';

      if (trim(DataInicial) <> '') or (trim(DataFinal) <> '') then
        qryNotasPag.MacroByName('DATA').AsString      := MontarIntervaloData('n.emissao', DataInicial, DataFinal);
    end;

    qryNotasPag.parambyname('selecionar').asboolean := False;

    case Operacao of
    0: // CANCELAR
    begin
      FOperacao := 'C';
      qryNotasPag.MacroByName('OPERACAO').AsString := '  AND n.situacao = ''C''' +
                                                        '  AND n.numprotocolonfe IS NOT NULL ' +
                                                        '  AND n.numcancelamentonfe IS NULL';
    end;
    1: // TRANSMITIR NF-e
    begin
      FOperacao := 'RI';
      qryNotasPag.MacroByName('OPERACAO').AsString := '  AND n.situacao = ''N''' +
                                                      '  AND (n.numprotocolonfe IS NULL)';
    end;
    2: //INUTCHEULIZAR
    begin
      FOperacao := 'I';
      qryNotasPag.MacroByName('OPERACAO').AsString := '  AND n.chv_nfe is not null '+
                                                          '  AND n.modelodocto = ''55'' ' +
                                                          '  AND n.situacao = ''C''' +
                                                          '  AND n.numprotocolonfe IS NULL '+
                                                          '  AND n.numinutilizacaonfe IS NULL';
    end;
    3:  // RECUPERAR E IMPRIMIR DANFE
    begin
      FOperacao := 'RI';
      if QtdeMarcados = 0 then
        QtdeMarcados := 1;
         
      qryNotasPag.parambyname('selecionar').asboolean := True;
      qryDadosFiscais.MacroByName('OPERACAO').AsString := '  AND n.situacao = ''N''';
    end;
    end;
    qryNotasPag.Open;
    Result := not qryNotasPag.IsEmpty;
  end
  else  // SAÍDA
  begin
    FTipoNotas := 'S';
    qryDadosFiscais.ParamByName('ambiente').AsInteger := NFeAmbiente;

    if Docto <> '' then
      qryDadosFiscais.MacroByName('DOCTO').AsString   := '  and df.numero = ' + Docto
    else
    begin
      qryDadosFiscais.MacroByName('DOCTO').AsString   := '';
      qryDadosFiscais.MacroByName('FILIAL').AsString   := 'and df.filialemissao = '+inttostr(FilialBase);

      if trim(Cliente) <> '' then
        qryDadosFiscais.MacroByName('CLIENTE').AsString := '  AND df.cliente = ' + Cliente
      else
        qryDadosFiscais.MacroByName('CLIENTE').AsString := '';

      if trim(SerieNota) <> '' then
        qryDadosFiscais.MacroByName('SERIE').AsString   := '  AND n.serie = ''' + SerieNota + ''''
      else
        qryDadosFiscais.MacroByName('SERIE').AsString   := '';

      if trim(NumeroNota) <> '' then
        qryDadosFiscais.MacroByName('NUMERO').AsString  := '  and df.nrdocumento = ' + NumeroNota
      else
        qryDadosFiscais.MacroByName('NUMERO').AsString  := '';
      if (trim(DataInicial) <> '') or (trim(DataFinal) <> '') then
        qryDadosFiscais.MacroByName('DATA').AsString      := MontarIntervaloData('data', DataInicial, DataFinal);
    end;

    qryDadosFiscais.parambyname('selecionar').asboolean := False;
    case Operacao of
    0: // CANCELAR
    begin
      FOperacao := 'C';
      if NotaVinculada then
      begin
        qryDadosFiscais.MacroByName('OPERACAO').AsString := '  AND df.numprotocolonfe IS NOT NULL AND df.numcancelamentonfe IS NULL';
        qryDadosFiscais.parambyname('selecionar').asboolean := True;
        if QtdeMarcados = 0 then
          QtdeMarcados := 1;
      end
      else
        qryDadosFiscais.MacroByName('OPERACAO').AsString := '  AND df.situacao = ''C'''+
                                                            '  AND df.numprotocolonfe IS NOT NULL AND df.numcancelamentonfe IS NULL';
    end;

    1:  // TRANSMITIR NF-e
    begin
      FOperacao := 'RI';
      qryDadosFiscais.MacroByName('OPERACAO').AsString := '  AND df.situacao = ''N''' +
                                                          '  AND (df.numprotocolonfe IS NULL)';
    end;

    2: //INUTCHEULIZAR
    begin
      FOperacao := 'I';
      qryDadosFiscais.MacroByName('OPERACAO').AsString := '  AND df.chv_nfe is not null '+
                                                          '  AND df.modelodocto = ''55'' ' +
                                                          '  AND df.situacao = ''C''' +
                                                          '  AND df.numprotocolonfe IS NULL '+
                                                          '  AND df.numinutilizacaonfe IS NULL';
    end;

    3:  // RECUPERAR E IMPRIMIR DANFE
    begin
      FOperacao := 'RI';
      qryDadosFiscais.parambyname('selecionar').asboolean := True;
      qryDadosFiscais.MacroByName('OPERACAO').AsString := '  AND df.situacao = ''N''';

    end;


    end;
    qryDadosFiscais.Open;
    Result := not qryDadosFiscais.IsEmpty;
  end;
end;

procedure TdtmControleNotasFiscaisEletronicas.SelecionarRegistro;
begin
  if FTipoNotas = 'E' then
    MarcarRegistros(qryNotasPag,
                    qryNotasPagselecionar,
                    qryNotasPagvalornota,
                    False,
                    False)
  else
    MarcarRegistros(qryDadosFiscais,
                    qryDadosFiscaisselecionar,
                    qryDadosFiscaisvalortotal,
                    False,
                    False);
end;

procedure TdtmControleNotasFiscaisEletronicas.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
 FileName: String;
begin
  inherited;
  FileName := 'c:\teclux\nfe.sql';
  Listar := tStringlist.create;
  if fileexists(FileName) then
    Listar.loadfromfile(FileName);
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile(FileName);
  listar.free;
end;

procedure TdtmControleNotasFiscaisEletronicas.qryDadosFiscaisBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  {
  if (qryDadosFiscaisnumprotocolonfe.AsString = '') then
    qryDadosFiscaisdatahoraemissao.AsDateTime := DataHoraServidor;
    }
end;

procedure TdtmControleNotasFiscaisEletronicas.qryNotasPagBeforePost(
  DataSet: TDataSet);
begin
  inherited;
  {
  if (qryNotasPagnumprotocolonfe.AsString = '') then
    qryNotasPagdatahoraemissao.AsDateTime := DataHoraServidor;
    }
end;

function TdtmControleNotasFiscaisEletronicas.TabelaReferenciada: TtecQuery;
begin
  if qryDadosFiscaisdadofiscalreferenciado.AsInteger <> 0 then
    result := qryDadosFiscaisRef
  else
  if qryDadosFiscaiscodigonotareferenciado.AsInteger <> 0 then
    result := qryNotaEntradaRef
  else
    result := nil;
end;

end.
