function TdtmControleNotasFiscaisEletronicas.SelecionarNotas(TipoNFe, Operacao: Integer;
  ChaveNota: Integer = 0; NotaVinculada: boolean = false): Boolean;
begin
{
  if ZerarContadores then
  begin
    QtdeMarcados := 0;
    TotalMarcados := 0;
  end;
}
  FOperacao := '';

  qryNotasPag.Close;
  qryDadosFiscais.Close;

  if TipoNFe = 0 then  // ENTRADA
  begin

    FTipoNotas := 'E';
    qryNotasPag.ParamByName('ambiente').AsInteger := NFeAmbiente;
    qryNotasPag.parambyname('ChaveNota').asInteger := ChaveNota;

    qryNotasPag.MacroByName('OPERACAO').AsString := '';

    case Operacao of

      1: // TRANSMITIR NF-e
      begin
        FOperacao := 'RI';
        qryNotasPag.MacroByName('OPERACAO').AsString := '  AND n.situacao = ''N''' +
                                                        '  AND (n.numprotocolonfe IS NULL)';
      end;

      3:  // RECUPERAR E IMPRIMIR DANFE
      begin
        FOperacao := 'RI';
        qryNotasPag.MacroByName('OPERACAO').AsString := '  AND n.situacao = ''N''';
      end;

      4:   //CANCELAR OU UNUTILIZAR
      begin
        FOperacao := 'CI';
        qryNotasPag.MacroByName('OPERACAO').AsString := '  AND n.situacao = ''C'' AND n.modelodocto in (''55'',''65'') ' +
                                                          ' AND ((n.numprotocolonfe IS NOT NULL AND n.numcancelamentonfe IS NULL) OR ' +
                                                          '      (n.numprotocolonfe IS     NULL AND n.numinutilizacaonfe IS NULL ))';
      end;
    end;
    qryNotasPag.Open;
    Result := qryNotasPag.recordcount = 1;
  end
  else  // SAÍDA
  begin
    FTipoNotas := 'S';

    qryDadosFiscais.ParamByName('NFeAmbiente').AsInteger := NFeAmbiente;
    qryDadosFiscais.ParamByName('NFSeAmbiente').AsInteger := NFSeAmbiente;
    qryDadosFiscais.ParamByName('CondicaoNFPSe').AsBoolean := (ftipoemissaonfeservico in [Eletronica_Betha_Sistemas, Florianopolis_SoftPlan]) and
                                                               parsistema.EmissorNFPSe;

    qryDadosFiscais.MacroByName('OPERACAO').AsString := '';

    if NotaVinculada then
      qryDadosFiscais.MacroByName('DOCTO').AsString   := ' and df.notavinculada and df.numero = (select n.dadofiscal from notas n where n.dadofiscalvinculado = :ChaveNota)'
    else
      qryDadosFiscais.MacroByName('DOCTO').AsString   := ' and df.numero = :ChaveNota';

    qryDadosFiscais.paramByName('ChaveNota').asInteger := ChaveNota;

    case Operacao of

      1:  // TRANSMITIR NF-e
      begin
        FOperacao := 'RI';

        qryDadosFiscais.MacroByName('OPERACAO').AsString := '  AND df.situacao = ''N'''+
                                                            ' and case when :CondicaoNFPSe and                              '+
                                                            '                (select count(*)                               '+
                                                            '                 from servicosdadosfiscais sdf                 '+
                                                            '                 where sdf.dadofiscal = df.numero) <> 0          '+
                                                            '           then df.numprotocolonfse is null                '+
                                                            '           else df.numprotocolonfe IS NULL '+
                                                            '      end                                                      ';

      end;

      3:  // RECUPERAR E IMPRIMIR DANFE
      begin
        FOperacao := 'RI';
        qryDadosFiscais.MacroByName('OPERACAO').AsString := '  AND df.situacao = ''N''';
      end;

      4:   //CANCELAR OU UNUTILIZAR
      begin

        FOperacao := 'CI';

        qryDadosFiscais.MacroByName('OPERACAO').AsString := ' AND df.situacao = ''C''                                      '+
                                                            ' AND df.modelodocto in (''55'',''65'',''99'')                  '+
                                                            ' and case when :CondicaoNFPSe and                              '+
                                                            '                (select count(*)                               '+
                                                            '                 from servicosdadosfiscais sdf                 '+
                                                            '                 where sdf.dadofiscal = df.numero)<>0 and coalesce(df.statusnfse,0)=0 '+
                                                            '           then true                    '+
                                                            '           else ((df.numprotocolonfe IS NOT NULL AND df.numcancelamentonfe IS NULL) OR '+
                                                            '                 (df.numprotocolonfe IS     NULL AND df.numinutilizacaonfe IS NULL )) '+
                                                            '           end                                                 ';

      end;
    end;
    qryDadosFiscais.Open;
    Result := qryDadosFiscais.RecordCount = 1;
  end;
end;

