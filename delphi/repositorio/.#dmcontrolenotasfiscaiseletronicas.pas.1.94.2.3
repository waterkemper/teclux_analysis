      else
      begin
        if (Tabela.FieldByName('numprotocolonfe').AsString = '') then
        begin
          result := AtualizaSituacaoNfe(Tabela,ChaveNota,Nfe);
          vSituacaoNFeAtualizada := true;
        end;


        {NÃO PODE TRANSMITIR NFE COM FILIALEMISSAO QUE NÃO SEJA A PRÓPRIA}
        if Tabela.FieldByName('numprotocolonfe').AsString = '' then
        begin
           FOperacao := 'T';
           result := EnviarNotasFiscais(NFE_Calculada);
           FOperacao := 'RI';
       //   MensagemAviso('O número do protocolo não foi recuperado. Utilize a funcionalidade em ''Estoque - Controle de Notas Fiscais Eletônicas''')
        end
        else if (Tabela.FieldByName('statusnfe').AsString = '301') or
                (Tabela.FieldByName('statusnfe').AsString = '302') then
        begin
          if ExibirMsgNFe then
            MensagemAviso('Nota fiscal em uso denegado.');

          if not CompartilharXML(true) then
          begin
             GerarNFe(true);
             vChave_Nfe := ChaveNota;
             nfe.ConsultarSituacaoNFe(vChave_Nfe, IntToStr(NFeAmbiente),Protocolo, status, StatusRetConsSitNFe, ProtocoloCancelamento, DataHoraProcessamento, MotivoNfe);
             CompartilharXML(true, true);
          end;
        end
        else
        if (Tabela.FieldByName('numcancelamentonfe').AsString = '') and
           not ImprimirDanfe then
        begin
          if not vSituacaoNFeAtualizada then
            AtualizaSituacaoNfe(Tabela,ChaveNota,Nfe, True);

          if not CompartilharXML(true) then
          begin
            IF Gerarnfe(true) then {Aqui é colocado na pasta de envio e uninfe processa colocando em processamento ou na pasta erro , capturar destas pastas e colocar na pasta de processamento}
              CompartilharXML(true, true);
          end;
          ImprimirDanfe;
        end;
      end;

      if result then
      begin
        if tabela.State = dsedit then
          tabela.Post;
      end
      else
      begin
        if tabela.State = dsedit then
          tabela.cancel;
      end;

    finally

      if vSituacaoNFeAtualizada then
        Perpetrar([Tabela, qryNotas_])
      else
        Perpetrar([Tabela,TabelaProdutos, qryNotas_]);
    end;

  end
  else
  begin
    if Tabela.FieldByName('nfpse').AsBoolean then
    begin

      if FOperacao = 'C' then
      begin
        ShowProcessando;
        ShowProcessando('Cancelando NF-e');
        sleep(500);
        RefazConsultaPorNome(qryNotas_, ['dadofiscal'], [tabela.fieldbyname('numero').asinteger]);
        Result := CancelarNotasSelecionadas;
        ShowProcessando;
      end
      else
      if FOperacao = 'I' then
      begin
        ShowProcessando;
        ShowProcessando('Inutilizando NF-e');
        sleep(500);
        Result := InutilizarNotasSelecionadas;
        ShowProcessando;
      end
      else
      if FOperacao = 'CI' then
      begin
        ShowProcessando;

        Protocolo := '';
        ProtocoloCancelamento := '';
        ProtocoloInutilizacao := '';
        vchave_nfe := '';
        status := '';
        StatusRetConsSitNFe := '';

        vSituacaoNFeAtualizada := false;

        if (Tabela.FieldByName('numprotocolonfse').AsString = '') then
        begin
          RefazConsultaPorNome(qryNotas_, ['dadofiscal'], [tabela.fieldbyname('numero').asinteger]);
          result := AtualizaSituacaoNFPSe(Tabela, qryNotas_);
          vSituacaoNFeAtualizada := true;
        end;

        if Tabela.FieldByName('numprotocolonfse').AsString = '' then
        begin
          ShowProcessando('Inutilizando NFPS-e');
          sleep(500);
          Result := InutilizarNotasSelecionadas;
          ShowProcessando;
        end
        else
        if Tabela.FieldByName('statusnfse').AsString = '0' then
        begin
          ShowProcessando;
          ShowProcessando('Cancelando NFPS-e');
          sleep(500);
          Result := CancelarNotasSelecionadas;
          ShowProcessando;
        end;

        Docxml := nil;

      end
      else  { T - Transmitir }
      begin
        ShowProcessando;
        try

          Tabela.edit;
          Tabela.FieldByName('data').asDateTime := DataServidor;
          AtribuirDadosTabela;
          AtualizarDataVencto;
          AbrirTabelasDiversas;
          if FOperacao = 'T' then
          begin

            result := GerarNotaEletronica(Tabela, nil, nil, nil, qryServicosDadosFiscais, nil, nil, nil, nil, nil,
                          '', 'S',  nil, false, nil, nil, Enviar, true, nil, qrynotas_, nil);

            if result then
            begin

              result := GerarNotaEletronica(Tabela, nil, nil, nil, qryServicosDadosFiscais, nil, nil, nil, nil, nil,
                            '', 'S',  nil, false, nil, nil, Enviar, false, nil, qrynotas_, nil);
              if result and (Tabela.FieldByName('numprotocolonfe').AsString <> '') then
                ImprimirNFPSe;

            end;
          end;

          if result then
          begin
            if tabela.State = dsedit then
              tabela.Post;
          end
          else
          begin
            if tabela.State = dsedit then
              tabela.cancel;
          end;

        finally
          Perpetrar([Tabela, TabelaProdutos, qryNotas_]);
        end;
        Docxml := nil;
      end;

    end
    else
    begin

      ShowProcessando('Verificando status do serviço NF-e!');
      sleep(500);
      if NFe.VerificarStatusServico(IntToStr(NFeAmbiente)) then
      begin

        if FOperacao = 'C' then
        begin
          ShowProcessando;
          ShowProcessando('Cancelando NF-e');
          sleep(500);
          Result := CancelarNotasSelecionadas;
          ShowProcessando;
        end
        else
        if FOperacao = 'I' then
        begin
          ShowProcessando;
          ShowProcessando('Inutilizando NF-e');
          sleep(500);
          Result := InutilizarNotasSelecionadas;
          ShowProcessando;
        end
        else
        if FOperacao = 'CI' then
        begin
          ShowProcessando;

          Protocolo := '';
          ProtocoloCancelamento := '';
          ProtocoloInutilizacao := '';
          vchave_nfe := '';
          status := '';
          StatusRetConsSitNFe := '';

          vSituacaoNFeAtualizada := false;

          if (Tabela.FieldByName('numprotocolonfe').AsString = '') then
          begin
            AtualizaSituacaoNfe(Tabela,ChaveNota,Nfe);
            vSituacaoNFeAtualizada := true;
          end;

          if Tabela.FieldByName('numprotocolonfe').AsString = '' then
          begin
            ShowProcessando('Inutilizando NF-e');
            sleep(500);
            Result := InutilizarNotasSelecionadas;
            ShowProcessando;
          end
          else
          if Tabela.FieldByName('numcancelamentonfe').AsString = '' then
          begin
            ShowProcessando;
            ShowProcessando('Cancelando NF-e');
            sleep(500);
            Result := CancelarNotasSelecionadas;
            ShowProcessando;
          end;
        end
        else  { T - Transmitir }
        begin
          ShowProcessando;
          try

            Protocolo := '';
            ProtocoloCancelamento := '';
            ProtocoloInutilizacao := '';
            vchave_nfe := '';
            status := '';

            if Tabela.FieldByName('formaemissao').asString <> '9' then   //ver forma mais generica para contigencia
            begin
              if FTipoNotas = 'E' then
              begin
                Tabela.Edit;
                Tabela.FieldByName('emissao').asDateTime := DataServidor;
              end
              else
              begin
                Tabela.edit;
                Tabela.FieldByName('data').asDateTime := DataServidor;
              end;
            end;

            AtribuirDadosTabela;
            AtualizarDataVencto;

            if FOperacao = 'T' then
            begin
              result := GerarNFe;

              if result then
              begin

                result := EnviarNFe;

                if Result then
                  result := ConsultarLote(false);

                if result Then
                  CompartilharXML(false);

                if result and (Tabela.FieldByName('numprotocolonfe').AsString <> '') then
                  ImprimirDanfe;

              end;
            end;

            if result then
            begin
              if tabela.State = dsedit then
                tabela.Post;
            end
            else
            begin
              if tabela.State = dsedit then
                tabela.cancel;
            end;

          finally
            Perpetrar([Tabela, TabelaProdutos, qryNotas_]);
          end;
        end;
      end
      else
        ShowProcessando;
    end;

  end;
end;

