  procedure AtribuirDadosTabela;
  var
    vt: integer;

    function ContigenciaScanNFCe: Boolean;
    begin
      result := (Tabela.FieldByName('formaemissao').asstring='9') and (Tabela.FieldByName('modelodocto').asstring='65');
    end;  
      
  begin
    Tabela.Edit;

    if (Tabela.FieldByName('nrdocumento').AsString='') or
       (Tabela.FieldByName('nrdocumento').Asinteger=0)  then
      Tabela.FieldByName('nrdocumento').AsString := Tabela.FieldByName('numeronota').AsString;

    if (Tabela.FieldByName('modelodocto').AsString='') then
      Tabela.FieldByName('modelodocto').AsString := '55';

    if tabela.fieldbyname('versaoteclux').isnull then
      tabela.fieldbyname('versaoteclux').AsString   := VersaoTecLUX;


    if Tabela.FieldByName('nfpse').AsBoolean then
    begin
      if (Tabela.FieldByName('ambientenfs').AsString='') or ((FOperacao='T') and not ContigenciaScanNFCe) then
        Tabela.FieldByName('ambientenfs').Asinteger := NFSeAmbiente;
    end
    else
    begin

      if (Tabela.FieldByName('codaleatorio').Asinteger=0) or ((FOperacao='T') and not ContigenciaScanNFCe) then
        Tabela.FieldByName('codaleatorio').Asinteger := Aleatorio( CampoData.AsDateTime,  Tabela.FieldByName('nrdocumento').asString);

      if (Tabela.FieldByName('chv_nfe').AsString='') or ((FOperacao='T') and not ContigenciaScanNFCe) then
      begin
        Tabela.FieldByName('chv_nfe').AsString:=ChaveNota;
        vchave_nfe := ChaveNota;
      end;

      if (Tabela.FieldByName('ambiente').AsString='') or ((FOperacao='T') and not ContigenciaScanNFCe) then
        Tabela.FieldByName('ambiente').Asinteger := NFeAmbiente;

      if (Tabela.FieldByName('formaemissao').AsString = '') or ((FOperacao='T') and not ContigenciaScanNFCe) then
        Tabela.FieldByName('formaemissao').AsInteger := NFeTipoEmissao;

      if (Tabela.FieldByName('digchaveacesso').asstring = '') or ((FOperacao='T') and not ContigenciaScanNFCe) then
        Tabela.FieldByName('digchaveacesso').asstring := copy(Tabela.FieldByName('chv_nfe').AsString, 44, 1);

      if tabela.fieldbyname('versaolayout').isnull  then
        tabela.fieldbyname('versaolayout').AsCurrency := 3.10;

      { 0 – pagamento à vista   1 – pagamento à prazo     2 - outros }
      if tabela.fieldbyname('formapagto').isnull then
        tabela.fieldbyname('formapagto').AsInteger    := 2;

      { 1-Retrato/ 2-Paisagem }
      if tabela.fieldbyname('formatodanfe').isnull then
        tabela.fieldbyname('formatodanfe').AsInteger  := 1;

      {1-Normal/ 2-Contingência}
      if tabela.fieldbyname('finalidadenf').isnull then
        tabela.fieldbyname('finalidadenf').AsInteger  := 1;

      if tabela.fieldbyname('procemissao').isnull then
        tabela.fieldbyname('procemissao').AsString    := '0';

    end;

//    Tabela.post;
  end;

  procedure AtualizarDataVencto;
  begin
    if FTipoNotas = 'E' then
    begin
      RefazConsultaPorNome(qryVenctosNotasPag, ['documentopag'],[Tabela.FieldByName('documentopag').AsInteger]);
      qryVenctosNotasPag.first;
      while not qryVenctosNotasPag.Eof do
      begin
        if qryVenctosNotasPag.fieldbyname('datavencto').asDateTime < DataServidor then
        begin
          qryVenctosNotasPag.edit;
          qryVenctosNotasPag.fieldbyname('datavencto').asDateTime := DataServidor;
          qryVenctosNotasPag.post;
        end;
        qryVenctosNotasPag.Next;
      end;
      perpetrar([qryVenctosNotasPag]);
    end
    else
    begin
      RefazConsultaPorNome(qryVenctosDadosFiscais, ['dadofiscal'],[Tabela.FieldByName('numero').AsInteger]);
      qryVenctosDadosFiscais.first;
      while not qryVenctosDadosFiscais.Eof do
      begin
        if qryVenctosDadosFiscais.fieldbyname('datavencto').asDateTime < DataServidor then
        begin
          qryVenctosDadosFiscais.edit;
          qryVenctosDadosFiscais.fieldbyname('datavencto').asDateTime := DataServidor;
          qryVenctosDadosFiscais.post;
        end;
        qryVenctosDadosFiscais.Next;
      end;
      perpetrar([qryVenctosDadosFiscais]);
    end;
  end;

