function TdtmControleNotasFiscaisEletronicas.SelecionarGeral(DataInicial,
  DataFinal, SerieNota, NumeroNota, Cliente: String): Boolean;

begin
  QtdeMarcados := 0;
  TotalMarcados := 0;

  qrynotas.close;

  qryNotas.ParamByName('NFeAmbiente').AsInteger := NFeAmbiente;
  qryNotas.ParamByName('NFSeAmbiente').AsInteger := NFSeAmbiente;
  qryNotas.ParamByName('CondicaoNFPSe').AsBoolean := (ftipoemissaonfeservico in [Eletronica_Betha_Sistemas, Florianopolis_SoftPlan]) and
                                                              parsistema.EmissorNFPSe;

  qryNotas.MacroByName('FILIAL_ENTRADA').AsString   := ' AND n.filial = '+inttostr(FilialBase);

  if trim(Cliente) <> '' then
    qryNotas.MacroByName('FORNECEDOR_ENTRADA').AsString:= ' AND n.fornecedor = ' + Cliente
  else
    qryNotas.MacroByName('FORNECEDOR_ENTRADA').AsString:= '';

  if trim(SerieNota) <> '' then
    qryNotas.MacroByName('SERIE_ENTRADA').AsString     := ' AND n.serie = ''' + SerieNota + ''''
  else
    qryNotas.MacroByName('SERIE_ENTRADA').AsString     := '';

  if trim(NumeroNota) <> '' then
    qryNotas.MacroByName('NUMERO_ENTRADA').AsString    := ' AND n.numero = ' + NumeroNota
  else
    qryNotas.MacroByName('NUMERO_ENTRADA').AsString    := '';

  if (trim(DataInicial) <> '') or (trim(DataFinal) <> '') then
     qryNotas.MacroByName('DATA_ENTRADA').AsString      := MontarIntervaloData('n.emissao', DataInicial, DataFinal);

  qryNotas.parambyname('selecionar').asboolean := false;


  qryNotas.MacroByName('FILIAL_SAIDA').AsString   := 'and df.filialemissao = '+inttostr(FilialBase);

  if trim(Cliente) <> '' then
    qryNotas.MacroByName('CLIENTE_SAIDA').AsString := '  AND df.cliente = ' + Cliente
  else
    qryNotas.MacroByName('CLIENTE_SAIDA').AsString := '';

  if trim(SerieNota) <> '' then
    qryNotas.MacroByName('SERIE_SAIDA').AsString   := '  AND n.serie = ''' + SerieNota + ''''
  else
    qryNotas.MacroByName('SERIE_SAIDA').AsString   := '';

  if trim(NumeroNota) <> '' then
    qryNotas.MacroByName('NUMERO_SAIDA').AsString  := '  and df.nrdocumento = ' + NumeroNota
  else
    qryNotas.MacroByName('NUMERO_SAIDA').AsString  := '';

  if (trim(DataInicial) <> '') or (trim(DataFinal) <> '') then
    qryNotas.MacroByName('DATA_SAIDA').AsString      := MontarIntervaloData('df.data', DataInicial, DataFinal);

  qryNotas.open;
  Result := not qryNotas.IsEmpty;

end;

function TdtmControleNotasFiscaisEletronicas.EnviarGeral: boolean;
var
  vRegistroAtual : TBookMark;

  function TipoNota: byte;
  begin
    if qryNotastiponfe.asString = 'ENTRADA' then result := 0
    else result := 1;
  end;

  function Operacao: byte;
  begin
    if qryNotasoperacao.asString = 'CANCELAR' then result := 4
    else
    if qryNotasoperacao.asString = 'TRANSMITIR' then result := 1
    else
    if qryNotasoperacao.asString = 'INUTILIZAR' then result := 4;
  end;

begin
  result := true;
  try
    vRegistroAtual := qryNotas.getBookMark;

    qryNotas.first;
    while not qryNotas.eof do
    begin
      if qryNotasselecionar.AsBoolean then
        if SelecionarNotas(TipoNota, Operacao, qryNotaschavenota.asInteger) then
           EnviarNotasFiscais;
      qryNotas.next;
    end;
  finally
    qryNotas.gotobookmark(vRegistroAtual);
    qryNotas.freeBookmark(vRegistroAtual);
  end;
end;

