      EditMask = '99/99/9999;1; '
    end
    object qryRegistroC420cod_tot_par: TStringField
      FieldName = 'cod_tot_par'
      Required = True
      Size = 7
    end
    object qryRegistroC420vlr_acum_tot: TFloatField
      FieldName = 'vlr_acum_tot'
