  object qryRegistroC420: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 
      'filial=filial;numerousuario=numerousuario;numerofabricacao=numer' +
      'ofabricacao;cro=cro;dt_doc=dt_doc;crz=crz'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC405
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select distinct rd.filial,'
      '       rd.numerousuario, rd.numerofabricacao,'
      '       rd.cro,'
      '       rd.crz,'
      '       rzd.datamovimento as dt_doc,'
      '/*'
      
        '       case when substring(rzd.tipototalizadorparcial,1,2)='#39'00'#39' ' +
        'then cast('#39'01'#39' as char(2))||cast(substring(rzd.tipototalizadorpa' +
        'rcial,3,5) as char(5))'
      '       else rzd.tipototalizadorparcial end as cod_tot_par,'
      '*/'
      ''
      '       rzd.tipototalizadorparcial as cod_tot_par,'
      ''
      '       rzd.valoracumulado as vlr_acum_tot,'
      '/*'
      
        '       cast(case when rzd.aliquota<>0 then case when substring(r' +
        'zd.tipototalizadorparcial,1,2)='#39'00'#39' then '#39'01'#39' else substring(rzd' +
        '.tipototalizadorparcial from 1 for 2) end'
      '            end as integer) as nr_tot'
      '*/'
      ''
      
        '       cast(case when rzd.aliquota<>0 then substring(rzd.tipotot' +
        'alizadorparcial from 1 for 2) '
      '            end as integer) as nr_tot'
      ''
      ''
      '       /* descr_nr_tot*/'
      ''
      'from reducoesz rd'
      '     join reducoeszdetalhes rzd'
      '     on rd.filial = rzd.filial'
      '     and rd.numerousuario = rzd.numerousuario'
      '     and rd.cro = rzd.cro'
      '     and rd.datamovimento = rzd.datamovimento'
      ''
      'where rzd.datamovimento between :datainicial and :datafinal'
      '  and rzd.valoracumulado<>0'
      '  and rzd.tipototalizadorparcial<>'#39'AT'#39
      '  and rd.filial = :filial'
      ''
      'order by rd.filial, rd.numerousuario, rd.numerofabricacao,'
      '         rd.cro, rd.crz, rzd.datamovimento,'
      '         rzd.tipototalizadorparcial'
      '         /*'
      
        '         case when substring(rzd.tipototalizadorparcial,1,2)='#39'00' +
        #39' then cast('#39'01'#39' as char(2))||cast(substring(rzd.tipototalizador' +
        'parcial,3,5) as char(5))'
      '         else rzd.tipototalizadorparcial end'
      '         */')
    RequestLive = False
    Left = 204
    Top = 399
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
