  object qryRegistroC160: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC100
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.numero as chave,'
      '       cast(1 as varchar(1)) as ind_oper,'
      
        '       cast('#39'F'#39'||cast(df.fornecedortransporte as varchar) as var' +
        'char(60)) as cod_part,'
      '       df.placa as veic_id,'
      '       vdf.volumes as qtd_vol,'
      '       vdf.pesobruto as peso_brt,'
      '       vdf.pesoliquido as peso_liq,'
      '       df.estadoplaca as uf_id'
      'from DadosFiscais df  join notas n on df.numero = n.dadofiscal'
      '     join VolumesDadosFiscais vdf on df.numero = vdf.dadofiscal'
      'where df.data between :datainicial and :datafinal'
      '/*  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39') */'
      '  and df.modelodocto in ('#39'01'#39','#39'04'#39') '
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      '  and vdf.volumes is not null'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      '')
    RequestLive = False
    Left = 362
    Top = 120
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroC160chave: TIntegerField
      FieldName = 'chave'
      DisplayFormat = '0'
    end
    object qryRegistroC160ind_oper: TStringField
      FieldName = 'ind_oper'
      Size = 1
