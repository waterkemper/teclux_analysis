  object qryRegistroC172: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper;cod_item=cod_item'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC170
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.numero '#9#9#9'       as chave,'
      '       cast(1 as varchar(1)) '#9#9'       as ind_oper,'
      
        '       cast(('#39'S'#39'||cast(sdf.servico as varchar)) as varchar(60)) ' +
        'as cod_item,'
      '       sdf.quantidade * sdf.valorservico       as vl_bc_issqn,'
      '       sdf.aliquotaissqn                        as aliq_issqn,'
      '       sdf.valorissqn                          as vl_issqn'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join servicosdadosfiscais sdf'
      '     on df.numero = sdf.dadofiscal'
      'where df.numero = sdf.dadofiscal'
      '  and df.data  between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      '')
    RequestLive = False
    Left = 520
    Top = 151
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroC172chave: TIntegerField
      FieldName = 'chave'
      DisplayFormat = '0'
    end
    object qryRegistroC172ind_oper: TStringField
      FieldName = 'ind_oper'
      Size = 1
    end
    object qryRegistroC172cod_item: TStringField
      FieldName = 'cod_item'
      Size = 60
    end
