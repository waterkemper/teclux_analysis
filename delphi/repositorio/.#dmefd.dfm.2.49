  object qryRegistroC425: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 
      'filial=filial;numerousuario=num_usu;numerofabricacao=num_fab;cro' +
      '=cro;cod_tot_par=cod_tot_parc;dt_doc=dt_doc;crz=crz'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC420
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select cod_item, sum(qtde_item) as qtde_item, un_med, sum(vl_tot' +
        '_item) as vl_tot_item, filial, num_usu, num_fab, cro, cod_tot_pa' +
        'rc, dt_doc, crz'
      'from'
      '('
      'select cast(('#39'P'#39'||dic.cod_item) as varchar(60)) as cod_item,'
      '       dic.qtde_item,'
      '       dic.un_med,'
      ''
      '/*'
      '       round(dic.vl_tot_item -'
      
        '            (dic.vl_tot_item *  case when dlc.tp_descto = '#39'V'#39' th' +
        'en dlc.sub_descto end / dlc.sub_docto) +'
      
        '            (dic.vl_tot_item *  case when dlc.tp_acres  = '#39'V'#39' th' +
        'en dlc.sub_acres end / dlc.sub_docto) ,2) as vl_tot_item,'
      '*/'
      ''
      '       dic.vl_tot_item -'
      
        '            (dic.vl_tot_item *  case when dlc.tp_descto = '#39'V'#39' th' +
        'en dlc.sub_descto end / dlc.sub_docto) +'
      
        '            (dic.vl_tot_item *  case when dlc.tp_acres  = '#39'V'#39' th' +
        'en dlc.sub_acres end / dlc.sub_docto)  as vl_tot_item,'
      ''
      ''
      '     /* vl_pis'
      '        vl_cofins */'
      '       dlc.filial,'
      '       dlc.num_usu , dlc.num_fab,'
      '       dlc.cro ,'
      ''
      '       /*'
      
        '       case when substring(dic.cod_tot_parc,1,2)='#39'00'#39' then cast(' +
        #39'01'#39' as char(2))||cast(substring(dic.cod_tot_parc,3,5) as char(5' +
        '))'
      '       else dic.cod_tot_parc end as cod_tot_parc,'
      '       */'
      ''
      '       dic.cod_tot_parc,'
      ''
      '       rzd.datamovimento as dt_doc,'
      '       dlc.crz'
      ''
      'from dadositemcupom dic'
      '     join dadoscupom dc'
      '       on dc.filial = dic.filial'
      '       and dc.num_usu = dic.num_usu'
      '       and dc.num_fab = dic.num_fab'
      '       and dc.cro = dic.cro'
      '       and dc.coo = dic.coo'
      ''
      '       join detalhecupom dlc'
      '         on dc.filial = dlc.filial'
      '         and dc.num_usu = dlc.num_usu'
      '         and dc.num_fab = dlc.num_fab'
      '         and dc.cro = dlc.cro'
      '         and dc.coo = dlc.coo'
      ''
      '       join reducoeszdetalhes rzd'
      '         on rzd.filial = dlc.filial'
      '         and rzd.numerousuario = dlc.num_usu'
      '         and rzd.numerofabricacao = dlc.num_fab'
      '         and rzd.cro = dlc.cro'
      '         and rzd.tipototalizadorparcial = dic.cod_tot_parc'
      '         '
      '       join reducoesz rz'
      '         on rzd.filial = rz.filial'
      '         and rzd.numerousuario = rz.numerousuario'
      '         and rzd.numerofabricacao = rz.numerofabricacao'
      '         and rzd.cro = rz.cro'
      '         and rzd.datamovimento = rz.datamovimento'
      '         and dlc.crz = rz.crz'
      ''
      ''
      
        '/*where cast(dlc.dt_ini as date) between :datainicial and :dataf' +
        'inal*/'
      'where rz.datamovimento between :datainicial and :datafinal'
      '  and dlc.canc='#39'N'#39
      '  and dic.ind_canc='#39'N'#39
      '  and rz.filial = :filial'
      ''
      'order by dlc.filial    ,'
      '         dlc.num_usu   ,  dlc.num_fab,'
      '         dlc.cro       ,'
      '/*         dlc.dt_ini    ,*/'
      '         dic.cod_tot_parc,'
      '         rzd.datamovimento'
      ') as Itens'
      ''
      'group by cod_item,'
      '         un_med,'
      '         filial,'
      '         num_usu, num_fab,'
      '         cro,'
      '         cod_tot_parc,'
      '         dt_doc,'
      '         crz'
      ''
      'order by filial    ,'
      '         num_usu   , num_fab,'
      '         cro       ,'
      '         crz,'
      '         dt_doc,'
      '         cod_tot_parc'
      ''
      '')
    RequestLive = False
    Left = 256
    Top = 416
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroC425cod_item: TStringField
      FieldName = 'cod_item'
      Size = 60
    end
    object qryRegistroC425qtde_item: TFloatField
      FieldName = 'qtde_item'
      DisplayFormat = '0.00'
    end
    object qryRegistroC425un_med: TStringField
      FieldName = 'un_med'
      Size = 3
    end
    object qryRegistroC425vl_tot_item: TFloatField
      FieldName = 'vl_tot_item'
      DisplayFormat = '0.00'
    end
    object qryRegistroC425filial: TIntegerField
      FieldName = 'filial'
      Required = True
      DisplayFormat = '0'
    end
    object qryRegistroC425num_usu: TIntegerField
      FieldName = 'num_usu'
      DisplayFormat = '0'
    end
    object qryRegistroC425cro: TIntegerField
      FieldName = 'cro'
      DisplayFormat = '0'
    end
    object qryRegistroC425cod_tot_parc: TStringField
      FieldName = 'cod_tot_parc'
      Size = 7
    end
    object qryRegistroC425dt_doc: TDateField
      Alignment = taCenter
      FieldName = 'dt_doc'
      Required = True
      EditMask = '99/99/9999;1; '
    end
    object qryRegistroC425crz: TIntegerField
      FieldName = 'crz'
      DisplayFormat = '0'
    end
    object qryRegistroC425num_fab: TStringField
      FieldName = 'num_fab'
    end
  end
