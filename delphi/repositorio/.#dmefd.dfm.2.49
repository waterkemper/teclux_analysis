  object qryRegistro0190: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select u.codigo as unid,'
      '       u.descricao as descr'
      'from'
      '('
      'select distinct coalesce(c.unidade,'#39'UN'#39') as unidade'
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join produtosdadosfiscais pdf'
      '     on df.numero = pdf.dadofiscal'
      ''
      '     join produtos p on pdf.produto = p.codigo'
      '     join caracteristicas c on p.caracteristica = c.codigo'
      'where df.numero = pdf.dadofiscal'
      '  and df.data between :DataInicial and :DataFinal'
      '/*  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'union'
      ''
      'select distinct coalesce(c.unidade,'#39'UN'#39') as unidade'
      'from notaspag np'
      '     join produtosnotaspag pnp'
      '          join produtos p on pnp.produto = p.codigo'
      '          join caracteristicas c on p.caracteristica = c.codigo'
      ''
      '     on np.codigo = pnp.codigonota'
      ''
      '/*   join produtos p on pnp.produto = p.codigo'
      '     join caracteristicas c on p.caracteristica = c.codigo */'
      ''
      'where np.data between :DataInicial and :DataFinal'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao = '#39'N'#39
      '  and not (np.permitirimprimir and np.modelodocto='#39'55'#39')'
      '  and np.filial = :filial'
      ''
      'union'
      ''
      'Select distinct coalesce(c.unidade,'#39'UN'#39') as unidade'
      'from dadositemcupom dic'
      ''
      '     join dadoscupom dc'
      '       on dc.filial = dic.filial'
      '       and dc.num_usu = dic.num_usu'
      '       and dc.cro = dic.cro'
      '       and dc.coo = dic.coo'
      ''
      '       join detalhecupom dlc'
      '         on dc.filial = dlc.filial'
      '         and dc.num_usu = dlc.num_usu'
      '         and dc.cro = dlc.cro'
      '         and dc.coo = dlc.coo'
      ''
      ''
      '     join produtos p on dic.cod_item = cast(p.codigo as varchar)'
      '     join caracteristicas c on p.caracteristica = c.codigo'
      ''
      ''
      ''
      
        'where cast(dlc.dt_ini as date) between :datainicial and :datafin' +
        'al'
      '  and dc.filial = :filial'
      ''
      'union'
      ''
      ' select distinct coalesce(c.unidade,'#39'UN'#39') as unidade'
      ' from'
      ' ('
      ' select ep.*,'
      ' m2.valor,'
      ' m2.quantidade as qtdUltimaEntrada'
      ' from'
      ' ('
      ' select'
      ' e.codigofilial,'
      ' e.codigoitem,'
      ' e.localizacao,'
      
        ' e.precocomicms, /*,estoques_preco(e.produto,e.filial) as precov' +
        'enda*/'
      ' m.emestoque,'
      ' m.reservado,'
      ' m.transito,'
      ' m.demonstracao,'
      ' m.conserto,'
      ' m.danificada,'
      ' m.reservaprevia,'
      ' m.estoquefisico,'
      ' m.financeiro as Custo_Medio'
      ' from'
      ' ('
      ' select m.numero,'
      ' e.filial as codigofilial,'
      ' e.produto as codigoitem,'
      ' e.localizacao,'
      ' e.precocomicms'
      ' from'
      ' ('
      ''
      ' select m2.numero, m1.produto, m1.filial'
      ' from'
      ' ('
      ' select m1.data, m1.produto, m1.filial,'
      ' (select max(m2.lancto)'
      ' from movimentos m2'
      ' where m2.produto = m1.produto'
      ' and m2.filial = m1.filial'
      ' and m2.data = m1.data) as lancto'
      ' from'
      ' ('
      ' select max(m1.data) as data, m1.produto, m1.filial'
      ' from movimentos m1'
      ' where m1.data < (cast(:datainventario as date)+1)'
      '   and :IncluirInventario'
      ' group by m1.produto, m1.filial'
      ' order by m1.produto, m1.filial'
      ' ) as m1'
      
        ' ) as m1 join movimentos m2 on m1.data = m2.data and m1.lancto =' +
        ' m2.lancto and m1.produto = m2.produto and m1.filial = m2.filial'
      
        ' ) as m join estoques e on m.produto = e.produto and m.filial = ' +
        'e.filial'
      
        ' Where (e.filial = :filial) /* WHERE ESTOQUE where e.produto =0 ' +
        '*/'
      ''
      ' ) as e join movimentos m on e.numero = m.numero'
      ' and m.financeiro<>0 /*and m1.financeiro<>0*/'
      
        ' ) as ep LEFT JOIN movimentos m2 ON m2.produto = ep.codigoitem A' +
        'ND'
      ' m2.filial = ep.codigofilial and'
      ' m2.numero = (SELECT max(m.numero)'
      ' from movimentos m'
      ' where m.produto=ep.codigoitem and'
      ' m.filial=ep.codigofilial and'
      ' m.data < (cast(:datafinal as date)+1) and'
      ' substring(m.operacao from 12 for 1)='#39'+'#39')'
      ''
      ' ) as ep'
      ' JOIN ( produtos p'
      '       JOIN caracteristicas c'
      '       ON p.caracteristica=c.codigo)'
      ' ON p.codigo = ep.codigoitem'
      ''
      
        ' where true /* ((not (c.inativo is not null)) or (c.inativo> :da' +
        'tafinal)) */'
      
        '  and coalesce(((SUBSTRING((SELECT f.Razao FROM Filiais f WHERE ' +
        'f.Codigo = 1) FROM 1 FOR 15) = '#39'KRAH-ICE-BRASIL'#39' AND c.Grupo IN ' +
        '('#39'CERA'#39', '#39'EMB'#39', '#39'MTPR'#39','#39'ZFD'#39','#39'ZKVW'#39','#39'KFG'#39','#39'SUP'#39','#39'FD'#39','#39'FK'#39','#39'GWW'#39',' +
        #39'PORC'#39','#39'FKD'#39','#39'KKD'#39','#39'ZZFD'#39','#39'SUBP'#39','#39'GERL'#39')) or'
      
        '      (SUBSTRING((SELECT f.Razao FROM Filiais f WHERE f.Codigo =' +
        ' 1) FROM 1 FOR 15) <> '#39'KRAH-ICE-BRASIL'#39')),true)'
      
        '   and (ep.emestoque+ep.reservado+ep.transito+ep.demonstracao+ep' +
        '.conserto+ep.danificada+ep.reservaprevia)>0'
      ''
      '  and c.tipoproduto in ('#39'00'#39','#39'01'#39','#39'02'#39','#39'03'#39','#39'04'#39','#39'05'#39','#39'06'#39')'
      ''
      ''
      ''
      
        ') as unidadesprodutos join unidades u on unidadesprodutos.unidad' +
        'e = u.codigo'
      'where unidadesprodutos.unidade = u.codigo')
    RequestLive = False
    Left = 260
    Top = 23
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DataInicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainventario'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IncluirInventario'
        ParamType = ptUnknown
      end>
  end
  object qryRegistro0200: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '('
      'select distinct'
      
        '       cast(('#39'S'#39'||cast(sdf.servico as varchar)) as varchar(60)) ' +
        'as cod_item,'
      '       (select s.descricao'
      '        from servicos s'
      '        where s.codigo =  sdf.servico) as descr_item,'
      '       cast(null as varchar(30)) as cod_barra,'
      
        '       cast(null as varchar(60)) as cod_ant_item, /* **n'#227'o exist' +
        'e ** */'
      '       cast('#39'UN'#39' as varchar(6)) as unid_inv,'
      '       cast('#39'02'#39' as varchar(2)) as tipo_item,'
      '       cast(null as varchar(8)) as cod_ncm,'
      '       cast(null as varchar(3)) as ex_ipi,'
      '       cast(0 as integer) as cod_gen,'
      '       (select s.codigolcp116'
      '        from servicos s'
      '        where s.codigo =  sdf.servico) as cod_lst,'
      '       cast(null as numeric(5,2)) as aliq_icms'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join servicosdadosfiscais sdf'
      '     on df.numero = sdf.dadofiscal'
      'where df.numero = sdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '/*  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      ')'
      ''
      'union all'
      ''
      '('
      
        'Select cast(('#39'P'#39'||cast(p.codigo as varchar)) as varchar(60)) as ' +
        'cod_item,'
      '       p.descricao as descr_item,'
      ''
      ' codigobarras(p.codigo) as cod_barra, '
      '        '
      '        '
      ''
      
        '       cast(null as varchar(60)) as cod_ant_item, /* **n'#227'o exist' +
        'e ** */'
      ''
      '       c.unidade as unid_inv,'
      ''
      '       coalesce(c.tipoproduto,'#39'00'#39') as tipo_item,'
      ''
      '      coalesce((select ipi.classificacaofiscal'
      '       from ipi'
      
        '       where ipi.codigo = c.ipi),cast('#39'0'#39' as char(8))) as cod_nc' +
        'm,'
      ''
      '      (select ipi.extipi'
      '       from ipi'
      '       where ipi.codigo = c.ipi) as ex_ipi,'
      ''
      ''
      '      (select case when ipi.genero=0 or ipi.genero is null then'
      
        '                case when trim(substring(coalesce(ipi.classifica' +
        'caofiscal,'#39#39'),1,2))<>'#39#39' then'
      
        '                    cast(trim(substring(coalesce(ipi.classificac' +
        'aofiscal,'#39#39'),1,2)) as integer)'
      '                else'
      '                  cast(null as integer)'
      '                end'
      '              else'
      '                ipi.genero'
      '              end'
      '       from ipi'
      '       where ipi.codigo = c.ipi) as cod_gen,'
      ''
      '       cast(null as varchar(4)) as cod_lst, /* **verificar** */'
      ''
      '      (select ei.valor'
      '       from estadosicms ei'
      '       where icms = c.icms'
      '         and ei.estado = :estado) as aliq_icms'
      ''
      'from produtos p'
      '     join caracteristicas c'
      '     on p.caracteristica = c.codigo'
      '     where p.codigo in ('
      ''
      ''
      'select distinct i.codigobem'
      'from'
      '('
      ''
      
        '/* MOVIMENTO SI os bens entraram antes do periodo de apuracao e ' +
        'possuem saldo a apropriar */'
      ''
      '('
      'select i.codigobem'
      'from'
      '('
      'select i.numero,'
      ' i.codigobem'
      ''
      'from imobilizado i'
      ' join notaspag np'
      ' on i.codigonota = np.codigo'
      ''
      ' join produtosnotaspag pnp'
      ' on pnp.codigonota = i.codigonota'
      ' and pnp.produto = i.codigobem'
      ' and pnp.filial = i. filialcontribuinte'
      ''
      ''
      'where i.data_entrada < :datainicial'
      ' and i.filialcontribuinte =:filial'
      ' and exists (select aii.numeroimobilizado'
      ' from apropriacaoicmsimobilizado aii'
      ' where aii.numeroimobilizado = i.numero'
      ' and aii.periodo between :datainicial and :datafinal'
      ' and aii.dataapropriacao between :datainicial and :datafinal)'
      ') as i join'
      ''
      ' (select i2.numero,'
      ' aii2.sequencia,'
      ' aii2.valor'
      
        ' from imobilizado i2 join apropriacaoicmsimobilizado aii2 on i2.' +
        'numero = aii2.numeroimobilizado'
      ' where aii2.periodo between :datainicial and :datafinal'
      ' and i2.filialcontribuinte = :filial'
      
        ' and aii2.dataapropriacao between :datainicial and :datafinal) a' +
        's i2 on i.numero = i2.numero'
      ')'
      ''
      'union'
      ''
      
        '/* MOVIMENTO IM o bem entrou no periodo de apura'#231#227'o e n'#227'o '#233' tran' +
        'sf. do ativo circulante*/'
      ''
      '('
      'select I.codigobem'
      ''
      'from imobilizado i'
      ' join apropriacaoicmsimobilizado aii'
      ' on i.numero = aii.numeroimobilizado'
      ''
      ' join notaspag np'
      ' on i.codigonota = np.codigo'
      ''
      ' join produtosnotaspag pnp'
      ' on pnp.codigonota = i.codigonota'
      ' and pnp.produto = i.codigobem'
      ' and pnp.filial = i. filialcontribuinte'
      ''
      'where i.data_entrada between :datainicial and :datafinal'
      ' and i.filialcontribuinte = :filial'
      ' and aii.periodo between :datainicial and :datafinal'
      ' and aii.dataapropriacao between :datainicial and :datafinal'
      ' and not exists (select pnp.codigonota'
      ' from notaspag np'
      ' join produtosnotaspag pnp'
      ' on np.codigo = pnp.codigonota'
      ' where np.codigo = pnp.codigonota'
      ' and i.codigonota = np.codigo'
      ' /*'
      ' and i.fornecedor_entrada = np.fornecedor'
      ' and i.tipofornecedor_entrada = np.tipofornecedor'
      ' and i.serie_entrada = np.serie'
      ' and i.numero_entrada = np.numero'
      ' */'
      ' and pnp.produto = i.codigobem'
      ' and pnp.filial = i.filialcontribuinte'
      ' /*and i.numitemdocfiscal = pnp.numero*/'
      ' and mod(pnp.codigofiscal,1000)=552'
      ' and np.data between :datainicial and :datafinal)'
      ')'
      ''
      'UNION'
      ''
      '('
      
        '/* MOVIMENTO MC o bem entrou no periodo de apura'#231#227'o e '#233' transf. ' +
        'do ativo circulante*/'
      'select i.codigobem'
      ''
      'from imobilizado i'
      ' join notaspag np on i.codigonota = np.codigo'
      ' /*i.fornecedor_entrada = np.fornecedor'
      ' and i.tipofornecedor_entrada = np.tipofornecedor'
      ' and i.serie_entrada = np.serie'
      ' and i.numero_entrada = np.numero*/'
      ''
      ' join produtosnotaspag pnp on i.codigonota = pnp.codigonota'
      ' and pnp.produto = i.codigobem'
      ' and pnp.filial = i.filialcontribuinte'
      ' /*and i.numitemdocfiscal = pnp.numero*/'
      ''
      
        ' join apropriacaoicmsimobilizado aii on i.numero = aii.numeroimo' +
        'bilizado'
      ''
      'where i.data_entrada between :datainicial and :datafinal'
      ' and i.filialcontribuinte = :filial'
      ' and np.data between :datainicial and :datafinal'
      ' and aii.periodo between :datainicial and :datafinal'
      ' and aii.dataapropriacao between :datainicial and :datafinal'
      ' and mod(np.codigofiscal,1000)=552'
      ')'
      ''
      ') as i'
      ''
      'UNION'
      ''
      'select i.codigobem'
      ''
      'from imobilizado i'
      ' join apropriacaoicmsimobilizado aii'
      ' on i.numero = aii.numeroimobilizado'
      ''
      ' join dadosfiscais df'
      ' join notas n'
      ' on n.dadofiscal = df.numero'
      ' on i.dadofiscal = df.numero'
      ''
      ' join produtosdadosfiscais pdf'
      ' on pdf.dadofiscal = i.dadofiscal'
      ' and pdf.produto = i.codigobem'
      ' and pdf.filial = i.filialcontribuinte'
      ''
      ''
      'where i.data_saida between :datainicial and :datafinal'
      ' and i.filialcontribuinte = :filial'
      ' and aii.periodo between :datainicial and :datafinal'
      ' and aii.dataapropriacao between :datainicial and :datafinal'
      
        ' and (n.filial,n.serie) in (select sf.filial,sf.valor from serie' +
        'sfiliais sf where sf.ativa)'
      ''
      'union'
      ''
      'select pdf.produto'
      'from dadosfiscais df'
      ''
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join produtosdadosfiscais pdf'
      '     on df.numero = pdf.dadofiscal'
      ''
      '          join produtos p'
      '            on pdf.produto = p.codigo'
      ''
      '            join caracteristicas c'
      '            on p.caracteristica = c.codigo'
      ''
      'where df.numero = pdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '/*  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '  and n.dadofiscalvinculado is null'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'union'
      ''
      '  select pdf.produto'
      ''
      '  from ((dadosfiscais df'
      '         join (produtosdadosfiscais pdf'
      '              join efd_t53'
      #9#9#9'  on pdf.codigo_efd_t53 = efd_t53.codigo)'
      '         on df.numero = pdf.dadofiscal)'
      ''
      #9#9' join notas n'
      #9#9' on df.numero = n.dadofiscal)'
      ''
      '  where df.data between :DataInicial and :DataFinal'
      '    and df.filialemissao = :filial'
      '    and df.situacao = '#39'N'#39
      '    and n.dadofiscalvinculado is null'
      
        '    and (case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') ' +
        'and not pdf.naoGerarDebitoICMS then pdf.icmsvalor else 0 end)<>0'
      
        #9'and (n.filial,n.serie) in (select sf.filial,sf.valor from serie' +
        'sfiliais sf where sf.ativa)'
      
        '  and (select coalesce(f.contribipi,false) from filiais f where ' +
        'f.codigo = :filial)'
      ''
      'union'
      ''
      'select pnp.produto'
      'from notaspag np'
      '     join produtosnotaspag pnp'
      '       on np.codigo = pnp.codigonota'
      ''
      '      join produtos p'
      '        on pnp.produto = p.codigo'
      ''
      '        join caracteristicas c'
      '        on p.caracteristica = c.codigo'
      ''
      'where np.codigo = pnp.codigonota'
      '  and np.data between :datainicial and :datafinal'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao='#39'N'#39
      '  and not (np.permitirimprimir and np.modelodocto='#39'55'#39')'
      '  and np.filial = :filial'
      ''
      ''
      ''
      'union'
      ''
      'Select cast(dic.cod_item as bigint)'
      'from dadositemcupom dic'
      ''
      '    join produtos p'
      '      on dic.cod_item = cast(p.codigo as varchar)'
      ''
      '      join caracteristicas c'
      '      on p.caracteristica = c.codigo'
      ''
      '     join dadoscupom dc'
      '       on dc.filial = dic.filial'
      '       and dc.num_usu = dic.num_usu'
      '       and dc.cro = dic.cro'
      '       and dc.coo = dic.coo'
      ''
      '       join detalhecupom dlc'
      '         on dc.filial = dlc.filial'
      '         and dc.num_usu = dlc.num_usu'
      '         and dc.cro = dlc.cro'
      '         and dc.coo = dlc.coo'
      ''
      
        'where cast(dlc.dt_ini  as date) between :datainicial and :datafi' +
        'nal'
      '  and dlc.canc='#39'N'#39
      '  and dic.ind_canc='#39'N'#39
      '  and dc.filial = :filial'
      ''
      'union'
      ''
      'select t.codigoitem as cod_item'
      'from'
      '('
      'SELECT t.*'
      'from'
      '(SELECT ep.codigoitem,'
      ' ep.unidade,'
      
        ' (ep.emestoque+ep.reservado+ep.transito+ep.demonstracao+ep.conse' +
        'rto+ep.danificada+ep.reservaprevia) AS qtdestoque,'
      ' custo_medio as vl_item,'
      ' coalesce(subconta,0) as cod_cta'
      'FROM'
      ' ('
      ' select ep.*,'
      
        ' (select i.classificacaofiscal from ipi i where i.codigo = c.ipi' +
        ') as classificacaofiscal,'
      ' cl.descricao AS classeproduto,'
      ' cl.codigo AS codigoclasse,'
      ' g.descricao AS grupoproduto,'
      ' g.codigo AS codigogrupo,'
      ' c.descricao AS produto,'
      ' c.codigo AS codigoproduto,'
      
        ' cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||coalesc' +
        'e(p.valorgrade2,'#39#39') as varchar) AS item,'
      ' ma.descricao AS marca, p.referencia,'
      ' c.unidade,'
      ' c.subconta'
      ' from'
      ' ('
      ' select ep.*,'
      ' m2.valor,'
      ' m2.quantidade as qtdUltimaEntrada'
      ' from'
      ' ('
      ' select'
      ' e.codigofilial,'
      ' e.codigoitem,'
      ' e.localizacao,'
      
        ' e.precocomicms, /*,estoques_preco(e.produto,e.filial) as precov' +
        'enda*/'
      ' m.emestoque,'
      ' m.reservado,'
      ' m.transito,'
      ' m.demonstracao,'
      ' m.conserto,'
      ' m.danificada,'
      ' m.reservaprevia,'
      ' m.estoquefisico,'
      ' m.financeiro as Custo_Medio'
      ' from'
      ' ('
      ' select m.numero,'
      ' e.filial as codigofilial,'
      ' e.produto as codigoitem,'
      ' e.localizacao,'
      ' e.precocomicms'
      ' from'
      ' ('
      ''
      ' select m2.numero, m1.produto, m1.filial'
      ' from'
      ' ('
      ' select m1.data, m1.produto, m1.filial,'
      ' (select max(m2.lancto)'
      ' from movimentos m2'
      ' where m2.produto = m1.produto'
      ' and m2.filial = m1.filial'
      ' and m2.data = m1.data) as lancto'
      ' from'
      ' ('
      ' select max(m1.data) as data, m1.produto, m1.filial'
      ' from movimentos m1'
      ' where m1.data < (cast(:datainventario as date)+1)'
      '   and :IncluirInventario'
      ' group by m1.produto, m1.filial'
      ' order by m1.produto, m1.filial'
      ' ) as m1'
      
        ' ) as m1 join movimentos m2 on m1.data = m2.data and m1.lancto =' +
        ' m2.lancto and m1.produto = m2.produto and m1.filial = m2.filial'
      
        ' ) as m join estoques e on m.produto = e.produto and m.filial = ' +
        'e.filial'
      
        ' Where (e.filial = :filial ) /* WHERE ESTOQUE where e.produto =0' +
        ' */'
      ''
      ' ) as e join movimentos m on e.numero = m.numero'
      ' and m.financeiro<>0 /*and m1.financeiro<>0*/'
      
        ' ) as ep LEFT JOIN movimentos m2 ON m2.produto = ep.codigoitem A' +
        'ND'
      ' m2.filial = ep.codigofilial and'
      ' m2.numero = (SELECT max(m.numero)'
      ' from movimentos m'
      ' where m.produto=ep.codigoitem and'
      ' m.filial=ep.codigofilial and'
      ' m.data < (cast(:datainventario as date)+1) and'
      ' substring(m.operacao from 12 for 1)='#39'+'#39')'
      ''
      ' ) as ep'
      ' JOIN ( produtos p'
      ' JOIN (((caracteristicas c'
      ' JOIN grupos g'
      ' ON c.grupo = g.codigo)'
      ' JOIN classes cl'
      ' ON c.classe=cl.codigo)'
      ' JOIN marcas ma'
      ' ON c.marca=ma.codigo)'
      ' ON p.caracteristica=c.codigo)'
      ' ON p.codigo = ep.codigoitem'
      
        ' where true /* ((not (c.inativo is not null)) or (c.inativo>:dat' +
        'ainventario)) */'
      ''
      
        ' and  coalesce(((SUBSTRING((SELECT f.Razao FROM Filiais f WHERE ' +
        'f.Codigo = 1) FROM 1 FOR 15) = '#39'KRAH-ICE-BRASIL'#39' AND c.Grupo IN ' +
        '('#39'CERA'#39', '#39'EMB'#39', '#39'MTPR'#39','#39'ZFD'#39','#39'ZKVW'#39','#39'KFG'#39','#39'SUP'#39','#39'FD'#39','#39'FK'#39','#39'GWW'#39',' +
        #39'PORC'#39','#39'FKD'#39','#39'KKD'#39','#39'ZZFD'#39','#39'SUBP'#39','#39'GERL'#39')) or'
      
        '      (SUBSTRING((SELECT f.Razao FROM Filiais f WHERE f.Codigo =' +
        ' 1) FROM 1 FOR 15) <> '#39'KRAH-ICE-BRASIL'#39')),true)'
      '      '
      ' and c.tipoproduto in ('#39'00'#39','#39'01'#39','#39'02'#39','#39'03'#39','#39'04'#39','#39'05'#39','#39'06'#39')'
      ''
      ') as EP'
      'Order BY item, codigoitem'
      ') as T'
      ' WHERE qtdestoque>0'
      ') as t'
      '   '
      '   '
      ')'
      ')'
      'order by cod_item'
      '')
    RequestLive = False
    Left = 348
    Top = 23
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'estado'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainventario'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'IncluirInventario'
        ParamType = ptUnknown
      end>
  end
  object ACBrSPEDFiscal: TACBrSPEDFiscal
    Path = 'C:\Arquivos de programas\Borland\Delphi6\Bin\'
    Delimitador = '|'
    ReplaceDelimitador = False
    TrimString = True
    CurMascara = '#0.00'
    OnError = ACBrSPEDFiscalError
    Left = 656
    Top = 512
  end
  object qryRegistro0400: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select n.codigo,'
      '       RetiraBrancoePipeeASCII255(n.descricao) as descricao'
      'from naturezas n'
      'where n.codigo in ('
      '  select pdf.natureza as cod_nat'
      '  from dadosfiscais df'
      '       join notas n'
      '       on df.numero = n.dadofiscal'
      ''
      '       join produtosdadosfiscais pdf'
      '       on df.numero = pdf.dadofiscal'
      '  where df.numero = pdf.dadofiscal'
      '    and df.data between :datainicial and :datafinal'
      '/*    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '    and df.CodigoFiscal < 8000'
      '    and df.situacao = '#39'N'#39
      '    and df.filialemissao = :filial'
      '    and not coalesce(df.notavinculada,false)'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      ''
      '  union'
      ''
      '  select sdf.natureza as cod_nat'
      '  from dadosfiscais df'
      '       join notas n'
      '       on df.numero = n.dadofiscal'
      ''
      '       join servicosdadosfiscais sdf'
      '            join servicos s'
      '            on sdf.servico = s.codigo'
      '       on df.numero = sdf.dadofiscal'
      '  where df.numero = sdf.dadofiscal'
      '    and df.data between :datainicial and :datafinal'
      '/*    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '    and df.CodigoFiscal < 8000'
      '    and df.situacao = '#39'N'#39
      '    and df.filialemissao = :filial'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      ''
      '  union'
      ''
      '  select pnp.natureza as cod_nat'
      ''
      '  from notaspag np'
      '       join produtosnotaspag pnp'
      '       on np.codigo = pnp.codigonota'
      '  where np.codigo = pnp.codigonota'
      '    and np.data between :datainicial and :datafinal'
      '    and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '    and np.situacao = '#39'N'#39
      '    and not (np.permitirimprimir and np.modelodocto='#39'55'#39')'
      '    and np.filial = :filial'
      ''
      ''
      ''
      ')'
      'order by n.codigo'
      '')
    RequestLive = False
    Left = 524
    Top = 22
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
  end
  object qryRegistro0450: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select informacoes.txt'
      'from'
      '('
      
        '  select cast(RetiraBrancoePipeeASCII255(observacoes) as varchar' +
        '(255)) as txt'
      '  from notaspag'
      '  where observacoes is not null'
      '    and (btrim(observacoes)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      
        '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39','#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39',' +
        #39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39','#39'21'#39','#39'22'#39')'
      '    and situacao='#39'N'#39
      '    and not (permitirimprimir and modelodocto='#39'55'#39')'
      '    and filial = :filial'
      ''
      '  group by observacoes'
      ''
      '  union'
      ''
      
        '  select cast(RetiraBrancoePipeeASCII255(infcomplementar) as var' +
        'char(255)) as txt'
      '  from notaspag'
      '  where infcomplementar is not null'
      '    and (btrim(infcomplementar)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39','#39'07'#39','#39'21'#39','#39'22'#39')'
      '    and situacao='#39'N'#39
      '    and not (permitirimprimir and modelodocto='#39'55'#39')'
      '    and filial = :filial'
      ''
      ''
      '  group by infcomplementar'
      ''
      '  union'
      ''
      
        '  select cast(RetiraBrancoePipeeASCII255(observacoes) as varchar' +
        '(255)) as txt'
      
        '  from dadosfiscais join notas n on dadosfiscais.numero = n.dado' +
        'fiscal'
      '  where observacoes is not null'
      '    and (btrim(observacoes)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      '/*    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '    and CodigoFiscal < 8000'
      '    and situacao = '#39'N'#39
      '    and filialemissao = :filial'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      ''
      ''
      '  group by observacoes'
      ''
      '  union'
      ''
      
        '  select cast(RetiraBrancoePipeeASCII255(observacoescomplementar' +
        ') as varchar(255)) as txt'
      
        '  from dadosfiscais join notas n on dadosfiscais.numero = n.dado' +
        'fiscal'
      '  where observacoescomplementar is not null'
      '    and (btrim(observacoescomplementar)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      '/*   and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '    and situacao = '#39'N'#39
      '    and CodigoFiscal < 8000'
      '    and filialemissao = :filial'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      '  group by observacoescomplementar'
      ''
      '  union'
      ''
      
        '  select cast(RetiraBrancoePipeeASCII255(infcomplementar) as var' +
        'char(255)) as txt'
      
        '  from dadosfiscais join notas n on dadosfiscais.numero = n.dado' +
        'fiscal'
      '  where infcomplementar is not null'
      '    and (btrim(infcomplementar)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      '/*    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39') */'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '    and situacao = '#39'N'#39
      '    and CodigoFiscal < 8000'
      '    and filialemissao = :filial'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      ''
      '  group by infcomplementar'
      ''
      '  union all'
      ''
      
        '  select cast(:ctREFERENTECUPOMFISCAL||cast(c.numero as varchar)' +
        ' as varchar(255)) as txt'
      '  from (dadosfiscais df'
      '        join (notas n'
      '              join cupons c'
      '              on n.dadofiscalvinculado = c.dadofiscal)'
      '        on df.numero = n.dadofiscal)'
      '  where df.data between :datainicial and :datafinal'
      '/*    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '    and situacao = '#39'N'#39
      '    and CodigoFiscal < 8000'
      '    and df.filialemissao = :filial'
      ''
      ''
      ') as informacoes'
      'order by txt')
    RequestLive = False
    Left = 609
    Top = 22
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ctREFERENTECUPOMFISCAL'
        ParamType = ptUnknown
      end>
    object qryRegistro0450txt: TStringField
      FieldName = 'txt'
      Size = 255
    end
  end
  object qryRegistro0460: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select txt'
      'from'
      '('
      
        'select cast(RetiraBrancoePipeeASCII255(ObsLivroEntrada) as varch' +
        'ar(255)) as txt'
      'from notaspag'
      'where ObsLivroEntrada is not null'
      '  and (btrim(ObsLivroEntrada)<>'#39#39')'
      '  and data between :datainicial and :datafinal'
      '  and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and situacao='#39'N'#39
      '  and not (permitirimprimir and modelodocto='#39'55'#39')'
      '  and filial = :filial'
      ''
      'group by ObsLivroEntrada'
      ''
      ' union'
      ' '
      
        '  select cast(RetiraBrancoePipeeASCII255(efd_t53.DescricaoLei) a' +
        's varchar(255)) as txt_compl'
      ''
      '  from ((dadosfiscais df'
      '         join (produtosdadosfiscais pdf'
      '              join efd_t53'
      #9#9#9'  on pdf.codigo_efd_t53 = efd_t53.codigo)'
      '         on df.numero = pdf.dadofiscal)'
      ''
      #9#9' join notas n'
      #9#9' on df.numero = n.dadofiscal)'
      ''
      '  where df.data between :DataInicial and :DataFinal'
      '    and df.filialemissao = :filial'
      '    and df.situacao = '#39'N'#39
      '    and n.dadofiscalvinculado is null'
      
        '    and (case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') ' +
        'and not pdf.naoGerarDebitoICMS then pdf.icmsvalor else 0 end)<>0'
      
        #9'and (n.filial,n.serie) in (select sf.filial,sf.valor from serie' +
        'sfiliais sf where sf.ativa)'
      ''
      ' union'
      ' '
      
        'SELECT cast(RetiraBrancoePipeeASCII255(observacao) as varchar(25' +
        '5)) as txt'
      'FROM'
      '('
      '  ('
      '   SELECT'
      
        '    case When cdf.CodigoFiscal in (5929,6929) then '#39'CF M-'#39'||trim' +
        '(cast(c.maquina as varchar))||'#39' '#39'||btrim(cast(c.numero as varcha' +
        'r))||'#39' '#39'||substr(df.observacoes,0,strpos(df.observacoes,chr(13))' +
        ')'
      
        '           else  substr(df.observacoes,0,strpos(df.observacoes,c' +
        'hr(13))) end as observacao'
      '   FROM ((dadosfiscais df'
      '           join (notas n'
      '                 left join cupons c'
      '                 on c.dadofiscal=n.dadofiscalvinculado)'
      ''
      '           on df.numero = n.dadofiscal)'
      ''
      
        '           join (select * from calculosdadosfiscais_(cast(:DataI' +
        'nicial as date),cast(:DataFinal as date))) cdf'
      '           on df.numero=cdf.dadofiscal)'
      ''
      ''
      '   Where cdf.tipo='#39'M'#39
      '    and cdf.codigofiscal not in (5933,6933,7933)'
      '    and df.data between (:DataInicial) and (:DataFinal)'
      '/*    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '    and df.CodigoFiscal < 8000'
      '    and df.situacao = '#39'N'#39
      '    and df.filialemissao = :filial'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      '  )'
      '  union'
      '  ('
      '   SELECT'
      
        '    case When cdf.CodigoFiscal in (5929,6929) then '#39'CF M-'#39'||btri' +
        'm(cast(c.maquina as varchar))||'#39' '#39'||btrim(cast(c.numero as varch' +
        'ar))||'#39' '#39'||substr(df.observacoes,0,strpos(df.observacoes,chr(13)' +
        '))'
      
        '            else  substr(df.observacoes,0,strpos(df.observacoes,' +
        'chr(13))) end as observacao'
      ''
      '   FROM ((dadosfiscais df'
      '           join (notas n'
      '                 left join cupons c'
      '                 on c.dadofiscal=n.dadofiscalvinculado)'
      ''
      '           on df.numero = n.dadofiscal)'
      ''
      
        '           join (select * from calculosdadosfiscais_(cast(:DataI' +
        'nicial as date),cast(:DataFinal as date))) cdf'
      '           on df.numero=cdf.dadofiscal)'
      ''
      '   Where cdf.tipo = '#39'S'#39
      '    and df.data between (:DataInicial) and (:DataFinal)'
      '/*    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '    and df.CodigoFiscal < 8000'
      '    and df.situacao = '#39'N'#39
      '    and df.filialemissao = :filial'
      
        '    and (n.filial,n.serie) in (select sf.filial,sf.valor from se' +
        'riesfiliais sf where sf.ativa)'
      ''
      '  )'
      '  union'
      '  ('
      '   SELECT'
      
        '    case When cdf.CodigoFiscal=5929 then '#39'NF S-'#39'||btrim(n.serie)' +
        '||'#39' '#39'||btrim(cast(n.numero as varchar))||'#39' '#39'||substr(df.observac' +
        'oes,0,strpos(df.observacoes,chr(13)))'
      
        '            else  substr(df.observacoes,0,strpos(df.observacoes,' +
        'chr(13))) end as observacao'
      '   FROM ((dadosfiscais df'
      '           join (cupons c'
      '                 left join notas n'
      '                 on c.dadofiscal=n.dadofiscalvinculado)'
      ''
      '           on df.numero = c.dadofiscal)'
      ''
      
        '           join (select * from calculosdadosfiscais_(cast(:DataI' +
        'nicial as date),cast(:DataFinal as date))) cdf'
      '           on df.numero=cdf.dadofiscal)'
      ''
      ''
      '   Where cdf.tipo='#39'M'#39
      '    and df.data between (:DataInicial) and (:DataFinal)'
      '/*    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')*/'
      '    and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '    and df.CodigoFiscal < 8000'
      '    and df.situacao = '#39'N'#39
      '    and df.filialemissao = :filial'
      '    and cdf.CodigoFiscal = 5929'
      ''
      '  )'
      ') as notascalculos'
      ') as obs'
      'where coalesce(btrim(txt),'#39#39')<>'#39#39
      'group by txt'
      'order by txt')
    RequestLive = False
    Left = 697
    Top = 21
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistro0460txt: TStringField
      FieldName = 'txt'
      Size = 255
    end
  end
  object qryRegistroC100: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select df.numero as chave,'
      '       cast(1 as varchar(1)) as ind_oper,'
      '       cast(0 as varchar(1)) as ind_emit,'
      
        '       cast(df.tipocliente||cast(df.cliente as varchar) as varch' +
        'ar(60)) as cod_part,'
      '       df.modelodocto as  cod_mod,'
      
        '       case when df.situacao = '#39'C'#39' '#9#9'       then cast('#39'02'#39' as va' +
        'rchar(2))  /* cancelado    */'
      
        '            when df.situacao = '#39'D'#39'           then cast('#39'04'#39' as v' +
        'archar(2))  /* denegada    */'
      
        '            when df.dadofiscalcomplementar is not null then cast' +
        '('#39'06'#39' as varchar(2))  /* complementar */'
      
        '            /*when df.datasaida > :datafinal             then ca' +
        'st('#39'01'#39' as varchar(2))*/  /* regular extemporaneo */'
      '            when  (mod(df.codigofiscal,1000) = 929) and'
      '                  (select count(*)'
      '                  from cupons cp'
      
        '                  where cp.dadofiscal = n.dadofiscalvinculado)>0' +
        ' then cast('#39'08'#39' as varchar(2)) /* regime especial : cupom vincul' +
        'ado */'
      '       else'
      
        '                                                            cast' +
        '('#39'00'#39' as varchar(2))  /* regular      */'
      '       end as cod_sit,'
      '       n.serie as ser,'
      '       n.numero as num_doc,'
      ''
      '       df.chv_nfe,'
      ''
      '       df.data as dt_doc,'
      '       df.datasaida as dt_e_s,'
      '       df.valortotal as vl_doc,'
      '       case when coalesce((select count(*)'
      '                           from venctosdadosfiscais vdf'
      '                           where vdf.dadofiscal = df.numero'
      '                            and vdf.datavencto > df.data'
      
        '                            limit 1),0)<>0                      ' +
        '  then 1'
      '            when coalesce((select count(*)'
      '                           from venctosdadosfiscais vdf'
      '                           where vdf.dadofiscal = df.numero'
      '                            and vdf.datavencto <= df.data'
      '                            limit 1),0)<>0 '#9#9#9'  then 0'
      #9#9#9#9#9#9#9#9'  else 2'
      '       end as ind_pgto,'
      
        '       coalesce(df.desconto,0)+coalesce((select sum(pdf.valordes' +
        'contoitem) from produtosdadosfiscais pdf where pdf.dadofiscal=df' +
        '.numero),0) as vl_desc,'
      '       cast(0 as numeric(15,2)) as vl_abat_nt,'
      ''
      
        '       /*coalesce(df.valorservicos,0)+coalesce(df.valorprodutos,' +
        '0) as vl_merc,*/'
      
        '       coalesce((select sum((pdf.quantidade * pdf.precovenda) /*' +
        '+'
      
        '                             coalesce(pdf.icmsvalorst,0)        ' +
        '*/'
      '                               /*+'
      '                              coalesce(pdf.frete,0) +'
      '                              coalesce(pdf.seguro,0) +'
      
        '                              coalesce(pdf.despesasacessorias,0)' +
        ' +'
      '                              coalesce(pdf.acrescimo,0) -'
      
        '                              coalesce(pdf.desconto,0)*/ ) from ' +
        'produtosdadosfiscais pdf where pdf.dadofiscal = df.numero),0)  a' +
        's vl_merc,'
      ''
      ''
      ''
      
        '       case when coalesce(df.valorfrete,0)=0                    ' +
        '  then 9       /* sem cobran'#231'a de frete */'
      '            else cast(df.frete as integer)'
      '       end as ind_frt,'
      '       coalesce(df.valorfrete,0) as vl_frt,'
      '       coalesce(df.seguro,0) as vl_seg,'
      ''
      '       coalesce(df.despesasacessorias,0) +'
      '       coalesce(df.totalvaloricmssubstituicao,0) as vl_out_da,'
      ''
      
        '       case when mod(df.codigofiscal,1000)<>411 then coalesce(df' +
        '.baseicms,0)'
      '       else 0.00 end as vl_bc_icms,'
      ''
      
        '       case when mod(df.codigofiscal,1000)<>411 then coalesce(df' +
        '.valoricms,0)'
      '       else 0.00 end as vl_icms,'
      ''
      '       /*'
      
        '       coalesce(df.totalbaseicmssubstituicao,0) as vl_bc_icms_st' +
        ','
      '       coalesce(df.totalvaloricmssubstituicao,0) as vl_icms_st,'
      '       */'
      ''
      '       0.00 as vl_bc_icms_st,'
      '       0.00 as vl_icms_st,'
      ''
      '       coalesce((select sum(cdf.valor)'
      '        from CalculosDadosFiscais_(df.numero, false) cdf'
      '        where cdf.dadofiscal = df.numero'
      '          and cdf.tipo='#39'P'#39'),0) as vl_ipi,'
      ''
      ''
      '       coalesce(df.totalvalorpis,0) as vl_pis,'
      '       coalesce(df.totalvalorcofins,0) as vl_cofins,'
      '       cast(0 as numeric(15,2)) as vl_pis_st,'
      '       cast(0 as numeric(15,2)) as vl_cofins_st'
      ''
      'from (dadosfiscais df'
      '       join notas n'
      '       on df.numero = n.dadofiscal)'
      ''
      'where df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'union all'
      ''
      ''
      'select np.codigo as chave,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       case when permitirimprimir then'
      '            cast(0 as varchar(1))  /* emiss'#227'o pr'#243'pria */'
      '       else cast(1 as varchar(1))  /* terceiros       */'
      '       end as ind_emit,'
      
        '       cast((np.tipofornecedor||cast(np.fornecedor as varchar)) ' +
        'as varchar(60)) as cod_part,'
      '       np.modelodocto as cod_mod,'
      
        '       case when np.situacao = '#39'C'#39' '#9#9'       then cast('#39'02'#39' as va' +
        'rchar(2))  /* cancelado */'
      
        '/*            when np.data > :datasaida                  then ca' +
        'st('#39'01'#39' as varchar(2)) */ /* regular extemporaneo  */'
      
        '       else                                                 cast' +
        '('#39'00'#39' as varchar(2))  /* regular   */'
      '       end as cod_sit,'
      '       np.serie as ser,'
      '       np.numero as num_doc,'
      '       np.chv_nfe as chv_nfe,'
      '       np.emissao as dt_doc,'
      '       np.data as dt_e_s,'
      ''
      '       np.valornota as vl_doc,'
      '       case when coalesce((select count(*)'
      '                           from duplicatas d'
      
        '                           where d.documentopag = np.documentopa' +
        'g'
      '                             and d.datavencto > np.data'
      
        '                            limit 1),0)<>0                      ' +
        '  then 1'
      '            when coalesce((select count(*)'
      '                           from duplicatas d'
      
        '                           where d.documentopag = np.documentopa' +
        'g'
      '                            and d.datavencto <= np.data'
      '                            limit 1),0)<>0 '#9#9#9'  then 0'
      #9#9#9#9#9#9#9#9'  else 2'
      '       end as ind_pgto,'
      
        '       coalesce(np.desconto,0) + coalesce(np.descontoitem,0) as ' +
        'vl_desc,'
      '       cast(0 as numeric(15,2)) as vl_abat_nt,'
      ''
      
        '       coalesce((select sum((pnp.quantidade * pnp.precounitario)' +
        ' /*+'
      '                              coalesce(pnp.frete,0) +'
      '                              coalesce(pnp.seguro,0) +'
      
        '                              coalesce(pnp.despesasacessorias,0)' +
        ' +'
      '                              coalesce(pnp.acrescimo,0) -'
      '                              coalesce(pnp.desconto,0)*/ )'
      '                 from produtosnotaspag pnp'
      '                 where pnp.codigonota = np.codigo),0) +'
      '       coalesce(np.valorservicos,0) as vl_merc,'
      ''
      ''
      
        '       case when np.fornecedortransporte is null                ' +
        '   then 9       /* sem cobran'#231'a de frete */'
      '            else cast(np.frete as integer)'
      '       end as ind_frt,'
      ''
      '       coalesce(np.freteinterno,0) as vl_frt,'
      '       coalesce(np.seguro,0) as vl_seg,'
      
        '       coalesce(np.despesasacessorias,0) + coalesce(np.valoricms' +
        'substituicao,0) as vl_out_da,'
      ''
      '       (select sum(pnp.icmsbasecalculo)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo'
      '          and pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39')'
      '          and not pnp.naogerarcreditoicms'
      '        ) as vl_bc_icms,'
      ''
      '       (select sum(pnp.icmsvalor)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo'
      '          and pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39')'
      '          and not pnp.naogerarcreditoicms'
      '        ) as vl_icms,'
      ''
      '/*       coalesce(np.baseicmssubstituicao,0) as vl_bc_icms_st,'
      '       coalesce(np.valoricmssubstituicao,0) as vl_icms_st,*/'
      ''
      '       0.00 as vl_bc_icms_st,'
      '       0.00 as vl_icms_st,'
      ''
      ''
      '       (select sum(pnp.valoripi)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo'
      
        '          and not coalesce(pnp.naogerarcreditoipi,false)) as vl_' +
        'ipi,'
      ''
      ''
      '       coalesce(np.totalvalorpis,0) as vl_pis,'
      '       coalesce(np.totalvalorcofins,0) as vl_cofins,'
      '       cast(0 as numeric(15,2)) as vl_pis_st,'
      '       cast(0 as numeric(15,2)) as vl_cofins_st'
      ''
      'from notaspag np'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao<>'#39'P'#39
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.filial = :filial'
      '  and exists (select pnp.codigonota'
      '              from produtosnotaspag pnp'
      '              where pnp.codigonota = np.codigo limit 1)')
    RequestLive = False
    Left = 36
    Top = 112
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cupom'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datasaida'
        ParamType = ptUnknown
      end>
