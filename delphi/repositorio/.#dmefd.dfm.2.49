  object qryRegistroC197: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper;txt_compl=txt_compl'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC195
    Constraints = <>
    OnCalcFields = qryRegistroC197CalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '  select df.numero as chave,'
      '        cast(1 as varchar(1)) as ind_oper,'
      
        #9#9'cast(RetiraBrancoePipeeASCII255(efd_t53.DescricaoLei) as varch' +
        'ar(255)) as txt_compl,'
      '    efd_t53.codigo as COD_AJ,'
      
        '    cast(RetiraBrancoePipeeASCII255(efd_t53.descricao) as varcha' +
        'r(255)) as DESCR_COMPL_AJ,'
      
        '    cast(('#39'P'#39'||cast(pdf.produto as varchar)) as varchar(60)) as ' +
        'cod_item,'
      ''
      
        '    case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') and n' +
        'ot pdf.naoGerarDebitoICMS then pdf.icmsbasecalculo else 0 end as' +
        ' vl_bc_icms,'
      
        '    case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') and n' +
        'ot pdf.naoGerarDebitoICMS then pdf.aliquotaicms else 0 end  as a' +
        'liq_icms,'
      
        '    case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') and n' +
        'ot pdf.naoGerarDebitoICMS then pdf.icmsvalor else 0 end as vl_ic' +
        'ms,'
      ''
      '    efd_t53.aliqcredpresumido,'
      '    '
      '    0.00 as VL_OUTROS'
      ''
      '  from ((dadosfiscais df'
      '         join (produtosdadosfiscais pdf'
      '              join efd_t53'
      #9#9#9'  on pdf.codigo_efd_t53 = efd_t53.codigo)'
      '         on df.numero = pdf.dadofiscal)'
      ''
      #9#9' join notas n'
      #9#9' on df.numero = n.dadofiscal)'
      ''
      '  where df.data between :DataInicial and :DataFinal'
      '    and df.filialemissao = :filial'
      '    and df.situacao = '#39'N'#39
      '    and n.dadofiscalvinculado is null'
      
        '    and (case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') ' +
        'and not pdf.naoGerarDebitoICMS then pdf.icmsvalor else 0 end)<>0'
      
        '  '#9'and (n.filial,n.serie) in (select sf.filial,sf.valor from ser' +
        'iesfiliais sf where sf.ativa)'
      '    and coalesce((select f.contribipi'
      '                  from filiais f'
      '                  where f.codigo = df.filialemissao), false)'
      '')
    RequestLive = False
    Left = 755
    Top = 119
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
