  object qryRegistroC590_Copia: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC500
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.codigo as chave,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       (select n.icmscst'
      '        from naturezas n'
      '        where n.codigo = np.natureza) as cst_icms,'
      ''
      '       np.codigofiscal as cfop,'
      ''
      '       (select sum(cnp.base)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '          and cnp.tipo='#39'M'#39') /'
      '       (select sum(cnp.valor)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '         and cnp.tipo='#39'M'#39') as aliq_icms,'
      ''
      '       coalesce(np.valorservicos,0) as vl_opr,'
      ''
      '       (select sum(cnp.base)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '          and cnp.tipo='#39'M'#39') as vl_bc_icms,'
      ''
      '       (select sum(cnp.valor)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '         and cnp.tipo='#39'M'#39') as vl_icms,'
      ''
      '       np.baseicmssubstituicao as vl_bc_icms_st,'
      '       np.valoricmssubstituicao as vl_icms_st'
      ''
      'from notaspag np'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao<>'#39'P'#39
      '  and np.modelodocto in ('#39'06'#39','#39'28'#39')'
      '  and np.filial = :filial')
    RequestLive = False
    Left = 208
    Top = 471
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
  end
  object qryRegistroD100: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.codigo as chave,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       case when permitirimprimir then'
      '            cast(0 as varchar(1))  /* emiss'#227'o pr'#243'pria */'
      '       else cast(1 as varchar(1))  /* terceiros       */'
      '       end as ind_emit,'
      
        '       cast((np.tipofornecedor||cast(np.fornecedor as varchar)) ' +
        'as varchar(60)) as cod_part,'
      '       np.modelodocto as cod_mod,'
      
        '       case when np.situacao = '#39'C'#39' '#9#9'       then cast('#39'02'#39' as va' +
        'rchar(2))  /* cancelado */'
      
        '       else                                                 cast' +
        '('#39'00'#39' as varchar(2))  /* regular   */'
      '       end as cod_sit,'
      '       np.serie as ser,'
      '       cast(null as varchar(4)) as sub,'
      '       np.numero as num_doc,'
      '       np.chv_nfe as chv_cte,'
      '       np.data as dt_doc,'
      '       np.emissao as dt_a_p,'
      '       cast(null as varchar(1)) as TP_CTe,'
      '       cast(null as varchar(44)) as chv_cte_ref,'
      '       np.valornota as vl_doc,'
      '       coalesce(np.desconto,0) as vl_desc,'
      ''
      '       cast(2 as integer) as ind_frt,'
      ''
      '       np.valorservicos as vl_serv,'
      ''
      '       (select sum(cnp.base)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '          and cnp.tipo='#39'M'#39') as vl_bc_icms,'
      ''
      '       (select sum(cnp.valor)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '         and cnp.tipo='#39'M'#39') as vl_icms,'
      ''
      '       (select sum(cnp.isentas)+sum(cnp.outras)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '         and cnp.tipo='#39'M'#39') as vl_nt,'
      ''
      '         /*'
      '       (select sum(pnp.icmsbasecalculo)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo) as vl_bc_icms,'
      ''
      '       (select sum(pnp.icmsvalor)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo) as vl_icms,'
      ''
      '        0.00 as vl_nt,'
      ''
      '        */'
      ''
      
        '       cast(RetiraBrancoePipeeASCII255(np.observacoes) as varcha' +
        'r(255)) as txt,'
      ''
      '       ci.codigoibge as COD_MUN_ORIG'
      ''
      'from notaspag np'
      '     join (vfornecedores vf'
      '           join cidades ci'
      '             on vf.estado = ci.estado'
      '            and vf.cidade = ci.codigo)'
      ''
      '     on np.fornecedor = vf.codigo'
      '     and np.tipofornecedor = vf.tipo'
      ''
      ''
      'where np.data between :datainicial and :datafinal'
      '  and np.filial = :filial'
      '  and np.situacao<>'#39'P'#39
      '  and cast(coalesce(np.modelodocto,'#39'01'#39') as varchar(2)) in'
      '  ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39')')
    RequestLive = False
    Left = 36
    Top = 536
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
