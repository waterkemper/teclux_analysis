  object qryRegistroC190: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC100
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select chave, ind_oper, cst_icms, cfop,aliq_icms,'
      '       sum(vl_opr)        as vl_opr,'
      '       sum(vl_bc_icms)    as vl_bc_icms,'
      '       sum(vl_icms)       as vl_icms,'
      '       sum(vl_bc_icms_st) as vl_bc_icms_st,'
      '       sum(vl_icms_st)    as vl_icms_st,'
      '       sum(vl_red_bc)     as vl_red_bc,'
      '       sum(vl_ipi)        as vl_ipi'
      'from'
      '('
      'select df.numero as chave,'
      '       cast(1 as varchar(1)) as ind_oper,'
      ''
      '       cast(CAST((select c.origem'
      '                     from caracteristicas c'
      '                     where c.codigo = (select p.caracteristica'
      '                                          from produtos p'
      
        '                                          where p.codigo = pdf.p' +
        'roduto)) AS VARCHAR) ||'
      '       pdf.incidencia as varchar(3)) as cst_icms,'
      ''
      '       pdf.codigofiscal   as cfop,'
      ''
      
        '/*   case when pdf.incidencia <> '#39'60'#39' then pdf.aliquotaicms  els' +
        'e 0.00 end  as aliq_icms,*/'
      ''
      
        '       case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') an' +
        'd not pdf.naoGerarDebitoICMS then coalesce(pdf.aliquotaicms,0) e' +
        'lse 0 end  as aliq_icms,'
      ''
      '       (pdf.quantidade * pdf.precovenda) +'
      '        coalesce(pdf.frete,0) +'
      '        coalesce(pdf.seguro,0) +'
      '        coalesce(pdf.despesasacessorias,0) +'
      '        coalesce(pdf.vicmsstretdesp,0) +'
      '        coalesce(pdf.acrescimo,0) -'
      '        coalesce(pdf.valordescontoitem,0) -'
      '        coalesce(pdf.desconto,0) +'
      '        coalesce(pdf.valoripi,0) +'
      '        coalesce(pdf.icmsvalorst,0) as vl_opr,'
      ''
      ''
      
        '       case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') an' +
        'd not pdf.naoGerarDebitoICMS then pdf.icmsbasecalculo else 0 end' +
        ' as vl_bc_icms,'
      
        '       case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') an' +
        'd not pdf.naoGerarDebitoICMS then pdf.icmsvalor else 0 end as vl' +
        '_icms,'
      ''
      '       /*'
      '       pdf.icmsbasecalculost as vl_bc_icms_st,'
      '       pdf.icmsvalorst       as vl_icms_st,'
      '       */'
      ''
      '       0.00 as vl_bc_icms_st,'
      '       0.00 as vl_icms_st,'
      ''
      '       pdf.reducaobase       as vl_red_bc,'
      '       pdf.valoripi          as vl_ipi'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join produtosdadosfiscais pdf'
      '     on df.numero = pdf.dadofiscal'
      'where df.numero = pdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'union all'
      ''
      'select df.numero '#9#9#9'       as chave,'
      '       cast(1 as varchar(1)) '#9#9'       as ind_oper,'
      '       cast('#39'90'#39' as varchar(2)) as cst_icms,'
      '       sdf.codigofiscal         as cfop,'
      '       0.00 as aliq_icms,'
      '       sdf.quantidade * sdf.valorservico         as vl_opr,'
      ''
      '       0.00 as vl_bc_icms,'
      '       0.00 as vl_icms,'
      ''
      '       0.00 as vl_bc_icms_st,'
      '       0.00 as vl_icms_st,'
      ''
      '       0.00 as vl_red_bc,'
      '       0.00 as vl_ipi'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join servicosdadosfiscais sdf'
      '          join servicos s'
      '          on sdf.servico = s.codigo'
      '     on df.numero = sdf.dadofiscal'
      'where df.numero = sdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'union all'
      ''
      'select np.codigo as chave,'
      '       cast(0 as varchar(1)) as ind_oper,'
      ''
      '       cast(CAST((select c.origem'
      '                     from caracteristicas c'
      '                     where c.codigo = (select p.caracteristica'
      '                                          from produtos p'
      
        '                                          where p.codigo = pnp.p' +
        'roduto)) AS VARCHAR) ||'
      '       pnp.incidencia as varchar(3)) as cst_icms,'
      '       pnp.codigofiscal   as cfop,'
      
        '       (coalesce((case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'7' +
        '0'#39','#39'90'#39') and not pnp.naogerarcreditoicms then coalesce(pnp.aliqu' +
        'otaicms,0) else 0 end),0)) as aliq_icms,'
      ''
      ''
      '       case when (pnp.codigofiscal in (3101, 3551,3556)) and'
      
        '                 (np.data > '#39'2010-09-02'#39')  then  /* NF IMPORTA'#199#195 +
        'O KRAH-ICE A PARTIR DE 03/SET/2010*/'
      ''
      '         (pnp.quantidade * pnp.precounitario) +'
      '          coalesce(pnp.frete,0) +'
      '          coalesce(pnp.seguro,0) +'
      '          coalesce(pnp.despesasacessorias,0) +'
      '          coalesce(pnp.acrescimo,0) -'
      '          coalesce(pnp.desconto,0) +'
      '          coalesce(pnp.valoripi,0) +'
      '          coalesce(pnp.icmsvalor,0) +'
      '          coalesce(pnp.iivalor,0) +'
      '          coalesce(pnp.icmsvalorst,0)'
      '       else'
      ''
      '         (pnp.quantidade * pnp.precounitario) +'
      '          coalesce(pnp.frete,0) +'
      '          coalesce(pnp.seguro,0) +'
      '          coalesce(pnp.despesasacessorias,0) +'
      '          coalesce(pnp.acrescimo,0) -'
      '          coalesce(pnp.valordescontoitem,0) -'
      '          coalesce(pnp.desconto,0) +'
      '          coalesce(pnp.valoripi,0) +'
      '          coalesce(pnp.icmsvalorst,0)'
      '        end as vl_opr,'
      ''
      ''
      
        '       (coalesce((case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'7' +
        '0'#39','#39'90'#39') and not pnp.naogerarcreditoicms then pnp.icmsbasecalcul' +
        'o else 0 end),0)) as vl_bc_icms,'
      
        '       (coalesce((case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'7' +
        '0'#39','#39'90'#39') and not pnp.naogerarcreditoicms then pnp.icmsvalor else' +
        ' 0 end),0)) as vl_icms,'
      ''
      '/*'
      '       pnp.icmsbasecalculost as vl_bc_icms_st,'
      '       pnp.icmsvalorst as vl_icms_st,'
      '*/'
      ''
      '       0.00 as vl_bc_icms_st,'
      '       0.00 as vl_icms_st,'
      ''
      '       pnp.valorreducaobase as vl_red_bc,'
      
        '       (coalesce((case when not pnp.naogerarcreditoipi then pnp.' +
        'valoripi       else 0 end),0)) as vl_ipi'
      ''
      ''
      'from notaspag np'
      '     join produtosnotaspag pnp'
      '     on np.codigo = pnp.codigonota'
      'where np.codigo = pnp.codigonota'
      '  and np.data between :datainicial and :datafinal'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao = '#39'N'#39
      '  and np.filial = :filial'
      ') as registro_C190'
      'group by chave, ind_oper, cst_icms, cfop, aliq_icms')
    RequestLive = False
    Left = 550
    Top = 120
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroC190chave: TIntegerField
      FieldName = 'chave'
      DisplayFormat = '0'
    end
    object qryRegistroC190ind_oper: TStringField
      FieldName = 'ind_oper'
      Size = 50
    end
    object qryRegistroC190cst_icms: TStringField
      FieldName = 'cst_icms'
      Size = 50
    end
    object qryRegistroC190cfop: TIntegerField
      FieldName = 'cfop'
      DisplayFormat = '0'
    end
    object qryRegistroC190aliq_icms: TFloatField
      FieldName = 'aliq_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroC190vl_opr: TFloatField
      FieldName = 'vl_opr'
      DisplayFormat = '0.00'
    end
    object qryRegistroC190vl_bc_icms: TFloatField
      FieldName = 'vl_bc_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroC190vl_icms: TFloatField
      FieldName = 'vl_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroC190vl_bc_icms_st: TFloatField
      FieldName = 'vl_bc_icms_st'
      DisplayFormat = '0.00'
    end
    object qryRegistroC190vl_icms_st: TFloatField
      FieldName = 'vl_icms_st'
      DisplayFormat = '0.00'
    end
    object qryRegistroC190vl_red_bc: TFloatField
      FieldName = 'vl_red_bc'
      DisplayFormat = '0.00'
    end
    object qryRegistroC190vl_ipi: TFloatField
      FieldName = 'vl_ipi'
      DisplayFormat = '0.00'
    end
  end
  object qryRegistroC195: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC100
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select chave, ind_oper, txt_compl'
      'from'
      '('
      ' ('
      '  select codigo as chave,'
      '         cast(0 as varchar(1)) as ind_oper,'
      
        '         cast(RetiraBrancoePipeeASCII255(ObsLivroEntrada) as var' +
        'char(255)) as txt_compl'
      '  from notaspag'
      '  where ObsLivroEntrada is not null'
      '    and (btrim(ObsLivroEntrada)<>'#39#39')'
      '    and data between :datainicial and :datafinal'
      '    and modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '    and not (permitirimprimir and modelodocto='#39'55'#39')'
      '    and situacao='#39'N'#39
      '    and filial = :filial'
      ' )'
      ' '
      ' union'
      ''
      ' ( '
      '  select df.numero as chave,'
      '        cast(1 as varchar(1)) as ind_oper,'
      
        #9#9'cast(RetiraBrancoePipeeASCII255(efd_t53.DescricaoLei) as varch' +
        'ar(255)) as txt_compl'
      #9#9
      '  from ((dadosfiscais df '
      '         join (produtosdadosfiscais pdf'
      '              join efd_t53 '
      #9#9#9'  on pdf.codigo_efd_t53 = efd_t53.codigo)'
      '         on df.numero = pdf.dadofiscal)'
      #9#9' '
      #9#9' join notas n'
      #9#9' on df.numero = n.dadofiscal)'
      ''
      '  where df.data between :DataInicial and :DataFinal'
      '    and df.filialemissao = :filial'
      '    and df.situacao = '#39'N'#39
      '    and n.dadofiscalvinculado is null'
      
        '    and (case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') ' +
        'and not pdf.naoGerarDebitoICMS then pdf.icmsvalor else 0 end)<>0'
      
        #9'and (n.filial,n.serie) in (select sf.filial,sf.valor from serie' +
        'sfiliais sf where sf.ativa)'
      ' )'
      ' '
      ' union'
      ' '
      ' ('
      '  SELECT chave, ind_oper,'
      
        '         cast(RetiraBrancoePipeeASCII255(observacao) as varchar(' +
        '255)) as txt_compl'
      '  FROM'
      '  ('
      '   ('
      '    SELECT df.numero as chave,'
      '          cast(1 as varchar(1)) as ind_oper,'
      
        '          case When cdf.CodigoFiscal in (5929,6929) then '#39'CF M-'#39 +
        '||btrim(cast(c.maquina as varchar))||'#39' '#39'||btrim(cast(c.numero as' +
        ' varchar))||'#39' '#39'||substr(df.observacoes,0,strpos(df.observacoes,c' +
        'hr(13)))'
      
        '           else  substr(df.observacoes,0,strpos(df.observacoes,c' +
        'hr(13))) end as observacao'
      '    FROM ((dadosfiscais df'
      '            join (notas n'
      '                  left join cupons c'
      '                  on c.dadofiscal=n.dadofiscalvinculado)'
      ''
      '            on df.numero = n.dadofiscal)'
      ''
      
        '            join (select * from calculosdadosfiscais_(cast(:Data' +
        'Inicial as date),cast(:DataFinal as date))) cdf'
      '            on df.numero=cdf.dadofiscal)'
      ''
      ''
      '    Where cdf.tipo='#39'M'#39
      '      and cdf.codigofiscal not in (5933,6933,7933)'
      '      and df.data between (:DataInicial) and (:DataFinal)'
      '      and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '      and df.CodigoFiscal < 8000'
      '      and df.situacao = '#39'N'#39
      '      and df.filialemissao = :filial'
      
        '      and (n.filial,n.serie) in (select sf.filial,sf.valor from ' +
        'seriesfiliais sf where sf.ativa)'
      '   )'
      '   union'
      '   ('
      '    SELECT df.numero as chave,'
      '          cast(1 as varchar(1)) as ind_oper,'
      
        '    case When cdf.CodigoFiscal in (5929,6929) then '#39'CF M-'#39'||btri' +
        'm(cast(c.maquina as varchar))||'#39' '#39'||btrim(cast(c.numero as varch' +
        'ar))||'#39' '#39'||substr(df.observacoes,0,strpos(df.observacoes,chr(13)' +
        '))'
      
        '            else  substr(df.observacoes,0,strpos(df.observacoes,' +
        'chr(13))) end as observacao'
      ''
      '    FROM ((dadosfiscais df'
      '            join (notas n'
      '                  left join cupons c'
      '                  on c.dadofiscal = n.dadofiscalvinculado)'
      ''
      '            on df.numero = n.dadofiscal)'
      ''
      
        '            join (select * from calculosdadosfiscais_(cast(:Data' +
        'Inicial as date),cast(:DataFinal as date))) cdf'
      '            on df.numero=cdf.dadofiscal)'
      ''
      '    Where cdf.tipo = '#39'S'#39
      '      and df.data between (:DataInicial) and (:DataFinal)'
      '      and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '      and df.CodigoFiscal < 8000'
      '      and df.situacao = '#39'N'#39
      '      and df.filialemissao = :filial'
      
        '      and (n.filial,n.serie) in (select sf.filial,sf.valor from ' +
        'seriesfiliais sf where sf.ativa)'
      '   )'
      '   union'
      '   ('
      '    SELECT df.numero as chave,'
      '          cast(1 as varchar(1)) as ind_oper,'
      
        '    case When cdf.CodigoFiscal=5929 then '#39'NF S-'#39'||btrim(n.serie)' +
        '||'#39' '#39'||btrim(cast(n.numero as varchar))||'#39' '#39'||substr(df.observac' +
        'oes,0,strpos(df.observacoes,chr(13)))'
      
        '            else  substr(df.observacoes,0,strpos(df.observacoes,' +
        'chr(13))) end as observacao'
      '    FROM ((dadosfiscais df'
      '            join (cupons c'
      '                  left join notas n'
      '                  on n.dadofiscalvinculado = c.dadofiscal)'
      ''
      '            on df.numero = c.dadofiscal)'
      ''
      
        '            join (select * from calculosdadosfiscais_(cast(:Data' +
        'Inicial as date),cast(:DataFinal as date))) cdf'
      '            on df.numero=cdf.dadofiscal)'
      ''
      ''
      '    Where cdf.tipo='#39'M'#39
      '      and df.data between (:DataInicial) and (:DataFinal)'
      '      and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39')'
      '      and df.CodigoFiscal < 8000'
      '      and df.situacao = '#39'N'#39
      '      and df.filialemissao = :filial'
      '   )'
      '  ) as notascalculos'
      ' )'
      ') as registro_C195'
      'where coalesce(btrim(txt_compl),'#39#39')<>'#39#39)
    RequestLive = False
    Left = 635
    Top = 119
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
