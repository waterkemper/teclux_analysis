  object qryRegistroC470: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'filial=filial;num_usu=num_usu;num_fab=num_fab;cro=cro;coo=coo'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC460
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cast(('#39'P'#39'||dic.cod_item) as varchar(60)) as cod_item,'
      ''
      '       dic.qtde_item as qtd,'
      ''
      '       case when dic.ind_canc='#39'S'#39' then'
      '         dic.qtde_item'
      '       else'
      '         0.000'
      '       end as qtd_canc,'
      ''
      '       dic.un_med as unid,'
      '       dic.vl_tot_item as vl_item,'
      '       ti.valor as cst_icms,'
      '       5929 as cfop,'
      '       dic.aliq_icms,'
      '       0.00 as vl_pis,'
      '       0.00 as vl_cofins,'
      ''
      '       dic.filial,'
      '       dic.num_usu , dic.num_fab, '
      '       dic.cro ,'
      '       dic.coo'
      ''
      'from dadositemcupom dic'
      '     join produtos p'
      '       on dic.cod_item = cast(p.codigo as varchar)'
      ''
      '       join caracteristicas c'
      '       on p.caracteristica = c.codigo'
      ''
      '       join tributosicms ti'
      '       on c.incidencia = ti.codigo'
      ''
      '     join dadoscupom dc'
      '       on dc.filial = dic.filial'
      '       and dc.num_usu = dic.num_usu'
      '       and dc.num_fab = dic.num_fab'
      '       and dc.cro = dic.cro'
      '       and dc.coo = dic.coo'
      ''
      '       join detalhecupom dlc'
      '         on dc.filial = dlc.filial'
      '         and dc.num_usu = dlc.num_usu'
      '         and dc.num_fab = dlc.num_fab'
      '         and dc.cro = dlc.cro'
      '         and dc.coo = dlc.coo'
      ''
      ''
      
        'where cast(dlc.dt_ini as date) between :datainicial and :datafin' +
        'al'
      '  and dlc.canc = '#39'N'#39
      '  and dc.filial = :filial'
      ''
      'order by dlc.filial    ,'
      '         dlc.num_usu   ,'
      '         dlc.num_fab   ,'
      '         dlc.cro       ,'
      '         dic.coo       ,'
      '         dic.cod_item')
    RequestLive = False
    Left = 360
    Top = 416
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroC470cod_item: TStringField
      FieldName = 'cod_item'
      Size = 60
    end
