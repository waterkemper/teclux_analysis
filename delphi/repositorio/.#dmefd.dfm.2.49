      FieldName = 'cfop'
      DisplayFormat = '0'
    end
    object qryRegistroC390aliq_icms: TFloatField
      FieldName = 'aliq_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroC390vl_opr: TFloatField
