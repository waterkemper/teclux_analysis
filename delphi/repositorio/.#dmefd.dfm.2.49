  object qryRegistroC130: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC100
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.numero as chave,'
      '       cast(1 as varchar(1)) as ind_oper,'
      ''
      '       df.valorservicos as vl_serv_nt,'
      ''
      '       df.valorservicos as vl_bc_issqn,'
      '       df.issretido     as vl_issqn,'
      ''
      '       df.valorservicos as vl_bc_irrf,'
      '       df.irretido      as vl_irrf,'
      ''
      '       df.valorservicos as vl_bc_prev,'
      '       df.inssretido    as vl_prev'
      ''
      'from dadosfiscais df join notas n on df.numero = n.dadofiscal'
      'where df.data between :datainicial and :datafinal'
      '  and mod(df.codigofiscal,1000)=933'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)')
    RequestLive = False
    Left = 278
    Top = 120
    ParamData = <
