  object qryRegistroC390: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'cod_mod=cod_mod;ser=ser;num_doc=num_doc;dt_doc=dt_doc'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC350
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.modelodocto     as cod_mod,'
      '       n.serie            as ser,'
      '       n.numero           as num_doc,'
      '       df.data            as dt_doc,'
      ''
      '       pdf.incidencia     as cst_icms,'
      '       pdf.codigofiscal   as cfop,'
      '       pdf.aliquotaicms   as aliq_icms,'
      ''
      '       sum((pdf.quantidade * pdf.precovenda) +'
      '        coalesce(pdf.frete,0) +'
      '        coalesce(pdf.seguro,0) +'
      '        coalesce(pdf.despesasacessorias,0) +'
      '        coalesce(pdf.vicmsstretdesp,0) +'
      '        coalesce(pdf.acrescimo,0) -'
      '        coalesce(pdf.desconto,0) +'
      '        coalesce(pdf.valoripi,0)) as vl_opr,'
      ''
      
        '       sum(case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39 +
        ') and not pdf.naoGerarDebitoICMS then pdf.icmsbasecalculo else 0' +
        ' end) as vl_bc_icms,'
      
        '       sum(case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39 +
        ') and not pdf.naoGerarDebitoICMS then pdf.icmsvalor else 0 end) ' +
        'as vl_icms,'
      ''
      '       sum(pdf.reducaobase)     as vl_red_bc'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join produtosdadosfiscais pdf'
      '     on df.numero = pdf.dadofiscal'
      'where df.numero = pdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'02'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      
        'group by df.modelodocto, n.serie, n.numero, df.data, pdf.inciden' +
        'cia, pdf.codigofiscal, pdf.aliquotaicms'
      
        'order by df.modelodocto, n.serie, n.numero, df.data, pdf.inciden' +
        'cia, pdf.codigofiscal, pdf.aliquotaicms'
      '')
    RequestLive = False
    Left = 211
    Top = 280
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroC390cod_mod: TStringField
      FieldName = 'cod_mod'
      Size = 2
    end
    object qryRegistroC390ser: TStringField
      FieldName = 'ser'
      Size = 3
    end
