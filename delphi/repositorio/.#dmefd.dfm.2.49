  object qryRegistroC170: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC100
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.numero as chave,'
      '       cast(1 as varchar(1)) as ind_oper,'
      '       pdf.numero as num_item,'
      
        '       cast(('#39'P'#39'||cast(pdf.produto as varchar) ) as varchar(60))' +
        ' as cod_item,'
      
        '       cast(RetiraBrancoePipeeASCII255(pdf.descricaoproduto) as ' +
        'varchar(255)) as descr_compl,'
      '       pdf.quantidade     as qtd,'
      ''
      
        '       case when coalesce(btrim(c.unidade),'#39#39')<>'#39#39' then c.unidad' +
        'e else cast('#39'UN'#39' as varchar(6)) end as unid,'
      ''
      '       (pdf.quantidade * pdf.precovenda) /*+'
      '       coalesce(pdf.icmsvalorst,0)*/ as vl_item,'
      ''
      
        '       coalesce(pdf.desconto,0)+coalesce(pdf.valordescontoitem,0' +
        ') as vl_desc,'
      '       pdf.ind_mov_fisica as ind_mov,'
      ''
      '       cast(cast((select c.origem'
      '                     from caracteristicas c'
      '                     where c.codigo = (select p.caracteristica'
      '                                          from produtos p'
      
        '                                          where p.codigo = pdf.p' +
        'roduto)) AS VARCHAR) ||'
      '       pdf.incidencia as varchar(3)) as cst_icms,'
      ''
      '       pdf.codigofiscal   as cfop,'
      '       pdf.natureza       as cod_nat,'
      ''
      
        '       case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') an' +
        'd not pdf.naoGerarDebitoICMS then pdf.icmsbasecalculo else 0 end' +
        ' as vl_bc_icms,'
      
        '       case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') an' +
        'd not pdf.naoGerarDebitoICMS then pdf.aliquotaicms else 0 end  a' +
        's aliq_icms,'
      
        '       case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39') an' +
        'd not pdf.naoGerarDebitoICMS then pdf.icmsvalor else 0 end as vl' +
        '_icms,'
      ''
      ''
      '       /*'
      '       pdf.icmsbasecalculost as vl_bc_icms_st,'
      '       pdf.aliquotaicmsst    as aliq_st,'
      '       pdf.icmsvalorst       as vl_icms_st,'
      '       */'
      ''
      '       0.00 as vl_bc_icms_st,'
      '       0.00 as aliq_st,'
      '       0.00 as vl_icms_st,'
      ''
      ''
      '       cast(0 as integer)   as ind_apur,'
      '       pdf.ipicst           as cst_ipi,'
      '       cast(999 as integer) as cod_enq,'
      ''
      '       pdf.IPIBaseCalculo as vl_bc_ipi,'
      '       pdf.aliquotaipi    as aliq_ipi,'
      '       pdf.valoripi       as vl_ipi,'
      ''
      '       pdf.piscst            as cst_pis,'
      '       pdf.PISBaseCalculo    as vl_bc_pis,'
      ''
      '       pdf.pisaliquota       as aliq_pis_perc,'
      '       cast(null as integer) as quant_bc_pis,'
      '       0.00                  as aliq_pis_r,'
      '       pdf.PISValor          as vl_pis,'
      ''
      '       pdf.cofinscst         as cst_cofins,'
      '       pdf.COFINSBaseCalculo as vl_bc_cofins,'
      '       pdf.COFINSAliquota    as aliq_cofins_perc,'
      ''
      '       cast(null as integer) as quant_bc_cofins,'
      '       0.00                  as aliq_cofins_r,'
      '       pdf.COFINSValor       as vl_cofins,'
      ''
      ''
      '       (select c.subconta'
      '        from caracteristicas c'
      '             join produtos p on c.codigo = p.caracteristica'
      '        where c.codigo = p.caracteristica'
      '          and p.codigo = pdf.produto) as cod_cta'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join produtosdadosfiscais pdf'
      '          join produtos p'
      '               join caracteristicas c'
      '               on p.caracteristica = c.codigo'
      '          on pdf.produto = p.codigo'
      '     on df.numero = pdf.dadofiscal'
      'where df.numero = pdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      '  and not coalesce(df.notavinculada,false)'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'union all'
      ''
      'select df.numero '#9#9#9'       as chave,'
      '       cast(1 as varchar(1)) '#9#9'       as ind_oper,'
      '       cast(1 as integer)                   as num_item,'
      
        '       cast(('#39'S'#39'||cast(sdf.servico as varchar)) as varchar(60)) ' +
        'as cod_item,'
      
        '       cast(RetiraBrancoePipeeASCII255(s.descricao) as varchar(2' +
        '55)) as descr_compl,'
      '       sdf.quantidade           as qtd,'
      '       cast('#39'UN'#39' as varchar(6)) as unid,'
      '       sdf.valorservico         as vl_item,'
      '       0.00                     as vl_desc,'
      '       cast(1 as integer)       as ind_mov,'
      '       cast('#39'090'#39' as varchar(2)) as cst_icms,'
      '       sdf.codigofiscal         as cfop,'
      '       sdf.natureza             as cod_nat,'
      ''
      '       0.00 as vl_bc_icms,'
      '       0.00 as aliq_icms,'
      '       0.00 as vl_icms,'
      ''
      '       0.00 as vl_bc_icms_st,'
      '       0.00 as aliq_st,'
      '       0.00 as vl_icms_st,'
      ''
      '       cast(0 as integer)       as ind_apur,'
      '       cast('#39'99'#39' as varchar(2)) as cst_ipi,'
      '       cast(999 as integer)     as cod_enq,'
      ''
      '       0.00 as vl_bc_ipi,'
      '       0.00 as aliq_ipi,'
      '       0.00 as vl_ipi,'
      ''
      '       case when (select f.simples'
      '                  from filiais f'
      '                  where f.codigo = :filial )='#39'N'#39' then'
      '         cast('#39'01'#39' as varchar(2))'
      '       else cast('#39'99'#39' as varchar(2))'
      '       end as cst_pis,'
      ''
      '       case when (select f.simples'
      '                  from filiais f'
      '                  where f.codigo = :filial )='#39'N'#39' then'
      '          sdf.quantidade * sdf.valorservico'
      '       else 0.00'
      '       end as vl_bc_pis,'
      ''
      '       case when (select f.simples'
      '                  from filiais f'
      '                  where f.codigo = :filial )='#39'N'#39' then'
      
        '          (select cast(replace((select parametros_valor('#39'ALIQUOT' +
        'A PIS'#39',1)),'#39','#39','#39'.'#39') as numeric(5,2)))'
      '       else 0.00'
      '       end as aliq_pis_perc,'
      ''
      '       cast(null as integer) as quant_bc_pis,'
      '       0.00                  as aliq_pis_r,'
      ''
      '       case when (select f.simples'
      '                  from filiais f'
      '                  where f.codigo = :filial )='#39'N'#39' then'
      ''
      
        '          cast((select cast(replace((select parametros_valor('#39'AL' +
        'IQUOTA PIS'#39',1)),'#39','#39','#39'.'#39') as numeric(5,2))) *'
      
        '               (sdf.quantidade * sdf.valorservico)/100 as numeri' +
        'c(13,2))'
      ''
      '       else 0.00'
      '       end as vl_pis,'
      ''
      '       case when (select f.simples'
      '                  from filiais f'
      '                  where f.codigo = :filial )='#39'N'#39' then'
      '         cast('#39'01'#39' as varchar(2))'
      '       else cast('#39'99'#39' as varchar(2))'
      '       end as cst_cofins,'
      ''
      '       case when (select f.simples'
      '                  from filiais f'
      '                  where f.codigo = :filial )='#39'N'#39' then'
      '          sdf.quantidade * sdf.valorservico'
      '       else 0.00'
      '       end as vl_bc_cofins,'
      ''
      '       case when (select f.simples'
      '                  from filiais f'
      '                  where f.codigo = :filial )='#39'N'#39' then'
      
        '          (select cast(replace((select parametros_valor('#39'ALIQUOT' +
        'A COFINS'#39',1)),'#39','#39','#39'.'#39') as numeric(5,2)))'
      '       else 0.00'
      '       end as aliq_cofins_perc,'
      ''
      '       cast(null as integer) as quant_bc_cofins,'
      '       0.00                  as aliq_cofins_r,'
      ''
      '       case when (select f.simples'
      '                  from filiais f'
      '                  where f.codigo = :filial )='#39'N'#39' then'
      ''
      
        '          cast((select cast(replace((select parametros_valor('#39'AL' +
        'IQUOTA COFINS'#39',1)),'#39','#39','#39'.'#39') as numeric(5,2))) *'
      
        '               (sdf.quantidade * sdf.valorservico)/100 as numeri' +
        'c(13,2))'
      ''
      '       else 0.00'
      '       end as vl_cofins,'
      ''
      '       cast(null as integer) as cod_cta'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join servicosdadosfiscais sdf'
      '          join servicos s'
      '          on sdf.servico = s.codigo'
      '     on df.numero = sdf.dadofiscal'
      'where df.numero = sdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      '  and not coalesce(df.notavinculada,false)'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      ''
      'union all'
      ''
      'select np.codigo as chave,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       pnp.numero as num_item,'
      
        '       cast(('#39'P'#39'|| cast(pnp.produto as varchar)) as varchar(60))' +
        ' as cod_item,'
      
        '       cast(RetiraBrancoePipeeASCII255(pnp.descricaoproduto) as ' +
        'varchar(255))    as descr_compl,'
      '       pnp.quantidade     as qtd,'
      
        '       case when coalesce(btrim(c.unidade),'#39#39')<>'#39#39' then c.unidad' +
        'e else cast('#39'UN'#39' as varchar(6)) end as unid,'
      ''
      '       (pnp.quantidade * pnp.precounitario)  as vl_item,'
      
        '       coalesce(pnp.desconto,0)+coalesce(pnp.valordescontoitem,0' +
        ')       as vl_desc,'
      '       pnp.ind_mov_fisica as ind_mov,'
      ''
      '       cast(CAST((select c.origem'
      '                     from caracteristicas c'
      '                     where c.codigo = (select p.caracteristica'
      '                                          from produtos p'
      
        '                                          where p.codigo = pnp.p' +
        'roduto)) AS VARCHAR) ||'
      '       pnp.incidencia as varchar(3)) as cst_icms,'
      '       pnp.codigofiscal   as cfop,'
      '       pnp.natureza       as cod_nat,'
      ''
      
        '       (coalesce((case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'7' +
        '0'#39','#39'90'#39') and not pnp.naogerarcreditoicms then pnp.icmsbasecalcul' +
        'o else 0 end),0)) as vl_bc_icms,'
      
        '       (coalesce((case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'7' +
        '0'#39','#39'90'#39') and not pnp.naogerarcreditoicms then coalesce(pnp.aliqu' +
        'otaicms,0) else 0 end),0)) as aliq_icms,'
      
        '       (coalesce((case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'7' +
        '0'#39','#39'90'#39') and not pnp.naogerarcreditoicms then pnp.icmsvalor else' +
        ' 0 end),0)) as vl_icms,'
      ''
      '/*'
      '       pnp.icmsbasecalculost as vl_bc_icms_st,'
      '       pnp.aliquotaicmsst as aliq_st,'
      '       pnp.icmsvalorst as vl_icms_st,'
      '*/'
      ''
      '       0.00 as vl_bc_icms_st,'
      '       0.00 as aliq_st,'
      '       0.00 as vl_icms_st,'
      ''
      '       cast(0 as integer) as ind_apur,'
      '       pnp.ipicst         as cst_ipi,'
      '       cast(999 as integer) as cod_enq,'
      ''
      
        '       (coalesce((case when not pnp.naogerarcreditoipi then pnp.' +
        'ipibasecalculo else 0 end),0)) as vl_bc_ipi,'
      
        '       (case when pnp.naogerarcreditoipi then 0.00 else coalesce' +
        '(pnp.AliquotaIPI,0) end) as aliq_ipi,'
      
        '       (coalesce((case when not pnp.naogerarcreditoipi then pnp.' +
        'valoripi       else 0 end),0)) as vl_ipi,'
      ''
      '       pnp.piscst         as cst_pis,'
      '       pnp.PISBaseCalculo as vl_bc_pis,'
      ''
      '       pnp.pisaliquota       as aliq_pis_perc,'
      '       cast(null as integer) as quant_bc_pis,'
      '       0.00                  as aliq_pis_r,'
      '       pnp.PISValor          as vl_pis,'
      ''
      '       pnp.cofinscst         as cst_cofins,'
      '       pnp.COFINSBaseCalculo as vl_bc_cofins,'
      '       pnp.COFINSAliquota    as aliq_cofins_perc,'
      ''
      '       cast(null as integer) as quant_bc_cofins,'
      '       0.00                  as aliq_cofins_r,'
      '       pnp.COFINSValor    as vl_cofins,'
      ''
      '       (select c.subconta'
      '        from caracteristicas c'
      '             join produtos p on c.codigo = p.caracteristica'
      '        where c.codigo = p.caracteristica'
      '          and p.codigo = pnp.produto) as cod_cta'
      ''
      'from notaspag np'
      '     join produtosnotaspag pnp'
      '         join produtos p'
      '               join caracteristicas c'
      '               on p.caracteristica = c.codigo'
      '          on pnp.produto = p.codigo'
      '     on np.codigo = pnp.codigonota'
      'where np.codigo = pnp.codigonota'
      '  and np.data between :datainicial and :datafinal'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao = '#39'N'#39
      '  and np.filial = :filial'
      '')
    RequestLive = False
    Left = 448
    Top = 120
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroC170chave: TIntegerField
      FieldName = 'chave'
      Required = True
      DisplayFormat = '0'
    end
    object qryRegistroC170ind_oper: TStringField
      FieldName = 'ind_oper'
      Size = 1
    end
    object qryRegistroC170num_item: TIntegerField
      FieldName = 'num_item'
      Required = True
      DisplayFormat = '0'
    end
    object qryRegistroC170cod_item: TStringField
      FieldName = 'cod_item'
      Size = 60
    end
    object qryRegistroC170descr_compl: TStringField
      DisplayWidth = 255
      FieldName = 'descr_compl'
      Size = 50
    end
    object qryRegistroC170qtd: TFloatField
      FieldName = 'qtd'
      Required = True
      DisplayFormat = '0.00'
    end
    object qryRegistroC170unid: TStringField
      FieldName = 'unid'
      Size = 6
    end
    object qryRegistroC170vl_item: TFloatField
      FieldName = 'vl_item'
      Required = True
      DisplayFormat = '0.00'
    end
    object qryRegistroC170vl_desc: TFloatField
      FieldName = 'vl_desc'
      DisplayFormat = '0.00'
    end
    object qryRegistroC170ind_mov: TIntegerField
      FieldName = 'ind_mov'
      DisplayFormat = '0'
    end
    object qryRegistroC170cst_icms: TStringField
      FieldName = 'cst_icms'
      Required = True
      Size = 3
    end
    object qryRegistroC170cfop: TIntegerField
      FieldName = 'cfop'
      Required = True
      DisplayFormat = '0'
    end
    object qryRegistroC170cod_nat: TIntegerField
      FieldName = 'cod_nat'
      DisplayFormat = '0'
    end
    object qryRegistroC170vl_bc_icms: TFloatField
      FieldName = 'vl_bc_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroC170aliq_icms: TFloatField
      FieldName = 'aliq_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroC170vl_icms: TFloatField
      FieldName = 'vl_icms'
      DisplayFormat = '0.00'
