  object qryRegistroD500: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkFields = 'codigo = filial'
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.codigo as chave,'
      '       np.filial,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       case when permitirimprimir then'
      '            cast(0 as varchar(1))  /* emiss'#227'o pr'#243'pria */'
      '       else cast(1 as varchar(1))  /* terceiros       */'
      '       end as ind_emit,'
      
        '       cast((np.tipofornecedor||cast(np.fornecedor as varchar)) ' +
        'as varchar(60)) as cod_part,'
      '       np.modelodocto as cod_mod,'
      
        '       case when np.situacao = '#39'C'#39' '#9#9'       then cast('#39'02'#39' as va' +
        'rchar(2))  /* cancelado */'
      
        '       else                                                 cast' +
        '('#39'00'#39' as varchar(2))  /* regular   */'
      '       end as cod_sit,'
      '       np.serie as ser,'
      '       cast(null as varchar(4)) as sub,'
      '       np.numero as num_doc,'
      '       np.data as dt_doc,'
      '       np.emissao as dt_a_p,'
      '       np.valornota as vl_doc,'
      '       coalesce(np.desconto,0) as vl_desc,'
      '       np.valorservicos as vl_serv,'
      '       (select sum(cnp.isentas)+sum(cnp.outras)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '         and cnp.tipo='#39'M'#39') as vl_serv_nt,'
      '       0.00 as vl_terc,'
      '       np.despesasacessorias as vl_da,'
      '       (select sum(cnp.base)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '          and cnp.tipo='#39'M'#39') as vl_bc_icms,'
      '       (select sum(cnp.valor)'
      '        from calculosnotaspag cnp'
      '        where cnp.codigonota = np.codigo'
      '         and cnp.tipo='#39'M'#39') as vl_icms,'
      
        '       cast(RetiraBrancoePipeeASCII255(np.observacoes) as varcha' +
        'r(255)) as txt,'
      '       coalesce(np.totalvalorpis,0) as vl_pis,'
      '       coalesce(np.totalvalorcofins,0) as vl_cofins'
      '       '
      'from notaspag np'
      'where np.data between :datainicial and :datafinal'
      '  and np.filial = :filial'
      '  and np.situacao<>'#39'P'#39
      
        '  and cast(coalesce(np.modelodocto,'#39'01'#39') as varchar(2)) in ('#39'21'#39 +
        ','#39'22'#39')')
    RequestLive = False
    Left = 444
    Top = 261
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
