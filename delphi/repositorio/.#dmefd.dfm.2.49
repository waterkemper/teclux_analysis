  object qryRegistroC500: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.codigo as chave,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       cast(1 as varchar(1)) as ind_emit,'
      
        '       cast((np.tipofornecedor||cast(np.fornecedor as varchar)) ' +
        'as varchar(60)) as cod_part,'
      '       np.modelodocto as cod_mod,'
      
        '       case when np.situacao = '#39'C'#39' '#9#9'       then cast('#39'02'#39' as va' +
        'rchar(2))  /* cancelado */'
      
        '       else                                                 cast' +
        '('#39'00'#39' as varchar(2))  /* regular   */'
      '       end as cod_sit,'
      '       np.serie as ser,'
      '       cast(null as varchar(4)) as sub,'
      '       cast(null as varchar(2)) as cod_cons,'
      '       np.numero as num_doc,'
      '       np.data as dt_e_s,'
      '       np.emissao as dt_doc,'
      '       coalesce(np.valornota,0) as vl_doc,'
      '       np.desconto as vl_desc,'
      '       coalesce(np.valorservicos,np.valornota) as vl_forn,'
      '       np.valorservicos_nt as vl_serv_nt,'
      '       np.valorterceiros as vl_terc,'
      
        '       coalesce(np.despesasacessorias,0) + coalesce(np.valoricms' +
        'substituicao,0) as vl_da,'
      ''
      '       (select sum(pnp.icmsbasecalculo)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo'
      '          and pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39')'
      '          and not pnp.naogerarcreditoicms'
      '        ) as vl_bc_icms,'
      ''
      '       (select sum(pnp.icmsvalor)'
      '        from produtosnotaspag pnp'
      '        where pnp.codigonota = np.codigo'
      '          and pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39')'
      '          and not pnp.naogerarcreditoicms'
      '        ) as vl_icms,'
      ''
      '/*'
      '       np.baseicmssubstituicao as vl_bc_icms_st,'
      '       np.valoricmssubstituicao as vl_icms_st,'
      '*/'
      ''
      '       0.00 as vl_bc_icms_st,'
      '       0.00 as vl_icms_st,'
      ''
      '       np.valorpis as vl_pis,'
      '       np.valorcofins as vl_cofins'
      ''
      'from notaspag np'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao<>'#39'P'#39
      '  and np.modelodocto in ('#39'06'#39','#39'28'#39','#39'29'#39')'
      '  and np.filial = :filial')
    RequestLive = False
    Left = 36
    Top = 464
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
