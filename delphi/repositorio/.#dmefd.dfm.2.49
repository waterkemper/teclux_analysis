  object qryRegistro0150: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select cast(df.tipocliente||cast(df.cliente as varchar) as varch' +
        'ar(60)) as cod_part,'
      
        '       btrim(coalesce(vf.razao, coalesce(vf.razao,vf.nome))) as ' +
        'nome,'
      ''
      '       (case when vf.estado='#39'.'#39' then'
      '        (select c.codigoibge'
      '         from cidades c'
      '         where c.codigo = vf.cidade'
      '           and c.estado = vf.estado)'
      '       else'
      '       1058 end) as cod_pais,'
      #9'   '
      '       case when vf.pessoatipo='#39'J'#39' and vf.estado<>'#39'.'#39' then'
      '         coalesce(vf.pessoanumero, vf.cnpj)'
      '       else cast(null as varchar(14)) end as cnpj,'
      ''
      '       case when vf.pessoatipo='#39'F'#39' and vf.estado<>'#39'.'#39' then'
      '         vf.pessoanumero'
      '       else cast(null as varchar(11)) end as cpf,'
      #9'   '
      '       case when vf.pessoatipo='#39'J'#39' then'
      '         vf.inscricaoestadual'
      '       else cast(null as varchar(14)) end as ie,'
      #9'   '
      '       case when vf.estado<>'#39'.'#39' then'
      '         (select c.codigoibge'
      '         from cidades c'
      '         where c.codigo = vf.cidade'
      '           and c.estado = vf.estado)'
      '       else 9999999 end as cod_mun,'
      #9'  '
      '       (case when df.tipocliente='#39'C'#39' then'
      '          (select cl.suframa'
      '           from clientes cl'
      '           where cl.codigo = df.cliente)'
      '        else (case when df.tipocliente='#39'F'#39' then'
      '               (select f.suframa'
      '                from fornecedores f'
      '                where f.codigo = df.cliente)'
      '              else'
      '                (case when df.tipocliente='#39'L'#39' then'
      '                 (select f.suframa'
      '                  from filiais f'
      '                  where f.codigo = df.cliente)'
      '                 end)'
      '              end)'
      '        end) as suframa,'
      ''
      '       cast(case when vf.estado<>'#39'.'#39' then'
      '         RetiraBrancoePipeeASCII255(vf.rua)'
      '       else'
      '         (select c.nome'
      '          from cidades c'
      '          where c.codigo = vf.cidade'
      '            and c.estado = vf.estado)||'#39' - '#39'||'
      '            RetiraBrancoePipeeASCII255(vf.rua)'
      '         end as varchar(60)) as end,'
      ''
      '       vf.numero as num,'
      '       btrim(vf.complemento) as compl,'
      ''
      #9'   btrim((select b.nome'
      #9'    from bairros b'
      #9#9'where b.cidade = vf.cidade'
      '          and b.codigo = vf.bairro'
      '          and b.estado = vf.estado)) as bairro'
      ''
      'from'
      '('
      ''
      '/* clientes - sa'#237'das */'
      'select distinct  df.cliente, df.tipocliente'
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      'where df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39', '#39'06'#39','#39'28'#39','#39'29'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'union'
      ''
      '/* fornecedores de transporte - sa'#237'das'
      
        'select distinct df.fornecedortransporte as cliente, cast('#39'F'#39' as ' +
        'varchar(1)) as tipocliente'
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join fornecedores f'
      '     on df.fornecedortransporte = f.codigo'
      ''
      'where df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      ''
      'union'
      '*/'
      ''
      '/* fornecedores - entradas */'
      
        'select distinct np.fornecedor as cliente, np.tipofornecedor as t' +
        'ipocliente'
      'from notaspag np'
      'where np.data between :datainicial and :datafinal'
      
        '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39','#39'06'#39','#39'28'#39','#39'29'#39','#39'07'#39 +
        ','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39','#39'21'#39','#39'22'#39')'
      '  and np.situacao='#39'N'#39
      '  and np.filial = :filial'
      '  and exists (select pnp.codigonota'
      '              from produtosnotaspag pnp'
      '              where pnp.codigonota = np.codigo limit 1)'
      ''
      ''
      '/*'
      'union'
      ' fornecedores de transportes - entradas'
      
        'select distinct np.fornecedorconhecimentofrete as cliente, cast(' +
        #39'F'#39' as varchar(1)) as tipocliente'
      
        'from notaspag np join fornecedores f on np.fornecedorconheciment' +
        'ofrete = f.codigo'
      'where np.data between :datainicial and :datafinal'
      ''
      '  and  np.situacao<>'#39'P'#39
      '  */'
      ''
      ''
      'union'
      ''
      
        'select distinct np.fornecedor as cliente, np.tipofornecedor as t' +
        'ipocliente'
      ''
      'from imobilizado i'
      ''
      '     join planocontas pl'
      '     on i.ccdobem = pl.codigo'
      ''
      '     join apropriacaoicmsimobilizado aii'
      '     on i.numero = aii.numeroimobilizado'
      ''
      '     join produtos p'
      '     on i.codigobem = p.codigo'
      ''
      '     join notaspag np'
      '     on np.codigo = i.codigonota'
      ''
      'where i.filialcontribuinte = :filial'
      '  and aii.periodo between :datainicial and :datafinal'
      '  and aii.dataapropriacao between :datainicial and :datafinal'
      ''
      'union'
      ''
      'select distinct df.cliente, df.tipocliente'
      ''
      'from imobilizado i'
      ''
      '     join planocontas pl'
      '     on i.ccdobem = pl.codigo'
      ''
      '     join apropriacaoicmsimobilizado aii'
      '     on i.numero = aii.numeroimobilizado'
      ''
      '     join produtos p'
      '     on i.codigobem = p.codigo'
      ''
      '     join dadosfiscais df'
      '          join notas n'
      '          on df.numero = n.dadofiscal'
      '     on df.numero= i.dadofiscal'
      ''
      'where i.filialcontribuinte = :filial'
      '  and aii.periodo between :datainicial and :datafinal'
      '  and aii.dataapropriacao between :datainicial and :datafinal'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      
        ') as df join vfornecedores vf on df.cliente = vf.codigo and df.t' +
        'ipocliente = vf.tipo')
    RequestLive = False
    Left = 172
    Top = 24
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
  end
  object qryRegistro0015: TtecQuery
