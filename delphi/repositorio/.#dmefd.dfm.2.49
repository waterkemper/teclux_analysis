  object qryRegistroC400: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select distinct'
      '       cast('#39'2D'#39' as varchar(2)) as COD_MOD,'
      '       modelodescricao as ECF_MOD,'
      '       serie AS ECF_FAB,'
      '       cast(maquina as integer) as ECF_CX'
      'from ecfs'
      'where modelodescricao is not null'
      '  and serie is not null'
      '  and maquina is not null'
      '  and exists (select r.crz'
      '              from reducoesz r'
      
        '              where r.datamovimento between :datainicial and :da' +
        'tafinal'
      
        '                and r.numerousuario = cast(ecfs.maquina as integ' +
        'er)'
      '                and r.numerofabricacao = ecfs.serie'
      '              limit 1)'
      '  and filial = :filial'
      
        'order by ecf_mod, ecf_fab, ecf_cx /*modelodescricao, serie, maqu' +
        'ina*/')
    RequestLive = False
    Left = 36
    Top = 368
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
