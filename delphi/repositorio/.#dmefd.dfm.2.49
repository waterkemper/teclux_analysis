    Macros = <>
    Sql.Strings = (
      'select df.numero as chave,'
      '       cast(1 as varchar(1)) as ind_oper,'
      
        '       cast(:ctREFERENTECUPOMFISCAL||cast(c.numero as varchar) a' +
        's varchar(255)) as txt,'
      '       cast('#39'2D'#39' as varchar(2)) as cod_mod,'
      '       c.numeroserie as ecf_fab,'
      '       c.maquina as ecf_cx,'
      '       c.numero as num_doc,'
      '       df.data as dt_doc '
      ''
      'from (dadosfiscais df'
      '       join (notas n'
      '             join cupons c'
      '             on n.dadofiscalvinculado = c.dadofiscal)'
      '       on df.numero = n.dadofiscal)'
      'where df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      ''
      '')
    RequestLive = False
