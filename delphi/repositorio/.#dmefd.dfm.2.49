  object qryRegistroC120: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC100
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.codigo as chave,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       0 as cod_doc_imp,'
      '       np.ndi as num_doc_imp,'
      ''
      '       coalesce((select sum(a.pis)'
      '                 from adicoes a'
      
        '                 where a.dadoimportacao = di.numero),0) as pis_i' +
        'mp,'
      ''
      '       coalesce((select sum(a.cofins)'
      '                 from adicoes a'
      
        '                 where a.dadoimportacao = di.numero),0) as cofin' +
        's_imp'
      ''
      'from notaspag np'
      '     join dadosimportacoes di'
      '     on np.ndi = di.numero'
      'where np.data between :datainicial and :datafinal'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao = '#39'N'#39
      '  and np.filial = :filial')
