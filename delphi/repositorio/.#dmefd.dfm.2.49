  object qryRegistroC490: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 
      'filial=filial;numerousuario=num_usu;numerofabricacao=num_fab;cro' +
      '=cro;crz=crz'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC405
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select cst_icms,'
      '       cfop,'
      '       aliq_icms,'
      ''
      '       sum(vl_opr) as vl_opr,'
      ''
      '       sum(vl_bc_icms)  as vl_bc_icms,'
      ''
      '       trunc(sum(aliq_icms * vl_bc_icms / 100),2) as vl_icms,'
      ''
      '       cast(null as varchar(6)) as cod_obs,'
      ''
      '       filial,'
      '       num_usu , num_fab,'
      '       cro ,'
      '       crz'
      ''
      'from'
      ' ('
      ''
      ''
      ''
      '  select (select pdf.incidencia'
      ''
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '             and dc.num_fab = c.numeroserie'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      ''
      '             and df.numero = c.dadofiscal'
      ''
      '             and pdf.dadofiscal = df.numero'
      
        '             and cast(pdf.produto as varchar) = dic.cod_item lim' +
        'it 1) as cst_icms,'
      ''
      
        '         (select cast('#39'5'#39'||cast(mod(pdf.codigofiscal,1000) as va' +
        'rchar) as integer)'
      
        '          from cupons c, dadosfiscais df, produtosdadosfiscais p' +
        'df'
      '          where dc.filial = c.filial'
      '             and dc.num_usu = c.maquina'
      '             and dc.num_fab = c.numeroserie'
      '            /*and dc.cro = c.intervensao*/'
      '             and dc.coo = c.numero'
      ''
      '             and df.numero = c.dadofiscal'
      ''
      '             and pdf.dadofiscal = df.numero'
      
        '             and cast(pdf.produto as varchar)= dic.cod_item limi' +
        't 1) as cfop,'
      ''
      '         dic.aliq_icms,'
      ''
      '/*'
      
        '        round(dic.vl_tot_item - dic.vl_tot_item *  case when dlc' +
        '.tp_descto = '#39'V'#39' then dlc.sub_descto end / dlc.sub_docto'
      
        '                               + dic.vl_tot_item *  case when dl' +
        'c.tp_acres = '#39'V'#39' then dlc.sub_acres   end / dlc.sub_docto, 2) as' +
        ' vl_opr,'
      '                               */'
      ''
      
        '        dic.vl_tot_item - dic.vl_tot_item *  case when dlc.tp_de' +
        'scto = '#39'V'#39' then dlc.sub_descto end / dlc.sub_docto'
      
        '                               + dic.vl_tot_item *  case when dl' +
        'c.tp_acres = '#39'V'#39' then dlc.sub_acres   end / dlc.sub_docto as vl_' +
        'opr,'
      ''
      '/*'
      '         (case when dic.cod_tot_parc='#39'I1'#39'  then 0.00'
      '               when dic.cod_tot_parc='#39'F1'#39'  then 0.00'
      '               when dic.cod_tot_parc='#39'N1'#39'  then 0.00'
      
        '         else round(dic.vl_tot_item - dic.vl_tot_item *  case wh' +
        'en dlc.tp_descto = '#39'V'#39' then dlc.sub_descto end / dlc.sub_docto'
      
        '                                    + dic.vl_tot_item *  case wh' +
        'en dlc.tp_acres  = '#39'V'#39' then dlc.sub_acres  end / dlc.sub_docto ,' +
        ' 2)'
      '         end) as vl_bc_icms,'
      '              */'
      ''
      '         (case when dic.cod_tot_parc='#39'I1'#39'  then 0.00'
      '               when dic.cod_tot_parc='#39'F1'#39'  then 0.00'
      '               when dic.cod_tot_parc='#39'N1'#39'  then 0.00'
      
        '         else dic.vl_tot_item - dic.vl_tot_item *  case when dlc' +
        '.tp_descto = '#39'V'#39' then dlc.sub_descto end / dlc.sub_docto'
      
        '                                    /* + dic.vl_tot_item *  case' +
        ' when dlc.tp_acres  = '#39'V'#39' then dlc.sub_acres  end / dlc.sub_doct' +
        'o   ver cupom 424 f5 fretta acrescimo n'#227'o faz parte da bc do icm' +
        's*/'
      ''
      ''
      ''
      
        '                              -  coalesce((select pdf.reducaobas' +
        'e'
      
        '                                  from cupons c, dadosfiscais df' +
        ', produtosdadosfiscais pdf'
      '                                  where dc.filial = c.filial'
      '                                     and dc.num_usu = c.maquina'
      
        '                                     and dc.num_fab = c.numerose' +
        'rie'
      
        '                                    /*and dc.cro = c.intervensao' +
        '*/'
      '                                     and dc.coo = c.numero'
      ''
      
        '                                     and df.numero = c.dadofisca' +
        'l'
      ''
      
        '                                     and pdf.dadofiscal = df.num' +
        'ero'
      
        '                                     and cast(pdf.produto as var' +
        'char)= dic.cod_item limit 1),0)'
      ''
      '                                 end) as vl_bc_icms,'
      ''
      ''
      '         dic.filial,'
      '         dic.num_usu ,'
      '         dic.num_fab,'
      '         dic.cro ,'
      '         dlc.crz,'
      '         dlc.sub_descto,'
      '         dlc.tp_descto,'
      '         dlc.sub_docto'
      ''
      '  from dadositemcupom dic'
      '/*'
      '       join produtos p'
      '         on dic.cod_item = cast(p.codigo as varchar)'
      ''
      '         join caracteristicas ca'
      '         on p.caracteristica = ca.codigo'
      ''
      '         join tributosicms ti'
      '         on ca.incidencia = ti.codigo'
      '*/'
      ''
      '       join dadoscupom dc'
      ''
      '/*            join cupons c'
      '            on dc.filial = c.filial'
      '            and dc.num_usu = c.maquina */'
      '            /*and dc.cro = c.intervensao*/'
      '/*            and dc.coo = c.numero*/'
      ''
      '         on dc.filial = dic.filial'
      '         and dc.num_usu = dic.num_usu'
      '         and dc.num_fab = dic.num_fab'
      '         and dc.cro = dic.cro'
      '         and dc.coo = dic.coo'
      ''
      ''
      '         join detalhecupom dlc'
      '           on dc.filial = dlc.filial'
      '           and dc.num_usu = dlc.num_usu'
      '           and dc.num_fab = dlc.num_fab'
      '           and dc.cro = dlc.cro'
      '           and dc.coo = dlc.coo'
      ''
      '/*       join dadosfiscais df'
      '       on df.numero = c.dadofiscal*/'
      ''
      '/*       join produtosdadosfiscais pdf'
      '       on pdf.dadofiscal = df.numero'
      '       and pdf.produto = dic.cod_item*/'
      '/*       and pdf.filial = dic.filial*/'
      '       '
      '/*       and pdf.numero = dic.num_item */'
      ''
      ''
      
        '  where cast(dlc.dt_ini as date) between :datainicial and :dataf' +
        'inal'
      '    and dlc.canc = '#39'N'#39
      '    and dic.ind_canc = '#39'N'#39
      '    and dc.filial = :filial'
      ''
      ''
      '/*'
      '    and not exists ('
      '       select pdf.dadofiscal'
      '       from produtosdadosfiscais pdf'
      '       where pdf.dadofiscal = df.numero'
      '         and cast(pdf.produto as varchar) = dic.cod_item)'
      '*/'
      ''
      ''
      ' ) as registros'
      ''
      ''
      
        'group by filial, num_usu, num_fab, cro, crz, cst_icms, cfop, ali' +
        'q_icms'
      
        'order by filial, num_usu, num_fab, cro, crz, cst_icms, cfop, ali' +
        'q_icms'
      '')
    RequestLive = False
    Left = 424
    Top = 400
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroC490cst_icms: TStringField
      FieldName = 'cst_icms'
      Size = 2
    end
    object qryRegistroC490cfop: TIntegerField
      FieldName = 'cfop'
      DisplayFormat = '0'
    end
    object qryRegistroC490aliq_icms: TFloatField
      FieldName = 'aliq_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroC490vl_opr: TFloatField
      FieldName = 'vl_opr'
      DisplayFormat = '0.00'
    end
    object qryRegistroC490vl_bc_icms: TFloatField
      FieldName = 'vl_bc_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroC490vl_icms: TFloatField
      FieldName = 'vl_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroC490cod_obs: TStringField
      FieldName = 'cod_obs'
      Size = 6
    end
    object qryRegistroC490filial: TIntegerField
      FieldName = 'filial'
      DisplayFormat = '0'
    end
    object qryRegistroC490num_usu: TIntegerField
      FieldName = 'num_usu'
      DisplayFormat = '0'
    end
    object qryRegistroC490cro: TIntegerField
      FieldName = 'cro'
      DisplayFormat = '0'
    end
    object qryRegistroC490crz: TIntegerField
      FieldName = 'crz'
      DisplayFormat = '0'
    end
    object qryRegistroC490num_fab: TStringField
      FieldName = 'num_fab'
    end
  end
  object qryregistroH010: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'SELECT t.*,'
      '       trunc((vl_item/qtdestoque),2) as vl_unit,'
      '       cast('#39'0'#39' as varchar) as ind_prop'
      'from'
      
        '(SELECT cast(('#39'P'#39'||cast(ep.codigoitem as varchar)) as varchar(60' +
        ')) as codigoitem,'
      ''
      ' ep.unidade,'
      
        ' (ep.emestoque+ep.reservado+ep.transito+ep.demonstracao+ep.conse' +
        'rto+ep.danificada+ep.reservaprevia) AS qtdestoque,'
      ' custo_medio as vl_item,'
      ' coalesce(subconta,0) as cod_cta'
      'FROM'
      ' ('
      ' select ep.*,'
      
        ' (select i.classificacaofiscal from ipi i where i.codigo = c.ipi' +
        ') as classificacaofiscal,'
      ' cl.descricao AS classeproduto,'
      ' cl.codigo AS codigoclasse,'
      ' g.descricao AS grupoproduto,'
      ' g.codigo AS codigogrupo,'
      ' c.descricao AS produto,'
      ' c.codigo AS codigoproduto,'
      
        ' cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||coalesc' +
        'e(p.valorgrade2,'#39#39') as varchar) AS item,'
      ' ma.descricao AS marca, p.referencia,'
      ' c.unidade,'
      ' c.subconta'
      ' from'
      ' ('
      ' select ep.*,'
      ' m2.valor,'
      ' m2.quantidade as qtdUltimaEntrada'
      ' from'
      ' ('
      ' select'
      ' e.codigofilial,'
      ' e.codigoitem,'
      ' e.localizacao,'
      
        ' e.precocomicms, /*,estoques_preco(e.produto,e.filial) as precov' +
        'enda*/'
      ' m.emestoque,'
      ' m.reservado,'
      ' m.transito,'
      ' m.demonstracao,'
      ' m.conserto,'
      ' m.danificada,'
      ' m.reservaprevia,'
      ' m.estoquefisico,'
      ' m.financeiro as Custo_Medio'
      ' from'
      ' ('
      ' select m.numero,'
      ' e.filial as codigofilial,'
      ' e.produto as codigoitem,'
      ' e.localizacao,'
      ' e.precocomicms'
      ' from'
      ' ('
      ''
      ' select m2.numero, m1.produto, m1.filial'
      ' from'
      ' ('
      ' select m1.data, m1.produto, m1.filial,'
      ' (select max(m2.lancto)'
      ' from movimentos m2'
      ' where m2.produto = m1.produto'
      ' and m2.filial = m1.filial'
      ' and m2.data = m1.data) as lancto'
      ' from'
      ' ('
      ' select max(m1.data) as data, m1.produto, m1.filial'
      ' from movimentos m1'
      ' where m1.data < (cast(:datafinal as date)+1)'
      ' group by m1.produto, m1.filial'
      ' order by m1.produto, m1.filial'
      ' ) as m1'
      
        ' ) as m1 join movimentos m2 on m1.data = m2.data and m1.lancto =' +
        ' m2.lancto and m1.produto = m2.produto and m1.filial = m2.filial'
      
        ' ) as m join estoques e on m.produto = e.produto and m.filial = ' +
        'e.filial'
      
        ' Where (e.filial = :filial ) /* WHERE ESTOQUE where e.produto =0' +
        ' */'
      ''
      ' ) as e join movimentos m on e.numero = m.numero'
      ' and m.financeiro<>0 /*and m1.financeiro<>0*/'
      
        ' ) as ep LEFT JOIN movimentos m2 ON m2.produto = ep.codigoitem A' +
        'ND'
      ' m2.filial = ep.codigofilial and'
      ' m2.numero = (SELECT max(m.numero)'
      ' from movimentos m'
      ' where m.produto=ep.codigoitem and'
      ' m.filial=ep.codigofilial and'
      ' m.data < (cast(:datafinal as date)+1) and'
      ' substring(m.operacao from 12 for 1)='#39'+'#39')'
      ''
      ' ) as ep'
      ' JOIN ( produtos p'
      ' JOIN (((caracteristicas c'
      ' JOIN grupos g'
      ' ON c.grupo = g.codigo)'
      ' JOIN classes cl'
      ' ON c.classe=cl.codigo)'
      ' JOIN marcas ma'
      ' ON c.marca=ma.codigo)'
      ' ON p.caracteristica=c.codigo)'
      ' ON p.codigo = ep.codigoitem'
      
        ' where true /*((not (c.inativo is not null)) or (c.inativo>:data' +
        'final))*/'
      ''
      
        '  and coalesce(((SUBSTRING((SELECT f.Razao FROM Filiais f WHERE ' +
        'f.Codigo = 1) FROM 1 FOR 15) = '#39'KRAH-ICE-BRASIL'#39' AND c.Grupo IN ' +
        '('#39'CERA'#39', '#39'EMB'#39', '#39'MTPR'#39','#39'ZFD'#39','#39'ZKVW'#39','#39'KFG'#39','#39'SUP'#39','#39'FD'#39','#39'FK'#39','#39'GWW'#39',' +
        #39'PORC'#39','#39'FKD'#39','#39'KKD'#39','#39'ZZFD'#39','#39'SUBP'#39','#39'GERL'#39')) or'
      
        '      (SUBSTRING((SELECT f.Razao FROM Filiais f WHERE f.Codigo =' +
        ' 1) FROM 1 FOR 15) <> '#39'KRAH-ICE-BRASIL'#39')),true)'
      ''
      '  and c.tipoproduto in ('#39'00'#39','#39'01'#39','#39'02'#39','#39'03'#39','#39'04'#39','#39'05'#39','#39'06'#39')'
      ''
      ') as EP'
      'Order BY item, codigoitem'
      ') as T'
      ' WHERE qtdestoque>0'
      '')
    RequestLive = False
    Left = 168
    Top = 725
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryregistroH010codigoitem: TStringField
      FieldName = 'codigoitem'
      Size = 60
    end
    object qryregistroH010unidade: TStringField
      FieldName = 'unidade'
      Size = 8
    end
    object qryregistroH010qtdestoque: TFloatField
      FieldName = 'qtdestoque'
      DisplayFormat = '0.00'
    end
    object qryregistroH010vl_item: TFloatField
      FieldName = 'vl_item'
      DisplayFormat = '0.00'
    end
    object qryregistroH010cod_cta: TIntegerField
      FieldName = 'cod_cta'
      DisplayFormat = '0'
    end
    object qryregistroH010vl_unit: TFloatField
      FieldName = 'vl_unit'
      DisplayFormat = '0.00'
    end
    object qryregistroH010ind_prop: TStringField
      FieldName = 'ind_prop'
      Size = 50
    end
  end
  object qryRegistroH005: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select sum(vl_item) as vl_inv,'
      '       current_date as dt_inv'
      'from'
      '('
      'SELECT t.*,'
      '       trunc((vl_item/qtdestoque),2) as vl_unit,'
      '       cast('#39'0'#39' as varchar) as ind_prop'
      'from'
      '(SELECT ep.codigoitem,'
      ' ep.unidade,'
      
        ' (ep.emestoque+ep.reservado+ep.transito+ep.demonstracao+ep.conse' +
        'rto+ep.danificada+ep.reservaprevia) AS qtdestoque,'
      ' custo_medio as vl_item,'
      ' coalesce(subconta,0) as cod_cta'
      'FROM'
      ' ('
      ' select ep.*,'
      
        ' (select i.classificacaofiscal from ipi i where i.codigo = c.ipi' +
        ') as classificacaofiscal,'
      ' cl.descricao AS classeproduto,'
      ' cl.codigo AS codigoclasse,'
      ' g.descricao AS grupoproduto,'
      ' g.codigo AS codigogrupo,'
      ' c.descricao AS produto,'
      ' c.codigo AS codigoproduto,'
      
        ' cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||coalesc' +
        'e(p.valorgrade2,'#39#39') as varchar) AS item,'
      ' ma.descricao AS marca, p.referencia,'
      ' c.unidade,'
      ' c.subconta'
      ' from'
      ' ('
      ' select ep.*,'
      ' m2.valor,'
      ' m2.quantidade as qtdUltimaEntrada'
      ' from'
      ' ('
      ' select'
      ' e.codigofilial,'
      ' e.codigoitem,'
      ' e.localizacao,'
      
        ' e.precocomicms, /*,estoques_preco(e.produto,e.filial) as precov' +
        'enda*/'
      ' m.emestoque,'
      ' m.reservado,'
      ' m.transito,'
      ' m.demonstracao,'
      ' m.conserto,'
      ' m.danificada,'
      ' m.reservaprevia,'
      ' m.estoquefisico,'
      ' m.financeiro as Custo_Medio'
      ' from'
      ' ('
      ' select m.numero,'
      ' e.filial as codigofilial,'
      ' e.produto as codigoitem,'
      ' e.localizacao,'
      ' e.precocomicms'
      ' from'
      ' ('
      ''
      ' select m2.numero, m1.produto, m1.filial'
      ' from'
      ' ('
      ' select m1.data, m1.produto, m1.filial,'
      ' (select max(m2.lancto)'
      ' from movimentos m2'
      ' where m2.produto = m1.produto'
      ' and m2.filial = m1.filial'
      ' and m2.data = m1.data) as lancto'
      ' from'
      ' ('
      ' select max(m1.data) as data, m1.produto, m1.filial'
      ' from movimentos m1'
      ' where m1.data < (cast(:datafinal as date)+1)'
      ' group by m1.produto, m1.filial'
      ' order by m1.produto, m1.filial'
      ' ) as m1'
      
        ' ) as m1 join movimentos m2 on m1.data = m2.data and m1.lancto =' +
        ' m2.lancto and m1.produto = m2.produto and m1.filial = m2.filial'
      
        ' ) as m join estoques e on m.produto = e.produto and m.filial = ' +
        'e.filial'
      
        ' Where (e.filial = :filial ) /* WHERE ESTOQUE where e.produto =0' +
        ' */'
      ''
      ' ) as e join movimentos m on e.numero = m.numero'
      ' and m.financeiro<>0 /*and m1.financeiro<>0*/'
      
        ' ) as ep LEFT JOIN movimentos m2 ON m2.produto = ep.codigoitem A' +
        'ND'
      ' m2.filial = ep.codigofilial and'
      ' m2.numero = (SELECT max(m.numero)'
      ' from movimentos m'
      ' where m.produto=ep.codigoitem and'
      ' m.filial=ep.codigofilial and'
      ' m.data < (cast(:datafinal as date)+1) and'
      ' substring(m.operacao from 12 for 1)='#39'+'#39')'
      ''
      ' ) as ep'
      ' JOIN ( produtos p'
      ' JOIN (((caracteristicas c'
      ' JOIN grupos g'
      ' ON c.grupo = g.codigo)'
      ' JOIN classes cl'
      ' ON c.classe=cl.codigo)'
      ' JOIN marcas ma'
      ' ON c.marca=ma.codigo)'
      ' ON p.caracteristica=c.codigo)'
      ' ON p.codigo = ep.codigoitem'
      
        ' where true /*((not (c.inativo is not null)) or (c.inativo>:data' +
        'final))*/'
      
        ' and coalesce(((SUBSTRING((SELECT f.Razao FROM Filiais f WHERE f' +
        '.Codigo = 1) FROM 1 FOR 15) = '#39'KRAH-ICE-BRASIL'#39' AND c.Grupo IN (' +
        #39'CERA'#39', '#39'EMB'#39', '#39'MTPR'#39','#39'ZFD'#39','#39'ZKVW'#39','#39'KFG'#39','#39'SUP'#39','#39'FD'#39','#39'FK'#39','#39'GWW'#39','#39 +
        'PORC'#39','#39'FKD'#39','#39'KKD'#39','#39'ZZFD'#39','#39'SUBP'#39','#39'GERL'#39')) or'
      
        '      (SUBSTRING((SELECT f.Razao FROM Filiais f WHERE f.Codigo =' +
        ' 1) FROM 1 FOR 15) <> '#39'KRAH-ICE-BRASIL'#39')),true)'
      '      '
      ' and c.tipoproduto in ('#39'00'#39','#39'01'#39','#39'02'#39','#39'03'#39','#39'04'#39','#39'05'#39','#39'06'#39')'
      ''
      ') as EP'
      'Order BY item, codigoitem'
      ') as T'
      ' WHERE qtdestoque>0'
      ''
      ') as t')
    RequestLive = False
    Left = 40
    Top = 752
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroH005vl_inv: TFloatField
      FieldName = 'vl_inv'
      DisplayFormat = '0.00'
    end
  end
  object qryRegistroC300: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.modelodocto     as cod_mod,'
      '       n.serie            as ser,'
      '       min(n.numero)      as num_doc_ini,'
      '       max(n.numero)      as num_doc_fin,'
      '       df.data            as dt_doc,'
      
        '       sum((case when df.situacao<>'#39'C'#39'          then df.valortot' +
        'al       else 0 end)) as vl_doc,'
      
        '       sum(coalesce((case when df.situacao<>'#39'C'#39' then df.totalval' +
        'orpis    else 0 end) ,0)) as vl_pis,'
      
        '       sum(coalesce((case when df.situacao<>'#39'C'#39' then df.totalval' +
        'orcofins else 0 end) ,0)) as vl_cofins'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      'where df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'02'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'group by df.modelodocto, n.serie, df.data'
      'order by df.modelodocto, n.serie, df.data')
    RequestLive = False
    Left = 36
    Top = 208
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
