  object qryEFD_E530: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterEdit = qryEFD_E530AfterEdit
    AfterPost = qryEFD_E530AfterPost
    AfterDelete = qryEFD_E530AfterDelete
    OnNewRecord = qryEFD_E530NewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select efd_e530.*,'
      '       tai.descricao,'
      '       cast('
      '       case when efd_e530.ind_aj = 0 then '#39'0 - D'#233'bito'#39
      '            when efd_e530.ind_aj = 1 then '#39'1 - Cr'#233'dito'#39
      '       end as varchar(15)) as descr_ind_aj,'
      ''
      '       cast('
      
        '       case when efd_e530.ind_doc = 0 then '#39'0 - Processo Judicia' +
        'l'#39
      '            when efd_e530.ind_doc = 1 then '#39'1 - Processo Adm.'#39
      '            when efd_e530.ind_doc = 2 then '#39'2 - PER/DCOMP'#39
      '            when efd_e530.ind_doc = 9 then '#39'9 - Outros'#39
      '       end as varchar(30)) as descr_ind_doc'
      ''
      'from efd_e530 efd_e530'
      '     join tabelaajusteipi tai'
      '     on efd_e530.cod_aj_apur = tai.codigo'
      ''
      'where efd_e530.periodo = :periodo'
      '  and efd_e530.filial = :filial'
      ''
