  object qryRegistroG110: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT Saldo_In_ICMS,'
      '       Som_Parc,'
      '       Vl_Trib_Exp,'
      '       Vl_Total,'
      '       Vl_Trib_Exp / Vl_Total AS Ind_Per_Sai,'
      '       Som_Parc * (Vl_Trib_Exp / Vl_Total) AS ICMS_Aprop,'
      ''
      '       (SELECT SUM(aii.Valor)'
      '           FROM Imobilizado i'
      '                JOIN ApropriacaoICMSImobilizado aii'
      '                ON i.Numero = aii.NumeroImobilizado'
      ''
      '           WHERE i.InicioUso < :DataInicial'
      '             AND i.FilialContribuinte = :Filial'
      '             AND aii.Periodo < :DataInicial'
      
        '             AND aii.DataApropriacao  BETWEEN :DataInicial AND :' +
        'DataFinal'
      '             AND i.CodigoNota IS NOT NULL'
      '             AND EXISTS (SELECT i2.Numero'
      '                           FROM Imobilizado i2'
      
        '                                JOIN ApropriacaoICMSImobilizado ' +
        'aii2'
      
        '                                ON i2.Numero = aii2.NumeroImobil' +
        'izado'
      '                           WHERE i2.filialcontribuinte = :Filial'
      
        '                             AND aii2.Periodo         BETWEEN :D' +
        'ataInicial AND :DataFinal'
      
        '                             AND aii2.DataApropriacao BETWEEN :D' +
        'ataInicial AND :DataFinal'
      '                             AND i2.Numero = i.Numero'
      '                             AND i2.CodigoNota IS NOT NULL)'
      '        ) AS SOM_ICMS_OC'
      ''
      'FROM'
      '('
      ' SELECT (SELECT SUM(COALESCE(i.ICMSValor,    0) +'
      '                    COALESCE(i.ICMSValorST,  0) +'
      '                    COALESCE(i.ICMSValorFrt, 0) +'
      
        '                    COALESCE(i.ICMSValorDif, 0)) AS Saldo_In_ICM' +
        'S                '
      '            FROM'
      ''
      '            ('
      '             SELECT i.Numero,'
      '                    i.ICMSValor,'
      '                    i.ICMSValorST,'
      '                    i.ICMSValorFrt,'
      '                    i.ICMSValorDif'
      ''
      '                FROM Imobilizado i'
      ''
      '                WHERE i.InicioUso < :DataInicial'
      '                  AND i.FilialContribuinte = :Filial'
      '                  AND EXISTS (SELECT aii.NumeroImobilizado'
      
        '                                 FROM ApropriacaoICMSImobilizado' +
        ' aii'
      
        '                                 WHERE aii.NumeroImobilizado = i' +
        '.Numero'
      
        '                                   AND aii.Periodo         BETWE' +
        'EN :DataInicial AND :DataFinal'
      
        '                                   AND aii.DataApropriacao BETWE' +
        'EN :DataInicial AND :DataFinal)'
      '            ) AS i'
      ''
      '            JOIN'
      '              '
      '            ('
      '             SELECT i2.Numero,'
      '                    aii2.Sequencia,'
      '                    aii2.Valor'
      ''
      '                FROM Imobilizado i2'
      '                     JOIN ApropriacaoICMSImobilizado aii2'
      '                     ON i2.Numero = aii2.NumeroImobilizado'
      ''
      '                WHERE i2.FilialContribuinte = :Filial'
      
        '                  AND aii2.Periodo         BETWEEN :DataInicial ' +
        'AND :DataFinal'
      
        '                  AND aii2.DataApropriacao BETWEEN :DataInicial ' +
        'AND :DataFinal) AS i2'
      '            ON i.Numero = i2.Numero'
      '        ) AS Saldo_In_ICMS,'
      '              '
      ''
      '        (SELECT SUM(aii.Valor) AS Som_parc'
      '            FROM ApropriacaoICMSImobilizado aii'
      
        '            WHERE aii.Periodo         BETWEEN :DataInicial AND :' +
        'DataFinal'
      
        '              AND aii.DataApropriacao BETWEEN :DataInicial AND :' +
        'DataFinal'
      ''
      '              AND EXISTS (SELECT i.Numero'
      '                             FROM Imobilizado i'
      
        '                                JOIN ApropriacaoICMSImobilizado ' +
        'aii2'
      
        '                                ON i.Numero = aii2.NumeroImobili' +
        'zado'
      
        '                             WHERE i.FilialContribuinte = :Filia' +
        'l'
      
        '                               AND aii2.Periodo         BETWEEN ' +
        ':DataInicial AND :DataFinal'
      
        '                               AND aii2.DataApropriacao BETWEEN ' +
        ':DataInicial AND :DataFinal'
      '                               AND i.Numero = i.Numero'
      '                               AND i.CodigoNota IS NOT NULL)'
      '      ) AS Som_Parc,'
      '    '
      '        (SELECT SUM(pdf.Quantidade * pdf.Precovenda    +'
      '                    COALESCE(pdf.Frete,            0) +'
      '                    COALESCE(pdf.Seguro,            0) +'
      '                    COALESCE(pdf.DespesasAcessorias,0) +'
      '                    coalesce(pdf.vicmsstretdesp,0) +'
      '                    COALESCE(pdf.Acrescimo,         0) -'
      '                    COALESCE(pdf.ValorDescontoItem, 0) -'
      '                    COALESCE(pdf.Desconto,          0) +'
      '                    COALESCE(pdf.ValorIPI,          0) +'
      
        '                    COALESCE(pdf.ICMSValorST,       0)) AS Vl_Op' +
        'r'
      ''
      '            FROM DadosFiscais df'
      
        '                 JOIN Notas n                  ON df.Numero = n.' +
        'DadoFiscal'
      
        '                 JOIN ProdutosDadosFiscais pdf ON df.Numero = pd' +
        'f.DadoFiscal'
      ''
      '            WHERE df.Numero = pdf.DadoFiscal'
      '              AND df.Data BETWEEN :DataInicial AND :DataFinal'
      '              AND df.ModeloDocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '              AND df.CodigoFiscal < 8000'
      '              AND df.Situacao = '#39'N'#39
      '              AND df.FilialEmissao = :Filial'
      ''
      
        '              AND ((SUBSTRING(cast(pdf.CodigoFiscal AS VARCHAR),' +
        '1,1) = '#39'7'#39' AND MOD(pdf.CodigoFiscal,1000) IN (101, 102)) OR'
      
        '                   (SUBSTRING(cast(pdf.Codigofiscal AS VARCHAR),' +
        '1,1) IN ('#39'5'#39', '#39'6'#39') AND MOD(pdf.CodigoFiscal,1000) IN (101,102) A' +
        'ND pdf.ICMSValor<>0))'
      ''
      
        '              AND (n.Filial, n.Serie) IN (SELECT sf.Filial, sf.V' +
        'alor FROM SeriesFiliais sf WHERE sf.Ativa)'
      ''
      '        ) AS Vl_Trib_Exp,'
      ''
      ''
      '        (SELECT SUM(pdf.Quantidade * pdf.precovenda +'
      '                    COALESCE(pdf.Frete,            0) +'
      '                    COALESCE(pdf.Seguro,            0) +'
      '                    COALESCE(pdf.DespesasAcessorias,0) +'
      '                    coalesce(pdf.vicmsstretdesp,0) +'
      '                    COALESCE(pdf.Acrescimo,         0) -'
      '                    COALESCE(pdf.ValorDescontoItem, 0) -'
      '                    COALESCE(pdf.Desconto,          0) +'
      '                    COALESCE(pdf.ValorIPI,          0) +'
      
        '                    COALESCE(pdf.ICMSValorST,       0)) AS Vl_Op' +
        'r'
      ''
      '            FROM DadosFiscais df'
      
        '                 JOIN Notas n                  ON df.Numero = n.' +
        'DadoFiscal'
      
        '                 JOIN ProdutosDadosFiscais pdf ON df.Numero = pd' +
        'f.DadoFiscal'
      ''
      '            WHERE df.Numero = pdf.DadoFiscal'
      '              AND df.Data BETWEEN :DataInicial AND :DataFinal'
      '              AND df.ModeloDocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '              AND df.CodigoFiscal < 8000'
      '              AND df.Situacao = '#39'N'#39
      '              AND df.FilialEmissao = :Filial'
      ''
      
        '              AND ((SUBSTRING(cast(pdf.CodigoFiscal AS VARCHAR),' +
        '1,1) = '#39'7'#39' AND MOD(pdf.CodigoFiscal,1000) IN (101, 102)) OR'
      
        '                   (SUBSTRING(cast(pdf.Codigofiscal AS VARCHAR),' +
        '1,1) IN ('#39'5'#39', '#39'6'#39') AND MOD(pdf.CodigoFiscal,1000) IN (101,102) A' +
        'ND pdf.ICMSValor<>0))'
      ''
      
        '              AND (n.Filial, n.Serie) IN (SELECT sf.Filial, sf.V' +
        'alor FROM SeriesFiliais sf WHERE sf.Ativa)'
      '        ) AS Vl_Total'
      '    '
      ''
      ') AS selecao'
      ''
      'WHERE COALESCE(Som_Parc, 0) <> 0')
    RequestLive = False
    Left = 592
    Top = 616
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object qryRegistroG110saldo_in_icms: TFloatField
      FieldName = 'saldo_in_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroG110som_parc: TFloatField
      FieldName = 'som_parc'
      DisplayFormat = '0.00'
    end
    object qryRegistroG110vl_trib_exp: TFloatField
      FieldName = 'vl_trib_exp'
      DisplayFormat = '0.00'
    end
    object qryRegistroG110vl_total: TFloatField
      FieldName = 'vl_total'
      DisplayFormat = '0.00'
    end
    object qryRegistroG110ind_per_sai: TFloatField
      FieldName = 'ind_per_sai'
      DisplayFormat = '0.00'
    end
    object qryRegistroG110icms_aprop: TFloatField
      FieldName = 'icms_aprop'
      DisplayFormat = '0.00'
    end
    object qryRegistroG110som_icms_oc: TFloatField
      FieldName = 'som_icms_oc'
      DisplayFormat = '0.00'
    end
  end
  object qryRegistroG125: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        '/* MOVIMENTO SI os bens entraram antes do periodo de apuracao e ' +
        'possuem saldo a apropriar */'
      ';'
      'select i.numero as COD_IND_BEM,'
      '       i.dt_mov,'
      '       i.tipo_mov,'
      '       i.icmsvalor as VL_IMOB_ICMS_OP,'
      '       i.icmsvalordif as VL_IMOB_ICMS_DIF,'
      '       i.icmsvalorfrt as VL_IMOB_ICMS_FRT,'
      '       i.icmsvalorst as VL_IMOB_ICMS_ST,'
      '       i2.sequencia AS NUM_PARC,'
      '       i2.valor AS VL_PARC_PASS'
      'from'
      '('
      'select i.numero,'
      '       cast(:datainicial as date) as dt_mov,'
      '       cast('#39'SI'#39' as char(2)) as tipo_mov,'
      '       i.icmsvalor,'
      '       i.icmsvalordif,'
      '       i.icmsvalorfrt,'
      '       i.icmsvalorst'
      ''
      'from imobilizado i'
      ''
      'where i.iniciouso < :datainicial'
      '  and i.filialcontribuinte = :filial'
      '  and exists (select aii.numeroimobilizado'
      '              from apropriacaoicmsimobilizado aii'
      '              where aii.numeroimobilizado = i.numero'
      
        '                and aii.periodo between :datainicial and :datafi' +
        'nal'
      
        '                and aii.dataapropriacao between :datainicial and' +
        ' :datafinal)'
      ') as i join'
      ''
      '     (select i2.numero,'
      '             aii2.sequencia,'
      '             aii2.valor'
      
        '      from imobilizado i2 join apropriacaoicmsimobilizado aii2 o' +
        'n i2.numero = aii2.numeroimobilizado'
      '      where i2.filialcontribuinte = :filial'
      '        and aii2.periodo between :datainicial and :datafinal'
      
        '        and aii2.dataapropriacao between :datainicial and :dataf' +
        'inal) as i2 on i.numero = i2.numero'
      ''
      'union all'
      ''
      
        '/* MOVIMENTO IM  o bem entrou no periodo de apura'#231#227'o e n'#227'o '#233' tra' +
        'nsf. do ativo circulante*/'
      'select i.numero as COD_IND_BEM,'
      '       i.iniciouso as dt_mov,'
      '       cast('#39'IM'#39' as char(2)) as tipo_mov,'
      '       i.icmsvalor as VL_IMOB_ICMS_OP,'
      '       i.icmsvalordif as VL_IMOB_ICMS_DIF,'
      '       i.icmsvalorfrt as VL_IMOB_ICMS_FRT,'
      '       i.icmsvalorst as VL_IMOB_ICMS_ST,'
      '       aii.sequencia AS NUM_PARC,'
      '       aii.valor AS VL_PARC_PASS'
      ''
      
        'from imobilizado i join apropriacaoicmsimobilizado aii on i.nume' +
        'ro = aii.numeroimobilizado'
      ''
      'where i.iniciouso between :datainicial and :datafinal'
      '  and i.filialcontribuinte = :filial'
      '  and aii.periodo between :datainicial and :datafinal'
      '  and aii.dataapropriacao between :datainicial and :datafinal'
      '  and not exists (select pnp.codigonota'
      '                  from notaspag np'
      '                       join produtosnotaspag pnp'
      '                       on np.codigo = pnp.codigonota'
      '                  where np.codigo = pnp.codigonota'
      '                     and i.codigonota = np.codigo'
      '                     /*'
      
        '                     and i.fornecedor_entrada     = np.fornecedo' +
        'r'
      
        '                     and i.tipofornecedor_entrada = np.tipoforne' +
        'cedor'
      '                     and i.serie_entrada          = np.serie'
      '                     and i.numero_entrada         = np.numero'
      '                     */'
      '                     and pnp.produto = i.codigobem'
      '                     and pnp.filial = i.filialcontribuinte'
      '                     /*and i.numitemdocfiscal = pnp.numero*/'
      '                     and mod(np.codigofiscal,1000)=552'
      
        '                     and np.data between :datainicial and :dataf' +
        'inal)'
      ''
      'UNION ALL'
      ''
      
        '/* MOVIMENTO MC  o bem entrou no periodo de apura'#231#227'o e '#233' transf.' +
        ' do ativo circulante*/'
      'select i.numero as COD_IND_BEM,'
      '       i.iniciouso as dt_mov,'
      '       cast('#39'MC'#39' as char(2)) as tipo_mov,'
      '       i.icmsvalor as VL_IMOB_ICMS_OP,'
      '       i.icmsvalordif as VL_IMOB_ICMS_DIF,'
      '       i.icmsvalorfrt as VL_IMOB_ICMS_FRT,'
      '       i.icmsvalorst as VL_IMOB_ICMS_ST,'
      '       aii.sequencia AS NUM_PARC,'
      '       aii.valor AS VL_PARC_PASS'
      ''
      ''
      'from imobilizado i'
      '     join notaspag np on i.codigonota = np.codigo'
      
        '                        /*i.fornecedor_entrada     = np.forneced' +
        'or'
      
        '                     and i.tipofornecedor_entrada = np.tipoforne' +
        'cedor'
      '                     and i.serie_entrada          = np.serie'
      '                     and i.numero_entrada         = np.numero*/'
      ''
      '     join produtosnotaspag pnp on np.codigo = pnp.codigonota'
      '                              and pnp.produto = i.codigobem'
      
        '                              and pnp.filial  = i.filialcontribu' +
        'inte'
      
        '                              /*and i.numitemdocfiscal = pnp.num' +
        'ero*/'
      ''
      
        '     join apropriacaoicmsimobilizado aii on i.numero = aii.numer' +
        'oimobilizado'
      ''
      'where i.iniciouso between :datainicial and :datafinal'
      '  and i.filialcontribuinte = :filial'
      '  and np.data between :datainicial and :datafinal'
      '  and aii.periodo between :datainicial and :datafinal'
      '  and aii.dataapropriacao between :datainicial and :datafinal'
      '  and mod(np.codigofiscal,1000)=552'
      ''
      'UNION ALL'
      ''
      
        '/* MOVIMENTO BA  Al'#233'm dos movimentos acima, sendo o '#250'ltimo movim' +
        'ento ser'#225' informado a baixa*/'
      'select i.numero as COD_IND_BEM,'
      '       aii.periodo as dt_mov,'
      '       cast('#39'BA'#39' as char(2)) as tipo_mov,'
      '       cast(null as numeric(15,2)) as VL_IMOB_ICMS_OP,'
      '       cast(null as numeric(15,2)) as VL_IMOB_ICMS_DIF,'
      '       cast(null as numeric(15,2)) as VL_IMOB_ICMS_FRT,'
      '       cast(null as numeric(15,2)) as VL_IMOB_ICMS_ST,'
      '       cast(null as integer) AS NUM_PARC,'
      '       cast(null as numeric(15,2)) AS VL_PARC_PASS'
      ''
      
        'from imobilizado i join apropriacaoicmsimobilizado aii on i.nume' +
        'ro = aii.numeroimobilizado'
      ''
      'where aii.periodo between :datainicial and :datafinal'
      '  and aii.dataapropriacao between :datainicial and :datafinal'
      '  and aii.sequencia = i.nmeses'
      '  and i.filialcontribuinte = :filial'
      ''
      'UNION ALL'
      ''
      
        '/* MOVIMENTO OUTRAS SAIDAS  AT, PE ou OT Baixa por nota fiscal d' +
        'e saida */'
      'select i.numero as COD_IND_BEM,'
      '       i.data_saida as dt_mov,'
      '       i.tipomovimentosaida as tipo_mov,'
      '       cast(null as numeric(15,2)) as VL_IMOB_ICMS_OP,'
      '       cast(null as numeric(15,2)) as VL_IMOB_ICMS_DIF,'
      '       cast(null as numeric(15,2)) as VL_IMOB_ICMS_FRT,'
      '       cast(null as numeric(15,2)) as VL_IMOB_ICMS_ST,'
      '       cast(null as integer) AS NUM_PARC,'
      '       cast(null as numeric(15,2)) AS VL_PARC_PASS'
      ''
      
        'from imobilizado i join apropriacaoicmsimobilizado aii on i.nume' +
        'ro = aii.numeroimobilizado'
      ''
      'where i.data_saida between :datainicial and :datafinal'
      '  and i.filialcontribuinte = :filial'
      '  and aii.periodo between :datainicial and :datafinal'
      '  and aii.dataapropriacao between :datainicial and :datafinal')
    RequestLive = False
    Left = 656
    Top = 632
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
