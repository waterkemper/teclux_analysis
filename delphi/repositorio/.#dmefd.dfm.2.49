  object qryRegistro0150_DF_Anterior: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '/* clientes - sa'#237'das */'
      'select distinct'
      
        '       cast(df.tipocliente|| cast(df.cliente as varchar) as varc' +
        'har(60)) as cod_part,'
      '       df.nome,'
      '       (case when df.estado='#39'.'#39' then'
      '        (select c.codigoibge'
      '         from cidades c'
      '         where c.codigo = df.cidade'
      '           and c.estado = df.estado)'
      '       else'
      '       1058 end) as cod_pais,'
      ''
      '       case when df.pessoatipo='#39'J'#39' and df.estado<>'#39'.'#39' then'
      '         df.pessoanumero'
      '       else cast(null as varchar(14)) end as cnpj,'
      ''
      '       case when df.pessoatipo='#39'F'#39' and df.estado<>'#39'.'#39' then'
      '         df.pessoanumero'
      '       else cast(null as varchar(11)) end as cpf,'
      ''
      '       case when df.pessoatipo='#39'J'#39' then'
      '         df.documento'
      '       else cast(null as varchar(14)) end as ie,'
      ''
      '       case when df.estado<>'#39'.'#39' then'
      '         df.cidadeibge'
      '       else 9999999 end as cod_mun,'
      ''
      '       df.suframa,'
      ''
      '       cast(case when df.estado<>'#39'.'#39' then'
      
        '         replace(replace(replace(df.rua,chr(13),'#39#39'),chr(10),'#39#39'),' +
        'chr(18),'#39#39')'
      '       else'
      '         (select c.nome'
      '          from cidades c'
      '          where c.codigo = df.cidade'
      '            and c.estado = df.estado)||'#39' - '#39'||'
      
        '            replace(replace(replace(df.rua,chr(13),'#39#39'),chr(10),'#39 +
        #39'),chr(18),'#39#39')'
      '         end as varchar(60)) as end,'
      ''
      '       df.endnumero as num,'
      '       df.endcomplemento as compl,'
      ''
      '       df.nomebairro as bairro'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      'where df.data between :datainicial and :datafinal'
      ''
      'union'
      ''
      '/* fornecedores de transporte - sa'#237'das */'
      ''
      'select distinct'
      
        '       cast('#39'F'#39'|| cast(df.fornecedortransporte as varchar) as va' +
        'rchar(60)) as cod_part,'
      '       f.nome,'
      '       (case when f.estado='#39'.'#39' then'
      '        (select c.codigoibge'
      '         from cidades c'
      '         where c.codigo = f.cidade'
      '           and c.estado = f.estado)'
      '       else'
      '       1058 end) as cod_pais,'
      ''
      '       case when f.pessoatipo='#39'J'#39' and f.estado<>'#39'.'#39' then'
      '         f.pessoanumero'
      '       else cast(null as varchar(14)) end as cnpj,'
      ''
      '       case when f.pessoatipo='#39'F'#39' and f.estado<>'#39'.'#39' then'
      '         f.pessoanumero'
      '       else cast(null as varchar(11)) end as cpf,'
      ''
      '       case when f.pessoatipo='#39'J'#39' then'
      '         f.pessoanumero'
      '       else cast(null as varchar(14)) end as ie,'
      ''
      '       case when f.estado<>'#39'.'#39' then'
      '        (select c.codigoibge'
      '         from cidades c'
      '         where c.codigo = f.cidade'
      '           and c.estado = f.estado)'
      '       else 9999999 end as cod_mun,'
      ''
      '       f.suframa,'
      ''
      '       cast(case when f.estado<>'#39'.'#39' then'
      
        '         replace(replace(replace(f.rua,chr(13),'#39#39'),chr(10),'#39#39'),c' +
        'hr(18),'#39#39')'
      '       else'
      '         (select c.nome'
      '          from cidades c'
      '          where c.codigo = f.cidade'
      '            and c.estado = f.estado)||'#39' - '#39'||'
      
        '         replace(replace(replace(f.rua,chr(13),'#39#39'),chr(10),'#39#39'),c' +
        'hr(18),'#39#39')'
      '         end as varchar(60)) as end,'
      ''
      '       f.numero as num,'
      '       f.complemento as compl,'
      ''
      '       (select b.nome'
      '        from bairros b'
      '        where b.estado = f.estado'
      '          and b.cidade = f.cidade'
      '          and b.codigo = f.bairro) as bairro'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join fornecedores f'
      '     on df.fornecedortransporte = f.codigo'
      ''
      'where df.data between :datainicial and :datafinal'
      ''
      ''
      'union'
      ''
      '/* fornecedores - entradas */'
      ''
      'select distinct'
      
        '       cast(np.tipofornecedor|| cast(np.fornecedor as varchar) a' +
        's varchar(60)) as cod_part,'
      '       np.nome, /**n'#227'o esta sendo atualizado**/'
      ''
      '       (case when np.estado='#39'.'#39' then'
      '        (select c.codigoibge'
      '         from cidades c'
      '         where c.codigo = np.cidade'
      '           and c.estado = np.estado)'
      '       else'
      '        1058 end) as cod_pais,'
      ''
      '       (case when np.estado<>'#39'.'#39' then'
      '         np.cnpj'
      '        else cast(null as varchar(14)) end) as cnpj,'
      ''
      '       cast(null as varchar(11)) as cpf,'
      '       np.inscricaoestadual as ie,'
      ''
      '       case when np.estado<>'#39'.'#39' then'
      '         np.cidadeibge'
      '       else 9999999 end as cod_mun,'
      ''
      '       /* np.suframa, **n'#227'o existe** */'
      '       case when np.tipofornecedor = '#39'L'#39' then'
      
        '              (select f.suframa from filiais f where f.codigo = ' +
        'np.fornecedor)'
      '            when np.tipofornecedor = '#39'F'#39' then'
      
        '              (select f.suframa from fornecedores f where f.codi' +
        'go = np.fornecedor)'
      '            when np.tipofornecedor = '#39'C'#39' then'
      
        '              (select c.suframa from clientes c where c.codigo =' +
        ' np.fornecedor)'
      '       end as suframa,'
      ''
      '       cast(case when np.estado<>'#39'.'#39' then'
      
        '         replace(replace(replace(np.rua,chr(13),'#39#39'),chr(10),'#39#39'),' +
        'chr(18),'#39#39')'
      '       else'
      '         (select c.nome'
      '          from cidades c'
      '          where c.codigo = np.cidade'
      '            and c.estado = np.estado)||'#39' - '#39'||'
      
        '         replace(replace(replace(np.rua,chr(13),'#39#39'),chr(10),'#39#39'),' +
        'chr(18),'#39#39')'
      '         end as varchar(60)) as end,'
      ''
      '       np.endnumero as num,'
      '       np.endcomplemento as compl,'
      ''
      '       np.nomebairro as bairro'
      ''
      'from notaspag np'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao<>'#39'P'#39
      ''
      'union'
      ''
      '/* fornecedores de transportes - entradas */'
      ''
      'select distinct'
      
        '       cast('#39'F'#39'|| cast(np.fornecedorconhecimentofrete as varchar' +
        ') as varchar(60)) as cod_part,'
      '       (select f.nome'
      '        from fornecedores f'
      
        '        where f.codigo = np.fornecedorconhecimentofrete) as nome' +
        ','
      ''
      '       (case when f.estado='#39'.'#39' then'
      '        (select c.codigoibge'
      '         from cidades c'
      '         where c.codigo = f.cidade'
      '           and c.estado = f.estado)'
      '       else'
      '        1058 end) as cod_pais,'
      ''
      '       case when f.pessoatipo='#39'J'#39' and f.estado<>'#39'.'#39' then'
      '         f.pessoanumero'
      '       else cast(null as varchar(14)) end as cnpj,'
      ''
      '       case when f.pessoatipo='#39'F'#39' and f.estado<>'#39'.'#39' then'
      '         f.pessoanumero'
      '       else cast(null as varchar(11)) end as cpf,'
      ''
      '       case when f.pessoatipo='#39'J'#39' then'
      '         f.pessoanumero'
      '       else cast(null as varchar(14)) end as ie,'
      ''
      '       case when f.estado<>'#39'.'#39' then'
      '        (select c.codigoibge'
      '         from cidades c'
      '         where c.codigo = f.cidade'
      '           and c.estado = f.estado)'
      '       else 9999999 end as cod_mun,'
      ''
      '       f.suframa,'
      ''
      '       cast(case when f.estado<>'#39'.'#39' then'
      
        '         replace(replace(replace(f.rua,chr(13),'#39#39'),chr(10),'#39#39'),c' +
        'hr(18),'#39#39')'
      '       else'
      '         (select c.nome'
      '          from cidades c'
      '          where c.codigo = f.cidade'
      '            and c.estado = f.estado)||'#39' - '#39'||'
      
        '         replace(replace(replace(f.rua,chr(13),'#39#39'),chr(10),'#39#39'),c' +
        'hr(18),'#39#39')'
      '         end as varchar(60)) as end,'
      ''
      '       f.numero as num,'
      '       f.complemento as compl,'
      ''
      '       (select b.nome'
      '        from bairros b'
      '        where b.estado = f.estado'
      '          and b.cidade = f.cidade'
      '          and b.codigo = f.bairro) as bairro'
      ''
      
        'from notaspag np join fornecedores f on np.fornecedorconheciment' +
        'ofrete = f.codigo'
      'where np.data between :datainicial and :datafinal'
      '  and  np.situacao<>'#39'P'#39
      '')
    RequestLive = False
    Left = 172
    Top = 64
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
  end
  object qryRegistroD190: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroD100
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ''
      'select np.codigo        as chave,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       pnp.incidencia   as cst_icms,'
      '       pnp.codigofiscal as cfop,'
      '       pnp.aliquotaicms     as aliq_icms,'
      ''
      '       sum((pnp.quantidade * pnp.precounitario) +'
      '        coalesce(pnp.frete,0) +'
      '        coalesce(pnp.seguro,0) +'
      '        coalesce(pnp.despesasacessorias,0) +'
      '        coalesce(pnp.acrescimo,0) -'
      '        coalesce(pnp.desconto,0) +'
      '        coalesce(pnp.valoripi,0)) as vl_opr,'
      
        '        sum( case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'9' +
        '0'#39') and not pnp.naogerarcreditoicms then  pnp.icmsbasecalculo el' +
        'se 0 end) as vl_bc_icms,'
      
        '        sum( case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'9' +
        '0'#39') and not pnp.naogerarcreditoicms then  pnp.icmsvalor else 0 e' +
        'nd) as vl_icms,'
      ''
      '       sum(pnp.valorreducaobase) as vl_red_bc'
      ''
      
        'from notaspag np join produtosnotaspag pnp on np.codigo = pnp.co' +
        'digonota'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao='#39'N'#39
      '  and cast(coalesce(np.modelodocto,'#39'01'#39') as varchar(2)) in'
      '  ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39')'
      '  and np.filial = :filial'
      
        'group by np.codigo,  pnp.incidencia, pnp.codigofiscal, pnp.aliqu' +
        'otaicms'
      
        'order by np.codigo,  pnp.incidencia, pnp.codigofiscal, pnp.aliqu' +
        'otaicms'
      ''
      ''
      '/*'
      'select np.codigo        as chave,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       n.icmscst        as cst_icms,'
      '       cnp.codigofiscal as cfop,'
      '       cnp.aliquota     as aliq_icms,'
      '       cnp.base         as vl_opr,'
      '       cnp.base         as vl_bc_icms,'
      '       cnp.valor        as vl_icms,'
      '       0.00             as vl_red_bc'
      ''
      'from (notaspag np'
      '      join (calculosnotaspag cnp'
      '            join naturezas n'
      '            on n.codigo = cnp.codigonatureza)'
      '      on np.codigo = cnp.codigonota)'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao='#39'N'#39
      '  and cast(coalesce(np.modelodocto,'#39'01'#39') as varchar(2)) in'
      '  ('#39'07'#39','#39'08'#39','#39'8B'#39','#39'09'#39','#39'10'#39','#39'11'#39','#39'26'#39','#39'27'#39','#39'57'#39')'
      '  and cnp.tipo = '#39'M'#39
      '  and np.filial = :filial'
      '  */')
    RequestLive = False
    Left = 160
    Top = 527
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroD190chave: TIntegerField
      FieldName = 'chave'
      DisplayFormat = '0'
    end
    object qryRegistroD190ind_oper: TStringField
      FieldName = 'ind_oper'
      Size = 1
    end
    object qryRegistroD190cst_icms: TStringField
      FieldName = 'cst_icms'
      Size = 2
    end
    object qryRegistroD190cfop: TIntegerField
      FieldName = 'cfop'
      DisplayFormat = '0'
    end
    object qryRegistroD190aliq_icms: TFloatField
      FieldName = 'aliq_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroD190vl_opr: TFloatField
      FieldName = 'vl_opr'
      DisplayFormat = '0.00'
    end
    object qryRegistroD190vl_bc_icms: TFloatField
      FieldName = 'vl_bc_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroD190vl_icms: TFloatField
      FieldName = 'vl_icms'
      DisplayFormat = '0.00'
    end
    object qryRegistroD190vl_red_bc: TFloatField
      FieldName = 'vl_red_bc'
      DisplayFormat = '0.00'
    end
  end
