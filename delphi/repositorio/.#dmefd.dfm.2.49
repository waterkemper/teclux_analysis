  object qryRegistroC460: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 
      'filial=filial;numerousuario=num_usu;numerofabricacao=num_fab;cro' +
      '=cro;crz=crz'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC405
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cast('#39'2D'#39' as varchar(2)) as COD_MOD,'
      
        '       case when dlc.canc='#39'S'#39' then cast('#39'02'#39' as varchar(2))  /* ' +
        'cancelado    */'
      
        '       else                        cast('#39'00'#39' as varchar(2))  /* ' +
        'regular      */'
      '       end as cod_sit,'
      '       dc.coo,'
      '       dlc.vl_tot as vl_doc,'
      '       0.00 as vl_pis,'
      '       0.00 as vl_cofins,'
      '       dlc.cnpj_cpf,'
      '       dlc.nome_cli,'
      ''
      '       dc.filial,'
      '       dc.num_usu, dc.num_fab,'
      '       dc.cro,'
      '       dlc.dt_ini as dt_doc,'
      '       dlc.crz,'
      ''
      '       dlc.canc'
      ''
      ''
      'from dadoscupom dc'
      '     join detalhecupom dlc'
      '       on dc.filial = dlc.filial'
      '       and dc.num_usu = dlc.num_usu'
      '       and dc.num_fab = dlc.num_fab'
      '       and dc.cro = dlc.cro'
      '       and dc.coo = dlc.coo'
      ''
      
        'where cast(dlc.dt_ini as date) between :datainicial and :datafin' +
        'al'
      '  and dc.filial = :filial'
      ''
      'order by dc.filial,'
      '         dc.num_usu, dc.num_fab,'
      '         dc.cro,'
      '         dlc.dt_ini')
    RequestLive = False
    Left = 312
    Top = 400
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
