  object qryRegistroC350: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.modelodocto     as cod_mod,'
      '       n.serie            as ser,'
      '       n.numero           as num_doc,'
      '       df.data            as dt_doc,'
      ''
      '       case when df.pessoatipo in ('#39'F'#39','#39'J'#39') then df.pessoanumero'
      '       else cast(null as varchar(14)) end as cnpj_cpf,'
      ''
      '       coalesce(df.valorprodutos   ,0) as vl_merc,'
      '       coalesce(df.valortotal      ,0) as vl_doc,'
      '       coalesce(df.desconto        ,0) as vl_desc,'
      '       coalesce(df.totalvalorpis   ,0) as vl_pis,'
      '       coalesce(df.totalvalorcofins,0) as vl_cofins'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      'where df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'02'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'order by df.modelodocto, n.serie, df.data, n.numero')
    RequestLive = False
    Left = 36
    Top = 272
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
