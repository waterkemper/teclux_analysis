  object qryRegistroC590: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'chave=chave;ind_oper=ind_oper'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC500
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select np.codigo        as chave,'
      '       cast(0 as varchar(1)) as ind_oper,'
      '       pnp.incidencia   as cst_icms,'
      '       pnp.codigofiscal as cfop,'
      '       pnp.aliquotaicms     as aliq_icms,'
      ''
      '       sum((pnp.quantidade * pnp.precounitario) +'
      '        coalesce(pnp.frete,0) +'
      '        coalesce(pnp.seguro,0) +'
      '        coalesce(pnp.despesasacessorias,0) +'
      '        coalesce(pnp.acrescimo,0) -'
      '        coalesce(pnp.desconto,0) +'
      '        coalesce(pnp.valoripi,0) +'
      '        coalesce(pnp.icmsvalorst,0) ) as vl_opr,'
      ''
      
        '        sum( case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'9' +
        '0'#39') and not pnp.naogerarcreditoicms then  pnp.icmsbasecalculo el' +
        'se 0 end) as vl_bc_icms,'
      
        '        sum( case when pnp.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'9' +
        '0'#39') and not pnp.naogerarcreditoicms then  pnp.icmsvalor else 0 e' +
        'nd) as vl_icms,'
      ''
      '/*'
      '       sum(pnp.icmsbasecalculost) as vl_bc_icms_st,'
      '       sum(pnp.icmsvalorst) as vl_icms_st'
      '*/'
      ''
      '       0.00 as vl_bc_icms_st,'
      '       0.00 as vl_icms_st'
      ''
      ''
      
        'from notaspag np join produtosnotaspag pnp on np.codigo = pnp.co' +
        'digonota'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao='#39'N'#39
      '  and np.modelodocto in ('#39'06'#39','#39'28'#39','#39'29'#39')'
      '/*  and cnp.tipo = '#39'M'#39'*/'
      '  and np.filial = :filial'
      
        'group by np.codigo,  pnp.incidencia, pnp.codigofiscal, pnp.aliqu' +
        'otaicms'
      
        'order by np.codigo,  pnp.incidencia, pnp.codigofiscal, pnp.aliqu' +
        'otaicms'
      ''
      ''
      ''
      '/*'
      'from (notaspag np'
      '      join (calculosnotaspag cnp'
      '           join naturezas n'
      '           on n.codigo = cnp.codigonatureza)'
      '      on np.codigo = cnp.codigonota)'
      'where np.data between :datainicial and :datafinal'
      '  and np.situacao<>'#39'P'#39
      '  and np.modelodocto in ('#39'06'#39','#39'28'#39')'
      '  and cnp.tipo = '#39'M'#39
      '  and np.filial = :filial'
      '  */')
    RequestLive = False
    Left = 160
    Top = 455
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
