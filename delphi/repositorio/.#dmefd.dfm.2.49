  object qryRegistroG126: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'cod_ind_bem=cod_ind_bem;num_parc=num_parc_mescorrente'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroG125
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select numero as cod_ind_bem,  dt_ini, dt_fim, num_parc, vl_parc' +
        '_pass, vl_trib_oc, vl_total,'
      '       vl_trib_oc/vl_total as ind_per_sai,'
      '       vl_parc_pass * (vl_trib_oc/vl_total) as VL_PARC_APROP,'
      '       num_parc_mescorrente'
      ''
      'from'
      '('
      ''
      
        '  select numero, dt_ini, dt_fim, num_parc, vl_parc_pass, num_par' +
        'c_mescorrente,'
      ''
      '          /* TOTAL VENDIDO E TRIBUTADO NO PERIODO*/'
      '          ('
      '          select sum((pdf.quantidade * pdf.precovenda) +'
      '                  coalesce(pdf.frete,0) +'
      '                  coalesce(pdf.seguro,0) +'
      '                  coalesce(pdf.despesasacessorias,0) +'
      '                  coalesce(pdf.vicmsstretdesp,0) +'
      '                  coalesce(pdf.acrescimo,0) -'
      '                  coalesce(pdf.valordescontoitem,0) -'
      '                  coalesce(pdf.desconto,0) +'
      '                  coalesce(pdf.valoripi,0) +'
      '                  coalesce(pdf.icmsvalorst,0)) as vl_opr'
      ''
      '          from dadosfiscais df'
      '               join notas n'
      '               on df.numero = n.dadofiscal'
      ''
      '               join produtosdadosfiscais pdf'
      '               on df.numero = pdf.dadofiscal'
      '          where df.numero = pdf.dadofiscal'
      '            and df.data between dt_ini and dt_fim'
      '            and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '            and df.CodigoFiscal < 8000'
      '            and df.situacao = '#39'N'#39
      '            and df.filialemissao = :filial'
      ''
      
        '            and ((substring(cast(pdf.codigofiscal as varchar),1,' +
        '1)='#39'7'#39' and mod(pdf.codigofiscal,1000) in (101,102)) or'
      
        '                 (substring(cast(pdf.codigofiscal as varchar),1,' +
        '1) in ('#39'5'#39','#39'6'#39') and mod(pdf.codigofiscal,1000) in (101,102) and ' +
        'pdf.icmsvalor<>0))'
      ''
      
        '            and (n.filial,n.serie) in (select sf.filial,sf.valor' +
        ' from seriesfiliais sf where sf.ativa)'
      ''
      '          ) as vl_trib_oc,'
      ''
      '          /* TOTAL VENDIDO*/'
      '          ('
      '          select sum((pdf.quantidade * pdf.precovenda) +'
      '                  coalesce(pdf.frete,0) +'
      '                  coalesce(pdf.seguro,0) +'
      '                  coalesce(pdf.despesasacessorias,0) +'
      '                  coalesce(pdf.vicmsstretdesp,0) +'
      '                  coalesce(pdf.acrescimo,0) -'
      '                  coalesce(pdf.valordescontoitem,0) -'
      '                  coalesce(pdf.desconto,0) +'
      '                  coalesce(pdf.valoripi,0) +'
      '                  coalesce(pdf.icmsvalorst,0)) as vl_opr'
      ''
      '          from dadosfiscais df'
      '               join notas n'
      '               on df.numero = n.dadofiscal'
      ''
      '               join produtosdadosfiscais pdf'
      '               on df.numero = pdf.dadofiscal'
      '          where df.numero = pdf.dadofiscal'
      '            and df.data between dt_ini and dt_fim'
      '            and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '            and df.CodigoFiscal < 8000'
      '            and df.situacao = '#39'N'#39
      '            and df.filialemissao = :filial'
      ''
      
        '            and ((substring(cast(pdf.codigofiscal as varchar),1,' +
        '1)='#39'7'#39' and mod(pdf.codigofiscal,1000) in (101,102)) or'
      
        '                 (substring(cast(pdf.codigofiscal as varchar),1,' +
        '1) in ('#39'5'#39','#39'6'#39') and mod(pdf.codigofiscal,1000) in (101,102)))'
      ''
      
        '            and (n.filial,n.serie) in (select sf.filial,sf.valor' +
        ' from seriesfiliais sf where sf.ativa)'
      ''
      '          ) as vl_total'
      ''
      '  from'
      '  ('
      '    select i.numero,'
      
        '           cast(date_part('#39'year'#39',aii.periodo)||'#39'-'#39'||date_part('#39'm' +
        'onth'#39',aii.periodo)||'#39'-01'#39' as date) as dt_ini,'
      ''
      
        '           cast(date_part('#39'year'#39',aii.periodo)||'#39'-'#39'||date_part('#39'm' +
        'onth'#39',aii.periodo)||'#39'-'#39'||'
      
        '           diasnomes(cast(date_part('#39'year'#39',aii.periodo) as integ' +
        'er),cast(date_part('#39'month'#39',aii.periodo) as integer)) as date) as' +
        ' dt_fim,'
      ''
      '           aii.sequencia as num_parc,'
      '           aii.valor AS VL_PARC_PASS,'
      ''
      
        '           /* S'#211' DEVE EXISTIR UM VENCIMENTO NO M'#202'S, NECESS'#193'RIO P' +
        ' RELACIONAR C G125 */'
      '           (select aii2.sequencia'
      '            from apropriacaoicmsimobilizado aii2'
      '            where aii2.numeroimobilizado = i.numero'
      
        '              and aii2.periodo between :datainicial and :datafin' +
        'al'
      
        '              and aii.dataapropriacao between :datainicial and :' +
        'datafinal order by aii2.sequencia LIMIT 1) as num_parc_mescorren' +
        'te'
      ''
      ''
      '    from imobilizado i'
      '         join apropriacaoicmsimobilizado aii'
      '         on i.numero = aii.numeroimobilizado'
      ''
      '    where i.iniciouso < :datainicial'
      '      and i.filialcontribuinte = :filial'
      '      and aii.periodo < :datainicial'
      '      and i.codigonota is not null'
      
        '      and aii.dataapropriacao between :datainicial and :datafina' +
        'l'
      '      and exists ( select i2.numero'
      
        '                   from imobilizado i2 join apropriacaoicmsimobi' +
        'lizado aii2'
      '                     on i2.numero = aii2.numeroimobilizado'
      '                   where i2.filialcontribuinte = :filial'
      
        '                     and aii2.periodo between :datainicial and :' +
        'datafinal'
      
        '                     and aii2.dataapropriacao between :datainici' +
        'al and :datafinal'
      '                     and i2.numero = i.numero'
      '                     and i2.codigonota is not null)'
      '  ) as i'
      ') AS I')
    RequestLive = False
    Left = 768
    Top = 640
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
    object qryRegistroG126cod_ind_bem: TIntegerField
      FieldName = 'cod_ind_bem'
      DisplayFormat = '0'
    end
    object qryRegistroG126dt_ini: TDateField
      Alignment = taCenter
      FieldName = 'dt_ini'
      EditMask = '99/99/9999;1; '
    end
    object qryRegistroG126dt_fim: TDateField
      Alignment = taCenter
      FieldName = 'dt_fim'
      EditMask = '99/99/9999;1; '
    end
    object qryRegistroG126num_parc: TIntegerField
      FieldName = 'num_parc'
      DisplayFormat = '0'
    end
    object qryRegistroG126vl_parc_pass: TFloatField
      FieldName = 'vl_parc_pass'
      DisplayFormat = '0.00'
    end
    object qryRegistroG126vl_trib_oc: TFloatField
      FieldName = 'vl_trib_oc'
      DisplayFormat = '0.00'
    end
    object qryRegistroG126vl_total: TFloatField
      FieldName = 'vl_total'
      DisplayFormat = '0.00'
    end
    object qryRegistroG126ind_per_sai: TFloatField
      FieldName = 'ind_per_sai'
      DisplayFormat = '0.00'
    end
    object qryRegistroG126vl_parc_aprop: TFloatField
      FieldName = 'vl_parc_aprop'
      DisplayFormat = '0.00'
    end
    object qryRegistroG126num_parc_mescorrente: TIntegerField
      FieldName = 'num_parc_mescorrente'
      DisplayFormat = '0'
    end
  end
  object qryRegistroG130eG140: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'cod_ind_bem=cod_ind_bem;tipo_mov=tipo_mov'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroG125
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      '   select i.numero as COD_IND_BEM,'
      ''
      '       case when i.tipofornecedor_entrada = '#39'L'#39' then'
      '            cast(0 as varchar(1))  /* emiss'#227'o pr'#243'pria */'
      '       else cast(1 as varchar(1))  /* terceiros       */'
      '       end as ind_emit,'
      '       i.tipo_mov,'
      
        '       cast((i.tipofornecedor_entrada||cast(i.fornecedor_entrada' +
        ' as varchar)) as varchar(60)) as cod_part,'
      '       case when i.tipofornecedor_entrada = '#39'F'#39' THEN'
      '                 (select sf.modelodoctofiscal'
      '                  from seriesfornecedores sf'
      '                  where sf.fornecedor = i.fornecedor_entrada'
      '                    and sf.serie = i.serie_entrada)'
      '           when i.tipofornecedor_entrada = '#39'C'#39' then'
      '                 (select sc.modelodoctofiscal'
      '                  from seriesclientes sc'
      '                  where sc.cliente = i.fornecedor_entrada'
      '                    and sc.serie = i.serie_entrada)'
      '           when i.tipofornecedor_entrada = '#39'L'#39' then'
      '                 (select sf.modelodoctofiscal'
      '                  from seriesfiliais sf'
      '                  where sf.filial = i.fornecedor_entrada'
      '                    and sf.valor = i.serie_entrada)'
      '       end as cod_mod,'
      '       i.serie_entrada as serie,'
      '       i.numero_entrada as num_doc,'
      ''
      '/*       case when i.tipofornecedor_entrada = '#39'L'#39' then*/'
      '            /* emiss'#227'o pr'#243'pria */'
      '            (select np.chv_nfe'
      '             from notaspag np'
      '             where np.fornecedor = i.fornecedor_entrada'
      '               and np.tipofornecedor = i.tipofornecedor_entrada'
      '               and np.serie = i.serie_entrada'
      '               and np.numero = i.numero_entrada'
      '             )'
      '/*       else cast(null as varchar(44))*/  /* terceiros       */'
      '/*       end */ as CHV_NFE_CTE,'
      ''
      '       i.data_entrada as dt_doc,'
      '       i.numitemdocfiscal as num_item,'
      '       cast(('#39'P'#39'||i.codigobem) as varchar(60)) as cod_item'
      'from'
      '('
      ''
      
        '/* MOVIMENTO SI  os bens entraram antes do periodo de apuracao e' +
        ' possuem saldo a apropriar */'
      ''
      '('
      'select i.*'
      'from'
      '('
      'select i.numero,'
      '       np.tipofornecedor as tipofornecedor_entrada,'
      '       np.fornecedor as fornecedor_entrada,'
      '       np.serie as serie_entrada,'
      '       np.numero as numero_entrada,'
      '       i.data_entrada,'
      '       i.codigobem,'
      '       pnp.numero as numitemdocfiscal,'
      '       cast('#39'SI'#39' as char(2)) as tipo_mov'
      ''
      'from imobilizado i'
      '     join notaspag np'
      '     on i.codigonota  = np.codigo'
      '     '
      '      join produtosnotaspag pnp'
      '      on pnp.codigonota = i.codigonota'
      '      and pnp.produto = i.codigobem'
      '       and pnp.filial = i. filialcontribuinte'
      ''
      ''
      'where i.iniciouso < :datainicial'
      '  and i.filialcontribuinte =:filial'
      '  and exists (select aii.numeroimobilizado'
      '              from apropriacaoicmsimobilizado aii'
      '              where aii.numeroimobilizado = i.numero'
      
        '                and aii.periodo between :datainicial and :datafi' +
        'nal'
      
        '                and aii.dataapropriacao between :datainicial and' +
        ' :datafinal)'
      ') as i join'
      ''
      '     (select i2.numero,'
      '             aii2.sequencia,'
      '             aii2.valor'
      
        '      from imobilizado i2 join apropriacaoicmsimobilizado aii2 o' +
        'n i2.numero = aii2.numeroimobilizado'
      '      where aii2.periodo between :datainicial and :datafinal'
      '            and i2.filialcontribuinte =:filial'
      
        '            and aii2.dataapropriacao between :datainicial and :d' +
        'atafinal) as i2 on i.numero = i2.numero'
      ')'
      ''
      'union all'
      ''
      
        '/* MOVIMENTO IM  o bem entrou no periodo de apura'#231#227'o e n'#227'o '#233' tra' +
        'nsf. do ativo circulante*/'
      ''
      '('
      'select i.numero,'
      '       np.tipofornecedor as tipofornecedor_entrada,'
      '       np.fornecedor as fornecedor_entrada,'
      '       np.serie as serie_entrada,'
      '       np.numero as numero_entrada,'
      '       i.data_entrada,'
      '       i.codigobem,'
      '       pnp.numero as numitemdocfiscal,'
      '       cast('#39'IM'#39' as char(2)) as tipo_mov'
      ''
      ''
      'from imobilizado i'
      '     join apropriacaoicmsimobilizado aii'
      '     on i.numero = aii.numeroimobilizado'
      ''
      '     join notaspag np'
      '     on i.codigonota  = np.codigo'
      ''
      '     join produtosnotaspag pnp'
      '     on pnp.codigonota = i.codigonota'
      '     and pnp.produto = i.codigobem'
      '     and pnp.filial = i. filialcontribuinte'
      ''
      'where i.iniciouso between :datainicial and :datafinal'
      '  and i.filialcontribuinte =:filial'
      '  and aii.periodo between :datainicial and :datafinal'
      '  and aii.dataapropriacao between :datainicial and :datafinal'
      '  and not exists (select pnp.codigonota'
      '                  from notaspag np'
      '                       join produtosnotaspag pnp'
      '                       on np.codigo = pnp.codigonota'
      '                  where np.codigo = pnp.codigonota'
      '                     and i.codigonota = np.codigo'
      '                     /*'
      
        '                     and i.fornecedor_entrada     = np.fornecedo' +
        'r'
      
        '                     and i.tipofornecedor_entrada = np.tipoforne' +
        'cedor'
      '                     and i.serie_entrada          = np.serie'
      '                     and i.numero_entrada         = np.numero'
      '                     */'
      '                     and pnp.produto = i.codigobem'
      '                     and pnp.filial = i.filialcontribuinte'
      '                     /*and i.numitemdocfiscal = pnp.numero*/'
      '                     and mod(pnp.codigofiscal,1000)=552'
      
        '                     and np.data between :datainicial and :dataf' +
        'inal)'
      ')'
      ''
      'UNION ALL'
      ''
      '('
      
        '/* MOVIMENTO MC  o bem entrou no periodo de apura'#231#227'o e '#233' transf.' +
        ' do ativo circulante*/'
      'select i.numero,'
      '       np.tipofornecedor as tipofornecedor_entrada,'
      '       np.fornecedor as fornecedor_entrada,'
      '       np.serie as serie_entrada,'
      '       np.numero as numero_entrada,'
      '       i.data_entrada,'
      '       i.codigobem,'
      '       pnp.numero as numitemdocfiscal,'
      '       cast('#39'MC'#39' as char(2)) as tipo_mov'
      ''
      ''
      'from imobilizado i'
      '     join notaspag np on i.codigonota = np.codigo'
      '         /*i.fornecedor_entrada     = np.fornecedor'
      
        '                     and i.tipofornecedor_entrada = np.tipoforne' +
        'cedor'
      '                     and i.serie_entrada          = np.serie'
      '                     and i.numero_entrada         = np.numero*/'
      ''
      '     join produtosnotaspag pnp on i.codigonota = pnp.codigonota'
      '                              and pnp.produto = i.codigobem'
      
        '                              and pnp.filial = i.filialcontribui' +
        'nte'
      
        '                              /*and i.numitemdocfiscal = pnp.num' +
        'ero*/'
      ''
      
        '     join apropriacaoicmsimobilizado aii on i.numero = aii.numer' +
        'oimobilizado'
      ''
      'where i.iniciouso between :datainicial and :datafinal'
      '  and i.filialcontribuinte =:filial'
      '  /*and np.data between :datainicial and :datafinal*/'
      '  and aii.periodo between :datainicial and :datafinal'
      '  and aii.dataapropriacao between :datainicial and :datafinal'
      '  and mod(np.codigofiscal,1000)=552'
      ')'
      ''
      ') as i'
      ''
      'UNION ALL'
      ''
      'select i.numero as COD_IND_BEM,'
      '       cast(0 as varchar(1)) as ind_emit,  /* emiss'#227'o pr'#243'pria */'
      '       i.tipomovimentosaida as tipo_mov,'
      
        '       cast((df.tipocliente||cast(df.cliente as varchar)) as var' +
        'char(60)) as cod_part,'
      '       df.modelodocto as cod_mod,'
      '       n.serie,'
      '       n.numero as num_doc,'
      '       df.chv_nfe as CHV_NFE_CTE,'
      '       i.data_saida as dt_doc,'
      '       pdf.numero as num_item,'
      
        '       cast(('#39'P'#39'||cast(i.codigobem as varchar)) as varchar(60)) ' +
        'as cod_item'
      ''
      'from imobilizado i'
      '     join apropriacaoicmsimobilizado aii'
      '          on i.numero = aii.numeroimobilizado'
      ''
      '     join dadosfiscais df'
      '          join notas n'
      '          on n.dadofiscal = df.numero'
      '     on i.dadofiscal = df.numero'
      ''
      '     join produtosdadosfiscais pdf'
      '     on pdf.dadofiscal = i.dadofiscal'
      '     and pdf.produto = i.codigobem'
      '     and pdf.filial = i.filialcontribuinte'
      ''
      ''
      'where i.data_saida between :datainicial and :datafinal'
      '  and i.filialcontribuinte = :filial'
      '  and aii.periodo between :datainicial and :datafinal'
      '  and aii.dataapropriacao between :datainicial and :datafinal'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      '')
    RequestLive = False
    Left = 696
    Top = 720
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
  end
  object qryRegistro0300: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select'
      '       /* REGISTRO 0300 */'
      '       i.numero as COD_IND_BEM,'
      '       cast(1 as smallint) as ident_merc,'
      '       RetiraBrancoePipeeASCII255(p.descricao) as DESCR_ITEM,'
      '       i.nmeses as NR_PARC,'
      ''
      '       case when pl.tipo = '#39'A'#39' then'
      
        '         cast(pl.classificacao||trim(to_char(pl.codigo,'#39'000000'#39')' +
        ') as varchar(60))'
      '       else'
      '         cast(pl.classificacao as varchar(60))'
      '       end as cod_cta,'
      ''
      ''
      '       /* REGISTRO 0305 */'
      '       i.centrodecusto as COD_CCUS,'
      '       RetiraBrancoePipeeASCII255(i.funcaobemnaempresa) as FUNC,'
      '       i.vidautil as VIDA_UTIL'
      ''
      'from imobilizado i'
      ''
      '     join planocontas pl'
      '     on i.ccdobem = pl.codigo'
      ''
      '     join apropriacaoicmsimobilizado aii'
      '     on i.numero = aii.numeroimobilizado'
      '     '
      '     join produtos p'
      '     on i.codigobem = p.codigo'
      ''
      'where /* i.data_entrada between :datainicial and :datafinal'
      '  and */ i.filialcontribuinte = :filial'
      '  and aii.periodo between :datainicial and :datafinal'
      '  and aii.dataapropriacao between :datainicial and :datafinal'
      '')
    RequestLive = False
    Left = 436
    Top = 22
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
  end
  object qryRegistro0500: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cast(:datainicial as date) as dt_alt,'
      '       cast(case when pl.natureza = '#39'A'#39'   then '#39'01'#39
      '                 when pl.natureza = '#39'P'#39'        then '#39'02'#39
      '                 when pl.natureza = '#39'L'#39'        then '#39'03'#39
      '                 when pl.natureza IN ('#39'R'#39','#39'D'#39') then '#39'04'#39
      '                 when pl.natureza = '#39'C'#39'        then '#39'05'#39
      '                 when pl.natureza = '#39'O'#39'        then '#39'09'#39
      '            end as varchar(2)) as cod_nat_cc,'
      ''
      '       cast(pl.tipo as char(1)) as ind_cta,'
      ''
      
        '       length(trim(pl.classificacao)) - length(trim(replace(pl.c' +
        'lassificacao,'#39'.'#39','#39#39')))+1 as nivel,'
      ''
      '       case when pl.tipo = '#39'A'#39' then'
      
        '         cast(pl.classificacao||trim(to_char(pl.codigo,'#39'000000'#39')' +
        ') as varchar(60))'
      '       else'
      '         cast(pl.classificacao as varchar(60))'
      '       end as cod_cta,'
      ''
      '       pl.descricao as nome_cta'
      ''
      'from planocontas pl'
      'where pl.codigo in'
      ''
      '      ('
      ''
      '        select i.ccdobem AS COD_CTA'
      ''
      '        from imobilizado i'
      ''
      '             join apropriacaoicmsimobilizado aii'
      '             on i.numero = aii.numeroimobilizado'
      ''
      '             join produtos p'
      '             on i.codigobem = p.codigo'
      ''
      '        where i.filialcontribuinte = :filial'
      '          and aii.periodo between :datainicial and :datafinal'
      
        '          and aii.dataapropriacao between :datainicial and :data' +
        'final'
      ''
      '      )'
      '')
    RequestLive = False
    Left = 784
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
  end
