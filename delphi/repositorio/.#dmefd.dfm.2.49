  object qryRegistroC321: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 
      'cod_mod=cod_mod;ser=ser;num_doc_ini=num_doc_ini;num_doc_fin=num_' +
      'doc_fin;dt_doc=dt_doc;cst_icms=cst_icms;cfop=cfop;aliq_icms=aliq' +
      '_icms'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrRegistroC320
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.modelodocto     as cod_mod,'
      '       n.serie            as ser,'
      '       min(n.numero)      as num_doc_ini,'
      '       max(n.numero)      as num_doc_fin,'
      '       df.data            as dt_doc,'
      ''
      '       pdf.incidencia     as cst_icms,'
      '       pdf.codigofiscal   as cfop,'
      '       pdf.aliquotaicms   as aliq_icms,'
      ''
      
        '       cast(('#39'P'#39'|| cast(pdf.produto as varchar))  as varchar(60)' +
        ') as cod_item,'
      '       sum(pdf.quantidade)      as qtd,'
      '       c.unidade              as unid,'
      '       sum(pdf.precovenda)      as vl_item,'
      '       sum(pdf.desconto)        as vl_desc,'
      ''
      
        '       sum(case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39 +
        ') and not pdf.naoGerarDebitoICMS then pdf.icmsbasecalculo else 0' +
        ' end) as vl_bc_icms,'
      
        '       sum(case when pdf.incidencia in ('#39'00'#39','#39'10'#39','#39'20'#39','#39'70'#39','#39'90'#39 +
        ') and not pdf.naoGerarDebitoICMS then pdf.icmsvalor else 0 end) ' +
        'as vl_icms,'
      ''
      '       sum(pdf.PISValor)        as vl_pis,'
      '       sum(pdf.COFINSValor)     as vl_cofins'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join produtosdadosfiscais pdf'
      '          join produtos p'
      '               join caracteristicas c'
      '               on p.caracteristica = c.codigo'
      '          on pdf.produto = p.codigo'
      ''
      '     on df.numero = pdf.dadofiscal'
      ''
      'where df.numero = pdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'02'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.filialemissao = :filial'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      
        'group by df.modelodocto, n.serie, df.data, pdf.incidencia, pdf.c' +
        'odigofiscal, pdf.aliquotaicms, pdf.produto, c.unidade'
      
        'order by df.modelodocto, n.serie, df.data, pdf.incidencia, pdf.c' +
        'odigofiscal, pdf.aliquotaicms, pdf.produto, c.unidade'
      '')
    RequestLive = False
    Left = 275
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
