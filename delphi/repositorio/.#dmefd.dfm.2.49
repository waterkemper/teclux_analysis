  object qryRegistroE510: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cfop, cst_ipi,'
      '       sum(vl_cont_ipi) as vl_cont_ipi,'
      '       sum(vl_bc_ipi)   as vl_bc_ipi,'
      '       sum(vl_ipi)      as vl_ipi'
      'from'
      '('
      'select pdf.codigofiscal   as cfop,'
      '       pdf.ipicst as cst_ipi,'
      
        '       (pdf.quantidade * pdf.precovenda)-coalesce(pdf.desconto,0' +
        ')+coalesce(pdf.acrescimo,0) as vl_cont_ipi,'
      '       pdf.ipibasecalculo as vl_bc_ipi,'
      '       pdf.valoripi       as vl_ipi'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join produtosdadosfiscais pdf'
      '     on df.numero = pdf.dadofiscal'
      'where df.numero = pdf.dadofiscal'
      '  and df.data between :datainicial and :datafinal'
      '  and df.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and df.CodigoFiscal < 8000'
      '  and df.situacao = '#39'N'#39
      '  and df.filialemissao = :filial'
      '  and coalesce(pdf.valoripi,0)<>0'
      
        '  and (n.filial,n.serie) in (select sf.filial,sf.valor from seri' +
        'esfiliais sf where sf.ativa)'
      ''
      'union all'
      ''
      'select'
      '       pnp.codigofiscal   as cfop,'
      '       pnp.ipicst  as cst_ipi,'
      
        '       (pnp.quantidade * pnp.precounitario)-coalesce(pnp.descont' +
        'o,0)+coalesce(pnp.acrescimo,0)  as vl_cont_ipi,'
      ''
      
        '       (coalesce((case when not pnp.naogerarcreditoipi then pnp.' +
        'ipibasecalculo else 0 end),0)) as vl_bc_ipi,'
      
        '       (coalesce((case when not pnp.naogerarcreditoipi then pnp.' +
        'valoripi       else 0 end),0)) as vl_ipi'
      ''
      ''
      'from notaspag np'
      '     join produtosnotaspag pnp'
      '     on np.codigo = pnp.codigonota'
      'where np.codigo = pnp.codigonota'
      '  and np.data between :datainicial and :datafinal'
      '  and np.modelodocto in ('#39'01'#39','#39'1B'#39','#39'04'#39','#39'55'#39')'
      '  and np.situacao = '#39'N'#39
      '  and np.filial = :filial'
      '  and coalesce(pnp.valoripi,0)<>0'
      ''
      ') as registro_E520'
      'group by cfop, cst_ipi'
      'order by cfop, cst_ipi')
    RequestLive = False
    Left = 32
    Top = 664
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    object qryRegistroE510cfop: TIntegerField
      FieldName = 'cfop'
      DisplayFormat = '0'
    end
    object qryRegistroE510cst_ipi: TStringField
      FieldName = 'cst_ipi'
      Size = 50
    end
    object qryRegistroE510vl_cont_ipi: TFloatField
      FieldName = 'vl_cont_ipi'
      DisplayFormat = '0.00'
    end
    object qryRegistroE510vl_bc_ipi: TFloatField
      FieldName = 'vl_bc_ipi'
      DisplayFormat = '0.00'
    end
    object qryRegistroE510vl_ipi: TFloatField
      FieldName = 'vl_ipi'
      DisplayFormat = '0.00'
    end
  end
