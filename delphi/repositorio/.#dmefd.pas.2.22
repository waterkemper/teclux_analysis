procedure TdtmEFD.P_RegistroE110;
begin
  //jr 19/12, acaba gerando valores zerados
 { qryEFD_E110.Edit;
  qryEFD_E110vl_tot_debitos.AsCurrency := FRegistroE110_VL_TOT_DEBITOS;
  qryEFD_E110vl_tot_creditos.AsCurrency := FRegistroE110_VL_TOT_CREDITOS;

  qryEFD_E110vl_aj_debitos.AsCurrency := FRegistroE110_VL_AJ_DEBITOS;
  qryEFD_E110vl_aj_creditos.AsCurrency := FRegistroE110_VL_AJ_CREDITOS;

  qryEFD_E110vl_tot_ded.AsCurrency :=  FRegistroE110_VL_TOT_DED;
  qryEFD_E110deb_esp.AsCurrency :=  FRegistroE110_VL_DEB_ESP;


  qryefd_e110.Post;}

  RefazConsultaPorNome(qryEFD_E110,['periodo','filial'],[qryefdperiodo.AsString,qryefdfilial.AsInteger]);

  with ACBrSPEDFiscal.Bloco_E.RegistroE110New do
  begin
    VL_TOT_DEBITOS           := qryEFD_E110vl_tot_debitos.AsCurrency;  // Valor total dos débitos por "Saídas e prestações com débito do imposto"
    VL_AJ_DEBITOS            := qryEFD_E110vl_aj_debitos.AsCurrency;             /// Valor total dos ajustes a débito decorrentes do documento fiscal.
    VL_TOT_AJ_DEBITOS        := qryEFD_E110vl_tot_aj_debitos.AsCurrency; // Valor total de "Ajustes a débito"
    VL_ESTORNOS_CRED         := qryEFD_E110vl_estornos_cred.AsCurrency;          /// Valor total de Ajustes “Estornos de créditos”
    VL_TOT_CREDITOS          := qryEFD_E110vl_tot_creditos.AsCurrency;  // Valor total dos créditos por "Entradas e aquisições com crédito do imposto"
    VL_AJ_CREDITOS           := qryEFD_E110vl_aj_creditos.AsCurrency;            /// Valor total dos ajustes a crédito decorrentes do documento fiscal.
    VL_TOT_AJ_CREDITOS       := qryEFD_E110vl_tot_aj_creditos.AsCurrency; // Valor total de "Ajustes a crédito"
    VL_ESTORNOS_DEB          := qryEFD_E110vl_estornos_deb.AsCurrency;           /// Valor total de Ajustes “Estornos de Débitos”
    VL_SLD_CREDOR_ANT        := qryEFD_E110vl_sld_credor_ant.AsCurrency;         /// Valor total de "Saldo credor do período anterior"

    if qryEFD_E110SALDODEVEDOR.AsCurrency > 0 then
    begin
      VL_SLD_APURADO  := qryEFD_E110SALDODEVEDOR.AsCurrency +   // Lúcio 19dez2012
                         qryEFD_E110vl_tot_ded.AsCurrency ; /// Valor total de "Saldo devedor (02+03+04+05-06-07-08-09-10) antes das deduções"
      VL_SLD_CREDOR_TRANSPORTAR := 0.00; /// Valor total de "Saldo credor a transportar para o período seguinte”
    end
    else
    begin
      VL_SLD_APURADO := 0;
      VL_SLD_CREDOR_TRANSPORTAR := roundto(abs(qryEFD_E110SALDOCREDOR.AsCurrency), -2);
    end;
//  VL_TOT_DED               := 0.00;   /// Valor total de "Deduções"     // Lúcio 19dez2012
      VL_TOT_DED               := qryEFD_E110vl_tot_ded.AsCurrency;         // Lúcio 19dez2012
    VL_ICMS_RECOLHER         := VL_SLD_APURADO - VL_TOT_DED;  /// Valor total de "ICMS a recolher (11-12)
    DEB_ESP                  := 0.00;  /// Valores recolhidos ou a recolher, extra-apuração.

    P_RegistroE111;
    P_RegistroE116;
  end;
end;

procedure TdtmEFD.qryRegistroC310FilterRecord(DataSet: TDataSet;
  var Accept: Boolean);
begin
  inherited;
  accept := (qryRegistroC310num_doc_canc.AsInteger >= qryRegistroC300num_doc_ini.AsInteger) or
            (qryRegistroC310num_doc_canc.AsInteger <= qryRegistroC300num_doc_fin.AsInteger);
end;

procedure TdtmEFD.P_RegistroC300;
begin
  RefazConsultaPorNome(qryRegistroC300,
                       ['datainicial','datafinal','filial'],
                       [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC310,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC320,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

      RefazConsultaPorNome(qryRegistroC321,
                           ['datainicial','datafinal','filial'],
                           [datainicial,datafinal,qryEFDFilial.asinteger]);

  qryRegistroC300.First;
  while not qryRegistroC300.Eof do
  begin

    with ACBrSPEDFiscal.Bloco_C.RegistroC300New do
    begin
      COD_MOD     := qryRegistroC300cod_mod.AsString; /// Código do modelo do documento fiscal, conforme a Tabela 4.1.1
      SER         := qryRegistroC300ser.AsString; /// Série do documento fiscal
//        SUB         := AnsiString; /// Subsérie do documento fiscal
      NUM_DOC_INI := qryRegistroC300num_doc_ini.AsString; /// Número do documento fiscal inicial
      NUM_DOC_FIN := qryRegistroC300num_doc_fin.AsString; /// Número do documento fiscal final
      DT_DOC      := qryRegistroC300dt_doc.AsDateTime; /// Data da emissão dos documentos fiscais
      VL_DOC      := qryRegistroC300vl_doc.AsCurrency; /// Valor total dos documentos
      VL_PIS      := qryRegistroC300vl_pis.AsCurrency; /// Valor total do PIS
      VL_COFINS   := qryRegistroC300vl_cofins.AsCurrency; /// Valor total da COFINS
//        COD_CTA     := AnsiString; /// Código da conta analítica contábil debitada/creditada
      P_RegistroC310;
      P_RegistroC320;
    end;
    qryRegistroC100.Next;
  end;

end;

procedure TdtmEFD.P_RegistroC310;
begin
  qryRegistroC310.First;
  while not qryRegistroC310.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC310New do
      NUM_DOC_CANC := qryRegistroC310num_doc_canc.AsString; /// Número do documento fiscal cancelado
    qryRegistroC310.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC320;
begin
  qryRegistroC320.First;
  while not qryRegistroC320.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC320New do
    begin
      CST_ICMS  := qryRegistroC320cst_icms.AsString;     /// Código da Situação Tributária, conforme a Tabela indicada no item 4.3.1
      CFOP      := qryRegistroC320cfop.AsString;         /// Código Fiscal de Operação e Prestação
      ALIQ_ICMS := qryRegistroC320aliq_icms.AsCurrency;  /// Alíquota do ICMS
      VL_OPR    := qryRegistroC320vl_opr.AsCurrency;     /// Valor total acumulado das operações correspondentes à combinação de CST_ICMS, CFOP e alíquota do ICMS, incluídas as despesas acessórias e acréscimos.
      VL_BC_ICMS:= qryRegistroC320vl_bc_icms.AsCurrency; /// Valor acumulado da base de cálculo do ICMS, referente à combinação de CST_ICMS, CFOP, e alíquota do ICMS.
      VL_ICMS   := qryRegistroC320vl_icms.AsCurrency;    /// Valor acumulado do ICMS, referente à combinação de CST_ICMS, CFOP e alíquota do ICMS.
      VL_RED_BC := qryRegistroC320vl_red_bc.AsCurrency;  /// Valor não tributado em função da redução da base de cálculo do ICMS, referente à combinação de CST_ICMS, CFOP, e alíquota do ICMS.
//        COD_OBS   := AnsiString;
      P_RegistroC321;
    end;
    qryRegistroC320.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC321;
begin
  qryRegistroC321.First;
  while not qryRegistroC321.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC321New do
    begin
        COD_ITEM  := qryRegistroC321cod_item.AsString;     /// Código do item (campo 02 do Registro 0200)
        QTD       := qryRegistroC321qtd.AsFloat;           /// Quantidade acumulada do item
        UNID      := qryRegistroC321unid.AsString;         /// Unidade do item (Campo 02 do registro 0190)
        VL_ITEM   := qryRegistroC321vl_item.AsCurrency;    /// Valor acumulado do item
        VL_DESC   := qryRegistroC321vl_desc.AsCurrency;    /// Valor do desconto acumulado
        VL_BC_ICMS:= qryRegistroC321vl_bc_icms.AsCurrency; /// Valor acumulado da base de cálculo do ICMS
        VL_ICMS   := qryRegistroC321vl_icms.AsCurrency;    /// Valor acumulado do ICMS debitado
        VL_PIS    := qryRegistroC321vl_pis.AsCurrency;     /// Valor acumulado do PIS
        VL_COFINS := qryRegistroC321vl_cofins.AsCurrency;  /// Valor acumulado da COFINS
    end;
    qryRegistroC321.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC350;
begin
  RefazConsultaPorNome(qryRegistroC350,
                       ['datainicial','datafinal','filial'],
                       [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC370,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC390,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

  qryRegistroC350.First;
  while not qryRegistroC350.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_C.RegistroC350New do
    begin
      SER       := qryRegistroC350ser.AsString;           /// Série do documento fiscal
//        SUB_SER   := AnsiString;       /// Subsérie do documento fiscal
      NUM_DOC   := qryRegistroC350num_doc.AsString;       /// Número do documento fiscal
      DT_DOC    := qryRegistroC350dt_doc.AsDateTime;     /// Data da emissão do documento fiscal
      CNPJ_CPF  := SomenteNumero(qryRegistroC350cnpj_cpf.AsString);      /// CNPJ ou CPF do destinatário
      VL_MERC   := qryRegistroC350vl_merc.AsCurrency;     /// Valor das mercadorias constantes no documento fiscal
      VL_DOC    := qryRegistroC350vl_doc.AsCurrency;      /// Valor total do documento fiscal
      VL_DESC   := qryRegistroC350vl_desc.AsCurrency;     /// Valor total do desconto
      VL_PIS    := qryRegistroC350vl_pis.AsCurrency;      /// Valor total do PIS
      VL_COFINS := qryRegistroC350vl_cofins.AsCurrency;   /// Valor total da COFINS
//        COD_CTA   := AnsiString;       /// Código da conta analítica contábil debitada/creditada
      P_RegistroC370;
      P_RegistroC390;
    end;
    qryRegistroC350.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC370;
begin
  qryRegistroC370.First;
  while not qryRegistroC370.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC370New do
    begin
      NUM_ITEM := qryRegistroC370num_item.asString;   /// Número seqüencial do item no documento fiscal
      COD_ITEM := qryRegistroC370cod_item.asString;   /// Código do Item (campo 02 do registro 0200)
      QTD      := qryRegistroC370qtd.AsCurrency;      /// Quantidade do item
      UNID     := qryRegistroC370unid.AsString;       /// Unidade do item (campo 02 do registro 0190)
      VL_ITEM  := qryRegistroC370vl_item.AsCurrency;  /// Valor total do item
      VL_DESC  := qryRegistroC370vl_desc.AsCurrency;  /// Valor total do desconto no item
    end;
    qryRegistroC370.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC390;
begin
  qryRegistroC390.First;
  while not qryRegistroC390.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC390New do
    begin
      CST_ICMS   := qryRegistroC390cst_icms.AsString;         /// Código da Situação Tributária, conforme a Tabela indicada no item 4.3.1
      CFOP       := qryRegistroC390cfop.AsString;             /// Código Fiscal de Operação e Prestação
      ALIQ_ICMS  := qryRegistroC390aliq_icms.AsCurrency;      /// Alíquota do ICMS
      VL_OPR     := qryRegistroC390vl_opr.AsCurrency;         /// Valor total acumulado das operações correspondentes à combinação de CST_ICMS, CFOP e alíquota do ICMS, incluídas as despesas acessórias e acréscimos.
      VL_BC_ICMS := qryRegistroC390vl_bc_icms.AsCurrency;     /// Valor acumulado da base de cálculo do ICMS, referente à combinação de CST_ICMS, CFOP, e alíquota do ICMS.
      VL_ICMS    := qryRegistroC390vl_icms.AsCurrency;        /// Valor acumulado do ICMS, referente à combinação de CST_ICMS, CFOP e alíquota do ICMS.
      VL_RED_BC  := qryRegistroC390vl_red_bc.AsCurrency;      /// Valor não tributado em função da redução da base de cálculo do ICMS, referente à combinação de CST_ICMS, CFOP, e alíquota do ICMS.
//        COD_OBS    := AnsiString;          /// Código da observação do lançamento fiscal (campo 02 do Registro 0460)
    end;
    qryRegistroC390.Next;
  end;
end;


function  TdtmEFD.SituacaoDocto(Situacao: String): TACBrSituacaoDocto;
begin
      if Situacao = '00' then result := sdRegular
 else if Situacao = '01' then result := sdExtempRegular
 else if Situacao = '02' then result := sdCancelado
 else if Situacao = '03' then result := sdCanceladoExtemp
 else if Situacao = '04' then result := sdDoctoDenegado
 else if Situacao = '05' then result := sdDoctoNumInutilizada
 else if Situacao = '06' then result := sdFiscalCompl
 else if Situacao = '07' then result := sdExtempCompl
 else if Situacao = '08' then result := sdRegimeEspecNEsp;

end;

function TdtmEFD.Operacao(tipo: byte): TACBrTipoOperacao;
begin
  case tipo of
  0: result := tpEntradaAquisicao;
  1: result := tpSaidaPrestacao;
  end;
end;

function TdtmEFD.Emitente(tipo: byte): TACBrEmitente;
begin
 case tipo of
 0: result := edEmissaoPropria;
 1: result := edTerceiros;
 end;
end;

function TdtmEFD.TipoPagamento(Tipo: byte): TACBrTipoPagamento;
begin
  case tipo of
  0: result := tpVista;
  1: result := tpPrazo;
  9: result := tpSemPagamento;
  end;
end;

function TdtmEFD.TipoFrete(tipo: byte): TACBrTipoFrete;
begin
  case tipo of
  0: result := tfPorContaTerceiros;
  1: result := tfPorContaEmitente;
  2: result := tfPorContaDestinatario;
  9: result := tfSemCobrancaFrete;
  end;
end;

function TdtmEFD.TipoItem(tipo: String): TACBrTipoItem;
begin
       if tipo = '00' then result := tiMercadoriaRevenda
  else if tipo = '01' then result := tiMateriaPrima
  else if tipo = '02' then result := tiEmbalagem
  else if tipo = '03' then result := tiProdutoProcesso
  else if tipo = '04' then result := tiProdutoAcabado
  else if tipo = '05' then result := tiSubproduto
  else if tipo = '06' then result := tiProdutoIntermediario
  else if tipo = '07' then result := tiMaterialConsumo
  else if tipo = '08' then result := tiAtivoImobilizado
  else if tipo = '09' then result := tiServicos
  else if tipo = '10' then result := tiOutrosInsumos
  else if tipo = '99' then result := tiOutras;
end;


function TdtmEFD.DoctoImporta(tipo: Byte): TACBrDoctoImporta;
begin
  case tipo of
  0: result := diImportacao;
  1: result := diSimplificadaImport;
  end;
end;

function TdtmEFD.MovimentacaoFisica(tipo: byte): TACBrMovimentacaoFisica;
begin
  case tipo of
  1: result := mfSim;
  else result := mfNao;
  end;
end;

function TdtmEFD.ApuracaoIPI(tipo: byte): TACBrApuracaoIPI;
begin
  case tipo of
  0: result := iaMensal;
  1: result := iaDecendial;
  end;

end;


function TdtmEFD.ClasseConsumo(tipo: String): TACBrClasseConsumo;
begin
       if tipo = '01' then result := ccComercial
  else if tipo = '02' then result := ccConsumoProprio
  else if tipo = '03' then result := ccIluminacaoPublica
  else if tipo = '04' then result := ccIndustrial
  else if tipo = '05' then result := ccPoderPublico
  else if tipo = '06' then result := ccResidencial
  else if tipo = '07' then result := ccRural
  else if tipo = '08' then result := ccServicoPublico;
end;

function TdtmEFD.PosseItem(tipo: byte): TACBrPosseItem;
begin
  case tipo of
  0: result := piInformante;
  1: result := piInformanteNoTerceiro;
  2: result := piTerceiroNoInformante;
  end;

end;


procedure TdtmEFD.AtualizaSaldoCredorMesAnterior;
begin
  RefazConsultaPorNome(qryEFD_E110_Anterior,['periodo','filial'],
    [FormatDateTime('mm/yyyy',IncMonth(strtodate('01/'+qryefdperiodo.asstring), -1)), qryefdfilial.asinteger]);
  if Not (qryEFD_E110.State in [dsInsert, dsEdit]) then
    qryEFD_E110.Edit;
  qryEFD_E110vl_sld_credor_ant.AsCurrency := qryEFD_E110_AnteriorSALDOCREDOR.AsCurrency;
end;

procedure TdtmEFD.qryEFD_E110_AnteriorCalcFields(DataSet: TDataSet);
var
  TotalDebitos, TotalCreditos : Currency;
begin
  inherited;
 TotalDebitos := qryEFD_E110_Anteriorvl_tot_debitos.AsCurrency +
                  qryEFD_E110_Anteriorvl_aj_debitos.AsCurrency +
                  qryEFD_E110_Anteriorvl_tot_aj_debitos.AsCurrency +
                  qryEFD_E110_Anteriorvl_estornos_cred.AsCurrency;

  TotalCreditos := qryEFD_E110_Anteriorvl_tot_creditos.AsCurrency +
       qryEFD_E110_Anteriorvl_aj_creditos.AsCurrency +
       qryEFD_E110_Anteriorvl_tot_aj_creditos.AsCurrency +
       qryEFD_E110_Anteriorvl_estornos_deb.AsCurrency +
       qryEFD_E110_Anteriorvl_sld_credor_ant.AsCurrency;

  if (TotalDebitos > TotalCreditos) then
  begin
     qryEFD_E110_AnteriorSALDODEVEDOR.AsCurrency := abs( TotalDebitos  - TotalCreditos);
     qryEFD_E110_AnteriorSALDOCREDOR.AsCurrency := 0;
  end
  else
  begin
    qryEFD_E110_AnteriorSALDODEVEDOR.AsCurrency := 0;
    qryEFD_E110_AnteriorSALDOCREDOR.AsCurrency := abs( TotalDebitos  - TotalCreditos);
  end;

end;


constructor TdtmEFD.Create(AOwner: TComponent);
begin
  inherited;

  qryefd.Tag := ctTabelas;
  {
  qryEFD_E110.Tag := cttabelas;
  qryEFD_E116.Tag := ctTabelas;
  qryEFD_E111.Tag := ctTabelas;

  qryEFD_E520.Tag := cttabelas;
  qryEFD_E530.Tag := cttabelas;
  }


//  SaldoObrigacoesFechado := true;
end;

function TdtmEFD.ExcluirEFD: Boolean;
begin
 qryefd.Delete;
 Perpetrar([qryefd]);
 Result := True
end;

function TdtmEFD.GravarEFD: Boolean;
//var
//  ValorTotalDebito: Currency;

begin
//  result :=  ValidarArquivo;

//  if result then

  if qryEFD_E110.state in [dsedit, dsinsert] then
    qryEFD_E110.Post;

  LigarDesligarEventosEFD_E111(false);
  if qryEFD_E111.state in [dsedit, dsinsert] then
    qryEFD_E111.Post;
  LigarDesligarEventosEFD_E111(true);

  if qryEFD_E116.state in [dsedit, dsinsert] then
    qryEFD_E116.Post;

  if qryEFD_E520.state in [dsedit, dsinsert] then
    qryEFD_E520.Post;

  LigarDesligarEventosEFD_E530(false);
  if qryEFD_E530.state in [dsedit, dsinsert] then
    qryEFD_E530.Post;
  LigarDesligarEventosEFD_E530(true);

  qryefdmotivoinventario.Required := not qryefddatainventario.IsNull;

  result := qryefd.CheckRequiredFields;

  if result then
    result := qryEFD_E110.CheckRequiredFields;

  if result then
    if qryEFD_E110SALDODEVEDOR.AsCurrency > 0 then
    begin
      qryefd_e116.First;
      while not qryefd_e116.Eof do
      begin
        result := qryEFD_E116.CheckRequiredFields;
        if not result then
          break
        else
          qryefd_e116.Next;
      end;
    end;

  if result then
  begin
    LigarDesligarEventosEFD_E111(false);
    qryEFD_E111.First;
    while not qryEFD_E111.Eof do
    begin
      result := qryEFD_E111.CheckRequiredFields;
      if not result then
        break
      else
        qryEFD_E111.Next;
    end;
    LigarDesligarEventosEFD_E111(true);
  end;

  if result then
    result := qryEFD_E520.CheckRequiredFields;

  if result then
  begin
    LigarDesligarEventosEFD_E530(false);
    qryEFD_E530.First;
    while not qryEFD_E530.Eof do
    begin
      result := qryEFD_E530.CheckRequiredFields;
      if not result then
        break
      else
        qryEFD_E530.Next;
    end;
    LigarDesligarEventosEFD_E530(true);
  end;


  if result then
  begin

{
    if not qryefd_e110.IsEmpty then
    begin
      qryefd_e110.Edit;
      qryEFD_E110periodo.AsString := qryefdperiodo.AsString;
      qryEFD_E110filial.AsInteger := qryefdfilial.AsInteger;
      qryefd_e110.Post;
    end;
}


{
    qryefd_e116.First;
    while not qryefd_e116.Eof do
    begin
      qryefd_e116.Edit;
      qryEFD_E116periodo.AsString := qryefdperiodo.AsString;
      qryEFD_E116filial.AsInteger := qryefdfilial.AsInteger;
      qryefd_e116.post;
      qryefd_e116.Next;
    end;
}

{
    if not qryEFD_E520.IsEmpty then
    begin
      qryefd_e520.Edit;
      qryEFD_E520periodo.AsString := qryefdperiodo.AsString;
      qryEFD_E520filial.AsInteger := qryefdfilial.AsInteger;
      qryefd_e520.Post;
    end;
}

    qryefd.Post;
    result := Perpetrar([qryefd, qryefd_e110, qryefd_e111, qryefd_e116, qryefd_e520, qryefd_e530]);
  end;
end;

function TdtmEFD.IncluirEFD: Boolean;
begin
//  qryefd.Params[0].Clear;
  qryefd.append;
  Result := True;
end;

procedure TdtmEFD.qryefdAfterScroll(DataSet: TDataSet);
begin
  inherited;

  RefazConsultaPorNome(qryFiliais,['codigo'],[qryefdfilial.asinteger]);

  {Apuracao ICMS}
  RefazConsultaPorNome(qryEFD_E110,['periodo','filial'],[qryefdperiodo.AsVariant, qryefdfilial.asinteger]);

  LigarDesligarEventosEFD_E111(false);
  RefazConsultaPorNome(qryEFD_E111,['periodo','filial'],[qryefdperiodo.AsVariant, qryefdfilial.asinteger]);
  LigarDesligarEventosEFD_E111(true);

  RefazConsultaPorNome(qryEFD_E116,['periodo','filial'],[qryefdperiodo.AsVariant, qryefdfilial.asinteger]);

  {Apuracao IPI}
  RefazConsultaPorNome(qryEFD_E520,['periodo','filial'],[qryefdperiodo.AsVariant, qryefdfilial.asinteger]);
  RefazConsultaPorNome(qryEFD_E530,['periodo','filial'],[qryefdperiodo.AsVariant, qryefdfilial.asinteger]);


  if qryefdperiodo.asstring<>'' then
  begin
    DataInicial := strtodate('01/'+qryefdperiodo.asstring);
    DataFinal := strtodate(inttostr(DaysInMonth(strtodate('01/'+qryefdperiodo.asstring)))+'/'+qryefdperiodo.asstring);

//    DataInicial :=  strtodate('05/07/2011');
//    DataFinal := strtodate('05/07/2011');
  end;

//  AtualizarSaldosICMS(true);
end;

procedure TdtmEFD.qryefdNewRecord(DataSet: TDataSet);
begin
  inherited;
//  qryefdperiodo.AsString := FormatDateTime('mm/yyyy',date());
  qryefddata.AsDateTime := now();
  qryefdtipo.AsString := 'O';

end;

procedure TdtmEFD.dsrefdDataChange(Sender: TObject; Field: TField);
begin
  inherited;

  if (field = qryefdfilial) then
    RefazConsultaPorNome(qryFiliais,['codigo'],[qryefdfilial.asinteger]);

  if (field = qryefdperiodo) or
     (field = qryefdfilial) then
  begin
    if (qryefd.State = dsinsert) and
       ((qryefdperiodo.AsString <> '') and
        (qryefdfilial.AsInteger <> 0)) then
    begin
      DataInicial := strtodate('01/'+qryefdperiodo.asstring);
      DataFinal := strtodate(inttostr(DaysInMonth(strtodate('01/'+qryefdperiodo.asstring)))+'/'+qryefdperiodo.asstring);

//    DataInicial :=  strtodate('05/07/2011');
//    DataFinal := strtodate('05/07/2011');



//      AtualizarSaldosICMS(true);
      if qryefddatainventario.IsNull then
        qryefddatainventario.AsDateTime := UltimoDiaMes(strtodatetime('01/'+qryefdperiodo.asstring));
//      dsrefd.OnDataChange := nil;
//      dsrefd.OnDataChange := dsrefdDataChange;
    end;
  end;

  if ((field = qryefdtipo) or
      (field = qryefdperiodo)) and
      (qryefdperiodo.AsString <> '') then
    qryefdnomearquivo.AsString := 'EFD_'+
      qryefdfilial.AsString+'_'+
      FormatDateTime('yyyy-mm',strtodate('01/'+qryefdperiodo.AsString)) + '_'+
      qryefdtipo.AsString+'.TXT';
end;

procedure TdtmEFD.qryEFD_E110CalcFields(DataSet: TDataSet);
var
  TotalDebitos, TotalCreditos : Currency;
begin
  inherited;
  TotalDebitos := qryEFD_E110vl_tot_debitos.AsCurrency +
                  qryEFD_E110vl_aj_debitos.AsCurrency +
                  qryEFD_E110vl_tot_aj_debitos.AsCurrency +
                  qryEFD_E110vl_estornos_cred.AsCurrency;

  TotalCreditos := qryEFD_E110vl_tot_creditos.AsCurrency +
       qryEFD_E110vl_aj_creditos.AsCurrency +
       qryEFD_E110vl_tot_aj_creditos.AsCurrency +
       qryEFD_E110vl_estornos_deb.AsCurrency +
       qryEFD_E110vl_sld_credor_ant.AsCurrency +
       qryEFD_E110vl_tot_ded.AsCurrency;

  if (TotalDebitos > TotalCreditos)   then
  begin
     qryEFD_E110SALDODEVEDOR.AsCurrency := roundto(abs( TotalDebitos  - TotalCreditos), -2);
     qryEFD_E110SALDOCREDOR.AsCurrency := 0;
  end
  else
  begin
    qryEFD_E110SALDODEVEDOR.AsCurrency := 0;
    qryEFD_E110SALDOCREDOR.AsCurrency := roundto(abs( TotalDebitos  - TotalCreditos), -2);
  end;

end;

procedure TdtmEFD.qryEFD_E110AfterEdit(DataSet: TDataSet);
begin
  inherited;
  qryefd.Edit;
end;

procedure TdtmEFD.qryEFD_E116AfterEdit(DataSet: TDataSet);
begin
  inherited;
  qryefd.Edit;
end;

procedure TdtmEFD.P_RegistroE116;
begin
  qryefd_e116.First;
  while not qryefd_e116.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_E.RegistroE116New do
    begin
      COD_OR    := qryEFD_E116icmsobrigacao.AsString; // Código da obrigação a recolher, conforme a Tabela 5.4
      VL_OR     := qryEFD_E116vl_or.AsCurrency;       // Valor da obrigação a recolher
      DT_VCTO   := qryEFD_E116dt_vcto.AsDateTime;     // Data de vencimento da obrigação
      COD_REC   := qryEFD_E116cod_rec.AsString;       // Código de receita referente à obrigação, próprio da unidade da federação, conforme legislação estadual,
      NUM_PROC  := qryEFD_E116num_proc.AsString;      // Número do processo ou auto de infração ao qual a obrigação está vinculada, se houver.
      if qryEFD_E116num_proc.AsString<>'' then
      begin
        IND_PROC  := OrigemProcesso(qryEFD_E116ind_proc.asinteger); // Indicador da origem do processo: 0- Sefaz; 1- Justiça Federal; 2- Justiça Estadual; 9- Outros
        PROC      := qryEFD_E116descr_proc.AsString;                // Descrição resumida do processo que embasou o lançamento
      end
      else
        ind_PROC := opNenhum;
      MES_REF := trocar(qryefdperiodo.AsString,'/','');
      TXT_COMPL := qryEFD_E116txt_comp.AsString;                  // Descrição complementar das obrigações a recolher.
    end;
    qryefd_e116.Next;
  end;
end;

function TdtmEFD.OrigemProcesso(tipo: integer): TACBrOrigemProcesso;
begin
  case tipo of
  0: result := opSefaz;            // 0 - Sefaz
  1: result := opJusticaFederal;   // 1 - Justiça Federal
  2: result := opJusticaEstadual;  // 2 - Justiça Estadual
  3: result := opSecexRFB;         // 3 - Secex/RFB
  9: result := opOutros;           // 9 - Outros
  end;
end;

procedure TdtmEFD.ExcluirEFD_E116;
begin
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['a ICMS obrigação'])) = smbOk then begin
    if not qryefd.IsEmpty then begin
      qryefd.Edit;
      qryEFD_E116.Delete;
    end;
  end;
end;

procedure TdtmEFD.AtualizarSaldosICMS;
begin
  if (qryefdperiodo.AsString <> '') and
     (qryefdfilial.AsInteger <> 0) then
  begin

    AtualizaSaldoCredorMesAnterior;

    CalcularDebitosCreditos(qryEfdfilial.AsInteger);



    qryefd_e110.Edit;
    qryEFD_E110vl_tot_aj_debitos.AsCurrency := 0;
    qryEFD_E110vl_tot_aj_creditos.AsCurrency := 0;
    qryefd_e110.Post;

    LigarDesligarEventosEFD_E111(False);

    qryEFD_E111.First;
    while not qryEFD_E111.Eof do
    begin
      if qryEFD_E111geradasistema.AsBoolean then
         qryEFD_E111.delete
      else
        qryEFD_E111.next;
    end;

    RefazConsultaPorNome(qryRegistroG110,
                       ['datainicial','datafinal','filial'],
                       [datainicial,datafinal,qryEFDFilial.asinteger]);
    if (qryRegistroG110.RecordCount > 0) and
       ((qryRegistroG110icms_aprop.AsCurrency + qryRegistroG110som_icms_oc.AsCurrency)>0) then
    begin
      qryEFD_E111.Append;
      qryEFD_E111cod_aj_apur.AsString := ctCREDITOCIAP;
      qryEFD_E111vl_aj_apur.AsCurrency := qryRegistroG110icms_aprop.AsCurrency + qryRegistroG110som_icms_oc.AsCurrency;
      qryEFD_E111geradasistema.AsBoolean := true;
      RefazConsultaPorNome(qryAjusteICMS,['codigo'],[qryEFD_E111cod_aj_apur.AsVariant]);
      qryEFD_E111descr_comp_aj.AsString := qryAjusteICMSdescricao.AsString;
      qryEFD_E111.Post
    end;

    if qryFiliaisfilialconsolidadoradime.AsInteger<>0 then
      TransferirDebitosCreditos(false)
    else
    begin
      ReFazConsulta(qryFiliaisConsolidacao,[],[]);
      qryFiliaisConsolidacao.First;
      if qryefdfilial.AsInteger = qryFiliaisConsolidacaofilialconsolidadoradime.AsInteger then
      begin
        while not qryFiliaisConsolidacao.Eof do
        begin
          CalcularDebitosCreditos(qryFiliaisConsolidacaofilial.AsInteger);
          TransferirDebitosCreditos(true);
          qryFiliaisConsolidacao.Next;
        end;
      end;
    end;

    LigarDesligarEventosEFD_E111(true);

    qryEFD_E111AfterScroll(qryefd_e111);
    TotalizaAjusteICMS(false, false);
    qryEFD_E110CalcFields(qryEFD_E110);

  end;
end;

procedure TdtmEFD.qryEFD_E116AfterPost(DataSet: TDataSet);
begin
  inherited;
  TotalizarObrigacoes;
end;

procedure TdtmEFD.qryEFD_E116AfterDelete(DataSet: TDataSet);
begin
  inherited;
  TotalizarObrigacoes;
end;

procedure TdtmEFD.TotalizarObrigacoes;
begin
  TotalObrigacoes := 0;
  GuardarRegistroAtual(qryEFD_E116,true);
  qryEFD_E116.First;
  while not qryEFD_E116.Eof do
  begin
    TotalObrigacoes := TotalObrigacoes + qryEFD_E116vl_or.AsCurrency;
    qryEFD_E116.Next;
  end;
  VoltarRegistroAtual(qryEFD_E116);

end;

procedure TdtmEFD.qryEFD_E116CalcFields(DataSet: TDataSet);
begin
  inherited;
  qryEFD_E116TotalObrigacoes.AsCurrency := TotalObrigacoes;
end;

procedure TdtmEFD.qryEFD_E116AfterOpen(DataSet: TDataSet);
begin
  inherited;
  TotalizarObrigacoes;
end;

procedure TdtmEFD.qryEFD_E116NewRecord(DataSet: TDataSet);
begin
  inherited;
  qryEFD_E116periodo.AsString := qryefdperiodo.AsString;
  qryEFD_E116filial.AsInteger := qryefdfilial.AsInteger;
  qryEFD_E116TotalObrigacoes.AsCurrency := TotalObrigacoes;

end;

procedure TdtmEFD.qryEFD_E110NewRecord(DataSet: TDataSet);
begin
  inherited;
  qryEFD_E110periodo.AsString := qryefdperiodo.AsString;
  qryEFD_E110filial.AsInteger := qryefdfilial.AsInteger;
end;

procedure TdtmEFD.P_RegistroD190;
begin
  qryRegistroD190.First;
  while not qryRegistroD190.Eof do
  begin
    with ACBrSPEDFiscal.bloco_D.RegistroD190New do
    begin
      CST_ICMS     := preencheString(trim(qryRegistroD190.fieldbyname('CST_ICMS').asstring),'0',3,false);
      CFOP         := qryRegistroD190.fieldbyname('CFOP').AsString;
      ALIQ_ICMS    := qryRegistroD190.fieldbyname('ALIQ_ICMS').AsCurrency;
      VL_OPR       := qryRegistroD190.fieldbyname('VL_OPR').AsCurrency;
      VL_BC_ICMS   := qryRegistroD190.fieldbyname('VL_BC_ICMS').AsCurrency;
      VL_ICMS      := qryRegistroD190.fieldbyname('VL_ICMS').AsCurrency;
//      VL_RED_BC    := qryRegistroC590.fieldbyname('VL_RED_BC').AsCurrency;
//      COD_OBS      := AnsiString read fCOD_OBS write fCOD_OBS;
      {Só temos entrada neste caso}
      if qryRegistroD100.fieldbyname('IND_OPER').AsString = ctOPERENTRADA then
        FRegistroE110_VL_TOT_CREDITOS := FRegistroE110_VL_TOT_CREDITOS + VL_ICMS;
    end;
    qryRegistroD190.Next;
  end;
end;

procedure TdtmEFD.CalcularDebitosCreditos(Filial: integer);
begin
  FRegistroE110_VL_TOT_DEBITOS := 0;
  FRegistroE110_VL_TOT_CREDITOS := 0;

  FRegistroE110_VL_AJ_DEBITOS := 0;
  FRegistroE110_VL_AJ_CREDITOS := 0;

  RefazConsultaPorNome(qryRegistroC100,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,filial]);

    RefazConsultaPorNome(qryRegistroC190,
                             ['datainicial','datafinal','filial'],
                             [datainicial,datafinal,filial]);

    RefazConsultaPorNome(qryRegistroC195,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,filial]);

      RefazConsultaPorNome(qryRegistroC197,
                           ['datainicial','datafinal','filial'],
                           [datainicial,datafinal,filial]);


  qryregistroc100.First;
  while not qryregistroc100.Eof do
  begin
    qryregistroc190.First;
    while not qryRegistroC190.Eof do
    begin
      {Se for saida}
      if (qryRegistroC100.fieldbyname('COD_SIT').AsString = '00') or  // normal
         (qryRegistroC100.fieldbyname('COD_SIT').AsString = '01') or  // normal extemporanea
         (qryRegistroC100.fieldbyname('COD_SIT').AsString = '06') then // complementar
      begin

        if qryRegistroC100.fieldbyname('IND_OPER').AsString = ctOPERSAIDA then
          {Se não for nota saida transf icms}
          if qryRegistroC190.fieldbyname('CFOP').asString <> ctTRANSFICMS then
            FRegistroE110_VL_TOT_DEBITOS := FRegistroE110_VL_TOT_DEBITOS + qryRegistroC190.fieldbyname('VL_ICMS').ascurrency;

         {Se for entrada}
          if qryRegistroC100.fieldbyname('IND_OPER').AsString = ctOPERENTRADA then
            FRegistroE110_VL_TOT_CREDITOS := FRegistroE110_VL_TOT_CREDITOS + qryRegistroC190.fieldbyname('VL_ICMS').ascurrency;
      end;
      qryRegistroC190.Next;
    end;

    qryRegistroC195.First;
    while not qryregistroc195.Eof do
    begin
      qryRegistroC197.First;
      while not qryRegistroC197.Eof do
      begin
        CalcularAjustes_C197;
        qryRegistroC197.next;
      end;
      qryRegistroC195.next;
    end;

    qryregistroc100.Next;
  end;

  RefazConsultaPorNome(qryRegistroC500,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,filial]);


    RefazConsultaPorNome(qryRegistroC590,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,filial]);

  qryregistroc500.First;
  while not qryregistroc500.Eof do
  begin
    qryRegistroC590.First;
    while not qryRegistroC590.Eof do
    begin
      {Só temos entrada neste caso}
      if qryRegistroC500.fieldbyname('IND_OPER').AsString = ctOPERENTRADA then
         FRegistroE110_VL_TOT_CREDITOS := FRegistroE110_VL_TOT_CREDITOS + qryRegistroC590.fieldbyname('VL_ICMS').AsCurrency;
      qryRegistroC590.Next;
    end;
    qryRegistroC500.Next;
  end;

  RefazConsultaPorNome(qryRegistroC400,['datainicial','datafinal','filial'],
                                [datainicial,datafinal,filial]);

     RefazConsultaPorNome(qryRegistroC405,
                           ['datainicial','datafinal','filial'],
                           [datainicial,datafinal,filial]);

        RefazConsultaPorNome(qryRegistroC490,
                             ['datainicial','datafinal','filial'],
                             [datainicial,datafinal,filial]);

  qryRegistroC400.First;
  while not qryregistroc400.Eof do
  begin
    qryregistroc405.First;
    while not qryregistroc405.Eof do
    begin
      qryRegistroC490.First;
      while not qryRegistroC490.Eof do
      begin
        FRegistroE110_VL_TOT_DEBITOS := fRegistroE110_VL_TOT_DEBITOS + qryRegistroC490vl_icms.AsCurrency;
        qryRegistroC490.Next;
      end;
      qryregistroc405.Next;
    end;
    qryregistroc400.Next;
  end;


  RefazConsultaPorNome(qryRegistroD100,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,filial]);


    RefazConsultaPorNome(qryRegistroD190,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,filial]);

  qryregistroD100.First;
  while not qryregistroD100.Eof do
  begin
    qryRegistroD190.First;
    while not qryRegistroD190.Eof do
    begin
        {Só temos entrada neste caso}
        if qryRegistroD100.fieldbyname('IND_OPER').AsString = ctOPERENTRADA then
          FRegistroE110_VL_TOT_CREDITOS := FRegistroE110_VL_TOT_CREDITOS + qryRegistroD190.fieldbyname('VL_ICMS').AsCurrency;
      qryRegistroD190.Next;
    end;
    qryRegistroD100.Next;
  end;

  if filial = qryefdfilial.AsInteger then
  begin
    qryEFD_E110.Edit;

    qryEFD_E110vl_tot_debitos.AsCurrency := FRegistroE110_VL_TOT_DEBITOS;
    qryEFD_E110vl_tot_creditos.AsCurrency := FRegistroE110_VL_TOT_CREDITOS;

    qryEFD_E110vl_aj_debitos.AsCurrency := FRegistroE110_VL_AJ_DEBITOS;
    qryEFD_E110vl_aj_creditos.AsCurrency := FRegistroE110_VL_AJ_CREDITOS;
    qryEFD_E110vl_tot_ded.AsCurrency :=  FRegistroE110_VL_TOT_DED;
    qryEFD_E110deb_esp.AsCurrency :=  FRegistroE110_VL_DEB_ESP;

    qryefd_e110.Post;
  end;

end;

procedure TdtmEFD.TransferirDebitosCreditos(HeConsolidadora: Boolean);
begin

  qryEFD_E111.Append;
  qryEFD_E111periodo.AsString := qryefdperiodo.AsString;
  qryEFD_E111filial.AsInteger := qryefdfilial.AsInteger;


  if (FRegistroE110_VL_TOT_DEBITOS +
      FRegistroE110_VL_AJ_DEBITOS) > (FRegistroE110_VL_TOT_CREDITOS +
                                      FRegistroE110_VL_AJ_CREDITOS) then
  begin
    if HeConsolidadora then
      qryEFD_E111cod_aj_apur.AsString := ctDEBITOMATRIZ
    else
      qryEFD_E111cod_aj_apur.AsString := ctFILIALCOMDEBITO;

    qryEFD_E111vl_aj_apur.AsCurrency :=  (FRegistroE110_VL_TOT_DEBITOS +
                                          FRegistroE110_VL_AJ_DEBITOS) - (FRegistroE110_VL_TOT_CREDITOS +
                                                                          FRegistroE110_VL_AJ_CREDITOS);
  end
  else
  begin
    if (FRegistroE110_VL_TOT_DEBITOS +
      FRegistroE110_VL_AJ_DEBITOS) < (FRegistroE110_VL_TOT_CREDITOS +
                                      FRegistroE110_VL_AJ_CREDITOS) then
    begin
      if HeConsolidadora then
        qryEFD_E111cod_aj_apur.AsString := ctCREDITOMATRIZ
      else
        qryEFD_E111cod_aj_apur.AsString := ctFILIALCOMCREDITO;

      qryEFD_E111vl_aj_apur.AsCurrency :=  (FRegistroE110_VL_TOT_CREDITOS +
                                            FRegistroE110_VL_AJ_CREDITOS) - (FRegistroE110_VL_TOT_DEBITOS +
                                                                            FRegistroE110_VL_AJ_DEBITOS);
    end;
  end;

  if qryEFD_E111cod_aj_apur.AsString <> '' then
  begin
    if HeConsolidadora then
      qryEFD_E111filialorigemdestino.AsInteger := qryFiliaisConsolidacaofilial.AsInteger
    else
      qryEFD_E111filialorigemdestino.AsInteger := qryFiliaisfilialconsolidadoradime.AsInteger;

    qryEFD_E111geradasistema.AsBoolean := true;

    RefazConsultaPorNome(qryAjusteICMS,['codigo'],[qryEFD_E111cod_aj_apur.AsVariant]);
    qryEFD_E111descr_comp_aj.AsString := qryAjusteICMSdescricao.AsString;
    qryEFD_E111.Post;

  end
  else
    qryEFD_E111.Cancel;

  qryEFD_E111AfterScroll(qryefd_e111);
  TotalizaAjusteICMS(true, true);
  qryEFD_E110CalcFields(qryEFD_E110);

end;

procedure TdtmEFD.qryEFD_E111AfterEdit(DataSet: TDataSet);
begin
  inherited;
  qryefd.Edit;
end;

procedure TdtmEFD.qryEFD_E111NewRecord(DataSet: TDataSet);
begin
  inherited;
  qryEFD_E111periodo.AsString := qryefdperiodo.AsString;
  qryEFD_E111filial.AsInteger := qryefdfilial.AsInteger;
  qryEFD_E111geradasistema.AsBoolean := false;
end;

procedure TdtmEFD.ExcluirEFD_E111;
begin
  if not qryEFD_E111geradasistema.AsBoolean then
    if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o ajuste do ICMS'])) = smbOk then begin
      if not qryefd.IsEmpty then begin
        qryefd.Edit;
        qryEFD_E111.Delete;
      end;
    end;
end;

procedure TdtmEFD.qryEFD_E111AfterDelete(DataSet: TDataSet);
begin
  inherited;
  TotalizaAjusteICMS(false, false);
end;

procedure TdtmEFD.TotalizaAjusteICMS(GravarEFD: Boolean; gerandodebitocredito: boolean = true);
var
  vvl_tot_aj_debitos,
  vvl_tot_aj_creditos,
  vvl_aj_debitos,
  vvl_aj_creditos,
  vvl_estornos_cred,
  vvl_estornos_deb,
  vvl_tot_ded,
  vvl_deb_esp : Currency;

begin
  vvl_tot_aj_debitos  := 0;
  vvl_tot_aj_creditos := 0;
  vvl_estornos_cred   := 0;
  vvl_estornos_deb    := 0;
  vvl_tot_ded         := 0;
  vvl_deb_esp         := 0;

//  vvl_aj_debitos      := 0;
//  vvl_aj_creditos     := 0;


  if not gerandodebitocredito then
    LigarDesligarEventosEFD_E111(false);

  GuardarRegistroAtual(qryEFD_E111,true);
  qryEFD_E111.First;
  while not qryefd_e111.Eof do
  begin
    if (copy(qryEFD_E111cod_aj_apur.AsString,3,1)='0') and
       (copy(qryEFD_E111cod_aj_apur.AsString,4,1)='0') then
       vvl_tot_aj_debitos  := vvl_tot_aj_debitos + qryEFD_E111vl_aj_apur.AsCurrency
    else
    if (copy(qryEFD_E111cod_aj_apur.AsString,3,1)='0') and
       (copy(qryEFD_E111cod_aj_apur.AsString,4,1)='1') then
       vvl_estornos_cred  := vvl_estornos_cred + qryEFD_E111vl_aj_apur.AsCurrency
    else
    if (copy(qryEFD_E111cod_aj_apur.AsString,3,1)='0') and
       (copy(qryEFD_E111cod_aj_apur.AsString,4,1)='2') then
       vvl_tot_aj_creditos := vvl_tot_aj_creditos + qryEFD_E111vl_aj_apur.AsCurrency
    else
    if (copy(qryEFD_E111cod_aj_apur.AsString,3,1)='0') and
       (copy(qryEFD_E111cod_aj_apur.AsString,4,1)='3') then
       vvl_estornos_deb := vvl_estornos_deb + qryEFD_E111vl_aj_apur.AsCurrency
    else
    if (copy(qryEFD_E111cod_aj_apur.AsString,3,1)='0') and
       (copy(qryEFD_E111cod_aj_apur.AsString,4,1)='4') then
       vvl_tot_ded := vvl_tot_ded + qryEFD_E111vl_aj_apur.AsCurrency
    else
    if (copy(qryEFD_E111cod_aj_apur.AsString,3,1)='0') and
       (copy(qryEFD_E111cod_aj_apur.AsString,4,1)='5') then
       vvl_deb_esp := vvl_deb_esp + qryEFD_E111vl_aj_apur.AsCurrency;

    qryEFD_E111.Next;
  end;
  VoltarRegistroAtual(qryEFD_E111);

  if not gerandodebitocredito then
    LigarDesligarEventosEFD_E111(true);


    (*

  GuardarRegistroAtual(qryRegistroC100, false);

  qryRegistroC100.First;
  while not qryRegistroC100.Eof do
  begin
    qryRegistroC195.First;
    while not qryregistroc195.Eof do
    begin
      qryRegistroC197.First;
      while not qryRegistroC197.Eof do
      begin

{Campo 03 VL_AJ_DEBITOS - Validação: o valor informado deve corresponder ao somatório do campo VL_ICMS do registro C197, se o
terceiro caractere do campo COD_AJ do registro C197 for igual a ‘3’, ‘4’ ou ‘5’ e o quarto caractere for igual a “0”, “3”,
“4” ou “5”. Deste somatório, estão excluídos os documentos extemporâneos (COD_SIT com valor igual ‘01’) e os
documentos complementares extemporâneas (COD_SIT com valor igual ‘07’), cujos valores devem ser prestados no
campo DEB_ESP juntamente com os demais valores extra-apuração.
Serão considerados os registros cujos documentos estejam compreendidos no período informado no registro E100,
utilizando para tanto o campo DT_E_S (C100). Quando o campo DT_E_S (C100) for vazio, utilizar o campo DT_DOC.}

        if (strtoint(copy(qryRegistroC197cod_aj.AsString,3,1)) in [3,4,5]) and
           (strtoint(copy(qryRegistroC197cod_aj.AsString,4,1)) in [0,3,4,5]) then
           vvl_aj_debitos  := vvl_aj_debitos + qryRegistroC197vl_calculado.AsCurrency
        else
        {
        if (copy(qryRegistroC197cod_aj.AsString,3,1)='0') and
           (copy(qryRegistroC197cod_aj.AsString,4,1)='1') then
           vvl_estornos_cred  := vvl_estornos_cred + qryRegistroC197vl_icms.AsCurrency
        else
        }

{Campo 07 VL_AJ_CREDITOS - Validação: o valor informado deve corresponder ao somatório do campo VL_ICMS do registro C197, se o
terceiro caractere do código de ajuste do registro C197 for ‘0’, ‘1’ ou ‘2’ e o quarto caractere for ‘0’, “3”, “4” ou “5”.
Devem ser considerados os documentos fiscais compreendidos no período informado no registro E100, analisando-se as
datas informadas no campo DT_E_S do registro C100, exceto se COD_SIT do registro C100 for igual a ‘01’
(extemporâneo) ou igual a ‘07’ (NF Complementar extemporânea), cujo valor deve ser somado no primeiro período de
apuração informado no registro E100.}

        if (strtoint(copy(qryRegistroC197cod_aj.AsString,3,1)) in [0,1,2]) and
           (strtoint(copy(qryRegistroC197cod_aj.AsString,4,1)) in [0,3,4,5]) then
           vvl_aj_creditos := vvl_aj_creditos + qryRegistroC197vl_calculado.AsCurrency
        else
        {
        if (copy(qryRegistroC197cod_aj.AsString,3,1)='0') and
           (copy(qryRegistroC197cod_aj.AsString,4,1)='3') then
           vvl_estornos_deb := vvl_estornos_deb + qryRegistroC197vl_icms.AsCurrency
        else
        }
{
Campo 12 VL_TOT_DED - Validação: o valor informado deve corresponder ao somatório do campo VL_ICMS do registro C197, se o
terceiro caractere do código de ajuste do registro C197, for ‘6’ e o quarto caractere for ‘0’, somado ao valor total
informado nos registros E111, quando o terceiro caractere for igual a ‘0’ e o quarto caractere for igual a ‘4’, do campo
COD_AJ_APUR do registro E111.
Para o somatório do campo VL_ICMS do registro C197 devem ser considerados os documentos fiscais compreendidos no
período informado no registro E100, comparando com a data informada no campo DT_E_S do registro C100, exceto se
COD_SIT do registro C100 for igual a ‘01’ (extemporâneo) ou igual a ‘07’ (NF Complementar extemporânea), cujo valor
deve ser somado no primeiro período de apuração informado no registro E100, quando houver mais de um período de
apuração. Quando o campo DT_E_S não for informado, utilizar o campo DT_DOC.
Neste campo são informados os valores que, segundo a legislação da UF, devam ser tratados como “Dedução do imposto”,
ainda que no campo VL_SLD_APURADO tenha como resultado o valor zero.}

        if (copy(qryRegistroC197cod_aj.AsString,3,1)='6') and
           (copy(qryRegistroC197cod_aj.AsString,4,1)='0') then
           vvl_tot_ded := vvl_tot_ded + qryRegistroC197vl_calculado.AsCurrency
        else

{
Campo 15 – Preenchimento: Informar o correspondente ao somatório dos valores:
a) de ICMS correspondentes aos documentos fiscais extemporâneos (COD_SIT igual a “01”) e das notas fiscais
complementares extemporâneas (COD_SIT igual a “07”); Pode ser verificado no resumo do relatório dos registros
fiscais de documentos de saídas (totalização por COD_SIT e CFOP ou o de entradas, constante das últimas
páginas).
b) de ajustes do campo VL_ICMS do registro C197, se o terceiro caractere do código informado no campo COD_AJ
do registro C197 for igual a “7” (débitos especiais) e o quarto caractere for igual a “0” ou “2” (operações próprias
ou outras apurações) referente aos documentos compreendidos no período a que se refere a escrituração *( Pode
ser verificado no resumo do relatório dos registros fiscais de documentos de saídas (totalização dos ajustes
constante das últimas páginas); e
c) de ajustes do campo VL_AJ_APUR do registro E111, se o terceiro caractere do código informado no campo
COD_AJ_APUR do registro E111 for igual a “0” (apuração ICMS próprio) e o quarto caractere for igual a
“5”(débito especial). *(Valor informado nos registros E111 com os códigos específicos para débitos especiais).
Validação: O valor da soma deste campo com o campo VL_ICMS_RECOLHER deve ser igual à soma dos valores do
campo VL_OR do registro E116.
REGISTRO
}
        if (copy(qryRegistroC197cod_aj.AsString,3,1)='7') and
           (strtoint(copy(qryRegistroC197cod_aj.AsString,4,1)) in [0,2]) then
           vvl_deb_esp := vvl_deb_esp + qryRegistroC197vl_calculado.AsCurrency;

        qryRegistroC197.next;
      end;
      qryRegistroC195.next;
    end;
    qryRegistroC100.next;
  end;

  VoltarRegistroAtual(qryRegistroC100);

  *)

  FRegistroE110_VL_TOT_DED := vvl_tot_ded; //FRegistroE110_VL_TOT_DED + vvl_tot_ded;    // Lúcio 19dez2012
  FRegistroE110_VL_DEB_ESP := vvl_deb_esp; //FRegistroE110_VL_DEB_ESP + vvl_deb_esp;

  qryefd_e110.Edit;
  qryEFD_E110vl_tot_aj_debitos.AsCurrency := vvl_tot_aj_debitos;
  qryEFD_E110vl_tot_aj_creditos.AsCurrency := vvl_tot_aj_creditos;

//  qryEFD_E110vl_aj_debitos.AsCurrency := vvl_aj_debitos;
//  qryEFD_E110vl_aj_creditos.AsCurrency := vvl_aj_creditos;

  qryEFD_E110vl_estornos_cred.AsCurrency := vvl_estornos_cred;
  qryEFD_E110vl_estornos_deb.AsCurrency := vvl_estornos_deb;
  qryEFD_E110vl_tot_ded.AsCurrency := FRegistroE110_VL_TOT_DED;
  qryEFD_E110deb_esp.AsCurrency := FRegistroE110_VL_DEB_ESP;

//  if GravarEFD then     // Lúcio 19dez2012
    qryefd_e110.Post;

end;

