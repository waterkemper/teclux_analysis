procedure TdtmEFD.qryEFD_E520CalcFields(DataSet: TDataSet);
var
  TotalDebitos, TotalCreditos : Currency;
begin
  inherited;
  TotalDebitos := qryEFD_E520vl_tot_debitos.AsCurrency +
                  qryEFD_E520vl_tot_aj_debitos.AsCurrency ;

  TotalCreditos := qryEFD_E520vl_tot_creditos.AsCurrency +
       qryEFD_E520vl_tot_aj_creditos.AsCurrency +
       qryEFD_E520vl_sld_credor_ant.AsCurrency;

  if (TotalDebitos > TotalCreditos)   then
  begin
     qryEFD_E520SALDODEVEDOR.AsCurrency := abs( TotalDebitos  - TotalCreditos);
     qryEFD_E520SALDOCREDOR.AsCurrency := 0;
  end
  else
  begin
    qryEFD_E520SALDODEVEDOR.AsCurrency := 0;
    qryEFD_E520SALDOCREDOR.AsCurrency := abs( TotalDebitos  - TotalCreditos);
  end;

end;

procedure TdtmEFD.AtualizarSaldosIPI;
begin
  if (qryefdperiodo.AsString <> '') and
     (qryefdfilial.AsInteger <> 0) then
  begin
    AtualizaSaldoCredorIPIMesAnterior;
    CalcularDebitosCreditosIPI;
    TotalizaAjusteIPI(false, false);
    qryEFD_E520CalcFields(qryEFD_E520);

  end;

end;

procedure TdtmEFD.AtualizaSaldoCredorIPIMesAnterior;
begin
  RefazConsultaPorNome(qryEFD_E520_Anterior,['periodo','filial'],
    [FormatDateTime('mm/yyyy',IncMonth(strtodate('01/'+qryefdperiodo.asstring), -1)), qryefdfilial.asinteger]);
  if Not (qryEFD_E520.State in [dsInsert, dsEdit]) then
    qryEFD_E520.Edit;
  qryEFD_E520vl_sld_credor_ant.AsCurrency := qryEFD_E520_AnteriorSALDOCREDOR.AsCurrency;
end;

procedure TdtmEFD.qryEFD_E520_AnteriorCalcFields(DataSet: TDataSet);
var
  TotalDebitos, TotalCreditos : Currency;
begin
  inherited;
  TotalDebitos := qryEFD_E520_Anteriorvl_tot_debitos.AsCurrency +
                  qryEFD_E520_Anteriorvl_tot_aj_debitos.AsCurrency ;

  TotalCreditos := qryEFD_E520_Anteriorvl_tot_creditos.AsCurrency +
       qryEFD_E520_Anteriorvl_tot_aj_creditos.AsCurrency +
       qryEFD_E520_Anteriorvl_sld_credor_ant.AsCurrency;

  if (TotalDebitos > TotalCreditos)   then
  begin
     qryEFD_E520_AnteriorSALDODEVEDOR.AsCurrency := abs( TotalDebitos  - TotalCreditos);
     qryEFD_E520_AnteriorSALDOCREDOR.AsCurrency := 0;
  end
  else
  begin
    qryEFD_E520_AnteriorSALDODEVEDOR.AsCurrency := 0;
    qryEFD_E520_AnteriorSALDOCREDOR.AsCurrency := abs( TotalDebitos  - TotalCreditos);
  end;

end;

procedure TdtmEFD.CalcularDebitosCreditosIPI;
begin
  FRegistroE520_VL_TOT_DEBITOS := 0;
  FRegistroE520_VL_TOT_CREDITOS := 0;

  RefazConsultaPorNome(qryRegistroE510,
                         ['datainicial','datafinal','filial'],
                         [datainicial, datafinal, qryefdfilial.AsVariant]);

  qryRegistroE510.First;
  while not qryRegistroE510.Eof do
  begin
    if ((qryRegistroE510cfop.AsInteger div 1000) = 1) or
       ((qryRegistroE510cfop.AsInteger div 1000) = 2) or
       ((qryRegistroE510cfop.AsInteger div 1000) = 3) then
      FRegistroE520_VL_TOT_CREDITOS := FRegistroE520_VL_TOT_CREDITOS + qryRegistroe510.fieldbyname('VL_IPI').ascurrency
    else
    if ((qryRegistroE510cfop.AsInteger div 1000) = 5) or
       ((qryRegistroE510cfop.AsInteger div 1000) = 6) then
       FRegistroE520_VL_TOT_DEBITOS := FRegistroE520_VL_TOT_DEBITOS + qryRegistroe510.fieldbyname('VL_IPI').ascurrency;
    qryRegistroE510.Next;
  end;

  qryEFD_E520.Edit;
  qryEFD_E520vl_tot_debitos.AsCurrency := FRegistroE520_VL_TOT_DEBITOS;
  qryEFD_E520vl_tot_creditos.AsCurrency := FRegistroE520_VL_TOT_CREDITOS;
  qryefd_e520.Post;

end;

procedure TdtmEFD.LigarDesligarEventosEFD_E530(ligar: Boolean);
begin
  if ligar then
  begin
    qryEFD_E530.AfterDelete := qryEFD_E530AfterDelete;
    qryEFD_E530.AfterEdit   := qryEFD_E530AfterEdit;
    qryEFD_E530.AfterPost   := qryEFD_E530AfterPost;
  end
  else
  begin
    qryEFD_E530.AfterDelete := nil;
    qryEFD_E530.AfterEdit   := nil;
    qryEFD_E530.AfterPost   := nil;
  end;

end;

procedure TdtmEFD.qryEFD_E530AfterDelete(DataSet: TDataSet);
begin
  inherited;
  TotalizaAjusteIPI(false, false);
end;

procedure TdtmEFD.TotalizaAjusteIPI(GravarEFD,
  gerandodebitocredito: boolean);
var
  vvl_tot_aj_debitos,
  vvl_tot_aj_creditos: Currency;

begin
  vvl_tot_aj_debitos  := 0;
  vvl_tot_aj_creditos := 0;

  if not gerandodebitocredito then
    LigarDesligarEventosEFD_E530(false);

  GuardarRegistroAtual(qryEFD_E530,true);
  qryEFD_E530.First;
  while not qryefd_e530.Eof do
  begin
    if qryEFD_E530ind_aj.AsInteger = 0 then  //ajuste de débito
      vvl_tot_aj_debitos  := vvl_tot_aj_debitos  + qryEFD_E530vl_aj_apur.AsCurrency
    else
    if qryEFD_E530ind_aj.AsInteger = 1 then  // ajuste de crédito
      vvl_tot_aj_creditos  := vvl_tot_aj_creditos  + qryEFD_E530vl_aj_apur.AsCurrency;

    qryEFD_E530.Next;
  end;

  if not gerandodebitocredito then
    LigarDesligarEventosEFD_E530(true);

  VoltarRegistroAtual(qryEFD_E530);

  qryEFD_E520.Edit;
  qryEFD_E520vl_tot_aj_debitos.AsCurrency := vvl_tot_aj_debitos;
  qryEFD_E520vl_tot_aj_creditos.AsCurrency := vvl_tot_aj_creditos;

  if GravarEFD then
    qryefd_e520.Post;

end;

procedure TdtmEFD.qryEFD_E530AfterEdit(DataSet: TDataSet);
begin
  inherited;
  qryefd.Edit;

end;

procedure TdtmEFD.qryEFD_E530AfterPost(DataSet: TDataSet);
begin
  inherited;
  TotalizaAjusteIPI(false, false);
end;

procedure TdtmEFD.qryEFD_E530NewRecord(DataSet: TDataSet);
begin
  inherited;
  qryEFD_E530periodo.AsString := qryefdperiodo.AsString;
  qryEFD_E530filial.AsInteger := qryefdfilial.AsInteger;
end;

procedure TdtmEFD.P_RegistroE510;
begin
  RefazConsultaPorNome(qryRegistroE510,
                      ['datainicial','datafinal','filial'],
                      [datainicial,datafinal,qryEFDFilial.asinteger]);

  qryRegistroE510.First;
  while not qryRegistroE510.Eof do
  begin
    with ACBrSPEDFiscal.bloco_e.RegistroE510New do
    begin
      CFOP        := qryRegistroE510.fieldbyname('CFOP').asString;  // Código Fiscal de Operação e Prestação do agrupamento de itens
      CST_IPI     := qryRegistroE510.fieldbyname('cst_IPI').asString;      // Código da Situação Tributária referente ao IPI, conforme a Tabela indicada no item 4.3.2.
      VL_CONT_IPI := qryRegistroE510.fieldbyname('VL_CONT_IPI').ascurrency; // Parcela correspondente ao "Valor Contábil" referente ao CFOP e ao Código de Tributação do IPI
      VL_BC_IPI   := qryRegistroE510.fieldbyname('VL_BC_IPI').ascurrency;   // Parcela correspondente ao "Valor da base de cálculo do IPI" referente ao CFOP e ao Código de Tributação do IPI, para operações tributadas
      VL_IPI      := qryRegistroE510.fieldbyname('VL_IPI').ascurrency;      // Parcela correspondente ao "Valor do IPI" referente ao CFOP e ao Código de Tributação do IPI, para operações tributadas

      if ((qryRegistroE510cfop.AsInteger div 1000) = 1) or
         ((qryRegistroE510cfop.AsInteger div 1000) = 2) or
         ((qryRegistroE510cfop.AsInteger div 1000) = 3) then
        FRegistroE520_VL_TOT_CREDITOS := FRegistroE520_VL_TOT_CREDITOS + qryRegistroe510.fieldbyname('VL_IPI').ascurrency
      else
      if ((qryRegistroE510cfop.AsInteger div 1000) = 5) or
         ((qryRegistroE510cfop.AsInteger div 1000) = 6) then
         FRegistroE520_VL_TOT_DEBITOS := FRegistroE520_VL_TOT_DEBITOS + qryRegistroe510.fieldbyname('VL_IPI').ascurrency;

    end;
    qryRegistroE510.Next;
  end;

end;

procedure TdtmEFD.P_RegistroE520;
begin
  with ACBrSPEDFiscal.bloco_e.RegistroE520New do
  begin
    VL_SD_ANT_IPI := qryEFD_E520.fieldbyname('vl_sld_credor_ant').ascurrency ; // Saldo credor do IPI transferido do período anterior
    VL_DEB_IPI    := qryEFD_E520.fieldbyname('vl_tot_debitos').ascurrency ; // Valor total dos débitos por "Saídas com débito do imposto"
    VL_CRED_IPI   := qryEFD_E520.fieldbyname('vl_tot_creditos').ascurrency ; // Valor total dos créditos por "Entradas e aquisições com crédito do imposto"
    VL_OD_IPI     := qryEFD_E520.fieldbyname('vl_tot_aj_debitos').ascurrency ; // Valor de "Outros débitos" do IPI (inclusive estornos de crédito)
    VL_OC_IPI     := qryEFD_E520.fieldbyname('vl_tot_aj_creditos').ascurrency ; // Valor de "Outros créditos" do IPI (inclusive estornos de débitos)
    VL_SC_IPI     := qryEFD_E520.fieldbyname('SALDOCREDOR').ascurrency ; // Valor do saldo credor do IPI a transportar para o período seguinte
    VL_SD_IPI     := qryEFD_E520.fieldbyname('SALDODEVEDOR').ascurrency ; // Valor do saldo devedor do IPI a recolher
    P_RegistroE530;
  end;
end;

procedure TdtmEFD.P_RegistroE530;
begin
  qryEFD_E530.First;
  while not qryEFD_E530.Eof do
  begin
    with ACBrSPEDFiscal.bloco_e.RegistroE530New do
    begin
      case qryefd_e530.FieldByName('ind_aj').AsInteger of
      0: IND_AJ :=  ajDebito;
      1: IND_AJ :=  ajCredito;
      end;
      VL_AJ    := qryefd_e530.FieldByName('vl_aj_apur').ascurrency;    // Valor do ajuste
      COD_AJ   := qryefd_e530.FieldByName('cod_aj_apur').asString; // Código do ajuste da apuração, conforme a Tabela indicada no item 4.5.4.

      // Indicador da origem do documento vinculado ao ajuste: 0 - Processo Judicial; 1 - Processo Administrativo; 2 - PER/DCOMP; 9 - Outros.
      case qryefd_e530.FieldByName('ind_doc').AsInteger of
      0: IND_DOC := odPorcessoJudicial;
      1: IND_DOC := odProcessoAdminist;
      2: IND_DOC := odPerDcomp;
      9: IND_DOC := odOutros;
      end;
      NUM_DOC  := qryefd_e530.FieldByName('num_doc').asString;  // Número do documento / processo / declaração ao qual o ajuste está vinculado, se houver
      DESCR_AJ := qryefd_e530.FieldByName('descr_aj').asString; // Descrição resumida do ajuste.
    end;
    qryEFD_E530.Next;
  end;
end;

procedure TdtmEFD.dsrEFD_E530DataChange(Sender: TObject; Field: TField);
begin
  inherited;
  if field = qryEFD_E530descr_ind_doc then
    if qryEFD_E530descr_ind_doc.AsString<>'' then
      qryEFD_E530ind_doc.AsInteger := strtoint(copy(qryEFD_E530descr_ind_doc.AsString,1,1))
end;

procedure TdtmEFD.qryEFD_E520NewRecord(DataSet: TDataSet);
begin
  inherited;
  qryEFD_E520periodo.AsString := qryefdperiodo.AsString;
  qryEFD_E520filial.AsInteger := qryefdfilial.AsInteger;
end;


procedure TdtmEFD.P_RegistroG110;
begin
  with ACBrSPEDFiscal.Bloco_G.RegistroG110New do
  begin
//    DT_INI        := DataInicial;  /// Data Inicial da Apuracao
//    DT_FIN        := DataFinal;    /// Data Final da Apuracao
   //MODO_CIAP    := String;       /// Modelo de CIAP adotado C ou D   (até a versão 102}
    SALDO_IN_ICMS := qryRegistroG110saldo_in_icms.AsCurrency;   /// Saldo inicial de ICMS do CIAP Modelo C
   //SALDO_FN_ICMS := Currency;   /// Saldo Final ICMS do CIAP Modelo C (até a versão 102}
    SOM_PARC      := qryRegistroG110som_parc.AsCurrency ;        /// Somatorio das Parcelas ICMS Passivel de Apropriacao Modelo D
    VL_TRIB_EXP   := qryRegistroG110vl_trib_exp.AsCurrency ;     /// Valor do somatorio das saidas tributadas e saidas para exportacao
    VL_TOTAL      := qryRegistroG110vl_total.AsCurrency;        /// Valor Total das Saidas
    IND_PER_SAI   := qryRegistroG110ind_per_sai.AsCurrency;       /// Participacao percentual do valor do somatorio das saidas tributadas e para exportacao
    ICMS_APROP    := qryRegistroG110icms_aprop.AsCurrency;      /// Parcela de ICMS a ser apropriada no Registro de Apuracao do ICMS
    SOM_ICMS_OC   := qryRegistroG110som_icms_oc.AsCurrency;     /// Valor de outros créditos a ser apropriado na Apuração do ICMS, correspondente ao somatório do campo 09 do registro G126
    P_RegistroG125;
  end;
end;

procedure TdtmEFD.P_RegistroG125;
begin
  RefazConsultaPorNome(qryRegistroG125,
                       ['datainicial','datafinal','filial'],
                       [datainicial,datafinal,qryEFDFilial.asinteger]);

  RefazConsultaPorNome(qryRegistroG126,
                       ['datainicial','datafinal','filial'],
                       [datainicial,datafinal,qryEFDFilial.asinteger]);

  RefazConsultaPorNome(qryRegistroG130eG140,
                       ['datainicial','datafinal','filial'],
                       [datainicial,datafinal,qryEFDFilial.asinteger]);


  qryRegistroG125.First;
  while not qryRegistroG125.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_G.RegistroG125New do
    begin
      COD_IND_BEM      := qryRegistroG125cod_ind_bem.AsString;         /// Codigo individualizado do bem ou componente
      DT_MOV           := qryRegistroG125dt_mov.AsDateTime;            /// Data movimentacao ou saldo inicial

           if qryRegistroG125tipo_mov.AsString = 'SI' then TIPO_MOV := mbcSI /// Tipo de movimentacao do bem ou componente
      else if qryRegistroG125tipo_mov.AsString = 'IM' then TIPO_MOV := mbcIM
      else if qryRegistroG125tipo_mov.AsString = 'IA' then TIPO_MOV := mbcIA
      else if qryRegistroG125tipo_mov.AsString = 'CI' then TIPO_MOV := mbcCI
      else if qryRegistroG125tipo_mov.AsString = 'MC' then TIPO_MOV := mbcMC
      else if qryRegistroG125tipo_mov.AsString = 'BA' then TIPO_MOV := mbcBA
      else if qryRegistroG125tipo_mov.AsString = 'AT' then TIPO_MOV := mbcAT
      else if qryRegistroG125tipo_mov.AsString = 'PE' then TIPO_MOV := mbcPE
      else if qryRegistroG125tipo_mov.AsString = 'OT' then TIPO_MOV := mbcOT;

      VL_IMOB_ICMS_OP  := qryRegistroG125vl_imob_icms_op.AsCurrency;   // Valor ICMS Operacao Propria na entrada do bem ou componente
      VL_IMOB_ICMS_ST  := qryRegistroG125vl_imob_icms_st.AsCurrency;  // Valor ICMS Operacao Subst.Trib. na entrada do bem ou componente
      VL_IMOB_ICMS_FRT := qryRegistroG125vl_imob_icms_frt.AsCurrency; // Valor ICMS Frete CTC na entrada do bem ou componente
      VL_IMOB_ICMS_DIF := qryRegistroG125vl_imob_icms_dif.AsCurrency; // Valor ICMS Diferencial de Aliquota cfe. Doc. arrecadacao na entrada do bem ou componente
      NUM_PARC         := qryRegistroG125num_parc.AsInteger;          // Numero da Parcela do ICMS
      VL_PARC_PASS     := qryRegistroG125vl_parc_pass.AsCurrency;     // Valor parcela icms passivel de apropriacao

      if (qryRegistroG125tipo_mov.AsString = 'SI') or
         (qryRegistroG125tipo_mov.AsString = 'IM') then
        P_RegistroG126;

      P_RegistroG130;
    end;
    qryRegistroG125.Next;
  end;
end;

procedure TdtmEFD.P_RegistroG126;
begin
  qryRegistroG126.First;
  while not qryRegistroG126.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_G.RegistroG126New do
    begin
      DT_INI       := qryRegistroG126dt_ini.AsDateTime;;
      DT_FIN       := qryRegistroG126dt_fim.AsDateTime;
      NUM_PARC     := qryRegistroG126num_parc.AsInteger;
      VL_PARC_PASS := qryRegistroG126vl_parc_pass.asCurrency;
      VL_TRIB_OC   := qryRegistroG126vl_trib_oc.AsCurrency;
      VL_TOTAL     := qryRegistroG126vl_total.asCurrency;
      IND_PER_SAI  := qryRegistroG126ind_per_sai.AsCurrency;
      VL_PARC_APROP:= qryRegistroG126vl_parc_aprop.AsCurrency;
    end;
    qryRegistroG126.Next;
  end;
end;

procedure TdtmEFD.P_RegistroG130;
begin
  qryRegistroG130eG140.First;
  while not qryRegistroG130eG140.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_G.RegistroG130New do
    begin
      case qryRegistroG130eG140.FieldByName('cod_ind_bem').AsInteger of
      0: IND_EMIT := edEmissaoPropria;     /// Código do ajuste da apuração e dedução, conforme a Tabela indicada no item 5.1.1.
      1: IND_EMIT := edTerceiros;
      end;
      COD_PART    := qryRegistroG130eG140.FieldByName('cod_part').AsString;
      COD_MOD     := qryRegistroG130eG140.FieldByName('cod_mod').AsString;
      SERIE       := qryRegistroG130eG140.FieldByName('serie').AsString;
      NUM_DOC     := qryRegistroG130eG140.FieldByName('num_doc').AsString;
      CHV_NFE_CTE := qryRegistroG130eG140.FieldByName('chv_nfe_cte').AsString;
      DT_DOC      := qryRegistroG130eG140.FieldByName('dt_doc').AsDateTime;

      P_RegistroG140;
    end;
    qryRegistroG130eG140.Next;
  end;
end;

procedure TdtmEFD.P_RegistroG140;
begin
  with ACBrSPEDFiscal.Bloco_G.RegistroG140New do
  begin
    NUM_ITEM := qryRegistroG130eG140.FieldByName('num_item').AsString;  /// Numero Sequencial do Item no documento fiscal
    COD_ITEM := qryRegistroG130eG140.FieldByName('cod_item').AsString;  /// Codigo Correspondente do bem no documento fiscal
  end;
end;

procedure TdtmEFD.qryEFD_E520AfterEdit(DataSet: TDataSet);
begin
  inherited;
  qryefd.Edit;
end;

constructor TdtmEFD.Create(AOwner: TComponent; PeriodoInicial,
  PeriodoFinal: TDateTime);
begin
  inherited Create(AOwner);
  DataInicial := PeriodoInicial;
  DataFinal   := PeriodoFinal;
  qryefd.ParamByName('periodo').AsString := FormatDateTime('MM/YYYY',DataFinal);
  qryefd.ParamByName('filial').AsInteger := FilialBase;

  qryefd.Close;
  qryefd.Open;

end;

procedure TdtmEFD.P_RegistroC197;
begin
  qryRegistroC197.First;
  while not qryRegistroC197.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC197new do
    begin
      COD_AJ         := qryRegistroC197cod_aj.asString;        // Código do ajustes/benefício/incentivo, conforme tabela indicada no item 5.3.
      DESCR_COMPL_AJ := qryRegistroC197descr_compl_aj.asString;        // Descrição complementar do ajuste da apuração, nos casos em que o código da tabela for “9999”
      COD_ITEM       := qryRegistroC197cod_item.asString;        // Código do item (campo 02 do Registro 0200)
      VL_BC_ICMS     := qryRegistroC197vl_bc_icms.ascurrency;      // Base de cálculo do ICMS ou do ICMS ST
      if qryRegistroC197aliq_icms.ascurrency = 0 then
        ALIQ_ICMS    := 0
      else
        ALIQ_ICMS    := qryRegistroC197aliq_icms.ascurrency - qryRegistroC197aliqcredpresumido.ascurrency;      // Alíquota do ICMS

      VL_ICMS        := qryRegistroC197vl_calculado.ascurrency;      // Valor do ICMS ou do ICMS ST
      VL_OUTROS      := qryRegistroC197vl_outros.ascurrency;      // Outros valores
    end;
    CalcularAjustes_C197;
    qryRegistroC197.Next;
  end;

end;

procedure TdtmEFD.qryRegistroC197CalcFields(DataSet: TDataSet);
begin
  inherited;
  qryRegistroC197vl_calculado.AsCurrency := qryRegistroC197vl_icms.AsCurrency -
                                            (qryRegistroC197vl_bc_icms.AsCurrency * qryRegistroC197aliqcredpresumido.AsCurrency / 100);
end;

procedure TdtmEFD.CalcularAjustes_C197;
begin
{Campo 03 VL_AJ_DEBITOS - Validação: o valor informado deve corresponder ao somatório do campo VL_ICMS do registro C197, se o
terceiro caractere do campo COD_AJ do registro C197 for igual a ‘3’, ‘4’ ou ‘5’ e o quarto caractere for igual a “0”, “3”,
“4” ou “5”. Deste somatório, estão excluídos os documentos extemporâneos (COD_SIT com valor igual ‘01’) e os
documentos complementares extemporâneas (COD_SIT com valor igual ‘07’), cujos valores devem ser prestados no
campo DEB_ESP juntamente com os demais valores extra-apuração.
Serão considerados os registros cujos documentos estejam compreendidos no período informado no registro E100,
utilizando para tanto o campo DT_E_S (C100). Quando o campo DT_E_S (C100) for vazio, utilizar o campo DT_DOC.}

        if (strtoint(copy(qryRegistroC197cod_aj.AsString,3,1)) in [3,4,5]) and
           (strtoint(copy(qryRegistroC197cod_aj.AsString,4,1)) in [0,3,4,5]) then
           FRegistroE110_VL_AJ_DEBITOS  := FRegistroE110_VL_AJ_DEBITOS + qryRegistroC197vl_calculado.AsCurrency
        else
        {
        if (copy(qryRegistroC197cod_aj.AsString,3,1)='0') and
           (copy(qryRegistroC197cod_aj.AsString,4,1)='1') then
           vvl_estornos_cred  := vvl_estornos_cred + qryRegistroC197vl_icms.AsCurrency
        else
        }

{Campo 07 VL_AJ_CREDITOS - Validação: o valor informado deve corresponder ao somatório do campo VL_ICMS do registro C197, se o
terceiro caractere do código de ajuste do registro C197 for ‘0’, ‘1’ ou ‘2’ e o quarto caractere for ‘0’, “3”, “4” ou “5”.
Devem ser considerados os documentos fiscais compreendidos no período informado no registro E100, analisando-se as
datas informadas no campo DT_E_S do registro C100, exceto se COD_SIT do registro C100 for igual a ‘01’
(extemporâneo) ou igual a ‘07’ (NF Complementar extemporânea), cujo valor deve ser somado no primeiro período de
apuração informado no registro E100.}

        if (strtoint(copy(qryRegistroC197cod_aj.AsString,3,1)) in [0,1,2]) and
           (strtoint(copy(qryRegistroC197cod_aj.AsString,4,1)) in [0,3,4,5]) then
           FRegistroE110_VL_AJ_CREDITOS := FRegistroE110_VL_AJ_CREDITOS + qryRegistroC197vl_calculado.AsCurrency
        else
        {
        if (copy(qryRegistroC197cod_aj.AsString,3,1)='0') and
           (copy(qryRegistroC197cod_aj.AsString,4,1)='3') then
           vvl_estornos_deb := vvl_estornos_deb + qryRegistroC197vl_icms.AsCurrency
        else
        }
{
Campo 12 VL_TOT_DED - Validação: o valor informado deve corresponder ao somatório do campo VL_ICMS do registro C197, se o
terceiro caractere do código de ajuste do registro C197, for ‘6’ e o quarto caractere for ‘0’, somado ao valor total
informado nos registros E111, quando o terceiro caractere for igual a ‘0’ e o quarto caractere for igual a ‘4’, do campo
COD_AJ_APUR do registro E111.
Para o somatório do campo VL_ICMS do registro C197 devem ser considerados os documentos fiscais compreendidos no
período informado no registro E100, comparando com a data informada no campo DT_E_S do registro C100, exceto se
COD_SIT do registro C100 for igual a ‘01’ (extemporâneo) ou igual a ‘07’ (NF Complementar extemporânea), cujo valor
deve ser somado no primeiro período de apuração informado no registro E100, quando houver mais de um período de
apuração. Quando o campo DT_E_S não for informado, utilizar o campo DT_DOC.
Neste campo são informados os valores que, segundo a legislação da UF, devam ser tratados como “Dedução do imposto”,
ainda que no campo VL_SLD_APURADO tenha como resultado o valor zero.}

        if (copy(qryRegistroC197cod_aj.AsString,3,1)='6') and
           (copy(qryRegistroC197cod_aj.AsString,4,1)='0') then
           FRegistroE110_VL_TOT_DED := FRegistroE110_VL_TOT_DED + qryRegistroC197vl_calculado.AsCurrency
        else

{
Campo 15 – Preenchimento: Informar o correspondente ao somatório dos valores:
a) de ICMS correspondentes aos documentos fiscais extemporâneos (COD_SIT igual a “01”) e das notas fiscais
complementares extemporâneas (COD_SIT igual a “07”); Pode ser verificado no resumo do relatório dos registros
fiscais de documentos de saídas (totalização por COD_SIT e CFOP ou o de entradas, constante das últimas
páginas).
b) de ajustes do campo VL_ICMS do registro C197, se o terceiro caractere do código informado no campo COD_AJ
do registro C197 for igual a “7” (débitos especiais) e o quarto caractere for igual a “0” ou “2” (operações próprias
ou outras apurações) referente aos documentos compreendidos no período a que se refere a escrituração *( Pode
ser verificado no resumo do relatório dos registros fiscais de documentos de saídas (totalização dos ajustes
constante das últimas páginas); e
c) de ajustes do campo VL_AJ_APUR do registro E111, se o terceiro caractere do código informado no campo
COD_AJ_APUR do registro E111 for igual a “0” (apuração ICMS próprio) e o quarto caractere for igual a
“5”(débito especial). *(Valor informado nos registros E111 com os códigos específicos para débitos especiais).
Validação: O valor da soma deste campo com o campo VL_ICMS_RECOLHER deve ser igual à soma dos valores do
campo VL_OR do registro E116.
REGISTRO
}
        if (copy(qryRegistroC197cod_aj.AsString,3,1)='7') and
           (strtoint(copy(qryRegistroC197cod_aj.AsString,4,1)) in [0,2]) then
           FRegistroE110_VL_DEB_ESP := FRegistroE110_VL_DEB_ESP + qryRegistroC197vl_calculado.AsCurrency;

end;

procedure TdtmEFD.P_RegistroD500;
begin
  RefazConsultaPorNome(qryRegistroD500, ['filial','datainicial','datafinal'],
                       [qryEFDFilial.asinteger, datainicial, datafinal]);

    RefazConsultaPorNome(qryRegistroD590, ['filial','datainicial','datafinal'],
                         [qryEFDFilial.asinteger, datainicial, datafinal]);


  if not qryRegistroD500.IsEmpty and
     (ACBrSPEDFiscal.Bloco_D.RegistroD001.IND_MOV = imSemDados) then
    ACBrSPEDFiscal.Bloco_D.RegistroD001.IND_MOV := imComDados;

  qryRegistroD500.First;
  while not qryRegistroD500.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_D.RegistroD500New do
    begin
      IND_OPER := Operacao(qryRegistroD500.fieldbyname('IND_OPER').AsInteger);
      IND_EMIT := Emitente(qryRegistroD500.fieldbyname('IND_EMIT').AsInteger);
      COD_PART := qryRegistroD500.fieldbyname('COD_PART').AsString;
      COD_MOD  := qryRegistroD500.fieldbyname('COD_MOD').AsString;
      COD_SIT  := SituacaoDocto(qryRegistroD500.fieldbyname('COD_SIT').AsString);
      SER      := qryRegistroD500.fieldbyname('SER').AsString;
//      SUB      := qryRegistroD500.fieldbyname('SUB').AsInteger;
      NUM_DOC  := qryRegistroD500.fieldbyname('NUM_DOC').AsString;
      DT_DOC   := qryRegistroD500.fieldbyname('DT_DOC').asDateTime;
      DT_A_P   := qryRegistroD500.fieldbyname('DT_DOC').asDateTime;
      VL_DOC        := qryRegistroD500.fieldbyname('VL_DOC').ascurrency;
      VL_DESC       := qryRegistroD500.fieldbyname('VL_DESC').ascurrency;
      VL_SERV := qryRegistroD500.fieldbyname('VL_SERV').ascurrency;
      VL_SERV_NT := qryRegistroD500.fieldbyname('VL_SERV_NT').ascurrency;
      VL_TERC := qryRegistroD500.fieldbyname('VL_TERC').ascurrency;
      VL_DA := qryRegistroD500.fieldbyname('VL_DA').ascurrency;
      VL_BC_ICMS := qryRegistroD500.fieldbyname('VL_BC_ICMS').ascurrency;
      VL_ICMS := qryRegistroD500.fieldbyname('VL_ICMS').ascurrency;

      if qryRegistroD500txt.AsString<>'' then
      begin
        if qryRegistro0450.Locate('txt',qryRegistroD500txt.AsString,[]) then
          COD_INF := inttostr(qryRegistro0450.RecNo)
        else
          MensagemErro('Inconssistência: Registro0450 x REgistroD500'+#10#13+
                       'Descrição não encontrada: '+qryRegistroD100txt.AsString);
      end;

      VL_PIS := qryRegistroD500.fieldbyname('VL_PIS').ascurrency;
      VL_COFINS := qryRegistroD500.fieldbyname('VL_COFINS').ascurrency;

      P_RegistroD590;

      qryRegistroD500.Next;
    end;
  end;
end;


procedure TdtmEFD.P_RegistroD590;
begin
  qryRegistroD590.First;
  while not qryRegistroD590.Eof do
  begin
    with ACBrSPEDFiscal.bloco_D.RegistroD590New do
    begin
      CST_ICMS     := preencheString(trim(qryRegistroD590.fieldbyname('CST_ICMS').asstring),'0',3,false);
      CFOP         := qryRegistroD590.fieldbyname('CFOP').AsString;
      ALIQ_ICMS    := qryRegistroD590.fieldbyname('ALIQ_ICMS').AsCurrency;
      VL_OPR       := qryRegistroD590.fieldbyname('VL_OPR').AsCurrency;
      VL_BC_ICMS   := qryRegistroD590.fieldbyname('VL_BC_ICMS').AsCurrency;
      VL_ICMS      := qryRegistroD590.fieldbyname('VL_ICMS').AsCurrency;
//      VL_RED_BC    := qryRegistroC590.fieldbyname('VL_RED_BC').AsCurrency;
//      COD_OBS      := AnsiString read fCOD_OBS write fCOD_OBS;
      {Só temos entrada neste caso}
      if qryRegistroD100.fieldbyname('IND_OPER').AsString = ctOPERENTRADA then
        FRegistroE110_VL_TOT_CREDITOS := FRegistroE110_VL_TOT_CREDITOS + VL_ICMS;
    end;
    qryRegistroD590.Next;
  end;

end;

function TdtmEFD.MotivodoInventario(motivo: String): TACBrMotivoInventario;
begin
       if motivo = '01' then result := miFinalPeriodo
  else if motivo = '02' then result := miMudancaTributacao
  else if motivo = '03' then result := miBaixaCadastral
  else if motivo = '04' then result := miRegimePagamento
  else if motivo = '05' then result := miDeterminacaoFiscos;

end;

procedure TdtmEFD.Bloco_1;
begin
  if DataInicial >= strtodatetime('01/07/2012') then
  begin
    ACBrSPEDFiscal.Bloco_1.Registro1001.IND_MOV := imComDados;
    with  ACBrSPEDFiscal.Bloco_1.Registro1010New do
    begin

      IND_EXP   := 'N'; // Reg. 1100 - Ocorreu averbação (conclusão) de exportação no período:
      IND_CCRF  := 'N'; // Reg. 1200 – Existem informações acerca de créditos de ICMS a serem controlados, definidos pela Sefaz:
      IND_COMB  := 'N'; // Reg. 1300 – É comercio varejista de combustíveis:
      IND_USINA := 'N'; // Reg. 1390 – Usinas de açúcar e/álcool – O estabelecimento é produtor de açúcar e/ou álcool carburante:
      IND_VA    := 'N'; // Reg. 1400 – Existem informações a serem prestadas neste registro e o registro é obrigatório em sua Unidade da Federação:
      IND_EE    := 'N'; // Reg. 1500 - A empresa é distribuidora de energia e ocorreu fornecimento de energia elétrica para consumidores de outra UF:
      IND_CART  := 'N'; // Reg. 1600 - Realizou vendas com Cartão de Crédito ou de débito:
      IND_FORM  := 'N'; // Reg. 1700 - É obrigatório em sua unidade da federação o controle de utilização de documentos  fiscais em papel:
      IND_AER   := 'N'; // Reg. 1800 – A empresa prestou serviços de transporte aéreo de cargas e de passageiros:

    end;
  end;  


end;

end.

