procedure TdtmEFD.P_Registro0200;
{
--------------------------------------------------------------------------------
REGISTRO 0200: TABELA DE IDENTIFICAÇÃO DO ITEM (PRODUTO E SERVIÇOS)
--------------------------------------------------------------------------------
Nº	Campo	        Descrição	                Tipo	Tam	Dec
--------------------------------------------------------------------------------
01	REG	        Texto fixo contendo "0200"	C	004	-
02	COD_ITEM	Código do item 	                C	060	-
03	DESCR_ITEM	Descrição do item	        C	-	-
04	COD_BARRA	Representação alfanumérico do
                        código de barra do produto,
                        se houver	                C	-	-
05	COD_ANT_ITEM	Código anterior do item com
                        relação à última informação
                        apresentada.	                C	060	-
06	UNID_INV	Unidade de medida utilizada
                        na quantificação de estoques.  	C	006	-
07	TIPO_ITEM	Tipo do item - Atividades
                        Industriais, Comerciais e Serviços:
                                00 - Mercadoria para Revenda;
                                01 - Matéria-Prima;
                                02 - Embalagem;
                                03 - Produto em Processo;
                                04 - Produto Acabado;
                                05 - Subproduto;
                                06 - Produto Intermediário;
                                07 - Material de Uso e Consumo;
                                08 - Ativo Imobilizado;
                                09 - Serviços;
                                10 - Outros insumos;
                                99 - Outras	        N	2	-
08	COD_NCM	        Código da Nomenclatura Comum do
                        Mercosul	                C	008	-
09	EX_IPI	        Código EX, conforme a TIPI	C	003	-
10	COD_GEN	        Código do gênero do item,
                        conforme a Tabela 4.2.1	        N	002*	-
11	COD_LST	        Código do serviço conforme
                        lista do Anexo I da Lei
                        Complementar Federal nº 116/03.	N	004
12	ALIQ_ICMS	Alíquota de ICMS aplicável
                        ao item nas operações internas	N	006	02
--------------------------------------------------------------------------------
Observações:
1.      O Código do Item deverá ser preenchido com as informações utilizadas na
        última ocorrência do período.
 2.     O campo COD_NCM é obrigatório:
 2.1) para empresas industriais e equiparadas a industrial, referente aos itens
        correspondentes à atividade fim,  ou quando gerarem créditos e débitos
        de IPI;
 2.2) para contribuintes de ICMS que sejam substitutos tributários;
 2.3) para empresas que realizarem operações de exportação ou importação."

3. O campo COD_GEN é obrigatório a todos os contribuintes somente na aquisição
        de produtos primários.
Nível hierárquico - 2
Ocorrência - vários (por arquivo)
--------------------------------------------------------------------------------
}
var
  vDataInventario: TDateTime;

begin
  if qryefddatainventario.isnull then
    vDataInventario := DataFinal
  else
    vDataInventario := qryefddatainventario.asdatetime;


  RefazConsultaPorNome(qryRegistro0200,
      ['datainicial','datafinal','datainventario','filial','estado','IncluirInventario'],
      [datainicial, datafinal, vdataInventario, qryefdfilial.asinteger, estadofilialbase, not qryefddatainventario.isnull]);

  qryRegistro0200.First;
  while not qryRegistro0200.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_0.Registro0200New do
    begin
      COD_ITEM    := qryRegistro0200.fieldbyname('COD_ITEM').asstring;       /// Código do item:
      DESCR_ITEM  := trim(qryRegistro0200.fieldbyname('DESCR_ITEM').asstring);     /// Descrição do item:
      COD_BARRA   := qryRegistro0200.fieldbyname('COD_BARRA').asstring;      /// Código de barra do produto, se houver:
      COD_ANT_ITEM:= qryRegistro0200.fieldbyname('COD_ANT_ITEM').asstring;   /// Código anterior do item (ultima apresentado):
      UNID_INV    := qryRegistro0200.fieldbyname('UNID_INV').asstring;       /// Unidade de medida do estoque:
      TIPO_ITEM   := tipoitem(qryRegistro0200.fieldbyname('TIPO_ITEM').asstring);      /// Tipo do item - Atividades Industriais, Comerciais e Serviços: 00 - Mercadoria para Revenda, 01 - Matéria-Prima,  02 - Embalagem, 03 - Produto em Processo, 04 - Produto Acabado, 05 - Subproduto, 06 - Produto Intermediário, 07 - Material de Uso e Consumo, 08 - Ativo Imobilizado, 09 - Serviços, 10 - Outros insumos, 99 - Outras
      COD_NCM     := SomenteNumero(qryRegistro0200.fieldbyname('COD_NCM').asstring);        /// Código da Nomenclatura Comum do Mercosul:
      EX_IPI      := qryRegistro0200.fieldbyname('EX_IPI').asstring;         /// Código EX, conforme a TIPI:
      COD_GEN     := format('%2.2d',[qryRegistro0200.fieldbyname('COD_GEN').asinteger]);        /// Código gênero item, tabela indicada item 4.2.1:
      COD_LST     := somenteNumero(qryRegistro0200.fieldbyname('COD_LST').asstring);        /// Código serviço Anexo I - Lei nº116/03:
      ALIQ_ICMS   := qryRegistro0200.fieldbyname('ALIQ_ICMS').AsCurrency;      /// Alíquota ICMS aplicável (operações internas):
    end;
    qryRegistro0200.Next;
  end;
end;

