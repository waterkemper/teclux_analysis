uses ACBrEFDBloco_C, ACBrEFDBloco_D, ACBrEFDBloco_E, ACBrEFDBloco_H,
  ACBrEFDBloco_G, ACBrEFDBloco_1;


{$R *.dfm}

{ TdtmEFD }


{
Tabela Blocos
Bloco Descrição
    0 Abertura, Identificação e Referências
    C Documentos Fiscais I – Mercadorias (ICMS/IPI)
    D Documentos Fiscais II – Serviços (ICMS)
    E Apuração do ICMS e do IPI
    H Inventário Físico
    1 Outras Informações
    9 Controle e Encerramento do Arquivo Digital
}
function TdtmEFD.GerarArquivo(pArquivo: String;  ViaMenuFiscal: Boolean = False): Boolean;
var
  NRegistrosDeclaracao,
  NRegistrosTotal : integer;
  Arq: TextFile;
  vPath, vArquivo,
  Barra,
  formato : String;
begin

  result := false;
{
  vPath := ExtractFilePath(Application.ExeName) + 'Saidas';
  if not DirectoryExists(vPath) then
    if not CreateDir(vPath) then
    raise Exception.Create('Impossível criar o diretório '+vPath);
    }

  {$IFDEF LINUX}
    Barra := '/';
  {$ELSE}
    Barra := '\';
  {$ENDIF}

  if ViaMenuFiscal then
  begin
    vPath    := ExtractFilePath(pArquivo);
    vArquivo := ExtractFileName(pArquivo);
  end
  else
  begin
    vPath    := SpedFiscalDir+Barra;
    vArquivo := pArquivo;
  end;

  result := true;

//  AtualizarSaldosICMS(false);

//comentario jr 19/12 .. sempre gerando zerado
{  FRegistroE110_VL_TOT_DEBITOS := 0;
  FRegistroE110_VL_TOT_CREDITOS := 0;

  FRegistroE110_VL_AJ_DEBITOS := 0;
  FRegistroE110_VL_AJ_CREDITOS := 0;

  FRegistroE110_VL_TOT_DED := 0;
  FRegistroE110_VL_DEB_ESP := 0;}


  FRegistroE520_VL_TOT_DEBITOS := 0;
  FRegistroE520_VL_TOT_CREDITOS := 0;


  Bloco_0;
  Bloco_C;
  Bloco_D;
  Bloco_E;
  Bloco_G;
  Bloco_H;
  Bloco_1;
  Bloco_9;


  with ACBrSPEDFiscal do
  begin
    DT_INI := DataInicial;
    DT_FIN := DataFinal;
    Path := vPath;
    Arquivo := vArquivo;
    SaveFileTXT;
  end;

  qryefd.Edit;
  qryefddata.AsDateTime := now();
  qryefd.post;

end;



procedure TdtmEFD.ACBrSPEDFiscalError(const MsnError: String);
begin
  inherited;
  Erro := MsnError;
  if Assigned(ACBrSPEDFiscalonError) then
    ACBrSPEDFiscalonError(self);

end;


procedure TdtmEFD.Bloco_0;
begin
  P_Registro0000; //Abertura, Identificação e Referências
  P_Registro0001; //ABERTURA DO BLOCO 0
  P_Registro0005; //DADOS COMPLEMENTARES DA ENTIDADE
  P_Registro0015; //DADOS DO CONTRIBUINTE SUBSTITUTO
  P_Registro0100; //DADOS DO CONTABILISTA
  P_Registro0150; //TABELA DE CADASTRO DO PARTICIPANTE
  P_Registro0175; //ALTERAÇÃO DA TABELA DE CADASTRO DE PARTICIPANTE
  P_Registro0190; //IDENTIFICAÇÃO DAS UNIDADES DE MEDIDA
  P_Registro0200; //TABELA DE IDENTIFICAÇÃO DO ITEM (PRODUTO E SERVIÇOS)
  P_Registro0205; //ALTERAÇÃO DO ITEM
  P_Registro0206; //CÓDIGO DE PRODUTO CONFORME TABELA ANP (COMBUSTÍVEIS)
  P_Registro0220; //FATORES DE CONVERSÃO DE UNIDADES
  P_Registro0300; //CADASTRO DE BENS OU COMPONENTES DO ATIVO IMOBILIZADO
  P_Registro0400; //TABELA DE NATUREZA DA OPERAÇÃO/PRESTAÇÃO
  P_Registro0450; //TABELA DE INFORMAÇÃO COMPLEMENTAR DO DOCUMENTO FISCAL
  P_Registro0460; //TABELA DE OBSERVAÇÕES DO LANÇAMENTO FISCAL
  P_Registro0500; //PLANO DE CONTAS CONTÁBEIS
  P_Registro0600; //CENTRO DE CUSTOS
  P_Registro0990; //ENCERRAMENTO DO BLOCO 0
end;

procedure TdtmEFD.P_Registro0000;
{ ------------------------------------------------------------------------------------------|
| Bloco 0: Abertura, Identificação e Referências                                          |
|-----------------------------------------------------------------------------------------|
| Nº | Campo	   | Descrição                                          | Tipo | Tam  | Dec |
|-----------------------------------------------------------------------------------------|
| 01 | REG	   | Texto fixo contendo "0000".	                |  C   | 004  | -   |
| 02 | COD_VER   |Código da versão do leiaute conforme                |      |      |     |
|                |   a tabela indicada no Ato Cotepe .                |  N   | 003* |	-   |
| 03 | COD_FIN   | Código da finalidade do arquivo:                   |      |      |     |
|                |    0 - Remessa do arquivo original;                |      |      |     |
|                |    1 - Remessa do arquivo substituto.              |  N   | 001  | -   |
| 04 | DT_INI	   | Data inicial das informações contidas no arquivo.  |  N   | 008* | -   |
| 05 | DT_FIN	   | Data final das informações contidas no arquivo.	|  N   | 008* |	-   |
| 06 | NOME	   | Nome empresarial da entidade.	                |  C   | 100  |	-   |
| 07 | CNPJ	   | Número de inscrição da entidade no CNPJ.	        |  N   | 014* | -   |
| 08 | CPF	   | Número de inscrição da entidade no CPF.	        |  N   | 011* | -   |
| 09 | UF	   | Sigla da unidade da federação da entidade.	        |  C   | 002* | -   |
| 10 | IE	   | Inscrição Estadual da entidade.	                |  C   | 014  | -   |
| 11 | COD_MUN   |Código do município do domicílio fiscal da entidade,|      |      |     |
|    |           |conforme a tabela IBGE                              |  N   | 007* |	-   |
| 12 | IM	   | Inscrição Municipal da entidade.	                |  C   |  -	-   |
| 13 | SUFRAMA   | Inscrição da entidade na Suframa	                |  C   | 009* |	-   |
| 14 | IND_PERFIL| Perfil de apresentação do arquivo fiscal;          |      |      |     |
|    |           |         A - Perfil A;                              |      |      |     |
|    |           |         B - Perfil B.;                             |      |      |     |
|    |           |         C - Perfil C.                              |  C   | 001  |	-   |
| 15 | IND_ATIV  | Indicador de tipo de atividade:                    |      |      |     |
|    |           |         0 - Industrial ou equiparado a industrial; |      |      |     |
|    |           |         1 - Outros.	                        |  N   |  001 |  -  |
|------------------------------------------------------------------------------------------ }
begin
  with ACBrSPEDFiscal.Bloco_0.Registro0000New do
  begin
    if DataInicial >= strtodatetime('01/01/2014') then
       COD_VER    := vlVersao107 // Código 007
    else
    if DataInicial >= strtodatetime('01/01/2013') then
       COD_VER    := vlVersao106 // Código 007
    else
    if DataInicial >= strtodatetime('01/07/2012') then
       COD_VER    := vlVersao105 // Código 006 - Versão 105 Ato COTEPE 09/2012
    else
    if DataInicial >= strtodatetime('01/01/2012') then
       COD_VER    := vlVersao104 // Código 005 - Versão 104 Ato COTEPE 01/01/2012
    else
    if DataInicial >= strtodatetime('01/01/2011') then
      COD_VER    := vlVersao103 // Código 004 - Versão 103 Ato COTEPE 01/01/2011
    else
      COD_VER    := vlVersao102; //003;

    if qryefdtipo.AsString = 'O' then
      COD_FIN := raOriginal
    else
      if qryefdtipo.AsString = 'S' then
        COD_FIN := raSubstituto;

    NOME       := copy(qryFiliaisrazao.AsString,1,100); // Nome Empresa
    CNPJ       := somentenumero(qryFiliaiscnpj.AsString); // CNPJ Empresa;
    CPF        := ''; // Deve ser uma informação valida
    UF         := qryFiliaisestado.AsString;
    IE         := copy(somentenumero(qryFiliaisinscricaoestadual.AsString),1,14);
    COD_MUN    := strtoint(qryFiliaiscidadeibge.AsString);
    IM         := qryFiliaisinscricaomunicipal.AsString;
    SUFRAMA    := qryFiliaissuframa.AsString;

    if      qryFiliaisind_perfil.AsString = 'A' then  IND_PERFIL := pfPerfilA
    else if qryFiliaisind_perfil.AsString = 'B' then  IND_PERFIL := pfPerfilB
    else if qryFiliaisind_perfil.AsString = 'C' then  IND_PERFIL := pfPerfilC;

    case qryFiliaisind_ativ.AsInteger of
    0 : IND_ATIV   := atIndustrial;
    1 : IND_ATIV   := atOutros;
    end;

    DT_INI     := DataInicial;
    DT_FIN     := DataFinal;
  end;
end;

procedure TdtmEFD.P_Registro0001;
{-----------------------------------------------------------------------------
REGISTRO 0001: ABERTURA DO BLOCO 0
-----------------------------------------------------------------------------
Nº	Campo	Descrição	                Tipo	Tam	Dec
-----------------------------------------------------------------------------
01	REG	Texto fixo contendo "0001".	C	004	-
-----------------------------------------------------------------------------
02	IND_MOV	Indicador de movimento:
              0- Bloco com dados informados;
              1- Bloco sem dados informados.	N	001	-
-----------------------------------------------------------------------------}
begin
  ACBrSPEDFiscal.Bloco_0.Registro0001New.IND_MOV := imComDados;
end;


procedure TdtmEFD.Bloco_C;
begin
  P_RegistroC001; //ABERTURA DO BLOCO C
  P_RegistroC100; //NOTA FISCAL (CÓDIGO 01), NOTA FISCAL AVULSA (CÓDIGO 1B),
                  //NOTA FISCAL DE PRODUTOR (CÓDIGO 04) E NF-e (CÓDIGO 55)
  P_RegistroC300; //NOTA FISCAL DE VENDA A CONSUMIDOR (02) - consolidado
  P_RegistroC350; //NOTA FISCAL DE VENDA A CONSUMIDOR (02) - por itens
  P_RegistroC400; //ECF 2D
  P_RegistroC500; //NOTA FISCAL/CONTA DE ENERGIA
end;




procedure TdtmEFD.P_RegistroC114;
{
--------------------------------------------------------------------------------
REGISTRO C114: CUPOM FISCAL REFERENCIADO
--------------------------------------------------------------------------------
Nº Campo    Descrição	                                Tipo	Tam	Dec
01 REG	    Texto fixo contendo "C114"	                C	004	-
02 COD_MOD  Código do modelo do documento fiscal,
            conforme a tabela indicada no item 4.1.1 	C	002*	-
03 ECF_FAB  Número de série de fabricação do ECF	C	020	-
04 ECF_CX   Número do caixa atribuído ao ECF	        N	003	-
05 NUM_DOC  Número do documento fiscal  	        N	006
06 DT_DOC   Data da emissão do documento fiscal	        N	008*	-
--------------------------------------------------------------------------------
Nível hierárquico - 4
Ocorrência - 1:N
--------------------------------------------------------------------------------
}
begin
  qryRegistroC114.First;
  while not qryRegistroC114.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC114New do
    begin
      COD_MOD := qryRegistroC114.fieldbyname('cod_mod').AsString;
      ECF_FAB := qryRegistroC114.fieldbyname('ecf_fab').AsString;
      ECF_CX  := format('%3.3d',[strtoint(qryRegistroC114.fieldbyname('ecf_cx').AsString)]);
      NUM_DOC := qryRegistroC114.fieldbyname('num_doc').AsString;
      DT_DOC  := qryRegistroC114.fieldbyname('dt_doc').AsDateTime;
    end;
    qryRegistroC114.Next;
  end;
end;


procedure TdtmEFD.P_RegistroC100;
{
REGISTRO C100: NOTA FISCAL (CÓDIGO 01), NOTA FISCAL AVULSA (CÓDIGO 1B),
               NOTA FISCAL DE PRODUTOR (CÓDIGO 04) E NF-e (CÓDIGO 55)

Nº Campo	Descrição	                        tipo	Tam	Dec
01 REG	Texto fixo contendo "C100"	                C	004	-
02 IND_OPER	Indicador do tipo de operação:
                0- Entrada;
                1- Saída	                        C	001*	-
03 IND_EMIT	Indicador do emitente do documento fiscal:
                0- Emissão própria;
                1- Terceiros	                        C	001*	-
04 COD_PART	Código do participante (campo 02 do Registro 0150):
                - do emitente do documento ou do remetente das mercadorias, no
                caso de entradas;
                - do adquirente, no caso de saídas	C	060	-
05 COD_MOD	Código do modelo do documento fiscal, conforme a Tabela 4.1.1
                                                        C	002*	-
06 COD_SIT	Código da situação do documento fiscal, conforme a Tabela 4.1.2
                                                        N	002*	-
07 SER	        Série do documento fiscal	        C	003	-
08 NUM_DOC	Número do documento fiscal	        N	009	-
09 CHV_NFE	Chave da Nota Fiscal Eletrônica	        N	044*	-
10 DT_DOC	Data da emissão do documento fiscal 	N	008*	-
11 DT_E_S	Data da entrada ou da saída	        N	008*	-
12 VL_DOC	Valor total do documento fiscal	        N	-	02
13 IND_PGTO	Indicador do tipo de pagamento:
                0- À vista;
                1- A prazo;
                9- Sem pagamento.	                C	001*	-
14 VL_DESC	Valor total do desconto	                N	-	02
15 VL_ABAT_NT	Abatimento não tributado e não comercial
                Ex. desconto ICMS nas remessas para ZFM.N	-	02
16 VL_MERC	Valor total das mercadorias e serviços	N	-	02
17 IND_FRT	Indicador do tipo do frete:
                0- Por conta de terceiros;
                1- Por conta do emitente;
                2- Por conta do destinatário;
                9- Sem cobrança de frete.	        C	001*	-
18 VL_FRT	Valor do frete indicado no documento
                fiscal	                                N	-	02
19 VL_SEG	Valor do seguro indicado no documento
                fiscal	                                N	-	02
20 VL_OUT_DA	Valor de outras despesas acessórias	N	-	02
21 VL_BC_ICMS	Valor da base de cálculo do ICMS	N	-	02
22 VL_ICMS	Valor do ICMS	                        N	-	02
23 VL_BC_ICMS_ST Valor da base de cálculo do ICMS
                substituição tributária	                N	-	02
24 VL_ICMS_ST	Valor do ICMS retido por substituição
                tributária	                        N	-	02
25 VL_IPI	Valor total do IPI 	                N	-	02
26 VL_PIS	Valor total do PIS	                N	-	02
27 VL_COFINS	Valor total da COFINS	                N	-	02
28 VL_PIS_ST	Valor total do PIS retido por
                substituição tributária	                N	-	02
29 VL_COFINS_ST	Valor total da COFINS retido por
                substituição tributária	                N	-	02
--------------------------------------------------------------------------------
                Nível hierárquico - 2
                Ocorrência - vários (por arquivo)
--------------------------------------------------------------------------------
}
begin
  RefazConsultaPorNome(qryRegistroC100,
                       ['datainicial','datafinal','filial'],
                       [datainicial,datafinal,qryEFDFilial.asinteger]);

//   if qryRegistroC100.IsEmpty and
//     ACBrSPEDFiscal.Bloco_C.RegistroC001.IND_MOV := imSemDados;

    RefazConsultaPorNome(qryRegistroC110,
                         ['datainicial','datafinal','filial','ctREFERENTECUPOMFISCAL'],
                         [datainicial,datafinal,qryEFDFilial.asinteger,ctREFERENTECUPOMFISCAL]);

      RefazConsultaPorNome(qryRegistroC114,
                           ['datainicial','datafinal','filial','ctREFERENTECUPOMFISCAL'],
                           [datainicial,datafinal,qryEFDFilial.asinteger,ctREFERENTECUPOMFISCAL]);

    RefazConsultaPorNome(qryRegistroC120,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC130,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC160,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC170,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC172,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC190,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC195,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

      RefazConsultaPorNome(qryRegistroC197,
                           ['datainicial','datafinal','filial'],
                           [datainicial,datafinal,qryEFDFilial.asinteger]);



  qryRegistroC100.First;
  while not qryRegistroC100.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_C.RegistroC100New do
    begin

      if (qryRegistroC100.fieldbyname('COD_SIT').AsString = '02') then //cancelada
      begin
        IND_OPER      := Operacao(qryRegistroC100.fieldbyname('IND_OPER').Asinteger);
        IND_EMIT      := Emitente(qryRegistroC100.fieldbyname('IND_EMIT').AsInteger);
        COD_MOD       := qryRegistroC100.fieldbyname('COD_MOD').AsString;
        COD_SIT       := SituacaoDocto(qryRegistroC100.fieldbyname('COD_SIT').Asstring);
        SER           := qryRegistroC100.fieldbyname('SER').AsString;
        NUM_DOC       := qryRegistroC100.fieldbyname('NUM_DOC').AsString;
        IND_PGTO      := tpNenhum;
        IND_FRT       := tfNenhum;

        if qryRegistroC100.fieldbyname('COD_MOD').AsString='55' then
          CHV_NFE       := qryRegistroC100.fieldbyname('CHV_NFE').AsString;
      end;

      if (qryRegistroC100.fieldbyname('COD_SIT').AsString = '08') then //regime especial
      begin
        IND_OPER      := Operacao(qryRegistroC100.fieldbyname('IND_OPER').Asinteger);
        IND_EMIT      := Emitente(qryRegistroC100.fieldbyname('IND_EMIT').AsInteger);
        COD_PART      := qryRegistroC100.fieldbyname('COD_PART').AsString;
        COD_MOD       := qryRegistroC100.fieldbyname('COD_MOD').AsString;
        COD_SIT       := SituacaoDocto(qryRegistroC100.fieldbyname('COD_SIT').Asstring);

        NUM_DOC       := qryRegistroC100.fieldbyname('NUM_DOC').AsString;
        DT_DOC        := qryRegistroC100.fieldbyname('DT_DOC').AsDateTime;

        VL_DOC        := qryRegistroC100.fieldbyname('VL_DOC').AsCurrency;

        P_RegistroC110;
        P_RegistroC120;
        P_RegistroC130;
        P_RegistroC140;
        P_RegistroC160;
        P_RegistroC165;
        P_RegistroC170;
        P_RegistroC190;
        P_RegistroC195;

      end;

      if (qryRegistroC100.fieldbyname('COD_SIT').AsString = '00') or  // normal
         (qryRegistroC100.fieldbyname('COD_SIT').AsString = '01') or  // normal extemporanea
         (qryRegistroC100.fieldbyname('COD_SIT').AsString = '06') then // complementar
      begin
        IND_OPER := Operacao(qryRegistroC100.fieldbyname('IND_OPER').Asinteger);
        IND_EMIT := Emitente(qryRegistroC100.fieldbyname('IND_EMIT').AsInteger);
        COD_MOD       := qryRegistroC100.fieldbyname('COD_MOD').AsString;
        COD_SIT       := SituacaoDocto(qryRegistroC100.fieldbyname('COD_SIT').AsString);
        SER           := qryRegistroC100.fieldbyname('SER').AsString;
        NUM_DOC       := qryRegistroC100.fieldbyname('NUM_DOC').AsString;
        COD_PART      := qryRegistroC100.fieldbyname('COD_PART').AsString;

        if qryRegistroC100.fieldbyname('COD_MOD').AsString='55' then
          CHV_NFE       := qryRegistroC100.fieldbyname('CHV_NFE').AsString;

        DT_DOC        := qryRegistroC100.fieldbyname('DT_DOC').AsDateTime;

        if qryRegistroC100.fieldbyname('DT_E_S').AsDateTime <= DataFinal then
          DT_E_S        := qryRegistroC100.fieldbyname('DT_E_S').AsDateTime;

        VL_DOC        := qryRegistroC100.fieldbyname('VL_DOC').AsCurrency;

        if qryRegistroC100.fieldbyname('IND_PGTO').IsNull then
          IND_PGTO      := tpNenhum
        else
          IND_PGTO      := TipoPagamento(qryRegistroC100.fieldbyname('IND_PGTO').AsInteger);

        VL_DESC       := qryRegistroC100.fieldbyname('VL_DESC').AsCurrency;
        VL_ABAT_NT    := qryRegistroC100.fieldbyname('VL_ABAT_NT').AsCurrency;
        VL_MERC       := qryRegistroC100.fieldbyname('VL_MERC').AsCurrency;

        if qryRegistroC100.fieldbyname('IND_FRT').IsNull then
          IND_FRT := tfNenhum
        else
          IND_FRT       := TipoFrete(qryRegistroC100.fieldbyname('IND_FRT').AsInteger);

        VL_FRT        := qryRegistroC100.fieldbyname('VL_FRT').AsCurrency;
        VL_SEG        := qryRegistroC100.fieldbyname('VL_SEG').AsCurrency;
        VL_OUT_DA     := qryRegistroC100.fieldbyname('VL_OUT_DA').AsCurrency;
        VL_BC_ICMS    := qryRegistroC100.fieldbyname('VL_BC_ICMS').AsCurrency;
        VL_ICMS       := qryRegistroC100.fieldbyname('VL_ICMS').AsCurrency;
        VL_BC_ICMS_ST := qryRegistroC100.fieldbyname('VL_BC_ICMS_ST').AsCurrency;
        VL_ICMS_ST    := qryRegistroC100.fieldbyname('VL_ICMS_ST').AsCurrency;
        VL_IPI        := qryRegistroC100.fieldbyname('VL_IPI').AsCurrency;
        VL_PIS        := qryRegistroC100.fieldbyname('VL_PIS').AsCurrency;
        VL_COFINS     := qryRegistroC100.fieldbyname('VL_COFINS').AsCurrency;
        VL_PIS_ST     := qryRegistroC100.fieldbyname('VL_PIS_ST').AsCurrency;
        VL_COFINS_ST  := qryRegistroC100.fieldbyname('VL_COFINS_ST').AsCurrency;


        if (qryRegistroC100.fieldbyname('COD_MOD').AsString='55') and
           (qryRegistroC100.fieldbyname('IND_EMIT').AsString='0') then
        begin
          P_RegistroC190;
          P_RegistroC195;
        end
        else
        begin
          P_RegistroC110;
          P_RegistroC120;
          P_RegistroC130;
          P_RegistroC140;
          P_RegistroC160;
          P_RegistroC165;
          P_RegistroC170;
          P_RegistroC190;
          P_RegistroC195;
        end;
      end;

    end;
    qryRegistroC100.Next;
  end;
end;



procedure TdtmEFD.P_Registro0005;
{----------------------------------------------------------------------------
REGISTRO 0005: DADOS COMPLEMENTARES DA ENTIDADE
-----------------------------------------------------------------------------
Nº	Campo	 Descrição	                        Tipo	Tam	Dec
01	REG	 Texto fixo contendo "0005"	        C	004	-
02	FANTASIA Nome de fantasia associado
                       ao nome empresarial.	        C	060	-
03	CEP	 Código de Endereçamento Postal.	N	008*	-
04	END	 Logradouro e endereço do imóvel.	C	060	-
05	NUM	 Número do imóvel.	                C	-	-
06	COMPL	 Dados complementares do endereço.	C	060	-
07	BAIRRO	 Bairro em que o imóvel está situado.	C	060	-
08	FONE	 Número do telefone.	                C	10*	-
09	FAX	 Número do fax.	                        C	10*	-
10	EMAIL	 Endereço do correio eletrônico.	C	-	-
-----------------------------------------------------------------------------}
begin
  with ACBrSPEDFiscal.Bloco_0.Registro0005New do
  begin
    FANTASIA := NomeFilialBase;
    CEP      := CEPFilialBase;
    ENDERECO := trim(RuaFilialBase);
    NUM      := NumeroFilialBase;
    COMPL    := ComplementoFilialBase;
    BAIRRO   := BairroFilialBase;
    FONE     := copy((trim(DDDFilialBase)+trim(FoneFilialBase)),1,10);
    FAX      := copy((trim(DDDFaxFilialBase)+trim(FaxFilialBase)),1,10);
    EMAIL    := ParSistema.EmailEmpresa;
  end;
end;


procedure TdtmEFD.P_Registro0015;
{-----------------------------------------------------------------------------
REGISTRO 0015: DADOS DO CONTRIBUINTE SUBSTITUTO
-----------------------------------------------------------------------------
Nº	Campo	Descrição	                Tipo	Tam	Dec
-----------------------------------------------------------------------------
01	REG	Texto fixo contendo "0015"	C	004	-
02	UF_ST	Sigla da unidade da federação
              do contribuinte substituído	C	002*	-
03	IE_ST	Inscrição Estadual de
              contribuinte substituto na
              unidade da federação do
              contribuinte substituído	C	014	-
-----------------------------------------------------------------------------
Nível hierárquico - 2
Ocorrência - vários (por arquivo)
-----------------------------------------------------------------------------}
begin
  RefazConsultaPorNome(qryRegistro0015,['cliente'],[ParSistema.filial]);
  qryRegistro0015.First;
  while not qryRegistro0015.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_0.Registro0015New do
    begin
      UF_ST := qryRegistro0015.fieldbyname('estado').AsString;
      IE_ST := qryRegistro0015.fieldbyname('inscricaoestadual').AsString;
    end;
    qryRegistro0015.Next;
  end;
end;

procedure TdtmEFD.P_Registro0100;
{REGISTRO 0100: DADOS DO CONTABILISTA
------------------------------------------------------------------------------
Nº	Campo	Descrição	                Tipo	Tam	Dec
------------------------------------------------------------------------------
01	REG	Texto fixo contendo "0100".	C	004	-
02	NOME	Nome do contabilista.	        C	100	-
03	CPF	Número de inscrição do
                contabilista no CPF.	        N	011*	-
04	CRC	Número de inscrição do
                contabilista no Conselho
                Regional de Contabilidade.	C	015	-
05	CNPJ	Número de inscrição do
                escritório de contabilidade no
                CNPJ, se houver.	        N	014*	-
06	CEP	Código de Endereçamento Postal.	N	008*	-
07	END	Logradouro e endereço do imóvel	C	060	-
08	NUM	Número do imóvel.	        C	-	-
09	COMPL	Dados complementares do endereço.	C	060	-
10	BAIRRO	Bairro em que o imóvel está
                situado.	                C	060	-
11	FONE	Número do telefone.	        C	10*	-
12	FAX	Número do fax.	                C	10*	-
13	EMAIL	Endereço do correio eletrônico.	C	-	-
14	COD_MUN	Código do município, conforme
                tabela IBGE.	                N	007*	-
------------------------------------------------------------------------------
  Observações: Registro obrigatório
Nível hierárquico - 2
Ocorrência - um (por arquivo)
-----------------------------------------------------------------------------}
begin
  with ACBrSPEDFiscal.Bloco_0.Registro0100New do
  begin
    NOME    := copy(trim(parsistema.NomeContador),1,60);  /// Nome do contabilista/escritório:
    CPF     := copy(trim(parsistema.CPFContador),1,11);   /// Número de inscrição no CPF:
    CRC     := copy(trim(parsistema.CRCContador),1,15);   /// Número de inscrição no Conselho Regional:
    CNPJ    := '';                                        /// CNPJ do escritório de contabilidade, se houver:
    CEP     := format('%8.8d', [strtoint(CEPFilialBase)]);/// Código de Endereçamento Postal:
    ENDERECO:= trim(copy(trim(RuaFilialBase),1,60));            /// Logradouro e endereço do imóvel:
    NUM     := trim(NumeroFilialBase);                    /// Número do imóvel:
    COMPL   := copy(trim(ComplementoFilialBase),1,60);    /// Dados complementares do endereço:
    BAIRRO  := copy(trim(BairroFilialBase),1,60);         /// Bairro em que o imóvel está situado:
    FONE    := copy((inttostr(parsistema.DDDContador)+
               inttostr(parsistema.TeleFoneContador)),1,10); /// Número do telefone:
    FAX     := copy((trim(DDDFaxFilialBase)+trim(FaxFilialBase)),1,10); /// Número do fax:
    EMAIL   := ParSistema.EmailContador;                  /// Endereço do correio eletrônico:
    COD_MUN := strtoint(CodigoCidadeIBGEFilialBase);  /// Código do município, conforme tabela IBGE:
  end;
end;

procedure TdtmEFD.P_Registro0150;
{REGISTRO 0150: TABELA DE CADASTRO DO PARTICIPANTE
----------------------------------------------------------------------------
Nº	Campo	Descrição	                        Tipo	Tam	Dec
----------------------------------------------------------------------------
01	REG	 Texto fixo contendo "0150".	        C	004	-
02	COD_PART Código de identificação do
                 participante no arquivo.	        C	060	-
03	NOME	 Nome pessoal ou empresarial do
                 participante.	                C	100	-
04	COD_PAIS Código do país do participante,
                 conforme a tabela indicada no
                 item 3.2.1	                        N       005	-
05	CNPJ	 CNPJ do participante.	                N	014*	-
06	CPF	 CPF do participante.	                N	011*	-
07	IE	 Inscrição Estadual do participante.	C	014	-
08	COD_MUN	 Código do município, conforme a
                 tabela IBGE	                N	007*	-
09	SUFRAMA	 Número de inscrição do participante na
                 Suframa.	                        C	009*	-
10	END	 Logradouro e endereço do imóvel	C	060	-
11	NUM	 Número do imóvel	C	-	-
12	COMPL	 Dados complementares do endereço	C	060	-
13	BAIRRO	 Bairro em que o imóvel está situado	C	060	-
----------------------------------------------------------------------------
Nível hierárquico - 2
Ocorrência - vários (por arquivo)

----------------------------------------------------------------------------}
begin
  RefazConsultaPorNome(qryRegistro0150,
    ['datainicial','datafinal','filial'],[datainicial,datafinal,qryEFDFilial.asinteger]);
  qryRegistro0150.First;
  while not qryRegistro0150.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_0.Registro0150New do
    begin
      COD_PART := qryRegistro0150.fieldbyname('cod_part').asstring ; /// Código de identificação do participante:
      NOME     := qryRegistro0150.fieldbyname('nome')    .asstring ; /// Nome pessoal ou empresarial:
      COD_PAIS := qryRegistro0150.fieldbyname('cod_pais').asstring ; /// Código do país do participante:
      CNPJ     := somentenumero(qryRegistro0150.fieldbyname('cnpj').asstring) ; /// CNPJ do participante:
      CPF      := qryRegistro0150.fieldbyname('cpf')     .asstring ; /// CPF do participante na unidade da federação do destinatário:
      IE       := copy(SomenteNumero(qryRegistro0150.fieldbyname('ie').asstring),1,14) ; /// Inscrição Estadual do participante:

      COD_MUN  := qryRegistro0150.fieldbyname('cod_mun') .AsInteger ; /// Código do município:
      SUFRAMA  := qryRegistro0150.fieldbyname('suframa') .asstring ; /// Número de inscrição na Suframa:
      ENDERECO := trim(qryRegistro0150.fieldbyname('end')     .asstring) ; /// Logradouro e endereço do imóvel:
      NUM      := qryRegistro0150.fieldbyname('num')     .asstring ; /// Número do imóvel:
      COMPL    := trim(copy(trim(qryRegistro0150.fieldbyname('compl').asstring),1,60)) ; /// Dados complementares do endereço:
      BAIRRO   := qryRegistro0150.fieldbyname('bairro')  .asstring ; /// Bairro em que o imóvel está situado:
    end;
    qryRegistro0150.Next;
  end;
end;

