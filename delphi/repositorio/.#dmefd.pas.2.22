36 VL_COFINS	Valor da COFINS	                        N	-	02
37 COD_CTA	Código da conta analítica contábil
                debitada/creditada	                C	-	-
--------------------------------------------------------------------------------
Nível hierárquico - 3
Ocorrência - 1:N
--------------------------------------------------------------------------------
}
{**********
var kemper: integer;
***********}

begin
  qryRegistroC170.First;
  while not qryRegistroC170.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC170New do
    begin
      if qryRegistroC170.fieldbyname('NUM_ITEM').IsNull then
        NUM_ITEM      := qryRegistroC170.fieldbyname('NUM_ITEM').asstring
      else
        NUM_ITEM      := inttostr(qryRegistroC170.recno);

      COD_ITEM        := qryRegistroC170.fieldbyname('COD_ITEM').asstring;
      DESCR_COMPL     := trim(qryRegistroC170.fieldbyname('DESCR_COMPL').asstring);
{**********
      if COD_ITEM = 'P13170108'
      then begin
         kemper:= FLVal(Copy(COD_ITEM,2,8));
         COD_ITEM:= 'P' + FStr(Kemper,$81);
      end;
{**********}
      QTD             := qryRegistroC170.fieldbyname('QTD').AsCurrency;
      UNID            := qryRegistroC170.fieldbyname('UNID').asstring;
      VL_ITEM         := qryRegistroC170.fieldbyname('VL_ITEM').AsCurrency;
      VL_DESC         := qryRegistroC170.fieldbyname('VL_DESC').AsCurrency;
      IND_MOV         := MovimentacaoFisica(qryRegistroC170.fieldbyname('IND_MOV').AsInteger);
      CST_ICMS        := preencheString(trim(qryRegistroC170.fieldbyname('CST_ICMS').asstring),'0',3,false);
      CFOP            := qryRegistroC170.fieldbyname('CFOP').asstring;
      COD_NAT         := qryRegistroC170.fieldbyname('COD_NAT').asstring;
      VL_BC_ICMS      := qryRegistroC170.fieldbyname('VL_BC_ICMS').AsCurrency;
      ALIQ_ICMS       := qryRegistroC170.fieldbyname('ALIQ_ICMS').AsCurrency;
      VL_ICMS         := qryRegistroC170.fieldbyname('VL_ICMS').AsCurrency;
      VL_BC_ICMS_ST   := qryRegistroC170.fieldbyname('VL_BC_ICMS_ST').AsCurrency;
      ALIQ_ST         := qryRegistroC170.fieldbyname('ALIQ_ST').AsCurrency;
      VL_ICMS_ST      := qryRegistroC170.fieldbyname('VL_ICMS_ST').AsCurrency;
      IND_APUR        := ApuracaoIPI(qryRegistroC170.fieldbyname('IND_APUR').AsInteger);
      CST_IPI         := qryRegistroC170.fieldbyname('CST_IPI').asstring;
//        COD_ENQ         := qryRegistroC170.fieldbyname('COD_ENQ').asstring; {ainda não definida pelo governo}
      VL_BC_IPI       := qryRegistroC170.fieldbyname('VL_BC_IPI').AsCurrency;
      ALIQ_IPI        := qryRegistroC170.fieldbyname('ALIQ_IPI').AsCurrency;
      VL_IPI          := qryRegistroC170.fieldbyname('VL_IPI').AsCurrency;
      CST_PIS         := qryRegistroC170.fieldbyname('CST_PIS').asstring;
      VL_BC_PIS       := qryRegistroC170.fieldbyname('VL_BC_PIS').AsCurrency;
      ALIQ_PIS_PERC   := qryRegistroC170.fieldbyname('ALIQ_PIS_PERC').AsCurrency;
      QUANT_BC_PIS    := qryRegistroC170.fieldbyname('QUANT_BC_PIS').AsCurrency;
      ALIQ_PIS_R      := qryRegistroC170.fieldbyname('ALIQ_PIS_R').AsCurrency;
      VL_PIS          := qryRegistroC170.fieldbyname('VL_PIS').AsCurrency;
      CST_COFINS      := qryRegistroC170.fieldbyname('CST_COFINS').asstring;
      VL_BC_COFINS    := qryRegistroC170.fieldbyname('VL_BC_COFINS').AsCurrency;
      ALIQ_COFINS_PERC:= qryRegistroC170.fieldbyname('ALIQ_COFINS_PERC').AsCurrency;
      QUANT_BC_COFINS := qryRegistroC170.fieldbyname('QUANT_BC_COFINS').AsCurrency;
      ALIQ_COFINS_R   := qryRegistroC170.fieldbyname('ALIQ_COFINS_R').AsCurrency;
      VL_COFINS       := qryRegistroC170.fieldbyname('VL_COFINS').AsCurrency;
      COD_CTA         := qryRegistroC170.fieldbyname('COD_CTA').asstring;

      P_RegistroC172;

    end;
    qryRegistroC170.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC172;
{
--------------------------------------------------------------------------------
REGISTRO C172: OPERAÇÕES COM ISSQN (CÓDIGO 01)
--------------------------------------------------------------------------------
Nº Campo	Descrição	                        Tipo	Tam	Dec
01 REG	        Texto fixo contendo "C172"	        C	004	-
02 VL_BC_ISSQN	Valor da base de cálculo do ISSQN	N	-	02
03 ALIQ_ISSQN	Alíquota do ISSQN	                N	006	02
04 VL_ISSQN	Valor do ISSQN	                        N	-	02
--------------------------------------------------------------------------------
Nível hierárquico - 4
Ocorrência - 1:1
--------------------------------------------------------------------------------
}
begin
  qryRegistroC172.First;
  while not qryRegistroC172.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC172New do
    begin
      VL_BC_ISSQN := qryRegistroC172.fieldbyname('VL_BC_ISSQN').AsCurrency;
      ALIQ_ISSQN  := qryRegistroC172.fieldbyname('ALIQ_ISSQN').AsCurrency;
      VL_ISSQN    := qryRegistroC172.fieldbyname('VL_ISSQN').AsCurrency;
    end;
    qryRegistroC172.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC190;
{
--------------------------------------------------------------------------------
REGISTRO C190: REGISTRO ANALÍTICO DO DOCUMENTO (CÓDIGO 01, 1B, 04 E 55)
--------------------------------------------------------------------------------
Nº Campo	Descrição	                        Tipo	Tam	Dec
--------------------------------------------------------------------------------
01 REG	         Texto fixo contendo "C190"	        C	004	-
02 CST_ICMS	 Código da Situação Tributária, conforme
                 a Tabela indicada no item 4.3.1	        N	003*	-
03 CFOP	         Código Fiscal de Operação e Prestação
                 do agrupamento de itens	                N	004*	-
04 ALIQ_ICMS	 Alíquota do ICMS	                N	006	02
05 VL_OPR	 Valor da operação na combinação de
                 CST_ICMS, CFOP e alíquota do ICMS,
                 correspondente ao somatório do valor
                 das mercadorias, despesas acessórias
                 (frete, seguros e outras despesas acessórias),
                 ICMS_ST  e IPI	                        N	-	02
06 VL_BC_ICMS	 Parcela correspondente ao "Valor da base de cálculo do ICMS"
                 referente à combinação de CST_ICMS, CFOP e alíquota do ICMS.
                                                        N	-	02
07 VL_ICMS	 Parcela correspondente ao "Valor do ICMS" referente à combinação
                 de CST_ICMS, CFOP e alíquota do ICMS.	N	-	02
08 VL_BC_ICMS_ST Parcela correspondente ao "Valor da base de cálculo do ICMS"
                 da substituição tributária referente à combinação de CST_ICMS,
                 CFOP e alíquota do ICMS.	        N	-	02
09 VL_ICMS_ST	 Parcela correspondente ao valor creditado/debitado do ICMS
                 da substituição tributária, referente à combinação de CST_ICMS,
                 CFOP, e alíquota do ICMS.	        N	-	02
10 VL_RED_BC	 Valor não tributado em função da redução da base de cálculo do
                 ICMS, referente à combinação de CST_ICMS, CFOP e alíquota do ICMS.
                                                        N	-	02
11 VL_IPI	 Parcela correspondente ao "Valor do IPI" referente à combinação
                 CST_ICMS, CFOP e alíquota do ICMS.	N	-	02
--------------------------------------------------------------------------------
Nível hierárquico - 3
Ocorrência - 1:N
--------------------------------------------------------------------------------
}
begin
  qryRegistroC190.First;
  while not qryRegistroC190.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC190New do
    begin
      CST_ICMS      := preencheString(trim(qryRegistroC190.fieldbyname('CST_ICMS').asstring),'0',3,false);
      if qryRegistroC100.fieldbyname('cod_sit').AsString = '08' then
      begin
        CFOP          := copy(qryRegistroC190.fieldbyname('CFOP').asString,1,1)+'929';
        ALIQ_ICMS     := 0.00;
        VL_OPR        := qryRegistroC190.fieldbyname('VL_OPR').ascurrency;
        VL_BC_ICMS    := 0.00;
        VL_ICMS       := 0.00;
        VL_BC_ICMS_ST := 0.00;
        VL_ICMS_ST    := 0.00;
        VL_RED_BC     := 0.00;
        VL_IPI        := 0.00;
      end
      else
      begin
        CFOP          := qryRegistroC190.fieldbyname('CFOP').asString;
        ALIQ_ICMS     := qryRegistroC190.fieldbyname('ALIQ_ICMS').ascurrency;
        VL_OPR        := qryRegistroC190.fieldbyname('VL_OPR').ascurrency;
        VL_BC_ICMS    := qryRegistroC190.fieldbyname('VL_BC_ICMS').ascurrency;
        VL_ICMS       := qryRegistroC190.fieldbyname('VL_ICMS').ascurrency;
        VL_BC_ICMS_ST := qryRegistroC190.fieldbyname('VL_BC_ICMS_ST').ascurrency;
        VL_ICMS_ST    := qryRegistroC190.fieldbyname('VL_ICMS_ST').ascurrency;
        VL_RED_BC     := qryRegistroC190.fieldbyname('VL_RED_BC').ascurrency;
        VL_IPI        := qryRegistroC190.fieldbyname('VL_IPI').ascurrency;
     end;

      {Se for saida}
      if qryRegistroC100.fieldbyname('IND_OPER').AsString = ctOPERSAIDA then
        if qryRegistroC100.fieldbyname('cod_sit').AsString <> '08' then {O DÉBITO JÁ ESTA NO CUPOM FISCAL}
          {Se não for nota saida transf icms}
          if (CFOP <> ctTRANSFICMS) then
            FRegistroE110_VL_TOT_DEBITOS := FRegistroE110_VL_TOT_DEBITOS + VL_ICMS;

      {Se for entrada}
      if qryRegistroC100.fieldbyname('IND_OPER').AsString = ctOPERENTRADA then
        FRegistroE110_VL_TOT_CREDITOS := FRegistroE110_VL_TOT_CREDITOS + VL_ICMS;

    end;
    qryRegistroC190.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC195;
{
--------------------------------------------------------------------------------
REGISTRO C195: OBSERVAÇOES DO LANÇAMENTO FISCAL(CÓDIGO 01, 1B E 55)
--------------------------------------------------------------------------------
Nº Campo     Descrição	                                Tipo	Tam	Dec
--------------------------------------------------------------------------------
01 REG	     Texto fixo contendo "C195"	                C	004	-
02 COD_OBS   Código da observação do lançamento
             fiscal (campo 02 do Registro 0460)	        C	006	-
03 TXT_COMPL Descrição complementar do código de obser
             vação.	                                C	-	-
--------------------------------------------------------------------------------
Nível hierárquico - 3
Ocorrência - 1:N
--------------------------------------------------------------------------------
}
begin
  qryRegistroC195.First;
  while not qryRegistroC195.Eof do
  begin
    if qryRegistro0460.Locate('txt',qryRegistroC195txt_compl.AsString,[]) then
    begin
      with ACBrSPEDFiscal.bloco_c.RegistroC195new do
      begin
        COD_OBS   := IntToStr(qryRegistro0460.RecNo);
        TXT_COMPL := qryRegistro0460txt.AsString;
        P_RegistroC197;
      end;
    end
    else
      MensagemErro('Inconssistência: Registro0460 x REgistroC195'+#10#13+
                   'Descrição não encontrada: '+qryRegistroC195txt_compl.AsString);

    qryRegistroC195.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC400;
{
--------------------------------------------------------------------------------
REGISTRO C400 - EQUIPAMENTO ECF (CÓDIGO 02 E 2D)
--------------------------------------------------------------------------------
Nº Campo    Descrição	                                Tipo	Tam	Dec
--------------------------------------------------------------------------------
01 REG	    Texto fixo contendo "C400"	                C	004	-
02 COD_MOD  Código do modelo do documento fiscal,
            conforme a Tabela 4.1.1	                C	002*	-
03 ECF_MOD  Modelo do equipamento	                C	020	-
04 ECF_FAB  Número de série de fabricação do ECF	C	020	-
05 ECF_CX   Número do caixa atribuído ao ECF	        N	003	-
--------------------------------------------------------------------------------
Nível hierárquico - 2
Ocorrência - 1:N
--------------------------------------------------------------------------------

}
begin
  RefazConsultaPorNome(qryRegistroC400,['datainicial','datafinal','filial'],
                                [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroC405,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

      RefazConsultaPorNome(qryRegistroC420,
                           ['datainicial','datafinal','filial'],
                           [datainicial,datafinal,qryEFDFilial.asinteger]);

        RefazConsultaPorNome(qryRegistroC425,
                             ['datainicial','datafinal','filial'],
                             [datainicial,datafinal,qryEFDFilial.asinteger]);

      RefazConsultaPorNome(qryRegistroC460,
                           ['datainicial','datafinal','filial'],
                           [datainicial,datafinal,qryEFDFilial.asinteger]);

        RefazConsultaPorNome(qryRegistroC470,
                             ['datainicial','datafinal','filial'],
                             [datainicial,datafinal,qryEFDFilial.asinteger]);

      RefazConsultaPorNome(qryRegistroC490,
                           ['datainicial','datafinal','filial'],
                           [datainicial,datafinal,qryEFDFilial.asinteger]);


  qryRegistroC400.First;
  while not qryRegistroC400.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_C.RegistroC400New do
    begin
      COD_MOD := qryRegistroC400.fieldbyname('COD_MOD').AsString;
      ECF_MOD := qryRegistroC400.fieldbyname('ECF_MOD').AsString;
      ECF_FAB := qryRegistroC400.fieldbyname('ECF_FAB').AsString;
      ECF_CX  := format('%3.3d',[strtoint(qryRegistroC400.fieldbyname('ecf_cx').AsString)]);
      P_RegistroC405;
    end;
    qryRegistroC400.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC500;
begin
  RefazConsultaPorNome(qryRegistroC500,
                       ['datainicial','datafinal','filial'],
                       [datainicial,datafinal,qryEFDFilial.asinteger]);


    RefazConsultaPorNome(qryRegistroC590,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);


  qryRegistroC500.First;
  while not qryRegistroC500.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_C.RegistroC500new do
    begin
      IND_OPER      := Operacao(qryRegistroC500.fieldbyname('IND_OPER').AsInteger);
      IND_EMIT      := Emitente(qryRegistroC500.fieldbyname('IND_EMIT').AsInteger);
      COD_PART      := qryRegistroC500.fieldbyname('COD_PART').AsString;
      COD_MOD       := qryRegistroC500.fieldbyname('COD_MOD').AsString;
      COD_SIT       := SituacaoDocto(qryRegistroC500.fieldbyname('COD_SIT').AsString);
      SER           := qryRegistroC500.fieldbyname('SER').AsString;
      SUB           := qryRegistroC500.fieldbyname('SUB').AsString;
      COD_CONS      := {ClasseConsumo(qryRegistroC500.fieldbyname('COD_CONS').AsString);} qryRegistroC500.fieldbyname('COD_CONS').AsString;

      NUM_DOC       := qryRegistroC500.fieldbyname('NUM_DOC').AsString;
      DT_DOC        := qryRegistroC500.fieldbyname('DT_DOC').asDateTime;

      if qryRegistroC100.fieldbyname('DT_E_S').AsDateTime <= DataFinal then
        DT_E_S        := qryRegistroC500.fieldbyname('DT_E_S').asDateTime;

      VL_DOC        := qryRegistroC500.fieldbyname('VL_DOC').ascurrency;
      VL_DESC       := qryRegistroC500.fieldbyname('VL_DESC').ascurrency;
      VL_FORN       := qryRegistroC500.fieldbyname('VL_FORN').ascurrency;
      VL_SERV_NT    := qryRegistroC500.fieldbyname('VL_SERV_NT').ascurrency ;
      VL_TERC       := qryRegistroC500.fieldbyname('VL_TERC').ascurrency;
      VL_DA         := qryRegistroC500.fieldbyname('VL_DA').ascurrency;
      VL_BC_ICMS    := qryRegistroC500.fieldbyname('VL_BC_ICMS').ascurrency;
      VL_ICMS       := qryRegistroC500.fieldbyname('VL_ICMS').ascurrency;
      VL_BC_ICMS_ST := qryRegistroC500.fieldbyname('VL_BC_ICMS_ST').ascurrency;
      VL_ICMS_ST    := qryRegistroC500.fieldbyname('VL_ICMS_ST').ascurrency;
//      COD_INF       := qryRegistroC500.fieldbyname('COD_INF').AsString;
      VL_PIS        := qryRegistroC500.fieldbyname('VL_PIS').ascurrency;
      VL_COFINS     := qryRegistroC500.fieldbyname('VL_COFINS').ascurrency;
//        TP_LIGACAO := qryRegistroC500.fieldbyname('').       AnsiString read fTP_LIGACAO       write fTP_LIGACAO;
//        COD_GRUPO_TENSAO := qryRegistroC500.fieldbyname(''). AnsiString read fCOD_GRUPO_TENSAO write fCOD_GRUPO_TENSAO;

      P_RegistroC590;

    end;
    qryRegistroC500.Next;
  end;

end;

procedure TdtmEFD.P_RegistroC590;
{
--------------------------------------------------------------------------------
REGISTRO C590: REGISTRO ANALÍTICO DO DOCUMENTO - NOTA FISCAL/CONTA DE ENERGIA
ELÉTRICA (CÓDIGO 06), NOTA FISCAL/CONTA DE FORNECIMENTO D'ÁGUA CANALIZADA
(CÓDIGO 29) E NOTA FISCAL CONSUMO FORNECIMENTO DE GÁS (CÓDIGO 28)
--------------------------------------------------------------------------------
Nº Campo	  Descrição	                        Tipo	Tam	Dec
--------------------------------------------------------------------------------
01 REG	          Texto fixo contendo "C590"	        C	004	-
02 CST_ICMS	  Código da Situação Tributária,
                  conforme a Tabela indicada no item
                  4.3.1.	                        N	003*	-
03 CFOP	          Código Fiscal de Operação e Prestação
                  do agrupamento de itens	        N	004*	-
04 ALIQ_ICMS	  Alíquota do ICMS	                N	006	02
05 VL_OPR 	  Valor da operação correspondente à
                  combinação de CST_ICMS, CFOP, e
                  alíquota do ICMS.	                N	-	02
06 VL_BC_ICMS	  Parcela correspondente ao "Valor da
                  base de cálculo do ICMS" referente à
                  combinação de CST_ICMS, CFOP e
                  alíquota do ICMS.	                N	-	02
07 VL_ICMS	  Parcela correspondente ao "Valor do
                  ICMS" referente à combinação de
                  CST_ICMS, CFOP e alíquota do ICMS.	N	-	02
08 VL_BC_ICMS_ST  Parcela correspondente ao "Valor da
                  base de cálculo do ICMS" da substituição
                  tributária referente à combinação de
                  CST_ICMS, CFOP e alíquota do ICMS.	N	-	02
09 VL_ICMS_ST	  Parcela correspondente ao valor
                  creditado/debitado do ICMS da
                  substituição tributária, referente à
                  combinação de CST_ICMS,  CFOP, e
                  alíquota do ICMS.	                N	-	02
10 VL_RED_BC	  Valor não tributado em função da
                  redução da base de cálculo do ICMS,
                  referente à combinação de CST_ICMS,
                  CFOP e alíquota do ICMS.	        N	-	02
11 COD_OBS	  Código da observação do lançamento
                  fiscal (campo 02 do Registro 0460)	C	006	-
--------------------------------------------------------------------------------
Nível hierárquico - 3
Ocorrência - 1:N
--------------------------------------------------------------------------------
}
begin
  qryRegistroC590.First;
  while not qryRegistroC590.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC590new do
    begin
      CST_ICMS     := preencheString(trim(qryRegistroC590.fieldbyname('CST_ICMS').asstring),'0',3,false);
      CFOP         := qryRegistroC590.fieldbyname('CFOP').AsString;
      ALIQ_ICMS    := qryRegistroC590.fieldbyname('ALIQ_ICMS').AsCurrency;
      VL_OPR       := qryRegistroC590.fieldbyname('VL_OPR').AsCurrency;
      VL_BC_ICMS   := qryRegistroC590.fieldbyname('VL_BC_ICMS').AsCurrency;
      VL_ICMS      := qryRegistroC590.fieldbyname('VL_ICMS').AsCurrency;
      VL_BC_ICMS_ST:= qryRegistroC590.fieldbyname('VL_BC_ICMS_ST').AsCurrency;
      VL_ICMS_ST   := qryRegistroC590.fieldbyname('VL_ICMS_ST').AsCurrency;
//      VL_RED_BC    := qryRegistroC590.fieldbyname('VL_RED_BC').AsCurrency;
//      COD_OBS      := AnsiString read fCOD_OBS write fCOD_OBS;


      {Só temos entrada neste caso}
      if qryRegistroC500.fieldbyname('IND_OPER').AsString = ctOPERENTRADA then
        FRegistroE110_VL_TOT_CREDITOS := FRegistroE110_VL_TOT_CREDITOS + VL_ICMS;

    end;
    qryRegistroC590.Next;
  end;
end;

procedure TdtmEFD.Bloco_D;
begin
  P_RegistroD001; //ABERTURA DO BLOCO D
  P_RegistroD100;
  P_RegistroD500;
end;

procedure TdtmEFD.P_RegistroD100;
{
REGISTRO D100:
NOTA FISCAL DE SERVIÇO DE TRANSPORTE (CÓDIGO 07) E
CONHECIMENTOS DE TRANSPORTE RODOVIÁRIO DE CARGAS (CÓDIGO 08),
CONHECIMENTO DE TRANSPORTE DE CARGAS AVULSO (CÓDIGO 8B),
AQUAVIÁRIO DE CARGAS (CÓDIGO 09),
AÉREO (CÓDIGO 10),
FERROVIÁRIO DE CARGAS (CÓDIGO 11),
MULTIMODAL DE CARGAS (CÓDIGO 26),
NOTA FISCAL DE TRANSPORTE FERROVIÁRIO DE CARGA (CÓDIGO 27) E
CONHECIMENTO DE TRANSPORTE ELETRÔNICO - CT-e (CÓDIGO 57)
--------------------------------------------------------------------------------
Nº Campo        Descrição	                       Tipo	Tam	Dec
--------------------------------------------------------------------------------
01 REG	        Texto fixo contendo "D100"	        C	004	-
02 IND_OPER	Indicador do tipo de operação:
                0- Aquisição;
                1- Prestação	                        C	001*	-
03 IND_EMIT	Indicador do emitente do documento fiscal:
                0- Emissão própria;
                1- Terceiros	                        C	001*	-
04 COD_PART	Código do participante (campo 02 do
                Registro 0150):
                - do prestador de serviço, no caso de
                aquisição de serviço;
                - do tomador do serviço, no caso de
                prestação de serviços.	                C	060	-
05 COD_MOD	Código do modelo do documento fiscal,
                conforme a Tabela 4.1.1 	        C	002*	-
06 COD_SIT	Código da situação do documento fiscal,
                conforme a Tabela 4.1.2	                N	002*	-
07 SER	        Série do documento fiscal	        C	004	-
08 SUB	        Subsérie do documento fiscal	        C	003	-
09 NUM_DOC	Número do documento fiscal	        N	009	-
10 CHV_CTE	Chave do Conhecimento de Transporte
                Eletrônico	                        N	044*	-
11 DT_DOC	Data da emissão do documento fiscal	N	008*	-
12 DT_A_P	Data da aquisição ou da prestação do
                serviço	                                N	008*	-
13 TP_CT-e	Tipo de Conhecimento de Transporte
                Eletrônico conforme definido no Manual
                de Integração do CT-e	                N	001*	-
14 CHV_CTE_REF	Chave do CT-e de referência cujos
                valores foram complementados (opção "1"
                do campo anterior) ou cujo débito foi
                anulado(opção "2" do campo anterior). 	N	044*	-
15 VL_DOC	Valor total do documento fiscal	        N	-	02
16 VL_DESC	Valor total do desconto	                N	-	02
17 IND_FRT	Indicador do tipo do frete:
                0- Por conta de terceiros;
                1- Por conta do emitente;
                2- Por conta do destinatário;
                9- Sem cobrança de frete.	        C	001*	-
18 VL_SERV	Valor total da prestação de serviço	N	-	02
19 VL_BC_ICMS	Valor da base de cálculo do ICMS	N	-	02
20 VL_ICMS	Valor do ICMS	                        N	-	02
21 VL_NT	Valor não-tributado	                N	-	02
22 COD_INF	Código da informação complementar do
                documento fiscal (campo 02 do Registro
                0450)	                                C	006	-
23 COD_CTA	Código da conta analítica contábil
                debitada/creditada	                C	-	-
--------------------------------------------------------------------------------
Nível hierárquico - 2
Ocorrência - vários (por arquivo)
--------------------------------------------------------------------------------
}
begin
  RefazConsultaPorNome(qryRegistroD100,
                       ['datainicial','datafinal','filial'],
                       [datainicial,datafinal,qryEFDFilial.asinteger]);

    RefazConsultaPorNome(qryRegistroD190,
                         ['datainicial','datafinal','filial'],
                         [datainicial,datafinal,qryEFDFilial.asinteger]);

  if qryRegistroD100.IsEmpty then
    ACBrSPEDFiscal.Bloco_D.RegistroD001.IND_MOV := imSemDados;

  qryRegistroD100.First;
  while not qryRegistroD100.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_D.RegistroD100New do
    begin
      IND_OPER := Operacao(qryRegistroD100.fieldbyname('IND_OPER').AsInteger);
      IND_EMIT := Emitente(qryRegistroD100.fieldbyname('IND_EMIT').AsInteger);
      COD_PART := qryRegistroD100.fieldbyname('COD_PART').AsString;
      COD_MOD  := qryRegistroD100.fieldbyname('COD_MOD').AsString;
      COD_SIT  := SituacaoDocto(qryRegistroD100.fieldbyname('COD_SIT').AsString);
      SER      := qryRegistroD100.fieldbyname('SER').AsString;
      SUB      := qryRegistroD100.fieldbyname('SUB').AsString;
      NUM_DOC  := qryRegistroD100.fieldbyname('NUM_DOC').AsString;
      CHV_CTE  := qryRegistroD100.fieldbyname('CHV_CTE').AsString;
      DT_DOC   := qryRegistroD100.fieldbyname('DT_DOC').asDateTime;
      DT_A_P   := qryRegistroD100.fieldbyname('DT_DOC').asDateTime;
      TP_CT_e  := qryRegistroD100.fieldbyname('TP_CTe').AsString;
      CHV_CTE_REF := qryRegistroD100.fieldbyname('CHV_CTE_REF').AsString;
      VL_DOC        := qryRegistroD100.fieldbyname('VL_DOC').ascurrency;
      VL_DESC       := qryRegistroD100.fieldbyname('VL_DESC').ascurrency;

      if qryRegistroD100.fieldbyname('IND_FRT').IsNull then
        IND_FRT := tfNenhum
      else
        IND_FRT := TipoFrete(qryRegistroD100.fieldbyname('IND_FRT').AsInteger);

      VL_SERV := qryRegistroD100.fieldbyname('VL_SERV').ascurrency;

      VL_BC_ICMS := qryRegistroD100.fieldbyname('VL_BC_ICMS').ascurrency;
      VL_ICMS := qryRegistroD100.fieldbyname('VL_ICMS').ascurrency;
      VL_NT := qryRegistroD100.fieldbyname('VL_NT').ascurrency;

      if qryRegistroD100txt.AsString<>'' then
      begin
        if qryRegistro0450.Locate('txt',qryRegistroD100txt.AsString,[]) then
          COD_INF := inttostr(qryRegistro0450.RecNo)
        else
          MensagemErro('Inconssistência: Registro0450 x REgistroD100'+#10#13+
                       'Descrição não encontrada: '+qryRegistroD100txt.AsString);
      end;
//      COD_CTA: String;

      P_RegistroD190;
    end;
    qryRegistroD100.Next;
  end;

end;

procedure TdtmEFD.P_RegistroC405;
begin
  qryRegistroC405.First;
  while not qryRegistroC405.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC405new do
    begin
      DT_DOC      := qryRegistroC405dt_doc.AsDateTime;      /// Data do movimento a que se refere a Redução Z
      CRO         := qryRegistroC405cro.AsInteger;          /// Posição do Contador de Reinício de Operação
      CRZ         := qryRegistroC405crz.AsInteger;          /// Posição do Contador de Redução Z
      NUM_COO_FIN := qryRegistroC405num_coo_fin.AsInteger;  /// Número do Contador de Ordem de Operação do último documento emitido no dia. (Número do COO na Redução Z)
      GT_FIN      := qryRegistroC405gt_fin.AsCurrency;      /// Valor do Grande Total final
      VL_BRT      := qryRegistroC405vl_brt.AsCurrency;      /// Valor da venda bruta

      P_RegistroC410;  {PIS E COFINS : NÃO IMPLEMENTADO}
      if (ACBrSPEDFiscal.Bloco_0.Registro0000.IND_PERFIL = pfPerfilB) and  (qryRegistroC405vl_brt.AsCurrency > 0) then
        P_RegistroC420;

      if ACBrSPEDFiscal.Bloco_0.Registro0000.IND_PERFIL = pfPerfilA then
        P_RegistroC460;

      P_RegistroC490;

    end;
    qryRegistroC405.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC410;
begin
{
  with ACBrSPEDFiscal.bloco_c.RegistroC410New do
  begin
    VL_PIS    := 0.00;      /// 'Valor total do PIS
    VL_COFINS := 0.00;   /// 'Valor total da COFINS
  end;
  }
end;

procedure TdtmEFD.P_RegistroC420;
  function ExisteOperacoesTributaveis: boolean;
  var
    vfilial : integer;
    vnumerousuario : integer;
    vcro : integer;
    vdataMovimento : TDateTime;
    vRegistroAtual : tBookMark;
  begin
    result := false;
    vfilial := qryRegistroC420filial.AsInteger;
    vnumerousuario := qryRegistroC420numerousuario.AsInteger;
    vcro := qryRegistroC420cro.AsInteger;
    vdataMovimento := qryRegistroC420dt_doc.AsDateTime;
    vRegistroAtual := qryRegistroC420.GetBookmark;
    qryRegistroC420.First;
    if qryRegistroC420.Locate('filial; numerousuario; cro; dt_doc', VarArrayOf([vfilial, vnumerousuario, vcro, vdataMovimento]), []) then
    begin
      while (vfilial = qryRegistroC420filial.AsInteger)
        and (vnumerousuario = qryRegistroC420numerousuario.AsInteger)
        and (vcro = qryRegistroC420cro.AsInteger)
        and (vdataMovimento = qryRegistroC420dt_doc.AsDateTime)
        and not qryRegistroC420.Eof do
      begin
        if (qryRegistroC420nr_tot.AsInteger <> 0)  or
           (copy(qryRegistroC420cod_tot_par.AsString,1,1) = 'F') or
           (copy(qryRegistroC420cod_tot_par.AsString,1,1) = 'I') or
           (copy(qryRegistroC420cod_tot_par.AsString,1,1) = 'N') then
        begin
          result := true;
          break;
        end;
        qryRegistroC420.Next;
      end;
    end;
    qryregistroc420.GotoBookmark(vregistroatual);
    qryregistroc420.FreeBookmark(vregistroatual);

  end;

begin
  qryRegistroC420.First;
  while not qryRegistroC420.Eof do
  begin
    {quando não possui operações tributáveis e existindo opnf não passa no validador sped fiscal, sendo necessário desconsiderar as opnf}
    if (qryRegistroC420cod_tot_par.AsString <> 'OPNF') or
       ((qryRegistroC420cod_tot_par.AsString = 'OPNF') and
//        (qryRegistroC405vl_brt.AsCurrency <> 0) and
        (qryRegistroC490.RecordCount <> 0)
{        ExisteOperacoesTributaveis}) then
    begin
      with ACBrSPEDFiscal.bloco_c.RegistroC420New do
      begin
        COD_TOT_PAR  := qryRegistroC420cod_tot_par.AsString ;     /// Código do totalizador, conforme Tabela 4.4.6
        VLR_ACUM_TOT := qryRegistroC420vlr_acum_tot.AsCurrency;   /// Valor acumulado no totalizador, relativo à respectiva Redução Z.
        if qryRegistroC420nr_tot.AsInteger<>0 then
          NR_TOT       := qryRegistroC420nr_tot.AsInteger;         /// Número do totalizador quando ocorrer mais de uma situação com a mesma carga tributária efetiva.
  //        DESCR_NR_TOT := AnsiString;    /// Descrição da situação tributária relativa ao totalizador parcial, quando houver mais de um com a mesma carga tributária efetiva.
        P_RegistroC425;
      end;
    end;
    qryRegistroC420.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC425;
begin
  qryRegistroC425.First;
  while not qryRegistroC425.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC425New do
    begin
      COD_ITEM := qryRegistroC425cod_item.AsString;      // Código do item (campo 02 do Registro 0200):
      QTD      := qryRegistroC425qtde_item.AsCurrency;   // Quantidade acumulada do item:
      UNID     := qryRegistroC425un_med.AsString;        // Unidade do item (Campo 02 do registro 0190)
      VL_ITEM  := qryRegistroC425vl_tot_item.AsCurrency; // Valor acumulado do item:
      VL_PIS   := 0.00;           /// Valor do PIS
      VL_COFINS:= 0.00;        /// Valor da COFINS
    end;
    qryRegistroC425.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC460;
begin
  qryRegistroC460.First;
  while not qryRegistroC460.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC460New do
    begin
      COD_MOD   := qryRegistroC460cod_mod.AsString;     // Código do modelo do documento fiscal, conforme a Tabela 4.1.1
      COD_SIT   := SituacaoDocto(qryRegistroC460cod_sit.AsString);     // Código da situação do documento fiscal, conforme a Tabela 4.1.2
      NUM_DOC   := qryRegistroC460coo.AsString;         // Número do documento fiscal (COO)
      if qryRegistroC460canc.AsString='N' then
      begin
        DT_DOC    := qryRegistroC460dt_doc.AsDateTime;    // Data da emissão do documento fiscal
        VL_DOC    := qryRegistroC460vl_doc.AsCurrency;    // Valor total do documento fiscal
        VL_PIS    := qryRegistroC460vl_pis.AsCurrency;    // Valor do PIS
        VL_COFINS := qryRegistroC460vl_cofins.AsCurrency; // Valor da COFINS
        CPF_CNPJ  := somentenumero(qryRegistroC460cnpj_cpf.AsString);    // CPF ou CNPJ do adquirente
        NOM_ADQ   := qryRegistroC460nome_cli.AsString;    // Nome do adquirente
      end;
      P_RegistroC470;
    end;
    qryRegistroC460.Next;
  end;
end;

procedure TdtmEFD.Bloco_H;
begin
  P_RegistroH001; //ABERTURA DO BLOCO C
  if not qryefddatainventario.IsNull then
    P_RegistroH005;
