procedure TdtmEFD.P_Registro0500;
{
--------------------------------------------------------------------------------
REGISTRO 0500: PLANO DE CONTAS CONTÁBEIS
--------------------------------------------------------------------------------
Nº 	Campo 	Descrição 	Tipo 	Tam 	Dec
--------------------------------------------------------------------------------
01	REG 	Texto fixo contendo "0500" 	C 	004* 	-
02	DT_ALT 	Data da inclusão/alteração 	N 	008*	-
03	COD_ NAT_CC	Código da natureza da conta/grupo de contas:
01 - Contas de ativo;
02 - Contas de passivo;
03 - Patrimônio líquido;
04 - Contas de resultado;
05 - Contas de compensação;
09 - Outras. 	C 	002* 	-
04	IND_CTA 	Indicador do tipo de conta:
S - Sintética (grupo de contas);
A - Analítica (conta). 	C 	001* 	-
05	NÍVEL 	Nível da conta analítica/grupo de contas. 	N 	005 	-
06	COD_CTA 	Código da conta analítica/grupo de contas. 	C 	015 	-
08	NOME_CTA 	Nome da conta analítica/grupo de contas. 	C 	060 	-
--------------------------------------------------------------------------------
Observações: informar somente as contas referenciadas nos tipos de registros:
0300 ou 0305 ou
C170 ou C300 ou
C350 ou C510 ou
C610 ou D100 ou
D300 ou D400 ou
D500 ou D510 ou
D610 ou H010 ou 1510.
Nível hierárquico - 2
Ocorrência - vários (por arquivo)
--------------------------------------------------------------------------------
}
begin
  RefazConsultaPorNome(qryRegistro0500,
                      ['datainicial','datafinal','filial'],
                      [datainicial, datafinal, qryefdfilial.asinteger]);

  qryRegistro0500.first;
  while not qryRegistro0500.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_0.Registro0500New do
    begin
      DT_ALT     := qryRegistro0500.fieldbyname('dt_alt').AsDateTime;   // Data da inclusão/alteração
      COD_NAT_CC := qryRegistro0500.fieldbyname('cod_nat_cc').AsString; // Código da natureza da conta/grupo de contas
      IND_CTA    := qryRegistro0500.fieldbyname('ind_cta').asString;    // Indicador do tipo de conta:  S - Sintética ou A - Analítica
      NIVEL      := qryRegistro0500.fieldbyname('nivel').asString;      // Nível da conta analítica/grupo de contas
      COD_CTA    := qryRegistro0500.fieldbyname('cod_cta').asString;    // Código da conta analítica/grupo de conta
      NOME_CTA   := qryRegistro0500.fieldbyname('nome_cta').AsString;   // Nome da conta analítica/grupo de contas
    end;
    qryRegistro0500.Next;
  end;

end;

procedure TdtmEFD.P_Registro0600;
{
--------------------------------------------------------------------------------
REGISTRO 0600: CENTRO DE CUSTOS
--------------------------------------------------------------------------------
Nº 	Campo 	Descrição 	tipo 	tam	Dec
--------------------------------------------------------------------------------
01 	REG 	Texto fixo contendo "0600". 	C 	004* 	-
02 	DT_ALT 	Data da inclusão/alteração. 	N 	008* 	-
03 	COD_CCUS 	Código do centro de custos. 	C 	010 	-
04 	CCUS 	Nome do centro de custos. 	C 	060 	-
--------------------------------------------------------------------------------
Observações: Informar somente os centros de custos referenciados no tipo de registro 0305
Nível hierárquico - 2
Ocorrência - vários (por arquivo)
--------------------------------------------------------------------------------
}
begin
  RefazConsultaPorNome(qryRegistro0600,
                      ['datainicial','datafinal','filial'],
                      [datainicial, datafinal, qryefdfilial.asinteger]);

  qryRegistro0600.first;
  while not qryRegistro0600.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_0.Registro0600New do
    begin
      DT_ALT     := qryRegistro0600.fieldbyname('dt_alt').AsDateTime;        // Data da inclusão/alteração
      COD_CCUS   := qryRegistro0600.fieldbyname('cod_ccus').asString;       // Código do centro de custos.
      CCUS       := qryRegistro0600.fieldbyname('ccus').asString;       // Nome do centro de custos.
    end;
    qryRegistro0600.Next;
  end;


end;

