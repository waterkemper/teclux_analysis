procedure TdtmEFD.P_RegistroG001;
begin

  RefazConsultaPorNome(qryRegistroG110,
                        ['datainicial','datafinal','filial'],
                        [datainicial,datafinal,qryEFDFilial.asinteger]);

   with ACBrSPEDFiscal.Bloco_G.RegistroG001New do
