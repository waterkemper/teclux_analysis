procedure TdtmEFD.P_RegistroC470;
begin
  qryRegistroC470.First;
  while not qryRegistroC470.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.registroC470New do
    begin
      COD_ITEM  := qryRegistroC470cod_item.AsString;           /// Código do item (campo 02 do Registro 0200):
      QTD       := qryRegistroC470qtd.AsCurrency;              /// Quantidade do item
      QTD_CANC  := qryRegistroC470qtd_canc.AsCurrency;         /// Quantidade cancelada, no caso de cancelamento parcial de item
      UNID      := qryRegistroC470unid.AsString;               /// Unidade do item (Campo 02 do registro 0190)
      VL_ITEM   := qryRegistroC470vl_item.AsCurrency;          /// Valor do item:
      CST_ICMS  := preencheString(qryRegistroC470cst_icms.AsString,'0',3,false);     /// Código da Situação Tributária, conforme a Tabela indicada no item 4.3.1.
      CFOP      := qryRegistroC470cfop.AsString;               /// Código Fiscal de Operação e Prestação
      ALIQ_ICMS := qryRegistroC470aliq_icms.AsCurrency;        /// Alíquota do ICMS - Carga tributária efetiva em percentual
      VL_PIS    := qryRegistroC470vl_pis.AsCurrency;           /// Valor do PIS
      VL_COFINS := qryRegistroC470vl_cofins.AsCurrency;        /// Valor da COFINS
    end;
    qryRegistroC470.Next;
  end;
end;

procedure TdtmEFD.P_RegistroC490;
begin
  qryRegistroC490.First;
  while not qryRegistroC490.Eof do
  begin
    with ACBrSPEDFiscal.bloco_c.RegistroC490New do
    begin
      CST_ICMS  := preencheString(qryRegistroC490cst_icms.AsString,'0',3,false); /// Código da Situação Tributária, conforme a Tabela indicada no item 4.3.1
      CFOP      := qryRegistroC490cfop.AsString;             /// Código Fiscal de Operação e Prestação
      ALIQ_ICMS := qryRegistroC490aliq_icms.AsCurrency;      /// Alíquota do ICMS
      VL_OPR    := qryRegistroC490vl_opr.AsCurrency;         /// Valor da operação correspondente à combinação de CST_ICMS, CFOP, e alíquota do ICMS, incluídas as despesas acessórias e acréscimos
      VL_BC_ICMS:= qryRegistroC490vl_bc_icms.AsCurrency;     /// Valor acumulado da base de cálculo do ICMS, referente à combinação de CST_ICMS, CFOP, e alíquota do ICMS.
      VL_ICMS   := qryRegistroC490vl_icms.AsCurrency;        /// Valor acumulado do ICMS, referente à combinação de CST_ICMS, CFOP e alíquota do ICMS.
      COD_OBS   := qryRegistroC490cod_obs.AsString;          /// Código da observação do lançamento fiscal (campo 02 do Registro 0460)

      FRegistroE110_VL_TOT_DEBITOS := fRegistroE110_VL_TOT_DEBITOS + VL_ICMS;

    end;
    qryRegistroC490.Next;
  end;
end;

procedure TdtmEFD.P_RegistroH001;
begin
  if qryefddatainventario.IsNull then
    ACBrSPEDFiscal.Bloco_H.RegistroH001.IND_MOV := imSemDados
  else
    ACBrSPEDFiscal.Bloco_H.RegistroH001.IND_MOV := imComDados;
end;

procedure TdtmEFD.P_RegistroH005;
begin
  RefazConsultaPorNome(qryRegistroH005,['datafinal','filial'],[qryefddatainventario.asdatetime,qryefdfilial.asinteger]);
    RefazConsultaPorNome(qryregistroH010,['datafinal','filial'],[qryefddatainventario.asdatetime,qryefdfilial.asinteger]);

  qryRegistroH005.First;
  while not qryRegistroH005.Eof do
  begin
    with ACBrSPEDFiscal.Bloco_H.RegistroH005New do
    begin
      DT_INV := qryefddatainventario.asdatetime;    /// Data do inventário:
      VL_INV := qryRegistroH005vl_inv.AsCurrency;     /// Valor total do estoque:
      MOT_INV := MotivodoInventario(qryefdmotivoinventario.AsString);
      P_RegistroH010;
    end;
    qryRegistroH005.Next;
  end;
end;

procedure TdtmEFD.P_RegistroH010;
begin
  qryregistroH010.First;
  while not qryregistroH010.Eof do
  begin
    with ACBrSPEDFiscal.bloco_h.RegistroH010New do
    begin
      COD_ITEM := qryregistroH010codigoitem.AsString;     /// Código do item (campo 02 do Registro 0200)
      UNID     := qryregistroH010unidade.AsString;         /// Unidade do item
      QTD      := qryregistroH010qtdestoque.AsCurrency;            /// Quantidade do item
      VL_UNIT  := qryregistroH010vl_unit.AsCurrency;        /// Valor unitário do item
      VL_ITEM  := qryregistroH010vl_item.AsCurrency;        /// Valor do item
      IND_PROP := PosseItem(qryregistroH010ind_prop.AsInteger);     /// Indicador de propriedade/posse do item: 0- Item de propriedade do informante e em seu poder, 1- Item de propriedade do informante em posse de terceiros, 2- Item de propriedade de terceiros em posse do informante
//        COD_PART := qryregistroH010cod AnsiString;     /// Código do participante (campo 02 do Registro 0150): proprietário/possuidor que não seja o informante do arquivo
//        TXT_COMPL:=  AnsiString;    /// Descrição complementar
//        COD_OBS  :=  AnsiString;      /// Código de referência à observação (campo 02 do Registro 0460)
      COD_CTA  :=  qryregistroH010cod_cta.AsString;      /// Código da conta analítica contábil debitada/creditada
    end;
    qryregistroH010.Next;
  end;
end;

