function TdtmEstornoRecebimentos.GetConsultaGrupoFiliais: TtecQuery;
begin
  Result := qryConsultaGrupoFiliais;
end;

procedure TdtmEstornoRecebimentos.qryClientesBeforeOpen(DataSet: TDataSet);
begin
  inherited;
  if qryClientes.Params[0].AsString = '' then
    qryClientes.Params[0].AsString:= 'C';
end;

function TdtmEstornoRecebimentos.AbrirParcelas: Boolean;
begin
  qryParcelas.Close;
  qryParcelas.Open;
  Result := qryParcelas.IsEmpty;
end;

function TdtmEstornoRecebimentos.GetQtdeParcelas: Integer;
begin
  Result := qryParcelas.RecordCount;
end;

function TdtmEstornoRecebimentos.GetTotalParcelas: Real;
begin
  result := TotalizarValores[qryParcelas,qryParcelasvalorpagto, nil];
end;

procedure TdtmEstornoRecebimentos.EfetuarEstorno;
var
  Usuario: TtecUsuarios;
  estornar: boolean;
begin
  Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
  try
    if UsuarioLogin.Pagamento then
         Usuario:= ObterAutorizacao(taSENHA)
    else Usuario:= ObterAutorizacao(taLOGIN, ctAUTORIZACAOPAGAMENTO, ctAUTORIZADO);
    if Assigned(Usuario) and Usuario.Pagamento then begin
      try
        qryParcelas.DisableControls;
        qryParcelas.First;
        while not qryParcelas.Eof do begin
          if qryParcelasselecionar.AsBoolean then begin
            ReFazConsulta(qryEstornarParcelas,[0,1],[qryParcelascontrato.AsString,
                                                     qryParcelasnumero.AsInteger]);
            if not qryEstornarParcelas.IsEmpty then
            begin

               {
                  verifica se tem recebimentos confirmados, caso sim
                    alerta usuário que tem recebimentos e serao cancelados (sim nao cancelar)
                  caso nao tenha confirmado, cancelar os recebimentos com o numero de transacao da parcela
               }
              estornar:=true;

              if(qryParcelasconfirmados.AsInteger > 0) then
              begin
                  {
                  estornar:=MensagemSelecionaOpcao(format('A parcela %s do contrato %s possui recebimentos confirmados, deseja estornar mesmo assim?',
                  [qryParcelasnumero.AsString,qryParcelascontrato.AsString])) = smbyes;
                  }

                  MensagemAviso(format('A parcela %s do contrato %s possui recebimentos confirmados, o estorno só poderá ser realizado na opção ''conntrole de recebimentos''',
                  [qryParcelasnumero.AsString,qryParcelascontrato.AsString]));

                  estornar := false;
              end;

              if(estornar) then
              begin
                //estorna os recebimentos tambem update recebimentos set situacao='C' where transacao=..
                qryAtualizaRecebimentos.ParamByName('transacao').AsInteger:=qryParcelastransacao.AsInteger;
                qryAtualizaRecebimentos.ExecSql;

                qryEstornarParcelas.Edit;
                qryEstornarParcelasDataPagto.Clear;
                qryEstornarParcelasValorPagto.Clear;
                qryEstornarParcelasFilialPagto.Clear;
                qryEstornarParcelastipopagto.Clear;
                qryEstornarParcelasContaBoleto.Clear;
                qryEstornarParcelasObservacaoBoleto.Clear;
                qryEstornarParcelasDataEstorno.AsDateTime := DataHoraLocal;
                qryEstornarParcelasUsuarioEstorno.AsString := Usuario.NomeUsuario;
                qryEstornarParcelas.Post;
                Perpetrar([qryEstornarParcelas]);
              end;
            end;
          end;
          qryParcelas.Next;
        end;
      finally
        LimparContadores;
        AbrirParcelas;
        qryParcelas.EnableControls;
      end;
    end
    else
      MensagemAviso(format(ctUSUARIONAOAUTORIZADO,['cancelar a quitação de parcelas.']));
  finally
    Usuario.Free;
  end;
end;

procedure TdtmEstornoRecebimentos.LimparContadores;
begin
  FQtdeMarcados := 0;
  FTotalMarcados:= 0;
end;

procedure TdtmEstornoRecebimentos.Limpar;
begin
  qryParcelas.Close;
  LimparContadores;
end;

end.
