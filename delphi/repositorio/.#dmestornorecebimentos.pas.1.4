{$R *.dfm}

{ Tdtmestornorecebimentos }

procedure TdtmEstornoRecebimentos.AbreTabelaPesquisa(
  TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
    pesFILIAIS : Abre(ctConsultaFiliais);
    pesGRUPOSFILIAIS : Abre(ctConsultaGruposFiliais);
    pesCLIENTES      : begin
                          qryConsultaClientes.Sql[8] := 'where vf.Codigo = 0';
                          Abre(ctConsultaClientes);
                       end;
    pesCONTADEBITO   : Abre(ctConsultaContas);
  end;
end;

procedure TdtmEstornoRecebimentos.FechaTabelaPesquisa(
  TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
    pesFILIAIS       : Fecha(ctConsultaFiliais);
    pesGRUPOSFILIAIS : Fecha(ctConsultaGruposFiliais);
    pesCLIENTES      : Fecha(ctConsultaClientes);
    pesCONTADEBITO   : Fecha(ctConsultaContas);
  end;
end;

procedure TdtmEstornoRecebimentos.MontarDataPagto;
const
  Data_1: String = ' AND p.datapagto = ''';
  Data_2: String = ' AND p.datapagto BETWEEN ''';
begin
   if not DataEmBranco(FPagtoInicial) then
     if DataEmBranco(FPagtoFinal) then
       qryParcelas.MacroByName('DataPagto').AsString:= Data_1 + FPagtoInicial + ''''
     else
       qryParcelas.MacroByName('DataPagto').AsString:= Data_2 + FPagtoInicial + ''' AND ''' + FPagtoFinal + ''''
   else
   if not DataEmBranco(FPagtoFinal) then
     qryParcelas.MacroByName('DataPagto').AsString:= Data_1 + FPagtoFinal + ''''
   else
     qryParcelas.MacroByName('DataPagto').AsString:= '';
end;

procedure TdtmEstornoRecebimentos.MontarDataVencto;
const
  Data_1: String = ' AND p.datavencto = ''';
  Data_2: String = ' AND p.datavencto BETWEEN ''';
begin
   if not DataEmBranco(FVenctoInicial) then
     if DataEmBranco(FVenctoFinal) then
       qryParcelas.MacroByName('DataVencto').AsString:= Data_1 + FVenctoInicial + ''''
     else
       qryParcelas.MacroByName('DataVencto').AsString:= Data_2 + FVenctoInicial + ''' AND ''' + FVenctoFinal + ''''
   else
   if not DataEmBranco(FVenctoFinal) then
     qryParcelas.MacroByName('DataVencto').AsString:= Data_1 + FVenctoFinal + ''''
   else
     qryParcelas.MacroByName('DataVencto').AsString:= '';
end;

procedure TdtmEstornoRecebimentos.Selecionar(
  TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
    pesFILIAIS       : ReFazConsulta(qryFilial, [0], [qryConsultaFiliaisCodigo.AsInteger]);
    pesGRUPOSFILIAIS : ReFazConsulta(qryGrupoFiliais, [0], [qryConsultaGrupoFiliaisCodigo.AsInteger]);
    pesCLIENTES      : ReFazConsulta(qryClientes, [0,1], [qryConsultaClientestipo.AsString,
                                                          qryConsultaClientescodigo.AsInteger]);
    pesCONTADEBITO   : ReFazConsulta(qryContas, [0], [qryConsultaContasConta.AsInteger]);
  end;
end;

procedure TdtmEstornoRecebimentos.SetCliente(const Value: String);
begin
  if Value <> '' then
    qryParcelas.MacroByName('Cliente').AsString := 'AND p.contrato IN ' +
                                                   '(SELECT ct.numero FROM contratos ct WHERE ct.cliente = ' + Value +
                                                   ' AND ct.tipocliente = ''' + qryClientestipo.AsString + ''') '
  else
    qryParcelas.MacroByName('Cliente').AsString := '';
end;

procedure TdtmEstornoRecebimentos.SetFilial(const Value: String);
begin
  if Value <> '' then
    qryParcelas.MacroByName('Filial').AsString:= 'AND p.filialpagto = ' + Value
  else
    qryParcelas.MacroByName('Filial').AsString:= '';
end;

procedure TdtmEstornoRecebimentos.SetGrupoFilial(const Value: String);
begin
  if Value <> '' then
    qryParcelas.MacroByName('GrupoFilial').AsString:= ' AND p.filialpagto IN ' +
                                                      '(SELECT filial FROM filiaisgruposfiliais WHERE grupo = ' + Value + ') '
  else
    qryParcelas.MacroByName('GrupoFilial').AsString:= '';
end;

procedure TdtmEstornoRecebimentos.SetPagtoFinal(const Value: String);
begin
  if not DataEmBranco(Value) then
    FPagtoFinal := Value
  else
    FPagtoFinal := '';
  MontarDataPagto;
end;

procedure TdtmEstornoRecebimentos.SetPagtoInicial(const Value: String);
begin
  if not DataEmBranco(Value) then
    FPagtoInicial := Value
  else
    FPagtoInicial := '';
  MontarDataPagto;
end;

procedure TdtmEstornoRecebimentos.SetVenctoFinal(const Value: String);
begin
  if not DataEmBranco(Value) then
    FVenctoFinal := Value
  else
    FVenctoFinal := '';
  MontarDataVencto;
end;

procedure TdtmEstornoRecebimentos.SetVenctoInicial(const Value: String);
begin
  if not DataEmBranco(Value) then
    FVenctoInicial := Value
  else
    FVenctoInicial := '';
  MontarDataVencto;
end;

procedure TdtmEstornoRecebimentos.dsrClientesDataChange(Sender: TObject;
  Field: TField);
