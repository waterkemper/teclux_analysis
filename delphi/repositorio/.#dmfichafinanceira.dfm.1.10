      '             e.descricao as descricaoequipamento,'
      '             e.referencia'
      
        'From     servicoscontratos sc left join equipamentos e on (sc.eq' +
        'uipamento = e.codigo), servicos s'
      'Where  (sc.servico = s.codigo) and'
      '           (sc.contrato =:contrato)')
    RequestLive = False
    Left = 216
    Top = 8
    ParamData = <
      item
        DataType = ftString
        Name = 'Contrato'
        ParamType = ptUnknown
        Value = '0'
      end>
