  object qryRecebimentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select r.codigo,'
      '       (select tr.descricao'
      '        from tiposrecebimentos tr'
      '        where tr.codigo = r.tiporecebimento) as tiporecebimento,'
      '       r.valorlancto,'
      '       r.datalancto,'
      '       r.datavencto,'
      '       r.transacao'
      'from recebimentos r'
      'where r.transacao in (select p.transacao'
      '                      from parcelas p'
      '                      where p.contrato = :contrato'
      '                      order by p.transacao)'
      '  and r.situacao <> '#39'C'#39
      'order by r.transacao, r.codigo, r.datalancto')
    RequestLive = False
    Left = 336
    Top = 136
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
    object qryRecebimentoscodigo: TIntegerField
      FieldName = 'codigo'
    end
    object qryRecebimentosvalorlancto: TFloatField
      FieldName = 'valorlancto'
    end
    object qryRecebimentosdatalancto: TDateTimeField
      FieldName = 'datalancto'
      DisplayFormat = 'dd/mm/yy hh:mm'
    end
    object qryRecebimentostiporecebimento: TStringField
      FieldName = 'tiporecebimento'
      Size = 50
    end
    object qryRecebimentosdatavencto: TDateField
      FieldName = 'datavencto'
    end
    object qryRecebimentostransacao: TIntegerField
      FieldName = 'transacao'
      Visible = False
    end
  end
