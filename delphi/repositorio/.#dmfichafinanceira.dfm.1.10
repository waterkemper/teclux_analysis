  object qryRomaneios: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryRomaneiosAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select    r.numero,'
      '              r.emissao,'
      '              r.fornecedor,'
      '              f.razao,'
      '              rn.dadofiscal,'
      
        '              cast(lpad(cast(n.filial as varchar),3,'#39' '#39') || '#39'-'#39' ' +
        '|| lpad(cast(n.serie as varchar),3,'#39' '#39') || '#39'-'#39' || lpad(cast(n.nu' +
        'mero as varchar),8,'#39' '#39') as varchar) as nota,'
      
        '              cast(lpad(cast(c.filial as varchar),3,'#39' '#39') || '#39'-'#39' ' +
        '|| lpad(cast(c.maquina as varchar),3,'#39' '#39') || '#39'-'#39' || lpad(cast(c.' +
        'intervensao as varchar),3,'#39' '#39') || '#39'-'#39' || lpad(cast(c.numero as v' +
        'archar),8,'#39' '#39') as varchar) as cupom'
      'From      romaneios r, romaneiosnotas rn, fornecedores f, '
      
        '              dadosfiscais df left join notas n on (df.numero = ' +
        'n.dadofiscal)'
      
        '                                       left join cupons c on (df' +
        '.numero = c.dadofiscal)'
      'Where    r.datapagto is null         and'
      '              (r.fornecedor = f.codigo) and'
      '              (r.numero = rn.romaneio)    and'
      '              (rn.dadofiscal = df.numero) and'
      '              (df.contrato =:contrato)'
      'Order By r.emissao')
    RequestLive = False
    Left = 216
    Top = 264
    ParamData = <
      item
        DataType = ftString
        Name = 'contrato'
        ParamType = ptUnknown
      end>
    object qryRomaneiosnumero: TIntegerField
      FieldName = 'numero'
      Required = True
      DisplayFormat = '0'
    end
    object qryRomaneiosemissao: TDateField
      Alignment = taCenter
      FieldName = 'emissao'
      Required = True
      EditMask = '99/99/9999;1; '
    end
    object qryRomaneiosfornecedortransporte: TIntegerField
      FieldName = 'fornecedor'
      DisplayFormat = '0'
    end
    object qryRomaneiosrazao: TStringField
      FieldName = 'razao'
      Required = True
      Size = 40
    end
    object qryRomaneiosnota: TStringField
      FieldName = 'nota'
      Size = 50
    end
    object qryRomaneioscupom: TStringField
      FieldName = 'cupom'
      Size = 50
    end
    object qryRomaneiosdadofiscal: TIntegerField
      FieldName = 'dadofiscal'
    end
  end
