  object qryMontagens: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryMontagensAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select distinct n.numero,'
      '       n.serie,'
      '       pdf.produto,'
      
        '       (select p.descricao from produtos p where p.codigo = pdf.' +
        'produto) as descricaoproduto,'
      
        '       (select gr.descricao from grades gr, caracteristicas c, p' +
        'rodutos p where gr.codigo = c.grade1 and c.codigo = p.caracteris' +
        'tica and p.codigo = pdf.produto) as linha,'
      
        '       (select gr.descricao from grades gr, caracteristicas c, p' +
        'rodutos p where gr.codigo = c.grade2 and c.codigo = p.caracteris' +
        'tica and p.codigo = pdf.produto) as coluna,'
      
        '       (select p.valorgrade1 from produtos p where p.codigo = pd' +
        'f.produto) as valorgrade1,'
      
        '       (select p.valorgrade2 from produtos p where p.codigo = pd' +
        'f.produto) as valorgrade2,'
      
        '       cast(coalesce((case when (select count(*) from requisicoe' +
        'sitens ri'
      '                                 where ri.requisicao = r.numero'
      #9#9#9#9'   and ri.datamontagem is not null) = 0 then '#39'ABERTO'#39
      #9#9#9'   else (case when (select count(*) from requisicoesitens ri'
      #9#9#9#9#9'    where ri.requisicao = r.numero'
      #9#9#9#9#9'      and ri.datamontagem is null) = 0 then '#39'FECHADO'#39
      #9#9#9#9'      else '#39'PARCIAL'#39
      #9#9#9#9' end)'
      #9#9'           end),'#39'ABERTA'#39') as varchar) as situacao'
      ''
      ''
      
        'from ((((produtoscontratos pc join dadosfiscais df on pc.contrat' +
        'o = df.contrato)'
      #9'join produtosdadosfiscais pdf on df.numero = pdf.dadofiscal'
      #9#9#9#9'     and pc.produto = pdf.produto'
      #9#9#9#9'     and pc.filial = pdf.filial)'
      #9'join requisicoes r on df.numero = r.dadofiscal)'
      #9'join notas n on df.numero = n.dadofiscal)'
      ''
      'where pc.contrato = :contrato'
      '  and pc.montagem = '#39'S'#39
      '  and df.situacao<>'#39'C'#39
      ''
      'order by produto,descricaoproduto, valorgrade1,valorgrade2')
    RequestLive = False
    Left = 216
    Top = 200
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
    object qryMontagensnumero: TIntegerField
      FieldName = 'numero'
    end
    object qryMontagensserie: TStringField
      FieldName = 'serie'
      Size = 3
    end
    object qryMontagensproduto: TLargeintField
      FieldName = 'produto'
    end
    object qryMontagensdescricaoproduto: TStringField
      FieldName = 'descricaoproduto'
      Size = 50
    end
    object qryMontagenslinha: TStringField
      FieldName = 'linha'
      Size = 50
