  object qryProdutosRomaneios: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select pdf.produto,'
      '           pdf.filial,'
      '           pdf.quantidade, '
      '           p.descricao '
      'From   produtosdadosfiscais pdf, '
      '           dadosfiscais df,'
      '           produtoscontratos pc,'
      '           produtos p'
      'Where (pdf.dadofiscal =:dadofiscal) and'
      '           (pdf.produto = pc.produto)    and'
      '           (pdf.filial = pc.filial)                and'
      '           (pdf.dadofiscal = df.numero) and'
      '           (pdf.produto = p.codigo)        and'
      '           (pc.contrato = df.contrato)     and'
      '           (pc.entrega = '#39'S'#39')')
    RequestLive = False
    Left = 216
    Top = 328
    ParamData = <
      item
        DataType = ftInteger
        Name = 'dadofiscal'
        ParamType = ptUnknown
        Value = '0'
      end>
