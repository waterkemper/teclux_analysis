  object qryNotaseCuponsdoContrato: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select notasecupons.* from'
      '('
      ''
      '  Select  n.filial,'
      '          n.serie,'
      '          cast(null as integer) as maquina,'
      '          cast(null as integer) as intervensao,'
      '          n.numero,'
      '          df.datasaida,'
      '          df.situacao,'
      '          cast('
      '          case when df.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '               when df.situacao = '#39'N'#39' then '#39'NORMAL'#39
      '               when df.situacao = '#39'D'#39' then '#39'DENEGADA'#39
      '          end as varchar(9)) as descricaosituacao,'
      '          df.cliente,'
      '          df.tipocliente,'
      '          df.nome as nomecliente,'
      '          df.valortotal,'
      '          df.numero as dadofiscal'
      ''
      '  From    notas n, dadosfiscais df'
      '  Where (n.dadofiscal = df.numero)'
      '       and (df.contrato =:contrato)'
      ''
      '       union all'
      ''
      '  Select  c.filial,'
      '          c.numeroserie as serie,'
      '          c.maquina,'
      '          c.intervensao,'
      '          c.numero,'
      '          df.datasaida,'
      '          df.situacao,'
      '          cast('
      '          case when df.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '               when df.situacao = '#39'N'#39' then '#39'NORMAL'#39
      '               when df.situacao = '#39'D'#39' then '#39'DENEGADA'#39
      '          end as varchar(9)) as descricaosituacao,'
      '          df.cliente,'
      '          df.tipocliente,'
      '          df.nome as nomecliente,'
      '          df.valortotal,'
      '          df.numero as dadofiscal'
      ''
      '  From    cupons c, dadosfiscais df'
      '  Where (c.dadofiscal = df.numero)'
      '       and (df.contrato =:contrato)'
      ''
      ') as notasecupons'
      'order by datasaida, numero')
    RequestLive = False
    Left = 216
    Top = 408
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
