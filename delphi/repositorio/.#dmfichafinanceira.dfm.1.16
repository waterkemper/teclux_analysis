  object qryParcelasCalcularDebito: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterInsert = qryParcelasCalcularDebitoAfterInsert
    AfterScroll = qryParcelasCalcularDebitoAfterScroll
    OnCalcFields = qryParcelasCalcularDebitoCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Condicao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select parcelasquitar.aux,'
      '              parcelasquitar.notasdocontrato,'
      '              parcelasquitar.numerocontrato,'
      '              parcelasquitar.numeroparcela,'
      '              parcelasquitar.datavencimento,'
      '              parcelasquitar.valorvencimento,'
      '              parcelasquitar.datapagamento,'
      '              parcelasquitar.valorpagamento,'
      '              parcelasquitar.filialpagamento,'
      '              parcelasquitar.filialvenda,'
      '              parcelasquitar.tipopagamento,'
      '              parcelasquitar.dataentrada,'
      '              parcelasquitar.datacaixa,'
      '              parcelasquitar.valorvista,'
      '              parcelasquitar.valorprazo,'
      '              parcelasquitar.parcelas'
      'From (Select   null as aux,'
      
        '                            notas_notasdocontrato(p.contrato) as' +
        ' notasdocontrato,'
      '                            p.contrato as numerocontrato, '
      '                            p.numero as numeroparcela,'
      '                            p.datavencto as datavencimento,'
      '                            p.valorvencto as valorvencimento,'
      '                            p.datapagto as datapagamento,'
      '                            p.valorpagto as valorpagamento,'
      '                            p.filialpagto as filialpagamento,'
      '                            c.filialvenda as filialvenda,'
      '                            p.tipopagto as tipopagamento,'
      '                            p.deventrada as dataentrada,'
      '                            p.devcaixa as datacaixa,'
      '                            c.valorvista as valorvista,'
      '                            c.valorprazo as valorprazo,'
      '                            false as parcelas'
      '             From     parcelas p, contratos c  '
      '             Where  (p.contrato = c.numero)            and'
      
        '                            (c.cliente =:cliente)               ' +
        '  and'
      
        '                            ((select count(numero) from  parcela' +
        's  where (contrato = c.numero)          and'
      
        '                                                                ' +
        '                                     datapagto is null) > 0)    ' +
        '      and'
      
        '                            ((select count(numero) from contrato' +
        's   where (origem = c.numero)) = 0)  and'
      '                            (c.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39'))'
      ''
      '             Union'
      ''
      '             Select  p.contrato as  aux,'
      
        '                     cast(null as varchar(50)) as notasdocontrat' +
        'o,'
      '                            p.contrato as  numerocontrato,'
      '                            null as numeroparcela,'
      '                            null as datavencimento,'
      '                            null as valorvencimento,'
      '                            null as datapagamento,'
      '                            null as valorpagamento,'
      '                            null as filialpagamento,'
      '                            null as FilialVenda,'
      '                            null as tipopagamento,'
      '                            null as dataentrada,'
      '                            null as datacaixa,'
      '                            null as valorvista,'
      '                            null as valorprazo,'
      '                            true as parcelas'
      '             From     parcelas p, contratos c'
      '             Where  (p.contrato = c.numero) and'
      '                            (c.cliente =:cliente) and'
      
        '                            ((select count(numero) from  parcela' +
        's  where (contrato = c.numero)          and'
      
        '                                                                ' +
        '                                     datapagto is null) > 0)    ' +
        '      and'
      
        '                            ((select count(numero) from contrato' +
        's   where (origem = c.numero)) = 0)  and'
      '                            (c.situacao in ('#39'F'#39','#39'N'#39','#39'P'#39'))'
      ''
      '             ) as parcelasquitar'
      '             where parcelasquitar.parcelas'
      '             %Condicao'
      
        'Order By  parcelasquitar.numerocontrato,parcelasquitar.aux, parc' +
        'elasquitar.datavencimento'
      ''
      '')
    RequestLive = True
    Left = 64
    Top = 328
    ParamData = <
      item
        DataType = ftInteger
        Name = 'cliente'
        ParamType = ptUnknown
        Value = 132164
      end>
