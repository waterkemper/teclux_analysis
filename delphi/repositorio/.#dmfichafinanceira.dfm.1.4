  object qryParcelas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT p.Contrato,'
      '       p.numero as nparcela,'
      '       p.Parcelaorigem as numero,'
      '       p.DataVencto,'
      '       p.ValorVencto,'
      '       p.DataPagto,'
      '       p.ValorPagto,'
      '       p.FilialPagto,'
      '       p.TipoPagto,'
      '       p.DevEntrada,'
      '       p.DevCaixa,'
      '       p.DescontoSugerido,'
      '      (p.ValorVencto - p.DescontoSugerido) as Liquido,'
      ''
      '      (CASE WHEN  p.DataPagto IS NOT NULL'
      
        '            THEN (p.ValorPagto - (p.ValorVencto - COALESCE(p.Des' +
        'contoSugerido,0)))'
      '            ELSE NULL'
      '       END) as JurosDesctos,'
      ''
      '       p.ContaBoleto,'
      ''
      '      (SELECT c.Digito FROM  Contas c'
      
        '                            WHERE c.Conta = p.ContaBoleto) as Di' +
        'gito,'
      ''
      '      (SELECT b.Sigla FROM  Bancos b'
      
        '                      WHERE b.Codigo = (SELECT c.Banco FROM  Con' +
        'tas c'
      
        '                                                     WHERE c.Con' +
        'ta = p.ContaBoleto)) as SiglaBanco,'
      ''
      '      (SELECT a.Nome  FROM  Agencias a'
      
        '                      WHERE a.Banco  = (SELECT c.Banco   FROM  C' +
        'ontas c'
      
        '                                                         WHERE c' +
        '.Conta = p.ContaBoleto)'
      
        '                        AND a.Codigo = (SELECT c.Agencia FROM  C' +
        'ontas c'
      
        '                                                         WHERE c' +
        '.Conta = p.ContaBoleto)) as NomeAgencia,'
      '       p.UsuarioExtraCaixa,'
      
        '       (SELECT tr.descricao FROM tiposrecebimentos tr WHERE tr.c' +
        'odigo = p.tiporecebimento) as tiporecebimento'
      ''
      'FROM   parcelas p'
      'WHERE  p.Contrato = :Contrato'
      ''
      'ORDER BY p.DataVencto, p.DataPagto'
      '')
    RequestLive = False
    Left = 64
    Top = 200
    ParamData = <
      item
        DataType = ftString
        Name = 'Contrato'
        ParamType = ptUnknown
        Value = '0'
      end>
