procedure TdtmFichaFinanceira.ImprimirCalculosDebitos;
var
//  Impressora: TfrPrinter;
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
  frVariables['Rua']   := RuaFilialBase;
  frVariables['Bairro']:= BairroFilialBase + ' - CEP: ' + CEPFilialBase;
  frVariables['Cidade']:= CidadeFilialBase + ' - ' + EstadoFilialBase;
  frVariables['Fone']  := FoneFilialBase;
  frVariables['DataBase'] := DataCalculo;
//  frVariables['TaxaJuros']     := FloatToStr(ParSistema.TaxaJuros);

  frVariables['AtrasoValor']    := FormatarValor(AtrasoParcela,2);
  frVariables['AtrasoJuro']     := FormatarValor(AtrasoJuro,2);
  frVariables['AtrasoTotal']    := FormatarValor(AtrasoParcela + AtrasoJuro,2);

  frVariables['AbertoValor']     := FormatarValor(EmAbertoParcela,2);
  frVariables['AbertoDesconto'] := FormatarValor(Abs(EmAbertoDesconto),2);
  frVariables['AbertoTotal']    := FormatarValor(EmAbertoParcela - Abs(EmAbertoDesconto),2);

  frVariables['TotalDebito']    := FormatarValor(RoundTo(AtrasoParcela + AtrasoJuro,-2) +
                                                 RoundTo(EmAbertoParcela - Abs(EmAbertoDesconto),-2),2);

  frVariables['ValorParcelas'] := FormatarValor(ValorParcela,2);
  frVariables['ValorJuros']    := FormatarValor(JuroParcela,2);
  frVariables['ValorDesconto'] := FormatarValor(DescontoParcela,2);
  frVariables['TotalCarne']    := FormatarValor(ValorParcela + JuroParcela - DescontoParcela,2);

  frVariables['Titulo']:= 'CÁLCULO DOS DÉBITOS';
  frmPreview := TfrmPreviewPadrao.create(self);
  try
   Relatorio := frmPreview.frCompositeReport;
   with frmPreview do
   begin
    frCompositeReport.Reports.Clear;
    frCompositeReport.Reports.Add(frpCalcularDebito);
   end;
//   Impressora.Printer.SetPrinter('');
   Relatorio.Preview := frmPreview.frPreviewPadrao;
   Relatorio.ShowReport;

   frmPreview.ShowModal;

  finally

   frmPreview.Free

  end;

end;


