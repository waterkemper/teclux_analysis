procedure TdtmFichaFinanceira.ReFazConsultaContratosPorCliente;
var
  Usuario: TtecUsuarios;
begin
  Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
  try
    ReFazConsulta(qryUsuarios,[0],[CodigoUsuario]);
    Fecha(ctCrediarioConsultaContratos);
    qryContratosPorCliente.Params[0].AsInteger:= qryClientesCodigo.AsInteger;
    qryContratosPorCliente.Params[1].AsString := qryClientestipo.AsString;
    if Usuario.AnalistaCredito then begin
      qryContratosPorCliente.Sql[ctSituacao] := 'and (v.situacao in (''C'',''R'',''F'',''N'',''P''))';
      qryContratosPorCliente.Sql[ctEstornado]:= '';
    end
    else begin
      qryContratosPorCliente.Sql[ctSituacao] := 'and (v.situacao in (''R'',''F'',''N'',''P''))';
      qryContratosPorCliente.Sql[ctEstornado]:= 'and ((select count(c.numero) from contratos c where (c.origem = v.numero)) = 0)';
    end;
    if (SomenteEmAberto) then
      qryContratosPorCliente.Sql[ctSomenteEmAberto] := ' AND aberto=''t'' '
    else
      qryContratosPorCliente.Sql[ctSomenteEmAberto] := '';
    Abre(ctCrediarioConsultaContratos);
  finally
    Usuario.Free;
  end;
end;

