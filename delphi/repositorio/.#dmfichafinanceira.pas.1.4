function TdtmFichaFinanceira.ExisteClientes(Parametro: Integer; NomeCampo: String; Value: Variant): Boolean;
const
  SQL = ' Where (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';
var
  vNomeCampo : String;
begin

  vNomeCampo := NomeCampo;
  if NomeCampo = 'nomecidade' then
    vNomeCampo:= 'c.nome'
  else if NomeCampo = 'tipo' then
    vNomeCampo:= 'v.tipo'
  else if nomecampo = 'nome' then
    vNomeCampo := 'v.razao'
  else if nomecampo = 'apelido' then
     vNomeCampo :='v.nome'
  else
    vNomeCampo:= 'v.' + NomeCampo;

  qryConsultaClientes.Sql[08]:= Format(SQL, [vNomeCampo, Value, '%']);

  qryConsultaClientes.Open;
  Result := qryConsultaClientes.RecordCount > 0
end;

