procedure TdtmFichaFinanceira.AtribuirDataDefault(AlterouDataBase, TodosContrato: Boolean);
var
  a:byte;
  Pos: TBookmark;
  Aux, ValorArredondado: Currency;
begin
  if AlterouDataBase or not TodosContrato then
    ZerarVariaveis;

  dsrParcelasCalcularDebito.OnDataChange:= nil;
  Pos:= qryParcelasCalcularDebito.GetBookmark;
  qryParcelasCalcularDebito.DisableControls;
  qryParcelasCalcularDebito.First;
  try
    for a:=1 to qryParcelasCalcularDebito.RecordCount do begin
      if (qryParcelasCalcularDebitoAux.AsString = '')                        and
//         (qryParcelasCalcularDebitoDataVencimento.AsDateTime <= DataCalculo) and
         (qryParcelasCalcularDebitoDataPagamento.AsDateTime = 0        )     and
         (qryParcelasCalcularDebitoValorPagamento.AsCurrency  = 0)           then begin
         if qryParcelasCalcularDebito.ReadOnly then
           qryParcelasCalcularDebito.ReadOnly:= False;
         qryParcelasCalcularDebito.Edit;

         if (qryParcelasCalcularDebitoDataVencimento.AsDateTime <= DataCalculo) then begin
           qryParcelasCalcularDebitoQuitar.AsBoolean:= True;
           qryParcelasCalcularDebitoDataPagamento.AsDateTime:= DataCalculo;

           qryParcelasCalcularDebitoValorPagamento.AsCurrency:=
                       qryParcelasCalcularDebitoValorVencimento.AsCurrency +
                       tecFinanceira.CalcularJuros(qryParcelasCalcularDebitoValorVencimento.AsCurrency,
                                                   qryParcelasCalcularDebitodatavencimento.AsDateTime,
                                                   qryParcelasCalcularDebitodatapagamento.AsDateTime);
            if (qryParcelasCalcularDebitoValorVencimento.AsCurrency <> qryParcelasCalcularDebitoValorPagamento.AsCurrency) then
              qryParcelasCalcularDebitoValorPagamento.AsCurrency:= Multiplo(qryParcelasCalcularDebitoValorPagamento.AsCurrency,
                                                                            ParSistema.ArredondamentoJurosCaixa);
            FValorParcela  := RoundTo(FValorParcela + qryParcelasCalcularDebitoValorVencimento.AsCurrency,-2);
         end
         else if (qryParcelasCalcularDebitoDataVencimento.AsDateTime > qryParcelasCalcularDebitoDataPagamento.AsDateTime) and
                 (qryParcelasCalcularDebitovalorprazo.AsCurrency > qryParcelasCalcularDebitovalorvista.AsCurrency) then begin

           Aux:=  qryParcelasCalcularDebitoValorVencimento.AsCurrency +
                  tecFinanceira.CalcularDesctos(qryParcelasCalcularDebitoValorVencimento.AsCurrency,
                                                qryParcelasCalcularDebitodatavencimento.AsDateTime,
                                                DataCalculo);
           ValorArredondado:= Multiplo(Aux, ParSistema.ArredondamentoJurosCaixa);
           if (ValorArredondado < qryParcelasCalcularDebitoValorVencimento.AsCurrency) then
             Aux:= ValorArredondado;
           FEmAbertoDesconto := FEmAbertoDesconto + (qryParcelasCalcularDebitoValorVencimento.AsCurrency - Aux);
         end;

         if (qryParcelasCalcularDebitoDataVencimento.AsDateTime < qryParcelasCalcularDebitoDataPagamento.AsDateTime) then
           FAtrasoParcela := RoundTo(FAtrasoParcela + qryParcelasCalcularDebitoValorVencimento.AsCurrency,-2)
         else
         if (qryParcelasCalcularDebitoDataVencimento.AsDateTime >= qryParcelasCalcularDebitoDataPagamento.AsDateTime) then
           FEmAbertoParcela := RoundTo(FEmAbertoParcela + qryParcelasCalcularDebitoValorVencimento.AsCurrency,-2);

         if (qryParcelasCalcularDebitoValorPagamento.AsCurrency > 0) then
              qryParcelasCalcularDebitoJurosDescontos.AsCurrency:= qryParcelasCalcularDebitoValorPagamento.AsCurrency - qryParcelasCalcularDebitoValorVencimento.AsCurrency
         else qryParcelasCalcularDebitoJurosDescontos.AsCurrency:= 0;

         if qryParcelasCalcularDebitoJurosDescontos.AsCurrency > 0 then begin
           FJuroParcela := RoundTo(FJuroParcela + qryParcelasCalcularDebitoJurosDescontos.AsCurrency,-2);
           FAtrasoJuro  := FJuroParcela;
         end;
         qryParcelasCalcularDebito.Post;
      end;
      qryParcelasCalcularDebito.Next;
    end;
  finally
    qryParcelasCalcularDebito.GotoBookmark(Pos);
    qryParcelasCalcularDebito.FreeBookmark(Pos);
    qryParcelasCalcularDebito.EnableControls;
  end;
  dsrParcelasCalcularDebito.OnDataChange:= dsrParcelasCalcularDebitoDataChange;
end;

procedure TdtmFichaFinanceira.CalcularDebitoParcelaEmAberto(ReCalcular:Boolean);
const
  WhereBase = '(parcelasquitar.numerocontrato in (';
var
  Posicao: Integer;
  ValorArredondado: Currency;
begin
  dsrParcelasCalcularDebito.OnDataChange:= nil;
  if not qryParcelasCalcularDebito.IsEmpty then begin
    if (qryParcelasCalcularDebitoAux.AsString = '')             and
       (qryParcelasCalcularDebitoFilialPagamento.AsInteger = 0) then begin

      if qryParcelasCalcularDebitoQuitar.AsBoolean then begin
        FValorParcela:= FValorParcela - qryParcelasCalcularDebitoValorVencimento.AsCurrency;
        if ((qryParcelasCalcularDebitovalorpagamento.AsCurrency - qryParcelasCalcularDebitovalorvencimento.AsCurrency)  > 0) then
             FJuroParcela     := RoundTo(FJuroParcela - qryParcelasCalcularDebitoJurosDescontos.AsCurrency,-2)
        else FDescontoParcela := RoundTo(FDescontoParcela - Abs(qryParcelasCalcularDebitoJurosDescontos.AsCurrency),-2);
      end;

      if qryParcelasCalcularDebito.ReadOnly then
        qryParcelasCalcularDebito.ReadOnly:= False;

      if not ReCalcular then
        qryParcelasCalcularDebitoQuitar.AsBoolean:= not qryParcelasCalcularDebitoQuitar.AsBoolean;

      qryParcelasCalcularDebito.Edit;
      if qryParcelasCalcularDebitoQuitar.AsBoolean then begin
        if not ReCalcular then
          qryParcelasCalcularDebitoDataPagamento.AsDateTime := DataCalculo;
        if (qryParcelasCalcularDebitoDataVencimento.AsDateTime < qryParcelasCalcularDebitoDataPagamento.AsDateTime) then begin
          qryParcelasCalcularDebitoValorPagamento.AsCurrency:=
                             qryParcelasCalcularDebitovalorvencimento.AsCurrency +
                             tecFinanceira.CalcularJuros(qryParcelasCalcularDebitovalorvencimento.AsCurrency,
                                                         qryParcelasCalcularDebitodatavencimento.AsDateTime,
                                                         qryParcelasCalcularDebitodatapagamento.AsDateTime);
          if (qryParcelasCalcularDebitoValorVencimento.AsCurrency <> qryParcelasCalcularDebitoValorPagamento.AsCurrency) then
            qryParcelasCalcularDebitoValorPagamento.AsCurrency:= Multiplo(qryParcelasCalcularDebitoValorPagamento.AsCurrency,
                                                                          ParSistema.ArredondamentoJurosCaixa);
        end
        else if (qryParcelasCalcularDebitoDataVencimento.AsDateTime > qryParcelasCalcularDebitoDataPagamento.AsDateTime) and
                (qryParcelasCalcularDebitovalorprazo.AsCurrency > qryParcelasCalcularDebitovalorvista.AsCurrency) then begin
          qryParcelasCalcularDebitoValorPagamento.AsCurrency:=
                             qryParcelasCalcularDebitovalorvencimento.AsCurrency +
                             tecFinanceira.CalcularDesctos(qryParcelasCalcularDebitovalorvencimento.AsCurrency,
                                                           qryParcelasCalcularDebitodatavencimento.AsDateTime,
                                                           qryParcelasCalcularDebitodatapagamento.AsDateTime);
          ValorArredondado:= Multiplo(qryParcelasCalcularDebitoValorPagamento.AsCurrency, ParSistema.ArredondamentoJurosCaixa);
          if (ValorArredondado < qryParcelasCalcularDebitovalorvencimento.AsCurrency) then
            qryParcelasCalcularDebitoValorPagamento.AsCurrency:= ValorArredondado;
        end
        else
          qryParcelasCalcularDebitoValorPagamento.AsCurrency:= qryParcelasCalcularDebitoValorVencimento.AsCurrency;

        qryParcelasCalcularDebitoJurosDescontos.AsCurrency:= qryParcelasCalcularDebitoValorPagamento.AsCurrency -
                                                             qryParcelasCalcularDebitoValorVencimento.AsCurrency;

        FValorParcela:= RoundTo(FValorParcela + qryParcelasCalcularDebitoValorVencimento.AsCurrency,-2);
        if qryParcelasCalcularDebitoJurosDescontos.AsCurrency > 0 then
          FJuroParcela := RoundTo(FJuroParcela + qryParcelasCalcularDebitoJurosDescontos.AsCurrency,-2)
        else if qryParcelasCalcularDebitoJurosDescontos.AsCurrency < 0 then
          FDescontoParcela := RoundTo(FDescontoParcela + Abs(qryParcelasCalcularDebitoJurosDescontos.AsCurrency),-2);
      end
      else begin
        qryParcelasCalcularDebitoDataPagamento.Clear;
        qryParcelasCalcularDebitoValorPagamento.Clear;
        qryParcelasCalcularDebitoJurosDescontos.Clear;
      end;
      qryParcelasCalcularDebito.Post;
    end
    else begin
      if (qryParcelasCalcularDebitoAux.AsString <> '') then begin
        if Contratos <> '' then
          Contratos := Contratos + ',';
        Posicao:= Pos(qryParcelasCalcularDebitoaux.AsString,Contratos);
        if Posicao > 0 then
             Delete(Contratos,Posicao-1,Length(qryParcelasCalcularDebitoaux.AsString)+3)
        else Contratos := Contratos + '''' + qryParcelasCalcularDebitoaux.AsString + ''',';
        qryParcelasCalcularDebito.Sql[61]:= 'Where';
        if Contratos <> '' then begin
          Delete(Contratos,Length(Contratos),1);
          qryParcelasCalcularDebito.Sql[62]:= WhereBase + Contratos + ')) or';
        end
        else
          qryParcelasCalcularDebito.Sql[62]:= '';
        qryParcelasCalcularDebito.Sql[63]  := 'parcelasquitar.parcelas';
        ReFazConsulta(qryParcelasCalcularDebito,[0],[qryClientescodigo.AsInteger]);
        SetarCampoQuitarFalse;
        AtribuirDataDefault(False,False);
      end;
    end;
  end;
  dsrParcelasCalcularDebito.OnDataChange:= dsrParcelasCalcularDebitoDataChange;
end;

procedure TdtmFichaFinanceira.CalcularDebitos(AlterouDataBase: Boolean);
begin
  if (qryParcelasCalcularDebito.IsEmpty) or AlterouDataBase then begin
    Contratos   := '';
    PrimeiraVez := True;
    qryParcelasCalcularDebito.Sql[61]:= '';
    qryParcelasCalcularDebito.Sql[62]:= '';
    qryParcelasCalcularDebito.Sql[63]:= '';
    ReFazConsulta(qryParcelasCalcularDebito,[0],[qryClientescodigo.AsInteger]);
    SetarCampoQuitarFalse;
    AtribuirDataDefault(AlterouDataBase,True);
  end;
end;

