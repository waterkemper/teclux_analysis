    RefazConsulta(qryMontagens,[0],[qryContratosPorClientenumero.AsString]);
end;

procedure TdtmFichaFinanceira.qryMontagensAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if Assigned(OnScrollLinhaColunaGrade) then
    OnScrollLinhaColunaGrade(qryMontagens);
end;

function TdtmFichaFinanceira.GetIntervaloCarnes: vString;
var
  a: integer;
begin
  a:=0;
  result := nil;
  SetLength(result, qryparcelas.RecordCount);
  qryParcelas.First;
  while not qryparcelas.Eof do
  begin
    result[a] := qryParcelasnparcela.AsString;
    inc(a);
    qryparcelas.next;
  end;
end;

function TdtmFichaFinanceira.GetIntervaloCarnesAbertas: vString;
var
  a: integer;
begin
  a:=0;
  result := nil;
  qryParcelas.First;
  while not qryparcelas.Eof do
  begin
    if qryParcelasdatapagto.AsString='' then
    begin
      SetLength(result, length(result)+1);
      result[a] := qryParcelasnparcela.AsString;
      inc(a);
    end;
    qryparcelas.next;
  end;
end;

procedure TdtmFichaFinanceira.ImprimirCarne(NumeroParcelas: vString);
var
  dtmImprimeCarne: TdtmImprimeCarne;
begin
  dtmImprimeCarne := TdtmImprimeCarne.Create(Self);
  try
    dtmImprimeCarne.ImprimirCarnesContrato(qryContratosPorClientenumero.AsString, NumeroParcelas)
  finally
    dtmImprimeCarne.Free;
  end
end;

procedure TdtmFichaFinanceira.SelecionarRecebimentos;
begin
  if not qryRecebimentos.Active then
    ReFazConsulta(qryRecebimentos,[0],[qryContratosPorClienteNumero.AsString]);
  if not qryParcelas.Active then
    RefazConsulta(qryParcelas,[0],[qryContratosPorClienteNumero.AsString]);
end;

procedure TdtmFichaFinanceira.qryContratosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  RefazConsultaPorNome(qryRomaneios,['contrato'],[qryContratosnumero.AsVariant]);
end;

procedure TdtmFichaFinanceira.qryClientesAfterScroll(DataSet: TDataSet);
begin
  inherited;
  RefazConsultaPorNome(qryRomaneios,['contrato'],[qryContratosnumero.AsVariant]);
