    Sql.Strings = (
      ';'
      'SELECT t.*,'
      '       trunc((vl_item/qtdestoque),2) as vl_unit,'
      '       cast('#39'0'#39' as varchar) as ind_prop'
      'from'
      '('
      ''
      
        #9'SELECT cast(('#39'P'#39'||cast(ep.codigoitem as varchar)) as varchar(60' +
        ')) as codigoitem,  ep.item, ep.situacaotributaria,'
      ''
      #9' ep.unidade, ep.aliquota,'
      
        #9' (ep.emestoque+ep.reservado+ep.transito+ep.demonstracao+ep.cons' +
        'erto+ep.danificada+ep.reservaprevia) AS qtdestoque,'
      #9' custo_medio as vl_item,'
      #9' coalesce(subconta,0) as cod_cta'
      #9'FROM'
      #9' ('
      #9' '
      #9#9' select ep.*,'
      #9#9' '
      
        #9#9#9#9' (select i.classificacaofiscal from ipi i where i.codigo = c' +
        '.ipi) as classificacaofiscal,'
      #9#9#9#9' cl.descricao AS classeproduto,'
      #9#9#9#9' cl.codigo AS codigoclasse,'
      #9#9#9#9' g.descricao AS grupoproduto,'
      #9#9#9#9' g.codigo AS codigogrupo,'
      #9#9#9#9' c.descricao AS produto,'
      #9#9#9#9' c.codigo AS codigoproduto,'
      
        #9#9#9#9' cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||coa' +
        'lesce(p.valorgrade2,'#39#39') as varchar) AS item,'
      #9#9#9#9' ma.descricao AS marca, p.referencia,'
      #9#9#9#9' c.unidade,'
      #9#9#9#9' c.subconta,'
      ''
      #9#9#9#9'CAST(CASE WHEN c.incidencia = 5 or c.csosn='#39'300'#39'  THEN '#39'I'#39
      
        #9#9#9#9#9#9'WHEN (c.incidencia in (4,6,7,11) or c.csosn in ('#39'103'#39','#39'400' +
        #39','#39'900'#39')) THEN '#39'N'#39
      
        #9#9#9#9#9#9'WHEN (c.incidencia in (2,9,10) or c.csosn in ('#39'201'#39','#39'202'#39',' +
        #39'203'#39','#39'500'#39'))  THEN '#39'F'#39
      
        #9#9#9#9#9#9'WHEN (c.incidencia in (1,3,8) or c.csosn in ('#39'101'#39','#39'102'#39'))' +
        '    THEN '#39'T'#39
      #9#9#9#9'END AS CHAR) AS situacaotributaria,'
      ''
      
        '         CAST(COALESCE((SELECT ei.valor FROM estadosicms ei WHER' +
        'E ei.icms = c.icms AND ei.estado = f.estado),0) AS NUMERIC(4,2))' +
        ' AS aliquota'
      ''
      #9#9' from'
      #9#9' ('
      #9#9#9' select ep.*,'
      #9#9#9' m2.valor,'
      #9#9#9' m2.quantidade as qtdUltimaEntrada'
      #9#9#9' from'
      #9#9#9' ('
      #9#9#9#9' select'
      #9#9#9#9' e.codigofilial,'
      #9#9#9#9' e.codigoitem,'
      #9#9#9#9' e.localizacao,'
      
        #9#9#9#9' e.precocomicms, /*,estoques_preco(e.produto,e.filial) as pr' +
        'ecovenda*/'
      #9#9#9#9' m.emestoque,'
      #9#9#9#9' m.reservado,'
      #9#9#9#9' m.transito,'
      #9#9#9#9' m.demonstracao,'
      #9#9#9#9' m.conserto,'
      #9#9#9#9' m.danificada,'
      #9#9#9#9' m.reservaprevia,'
      #9#9#9#9' m.estoquefisico,'
      #9#9#9#9' m.financeiro as Custo_Medio'
      #9#9#9#9' from'
      #9#9#9#9' ('
      #9#9#9#9#9' select m.numero,'
      #9#9#9#9#9' e.filial as codigofilial,'
      #9#9#9#9#9' e.produto as codigoitem,'
      #9#9#9#9#9' e.localizacao,'
      #9#9#9#9#9' e.precocomicms'
      #9#9#9#9#9' from'
      #9#9#9#9#9' ('
      ''
      #9#9#9#9#9#9' select m2.numero, m1.produto, m1.filial'
      #9#9#9#9#9#9' from'
      #9#9#9#9#9#9' ('
      #9#9#9#9#9#9#9'select m1.data, m1.produto, m1.filial,'
      #9#9#9#9#9#9#9
      #9#9#9#9#9#9#9#9' (select max(m2.lancto)'
      #9#9#9#9#9#9#9#9'  from movimentos m2'
      #9#9#9#9#9#9#9#9'  where m2.produto = m1.produto'
      #9#9#9#9#9#9#9#9'  and m2.filial = m1.filial'
      #9#9#9#9#9#9#9#9'  and m2.data = m1.data) as lancto'
      #9#9#9#9#9#9' '
      #9#9#9#9#9#9#9' from'
      #9#9#9#9#9#9#9' ('
      #9#9#9#9#9#9#9#9' select max(m1.data) as data, m1.produto, m1.filial'
      #9#9#9#9#9#9#9#9' from movimentos m1'
      #9#9#9#9#9#9#9#9' where m1.data < (cast(:datafinal as date)+1)'
      #9#9#9#9#9#9#9#9' group by m1.produto, m1.filial'
      #9#9#9#9#9#9#9#9' order by m1.produto, m1.filial'
      #9#9#9#9#9#9#9' ) as m1'
      #9#9#9#9#9#9#9' '
      
        #9#9#9#9#9#9' ) as m1 join movimentos m2 on m1.data = m2.data and m1.la' +
        'ncto = m2.lancto and m1.produto = m2.produto and m1.filial = m2.' +
        'filial'
      #9#9#9#9#9' '
      
        #9#9#9#9#9' ) as m join estoques e on m.produto = e.produto and m.fili' +
        'al = e.filial'
      
        #9#9#9#9#9' Where (e.filial = :filial ) /* WHERE ESTOQUE where e.produ' +
        'to =0 */'
      ''
      #9#9#9#9' ) as e join movimentos m on e.numero = m.numero'
      #9#9#9#9'   and m.financeiro<>0 /*and m1.financeiro<>0*/'
      #9#9#9'   '
      
        #9#9#9' ) as ep LEFT JOIN movimentos m2 ON m2.produto = ep.codigoite' +
        'm AND'
      #9#9#9#9' m2.filial = ep.codigofilial and'
      #9#9#9#9' m2.numero = (SELECT max(m.numero)'
      #9#9#9#9#9#9#9#9' from movimentos m'
      #9#9#9#9#9#9#9#9' where m.produto=ep.codigoitem and'
      #9#9#9#9#9#9#9#9' m.filial=ep.codigofilial and'
      #9#9#9#9#9#9#9#9' m.data < (cast(:datafinal as date)+1) and'
      #9#9#9#9#9#9#9#9' substring(m.operacao from 12 for 1)='#39'+'#39')'
      ''
      #9#9' ) as ep'
      #9#9' JOIN filiais f'
      #9#9' on ep.codigofilial = f.codigo'
      #9#9' '
      #9#9' JOIN ( produtos p'
      #9#9' JOIN (((caracteristicas c'
      #9#9' JOIN grupos g'
      #9#9' ON c.grupo = g.codigo)'
      #9#9' JOIN classes cl'
      #9#9' ON c.classe=cl.codigo)'
      #9#9' JOIN marcas ma'
      #9#9' ON c.marca=ma.codigo)'
      #9#9' ON p.caracteristica=c.codigo)'
      #9#9' ON p.codigo = ep.codigoitem'
      
        #9#9' where ((not (c.inativo is not null)) or (c.inativo>:datafinal' +
        '))'
      ''
      ''
      #9') as EP'
      #9'Order BY item, codigoitem'
      ') as T'
      ' WHERE qtdestoque>0'
      '')
