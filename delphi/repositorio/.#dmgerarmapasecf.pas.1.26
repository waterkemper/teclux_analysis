function TdtmGerarMapasECF.TransmitirReducoesZ(
  vNomeArquivo: String; NotificarSplash: TtecProcParametroString): Boolean;
var
  RespostaValidacao, NovoArquivo: String;
  Arquivo: TStringList;
  vNumeroRecibo: String;

  function Consultar(nrRecibo: String): boolean;
  begin
    result := true;
    ACBrBlocoX1.WebServices.ConsultarBlocoX.ArqResp :=
                extractfilepath(vNomeArquivo)+ '\Recibos – Bloco X\'+
                       trocar(extractfilename(vNomeArquivo), '.xml', '_ConsultarBlocoX');

    Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - consultando situação Reduções Z '+extractfilename(vNomeArquivo));

    ACBrBlocoX1.WebServices.ConsultarBlocoX.Clear;
    ACBrBlocoX1.WebServices.ConsultarBlocoX.Recibo := nrRecibo;

    if ACBrBlocoX1.WebServices.ConsultarBlocoX.Executar then
    begin
      if (qryReducoesZsituacaoprocessamentocodigo.AsInteger <> ACBrBlocoX1.WebServices.ConsultarBlocoX.SituacaoProcCod) or
         (qryReducoesZSituacaoProcessamentoDescricao.AsString <> ACBrBlocoX1.WebServices.ConsultarBlocoX.BlocoXRetorno.SituacaoProcStr) or
         (qryReducoesZmensagemprocessamentodescricao.AsString <> ACBrBlocoX1.WebServices.ConsultarBlocoX.BlocoXRetorno.Mensagem) or
         qryReducoesZreciboenviofiscoreducaoz.isnull or
         qryReducoesZsituacaoprocessamentocodigo.isnull then
      begin
        qryReducoesZ.edit;

        if qryReducoesZreciboenviofiscoreducaoz.isnull then
          qryReducoesZreciboenviofiscoreducaoz.AsString := ACBrBlocoX1.WebServices.ConsultarBlocoX.Recibo;

        qryReducoesZsituacaoprocessamentocodigo.AsInteger := ACBrBlocoX1.WebServices.ConsultarBlocoX.SituacaoProcCod;

        qryReducoesZSituacaoProcessamentoDescricao.AsString := ACBrBlocoX1.WebServices.ConsultarBlocoX.BlocoXRetorno.SituacaoProcStr;
        qryReducoesZmensagemprocessamentodescricao.AsString := ACBrBlocoX1.WebServices.ConsultarBlocoX.BlocoXRetorno.Mensagem;

        qryReducoesZ.post;
      end;
    end
    else
    begin
      result := false;

      raise Exception.Create(
        'Não foi possível transmitir o arquivo!' + sLineBreak +
        ACBrBlocoX1.WebServices.ConsultarBlocoX.RetWS);
    end;

  end;



  function Enviar: boolean;
  begin
    result := true;

    if not DirectoryExists(extractfilepath(vNomeArquivo) + '\Recibos – Bloco X') then
      if not CreateDir(extractfilepath(vNomeArquivo) + '\Recibos – Bloco X') then
        raise Exception.Create('Impossível criar o diretório '+extractfilepath(vNomeArquivo) + '\Recibos – Bloco X');

    Arquivo := TStringList.Create;
    try
      Arquivo.LoadFromFile(vNomeArquivo);

      Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Validando xml: Reduções Z '+extractfilename(vNomeArquivo));

  //    ACBrBlocoX1.WebServices.ValidarBlocoX.ArqResp := trocar(vNomeArquivo, '.xml', '_ValidarBlocoX');

  {DEMORA MUITO TEMPO }
      ACBrBlocoX1.WebServices.ValidarBlocoX.Clear;
      ACBrBlocoX1.WebServices.ValidarBlocoX.XML := Arquivo.Text;


      ACBrBlocoX1.WebServices.ValidarBlocoX.Executar;
      RespostaValidacao := ACBrBlocoX1.WebServices.ValidarBlocoX.RetWS;

      if Pos('VALIDADO COM SUCESSO', UpperCase(RespostaValidacao)) > 0 then
      begin
  //      ShowMessage(RespostaValidacao);

        Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Transmitindo xml: Reduções Z '+extractfilename(vNomeArquivo));

        ACBrBlocoX1.WebServices.EnviarBlocoX.ArqResp := extractfilepath(vNomeArquivo)+ '\Recibos – Bloco X\'+
                   trocar(extractfilename(vNomeArquivo), '.xml', '_EnviarBlocoX');

    //      ACBrBlocoX1.WebServices.EnviarBlocoX.RetWS

        ACBrBlocoX1.WebServices.EnviarBlocoX.Clear;
        ACBrBlocoX1.WebServices.EnviarBlocoX.XML := Arquivo.Text;

        Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Gerando zip do xml: Reduções Z '+extractfilename(vNomeArquivo));

        NovoArquivo := ChangeFileExt(vNomeArquivo, '.zip');

        KAZip1.CreateZip(NovoArquivo);
        KAZip1.FileName := NovoArquivo;
        KAZip1.Open(NovoArquivo);
        KAZip1.AddFile(vNomeArquivo);
        KAZip1.Close;

        ACBrBlocoX1.WebServices.EnviarBlocoX.XMLZipado := EncodeBase64(LoadFileToAnsiStr(NovoArquivo));

        Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Transmitindo zip do xml: Reduções Z '+extractfilename(vNomeArquivo));

        if ACBrBlocoX1.WebServices.EnviarBlocoX.Executar then
        begin

          if (pos('Não gerado', ACBrBlocoX1.WebServices.EnviarBlocoX.Recibo)<>0) and
             (pos('O número do recibo é', ACBrBlocoX1.WebServices.EnviarBlocoX.Mensagem)<>0) then
          begin
            vNumeroRecibo := copy(ACBrBlocoX1.WebServices.EnviarBlocoX.Mensagem,
                pos('O número do recibo é',ACBrBlocoX1.WebServices.EnviarBlocoX.Mensagem)+21, 36);

            result := Consultar(vNumeroRecibo);


          end
          else
          begin
            qryReducoesZ.edit;
            qryReducoesZreciboenviofiscoreducaoz.AsString := ACBrBlocoX1.WebServices.EnviarBlocoX.Recibo;
            qryReducoesZsituacaoprocessamentocodigo.AsInteger := ACBrBlocoX1.WebServices.EnviarBlocoX.SituacaoProcCod;

            qryReducoesZSituacaoProcessamentoDescricao.AsString := ACBrBlocoX1.WebServices.EnviarBlocoX.SituacaoProcStr;
            qryReducoesZmensagemprocessamentodescricao.AsString := ACBrBlocoX1.WebServices.EnviarBlocoX.Mensagem;

            qryReducoesZ.post;
          end;
        end
        else
        begin
          result := false;

          raise Exception.Create(
            'Não foi possível transmitir o arquivo!' + sLineBreak +
            ACBrBlocoX1.WebServices.EnviarBlocoX.RetWS);
        end;

      end
      else
      begin
        result := false;
        raise Exception.Create(RespostaValidacao);
      end;
    finally
      Arquivo.Free;
    end;
  end;


begin
  result := true;

  if qryReducoesZreciboenviofiscoreducaoz.AsString <> '' then
    result := Consultar(qryReducoesZreciboenviofiscoreducaoz.AsString)
  else
    result := Enviar;
end;

procedure TdtmGerarMapasECF.qryReducoesZBeforePost(DataSet: TDataSet);
begin
  inherited;
  if vdatahoraenviofiscoreducaoz <> 0 then
    qryReducoesZdatahoraenviofiscoreducaoz.asDatetime := vdatahoraenviofiscoreducaoz;
end;

