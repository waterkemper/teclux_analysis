  qryReducaoZResumoEnvioFiscodescricaodatamovimento.AsString :=
     'Arquivo "Redução Z '+formatdatetime('ddmmyyyy', qryReducaoZResumoEnvioFiscodatamovimento.asDateTime)+
     '" transmitido com sucesso ';

end;

function TdtmGerarMapasECF.TransmitirBlocoXEstoqueMesAnterior(
  vNomeArquivo: String; NotificarSplash: TtecProcParametroString): Boolean;
var
  RespostaValidacao, NovoArquivo: String;
  Arquivo: TStringList;
  vNumeroRecibo: String;

  function Consultar(NrRecibo: String): boolean;
  begin
    result := true;

    Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - consultando situação Estoque Fisco '+extractfilename(vNomeArquivo));

    ACBrBlocoX1.WebServices.ConsultarBlocoX.ArqResp :=
                extractfilepath(vNomeArquivo)+ '\Recibos – Bloco X\'+
                       trocar(extractfilename(vNomeArquivo), '.xml', '_ConsultarBlocoX');

    ACBrBlocoX1.WebServices.ConsultarBlocoX.Recibo := NrRecibo;

    if ACBrBlocoX1.WebServices.ConsultarBlocoX.Executar then
    begin
      if (qryfiscoestoquefiliaissituacaoprocessamentocodigo.AsInteger <> ACBrBlocoX1.WebServices.ConsultarBlocoX.SituacaoProcCod) or
          qryfiscoestoquefiliaisreciboenviofiscoestoque.isnull or
          qryfiscoestoquefiliaissituacaoprocessamentocodigo.isnull or
         (qryfiscoestoquefiliaisSituacaoProcessamentoDescricao.AsString <> ACBrBlocoX1.WebServices.ConsultarBlocoX.BlocoXRetorno.SituacaoProcStr) or
         (qryfiscoestoquefiliaismensagemprocessamentodescricao.AsString <> ACBrBlocoX1.WebServices.ConsultarBlocoX.BlocoXRetorno.Mensagem) then
      begin
        qryfiscoestoquefiliais.edit;
        if qryfiscoestoquefiliaisreciboenviofiscoestoque.isnull then
          qryfiscoestoquefiliaisreciboenviofiscoestoque.asString :=  ACBrBlocoX1.WebServices.ConsultarBlocoX.Recibo;

        qryfiscoestoquefiliaissituacaoprocessamentocodigo.AsInteger := ACBrBlocoX1.WebServices.ConsultarBlocoX.SituacaoProcCod;
        qryfiscoestoquefiliaisSituacaoProcessamentoDescricao.AsString := ACBrBlocoX1.WebServices.ConsultarBlocoX.BlocoXRetorno.SituacaoProcStr;
        qryfiscoestoquefiliaismensagemprocessamentodescricao.AsString := ACBrBlocoX1.WebServices.ConsultarBlocoX.BlocoXRetorno.Mensagem;

        qryfiscoestoquefiliais.post;
      end;
    end
    else
    begin
      result := false;

      raise Exception.Create(
        'Não foi possível transmitir o arquivo!' + sLineBreak +
        ACBrBlocoX1.WebServices.ConsultarBlocoX.RetWS);
    end;


  end;

  Function Enviar: boolean;
  begin
    result := true;
    if not DirectoryExists(extractfilepath(vNomeArquivo) + '\Recibos – Bloco X') then
      if not CreateDir(extractfilepath(vNomeArquivo) + '\Recibos – Bloco X') then
        raise Exception.Create('Impossível criar o diretório '+extractfilepath(vNomeArquivo) + '\Recibos – Bloco X');

    Arquivo := TStringList.Create;
    try
      Arquivo.LoadFromFile(vNomeArquivo);

  //    ACBrBlocoX1.WebServices.ValidarBlocoX.ArqResp := trocar(vNomeArquivo, '.xml', '_ValidarBlocoX');
      Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Validando xml: Estoque Fisco '+extractfilename(vNomeArquivo));

        {DEMORA MUITO TEMPO

      ACBrBlocoX1.WebServices.ValidarBlocoX.Clear;
      ACBrBlocoX1.WebServices.ValidarBlocoX.XML := Arquivo.Text;

      ACBrBlocoX1.WebServices.ValidarBlocoX.Executar;
      RespostaValidacao := ACBrBlocoX1.WebServices.ValidarBlocoX.RetWS;
      }

      if  TRUE {Pos('VALIDADO COM SUCESSO', UpperCase(RespostaValidacao)) > 0} then
      begin
  //      ShowMessage(RespostaValidacao);

        Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Esoque Fisco: Reduções Z '+extractfilename(vNomeArquivo));

        ACBrBlocoX1.WebServices.EnviarBlocoX.ArqResp := extractfilepath(vNomeArquivo)+ '\Recibos – Bloco X\'+
                   trocar(extractfilename(vNomeArquivo), '.xml', '_EnviarBlocoX');

  //      ACBrBlocoX1.WebServices.EnviarBlocoX.RetWS

        ACBrBlocoX1.WebServices.EnviarBlocoX.Clear;
        ACBrBlocoX1.WebServices.EnviarBlocoX.XML := Arquivo.Text;

        Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Gerando zip do xml: Estoque Fisco '+extractfilename(vNomeArquivo));

        NovoArquivo := ChangeFileExt(vNomeArquivo, '.zip');

        KAZip1.CreateZip(NovoArquivo);
        KAZip1.FileName := NovoArquivo;
        KAZip1.Open(NovoArquivo);
        KAZip1.AddFile(vNomeArquivo);
        KAZip1.Close;

        ACBrBlocoX1.WebServices.EnviarBlocoX.XMLZipado := EncodeBase64(LoadFileToAnsiStr(NovoArquivo));

        Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Transmitindo zip do xml: Estoque Fisco '+extractfilename(vNomeArquivo));

        if ACBrBlocoX1.WebServices.EnviarBlocoX.Executar then
        begin

          if (pos('Não gerado', ACBrBlocoX1.WebServices.EnviarBlocoX.Recibo)<>0) and
             (pos('O número do recibo é', ACBrBlocoX1.WebServices.EnviarBlocoX.Mensagem)<>0) then
          begin
            vNumeroRecibo := copy(ACBrBlocoX1.WebServices.EnviarBlocoX.Mensagem,
                pos('O número do recibo é',ACBrBlocoX1.WebServices.EnviarBlocoX.Mensagem)+21, 36);

            result := Consultar(vNumeroRecibo);

          end
          else
          begin
            qryfiscoestoquefiliais.edit;
            qryfiscoestoquefiliaisreciboenviofiscoestoque.AsString := ACBrBlocoX1.WebServices.EnviarBlocoX.Recibo;
            qryfiscoestoquefiliaissituacaoprocessamentocodigo.AsInteger := ACBrBlocoX1.WebServices.EnviarBlocoX.SituacaoProcCod;

            qryfiscoestoquefiliaisSituacaoProcessamentoDescricao.AsString := ACBrBlocoX1.WebServices.EnviarBlocoX.SituacaoProcStr;
            qryfiscoestoquefiliaismensagemprocessamentodescricao.AsString := ACBrBlocoX1.WebServices.EnviarBlocoX.Mensagem;

            qryfiscoestoquefiliais.post;
          end;
        end
        else
        begin
          result := false;

          raise Exception.Create(
            'Não foi possível transmitir o arquivo!' + sLineBreak +
            ACBrBlocoX1.WebServices.EnviarBlocoX.RetWS);
        end;

      end
      else
      begin
        result := false;
        raise Exception.Create(RespostaValidacao);
      end;
    finally
      Arquivo.Free;
    end;

  end;

begin


  result := true;

  if qryfiscoestoquefiliaisreciboenviofiscoestoque.AsString <> '' then
    result := Consultar(qryfiscoestoquefiliaisreciboenviofiscoestoque.AsString)
  else
    result := Enviar;
end;

