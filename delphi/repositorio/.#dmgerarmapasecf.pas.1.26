{ TdtmGerarMapasECF }

procedure TdtmGerarMapasECF.PreencherCabecalhoBlocoX(const AACBrBlocoX: TACBrBlocoX);
begin
  qryWebService.close;
  qryWebService.open;

  with AACBrBlocoX do
  begin

    if qryWebServiceambiente.asString = 'taHomologacao' then
      Configuracoes.WebServices.Ambiente := taHomologacao
    else
    if qryWebServiceambiente.asString = 'taProducao' then
      Configuracoes.WebServices.Ambiente := taProducao;

    if qryWebServicetipo.assTring = 'CAPICOM' then
    begin
      Configuracoes.Geral.SSLLib := libCapicom;
      Configuracoes.Certificados.NumeroSerie := qryWebServiceNumeroSerie.asString;
    end
    else
    if qryWebServicetipo.assTring = 'OPENSSL' then
    begin
      Configuracoes.Geral.SSLLib := libOpenSSL;
      Configuracoes.Certificados.NumeroSerie := qryWebServiceNumeroSerie.asString;
      Configuracoes.Certificados.ArquivoPFX := qryWebServicearquivopfx.asString;
    end;

    Configuracoes.Certificados.Senha       := qryWebServiceSenha.asString;

            {
    Configuracoes.WebServices.ProxyHost := qryWebServiceProxyHost.asString;
    Configuracoes.WebServices.ProxyPort := qryWebServiceProxyPort.asString;
    Configuracoes.WebServices.ProxyUser := qryWebServiceProxyUser.asString;
    Configuracoes.WebServices.ProxyPass := qryWebServiceProxyPass.asString;
    }

    Estabelecimento.Ie              := somentenumero(InscricaoEstadualFilialBase);
    Estabelecimento.Cnpj            := CNPJFilialBase;
    Estabelecimento.NomeEmpresarial := RazaoFilialBase;

    PafECF.Versao                       := Parsistema.VersaoPAFECF;
    PafECF.NumeroCredenciamento         := Parsistema.NumeroCredenciamento; {homologação '9160690001342' ou produção 1606900015251}
    PafECF.NomeComercial                := Parsistema.NomeComercialSistema;
    PafECF.NomeEmpresarialDesenvolvedor := ParSistema.NomeEmpresaDesenvolvedora;
    PafECF.CnpjDesenvolvedor            := ParSistema.CNPJDesenvolvedora;
{
    PafECF.Versao                       := '01.01.01';
    PafECF.NumeroCredenciamento         := '123456789012345';
    PafECF.NomeComercial                := 'NOME COMERCIAL';
    PafECF.NomeEmpresarialDesenvolvedor := 'NOME EMPRESARIAL DO DESENVOLVEDOR';
    PafECF.CnpjDesenvolvedor            := '88888888888888';
 }
  end;
end;


function TdtmGerarMapasECF.GravarMapa(MapaECF: TtecMapaECF): Boolean;
const
  SQLDelete = 'delete from mapasecf where (filial,maquina,intervensao,data) in (%s)';
var
 i,j: integer;
 NumeroCupom, maquina, intervensao: integer;
 ListadeDatas, ListadeChaves, DataAnterior: String;
begin
  maquina := 0;
  intervensao := 0;
  NumeroCupom := 0;
  ListadeDatas  := '';
  ListadeChaves := '';
  for i:=0 to high(MapaECF) do
  begin
    if maquina = 0 then
      maquina := MapaECF[i].maquina;
    if intervensao = 0 then
      intervensao := MapaECF[i].intervensao;

    ListadeDatas := ListadeDatas +
      quotedstr(
      FormatDateTime('yyyy-mm-dd',strtodate(MapaECF[i].data)))+',';
    ListadeChaves := ListadeChaves +
                     '(' + inttostr(FilialBase) + ',' +
                           inttostr(MapaECF[i].maquina) + ',' +
                           inttostr(MapaECF[i].intervensao) + ',' +
                           quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(MapaECF[i].data))) +'),';
  end;

  if ListadeChaves<>'' then
  begin
    Delete(ListadeChaves,length(ListadeChaves),1);
    qryApagarMapasECF.Sql[0] := format(SQLDelete,[ListadeChaves]);
    qryApagarMapasECF.ExecSql;
  end;

  if ListadeDatas<>'' then
  begin
    Delete(ListadeDatas,length(ListadeDatas),1);
    qryCuponsExistentes_MesmaData.MacroByName('ListadeDatas').AsString :=
        'and df.data in ('+ListadeDatas+')';
    ReFazConsulta(qryCuponsExistentes_MesmaData,[0,1,2],
       [filialbase,
        maquina,
        intervensao]);
  end;

  DataAnterior:='';
  for i:=0 to high(MapaECF) do
  begin
    if (DataAnterior='') or
       (DataAnterior<>MapaECF[i].data) then
    begin
      DataAnterior := MapaECF[i].data;
      if qryCuponsExistentes_MesmaData.Locate('data',strtodate(MapaECF[i].data),[]) then
        NumeroCupom := qryCuponsExistentes_MesmaDatacupom.AsInteger
      else
      begin
        ReFazConsulta(qryCuponsExistentes_InferiorData,[0,1,2,3],
           [filialbase,
            maquina,
            intervensao,
            MapaECF[i].Data]);
        if not qryCuponsExistentes_InferiorData.IsEmpty then
          NumeroCupom := qryCuponsExistentes_InferiorDatacupom.AsInteger + 1
        else
        begin
          ReFazConsulta(qryCuponsExistentes_SuperiorData,[0,1,2,3],
             [filialbase,
              maquina,
              intervensao,
              MapaECF[i].Data]);
          if not qryCuponsExistentes_SuperiorData.IsEmpty then
            NumeroCupom := qryCuponsExistentes_InferiorDatacupom.AsInteger - 1
        end;
      end;

      qryIncluirMapasECF.ParamByName('filial').AsInteger := filialbase;
      qryIncluirMapasECF.ParamByName('maquina').AsInteger := MapaECF[i].maquina;
      qryIncluirMapasECF.ParamByName('intervensao').AsInteger := MapaECF[i].intervensao;
      qryIncluirMapasECF.ParamByName('data').AsDateTime := StrToDateTime(MapaECF[i].data);
      qryIncluirMapasECF.ParamByName('cupomfinal').AsInteger := MapaECF[i].cpfinal;
      qryIncluirMapasECF.ParamByName('reducoes').AsInteger := MapaECF[i].reducoes;
      qryIncluirMapasECF.ParamByName('grandetotal').AsCurrency := MapaECF[i].gt;
      qryIncluirMapasECF.ParamByName('cancelamentos').AsCurrency := MapaECF[i].tcanc;
      qryIncluirMapasECF.ParamByName('descontos').AsCurrency := MapaECF[i].tdesc;
      qryIncluirMapasECF.ParamByName('substituicao').AsCurrency := MapaECF[i].tsubs;
      qryIncluirMapasECF.ParamByName('isento').AsCurrency := MapaECF[i].tisen;
      qryIncluirMapasECF.ParamByName('naotributado').AsCurrency := MapaECF[i].tntrb;
      qryIncluirMapasECF.ExecSql;

      for j:=0 to high(MapaECF[i].ttrib) do
      begin
        qryIncluirMapasECFTributados.ParamByName('filial').AsInteger := filialbase;
        qryIncluirMapasECFTributados.ParamByName('maquina').AsInteger := MapaECF[i].maquina;
        qryIncluirMapasECFTributados.ParamByName('intervensao').AsInteger := MapaECF[i].intervensao;
        qryIncluirMapasECFTributados.ParamByName('data').AsDateTime := StrToDateTime(MapaECF[i].data);
        qryIncluirMapasECFTributados.ParamByName('aliquota').AsCurrency :=  MapaECF[i].ttrib[j].aliquota;
        qryIncluirMapasECFTributados.ParamByName('base').AsCurrency := MapaECF[i].ttrib[j].base;
        qryIncluirMapasECFTributados.ParamByName('valor').AsCurrency := MapaECF[i].ttrib[j].valor;
        qryIncluirMapasECFTributados.ExecSql;
      end;
    end;
  end;
  result := Perpetrar([qryApagarMapasECF,qryIncluirMapasECF,qryIncluirMapasECFTributados]);
end;

function TdtmGerarMapasECF.GravarReducaoZ(
  ReducoesZ: TTecReducoesZ): Boolean;
var
  I: integer;
  DataString: string;

begin
  result := true;

  try
    with ReducoesZ do
    begin
      if Datamovimento<>0 then
      begin
        qryReducoesz.open;
        qryReducoesZDetalhes.open;

        qryReducoesz.Append;
        qryReducoesZ.FieldByName('NumeroFabricacao').AsString  := Numerofabricacao;
        qryReducoesZ.FieldByName('Filial'          ).AsInteger := FilialBase;
        qryReducoesZ.FieldByName('MFadicional'     ).AsString  := MFadicional;
        qryReducoesZ.FieldByName('ModelodoECF'     ).AsString  := ModeloECF;
        qryReducoesZ.FieldByName('Numerousuario'   ).AsInteger := Numerousuario;
        qryReducoesZ.FieldByName('CRZ'             ).AsInteger := CRZ;
        qryReducoesZ.FieldByName('COO'             ).AsInteger := COO;
        qryReducoesZ.FieldByName('COO_Inicial'     ).AsInteger := COO_Inicial;
        qryReducoesZ.FieldByName('COO_Final'       ).AsInteger := COO_Final;
        qryReducoesZ.FieldByName('CRO'             ).AsInteger := CRO;
        qryReducoesZ.FieldByName('DataMovimento'   ).AsDateTime := Datamovimento;
        qryReducoesZ.FieldByName('DataEmissao'     ).AsDateTime := Dataemissao;
        qryReducoesZ.FieldByName('HoraEmissao'     ).AsDateTime := Dataemissao;
        qryReducoesZ.FieldByName('VendaBrutaDiaria').AsCurrency := VendaBrutaDiaria;
        qryReducoesZ.FieldByName('totalizadorgeral').AsCurrency := TotalizadorGeral;
        qryReducoesZ.FieldByName('ParametroIncidenciaISSQN').AsString := ParametroincidenciaISSQN;
        qryReducoesZorigeminformacao.asString := origeminformacao;

        qryReducoesZdatahoraenviofiscoreducaoz.asvariant := null;
        qryReducoesZreciboenviofiscoreducaoz.asvariant := null;
        qryReducoesZsituacaoprocessamentocodigo.asvariant := null;
        qryReducoesZsituacaoprocessamentodescricao.asvariant := null;
        qryReducoesZmensagemprocessamentodescricao.asvariant := null;
        qryReducoesZ.FieldByName('hash_paf_registro_r02').AsString :=  ACBrEAD1.MD5FromString(Numerofabricacao +
                                                                                             inttostr(CRZ) +
                                                                                             inttostr(COO)+
                                                                                             inttostr(CRO)+
                                                                                             DateToStr(Datamovimento)+
                                                                                             DateTimeToStr(Dataemissao)+
                                                                                             DateTimeToStr(Horaemissao)+
                                                                                             Trim(Trocar(Trocar(formatarvalor(VendaBrutaDiaria,2),'.',''),',','.')));
        qryReducoesz.Post;
{  md5(numerofabricacao ||cast(crz as varchar)||cast(coo as varchar)||cast(cro as varchar)||cast(datamovimento as varchar)||cast(dataemissao as varchar)
      ||cast(horaemissao as varchar)||cast(vendabrutadiaria as varchar))}


        for I:=0 to high(DetalhesReducaoZ) do
        begin
          qryReducoesZDetalhes.Append;
          qryReducoesZDetalhes.FieldByName('Filial').AsInteger := FilialBase;
          qryReducoesZDetalhes.FieldByName('Numerousuario').AsInteger := Numerousuario;
          qryReducoesZDetalhes.FieldByName('CRO').AsInteger := CRO;
          qryReducoesZDetalhes.FieldByName('NumeroFabricacao').AsString  := Numerofabricacao;
          qryReducoesZDetalhes.FieldByName('DataMovimento').AsDateTime := Datamovimento;

          qryReducoesZDetalhes.FieldByName('TipoTotalizadorParcial').AsString := DetalhesReducaoZ[i].TipoTotalizadorParcial;
          qryReducoesZDetalhes.FieldByName('aliquota').AsCurrency := DetalhesReducaoZ[i].aliquota;
          qryReducoesZDetalhes.FieldByName('ValorAcumulado').AsCurrency := DetalhesReducaoZ[i].ValorAcumulado;
          qryReducoesZDetalhes.FieldByName('hash_paf_registro_R03').AsString :=  ACBrEAD1.MD5FromString(Numerofabricacao +
                                                                                             inttostr(Numerousuario) +
                                                                                             datetostr(Datamovimento)+
                                                                                             DetalhesReducaoZ[i].TipoTotalizadorParcial+
                                                                                             Trim(Trocar(Trocar(formatarvalor(DetalhesReducaoZ[i].aliquota,2),'.',''),',','.'))+
                                                                                             Trim(Trocar(Trocar(formatarvalor(DetalhesReducaoZ[i].ValorAcumulado,2),'.',''),',','.'))+
                                                                                             IntToStr(CRZ));
          qryReducoesZDetalhes.post;
        end;
      end;
    end;
  except
   on E: Exception do
    begin
      ShowMessage(E.Message);
      Result := false;
    end;
  end;
end;

function TdtmGerarMapasECF.GravarReducaoZ(Gravar: boolean): Boolean;
begin
  result := false;
  if gravar then
  begin
    if Perpetrar([qryreducoesz, qryreducoeszdetalhes]) then
    begin

      qryRegistro_R02.Close;
      qryRegistro_R02.Open;
      CopiarRegistros(qryreducoesZ, qryRegistro_R02 );

      qryRegistro_R03.Close;
      qryRegistro_R03.Open;

      CopiarRegistros(qryReducoesZDetalhes, qryRegistro_R03 );

      qryIncluir_Registro_R04.ParamByName('filial').asinteger := qryReducoesZfilial.asinteger;
      qryIncluir_Registro_R04.ParamByName('num_usu').asinteger := qryReducoesZnumerousuario.AsInteger;
      qryIncluir_Registro_R04.ParamByName('cro').asinteger := qryReducoesZcro.AsInteger;
      qryIncluir_Registro_R04.ParamByName('crz').asinteger := qryReducoesZcrz.AsInteger;
      qryIncluir_Registro_R04.ParamByName('num_fab').AsString := qryReducoesZnumerofabricacao.AsString;
      qryIncluir_Registro_R04.ExecSql;


      qryIncluir_Registro_R05.ParamByName('filial').asinteger := qryReducoesZfilial.asinteger;
      qryIncluir_Registro_R05.ParamByName('num_usu').asinteger := qryReducoesZnumerousuario.AsInteger;
      qryIncluir_Registro_R05.ParamByName('cro').asinteger := qryReducoesZcro.AsInteger;
      qryIncluir_Registro_R05.ParamByName('crz').asinteger := qryReducoesZcrz.AsInteger;
      qryIncluir_Registro_R05.ParamByName('num_fab').AsString := qryReducoesZnumerofabricacao.AsString;
      qryIncluir_Registro_R05.ExecSql;


      qryIncluir_Registro_R06.ParamByName('filial').asinteger := qryReducoesZfilial.asinteger;
      qryIncluir_Registro_R06.ParamByName('num_usu').asinteger := qryReducoesZnumerousuario.AsInteger;
      qryIncluir_Registro_R06.ParamByName('cro').asinteger := qryReducoesZcro.AsInteger;
      qryIncluir_Registro_R06.ParamByName('coo_inicial').asinteger := qryReducoesZcoo_inicial.AsInteger;
      qryIncluir_Registro_R06.ParamByName('coo_final').asinteger := qryReducoesZcoo_final.AsInteger;
      qryIncluir_Registro_R06.ParamByName('num_fab').AsString := qryReducoesZnumerofabricacao.AsString;
      qryIncluir_Registro_R06.ExecSql;

      qryIncluir_Registro_R07.ParamByName('filial').asinteger := qryReducoesZfilial.asinteger;
      qryIncluir_Registro_R07.ParamByName('num_usu').asinteger := qryReducoesZnumerousuario.AsInteger;
      qryIncluir_Registro_R07.ParamByName('cro').asinteger := qryReducoesZcro.AsInteger;
      qryIncluir_Registro_R07.ParamByName('coo_inicial').asinteger := qryReducoesZcoo_inicial.AsInteger;
      qryIncluir_Registro_R07.ParamByName('coo_final').asinteger := qryReducoesZcoo_final.AsInteger;
      qryIncluir_Registro_R07.ParamByName('num_fab').AsString := qryReducoesZnumerofabricacao.AsString;
      qryIncluir_Registro_R07.ExecSql;


       //u1,a2,e2,e3,p2,j1,j2,r01..r07,


      result := perpetrar([qryRegistro_R02, qryRegistro_R03, qryIncluir_Registro_R04, qryIncluir_Registro_R05,
         qryIncluir_Registro_R06, qryIncluir_Registro_R07]);

      
      {
      registro_r04 - Detalhe Cupom
      registro_r05 - Dados Item Cupom
      regsitro_r06 - Detalhe Demais Doctos
      registro_r07 - FormasPagamentoECF
      }

      if result then
      begin
        result := AtualizaHashInclusaoExclusao;

        if result then
        begin
          BlocoXReducaoZ(nil);
          BlocoXEstoqueMesAnterior(nil);
        end;
      end;


    end;
  end;


end;

procedure TdtmGerarMapasECF.ZMonitor1MonitorEvent(Sql, Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\logecf2.txt') then
    Listar.loadfromfile('c:\logecf2.txt');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\logecf2.txt');
  listar.free;
end;

function TdtmGerarMapasECF.BlocoXReducaoZ(NotificarSplash: TtecProcParametroString){(OpcaoFonteDados: Byte; DataInicial, DataFinal: TDateTime; CrzInicial, crzFinal: Integer; AposREducaoZ: boolean)}: boolean;
var
  vNomeArquivo, vNomeArquivoAssinado : String;
  vMensagemReducaoZ: String;

const
  msgReducaoZPendente = 'HÁ %s ARQUIVOS COM INFORMAÇÕES DA REDUÇÃO Z DO PAF-ECF ' + chr(13) +
                        'PENDENTES DE TRANSMISSÃO AO FISCO. O CONTRIBUINTE PODE TRANSMITIR ' + chr(13) +
                        'OS ARQUIVOS PELO MENU FISCAL POR MEIO DO COMANDO "TRANSMITIR ARQUIVO REDUÇÃO Z DDMMAAAA."';

  msgReducaoZPendenteAdicional = 'VERIFIQUE COM O FORNECEDOR DO PROGRAMA A SOLUÇÃO DA PENDÊNCIA';

  msgReducaoZPendenteBloquear = 'A PARTIR DA 20ª TRANSMISSÃO PENDENTE, O SEU PROGRAMA SERÁ ' + chr(13) +
                                'BLOQUEADO E SOMENTE SERÁ LIBERADO APÓS TODAS AS TRANSMISSÕES ' + chr(13) +
                                'SEREM REALIZADAS. VERIFIQUE URGENTEMENTE COM O FORNECEDOR DO ' + chr(13) +
                                'PROGRAMA A SOLUÇÃO DA PENDÊNCIA';
begin
  if parsistema.Data_Inicial_Envio_ao_Fisco <> 0 then 
  begin

    try

      Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Abrindo Tabelas: Reduções Z');

      result := true;
      vdatahoraenviofiscoreducaoz := DataHoraServidor;

      qryReducoesZ.parambyname('DataInicial').asDateTime := parsistema.Data_Inicial_Envio_ao_Fisco;
      qryReducoesZ.macrobyname('Condicao').asString := ' rz.datamovimento >= :DataInicial '+
                                                       ' and (rz.reciboenviofiscoreducaoz is null or '+
                                                       ' (rz.reciboenviofiscoreducaoz is not null and '+
                                                       '  rz.SituacaoProcessamentoCodigo in (0,2))) /* and rz.crz=1421 */';

      qryReducoesZDetalhes.parambyname('DataInicial').asDateTime := parsistema.Data_Inicial_Envio_ao_Fisco;
      qryReducoesZDetalhes.macrobyname('Condicao').asString := qryReducoesZ.macrobyname('Condicao').asString;

      qryDadosItemCupom.parambyname('DataInicial').asDateTime := parsistema.Data_Inicial_Envio_ao_Fisco;
      qryDadosItemCupom.macrobyname('Condicao').asString := qryReducoesZ.macrobyname('Condicao').asString;


      qryReducoesZ.close;
      qryReducoesZ.open;

      qryReducoesZDetalhes.close;
      qryReducoesZDetalhes.Open;

      qryDadosItemCupom.close;
      qryDadosItemCupom.open;



      qryReducoesZ.first;
  //    qryReducoesZ.last;

       PreencherCabecalhoBlocoX(ACBrBlocoX1);

      Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Gerando arquivo: Reduções Z');

      while not qryReducoesZ.eof do
      begin

        if (qryECFsfilial.asinteger <> qryReducoesZfilial.asinteger) or
           (qryECFsmaquina.Asinteger <> qryReducoesZnumerousuario.asinteger) or
           (qryECFsserie.AsString <> qryReducoesZnumerofabricacao.asString) then
        begin

          refazConsultapornome(qryEcfs, ['filial','maquina','intervencao','serie'],
           [qryReducoesZfilial.asinteger, qryReducoesZnumerousuario.asinteger, qryReducoesZcro.asinteger, qryReducoesZnumerofabricacao.asString]);

          if qryEcfs.recordcount = 0 then
          begin
            MensagemErro('ECfs não encontrada '+
             qryReducoesZfilial.asString +' '+
             qryReducoesZnumerousuario.asString+' '+
             qryReducoesZcro.asString+' '+
             qryReducoesZnumerofabricacao.asString);
            exit;
          end;

        end;


        if qryReducoesZreciboenviofiscoreducaoz.IsNull then
        begin

          with ACBrBlocoX1 do
          begin

            ECF.NumeroFabricacao := qryReducoesZnumerofabricacao.asString;
            ECF.Tipo             := qryECFstipo.asString;
            ECF.Marca            := qryECFsmarca.asString;
            ECF.Modelo           := qryECFsmodelo.asString;
            ECF.Versao           := qryECFsversao_sb.asString;
            ECF.Caixa            := qryECFsmaquina.asString;

            with ReducoesZ do
            begin

              ReducoesZ.DataReferencia   := qryReducoesZ.FieldByName('datamovimento'   ).AsDateTime;
              ReducoesZ.DataHoraEmissaoReducaoZ  := qryReducoesZ.FieldByName('dataemissao').AsDateTime;
              ReducoesZ.CRZ              := qryReducoesZ.FieldByName('crz'             ).AsInteger;
              ReducoesZ.COO              := qryReducoesZ.FieldByName('coo'             ).AsInteger;
              ReducoesZ.CRO              := qryReducoesZ.FieldByName('cro'             ).AsInteger;
              ReducoesZ.VendaBrutaDiaria := qryReducoesZ.FieldByName('vendabrutadiaria').AsCurrency;
              ReducoesZ.GT               := qryReducoesZ.FieldByName('totalizadorgeral').AsCurrency;

              TotalizadoresParciais.Clear;
              qryReducoesZDetalhes.first;
              while not qryReducoesZDetalhes.eof do
              begin
                with TotalizadoresParciais.Add do
                begin
                  Identificacao := qryReducoesZDetalhes.FieldByName('TipoTotalizadorParcial').AsString;
                  Valor       := qryReducoesZDetalhes.FieldByName('ValorAcumulado').AsCurrency;

                  qryDadosItemCupom.first;

                  while not qryDadosItemCupom.eof do
                  begin
                    with Produtos.Add do
                    begin

                      Codigo.Tipo   := tpcProprio;
                      Codigo.CodigoProprio := qryDadosItemCupom.fieldbyname('cod_item').asString;
                      {Codigo.CodigoGTIN, CodigoCEST e CodigoNCMSH}
                      if somentenumero(qryDadosItemCupom.FieldByName('classificacaofiscal').asString) <> '' then
                        Codigo.CodigoNCMSH := somentenumero(qryDadosItemCupom.FieldByName('classificacaofiscal').asString)
                       else
                        Codigo.CodigoNCMSH := '00000000';

                      Descricao      := qryDadosItemCupom.fieldbyname('desc_item').asString;
                      Quantidade     := qryDadosItemCupom.fieldbyname('qtde_item').asInteger;
                      Unidade        := qryDadosItemCupom.fieldbyname('un_med').asString;
                      ValorUnitario  := qryDadosItemCupom.fieldbyname('vl_unit').ascurrency;
                      ValorDesconto  := qryDadosItemCupom.fieldbyname('descto_item').ascurrency;
                      ValorAcrescimo := qryDadosItemCupom.fieldbyname('acres_item').ascurrency;
                      ValorCancelamento := qryDadosItemCupom.fieldbyname('vl_canc').ascurrency;
                      ValorTotalLiquido := qryDadosItemCupom.fieldbyname('vl_tot_item').ascurrency;

                    end;
                    qryDadosItemCupom.next;
                  end;

                  qryReducoesZDetalhes.next;
                end;
              end;
            end;
          end;
        end;

        vNomeArquivo := ExtractFilePath(Application.ExeName) + 'PAF-ECF';

        if not DirectoryExists(vNomeArquivo) then
          if not CreateDir(vNomeArquivo) then
          raise Exception.Create('Impossível criar o diretório '+vNomeArquivo);

        vNomeArquivo := vNomeArquivo + '\REDUCOES_Z';

        if not DirectoryExists(vNomeArquivo) then
          if not CreateDir(vNomeArquivo) then
          raise Exception.Create('Impossível criar o diretório '+vNomeArquivo);

                 {
        vNomeArquivo := vNomeArquivo+'\'+preencheString(somentenumero(qryReducoesZversao_sb.asString),'0',6,false)+
                                         preencheString(qryReducoesZ.FieldByName('NumeroFabricacao').AsString,'0',14,false)+'_'+
                                         FormatDateTime('ddmmyyyy', qryReducoesZdatamovimento.asdatetime)+'_'+
                                         qryReducoesZ.FieldByName('CRO'             ).AsString+'_'+
                                         qryReducoesZ.FieldByName('CRZ'             ).AsString+'.xml';


        Redução Z DDMMAAAA
                 }

        vNomeArquivo := vNomeArquivo+'\Redução Z'+
                                         FormatDateTime('ddmmyyyy', qryReducoesZdatamovimento.asdatetime)+'_'+
                                         qryReducoesZ.FieldByName('codigo_ecf').AsString+'_.xml';


        if qryReducoesZreciboenviofiscoreducaoz.IsNull then
          ACBrBlocoX1.ReducoesZ.SaveToFile(vNomeArquivo, true);

        if not TransmitirReducoesZ(vNomeArquivo, NotificarSplash ) then
        begin
          result := false;
          break;
        end;

        qryReducoesZ.next;
      end;

      if result then
        result := perpetrar([qryReducoesZ]);

      refazConsultaporNome(qryReducaoZResumoEnvioFisco, ['datahoraenviofiscoreducaoz'],
                    [vdatahoraenviofiscoreducaoz]);

      if qryReducaoZResumoEnvioFisco.recordcount <> 0 then
      begin

        vMensagemReducaoZ := RetornarLista(qryReducaoZResumoEnvioFisco, qryReducaoZResumoEnvioFiscodescricaodatamovimento);
        vMensagemReducaoZ := trocar(vMensagemReducaoZ, ',', chr(13));

        MensagemAviso(vMensagemReducaoZ)
                                                                     {
        frmMensagemGrid := TfrmMensagemGrid.Create(frmMensagemGrid);
        frmMensagemGrid.Caption := 'Reduções Z enviadas ao fisco';
        frmMensagemGrid.lblTitulo.Caption := 'Reduções Z enviadas ao fisco';
        frmMensagemGrid.lblTExto.Caption := 'Na lista abaixo estão as Reduções Z Enviados ao fisco';
        frmMensagemGrid.dbgMensagem.DataSource := dsrReducaoZResumoEnvioFisco;
        frmMensagemGrid.ShowModal;
        frmMensagemGrid.Free;
            }
      end;

    finally

  //    result := true;
      vBloquearSistemaReducaoZPendente := false;

      refazConsultaporNome(qryQtReducoaZPendentes, ['DataInicialEnvioAoFisco'],
                    [ParSistema.Data_Inicial_Envio_ao_Fisco]);

      if qryQtReducoaZPendentesqt.AsInteger <> 0 then
      begin

        vMensagemReducaoZ :=  format(msgReducaoZPendente, [qryQtReducoaZPendentesqt.AsString]);

        if (qryQtReducoaZPendentesqt.AsInteger in [5..8]) then
        begin
          vMensagemReducaoZ := vMensagemReducaoZ + chr(13) + msgReducaoZPendenteAdicional;
          MensagemAviso(vMensagemReducaoZ);
        end
        else
        if (qryQtReducoaZPendentesqt.AsInteger >= 9) then
        begin
          vBloquearSistemaReducaoZPendente := qryQtReducoaZPendentesqt.AsInteger > 19;
          vMensagemReducaoZ := vMensagemReducaoZ + chr(13) + msgReducaoZPendenteBloquear;
          if vBloquearSistemaReducaoZPendente then
            MensagemAviso(vMensagemReducaoZ)
          else
            MensagemErro(vMensagemReducaoZ);
        end
        else
          MensagemAviso(vMensagemReducaoZ);
      end;

    end;

  end;

end;

function TdtmGerarMapasECF.BlocoXEstoqueMesAnterior(NotificarSplash: TtecProcParametroString) {(DataInicial, DataFinal: TDateTime; AposREducaoZ: boolean)}: boolean;
var
  vNomeArquivo : String;
  vMensagem: String;

const
  msgReducaoZPendente = 'HÁ %s ARQUIVOS COM INFORMAÇÕES DO ESTOQUE MENSAL DO ' + chr(13) +
                        'ESTABELECIMENTO PENDENTES DE TRANSMISSÃO AO FISCO. O CONTRIBUINTE ' + chr(13) +
                        'PODE TRANSMITIR OS ARQUIVOS PELO MENU FISCAL POR MEIO DO COMANDO ' + chr(13) +
                        '"TRANSMITIR ARQUIVO ESTOQUE MENSAL MMAAAA"';

  msgReducaoZPendenteAdicional = 'VERIFIQUE COM O FORNECEDOR DO PROGRAMA A SOLUÇÃO DA PENDÊNCIA';

  msgReducaoZPendenteBloquear = 'A PARTIR DA 5ª TRANSMISSÃO PENDENTE, O SEU PROGRAMA SERÁ ' + chr(13) +
                                'BLOQUEADO E SOMENTE SERÁ LIBERADO APÓS TODAS AS TRANSMISSÕES ' + chr(13) +
                                'SEREM REALIZADAS. VERIFIQUE URGENTEMENTE COM O FORNECEDOR DO ' + chr(13) +
                                'PROGRAMA A SOLUÇÃO DA PENDÊNCIA.';
                                
begin
  if parsistema.Data_Inicial_Envio_ao_Fisco <> 0 then 
  begin
    try

      result := true;
      Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Abrindo Tabelas: Estoque fisco');

      vdatahoraenviofiscoreducaoz := DataHoraServidor;


      qryIncluirfiscoestoquefiliais.parambyname('filial').AsInteger := filialbase;
      if formatdatetime('dd/mm/yyyy',parsistema.Data_Inicial_Envio_ao_Fisco) = '30/12/1899' then
        qryIncluirfiscoestoquefiliais.parambyname('Data_Inicial_Envio_ao_Fisco').asDateTime := dataservidor
      else
        qryIncluirfiscoestoquefiliais.parambyname('Data_Inicial_Envio_ao_Fisco').asDateTime := parsistema.Data_Inicial_Envio_ao_Fisco;

      qryApagarfiscoestoquefiliais.close;
      qryApagarfiscoestoquefiliais.open;
      perpetrar([qryApagarfiscoestoquefiliais]);

      qryIncluirfiscoestoquefiliais.close;
      qryIncluirfiscoestoquefiliais.open;
      perpetrar([qryIncluirfiscoestoquefiliais]);

      qryfiscoestoquefiliais.parambyname('filial').asinteger := filialbase;
      qryfiscoestoquefiliais.close;
      qryfiscoestoquefiliais.Open;

      PreencherCabecalhoBlocoX(ACBrBlocoX1);


      with ACBrBlocoX1 do
      begin

        qryfiscoestoquefiliais.first;
        while not qryfiscoestoquefiliais.eof do
        begin
          result := true;



          if qryfiscoestoquefiliaisreciboenviofiscoestoque.IsNull then
          begin

            RefazConsultaPorNome(qryfiscoestoqueprodutos,
                                ['filial','dataestoque'],
                                [qryfiscoestoquefiliaisfilial.asinteger,
                                 qryfiscoestoquefiliaisdataestoque.asDatetime]);

            if qryfiscoestoqueprodutos.RecordCount = 0 then
            begin
              qryIncluirfiscoestoqueprodutos.ParamByName('filial').asinteger := qryfiscoestoquefiliaisfilial.asinteger;
              qryIncluirfiscoestoqueprodutos.ParamByName('datafinal').asDateTime := qryfiscoestoquefiliaisdataestoque.asDateTime;
              qryIncluirfiscoestoqueprodutos.close;
              qryIncluirfiscoestoqueprodutos.open;
              perpetrar([qryIncluirfiscoestoqueprodutos]);

              RefazConsultaPorNome(qryfiscoestoqueprodutos,
                                  ['filial','dataestoque'],
                                  [qryfiscoestoquefiliaisfilial.asinteger,
                                   qryfiscoestoquefiliaisdataestoque.asDatetime]);

            end;


            with Estoque do
            begin

              ACBrBlocoX1.Estoque.Produtos.clear;


              qryfiscoestoqueprodutos.first;
              while not qryfiscoestoqueprodutos.eof do
              begin
                ACBrBlocoX1.Estoque.DataReferencia := qryfiscoestoquefiliaisdataestoque.asDateTime;
                with Produtos.Add do
                begin
                  Codigo.Tipo             := tpcProprio;
                  Codigo.CodigoProprio    := qryfiscoestoqueprodutoscodigoitem.ASsTRING;

                  {Codigo.CodigoGTIN, CodigoCEST e CodigoNCMSH}
                  if somentenumero(qryfiscoestoqueprodutosclassificacaofiscal.asString) <> '' then
                    Codigo.CodigoNCMSH := somentenumero(qryfiscoestoqueprodutosclassificacaofiscal.asString)
                   else
                    Codigo.CodigoNCMSH := '00000000';

                  Descricao               := qryfiscoestoqueprodutositem.asString;
                  ValorUnitario           := qryfiscoestoqueprodutosvl_item.asCurrency;
                  Ippt                    := ipptTerceiros;

                  if qryfiscoestoqueprodutossituacaotributaria.asString = 'I' then
                    SituacaoTributaria      := stIsento
                  else
                  if qryfiscoestoqueprodutossituacaotributaria.asString = 'N' then
                    SituacaoTributaria      := stNaoTributado
                  else
                  if qryfiscoestoqueprodutossituacaotributaria.asString = 'F' then
                    SituacaoTributaria      := stSubstTributaria
                  else
                  if qryfiscoestoqueprodutossituacaotributaria.asString = 'T' then
                    SituacaoTributaria      := stTributado;

                  Aliquota                := qryfiscoestoqueprodutosaliquota.asCurrency;
                  Unidade                 := qryfiscoestoqueprodutosunidade.asString;
                  Quantidade              := qryfiscoestoqueprodutosqtdestoque.asInteger;
                  IndicadorArredondamento := False;
                end;

                qryfiscoestoqueprodutos.next;
              end;
            end;
          end;



          vNomeArquivo := ExtractFilePath(Application.ExeName) + 'PAF-ECF';

          if not DirectoryExists(vNomeArquivo) then
            if not CreateDir(vNomeArquivo) then
             raise Exception.Create('Impossível criar o diretório '+vNomeArquivo);

          vNomeArquivo := vNomeArquivo + '\FISCO-ESTOQUE';

          if not DirectoryExists(vNomeArquivo) then
            if not CreateDir(vNomeArquivo) then
            raise Exception.Create('Impossível criar o diretório '+vNomeArquivo);

            {
            Estoque Mensal MMAAAA
            }
          vNomeArquivo := vNomeArquivo+'\'+'Estoque Mensal '+
                                           formatdatetime('MMYYYY',qryfiscoestoquefiliaisdataestoque.asDateTime)+'.xml';

          Notificar(NotificarSplash, 'Verificando Pendencias de Envio ao Fisco - Gerando arquivo: Estoque Fisco'+ExtractFileName(vNomeArquivo) );

          if qryfiscoestoquefiliaisreciboenviofiscoestoque.IsNull then
            ACBrBlocoX1.Estoque.SaveToFile(vNomeArquivo, true);

          if not TransmitirBlocoXEstoqueMesAnterior(vNomeArquivo, NotificarSplash) then
          begin
            result := false;
            break;
          end;

          qryfiscoestoquefiliais.next;

        end;
      end;


      if result then
        result := perpetrar([qryfiscoestoquefiliais]);

      refazConsultaporNome(qryfiscoestoquefiliaisResumoEnvioFisco, ['datahoraenviofiscoestoque'],
                    [vdatahoraenviofiscoreducaoz]);

      if qryfiscoestoquefiliaisResumoEnvioFisco.recordcount <> 0 then
      begin

        vMensagem := RetornarLista(qryfiscoestoquefiliaisResumoEnvioFisco, qryfiscoestoquefiliaisResumoEnvioFiscoDescricaoDataEstoque);
        vMensagem := trocar(vMensagem, ',', chr(13));

        MensagemAviso(vMensagem)
      end;

    finally

      vBloquearSistemaEstoqueFisco := false;

      refazConsultaporNome(qryQtEstoqueFiscoPendente, ['DataInicialEnvioAoFisco'],
                    [ParSistema.Data_Inicial_Envio_ao_Fisco]);

      if qryQtEstoqueFiscoPendenteqt.AsInteger <> 0 then
      begin

        vMensagem :=  format(msgReducaoZPendente, [qryQtEstoqueFiscoPendenteqt.AsString]);

        if (qryQtEstoqueFiscoPendenteqt.AsInteger in [2..3]) then
        begin
          vMensagem := vMensagem + chr(13) + msgReducaoZPendenteAdicional;
          MensagemAviso(vMensagem);
        end
        else
        if (qryQtEstoqueFiscoPendenteqt.AsInteger >= 4) then
        begin
          vBloquearSistemaEstoqueFisco := qryQtEstoqueFiscoPendenteqt.AsInteger > 5;
          vMensagem := vMensagem + chr(13) + msgReducaoZPendenteBloquear;
          if vBloquearSistemaEstoqueFisco then
            MensagemAviso(vMensagem)
          else
            MensagemErro(vMensagem);
        end
        else
          MensagemAviso(vMensagem);
      end;
    end;
  end;
end;

