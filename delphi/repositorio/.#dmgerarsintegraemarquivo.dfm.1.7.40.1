    Sql.Strings = (
      'select distinct'
      '       cast('#39'75'#39' as char(2)) as tipo,'
      '       cast(null as date) as validadeinicial,'
      '       cast(null as date) as validadefinal,'
      '       p.codigo as cod_item,'
      ''
      '      (select i.classificacaofiscal'
      '       from ipi i'
      '       where i.codigo = c.ipi) as classificacaofiscal,'
