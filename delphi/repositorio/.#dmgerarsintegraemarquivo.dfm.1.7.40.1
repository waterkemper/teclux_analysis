    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'select tipo, subtipo, datamovimento, numerofabricacao, totalizad' +
        'or, sum(valoracumulado) as valoracumulado'
      'from'
      '('
      'select cast('#39'60'#39' as char(2)) as tipo,'
      '       cast('#39'A'#39' as char(1)) as subtipo,'
      '       datamovimento,'
      '       numerofabricacao,'
      '       totalizador,'
      '       valoracumulado'
      'from'
      ''
      '  ('
      '    select'
      ''
      '           rz.datamovimento,'
      '           rz.numerofabricacao,'
      
        '           (case when position(cast('#39'S'#39' as varchar) in rzd.tipot' +
        'otalizadorparcial)<>0 then cast('#39'ISS'#39' as varchar(4))'
      
        '                when rzd.tipototalizadorparcial='#39'I1'#39'            ' +
        ' then cast('#39'I'#39'as varchar(4))'
      
        '                when rzd.tipototalizadorparcial='#39'F1'#39'            ' +
        ' then cast('#39'F'#39'as varchar(4))'
      
        '                when rzd.tipototalizadorparcial='#39'N1'#39'            ' +
        ' then cast('#39'N'#39'as varchar(4))'
      
        '                when rzd.tipototalizadorparcial='#39'Can-T'#39'         ' +
        ' then cast('#39'CANC'#39'as varchar(4))'
      
        '                when rzd.tipototalizadorparcial='#39'DT'#39'            ' +
        ' then cast('#39'DESC'#39'as varchar(4))'
      
        '           else cast(substring(rzd.tipototalizadorparcial from 4' +
        ' for 4)as varchar(4))'
      '           end) as totalizador,'
      ''
      '           rzd.valoracumulado'
      ''
      '    from reducoesz rz'
      '         join reducoeszdetalhes rzd'
      '         on   rz.filial = rzd.filial'
      '         and  rz.numerousuario = rzd.numerousuario'
      '         and  rz.cro = rzd.cro'
      '         and  rz.datamovimento = rzd.datamovimento'
      '    where rz.filial = :filial'
      '      and rz.datamovimento between :datainicial and :datafinal'
      
        '      and rzd.tipototalizadorparcial not in ('#39'AT'#39','#39'AS'#39','#39'OPNF'#39')  ' +
        '/*???*/'
      ''
      '    order by rz.datamovimento, rz.numerofabricacao'
      '  ) as reducoes'
      ') as reducoes'
      
        'group by tipo, subtipo, datamovimento,  numerofabricacao, totali' +
        'zador'
      'order by datamovimento, numerofabricacao'
      '')
