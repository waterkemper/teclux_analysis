      end>
    Sql.Strings = (
      '('
      '  SELECT'
      
        '   case when np.cnpj='#39#39' then cast(0 as varchar) else coalesce(np' +
        '.cnpj, cast(0 as varchar)) end as cnpj,'
      
        '   case when (mod(pnp.codigofiscal,1000) in (250,251,252,253,254' +
        ',255,256,257,258,259))  then cast('#39'06'#39' as varchar(2))'
      
        '            when (mod(pnp.codigofiscal,1000) in (300,301,302,303' +
        ',304,305,306,307,308,309))  then cast('#39'22'#39' as varchar(2))'
      '            else  cast('#39'01'#39' as varchar(2)) end as modelo,'
      '   np.serie,'
      '   np.numero,'
      '   pnp.codigofiscal,'
      '   pnp.incidencia,'
      '   pnp.numero as numeroproduto,'
      '   pnp.produto,'
      '   pnp.quantidade,'
      '   pnp.quantidade * pnp.precounitario as ValordoProduto,'
      
        '   coalesce(pnp.desconto,0) + coalesce(pnp.valordescontoitem,0) ' +
        '+ coalesce(pnp.despesasacessorias,0) as ValordoDesconto,'
      ''
      '   case when incidencia in ('#39'00'#39','#39'20'#39') then'
      
        '            round((pnp.quantidade * pnp.precounitario) / (select' +
        ' sum(pnp2.quantidade * pnp2.precounitario)'
      
        '                                                    from produto' +
        'snotaspag pnp2'
      
        '                                                    where pnp2.c' +
        'odigonota = np.codigo'
      
        '                                                      and pnp2.i' +
        'ncidencia in ('#39'00'#39','#39'20'#39')) *'
      '            (select cnp.base'
      '             from calculosnotaspag cnp'
      
        '             where cnp.codigonota = np.codigo and cnp.tipo = '#39'M'#39 +
        ' and coalesce(cnp.base,0)<>0 ),2)'
      '   else 0.00 end as icmsbasecalculo,'
      ''
      ''
      '   case when incidencia in ('#39'60'#39') then'
      
        '            round((pnp.quantidade * pnp.precounitario) / (select' +
        ' sum(pnp2.quantidade * pnp2.precounitario)'
      
        '                                                    from produto' +
        'snotaspag pnp2'
      
        '                                                    where pnp2.c' +
        'odigonota = np.codigo'
      
        '                                                      and pnp2.i' +
        'ncidencia in ('#39'60'#39')) *'
      
        '            (select coalesce(cnp.outras,0) + coalesce(cnp.isenta' +
        's,0)'
      '             from calculosnotaspag cnp'
      
        '             where cnp.codigonota = np.codigo and cnp.tipo = '#39'M'#39 +
        ' and (coalesce(cnp.outras,0) + coalesce(cnp.isentas,0))<>0 ),2)'
      '   else 0.00 end as icmsbasecalculost,'
      ''
      ''
      '   pnp.valoripi,'
      
        '   case when coalesce(pnp.aliquotaicms,0) = 0 and incidencia in ' +
        '('#39'00'#39','#39'20'#39') then'
      '            (select cnp.aliquota'
      '             from calculosnotaspag cnp'
      
        '             where cnp.codigonota = np.codigo and cnp.tipo = '#39'M'#39 +
        ' and coalesce(cnp.aliquota,0)<>0 )'
      '   else coalesce(pnp.aliquotaicms,0) end as aliquotaicms'
      ''
      
        '  FROM (notaspag np join produtosnotaspag pnp on np.codigo = pnp' +
        '.codigonota)'
      '  Where np.filial = :filial'
      '    and np.data between :datainicial and :datafinal'
      
        '    and (mod(pnp.codigofiscal,1000) not in (350,351,352,353,354,' +
        '355,356,357,358,359))'
      ''
      '  %WhereCodigosFiscais_entrada'
      '  %WhereEstado_entrada'
      ''
      '  order by np.data, pnp.codigofiscal'
      ''
      ''
      ')'
      'union all'
      '('
      'select'
      
        '   case when df.pessoanumero='#39#39' then cast(0 as varchar) else coa' +
        'lesce(df.pessoanumero,cast(0 as varchar)) end as cnpj,'
      '   cast('#39'01'#39' as varchar(2)) as modelo,'
      '   n.serie,'
      '   n.numero,'
      '   pdf.codigofiscal,'
      '   case when pdf.incidencia in ('#39'1'#39','#39'00'#39') then '#39'00'#39
      '        when pdf.incidencia in ('#39'2'#39','#39'10'#39') then '#39'10'#39
      '        when pdf.incidencia in ('#39'3'#39','#39'20'#39') then '#39'20'#39
      '        when pdf.incidencia in ('#39'4'#39','#39'30'#39') then '#39'30'#39
      '        when pdf.incidencia in ('#39'5'#39','#39'40'#39') then '#39'40'#39
      '        when pdf.incidencia in ('#39'6'#39','#39'41'#39') then '#39'41'#39
      '        when pdf.incidencia in ('#39'7'#39','#39'50'#39') then '#39'50'#39
      '        when pdf.incidencia in ('#39'8'#39','#39'51'#39') then '#39'51'#39
      '        when pdf.incidencia in ('#39'0'#39','#39'9'#39','#39'60'#39') then '#39'60'#39
      '        when pdf.incidencia in ('#39'10'#39', '#39'70'#39') then '#39'70'#39
      '        when pdf.incidencia in ('#39'11'#39', '#39'90'#39') then '#39'90'#39
      '   else'
      '     null end as incidencia,'
      ''
      '   pdf.numero as numeroproduto,'
      '   pdf.produto,'
      '   pdf.quantidade,'
      '   pdf.quantidade * pdf.precovenda as ValordoProduto,'
      
        '   coalesce(pdf.desconto,0) + coalesce(pdf.valordescontoitem,0) ' +
        'as ValordoDesconto,'
      ''
      
        '   case when incidencia in ('#39'1'#39','#39'00'#39','#39'3'#39','#39'20'#39','#39'8'#39','#39'51'#39','#39'11'#39','#39'90'#39 +
        ') then'
      
        '            round((pdf.quantidade * pdf.precovenda) / (select su' +
        'm(pdf2.quantidade * pdf2.precovenda)'
      
        '                                                       from prod' +
        'utosdadosfiscais pdf2'
      
        '                                                       where pdf' +
        '2.dadofiscal = df.numero'
      
        '                                                         and pdf' +
        '2.incidencia in ('#39'1'#39','#39'00'#39','#39'3'#39','#39'20'#39','#39'8'#39','#39'51'#39','#39'11'#39','#39'90'#39')) *'
      '            (select sum(cdf.base)'
      '             from calculosdadosfiscais cdf'
      
        '             where cdf.dadofiscal = df.numero and cdf.tipo = '#39'M'#39 +
        ' and coalesce(cdf.base,0)<>0 ),2)'
      '   else 0.00 end as icmsbasecalculo,'
      ''
      ''
      '   case when incidencia in ('#39'9'#39','#39'60'#39','#39'6'#39','#39'41'#39','#39'7'#39','#39'50'#39') then'
      ''
      
        '            round((pdf.quantidade * pdf.precovenda) / (select su' +
        'm(pdf2.quantidade * pdf2.precovenda)'
      
        '                                                       from prod' +
        'utosdadosfiscais pdf2'
      
        '                                                       where pdf' +
        '2.dadofiscal = df.numero'
      
        '                                                         and pdf' +
        '2.incidencia in ('#39'9'#39','#39'60'#39','#39'6'#39','#39'41'#39','#39'7'#39','#39'50'#39')) *'
      ''
      
        '            (select sum(coalesce(cdf.outras,0)+coalesce(cdf.isen' +
        'tas,0))'
      '             from calculosdadosfiscais cdf'
      
        '             where cdf.dadofiscal = df.numero and cdf.tipo = '#39'M'#39 +
        ' and (coalesce(cdf.outras,0)+coalesce(cdf.isentas,0))<>0),2)'
      ''
      '   else 0.00 end as icmsbasecalculost,'
      ''
