  object qryNotas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereCodigosFiscais_entrada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereEstado_entrada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereCodigosFiscais_saida'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereEstado_saida'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereAgentes_saida'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      '('
      '  SELECT'
      
        '   case when np.cnpj='#39#39' then cast(0 as varchar) else coalesce(np' +
        '.cnpj, cast(0 as varchar)) end as cnpj,'
      
        '   case when  (select vf.pessoatipo from vfornecedores vf where ' +
        'vf.codigo = np.fornecedor and vf.tipo = np.tipofornecedor)='#39'F'#39' t' +
        'hen'
      
        '     cast('#39'ISENTO'#39' as varchar) else np.inscricaoestadual end as ' +
        'inscricaoestadual,'
      '   np.data, np.estado,'
      
        '   case when (mod(cnp.codigofiscal,1000) in (250,251,252,253,254' +
        ',255,256,257,258,259))  then cast('#39'06'#39' as varchar(2))'
      
        '            when (mod(cnp.codigofiscal,1000) in (300,301,302,303' +
        ',304,305,306,307,308,309))  then cast('#39'22'#39' as varchar(2))'
      '            else  cast('#39'01'#39' as varchar(2)) end as modelo,'
      '   np.serie,'
      '   np.numero,'
      '   cnp.codigofiscal,'
      
        '   cast('#39'P'#39' as varchar(1)) as emitentenotafiscal, /*SITUACAO IND' +
        'EFINIDA*/'
      '   sum(cnp.base+cnp.isentas+cnp.outras) as valornota,'
      '   sum(cnp.base) as base,'
      '   sum(cnp.valor) as valor,'
      '   sum(cnp.isentas) as isentas,'
      '   sum(cnp.outras) as outras, cnp.aliquota,'
      '   cast('#39'N'#39' as varchar(1)) as cancelado  /*SITUACAO INDEFINIDA*/'
      
        '  FROM (notaspag np join calculosnotaspag cnp on np.codigo = cnp' +
        '.codigonota)'
      
        '  Where np.filial = :filial and cnp.tipo='#39'M'#39' and np.data between' +
        ' :datainicial and :datafinal and'
      
        '       (mod(cnp.codigofiscal,1000) not in (350,351,352,353,354,3' +
        '55,356,357,358,359))'
      ''
      '  %WhereCodigosFiscais_entrada'
      '  %WhereEstado_entrada'
      ''
      
        '  group by np.cnpj, np.inscricaoestadual, np.data, np.estado, cn' +
        'p.codigofiscal, np.serie, np.numero, cnp.aliquota, np.fornecedor' +
        ', np.tipofornecedor'
      '  order by np.data,cnp.codigofiscal'
      ')'
      'union all'
      '('
      
        'select case when df.pessoanumero='#39#39' then cast(0 as varchar) else' +
        ' coalesce(df.pessoanumero,cast(0 as varchar)) end as cnpj,'
      '       case when df.pessoatipo = '#39'J'#39' then'
      
        '         (select coalesce(vf.inscricaoestadual,cast('#39'ISENTO'#39' as ' +
        'varchar)) from vfornecedores vf where vf.codigo = df.cliente and' +
        ' vf.tipo=df.tipocliente)'
      
        '       else (cast('#39'ISENTO'#39' as varchar)) end as inscricaoestadual' +
        ','
      '       df.data,'
      '       df.estado,'
      '       cast('#39'01'#39' as varchar(2)) as modelo,'
      '       saidasnotas.serie,'
      '       saidasnotas.numero,'
      '       saidasnotas.codigofiscal,'
      
        '       cast('#39'P'#39' as varchar(1)) as emitentenotafiscal, /*SITUACAO' +
        ' INDEFINIDA*/'
      
        '       case when df.situacao='#39'N'#39' then (saidasnotas.base+saidasno' +
        'tas.isentas+saidasnotas.outras) else 0 end as valornota,'
      '       saidasnotas.base,'
      '       saidasnotas.valor,'
      '       saidasnotas.isentas,'
      '       saidasnotas.outras,'
      '       saidasnotas.aliquota,'
      
        '       case when df.situacao='#39'N'#39' then cast('#39'N'#39' as varchar(1)) el' +
        'se  cast('#39'S'#39' as varchar(1))  end as cancelado'
      'from'
      '('
      ' SELECT'
      '  n.dadofiscal,'
      '  n.serie,'
      '  n.numero,'
      '  cdf.aliquota,'
      '  cdf.codigofiscal,'
      
        '  sum(case When cdf.CodigoFiscal=5929 then 0 else (case When df.' +
        'situacao='#39'N'#39' then cdf.base else 0 end) end) as base,'
      
        '  sum(case When cdf.CodigoFiscal=5929 then 0 else (case When df.' +
        'situacao='#39'N'#39' then cdf.valor else 0 end) end) as valor,'
      
        '  sum(case When cdf.CodigoFiscal=5929 then 0 else (case When df.' +
        'situacao='#39'N'#39' then cdf.isentas else 0 end) end) as isentas,'
      
        '  sum(case When df.situacao='#39'N'#39' then (case When cdf.CodigoFiscal' +
        '=5929 then (cdf.base+cdf.isentas+cdf.outras) else cdf.outras  en' +
        'd) else 0 end) as outras'
      
        ' FROM ((dadosfiscais df join notas n on df.numero = n.dadofiscal' +
        ')'
      
        '                                   join calculosdadosfiscais cdf' +
        ' on df.numero=cdf.dadofiscal)'
      
        ' Where df.filialemissao = :filial and cdf.tipo='#39'M'#39' and df.data b' +
        'etween :datainicial and :datafinal'
      ''
      '  %WhereCodigosFiscais_saida'
      '  %WhereEstado_saida'
      '  %WhereAgentes_saida'
      ''
      
        ' group by n.dadofiscal, n.serie, n.numero, cdf.codigofiscal, df.' +
        'situacao, cdf.aliquota'
      
        ' order by n.dadofiscal, n.serie, n.numero, cdf.codigofiscal, df.' +
        'situacao, cdf.aliquota'
      
        ') as saidasnotas join dadosfiscais df on df.numero = saidasnotas' +
        '.dadofiscal'
      'order by df.data, saidasnotas.codigofiscal'
      ')'
      'order by data, codigofiscal')
    RequestLive = False
    Left = 40
    Top = 232
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end>
