  object qryRegistros60D: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select tipo, subtipo, dt_ini, num_fab, cod_item,'
      '       sum(qtde_item) as qtde_item,'
      '       sum(vl_tot_item) as vl_tot_item,'
      '       sum(baseicms) as baseicms,'
      '       totalizador,'
      '       trunc((aliquota*sum(baseicms))/100,2) as valoricms'
      'from'
      '('
      'select cast('#39'60'#39' as char(2)) as tipo,'
      '       cast('#39'D'#39' as char(1)) as subtipo,'
      '       dlc.dt_ini,'
      '       dc.num_fab,'
      '       dic.cod_item,'
      '       dic.qtde_item,'
      '       dic.vl_tot_item,'
      '       (case when dic.cod_tot_parc='#39'I1'#39'  then 0.00'
      '             when dic.cod_tot_parc='#39'F1'#39'  then 0.00'
      '             when dic.cod_tot_parc='#39'N1'#39'  then 0.00'
      '       else dic.vl_tot_item'
      '       end) as baseicms,'
      ''
      
        '       (case when dic.cod_tot_parc='#39'I1'#39'             then cast('#39'I' +
        #39'as varchar(4))'
      
        '             when dic.cod_tot_parc='#39'F1'#39'             then cast('#39'F' +
        #39'as varchar(4))'
      
        '             when dic.cod_tot_parc='#39'N1'#39'             then cast('#39'N' +
        #39'as varchar(4))'
      
        '       else cast(substring(dic.cod_tot_parc from 4 for 4)as varc' +
        'har(4))'
      '       end) as totalizador,'
      ''
      '       (case when dic.cod_tot_parc='#39'I1'#39'             then 0.00'
      '             when dic.cod_tot_parc='#39'F1'#39'             then 0.00'
      '             when dic.cod_tot_parc='#39'N1'#39'             then 0.00'
      
        '       else to_number(cast(substring(dic.cod_tot_parc from 4 for' +
        ' 2)as varchar(2))||'#39'.'#39'||'
      
        '             cast(substring(dic.cod_tot_parc from 6 for 2)as var' +
        'char(2)), '#39'9999D99'#39')'
      '       end) as aliquota'
      ''
      'from dadoscupom dc'
      '     join detalhecupom dlc'
      '       on  dc.filial = dlc.filial'
      '       and dc.num_usu = dlc.num_usu'
      '       and dc.cro = dlc.cro'
      '       and dc.coo = dlc.coo'
      ''
      '     join dadositemcupom dic'
      '       on  dc.filial = dic.filial'
      '       and dc.num_usu = dic.num_usu'
      '       and dc.cro = dic.cro'
      '       and dc.coo = dic.coo'
      ''
      'where dc.filial = :filial'
      
        '  and cast(dlc.dt_ini as date) between :datainicial and :datafin' +
        'al'
      ') as temp'
      
        'group by tipo, subtipo, dt_ini, num_fab, cod_item, totalizador, ' +
        'aliquota'
      'order by dt_ini, num_fab, cod_item, totalizador, aliquota')
    RequestLive = False
