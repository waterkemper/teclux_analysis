    qryRegistroTipo54.MacroByName('WhereCodigosFiscais_saida').AsString :=
      format(CFSaidaI_Produtos,
           [qryProcuraCodigosFiscaisSaidaInicialcodigo.AsString]);
  end
  else
  if (qryProcuraCodigosFiscaisSaidaInicialcodigo.AsInteger=0) and
     (qryProcuraCodigosFiscaisSaidaFinalcodigo.AsInteger<>0) then
  begin
   qryNotas.MacroByName('WhereCodigosFiscais_saida').AsString :=
      format(CFSaidaF,
           [qryProcuraCodigosFiscaisSaidaFinalcodigo.AsString]);

   qryRegistroTipo54.MacroByName('WhereCodigosFiscais_saida').AsString :=
      format(CFSaidaF_Produtos,
           [qryProcuraCodigosFiscaisSaidaFinalcodigo.AsString])
  end
  else
  if (qryProcuraCodigosFiscaisSaidaInicialcodigo.AsInteger=0) and
     (qryProcuraCodigosFiscaisSaidaFinalcodigo.AsInteger=0) then
  begin
    qryNotas.MacroByName('WhereCodigosFiscais_saida').AsString := '';
    qryRegistroTipo54.MacroByName('WhereCodigosFiscais_saida').AsString := '';
  end;

  if qryProcuraEstadoscodigo.AsString<>'' then
  begin
   qrynotas.MacroByName('WhereEstado_entrada').AsString := format(CFEntradaUF,[quotedstr(qryProcuraEstadoscodigo.AsString)]);
   qrynotas.MacroByName('WhereEstado_saida').AsString := format(CFSaidaUF,[quotedstr(qryProcuraEstadoscodigo.AsString)]);
   qrytransportes.MacroByName('WhereEstado').AsString := format(CFEntradaUF,[quotedstr(qryProcuraEstadoscodigo.AsString)]);
   qryRegistroTipo54.MacroByName('WhereEstado_entrada').AsString := format(CFEntradaUF,[quotedstr(qryProcuraEstadoscodigo.AsString)]);
   qryRegistroTipo54.MacroByName('WhereEstado_saida').AsString := format(CFSaidaUF,[quotedstr(qryProcuraEstadoscodigo.AsString)]);
  end
  else
  begin
   qrynotas.MacroByName('WhereEstado_entrada').AsString := '';
   qrynotas.MacroByName('WhereEstado_saida').AsString := '';
   qrytransportes.MacroByName('WhereEstado').AsString := '';
   qryRegistroTipo54.MacroByName('WhereEstado_entrada').AsString := '';
   qryRegistroTipo54.MacroByName('WhereEstado_saida').AsString := '';
  end;

end;

procedure TdtmGerarSintegraemArquivo.Selecionar(
  TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
    pesCODIGOFISCALENTRADAINICIAL : ReFazConsulta(qryProcuraCodigosFiscaisEntradaInicial,[0], [qryconsultaCodigosFiscaisEntradacodigo.AsVariant]);
    pesCODIGOFISCALENTRADAFINAL   : ReFazConsulta(qryProcuraCodigosFiscaisEntradaFinal,[0], [qryconsultaCodigosFiscaisEntradacodigo.AsVariant]);
    pesCODIGOFISCALSAIDAINICIAL   : ReFazConsulta(qryProcuraCodigosFiscaisSaidaInicial,[0], [qryConsultaCodigosFiscaisSaidascodigo.AsVariant]);
    pesCODIGOFISCALSAIDAFINAL     : ReFazConsulta(qryProcuraCodigosFiscaisSaidaInicial,[0], [qryConsultaCodigosFiscaisSaidascodigo.AsVariant]);
    pesESTADOS : ReFazConsulta(qryProcuraEstados,[0], [qryConsultaEstadoscodigo.AsVariant]);
  end;
end;

procedure TdtmGerarSintegraemArquivo.SetAgentes(const Value: String);
const
  SQLAgente = 'and df.agente in (%s)';
begin
  if (Value <> '') then
  begin
    qrynotas.MacroByName('WhereAgentes_saida').AsString := Format(SQLAgente,[Value]);
    qryRegistroTipo54.MacroByName('WhereAgentes_saida').AsString := Format(SQLAgente,[Value])
  end
  else
  begin
    qrynotas.MacroByName('WhereAgentes_saida').AsString := '';
    qryRegistroTipo54.MacroByName('WhereAgentes_saida').AsString := '';
  end
end;

procedure TdtmGerarSintegraemArquivo.SetFiliais(const Value: String);
const
 FiltroFilial = 'and f.codigo in (%s)';
begin
  if (Value <> '') then
    qryConsultaFiliais.macrobyname('condicao').asstring := Format(FiltroFilial,[Value])
  else
    qryConsultaFiliais.macrobyname('condicao').asstring :=  '';
end;

procedure TdtmGerarSintegraemArquivo.SetGrupoFiliais(const Value: String);
const
  FiltroGrupoFilial = ' and f.codigo IN (SELECT fgf.filial '+#13#10+
                                  'FROM filiaisgruposfiliais fgf '+#13#10+
                                    'WHERE fgf.grupo IN (%s))';
begin
  if (Value <> '') then
      qryConsultaFiliais.Sql[22]:=Format(FiltroGrupoFilial,[Value])
end;

procedure TdtmGerarSintegraemArquivo.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\sentegra.sql') then
    Listar.loadfromfile('c:\sentegra.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\sentegra.sql');
  listar.free;
end;

