procedure TdtmGerarSintegraemArquivo.AbreTabelaPesquisa(
  TipoPesquisa: TTecPesquisa);
begin
  case TipoPesquisa of
    pesCODIGOFISCALENTRADAINICIAL,
    pesCODIGOFISCALENTRADAFINAL : Abre(ctLIVTabelaConsultaCodigoFiscaisEntrada);
    pesCODIGOFISCALSAIDAINICIAL,
    pesCODIGOFISCALSAIDAFINAL: Abre(ctLIVTabelaConsultaCodigoFiscaisSaida);
    pesESTADOS : Abre(ctLIVTabelaConsultaEstados);
  end;
end;

constructor TdtmGerarSintegraemArquivo.Create(AOwner: TComponent);
begin
  inherited;
  qryFiliais.Tag      := ctLIVTabelaConsultaFiliais;
  qryGrupoFiliais.Tag := ctLIVTabelaConsultaGruposFiliais;
  qryAgentes.Tag      := ctLIVTabelaConsultaAgentes;
  qryconsultaCodigosFiscaisEntrada.Tag := ctLIVTabelaConsultaCodigoFiscaisEntrada;
  qryConsultaCodigosFiscaisSaidas.Tag := ctLIVTabelaConsultaCodigoFiscaisSaida;
  qryConsultaEstados.Tag := ctLIVTabelaConsultaEstados;
  qryProcuraCodigosFiscaisEntradaInicial.Tag := ctTabelas;
  qryProcuraCodigosFiscaisEntradaFinal.Tag := ctTabelas;
  qryProcuraCodigosFiscaisSaidaInicial.Tag := ctTabelas;
  qryProcuraCodigosFiscaisSaidaFinal.Tag := ctTabelas;
  qryProcuraEstados.Tag := ctTabelas;

  R10_11_NatOperacoes := 3;
  R10_12_Finalidade := 1;
end;

function TdtmGerarSintegraemArquivo.ExisteCodigoFiscalEntrada(Campo,
  Codigo: string): Boolean;
begin
  Result:= ExisteCodigo(qryconsultaCodigosFiscaisEntrada, Campo, Codigo);
end;

function TdtmGerarSintegraemArquivo.ExisteCodigoFiscalSaida(Campo,
  Codigo: string): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaCodigosFiscaisSaidas, Campo, Codigo);
end;


function TdtmGerarSintegraemArquivo.ExisteEstado(Campo,
  Codigo: string): Boolean;
begin
  Result:= ExisteCodigo(qryConsultaEstados, Campo, Codigo);
end;

procedure TdtmGerarSintegraemArquivo.FechaTabelaPesquisa(
  TipoPesquisa: TTecPesquisa);
begin
  case TipoPesquisa of
    pesCODIGOFISCALENTRADAINICIAL,
    pesCODIGOFISCALENTRADAFINAL : Fecha(ctLIVTabelaConsultaCodigoFiscaisEntrada);
    pesCODIGOFISCALSAIDAINICIAL,
    pesCODIGOFISCALSAIDAFINAL: Fecha(ctLIVTabelaConsultaCodigoFiscaisSaida);
    pesESTADOS : Fecha(ctLIVTabelaConsultaEstados);
  end;
end;

procedure TdtmGerarSintegraemArquivo.GerarArquivo(NomeArquivo: String; ExtTXT: boolean = true);
const
 tipo = 0;
 Qtidade =1;
var
  PosBarra,
  NRegistrosTotal, I, J, N : integer;
  IE, Tipos, Arquivo : String;
  Arq: TextFile;
  NrPorTipo: Array[0..1] of TStringList;
  RegravarUltimaLinha : Boolean;
  NumNota10: String;
  NumNota06: String;

  Tipo50, Tipo54, Tipo60, Tipo70, Tipo75: Integer;
  FilAnt: Integer;
  Tipo50Str, Tipo54Str, Tipo60Str, Tipo70Str, Tipo75Str, Tipo99Str: String;
  Espacos : String;
  Tam: Integer;
  K: Byte;
  CnpjStr, InscrStr: String;

  procedure GravarLinha_String(str : String);
  var
   index :integer;
  begin
  {$IFDEF LINUX}
   Writeln(Arq, str+#13);
  {$ELSE }
   Writeln(Arq, str);
  {$ENDIF }
   if not (strtoint(copy(str,1,2)) in [90]) then
     NRegistrosTotal := NRegistrosTotal + 1;

   if not (strtoint(copy(str,1,2)) in [10,11,90]) then begin
     index := NrPorTipo[tipo].IndexOf(copy(str,1,2));
     if index <> -1 then
        nrPorTipo[Qtidade].Strings[index]:=inttostr(strtoint(nrPorTipo[Qtidade].Strings[index])+1)
     else begin
        NrPorTipo[tipo].Add(copy(str,1,2));
        NrPorTipo[Qtidade].Add('1');
     end;
   end
  end;

begin
//Estrutura conforme Convênio ICMS 57/95, com as alterações promovidas pelo Convênio ICMS 76/03.
 R10_10_CodIdConvenio := 3;
 IE := '';
 NRegistrosTotal := 0;
 RegravarUltimaLInha := false;
 NrPorTipo[tipo] := tStringlist.Create;
 NrPorTipo[Qtidade] := tStringlist.Create;
 CodigosFiliaisGerados := '';

{$IFDEF LINUX}
  PosBarra := Pos('/', NomeArquivo);
{$ELSE }
  PosBarra := Pos('\', NomeArquivo);
{$ENDIF }

 if NomeArquivo = 'sintegra_n.txt' then
    NomeArquivo := 'sintegra_.txt'
 else
  if (pos('.txt',NomeArquivo)=0) and
     (pos('.',NomeArquivo)=0) then
    if ExtTXT then
      NomeArquivo := NomeArquivo+'.txt';

  CodigosFiliaisGerados := #10#13;
  ReFazConsulta(qryConsultaFiliais,[],[]);

  Tipo50 := 0; Tipo54 := 0; Tipo60 := 0;  Tipo70 := 0; Tipo75:= 0;
  Tipo50Str := '';  Tipo54Str := ''; Tipo60Str := ''; Tipo70Str := '';
  Tipo75Str := ''; Tipo99Str:= '';
  CnpjStr := '';
  InscrStr:= '';

  qryConsultaFiliais.First;
  FilAnt := qryConsultaFiliaisCODIGO.AsInteger;
  CnpjStr  := qryConsultaFiliaisCNPJ.AsString;
  InscrStr := qryConsultafiliaisINSCRICAOESTADUAL.AsString;

  while not qryConsultaFiliais.Eof do
  begin
    if FilAnt <> qryConsultaFiliaisCODIGO.AsInteger then
    begin
       if Tipo50 <> 0 then
          Tipo50Str := '50' + format('%8.8d',[Tipo50]);

       if Tipo54 <> 0 then
          Tipo54Str := '54' + format('%8.8d',[Tipo54]);

       if Tipo60 <> 0 then
          Tipo60Str := '60' + format('%8.8d',[Tipo60]);

       if Tipo70 <> 0 then
          Tipo70Str := '70' + format('%8.8d',[Tipo70]);

       if Tipo75 <> 0 then
          Tipo75Str := '75' + format('%8.8d',[Tipo75]);

       Espacos := '';
       Tam :=  126 - (41 + Length(Tipo50Str + Tipo54Str + Tipo60Str + Tipo70Str + Tipo75Str));
       for K := 1 to Tam do
           Espacos := Espacos + ' ';

       Tipo99Str := '99' + format('%-8.8d', [NregistrosTotal+1])+ Espacos + '1';

       GravarLinha_String(
           '90'+
            format('%14.14d',[strtoint64(SomenteNumero(CnpjStr))])+
            format('%-14s', [somentenumero(InscrStr)])+
            Tipo50Str + Tipo54Str + Tipo60Str + Tipo70Str + Tipo75Str + Tipo99Str);

        closefile(arq);


        Tipo50Str := '';  Tipo54Str := ''; Tipo60Str := '';
        Tipo70Str := ''; Tipo75Str := ''; Tipo99Str:= '';

        Tipo50 := 0;
        Tipo54 := 0;
        Tipo60 := 0;
        Tipo70 := 0;
        Tipo75 := 0;

        NregistrosTotal := 0;

        FilAnt  := qryConsultaFiliaisCODIGO.AsInteger;
        CnpjStr := qryConsultaFiliaisCNPJ.AsString;
        InscrStr:= qryConsultafiliaisINSCRICAOESTADUAL.AsString;
    end;

    if ExtTXT then
    begin
      if PosBarra = 0 then
      begin
        Arquivo := copy(NomeArquivo,0,pos('.',NomeArquivo)-1) +
                   qryConsultaFiliaiscodigo.AsString +
                   copy(NOmeArquivo,pos('.',NomeArquivo),length(NomeArquivo));
        CodigosFiliaisGerados := CodigosFiliaisGerados + Arquivo + #10#13;
        Arquivo := ExtractFilePath(Application.ExeName) + Arquivo;
      end
      else
      begin
        Arquivo := copy(ExtractFileName(NomeArquivo),0,pos('.',ExtractFileName(NomeArquivo))-1) +
                   qryConsultaFiliaiscodigo.AsString +
                   copy(ExtractFileName(NomeArquivo),pos('.',ExtractFileName(NomeArquivo)),length(ExtractFileName(NomeArquivo)));
        CodigosFiliaisGerados := CodigosFiliaisGerados + Arquivo + #10#13;
        Arquivo := ExtractFilePath(NomeArquivo) + Arquivo;
      end;
    end
    else
      Arquivo := NomeArquivo;
    try

    AssignFile(Arq,Arquivo);
    Rewrite(Arq);

    // Tipo 10 - Registro mestre do estabelecimento, destinado à identificação do estabelecimento informante;
    GravarLinha_String(
     '10'+
     format('%14.14d',[strtoint64(SomenteNumero(qryconsultaFiliaiscnpj.AsString))])+
     format('%-14s', [somenteNumero(qryConsultafiliaisinscricaoestadual.asstring)])+
     format('%-35s', [Copy(qryConsultafiliaisRazao.asstring,1,35)])+
     format('%-30s', [Copy(qryConsultafiliaisMunicipio.Asstring,1,30)])+
     format('%-2s',  [Copy(qryConsultafiliaisestado.asstring,1,2)])+
     format('%10.10d', [strtoint64(Copy(qryConsultaFiliaisfaxddd.AsString + qryConsultaFiliaisfaxnumero.AsString,1,10))])+
     FormatDateTime('YYYYmmdd',strtodatetime(DataInicial))+
     FormatDateTime('YYYYmmdd',strtodatetime(DataFinal))+
     Inttostr(R10_10_CodIdConvenio)+
     inttostr(R10_11_NatOperacoes)+
     inttostr(R10_12_Finalidade));

   // Tipo 11 - Dados complementares do informante;
    GravarLinha_String(
     '11'+
     format('%-34s', [Copy(qryConsultafiliaisrua.asstring,1,34)])+
     format('%5.5d',  [1])+
     format('%-22s',  [' '])+
     format('%-15s',  [Copy(qryConsultafiliaisbairro.asstring,1,15)])+
     format('%5.5d',  [qryConsultafiliaiscep.asinteger])+
     format('%-28s',  [Copy(parsistema.nomeContador,1,28)])+
     format('%12.12d',[strtoint64(Copy(qryConsultaFiliaisFONEDDD.AsString + qryConsultaFiliaisfoneNUMERO.AsString,1,10))]));


    ReFazConsulta(qryNotas,[0,1,2],[qryConsultaFiliaisCODIGO.AsVariant, DataInicial, DataFinal]);
    qryNotas.First;
    while not qryNotas.Eof do
    begin
      NumNota10 := '';
      NumNota10 := format('%10.10d',[qryNotasNumero.asinteger]);
      NumNota06 := Copy(NumNota10,5,6);

      if qryNotasinscricaoestadual.asstring<>'ISENTO' then
        IE:= somenteNumero(qryNotasinscricaoestadual.asstring)
      else
        IE := qryNotasinscricaoestadual.asstring;

      GravarLinha_String(
         '50'+
         format('%14.14d',[strtoint64(SomenteNumero(qryNotascnpj.AsString))])+
         format('%-14s', [IE])+
         FormatDateTime('YYYYmmdd',qryNotasdata.AsDateTime)+
         format('%-2s', [qryNotasestado.AsString])+
         format('%-2s', [qryNotasmodelo.AsString])+
         format('%-3s', [ifthen((not PossuiSomenteNumero(qryNotasSerie.AsString)),'1',qryNotasSerie.AsString)])+
         NumNota06 +
//       format('%6.6d',[qryNotasNumero.asinteger])+
         format('%4.4d',[qryNotascodigofiscal.asinteger])+
         qryNotasemitentenotafiscal.asstring+
         formatfloat('0000000000000',round((qryNotasvalornota.Ascurrency*100)))+
         formatfloat('0000000000000',round((qryNotasbase.Ascurrency*100)))+
         formatfloat('0000000000000',round((qryNotasvalor.Ascurrency*100)))+
