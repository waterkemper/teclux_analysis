end;

procedure TdtmGerarSintegraemArquivo.SetAgentes(const Value: String);
const
  SQLAgente = 'and df.agente in (%s)';
begin
  if (Value <> '') then
  begin
    qrynotas.MacroByName('WhereAgentes_saida').AsString := Format(SQLAgente,[Value]);
    qryRegistroTipo54.MacroByName('WhereAgentes_saida').AsString := Format(SQLAgente,[Value])
  end
  else
  begin
    qrynotas.MacroByName('WhereAgentes_saida').AsString := '';
    qryRegistroTipo54.MacroByName('WhereAgentes_saida').AsString := '';
  end
end;

procedure TdtmGerarSintegraemArquivo.SetFiliais(const Value: String);
const
 FiltroFilial = 'and f.codigo in (%s)';
begin
  if (Value <> '') then
   qryConsultaFiliais.Sql[22]:=Format(FiltroFilial,[Value])
  else
   qryConsultaFiliais.Sql[22]:='';
end;

procedure TdtmGerarSintegraemArquivo.SetGrupoFiliais(const Value: String);
const
  FiltroGrupoFilial = ' and f.codigo IN (SELECT fgf.filial '+#13#10+
                                  'FROM filiaisgruposfiliais fgf '+#13#10+
                                    'WHERE fgf.grupo IN (%s))';
begin
  if (Value <> '') then
      qryConsultaFiliais.Sql[22]:=Format(FiltroGrupoFilial,[Value])
end;

procedure TdtmGerarSintegraemArquivo.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:\sentegra.sql') then
    Listar.loadfromfile('c:\sentegra.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:\sentegra.sql');
  listar.free;
