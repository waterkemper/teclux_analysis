procedure TdtmGerarSintegraemArquivo.MontarFiltroFiliais(
  Usar: TCheckListBox);
var
  STRFiliais: String;
  TodasFiliais: Boolean;
  cnt: Integer;
begin
  TodasFiliais := True;
  STRFiliais := '';
  for cnt := 0 to FListaFiliais.Count - 1 do
    if Usar.Checked[cnt] then
      STRFiliais := STRFiliais + '''' + IntToStr(Integer(FListaFiliais.Objects[cnt])) + ''','
    else
      TodasFiliais := False;

  STRFiliais := Copy(STRFiliais, 0, Length(STrFiliais) - 1);
  Filiais := STRFiliais;
  if Trim(STRFiliais) <> '' then
    if TodasFiliais then
      Filiais := '';
end;

procedure TdtmGerarSintegraemArquivo.MontarFiltroGrupoFiliais(
  Usar: TCheckListBox);
var
  STRGruposFiliais: String;
  TodosGrupos: Boolean;
  cnt: Integer;
begin
  STRGruposFiliais := '';
  TodosGrupos := True;
  for cnt := 0 to FListaGruposFiliais.Count - 1 do
    if Usar.Checked[cnt] then
      STRGruposFiliais := STRGruposFiliais + '''' + IntToStr(Integer(FListaGruposFiliais.Objects[cnt]))+ ''','
    else
      TodosGrupos := False;

  STRGruposFiliais := Copy(STRGruposFiliais, 0, Length(STrGruposFiliais) - 1);
  GrupoFiliais:=STRGruposFiliais;
  if Trim(STRGruposFiliais) <> '' then
   if TodosGrupos then
    GrupoFiliais:='';
end;

procedure TdtmGerarSintegraemArquivo.MontarSQL;
const
 CFEntradaIF = 'and cnp.codigofiscal >= %s and cnp.codigofiscal <= %s';
 CFEntradaIF_Produtos = 'and pnp.codigofiscal >= %s and pnp.codigofiscal <= %s';

 CFEntradaI = 'and cnp.codigofiscal >= %s';
 CFEntradaI_Produtos = 'and pnp.codigofiscal >= %s';

 CFEntradaF = 'and cnp.codigofiscal <= %s';
 CFEntradaF_Produtos = 'and pnp.codigofiscal <= %s';

 CFSaidaIF = 'and cdf.codigofiscal >= %s and cdf.codigofiscal <= %s';
 CFSaidaI = 'and cdf.codigofiscal >= %s';
 CFSaidaF = 'and cdf.codigofiscal <= %s';

 CFSaidaIF_Produtos = 'and pdf.codigofiscal >= %s and pdf.codigofiscal <= %s';
 CFSaidaI_Produtos = 'and pdf.codigofiscal >= %s';
 CFSaidaF_Produtos = 'and pdf.codigofiscal <= %s';

 CFEntradaUF = 'and np.estado = %s';
 CFSaidaUF = 'and df.estado = %s';

begin
  if (qryProcuraCodigosFiscaisEntradaInicialcodigo.AsInteger<>0) and
     (qryProcuraCodigosFiscaisEntradaFinalcodigo.AsInteger<>0) then
  begin
   qryNotas.MacroByName('WhereCodigosFiscais_entrada').AsString :=
     format(CFEntradaIF,
           [qryProcuraCodigosFiscaisEntradaInicialcodigo.AsString,
            qryProcuraCodigosFiscaisEntradaFinalcodigo.AsString]);

   qryRegistroTipo54.MacroByName('WhereCodigosFiscais_entrada').AsString :=
     format(CFEntradaIF_Produtos,
           [qryProcuraCodigosFiscaisEntradaInicialcodigo.AsString,
            qryProcuraCodigosFiscaisEntradaFinalcodigo.AsString]);

  end
  else
  if (qryProcuraCodigosFiscaisEntradaInicialcodigo.AsInteger<>0) and
     (qryProcuraCodigosFiscaisEntradaFinalcodigo.AsInteger=0) then
  begin
   qryNotas.MacroByName('WhereCodigosFiscais_entrada').AsString :=
     format(CFEntradaI,
           [qryProcuraCodigosFiscaisEntradaInicialcodigo.AsString]);

   qryRegistroTipo54.MacroByName('WhereCodigosFiscais_entrada').AsString :=
     format(CFEntradaI_Produtos,
           [qryProcuraCodigosFiscaisEntradaInicialcodigo.AsString])
  end
  else
  if (qryProcuraCodigosFiscaisEntradaInicialcodigo.AsInteger=0) and
     (qryProcuraCodigosFiscaisEntradaFinalcodigo.AsInteger<>0) then
  begin
   qryNotas.MacroByName('WhereCodigosFiscais_entrada').AsString :=
     format(CFEntradaF,
           [qryProcuraCodigosFiscaisEntradaFinalcodigo.AsString]);

   qryRegistroTipo54.MacroByName('WhereCodigosFiscais_entrada').AsString :=
     format(CFEntradaF_Produtos,
           [qryProcuraCodigosFiscaisEntradaFinalcodigo.AsString]);

  end
  else
  if (qryProcuraCodigosFiscaisEntradaInicialcodigo.AsInteger=0) and
     (qryProcuraCodigosFiscaisEntradaFinalcodigo.AsInteger=0) then
  begin
    qryNotas.MacroByName('WhereCodigosFiscais_entrada').AsString := '';
    qryRegistroTipo54.MacroByName('WhereCodigosFiscais_entrada').AsString := '';
  end;

  if (qryProcuraCodigosFiscaisSaidaInicialcodigo.AsInteger<>0) and
     (qryProcuraCodigosFiscaisSaidaFinalcodigo.AsInteger<>0) then
  begin
    qryNotas.MacroByName('WhereCodigosFiscais_saida').AsString :=
      format(CFSaidaIF,
           [qryProcuraCodigosFiscaisSaidaInicialcodigo.AsString,
           qryProcuraCodigosFiscaisSaidaFinalcodigo.AsString]);

    qryRegistroTipo54.MacroByName('WhereCodigosFiscais_saida').AsString :=
      format(CFSaidaIF_Produtos,
           [qryProcuraCodigosFiscaisSaidaInicialcodigo.AsString,
           qryProcuraCodigosFiscaisSaidaFinalcodigo.AsString])
  end
  else
  if (qryProcuraCodigosFiscaisSaidaInicialcodigo.AsInteger<>0) and
     (qryProcuraCodigosFiscaisSaidaFinalcodigo.AsInteger=0) then
  begin
    qryNotas.MacroByName('WhereCodigosFiscais_saida').AsString :=
      format(CFSaidaI,
           [qryProcuraCodigosFiscaisSaidaInicialcodigo.AsString]);

    qryRegistroTipo54.MacroByName('WhereCodigosFiscais_saida').AsString :=
      format(CFSaidaI_Produtos,
           [qryProcuraCodigosFiscaisSaidaInicialcodigo.AsString]);
  end
  else
  if (qryProcuraCodigosFiscaisSaidaInicialcodigo.AsInteger=0) and
     (qryProcuraCodigosFiscaisSaidaFinalcodigo.AsInteger<>0) then
  begin
   qryNotas.MacroByName('WhereCodigosFiscais_saida').AsString :=
      format(CFSaidaF,
           [qryProcuraCodigosFiscaisSaidaFinalcodigo.AsString]);

   qryRegistroTipo54.MacroByName('WhereCodigosFiscais_saida').AsString :=
      format(CFSaidaF_Produtos,
           [qryProcuraCodigosFiscaisSaidaFinalcodigo.AsString])
  end
  else
  if (qryProcuraCodigosFiscaisSaidaInicialcodigo.AsInteger=0) and
     (qryProcuraCodigosFiscaisSaidaFinalcodigo.AsInteger=0) then
  begin
    qryNotas.MacroByName('WhereCodigosFiscais_saida').AsString := '';
    qryRegistroTipo54.MacroByName('WhereCodigosFiscais_saida').AsString := '';
  end;

  if qryProcuraEstadoscodigo.AsString<>'' then
  begin
   qrynotas.MacroByName('WhereEstado_entrada').AsString := format(CFEntradaUF,[quotedstr(qryProcuraEstadoscodigo.AsString)]);
   qrynotas.MacroByName('WhereEstado_saida').AsString := format(CFSaidaUF,[quotedstr(qryProcuraEstadoscodigo.AsString)]);
   qrytransportes.MacroByName('WhereEstado').AsString := format(CFEntradaUF,[quotedstr(qryProcuraEstadoscodigo.AsString)]);
   qryRegistroTipo54.MacroByName('WhereEstado_entrada').AsString := format(CFEntradaUF,[quotedstr(qryProcuraEstadoscodigo.AsString)]);
   qryRegistroTipo54.MacroByName('WhereEstado_saida').AsString := format(CFSaidaUF,[quotedstr(qryProcuraEstadoscodigo.AsString)]);
  end
  else
  begin
   qrynotas.MacroByName('WhereEstado_entrada').AsString := '';
   qrynotas.MacroByName('WhereEstado_saida').AsString := '';
   qrytransportes.MacroByName('WhereEstado').AsString := '';
   qryRegistroTipo54.MacroByName('WhereEstado_entrada').AsString := '';
   qryRegistroTipo54.MacroByName('WhereEstado_saida').AsString := '';
  end;

end;

procedure TdtmGerarSintegraemArquivo.Selecionar(
  TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
    pesCODIGOFISCALENTRADAINICIAL : ReFazConsulta(qryProcuraCodigosFiscaisEntradaInicial,[0], [qryconsultaCodigosFiscaisEntradacodigo.AsVariant]);
    pesCODIGOFISCALENTRADAFINAL   : ReFazConsulta(qryProcuraCodigosFiscaisEntradaFinal,[0], [qryconsultaCodigosFiscaisEntradacodigo.AsVariant]);
    pesCODIGOFISCALSAIDAINICIAL   : ReFazConsulta(qryProcuraCodigosFiscaisSaidaInicial,[0], [qryConsultaCodigosFiscaisSaidascodigo.AsVariant]);
    pesCODIGOFISCALSAIDAFINAL     : ReFazConsulta(qryProcuraCodigosFiscaisSaidaInicial,[0], [qryConsultaCodigosFiscaisSaidascodigo.AsVariant]);
