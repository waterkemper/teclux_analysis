  object qryParcelasBanco: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryParcelasBancoBeforeOpen
    OnCalcFields = qryParcelasBancoCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'WhereContrato'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'WhereNumeroParcelas'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT cc.Carteira,'
      '       cc.UsoDoBanco,'
      '       cc.Cedente  AS Cedente_CodigoCedente,'
      '       cc.Banco    AS Cedente_ContaBancaria_Banco_Codigo,'
      '       cc.Agencia  AS Cedente_ContaBancaria_CodigoAgencia,'
      '       a.Digito    AS Cedente_ContaBancaria_DigitoAgencia,'
      '       cc.Digito   AS Cedente_ContaBancaria_DigitoConta,'
      '       cc.Conta    AS Cedente_ContaBancaria_NumeroConta,'
      '       cc.Convenio AS Cedente_ContaBancaria_Convenio,'
      '       '
      '      (SELECT b.Nome'
      '          FROM Bairros b'
      '          WHERE f.Estado = b.Estado AND'
      '                f.Cidade = b.Cidade AND'
      '                f.Bairro = b.Codigo) AS Cedente_Endereco_Bairro,'
      '                '
      
        '       CAST(LPAD(CAST(f.CEP AS VARCHAR), 8, '#39'0'#39') AS VARCHAR(8)) ' +
        'AS Cedente_Endereco_CEP,'
      ''
      '      (SELECT cd.Nome'
      '          FROM Cidades cd '
      '          WHERE f.Estado = cd.Estado AND'
      
        '                f.Cidade = cd.Codigo) AS Cedente_Endereco_Cidade' +
        ','
      '                '
      '       f.Rua    AS Cedente_Endereco_Rua,'
      '       f.Estado AS Cedente_Endereco_Estado,'
      ''
      
        '       CASE WHEN BTRIM(cc.Cedente_Nome)            <> '#39#39' THEN cc' +
        '.Cedente_Nome            ELSE f.Razao END AS Cedente_Nome,'
      
        '       CASE WHEN BTRIM(cc.CNPJ_Agencia_Referencia) <> '#39#39' THEN cc' +
        '.CNPJ_Agencia_Referencia ELSE f.CNPJ  END AS Cedente_NumeroCPFCG' +
        'C,'
      ''
      '       ct.Faturamento             AS DataDocumento,'
      '       f.Razao || '#39' - '#39' || f.CNPJ AS Sacador_Avalista,'
      ''
      
        '       /* ---------------------------------------------- Se os v' +
        'alores n'#227'o existirem ('#39#39'), s'#227'o considerados "0" e eventuais v'#237'rg' +
        'ulas, s'#227'o trocadas para pontos */'
      
        '      (SELECT CAST(REPLACE(CASE WHEN Parametros_Valor('#39'DESCONTO ' +
        'Pag ANTECIPADO'#39', CASE WHEN :UsarDadosdaFilialBase THEN :FilialBo' +
        'leto ELSE ct.filialvenda END) = '#39#39
      '                                THEN '#39'0'#39
      
        '                                ELSE Parametros_Valor('#39'DESCONTO ' +
        'Pag ANTECIPADO'#39', CASE WHEN :UsarDadosdaFilialBase THEN :FilialBo' +
        'leto ELSE ct.filialvenda END)'
      
        '                           END, '#39','#39', '#39'.'#39') AS NUMERIC(9,2))) AS P' +
        'ercentualDesconto,'
      ''
      '      (SELECT CASE WHEN Parametros_Valor('#39'DIAS ATRASO 1'#39') = '#39#39
      '                   THEN '#39'0'#39
      '                   ELSE Parametros_Valor('#39'DIAS ATRASO 1'#39')'
      '              END) AS DiasAtraso1,'
      ''
      
        '      (SELECT CAST(REPLACE(CASE WHEN Parametros_Valor('#39'PERCENTUA' +
        'L ATRASO JUROS 1'#39', CASE WHEN :UsarDadosdaFilialBase THEN :Filial' +
        'Boleto ELSE ct.filialvenda END) = '#39#39
      '                                THEN '#39'0'#39
      
        '                                ELSE Parametros_Valor('#39'PERCENTUA' +
        'L ATRASO JUROS 1'#39', CASE WHEN :UsarDadosdaFilialBase THEN :Filial' +
        'Boleto ELSE ct.filialvenda END)'
      
        '                           END, '#39','#39', '#39'.'#39') AS NUMERIC(9,2))) AS P' +
        'ercentualMoraJuros,'
      '                           '
      
        '      (SELECT CAST(REPLACE(CASE WHEN Parametros_Valor('#39'PERCENTUA' +
        'L ATRASO MULTAS 1'#39', CASE WHEN :UsarDadosdaFilialBase THEN :Filia' +
        'lBoleto ELSE ct.filialvenda END) = '#39#39
      '                                THEN '#39'0'#39
      
        '                                ELSE Parametros_Valor('#39'PERCENTUA' +
        'L ATRASO MULTAS 1'#39', CASE WHEN :UsarDadosdaFilialBase THEN :Filia' +
        'lBoleto ELSE ct.filialvenda END)'
      
        '                           END, '#39','#39', '#39'.'#39') AS NUMERIC(9,2))) AS P' +
        'ercentualMoraMulta,'
      ''
      '       p.DataVencto,'
      '       cc.InstrucoesBoleto AS Instrucoes,'
      '       cc.LocalPagamento,'
      '       cc.LocalPagamento2,'
      ''
      '       CASE WHEN cc.Codigo_Singular IS NOT NULL'
      
        '            THEN CAST('#39'2'#39' || cast(cc.AgenciaReferencia as VARCHA' +
        'R) || LPAD(CAST(p.NossoNumero AS VARCHAR),6,'#39'0'#39') AS BIGINT)'
      '            ELSE p.NossoNumero'
      '       END AS NossoNumero,'
      '       '
      '      (SELECT MAX(n.Numero)'
      '          FROM Notas n, DadosFiscais df'
      '          WHERE n.DadoFiscal = df.Numero AND'
      '                df.Contrato  = Contrato_Original(ct.Numero) AND'
      '                df.Situacao  = '#39'N'#39') AS NotaFiscal,'
      ''
      '       (SELECT count(*)'
      '           FROM Notas n, DadosFiscais df'
      '           WHERE n.DadoFiscal = df.Numero AND'
      '                 df.Contrato  = Contrato_Original(ct.Numero) AND'
      '                 df.Situacao  = '#39'N'#39') AS QtdeNotaFiscais,'
      ''
      '       p.Contrato,'
      '       p.Numero AS NumeroParcela,'
      ''
      '      (SELECT b.Nome'
      '          FROM Bairros b'
      '          WHERE c.Estado = b.Estado AND'
      '                c.Cidade = b.Cidade AND'
      '                c.Bairro = b.Codigo) AS Sacado_Endereco_Bairro,'
      ''
      
        '       CAST(LPAD(CAST(c.CEP AS VARCHAR),8,'#39'0'#39') AS VARCHAR(8)) AS' +
        ' Sacado_Endereco_CEP,'
      '       '
      '      (SELECT cd.Nome'
      '          FROM Cidades cd'
      '          WHERE c.Estado = cd.Estado AND'
      '                c.Cidade = cd.Codigo) AS Sacado_Endereco_Cidade,'
      '                '
      '       c.Estado         AS Sacado_Endereco_Estado,'
      '       c.Rua            AS Sacado_Endereco_Rua,'
      '       c.Numero         AS Sacado_Endereco_Numero,'
      '       c.Complemento    AS Sacado_Endereco_Complemento,'
      '       c.Nome           AS Sacado_Nome,'
      '       c.PessoaTipo,'
      '       c.PessoaNumero   AS Sacado_NumeroCPFCGC,'
      '       c.Email          AS Sacado_Email,'
      '       c.FoneNumero     AS Sacado_Fone_Numero,'
      '       c.FoneDDD        AS Sacado_Fone_DDD,'
      ''
      '       p.Contrato || '#39'-'#39' || p.Numero AS SeuNumero,'
      '       p.ValorVencto                 AS ValorDocumento,'
      '       cc.nrviasBoleto,'
      '       '
      
        '       (((p.ValorVencto * :JurosAtraso) / 30) / 100) AS JurosDia' +
        'sReais'
      ''
      
        'FROM  Parcelas p, Contratos ct, Filiais f, Contas cc, Agencias a' +
        ', Bancos b, Clientes c'
      ''
      'WHERE p.DataPagto IS NULL AND'
      ''
      '      %WhereContrato'
      '      %WhereNumeroParcelas'
      ''
      '      (ct.Numero  = p.Contrato) AND'
      '      (ct.Cliente = c.Codigo)   AND'
      '      '
      '      (CASE WHEN :UsarDadosdaFilialBase'
      '            THEN :FilialBoleto'
      '            ELSE ct.filialvenda'
      '       END = f.Codigo) AND'
      ''
      '       cc.Conta = :Conta AND'
      '/*'
      
        '      CAST(cc.Conta AS VARCHAR) = Parametros_Valor('#39'Conta banc'#225'r' +
        'ia para emiss'#227'o do boleto'#39', CASE WHEN :UsarDadosdaFilialBase'
      
        '                                                                ' +
        '                                 THEN :FilialBoleto'
      
        '                                                                ' +
        '                                 ELSE ct.filialvenda'
      
        '                                                                ' +
        '                            END) AND'
      '*/'
      '      cc.Agencia = a.Codigo AND'
      '      cc.Banco   = a.Banco  AND'
      '      a.Banco    = b.Codigo'
      ''
      'ORDER BY p.DataVencto, p.DataPagto'
      ''
      ''
      '/*'
      '  (p.Contrato = :Contrato) AND'
      '*/'
      '')
    RequestLive = False
    Left = 32
    Top = 104
    ParamData = <
      item
        DataType = ftUnknown
