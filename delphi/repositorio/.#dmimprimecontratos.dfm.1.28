  object qryContratosEntradas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select'
      '       (case when (select count(*) from parcelas p where'
      '                   p.contrato = ct.numero and'
      
        '                   p.datavencto > (ct.data+coalesce(pl.toleranci' +
        'aentrada,0)))=0 then 0'
      '                                              else'
      
        '                           (select sum(p.valorvencto) from parce' +
        'las p where'
      '                            p.contrato = ct.numero and'
      
        '                            p.datavencto<=(ct.data+coalesce(pl.t' +
        'oleranciaentrada,0))'
      '                            )'
      '                                               end) as entradas'
      'from (contratos ct  left join planos pl on ct.plano=pl.codigo)'
      'Where ct.numero=:numero')
    RequestLive = False
    Left = 193
    Top = 226
    ParamData = <
      item
        DataType = ftString
        Name = 'numero'
        ParamType = ptUnknown
        Value = '16283'
      end>
    object qryContratosEntradasentradas: TFloatField
      FieldName = 'entradas'
      DisplayFormat = '0.00'
    end
  end
  object qryParcelasImprimir: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';select * from'
      '('
      'Select cast(count(numero) as varchar) as parcelaorigem,'
      '       min(datavencto) as datavencto,'
      '       valorvencto,'
      '/*     numero,*/'
      
        '       case when formapagamento = '#39'T'#39' then cast('#39'QT'#39' as varchar)' +
        ' else cast('#39'  '#39' as varchar) end as formapagamento,'
      '       tiporecebimento,'
      '       (select tr.descricao'
      '        from tiposrecebimentos tr'
      
        '        where tr.codigo = parcelas.tiporecebimento) as descricao' +
        'tiporecebimento'
      ''
      'From   parcelas'
      'Where contrato =:contrato'
      'Group By valorvencto, formapagamento, tiporecebimento'
      ') as temp'
      'order by datavencto')
    RequestLive = False
    Left = 63
    Top = 276
    ParamData = <
      item
        DataType = ftString
        Name = 'contrato'
        ParamType = ptUnknown
        Value = '16283'
      end>
    object qryParcelasImprimirdatavencto: TDateField
      Alignment = taCenter
      FieldName = 'datavencto'
      EditMask = '99/99/9999;1; '
    end
    object qryParcelasImprimirvalorvencto: TFloatField
      FieldName = 'valorvencto'
      DisplayFormat = '0.00'
    end
    object qryParcelasImprimirformapagamento: TStringField
      FieldName = 'formapagamento'
      Size = 50
    end
    object qryParcelasImprimirparcelaorigem: TStringField
      FieldName = 'parcelaorigem'
      Size = 50
    end
    object qryParcelasImprimirtiporecebimento: TIntegerField
      FieldName = 'tiporecebimento'
    end
    object qryParcelasImprimirdescricaotiporecebimento: TStringField
      FieldName = 'descricaotiporecebimento'
      Size = 50
    end
  end
