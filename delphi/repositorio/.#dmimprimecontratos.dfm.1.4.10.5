        '        where  (c2.origem = c.numero)) as renegociado, c.credito' +
        'troca, cast(0 as numeric(9,3)) as totalqtdeprodutos,'
      '       c.cfps,'
      
        '       (select cfs.descricao from codigosfiscaisservicos cfs whe' +
        're cfs.codigo = c.cfps) as descricaocfps'
      'from contratos c'
      'where c.numero =:numero and (os is NULL OR os='#39'false'#39')'
      '/*          NAO ALTERAR A ORDEM DOS CAMPOS   */')
