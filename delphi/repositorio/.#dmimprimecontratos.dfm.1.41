  object qryProdutosEntregar_F_P: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Vendedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ContratosFuturo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Contrato'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      
        'select localizacao, sublocalizacao, produtovisual, descricao, fi' +
        'lial,'
      
        '       valorgrade1, valorgrade2, /*compostovisual,*/  vendedor, ' +
        'u.nome as nomevendedor,'
      
        '       array_to_string(array_agg(trim(pc.contrato)),chr(13)) as ' +
        'ListaContrato,'
      '       sum(pendente_contrato) as pendente_contrato'
      'from'
      '('
      'select  pc.contrato,'
      '        p.descricao, pc.filial, '
      '        p.valorgrade1,'
      '        p.valorgrade2,'
      '        pc.vendedor,'
      ''
      '       (select e.localizacao'
      '        from estoques e'
      '        where e.produto = pc.produto'
      '          and e.filial = pc.filial) as localizacao,'
      ''
      '       (select e.sublocalizacao'
      '        from estoques e'
      '        where e.produto = pc.produto'
      '          and e.filial = pc.filial) as sublocalizacao,'
      ''
      ''
      '       p.codigovisual as produtovisual,'
      '       p2.codigovisual as compostovisual,'
      ''
      '       pc.pendente_contrato'
      ''
      'from'
      '('
      ''
      
        ' select contrato, produto, composto, ordem, vendedor, filial, en' +
        'trega, sum(pendente_contrato) as pendente_contrato'
      ' from'
      ' ('
      ''
      '      ('
      
        '         select pc.contrato,pc.produto, pc.produto as composto, ' +
        '1 as ordem, pc.vendedor, pc.filial,pc.entrega,'
      
        '                pc.pendente_contrato - coalesce(pd.quantidade,0)' +
        ' as pendente_contrato'
      '         from'
      '        ('
      '          Select pc.contrato,'
      '                 pc.produto,'
      '                 pc.vendedor,'
      '                 pc.filial,'
      '                 pc.entrega,'
      
        '                 sum(pc.quantidade-coalesce(pc.cancelado,0))  as' +
        ' pendente_contrato'
      ''
      '          from (contratos ct'
      '                join produtoscontratos pc'
      '                                     join produtos p'
      '                          join caracteristicas c'
      '                          on p.caracteristica = c.codigo'
      '                     on pc.produto = p.codigo'
      ''
      '                on ct.numero = pc.contrato)'
      ''
      '          where ct.numero = pc.contrato'
      '            and not coalesce(c.conferircomposto,false)'
      '            and ct.situacao = '#39'P'#39
      
        '            and (ct.os IS NULL OR not ct.os) and not exists (sel' +
        'ect c2.numero from contratos c2 where c2.origem = ct.numero)'
      '            and pc.quantidade > coalesce(pc.cancelado,0)'
      ''
      '            %Filial'
      '            %Vendedor'
      '            %ContratosFuturo'
      ''
      '            %Contrato'
      ''
      
        '          group by pc.contrato, pc.produto, pc.vendedor, pc.fili' +
        'al, pc.entrega'
      '         ) pc left join (select d.contrato,'
      '                                pd1.produto,'
      '                                pd1.filial,'
      
        '                                sum(pd1.quantidade) as quantidad' +
        'e'
      ''
      '                         from ((dadosfiscais d'
      
        '                                join contratos ct on d.contrato ' +
        '= ct.numero)'
      '                                join produtosdadosfiscais pd1'
      
        '                                     on d.numero = pd1.dadofisca' +
        'l)'
      ''
      '                         where d.contrato = ct.numero'
      '                           and d.numero = pd1.dadofiscal'
      
        '                           and not coalesce(d.notavinculada,fals' +
        'e)'
      '                           and d.situacao = '#39'N'#39
      '                           and ct.situacao = '#39'P'#39
      #9#9'       '#9'   and not coalesce(d.notavinculada,false)'
      
        '                           and not ehnotafiscalsaidasimplesfatur' +
        'amento(d.codigofiscal)'
      
        '                           AND (ct.os IS NULL OR not ct.os)  and' +
        ' not exists (select c2.numero from contratos c2 where c2.origem ' +
        '= ct.numero)'
      ''
      '                                   %Filial'
      '                                   %Vendedor'
      '                                   %ContratosFuturo'
      ''
      
        '                         group by d.contrato, pd1.produto, pd1.f' +
        'ilial) pd'
      '                      using (contrato,produto,filial)'
      '         where pc.pendente_contrato > coalesce(pd.quantidade,0)'
      '     )'
      '     '
      '     union all'
      '     '
      '      ('
      
        '         select pc.contrato,pc.produto, pc.composto, 2 as ordem,' +
        ' pc.vendedor, pc.filial,pc.entrega,'
      
        '                pc.pendente_contrato - coalesce(pd.quantidade,0)' +
        ' as pendente_contrato'
      '         from'
      '        ('
      '          Select pc.contrato,'
      '                 pcp.componente as produto,'
      '                 pc.produto as composto,'
      '                 pc.vendedor,'
      '                 pc.filial,'
      '                 pc.entrega,'
      
        '                 sum((pc.quantidade-coalesce(pc.cancelado,0))*pc' +
        'p.quantidade)  as pendente_contrato'
      ''
      '          from (contratos ct'
      '                join produtoscontratos pc               '
      '                     join produtos p'
      '                          join caracteristicas c'
      '                          on p.caracteristica = c.codigo'
      '                     on pc.produto = p.codigo'
      ''
      '                     join produtoscompostos pcp'
      '                     on pc.produto = pcp.composto'
      '                on ct.numero = pc.contrato)'
      ''
      '          where ct.numero = pc.contrato'
      '            and ct.situacao = '#39'P'#39
      
        '            and (ct.os IS NULL OR not ct.os) and not exists (sel' +
        'ect c2.numero from contratos c2 where c2.origem = ct.numero)'
      '            and pc.quantidade > coalesce(pc.cancelado,0)'
      '            and c.conferircomposto'
      ''
      '            %Filial'
      '            %Vendedor'
      '            %ContratosFuturo'
      ''
      '            %Contrato'
      ''
      
        '          group by pc.contrato, pcp.componente, pc.produto, pc.v' +
        'endedor, pc.filial, pc.entrega'
      '          '
      '         ) pc left join (select d.contrato,'
      '                                pcp.componente as produto,'
      '                                pd1.produto as composto,'
      '                                pd1.filial,'
      
        '                                sum(pd1.quantidade*pcp.quantidad' +
        'e) as quantidade'
      ''
      '                         from ((dadosfiscais d'
      
        '                                join contratos ct on d.contrato ' +
        '= ct.numero)'
      '                                join produtosdadosfiscais pd1'
      '                                     join produtos p'
      '                                          join caracteristicas c'
      
        '                                          on p.caracteristica = ' +
        'c.codigo'
      '                                     on pd1.produto = p.codigo'
      '                                '
      '                                '
      '                                     join produtoscompostos pcp'
      
        '                                     on pd1.produto = pcp.compon' +
        'ente'
      ''
      
        '                                     on d.numero = pd1.dadofisca' +
        'l)'
      ''
      '                         where d.contrato = ct.numero'
      '                           and d.numero = pd1.dadofiscal'
      
        '                           and not coalesce(d.notavinculada,fals' +
        'e)'
      '                           and d.situacao = '#39'N'#39
      '                           and ct.situacao = '#39'P'#39
      #9#9#9'   and not coalesce(d.notavinculada,false)'
      
        '                           and not ehnotafiscalsaidasimplesfatur' +
        'amento(d.codigofiscal)'
      '                           and c.conferircomposto'
      
        '                           AND (ct.os IS NULL OR not ct.os)  and' +
        ' not exists (select c2.numero from contratos c2 where c2.origem ' +
        '= ct.numero)'
      ''
      '                                   %Filial'
      '                                   %Vendedor'
      '                                   %ContratosFuturo'
      ''
      
        '                         group by d.contrato, pcp.componente, pd' +
        '1.produto, pd1.filial) pd'
      '                      using (contrato,produto,composto, filial)'
      '         where pc.pendente_contrato > coalesce(pd.quantidade,0)'
      '     )'
      '     '
      '      union all'
      ''
      '     ('
      '      Select pc.contrato,'
      '             pc.produto,'
      '             pc.produto as composto,'
      '             1 as ordem,'
      '             pc.vendedor,'
      '             pc.filial,'
      '             pc.entrega,'
      
        '             sum(pc.quantidade-coalesce(pc.cancelado,0))  as pen' +
        'dente_contrato'
      ''
      '      from (contratos ct'
      '            join produtoscontratos pc'
      ''
      '                     join produtos p'
      '                          join caracteristicas c'
      '                          on p.caracteristica = c.codigo'
      '                     on pc.produto = p.codigo'
      ''
      '            on ct.numero = pc.contrato)'
      ''
      '      where ct.numero = pc.contrato'
      '        and ct.situacao = '#39'F'#39
      '        and not coalesce(c.conferircomposto,false)'
      '        and (ct.os IS NULL OR not ct.os)'
      
        '        and not exists (select c2.numero from contratos c2 where' +
        ' c2.origem = ct.numero)'
      ''
      '        %Filial'
      '        %Vendedor'
      '        %ContratosFuturo'
      ''
      '        %Contrato'
      ''
      ''
      
        '      group by pc.contrato, pc.produto, pc.vendedor, pc.filial, ' +
        'pc.entrega'
      ''
      '     )'
      '     '
      '     union all'
      '     '
      '     ('
      '      Select pc.contrato,'
      '             pcp.componente as produto,'
      '             pc.produto as composto,'
      '             2 as ordem,'
      '             pc.vendedor,'
      '             pc.filial,'
      '             pc.entrega,'
      
        '             sum((pc.quantidade-coalesce(pc.cancelado,0))*pcp.qu' +
        'antidade)  as pendente_contrato'
      ''
      '      from (contratos ct'
      '            join produtoscontratos pc'
      ''
      '                 join produtos p'
      '                      join caracteristicas c'
      '                      on p.caracteristica = c.codigo'
      '                 on pc.produto = p.codigo'
      ''
      '                 join produtoscompostos pcp'
      '                 on pc.produto = pcp.composto'
      '            on ct.numero = pc.contrato)'
      ''
      '      where ct.numero = pc.contrato'
      '        and ct.situacao = '#39'F'#39
      '        and (ct.os IS NULL OR not ct.os)'
      
        '        and not exists (select c2.numero from contratos c2 where' +
        ' c2.origem = ct.numero)'
      '        and c.conferircomposto'
      ''
      '        %Filial'
      '        %Vendedor'
      '        %ContratosFuturo'
      ''
      '        %Contrato'
      ''
      ''
      
        '      group by pc.contrato, pcp.componente, pc.produto, pc.vende' +
        'dor, pc.filial, pc.entrega'
      ''
      '     )'
      ''
      ''
      ' ) as pc'
      ''
      
        ' group by contrato, composto, produto, ordem, vendedor, filial, ' +
        'entrega'
      ''
      ') pc join produtos p'
      '          join caracteristicas c'
      '          on p.caracteristica = c.codigo'
      '  on pc.produto = p.codigo'
      ''
      ''
      '  join produtos p2'
      '  on pc.composto = p2.codigo'
      ''
      ') as pc left join usuarios u on pc.vendedor = u.codigo'
      ''
      
        'group by localizacao, sublocalizacao, produtovisual, descricao, ' +
        'valorgrade1, valorgrade2, filial, vendedor, u.nome /*, compostov' +
        'isual*/'
      ''
      
        'order by localizacao, sublocalizacao, produtovisual, descricao, ' +
        'valorgrade1, valorgrade2, filial, vendedor, u.nome /*, compostov' +
        'isual*/'
      ''
      '')
    RequestLive = False
    Left = 640
    Top = 232
  end
  object qryProdutosEntregar_O_R: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'Situacao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Vendedor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ContratosFuturo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Contrato'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      ';'
      
        'select localizacao, sublocalizacao, produtovisual, descricao, fi' +
        'lial,'
      
        '       valorgrade1, valorgrade2, /*compostovisual,*/ vendedor, u' +
        '.nome as nomevendedor,'
      
        '       array_to_string(array_agg(trim(pc.contrato)),chr(13)) as ' +
        'ListaContrato,'
      '       sum(pendente_contrato) as pendente_contrato'
      'from'
      '('
      'select  pc.contrato,'
      '        p.descricao,  pc.filial,'
      '        p.valorgrade1,'
      '        p.valorgrade2,'
      '        pc.vendedor,'
      ''
      '       (select e.localizacao'
      '        from estoques e'
      '        where e.produto = pc.produto'
      '          and e.filial = pc.filial) as localizacao,'
      ''
      '       (select e.sublocalizacao'
      '        from estoques e'
      '        where e.produto = pc.produto'
      '          and e.filial = pc.filial) as sublocalizacao,'
      ''
      ''
      '       p.codigovisual as produtovisual,'
      '       p2.codigovisual as compostovisual,'
      ''
      '       pc.pendente_contrato'
      ''
      'from'
      '('
      ''
      '  ('
      '  Select pc.contrato,'
      '         pc.produto,'
      '         pc.produto as composto,'
      '         pc.vendedor,'
      '         pc.filial,'
      '         pc.entrega,'
      
        '         sum(pc.quantidade-coalesce(pc.cancelado,0))  as pendent' +
        'e_contrato,'
      '         1 as ordem'
      ''
      ''
      '  from (contratos ct'
      '        join produtoscontratos pc'
      '             join produtos p'
      '                  join caracteristicas c'
      '                  on p.caracteristica = c.codigo'
      '             on pc.produto = p.codigo'
      '        on ct.numero = pc.contrato)'
      ''
      '  where ct.numero = pc.contrato /* AND CT.numero = '#39'923492'#39'*/ '
      '    and not coalesce(c.conferircomposto,false)'
      ''
      '    %Situacao'
      '    %Filial'
      '    %Vendedor'
      '    %ContratosFuturo'
      ''
      '    %Contrato'
      ''
      
        '  group by pc.contrato, pc.produto, pc.vendedor, pc.filial, pc.e' +
        'ntrega'
      '  )'
      ''
      '  union all'
      ''
      '  ('
      ''
      '  Select pc.contrato,'
      '         pcp.componente as produto,'
      '         pc.produto as composto,'
      '         pc.vendedor,'
      '         pc.filial,'
      '         pc.entrega,'
      
        '         sum((pc.quantidade * pcp.quantidade) - coalesce((pc.can' +
        'celado * pcp.quantidade),0))  as pendente_contrato,'
      '         2 as ordem'
      ''
      '  from (contratos ct'
      '        join produtoscontratos pc'
      '             join produtos p'
      '                  join caracteristicas c'
      '                  on p.caracteristica = c.codigo'
      '             on pc.produto = p.codigo'
      '             join produtoscompostos pcp'
      ''
      '             on pc.produto = pcp.composto'
      '        on ct.numero = pc.contrato)'
      ''
      '  where ct.numero = pc.contrato   /*AND CT.numero = '#39'923492'#39'*/'
      '    and c.conferircomposto'
      ''
      '    %Situacao'
      '    %Filial'
      '    %Vendedor'
      '    %ContratosFuturo'
      ''
      '    %Contrato'
      ''
      
        '  group by pc.contrato, pc.produto, pcp.componente, pc.vendedor,' +
        ' pc.filial, pc.entrega'
      ''
      ''
      '  )'
      ''
      ''
      ') pc join produtos p'
      '          join caracteristicas c'
      '          on p.caracteristica = c.codigo'
      '  on pc.produto = p.codigo'
      ''
      '  join produtos p2'
      '  on pc.composto = p2.codigo'
      ''
      ') as pc  left join usuarios u on pc.vendedor = u.codigo'
      ''
      
        'group by localizacao, sublocalizacao, produtovisual, descricao, ' +
        'valorgrade1, valorgrade2, /*compostovisual,*/ filial, vendedor, ' +
        'u.nome'
      ''
      
        'order by localizacao, sublocalizacao, produtovisual, descricao, ' +
        'valorgrade1, valorgrade2, /*compostovisual,*/ filial, vendedor, ' +
        'u.nome'
      ''
      '')
    RequestLive = False
    Left = 648
    Top = 312
  end
