    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select   sc.contrato,'
      '             sc.servico,'
      '             s.descricao as descricaoservico,'
      '             sc.quantidade,'
      '             sc.aliquotaissqn,'
      '             sc.valorservico,'
      '             sc.complementoservico,'
      '             sc.equipamento,'
      '             e.descricao as descricaoequipamento,'
      '             e.referencia,'
      '             e.marca,'
      '             e.modelo,'
      '             e.opcionais,'
      '             e.ano,'
      '             m.descricao as descricaomarca'
      'From     servicoscontratos sc '
      
        '                  left join (equipamentos e left join marcas m o' +
        'n (e.marca = m.codigo))'
      
        '                        on  (sc.equipamento = e.codigo), servico' +
        's s'
      'Where  (sc.servico = s.codigo) and'
      '            (sc.contrato =:contrato)')
    RequestLive = True
