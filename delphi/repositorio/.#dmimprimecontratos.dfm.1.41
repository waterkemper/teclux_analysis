  object qryProdutosContratos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryProdutosContratosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'OrderBy'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select pc.*'
      'from'
      '('
      '  ('
      '    select pc.contrato,'
      '           pc.produto,'
      '           p.codigovisual as produtovisual,'
      '           pc.produto as composto,'
      '           p.codigovisual as compostovisual,'
      '           1 as ordem,'
      '           pc.filial,'
      '           pc.numero,'
      '           pc.quantidade,'
      '           pc.cancelado,'
      '           pc.precovenda,'
      '           pc.precotabela,'
      '           pc.descricaoprecovenda,'
      '           pc.montagem,'
      '           pc.entrega,'
      '           pc.produtolista,'
      '           coalesce((select m.emestoque'
      '                     from movimentos m'
      '                     where m.numero = (select max(m2.numero)'
      '                                       from movimentos m2'
      
        '                                       where (m2.produto = pc.pr' +
        'oduto) and'
      
        '                                             (m2.filial = pc.fil' +
        'ial)'
      '                                      )'
      '                   ),0)'
      '           as emestoque,'
      '           coalesce((select m.reservado'
      '                     from movimentos m'
      '                     where m.numero = (select max(m2.numero)'
      '                                       from movimentos m2'
      
        '                                       where (m2.produto = pc.pr' +
        'oduto) and'
      
        '                                             (m2.filial = pc.fil' +
        'ial)'
      '                                      )'
      '                   ),0)'
      '           as reservado,'
      '           coalesce((select m.futuro'
      '                     from movimentos m'
      '                     where m.numero = (select max(m2.numero)'
      '                                       from movimentos m2'
      
        '                                       where (m2.produto = pc.pr' +
        'oduto) and'
      
        '                                             (m2.filial = pc.fil' +
        'ial)'
      '                                      )'
      '                   ),0)'
      '           as futuro,'
      ''
      '           p.descricao,'
      '           c.unidade,'
      '           c.vendanegativa as vendasemestoque,'
      
        '           Selecionar_Aliquotaicms(:estadofilialbase, :Estadocfo' +
        ', :tipoPessoa, pc.produto) as aliquotaicms,'
      '           c.icms,'
      ''
      '           (select i.aliquota'
      '            from ipi i'
      '            where i.codigo = c.ipi'
      '           ) as aliquotaipi,'
      ''
      '           c.origem,'
      ''
      '           (select t.valor'
      '            from tributosicms t'
      '            where t.codigo = c.incidencia) as incidencia,'
      ''
      ''
      '           (select f.transfautomatica'
      '            from filiais f'
      '            where f.codigo = pc.filial'
      '            ) as transfautomatica,'
      ''
      '           c.montagem as montagemoriginal,'
      ''
      '           c.percreducaobase,'
      ''
      '           pc.reserva,'
      '           pc.brinde,'
      '           pc.vendedor,'
      ''
      '           (select u.nome'
      '            from usuarios u'
      '            where u.codigo = pc.vendedor) as nomevendedor,'
      ''
      '           pc.movimento,'
      ''
      '           cast(0 as numeric(9,3)) as qtdecopiar,'
      '           (select pr.quantidade'
      '            from produtosreservas pr'
      '            where (pc.produto = pr.produto) and'
      '                       (pc.filial = pr.filial) and'
      '                       (pc.reserva = pr.reserva)'
      '           ) as qtdereservaprevia,'
      ''
      '           false as incluirnanotafiscal,'
      '           false as incluirnalistacasamento,'
      '           false as promocao,'
      ''
      
        '           (select g.descricao from grades g, caracteristicas c ' +
        'where c.codigo = p.caracteristica and g.codigo = c.grade1) as li' +
        'nha,'
      
        '           (select g.descricao from grades g, caracteristicas c ' +
        'where c.codigo = p.caracteristica and g.codigo = c.grade2) as co' +
        'luna,'
      ''
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      ''
      '           cast(null as bigint) as codigobarras,'
      '           p.referencia,'
      
        '           case when c.emitecomplemento then c.complemento else ' +
        'cast(null as varchar(1000)) end as complemento,'
      '           c.anvisa,'
      
        '           (select cast(trim(coalesce(e.localizacao,'#39#39')||cast('#39' ' +
        #39' as varchar(1))||coalesce(e.sublocalizacao,'#39#39')) as varchar(41))'
      
        '            from estoques e where e.produto = pc.produto and e.f' +
        'ilial = pc.filial) as localizacao'
      ''
      '    from produtoscontratos pc, produtos p, caracteristicas c'
      '    where (p.codigo = pc.produto)'
      '      and (p.caracteristica = c.codigo)'
      '      and (contrato = :contrato)'
      ''
      '  )'
      ''
      '  union all'
      ''
      '  ('
      ''
      '    select pc.contrato,'
      '           pcp.componente as produto,'
      
        '           (select p1.codigovisual from produtos p1 where p1.cod' +
        'igo = pcp.componente) as produtovisual,'
      '           pc.produto as composto,'
      '           p.codigovisual as compostovisual,'
      '           2 as ordem,'
      '           pc.filial,'
      '           pc.numero,'
      '           (pcp.quantidade * pc.quantidade) as quantidade,'
      '           pc.cancelado,'
      
        '           cast(null as numeric(19,10)) as precovenda, /* pc.pre' +
        'covenda, */'
      '           pc.precotabela,'
      '           pc.descricaoprecovenda,'
      '           pc.montagem,'
      '           pc.entrega,'
      '           pc.produtolista,'
      '           coalesce((select m.emestoque'
      '                     from movimentos m'
      '                     where m.numero = (select max(m2.numero)'
      '                                       from movimentos m2'
      
        '                                       where (m2.produto = pc.pr' +
        'oduto) and'
      
        '                                             (m2.filial = pc.fil' +
        'ial)'
      '                                      )'
      '                   ),0)'
      '           as emestoque,'
      '           coalesce((select m.reservado'
      '                     from movimentos m'
      '                     where m.numero = (select max(m2.numero)'
      '                                       from movimentos m2'
      
        '                                       where (m2.produto = pc.pr' +
        'oduto) and'
      
        '                                             (m2.filial = pc.fil' +
        'ial)'
      '                                      )'
      '                   ),0)'
      '           as reservado,'
      '           coalesce((select m.futuro'
      '                     from movimentos m'
      '                     where m.numero = (select max(m2.numero)'
      '                                       from movimentos m2'
      
        '                                       where (m2.produto = pc.pr' +
        'oduto) and'
      
        '                                             (m2.filial = pc.fil' +
        'ial)'
      '                                      )'
      '                   ),0)'
      '           as futuro,'
      ''
      
        '           (select p1.descricao from produtos p1 where p1.codigo' +
        ' = pcp.componente) as descricao,'
      ''
      '           c.unidade,'
      '           c.vendanegativa as vendasemestoque,'
      
        '           Selecionar_Aliquotaicms(:estadofilialbase, :Estadocfo' +
        ', :tipoPessoa, pc.produto) as aliquotaicms,'
      '           c.icms,'
      ''
      '           (select i.aliquota'
      '            from ipi i'
      '            where i.codigo = c.ipi'
      '           ) as aliquotaipi,'
      ''
      '           c.origem,'
      ''
      '           (select t.valor'
      '            from tributosicms t'
      '            where t.codigo = c.incidencia) as incidencia,'
      ''
      ''
      '           (select f.transfautomatica'
      '            from filiais f'
      '            where f.codigo = pc.filial'
      '            ) as transfautomatica,'
      ''
      '           c.montagem as montagemoriginal,'
      ''
      '           c.percreducaobase,'
      ''
      '           pc.reserva,'
      '           pc.brinde,'
      '           pc.vendedor,'
      ''
      '           (select u.nome'
      '            from usuarios u'
      '            where u.codigo = pc.vendedor) as nomevendedor,'
      ''
      '           pc.movimento,'
      ''
      '           cast(0 as numeric(9,3)) as qtdecopiar,'
      '           (select pr.quantidade'
      '            from produtosreservas pr'
      '            where (pc.produto = pr.produto) and'
      '                       (pc.filial = pr.filial) and'
      '                       (pc.reserva = pr.reserva)'
      '           ) as qtdereservaprevia,'
      ''
      '           false as incluirnanotafiscal,'
      '           false as incluirnalistacasamento,'
      '           false as promocao,'
      ''
      
        '           (select g.descricao from grades g, caracteristicas c ' +
        'where c.codigo = p.caracteristica and g.codigo = c.grade1) as li' +
        'nha,'
      
        '           (select g.descricao from grades g, caracteristicas c ' +
        'where c.codigo = p.caracteristica and g.codigo = c.grade2) as co' +
        'luna,'
      ''
      
        '           (select p1.valorgrade1 from produtos p1 where p1.codi' +
        'go = pcp.componente) as valorgrade1, /* p.valorgrade1, */'
      
        '           (select p1.valorgrade2 from produtos p1 where p1.codi' +
        'go = pcp.componente) as valorgrade2, /*p.valorgrade2, */'
      ''
      '           cast(null as bigint) as codigobarras,'
      ''
      
        '           (select p1.referencia from produtos p1 where p1.codig' +
        'o = pcp.componente) as referencia,'
      ''
      
        '           case when c.emitecomplemento then c.complemento else ' +
        'cast(null as varchar(1000)) end as complemento,'
      
        '           (select c1.anvisa from caracteristicas c1, produtos p' +
        '1 where p1.caracteristica = c1.codigo and p1.codigo = pcp.compon' +
        'ente) as anvisa, /* c.anvisa, */'
      ''
      
        '           (select cast(trim(coalesce(e.localizacao,'#39#39')||cast('#39' ' +
        #39' as varchar(1))||coalesce(e.sublocalizacao,'#39#39')) as varchar(41))'
      '           '
      
        '            from estoques e where e.produto = pcp.componente and' +
        ' e.filial = pc.filial) as localizacao'
      ''
      ''
      
