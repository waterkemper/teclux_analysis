procedure TdtmImprimeContratos.SetOrdenacaoProdutos(const Value: String);
begin
  FOrdenacaoProdutos := Value;
  if qryProdutosContratos.FindField(FOrdenacaoProdutos)<>nil then
    qryProdutosContratos.macrobyname('OrderBy').AsString := 'ORDER BY '+FOrdenacaoProdutos
  else
  begin
    qryProdutosContratos.macrobyname('OrderBy').AsString := 'ORDER BY numero';
    FOrdenacaoProdutos := 'numero';
  end;
end;

function TdtmImprimeContratos.Contratosconsideracoesm: String;
var
  vObservacao: String;

begin
  result := qryContratosconsideracoes.AsString;

  if (qryContratosfrete_transportadora.asString <> '') then
    vObservacao := ' TRANSPORTE: ' + qryContratosfrete_transportadora.asString;

  if qryContratosfrete_mensagem.asString <> '' then
  begin
    if (vObservacao <> '') then
      vObservacao := vObservacao + ' - ' + qryContratosfrete_mensagem.asString
    else
      vObservacao := ' TRANSPORTE: ' + qryContratosfrete_mensagem.asString;
  end;

  if qryContratosfrete_servico.asString <> '' then
  begin
    if vObservacao <> '' then
      vObservacao := vObservacao + ' SERVIÇO: ' + qryContratosfrete_servico.asString
    else
      vObservacao := 'SERVIÇO: ' + qryContratosfrete_servico.asString;
  end;

  if qryContratosfrete_prazo_entrega.AsInteger <> 0 then
  begin
    if vObservacao <> '' then
      vObservacao := vObservacao + ' PRAZO ENTREGA: ' + qryContratosfrete_prazo_entrega.AsString + ' DIAS UTEIS'
    else
      vObservacao := 'PRAZO ENTREGA: ' + qryContratosfrete_prazo_entrega.AsString + ' DIAS UTEIS';
  end;

  if not qryContratosfilial_retirada.IsNull then
  begin
    if vObservacao <> '' then
      vObservacao := vObservacao + ' FILIAL DE RETIRADA: ' + qryContratosfilial_retirada.AsString + ' - ' + qryContratosnomefilialretirada.asString
    else
      vObservacao := ' FILIAL DE RETIRADA: ' + qryContratosfilial_retirada.AsString + ' - ' + qryContratosnomefilialretirada.asString;
  end;

  if vObservacao<>'' then
    result := result + vObservacao;
end;

procedure TdtmImprimeContratos.qryProdutosContratosCalcFields(
  DataSet: TDataSet);
begin
  inherited;

  if not qryProdutosContratosvalorgrade1.isnull and
     not qryProdutosContratosvalorgrade2.isnull then

    qryProdutosContratosdescricaolc.asString := qryProdutosContratosdescricao.asString+' '+
                                                qryProdutosContratosvalorgrade1.asString+' '+
                                                qryProdutosContratosvalorgrade2.asString

  else
  if not qryProdutosContratosvalorgrade1.isnull and
         qryProdutosContratosvalorgrade2.isnull then

    qryProdutosContratosdescricaolc.asString := qryProdutosContratosdescricao.asString+' '+
                                                qryProdutosContratosvalorgrade1.asString

  else
  if     qryProdutosContratosvalorgrade1.isnull and
     not qryProdutosContratosvalorgrade2.isnull then

    qryProdutosContratosdescricaolc.asString := qryProdutosContratosdescricao.asString+' '+
                                                qryProdutosContratosvalorgrade2.asString

  else

    qryProdutosContratosdescricaolc.asString := qryProdutosContratosdescricao.asString;


 if qryProdutosContratosanvisa.asstring <> '' then
   qryProdutosContratosdescricaolc.asString := qryProdutosContratosdescricaolc.asString + ' MS - ' +
                                               qryProdutosContratosanvisa.asstring;


end;

end.
