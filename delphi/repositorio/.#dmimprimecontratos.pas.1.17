implementation

{$R *.dfm}

{ TdtmImprimeContratos }

procedure TdtmImprimeContratos.ImprimirContratos(Numero: String; SimplesMeiaPagina: Boolean);
Var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
  LinhaE: T_Extenso;
  ValorExtenso, ResultExtenso: String;
  //  I:integer;
begin

  qryContratos.parambyname('numero').asString := Numero;
  qryContratos.MacroByName('ListaNumeros').asString := Numero;

//  ReFazConsulta(qryContratos,[0],[Numero]);
  qryContratos.Close;
  qryContratos.Open;

{
  Trocado para o afterscroll do contrato

  if qryparcelas.recordcount > 36 then
  begin
    frVariables['IMPRIMINDOQUANTIDADE']  := True;
    dspParcelas.DataSet := qryParcelasImprimir;
    ReFazConsulta(qryParcelasImprimir, [0],[Numero]);
  end
  else
  begin
    qryParcelasImprimir.Close;
    dspParcelas.DataSet := qryParcelas;
    frVariables['IMPRIMINDOQUANTIDADE']  := False;
  end;
  cdsparcelas.close;
  cdsParcelas.Open;
}


  frVariables['Juros']        := ParSistema.PercentualAtrasoJuros2;
  if ParSistema.PercentualAtrasoMultas2 > 0 then
    frVariables['Multa']      := 'e multa contratual de '+floattostr(ParSistema.PercentualAtrasoMultas2)+'% '
  else
    frVariables['Multa']      := '';
  LinhaE.ExtTamLinha[1]:= 150;
  Extenso(ParSistema.PercentualAtrasoJuros2,$92,'VIRGULA','VIRGULA',' ',' ',' ', LinhaE);
  ValorExtenso:= Trim(LinhaE.ExtLinha[1]);
  if Pos(',',floattostr(ParSistema.PercentualAtrasoJuros2)) = 0 then
    ResultExtenso:= Trocar(ValorExtenso,'VIRGULA','')
  else
    ResultExtenso:= Trocar(ValorExtenso,'VIRGULA E ','VIRGULA ');
  frVariables['JurosExtenso'] := ResultExtenso+ ' POR CENTO';
  frVariables['RazaoSemAcento']:= RetiraAcento(RazaoFilialBase);

  if not qryContratos.IsEmpty then
  begin
//     Trocado para o afterscroll do contrato
//    RefazConsulta(qryContratosEntradas,[0],[Numero]);

    frVariables['Nome']  := RazaoFilialBase;
    frVariables['NomeCliente'] := RetiraAcento(qryContratosnome.asString);
    frVariables['Rua']   := RuaFilialBase;
    frVariables['RuaFilialBase']   := RuaFilialBase;
    frVariables['Bairro']:= BairroFilialBase + ' - CEP: ' + Copy(CEPFilialBase,1,2)+'.'+Copy(CEPFilialBase,3,3)+'-'+Copy(CEPFilialBase,6,3);
    frVariables['BairroFilialBase']:= BairroFilialBase + ' - CEP: ' + Copy(CEPFilialBase,1,2)+'.'+Copy(CEPFilialBase,3,3)+'-'+Copy(CEPFilialBase,6,3);
    frVariables['Cidade']:= CidadeFilialBase + ' - ' + EstadoFilialBase;
    frVariables['Fone']  := FormatarFone(DDDFilialBase,FoneFilialBase);
    frVariables['Outras']:= RazaoFilialBase;
// Trocado para o afterscroll do contrato
//    frVariables['TabelaProdutosVazia']:= qryProdutosContratos.IsEmpty;
//    frVariables['TabelaServicosVazia']:= qryServicosContratos.IsEmpty;

    frVariables['titulo']:='CONTRATO DE COMPRA E VENDA';
    frVariables['ImprimirTaxadeJuros'] := parsistema.ImprimirTaxadeJuros;


    IF (qryProdutosContratos.RecordCount > 17) then
      frVariables['PRODUTOS']:= 1
    ELSE
      frVariables['PRODUTOS']:= 0;

//    frpContratosSimplesMeiaPagina.DesignReport;
//    frpContratos.DesignReport;
    frmPreview := TfrmPreviewPadrao.create(self);
    frmPreview.cmbZoom.ItemIndex := 4;
    try
      Relatorio := frmPreview.frCompositeReport;
      frmPreview.frCompositeReport.Reports.Clear;
      if SimplesMeiaPagina then
      begin
//        frpContratosSimplesMeiaPagina.designreport;
        frmPreview.frCompositeReport.Reports.Add(frpContratosSimplesMeiaPagina);
      end
      else
      if ParSistema.ImprimirContratoSimples then
      begin
//        frpContratosSimples.designreport;
        frmPreview.frCompositeReport.Reports.Add(frpContratosSimples)
      end
      {
      else
      if ParSistema.ImprimirContratoSimplesMeiaPagina then
        frmPreview.frCompositeReport.Reports.Add(frpContratosSimplesMeiaPagina)
      }

      else if ParSistema.ImprimirContratoPadrao then
      begin
//        frpContratos.DesignReport;
        frmPreview.frCompositeReport.Reports.Add(frpContratos)
      end
      else if ParSistema.ImprimirContratoFrenteVerso then
      begin
        {$IFDEF LINUX}
        frmPreview.frCompositeReport.Reports.Add(frpDadoseProdutos_Linux);
        frmPreview.frCompositeReport.Reports.Add(frpParcelas_Linux_16);
        {$ELSE }
        frmPreview.frCompositeReport.Reports.Add(frpDadoseProdutos_Windows);
        frmPreview.frCompositeReport.Reports.Add(frpParcelas_Windows_16);
        {$ENDIF}
      end
      else
      begin
        frmPreview.frCompositeReport.Reports.Add(frpContratos);
      end;
      Relatorio.Preview := frmPreview.frPreviewPadrao;
      Relatorio.ShowReport;
      frmPreview.ShowModal;
    finally
      frmPreview.Free;
    end;
  end;

end;

procedure TdtmImprimeContratos.qryContratosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  ReFazConsulta(qryServicosContratos,[0],[qryContratosnumero.AsString]);
  ReFazConsulta(qryParcelas,[0],[qryContratosnumero.AsString]);
  ReFazConsulta(qryProcuraNaturalidade, [0, 1],
                [qryContratosnaturalestado.AsString,
                 qryContratosnaturalcidade.AsInteger]);
  if not ParSistema.imprimircontratosimples then
  begin
    RefazConsulta(qryProcuraAvalista,[0],[qryContratosavalista.asinteger]);
    RefazConsulta(qryProcuraCargosCliente,[0],[qryContratosempcargo.asinteger]);
    RefazConsulta(qryConjuge,[0],[qryContratosconjuge.asinteger]);
    RefazConsulta(qryProcuraCargosConjuge,[0],[qryConjugeempcargo.asinteger]);
  end;
  ReFazConsulta(qryprocuravendedor,[0], [qrycontratosvendedor.asinteger]);
  RefazConsulta(qryplanopagamento,[0],[qrycontratosplano.asinteger]);
  qryProdutosContratos.Close;
  if FOrdenacaoProdutos='' then
    OrdenacaoProdutos := 'numero';
  ReFazConsulta(qryProdutosContratos,[3],[qryContratosnumero.AsString]);
  qryProdutosContratos.Open;


  if qryparcelas.recordcount > 36 then
  begin
    frVariables['IMPRIMINDOQUANTIDADE']  := True;
    dspParcelas.DataSet := qryParcelasImprimir;
    ReFazConsulta(qryParcelasImprimir, [0],[qryContratosNumero.asString]);
  end
  else
  begin
    qryParcelasImprimir.Close;
    dspParcelas.DataSet := qryParcelas;
    frVariables['IMPRIMINDOQUANTIDADE']  := False;
  end;
  cdsparcelas.close;
  cdsParcelas.Open;

  RefazConsulta(qryContratosEntradas,[0],[qryContratosNumero.asString]);

  frVariables['TabelaProdutosVazia']:= qryProdutosContratos.IsEmpty;
  frVariables['TabelaServicosVazia']:= qryServicosContratos.IsEmpty;



end;

procedure TdtmImprimeContratos.qryContratosCalcFields(DataSet: TDataSet);
begin
  inherited;
  qryContratosTotalLiquidoServicos.AsCurrency := qryContratostotalservicos.AsCurrency - qryContratosimpostoretido.AsCurrency;
  qryContratosconsideracoesm.asstring := Contratosconsideracoesm;
end;

