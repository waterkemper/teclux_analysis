        '                                           CASE WHEN pi.DataPagt' +
        'o IS NULL OR'
      
        '                                                     pi.DataPagt' +
        'o > :Data'
      '                                                THEN :Data'
      
        '                                                ELSE pi.DataPagt' +
        'o'
      
        '                                           END,true)) - pi.Valor' +
