  object qryParcelasAberto: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'SELECT *,'
      '       CASE WHEN :Data >= Database'
      '            THEN Database'
      '            ELSE (SELECT vi.Data FROM VendasImoveis vi'
      '                     WHERE vi.Contrato =:Contrato)'
      '       END AS DataBase2,'
      ''
      '       CASE WHEN :Data >= Database'
      '            THEN Moeda'
      
        '            ELSE (SELECT vi.IndexadorAteHabiteSe FROM VendasImov' +
        'eis vi'
      '                     WHERE vi.Contrato =:Contrato)'
      '       END AS Moeda2,'
      ''
      '       CASE WHEN Juros = 0'
      '            THEN NULL'
      '            ELSE Juros'
      '       END AS Juros2,'
      ''
      '       CASE WHEN Correcao = 0'
      '            THEN NULL'
      '            ELSE Correcao'
      '       END AS Correcao2'
      ''
      'FROM'
      '(SELECT pi.Contrato,'
      '        pi.Tipo,'
      '        pi.Origem,'
      '        pi.Numero,'
      '        pi.DataVencto,'
      '        pi.ValorHistorico,'
      '        pi.ValorContratado,'
      ''
      
        '       (SELECT ValorDevido(pi.Contrato, pi.Tipo, pi.Numero, pi.N' +
        'rPagto,'
      '                           CASE WHEN pi.DataPagto IS NULL OR'
      '                                     pi.DataPagto > :Data'
