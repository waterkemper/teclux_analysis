  object qryRecibos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'TipoPagto'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT pi.Contrato,'
      '       pi.Tipo,'
      '       pi.Origem,'
      '       pi.Numero,'
      '       pi.NrPagto,'
      '       pi.DataVencto,'
      '       pi.ValorHistorico,'
      '       pi.ValorContratado,'
      '       pi.Valorvencto,'
      '       '
      
        '      (SELECT ValorDevido(pi.Contrato, pi.Tipo, pi.Numero, pi.Nr' +
        'Pagto,'
      '                         (CASE WHEN pi.Datapagto IS NULL'
      '                               THEN CURRENT_DATE'
      '                               ELSE pi.Datapagto'
      '                          END))) AS ValorDevido,'
      '                          '
      
        '      (SELECT ValorCorrigido(pi.Contrato, pi.Tipo, pi.Numero, pi' +
        '.NrPagto,'
      '                            (CASE WHEN pi.Datapagto IS NULL'
      '                                  THEN CURRENT_DATE'
      '                                  ELSE pi.Datapagto'
      '                             END),true)) AS ValorCorrigido,'
      '       pi.Datapagto,'
      '       pi.ValorPagto,'
      
        '      (SELECT JurosContratuais(pi.Contrato, pi.Tipo, pi.Numero, ' +
        'pi.NrPagto,'
      '                              (CASE WHEN pi.Datapagto IS NULL'
      '                                    THEN CURRENT_DATE'
      '                                    ELSE pi.Datapagto'
      '                               END))) AS Juros,'
      '       pi.Moeda,'
      '      (SELECT m.Descricao'
      '          FROM Moedas m'
      '          WHERE pi.Moeda = m.Codigo) AS DescricaoMoeda,'
      '          '
      '       pi.Database,'
      '       pi.TaxaJuros,'
      '       pi.Juroscompostos,'
      '       pi.Cheque,'
      '       pi.ContaPagto,'
      '       pi.Agencia,'
      '       pi.BancoCheque,'
      '      (SELECT b.Nome'
      '          FROM Bancos b'
      '          WHERE pi.BancoCheque = b.Codigo) AS NomeBanco, '
      '          '
      '       pi.Emitente,'
      '       pi.ReciboPagto,'
      '       pi.Sequencia,'
      '       '
      
        '     ((SELECT ValorCorrigido(pi.Contrato, pi.Tipo, pi.Numero, pi' +
        '.NrPagto,'
      '                            (CASE WHEN pi.Datapagto IS NULL'
      '                                  THEN CURRENT_DATE'
      '                                  ELSE pi.Datapagto'
      
        '                             END),true)) - pi.ValorHistorico) AS' +
        ' Correcao,'
      '                             '
      '      (CASE WHEN pi.DataPagto IS NULL'
      '            THEN NULL'
      
        '            ELSE CASE WHEN (pi.Valorpagto - (SELECT ValorDevido(' +
        'pi.Contrato, pi.Tipo,'
      
        '                                                                ' +
        'pi.Numero,pi.NrPagto,'
      
        '                                                                ' +
        'pi.Datapagto))) = 0'
      '                      THEN NULL'
      
        '                      ELSE (pi.Valorpagto - (SELECT ValorDevido(' +
        'pi.Contrato, pi.Tipo,'
      
        '                                                                ' +
        'pi.Numero,   pi.NrPagto,'
      
        '                                                                ' +
        'pi.Datapagto)))'
      '                 END'
      '       END) AS Diferenca,'
      '       '
      '       pi.Promissoria,'
      '       pi.Documento,'
      '       pi.Observacoes,'
      '       pi.TipoPagto,'
      '       '
      '      (SELECT coalesce(v.razao,v.nome)'
      '          FROM vFornecedores v'
      
        '               JOIN Compradores co ON v.Codigo    = co.Cliente  ' +
        '   AND'
      
        '                                      v.Tipo      = co.TipoClien' +
        'te AND'
      '                                      pi.Contrato = co.Contrato'
      '          WHERE v.Codigo    = co.Cliente     AND'
      '                v.tipo      = co.tipoCliente AND'
      '                pi.Contrato = co.Contrato    AND'
      '                co.Principal) AS NomeCliente,'
      '                '
      '      (SELECT v.Sexo'
      '          FROM vFornecedores v'
      
        '               JOIN Compradores co ON v.Codigo    = co.Cliente  ' +
        '   AND'
      
        '                                      v.Tipo      = co.TipoClien' +
        'te AND'
      '                                      pi.Contrato = co.Contrato'
      '          WHERE v.Codigo    = co.Cliente     AND'
      '                v.tipo      = co.tipoCliente AND'
      '                pi.Contrato = co.Contrato    AND'
      '                co.Principal) AS Sexo,'
      '                '
      '       FALSE AS Selecionado'
      '       '
      'FROM parcelasimoveis pi'
      ''
      'WHERE pi.Contrato = :Contrato AND'
      '      ReciboPagto = :Recibo'
      '%TipoPagto'
      '')
    RequestLive = False
    Left = 288
    Top = 120
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Contrato'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'Recibo'
        ParamType = ptUnknown
      end>
