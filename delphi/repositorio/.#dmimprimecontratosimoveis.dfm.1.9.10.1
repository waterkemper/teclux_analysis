  object qryParcelasContrato: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'SELECT *,'
      
        '       CASE WHEN ((:Data > DataBase) OR (MoedaAteHabiteSe IS NUL' +
        'L)) AND'
      
        '                 (EXTRACT(YEAR  FROM CAST(:Data AS DATE)) <> EXT' +
        'RACT(YEAR  FROM COALESCE(Habite_Se, CURRENT_DATE+1)) OR'
      
        '                  EXTRACT(MONTH FROM CAST(:Data AS DATE)) <> EXT' +
        'RACT(MONTH FROM COALESCE(Habite_Se, CURRENT_DATE+1)))'
      '            THEN Database'
      '            ELSE DataBaseAteHabiteSe'
      '       END AS DataBase2,'
      ''
      
        '        CASE WHEN ((:Data > DataBase) OR (MoedaAteHabiteSe IS NU' +
        'LL)) AND'
      
        '                 (EXTRACT(YEAR  FROM CAST(:Data AS DATE)) <> EXT' +
        'RACT(YEAR  FROM COALESCE(Habite_Se, CURRENT_DATE+1)) OR'
      
        '                  EXTRACT(MONTH FROM CAST(:Data AS DATE)) <> EXT' +
        'RACT(MONTH FROM COALESCE(Habite_Se, CURRENT_DATE+1)))'
      '            THEN Moeda'
      '            ELSE MoedaAteHabiteSe'
      '       END AS Moeda2,'
      ''
      '       CASE WHEN Juros = 0'
      '            THEN NULL'
      '            ELSE Juros'
      '       END AS Juros2,'
      ''
      '       CASE WHEN Correcao = 0'
      '            THEN NULL'
      '            ELSE Correcao'
      '       END AS Correcao2'
      ''
      'FROM'
      ''
      '('
      ' SELECT pi.Contrato,'
      '        pi.Tipo,'
      '        pi.Origem,'
      '        pi.Numero,'
      '        pi.DataVencto,'
      ''
      
        '        CASE WHEN (:Data < CURRENT_DATE AND (pi.DataPagto IS NUL' +
        'L OR'
      
        '                                             pi.DataPagto  > :Da' +
        'ta)) AND'
      
        '                                             pi.DataPagto <> :Da' +
        'ta   AND'
      '                     (SELECT COUNT(*) FROM ParcelasImoveis'
      
        '                      WHERE Contrato = pi.Contrato AND Tipo    =' +
        ' pi.Tipo AND'
      
        '                            Numero   = pi.Numero   AND NrPagto >' +
        ' pi.NrPagto) > 0'
      '             THEN pi.ValorHistorico +'
      '                         (SELECT SUM(ValorHistorico)'
      '                             FROM ParcelasImoveis'
      
        '                             WHERE Contrato = pi.Contrato AND Ti' +
        'po    = pi.Tipo AND'
      
        '                                   Numero   = pi.Numero   AND Nr' +
        'Pagto > pi.NrPagto)'
      '             ELSE pi.ValorHistorico'
      '         END as ValorHistorico,'
      ''
      '         CASE WHEN :Data >= pi.DataBase'
      
        '         THEN CASE WHEN (:Data < CURRENT_DATE AND (pi.DataPagto ' +
        'IS NULL OR'
      
        '                                                   pi.DataPagto ' +
        '> :Data)) AND'
      
        '                        pi.DataPagto <> :Data AND (SELECT COUNT(' +
        '*) FROM ParcelasImoveis'
      
        '                                                      WHERE Cont' +
        'rato = pi.Contrato AND Tipo    = pi.Tipo AND'
      
        '                                                            Nume' +
        'ro   = pi.Numero   AND NrPagto > pi.NrPagto) > 0'
      ''
      
        '                    THEN CASE WHEN vi.Habite_Se IS NULL OR vi.Ha' +
        'bite_Se > :Data'
      
        '                              THEN pi.ValorContratado + (SELECT ' +
        'SUM(CASE WHEN DataBaseAteHabiteSe IS NULL'
      
        '                                                                ' +
        '         THEN ValorContratado'
      
        '                                                                ' +
        '         ELSE ValorContratadoAteHabiteSe'
      
        '                                                                ' +
        '    END)'
      
        '                                                            FROM' +
        ' ParcelasImoveis'
      
        '                                                            WHER' +
        'E Contrato = pi.Contrato AND Tipo    = pi.Tipo AND'
      
        '                                                                ' +
        '  Numero   = pi.Numero   AND NrPagto > pi.NrPagto)'
      ''
      
        '                              ELSE pi.ValorContratadoAteHabiteSe' +
        ' + (SELECT SUM(ValorContratadoAteHabiteSe)'
      
        '                                                                ' +
        '       FROM ParcelasImoveis'
      
        '                                                                ' +
        '       WHERE Contrato = pi.Contrato AND Tipo    = pi.Tipo AND'
      
        '                                                                ' +
        '             Numero   = pi.Numero   AND NrPagto > pi.NrPagto)'
      '                         END'
      '                    ELSE pi.ValorContratado'
      '              END'
      ''
      
        '         ELSE CASE WHEN (:Data < CURRENT_DATE AND (pi.DataPagto ' +
        'IS NULL OR'
      
        '                                                   pi.DataPagto ' +
        '> :Data)) AND'
      
        '                         pi.DataPagto <> :Data AND (SELECT COUNT' +
        '(*) FROM ParcelasImoveis'
      
        '                                                       WHERE Con' +
        'trato = pi.Contrato AND Tipo    = pi.Tipo AND'
      
        '                                                             Num' +
        'ero   = pi.Numero   AND NrPagto > pi.NrPagto) > 0'
      
        '                   THEN pi.ValorContratadoAteHabiteSe + (SELECT ' +
        'SUM(ValorContratadoAteHabiteSe)'
      
        '                                                           FROM ' +
        'ParcelasImoveis'
      
        '                                                           WHERE' +
        ' Contrato = pi.Contrato AND Tipo    = pi.Tipo AND'
      
        '                                                                ' +
        ' Numero   = pi.Numero   AND NrPagto > pi.NrPagto)'
      '                   ELSE pi.ValorContratadoAteHabiteSe'
      '              END'
      '         END AS ValorContratado,'
      ''
      ''
      
        '       (SELECT ValorDevido(pi.Contrato, pi.Tipo, pi.Numero, pi.N' +
        'rPagto,'
      '                           CASE WHEN pi.DataPagto IS NULL OR'
      '                                     pi.DataPagto > :Data'
      '                                THEN :Data'
      '                                ELSE pi.DataPagto'
      '                           END)) AS ValorDevido,'
      ''
      
        '       (SELECT ValorCorrigido(pi.Contrato, pi.Tipo, pi.Numero, p' +
        'i.NrPagto,'
      '                              CASE WHEN pi.DataPagto IS NULL OR'
      '                                        pi.DataPagto > :Data'
      '                                   THEN :Data'
      '                                   ELSE pi.DataPagto'
      '                              END,true)) AS ValorCorrigido,'
      ''
      '        CASE WHEN pi.DataPagto IS NULL OR'
      '                  pi.DataPagto > :Data'
      '             THEN NULL'
      '             ELSE pi.DataPagto'
      '         END AS DataPagto,'
      ''
      '        CASE WHEN pi.DataPagto IS NULL OR'
      '                  pi.DataPagto > :Data'
      '             THEN NULL'
      '             ELSE pi.ValorPagto'
      '        END AS ValorPagto,'
      ''
      
        '       (SELECT JurosContratuais(pi.Contrato, pi.Tipo, pi.Numero,' +
        ' pi.NrPagto,'
      
        '                                CASE WHEN pi.DataPagto IS NULL O' +
        'R'
      '                                          pi.DataPagto > :Data'
      '                                     THEN :Data'
      '                                     ELSE pi.DataPagto'
      '                                END)) AS Juros,'
      '        pi.Moeda,'
      '        pi.MoedaAteHabiteSe,'
      '        pi.Database,'
      '        pi.DataBaseAteHabiteSe,'
      '        vi.Habite_Se,        '
      ''
      '        CASE WHEN :Data > pi.DataBase AND'
      
        '                 (EXTRACT(YEAR  FROM CAST(:Data AS DATE)) <> EXT' +
        'RACT(YEAR  FROM COALESCE(vi.Habite_Se, CURRENT_DATE+1)) OR'
      
        '                  EXTRACT(MONTH FROM CAST(:Data AS DATE)) <> EXT' +
        'RACT(MONTH FROM COALESCE(vi.Habite_Se, CURRENT_DATE+1)))'
      '             THEN pi.TaxaJuros'
      '             ELSE pi.TaxaJurosAteHabiteSe'
      '        END AS TaxaJuros,'
      ''
      '        CASE WHEN :Data > pi.DataBase AND'
      
        '                 (EXTRACT(YEAR  FROM CAST(:Data AS DATE)) <> EXT' +
        'RACT(YEAR  FROM COALESCE(vi.Habite_Se, CURRENT_DATE+1)) OR'
      
        '                  EXTRACT(MONTH FROM CAST(:Data AS DATE)) <> EXT' +
        'RACT(MONTH FROM COALESCE(vi.Habite_Se, CURRENT_DATE+1)))'
      '             THEN pi.JurosCompostos'
      '             ELSE pi.TipoJurosAteHabiteSe'
      '        END AS JurosCompostos,'
      ''
      ''
      
        '        CASE WHEN (:Data < CURRENT_DATE AND (pi.DataPagto IS NUL' +
        'L OR'
      
        '                                             pi.DataPagto  > :Da' +
        'ta)) AND'
      
        '                                             pi.DataPagto <> :Da' +
        'ta   AND'
      
        '                                             (SELECT COUNT(*) FR' +
        'OM ParcelasImoveis'
      
        '                                                WHERE Contrato =' +
        ' pi.Contrato AND Tipo    = pi.Tipo AND'
      
        '                                                      Numero   =' +
        ' pi.Numero   AND NrPagto > pi.NrPagto) > 0'
      
        '             THEN ((SELECT ValorCorrigido(pi.Contrato, pi.Tipo, ' +
        'pi.Numero, pi.NrPagto,'
      
        '                                          CASE WHEN pi.DataPagto' +
        ' IS NULL OR'
      
        '                                                    pi.DataPagto' +
        ' > :Data'
      '                                               THEN :Data'
      '                                               ELSE pi.DataPagto'
      
        '                                          END,true)) - pi.ValorH' +
        'istorico) +'
      
        '                   (SELECT SUM(((SELECT ValorCorrigido(pi2.Contr' +
        'ato, pi2.Tipo, pi2.Numero, pi2.NrPagto,'
      
        '                                                       CASE WHEN' +
        ' pi2.DataPagto IS NULL OR'
      
        '                                                                ' +
        ' pi2.DataPagto > :Data'
      
        '                                                            THEN' +
        ' :Data'
      
        '                                                            ELSE' +
        ' pi2.DataPagto'
      
        '                                                       END,true)' +
        ') - pi2.ValorHistorico))'
      '                                 FROM ParcelasImoveis pi2'
      
        '                                 WHERE pi2.Contrato = pi.Contrat' +
        'o AND pi2.Tipo    = pi.tipo AND'
      
        '                                       pi2.Numero   = pi.Numero ' +
        '  AND pi2.NrPagto > pi.NrPagto)'
      
        '             ELSE  ((SELECT ValorCorrigido(pi.Contrato, pi.Tipo,' +
        ' pi.Numero, pi.NrPagto,'
      
        '                                           CASE WHEN pi.DataPagt' +
        'o IS NULL OR'
      
        '                                                     pi.DataPagt' +
        'o > :Data'
      '                                                THEN :Data'
      
        '                                                ELSE pi.DataPagt' +
        'o'
      
        '                                           END,true)) - pi.Valor' +
        'Historico)'
      '        END as Correcao,'
      ''
      '       CASE WHEN pi.DataPagto IS NULL OR'
      '                 pi.DataPagto > :Data'
      '            THEN NULL'
      
        '            ELSE CASE WHEN (pi.ValorPagto - (SELECT ValorDevido(' +
        'pi.Contrato, pi.Tipo,'
      
        '                                                                ' +
        'pi.Numero,   pi.NrPagto,'
      
        '                                                                ' +
        'pi.DataPagto))) = 0'
      '                      THEN NULL'
      
        '                      ELSE (pi.ValorPagto - (SELECT ValorDevido(' +
        'pi.Contrato, pi.Tipo,'
      
        '                                                                ' +
        'pi.Numero,   pi.NrPagto,'
      
        '                                                                ' +
        'pi.DataPagto)))'
      '                 END'
      '       END AS Diferenca,'
      '       pi.Promissoria,'
      '       pi.Documento,'
      '       pi.NrPagto,'
      '       pi.observacoes'
      '       '
      'FROM ParcelasImoveis pi '
      '     JOIN VendasImoveis vi'
      '     ON   vi.Contrato = pi.Contrato'
      '     '
      'WHERE  CASE WHEN pi.NrPagto > 1 AND ((SELECT pi2.DataPagto'
      '                                       FROM parcelasimoveis pi2'
      
        '                                       WHERE pi2.Contrato = pi.C' +
        'ontrato AND pi2.Tipo    = pi.Tipo AND'
      
        '                                             pi2.Numero   = pi.N' +
        'umero   AND pi2.NrPagto = pi.NrPagto-1)IS NULL OR'
      '                                    (SELECT pi2.DataPagto'
      '                                       FROM parcelasimoveis pi2'
      
        '                                       WHERE pi2.Contrato = pi.C' +
        'ontrato AND pi2.Tipo    = pi.Tipo AND'
      
        '                                             pi2.Numero   = pi.N' +
        'umero   AND pi2.NrPagto = pi.NrPagto-1) > :Data) AND'
      '                                    (SELECT pi2.DataPagto'
      '                                       FROM parcelasimoveis pi2'
      
        '                                       WHERE pi2.Contrato = pi.C' +
        'ontrato AND pi2.Tipo    = pi.Tipo AND'
      
        '                                             pi2.Numero   = pi.N' +
        'umero   AND pi2.NrPagto = pi.NrPagto-1) <> :Data'
      '            THEN FALSE'
      '            ELSE TRUE'
      '       END'
      ') AS Temp'
      'WHERE Contrato = :Contrato'
      'ORDER BY Tipo, Numero, NrPagto'
      '')
