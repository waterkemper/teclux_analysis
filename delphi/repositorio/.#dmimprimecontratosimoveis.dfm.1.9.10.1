    Sql.Strings = (
      'Select iv.Ordem,'
      '       iv.contrato,'
      '       e.codigo as CodigoEmpreendimento,'
      '       e.nome as empreendimento,'
      '       e.datahabitese,'
      '       e.sigla,'
      '       iv.bloco,'
      '       b.descricao as nomebloco,'
      '       iv.numero,'
      '       tu.codigo as Unidade,'
      '       tu.nome as TipoUnidade,'
      '       i.pavimento,'
      '       i.situacao,'
      '       i.areaprivativa,'
      '       i.areacomum,'
      '       cast(null as numeric) as AreaTotal,'
      '       i.fracaoideal,'
      '       iv.precovenda as precovendido,'
      '       iv.observacoes'
      ''
      'from imoveisvendidos iv'
      '     left join (imoveis i'
      '                join tiposunidades tu'
