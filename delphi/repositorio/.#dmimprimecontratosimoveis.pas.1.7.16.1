procedure TdtmImprimeContratosImoveis.ImprimirExtratos(Contrato, Data: String; TipoExtrato: TTecTipoExtratoContratoImoveis);
Var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
  RefazConsultaPorNome(qryContratos,['Contrato'],[Contrato]);
  if not (strtodate(Data) < qryContratosdata.AsDateTime) then
  begin
    if (qryContratosdataalteracao.AsDateTime > 0) and (strtodate(Data) > qryContratosdataalteracao.AsDateTime) then
    begin
      MensagemAviso('A data do extrato é posterior à de alteração do contrato');
    end
    else
    begin
      RefazConsultaPorNome(qryParcelasContrato,['Contrato','Data'],[Contrato,formatdatetime('yyyy-mm-dd',strtodate(Data))]);
      RefazConsultaPorNome(qryCompradores,['Contrato'],[Contrato]);
      RefazConsultaPorNome(qryImoveisVendidos,['Contrato'],[Contrato]);
      RefazConsultaPorNome(qryParcelasAberto,['Contrato','Data'],[Contrato,FormatDateTime('YYYY-MM-DD',strtodate(Data))]);
      RefazConsultaPorNome(qryTotaisContrato,['Contrato'],[Contrato]);

      AtribuirParametrosBaseRelatorio;
      SaldoDevedor(Data);
      frVariables['Outras']:= 'EXTRATO COM A SITUAÇÃO EM '+FormatDateTime('DD/MM/YYYY',STRTODATE(DATA));
      frVariables['Titulo']:= 'CONTRATO Nº '+qryContratoscontrato.AsString;
      frVariables['SaldoDevedor']:= FormatFloat('###,###,###,##0.00',FSaldoDevedor);
      frVariables['SaldoAtraso']:= FormatFloat('###,###,###,##0.00',FTotalAbertoAtraso);
      frVariables['SaldoVencer']:= FormatFloat('###,###,###,##0.00',FtotalAbertoVencer);

      frVariables['Historico']:= FormatFloat('###,###,###,##0.00',FTotalHistorico);
      frVariables['Contratado']:= FormatFloat('###,###,###,##0.00',FTotalContratado);
      frVariables['Devido']:= FormatFloat('###,###,###,##0.00',FTotalDevido);
      frVariables['Juros']:= FormatFloat('###,###,###,##0.00',FTotalJuros);
      frVariables['Correcao']:= FormatFloat('###,###,###,##0.00',FTotalCorrecao);
      frVariables['Diferenca']:= FormatFloat('###,###,###,##0.00',FTotalDiferenca);
      frVariables['ValorPago']:= FormatFloat('###,###,###,##0.00',FTotalPago);

      frVariables['TotalHistorico'] := FormatFloat('###,###,###,##0.00',FValorTotalHistorico);
      frVariables['TotalContratado']:= FormatFloat('###,###,###,##0.00',FValorTotalContratado);

      frVariables['DevidoAberto']:= FormatFloat('###,###,###,##0.00',FTotalDevidoAberto);
      frVariables['HistoricoAberto']:= FormatFloat('###,###,###,##0.00',FTotalHistoricoAberto);
      frVariables['ContratadoAberto']:= FormatFloat('###,###,###,##0.00',FTotalContratadoAberto);
      frVariables['JurosAberto']:= FormatFloat('###,###,###,##0.00',FTotalJurosAberto);
      frVariables['CorrecaoAberto']:= FormatFloat('###,###,###,##0.00',FTotalCorrecaoAberto);
      frVariables['FDATA']:=  strtodate(Data);
      if ((qryContratossituacao.AsString[1] in ['T','G','S'])and
         (strtodate(Data) >= qryContratosdataalteracao.AsDateTime)) then
        frVariables['Situacao']:=  qryContratosnomesituacao.AsString
      else
        frVariables['Situacao']:=  '';
//      frpExtratoSimplificado.DesignReport;
      frmPreview := TfrmPreviewPadrao.create(self);
      frmPreview.cmbZoom.ItemIndex := 4;
      try
        Relatorio := frmPreview.frCompositeReport;
        frmPreview.frCompositeReport.Reports.Clear;
        frmPreview.frCompositeReport.DoublePass:= True;
        frmPreview.frCompositeReport.DoublePass:= True;
//        frpExtratoParaCliente.DesignReport;

        case TipoExtrato of
          ParaCliente  : frmPreview.frCompositeReport.Reports.Add(frpExtratoParaCliente);
          Completo     : frmPreview.frCompositeReport.Reports.Add(frpExtratoCompleto);
          Simplificado : frmPreview.frCompositeReport.Reports.Add(frpExtratoSimplificado);
        end;

        Relatorio.Preview := frmPreview.frPreviewPadrao;
        Relatorio.ShowReport;
        frmPreview.ShowModal;
      finally
        frmPreview.Free;
      end;
    end
  end
  else
    MensagemAviso('A data do extrato é anterior à data de venda');
end;

