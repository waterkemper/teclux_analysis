procedure TdtmImprimeContratosImoveis.SaldoDevedor(DataSituacao: String);
var TotalPago, TotalDevido : Currency;
begin
  FSaldoDevedor         := 0;

  FTotalHistorico       := 0;
  FTotalContratado      := 0;
  FTotalDevido          := 0;
  FTotalPago            := 0;
  FTotalCorrecao        := 0;
  FTotalJuros           := 0;
  FTotalDiferenca       := 0;

  FValorTotalHistorico  := 0;
  FValorTotalContratado := 0;

  FTotalHistoricoAberto := 0;
  FTotalContratadoAberto:= 0;
  FTotalDevidoAberto    := 0;
  FTotalAbertoAtraso     := 0;
  FtotalAbertoVencer     := 0;

  FTotalCorrecaoAberto  := 0;
  FTotalJurosAberto     := 0;
  GuardarRegistroAtual(qryParcelasContrato, True);
  qryParcelasContrato.First;
  while not qryParcelasContrato.Eof do
  begin
    if qryParcelasContratodatapagto.IsNull then
    begin
      FTotalHistoricoAberto  := FTotalHistoricoAberto   + qryParcelasContratovalorhistorico.AsCurrency;
      FTotalContratadoAberto := FTotalContratadoAberto  + qryParcelasContratovalorcontratado.AsCurrency;
      FTotalDevidoAberto     := FTotalDevidoAberto      + qryParcelasContratovalordevido.AsCurrency;
      FTotalCorrecaoAberto   := FTotalCorrecaoAberto    + qryParcelasContratocorrecao2.AsCurrency;
      FTotalJurosAberto      := FTotalJurosAberto       + qryParcelasContratojuros2.AsCurrency;
      if qryParcelasContratodatavencto.AsDateTime < StrToDateTime(DataSituacao) then
        FTotalAbertoAtraso := FTotalAbertoAtraso +  qryParcelasContratovalordevido.AsCurrency
      else                                                                                   
        FTotalAbertoVencer := FTotalAbertoVencer +  qryParcelasContratovalordevido.AsCurrency;
    end
    else
    begin
      FTotalPago       := FTotalPago        + qryParcelasContratovalorpagto.AsCurrency;
      FTotalDevido     := FTotalDevido      + qryParcelasContratovalordevido.AsCurrency;
      FTotalHistorico  := FTotalHistorico   + qryParcelasContratovalorhistorico.AsCurrency;
      FTotalContratado := FTotalContratado  + qryParcelasContratovalorcontratado.AsCurrency;
      FTotalJuros      := FTotalJuros       + qryParcelasContratojuros2.AsCurrency;
      FTotalCorrecao   := FTotalCorrecao    + qryParcelasContratocorrecao2.AsCurrency;
      FTotalDiferenca  := FTotalDiferenca   + qryParcelasContratodiferenca.AsCurrency;
    end;
    FValorTotalHistorico := FValorTotalHistorico  + qryParcelasContratovalorhistorico.AsCurrency;
    FValorTotalContratado:= FValorTotalContratado + qryParcelasContratovalorcontratado.AsCurrency;;

    qryParcelasContrato.Next;
  end;
  VoltarRegistroAtual(qryParcelasContrato);
  FSaldoDevedor := FTotalDevidoAberto;
end;

procedure TdtmImprimeContratosImoveis.ImprimirContrato(Contrato: String);
Var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
   RefazConsultaPorNome(qryContratos,['Contrato'],[Contrato]);
   RefazConsultaPorNome(qryParcelasContrato,['Contrato','Data'],[Contrato,FormatDateTime('YYYY-MM-DD',DataLocal)]);
   RefazConsultaPorNome(qryParcelasAberto,['Contrato','Data'],[Contrato,FormatDateTime('YYYY-MM-DD',DataLocal)]);
   RefazConsultaPorNome(qryTotaisContrato,['Contrato'],[Contrato]);
   RefazConsultaPorNome(qryCompradores,['Contrato'],[Contrato]);
   RefazConsultaPorNome(qryImoveisVendidos,['Contrato'],[Contrato]);

   AtribuirParametrosBaseRelatorio;
   frVariables['Outras']:= 'EXTRATO EM '+FormatDateTime('DD/MM/YYYY',DataLocal);
   frVariables['Titulo']:= 'CONTRATO Nº '+qryContratoscontrato.AsString;
   frmPreview := TfrmPreviewPadrao.create(self);
   frmPreview.cmbZoom.ItemIndex := 4;
   try
     Relatorio := frmPreview.frCompositeReport;
     frmPreview.frCompositeReport.Reports.Clear;
     frmPreview.frCompositeReport.DoublePass:= True;
     frmPreview.frCompositeReport.Reports.Add(frpContratoCompleto);
     Relatorio.Preview := frmPreview.frPreviewPadrao;
     Relatorio.ShowReport;
     frmPreview.ShowModal;
   finally
     frmPreview.Free;
   end;
end;

procedure TdtmImprimeContratosImoveis.ImprimirRecibo(Contrato: String; Recibo: Integer);
var
  ValorExtenso: String;
  LinhaE: T_Extenso;
  ValorParcelas: Currency;
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
  Referencia: string;
  AouO: char;
  NR, Inicio, Tamanho: integer;

begin
  qryRecibos.MacroByName('TipoPagto').AsString:= '';
  RefazConsultaPorNome(qryRecibos,['Contrato', 'Recibo'],[Contrato,Recibo]);
  RefazConsultaPorNome(qryParcelasContrato,['Contrato'],[Contrato]);
  RefazConsultaPorNome(qryCompradores,['Contrato'],[Contrato]);
  RefazConsultaPorNome(qryImoveisVendidos,['Contrato'],[Contrato]);
  AtribuirParametrosBaseRelatorio;
  frVariables['COMPRADOR']:= PreencheString(qryCompradoresnomecliente.AsString,'*',40);
  frVariables['CPFCNPJCOMPRADOR']  :=qryCompradoresnumerocliente.AsString;
  ValorParcelas:= GetValorParcelas;
  LinhaE.ExtTamLinha[1]:= 65;
  LinhaE.ExtTamLinha[2]:= 78;
  LinhaE.ExtTamLinha[3]:= 78;
  Extenso(ValorParcelas,$92,'','','','','*', LinhaE);
  frVariables['ValorExtenso1']:= trim(LinhaE.ExtLinha[1]);
  frVariables['ValorExtenso2']:= trim(LinhaE.ExtLinha[2]);
  frVariables['ValorExtenso3']:= trim(LinhaE.ExtLinha[3]);
  frVariables['ValorParcelas']:= FormatFloat('###,###,###,##0.00',ValorParcelas);
  FiltrarTipoParcelas(Contrato, Recibo);
  qryRecibos.MacroByName('TipoPagto').AsString:= '';
  RefazConsultaPorNome(qryRecibos,['Contrato', 'Recibo'],[Contrato,Recibo]);


  if qryRecibos.RecordCount > 1
  then Referencia:= Referencia + ' DAS PARCELAS '
  else Referencia:= Referencia + ' DA PARCELA ';

  if FSaldo <> '' then begin
     frVariables['Referente_0']:= 'referente à'; AouO:= 'A';
     Referencia:= 'QUITAÇÃO DO SALDO' + Referencia + FSaldo;
  end
  else if FParcial <> '' then begin
          frVariables['Referente_0']:= 'referente ao';  AouO:= 'O';
          Referencia:= 'PAGAMENTO PARCIAL' + Referencia + FParcial;
       end
       else {if FQuitacao <> '' then} begin
               frVariables['Referente_0']:= 'referente à'; AouO:= 'A';
               Referencia:= 'QUITAÇÃO' + Referencia + FQuitacao;
            end;

  if qryRecibosCheque.AsString <> '' then begin
     Referencia:= Referencia + ', EFETUAD' + AouO +
                  ' ATRAVÉS DO CHEQUE Nº ' + FormatFloat('###,###',qryRecibosCheque.AsFloat) +
                 ' DO BANCO ' + FormatFloat('000', qryRecibosbancocheque.AsFloat) +
                             ' - ' + qryRecibosNomeBanco.AsString;
     if qryRecibosAgencia.AsFloat <> 0
     then Referencia:= Referencia + ', AGÊNCIA '+ FormatFloat('0000', qryRecibosAgencia.AsFloat);

     if (qryRecibosEmitente.AsString <> '') and
        (qryRecibosEmitente.AsString <> qryCompradoresNomeCliente.AsString)
     then Referencia:= Referencia + ', CUJO TITULAR É ' + qryRecibosEmitente.AsString;
  end;

  Referencia:= Referencia + ' - ' + qryImoveisVendidosEmpreendimento.AsString;
  qryImoveisVendidos.First;
  while not qryImoveisVendidos.Eof do begin
     Referencia:= Referencia + ', BLOCO ' + qryImoveisVendidosnomeBloco.  AsString +
                                    ' - ' + qryImoveisVendidosTipoUnidade.AsString +
                                   ' Nº ' + qryImoveisVendidosNumero.     AsString;
     qryImoveisVendidos.Next;
  end;
  Referencia:= Referencia + '.';

  Inicio:=  1;
  for NR:= 1 to 7 do begin
      if NR in [1, 2] then Tamanho:= 68
                      else Tamanho:= 78;
      while (Inicio+Tamanho < length(Referencia)) and
            (copy(Referencia,Inicio+Tamanho,1) <> ' ') do dec(Tamanho);
      frVariables['Referente_' + FStr(NR,$11)]:= Copy(Referencia,Inicio,Tamanho);
      inc(Inicio,Tamanho);
      while copy(Referencia,inicio,1) = ' ' do delete(Referencia,Inicio,1);
  end;

  frVariables['Recibo']:= FormatFloat('###,###',qryRecibosrecibopagto.AsFloat);
  frVariables['DIA']:= DayOf(qryRecibosdatapagto.AsDateTime);
  frVariables['MES']:= LowerCase(MesExtenso(MonthOf(qryRecibosdatapagto.AsDateTime)));
  frVariables['ANO']:= YearOf(qryRecibosdatapagto.AsDateTime);
  frVariables['CONTRATO']:= qryReciboscontrato.AsString;
  if qryCompradorestipocliente.AsString = 'F' then
    frVariables['TIPO']:= True
  else
    frVariables['TIPO']:= False;
//  frpRecibos.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);
   frmPreview.cmbZoom.ItemIndex := 4;
   try
     Relatorio := frmPreview.frCompositeReport;
     frmPreview.frCompositeReport.Reports.Clear;
     frmPreview.frCompositeReport.DoublePass:= True;
     frmPreview.frCompositeReport.Reports.Add(frpRecibos);
     Relatorio.Preview := frmPreview.frPreviewPadrao;
     Relatorio.ShowReport;
     frmPreview.ShowModal;
   finally
     frmPreview.Free;
   end;
end;

function TdtmImprimeContratosImoveis.DescricaoParcelasPagas: String;
var Tipo, Parcela, Saida: String;
    Numero, a, i, g, Total: Integer;
    ArquivoParcelas: T_ParcelasPagas;
    SequenciaParcelas: T_SeqParcelas;
begin
  if qryRecibos.RecordCount > 1 then
  begin
    a:= 0;
    i:= -1;
    Numero := 0;
    tipo:= '';
    Saida:= '';
    GuardarRegistroAtual(qryRecibos, True);
    qryRecibos.First;
    SetLength(ArquivoParcelas, qryRecibos.RecordCount);
    while not qryRecibos.Eof do
    begin
      ArquivoParcelas[a].Tipo     := qryRecibos.FieldByName('tipo').AsString;
      ArquivoParcelas[a].Numero   := qryRecibos.FieldByName('numero').AsInteger;
      ArquivoParcelas[a].Origem   := qryRecibos.FieldByName('origem').AsString;
      ArquivoParcelas[a].Resultado:= qryRecibos.FieldByName('tipo').AsString + '-'+
                                     qryRecibos.FieldByName('origem').AsString;
      inc(a);

      qryRecibos.Next;
    end;
    VoltarRegistroAtual(qryRecibos);
    Total:= a;
    SetLength(SequenciaParcelas,Total+1);
    for a:=0 to Total-1 do
    begin
      if Tipo <> ArquivoParcelas[a].Tipo then
      begin
        inc(i);
        Tipo:= ArquivoParcelas[a].Tipo;
        SequenciaParcelas[i].Tipo:= ArquivoParcelas[a].Tipo;
        SequenciaParcelas[i].NI  := ArquivoParcelas[a].Numero;
        SequenciaParcelas[i].OrI := ArquivoParcelas[a].Resultado;
        SequenciaParcelas[i].NF  := ArquivoParcelas[a].Numero;
        SequenciaParcelas[i].OrF := ArquivoParcelas[a].Resultado;
      end
      else
      begin
        if (ArquivoParcelas[a].Numero - SequenciaParcelas[i].NF) = 1 then
        begin
          SequenciaParcelas[i].NF  := ArquivoParcelas[a].Numero;
          SequenciaParcelas[i].OrF := ArquivoParcelas[a].Resultado;
          SequenciaParcelas[i].Seq := True;
        end
        else
        begin
          Inc(i);
          SequenciaParcelas[i].Tipo:= ArquivoParcelas[a].Tipo;
          SequenciaParcelas[i].NI  := ArquivoParcelas[a].Numero;
          SequenciaParcelas[i].OrI := ArquivoParcelas[a].Resultado;
          SequenciaParcelas[i].NF  := ArquivoParcelas[a].Numero;
          SequenciaParcelas[i].OrF := ArquivoParcelas[a].Resultado;
        end;
      end;
    end;
    for a:=0 to i do
    begin
      if SequenciaParcelas[a].Seq = True then
        if i-1 = a then
          Saida:= Saida + SequenciaParcelas[a].Tipo+'-'+preencheString(inttostr(SequenciaParcelas[a].NI),'0',3,False)+' A '+SequenciaParcelas[a].OrF+' E '
        else
          Saida:= Saida + SequenciaParcelas[a].Tipo+'-'+preencheString(inttostr(SequenciaParcelas[a].NI),'0',3,False)+' A '+SequenciaParcelas[a].OrF+', '
      else
        if i-1 = a then
          Saida:= Saida + SequenciaParcelas[a].OrI+ ' E '
        else
          Saida:= Saida + SequenciaParcelas[a].OrI+ ', ';
    end;
    Delete(Saida,length(Saida)-1,1);
    Result:= Saida+' do contrato nº '+qryRecibos.FieldByName('contrato').AsString;
  end
  else if qryRecibos.RecordCount = 1 then
  Begin
    Result:= qryRecibos.FieldByName('tipo').AsString+'-'+qryRecibos.fieldByName('origem').AsString +
             ' DO CONTRATO Nº '+qryRecibos.FieldByName('contrato').AsString;
  end
  else
    Result:= '';
end;


function TdtmImprimeContratosImoveis.GetValorParcelas: Currency;
begin
  Result:= 0;
  if qryRecibos.RecordCount > 1 then
  begin
    GuardarRegistroAtual(qryRecibos, true);
    qryRecibos.First;
    while not qryRecibos.Eof do
    begin
      Result:= Result + qryRecibosvalorpagto.AsCurrency;
      qryRecibos.Next;
    end;
    VoltarRegistroAtual(qryRecibos);
  end
  else
    Result:= qryRecibosvalorpagto.AsCurrency;
end;

function TdtmImprimeContratosImoveis.FiltrarTipoParcelas(Contrato: String; Recibo: Integer): Boolean;
begin
  FQuitacao:= FiltroDescricaoParcelas(Contrato, Recibo, 'Q');
  FSaldo   := FiltroDescricaoParcelas(Contrato, Recibo, 'S');
  FParcial := FiltroDescricaoParcelas(Contrato, Recibo, 'P');
end;

function TdtmImprimeContratosImoveis.FiltroDescricaoParcelas(Contrato: String; Recibo: Integer; Tipo: Char): String;
begin
  qryRecibos.Close;
  qryRecibos.MacroByName('TipoPagto').AsString:= 'AND pi.tipopagto = '+QuotedStr(Tipo);
  RefazConsultaPorNome(qryRecibos,['Contrato','Recibo'],[Contrato, Recibo]);
  Result:= DescricaoParcelasPagas;
end;

