  object qryEstoqueBloqueio: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select e.produto,'
      '         e.filial,'
      '         (select m.emestoque '
      '          from movimentos m '
      '          where m.numero = (select Max(m1.numero)'
      '                                       from movimentos m1'
      
        '                                       where (m1.produto = e.Pro' +
        'duto) and'
      
        '                                                (m1.filial  = e.' +
        'Filial))'
      '         ) as emestoque,'
      '         (select m.reservado'
      '          from movimentos m '
      '          where m.numero = (select Max(m1.numero)'
      '                                       from movimentos m1'
      
        '                                       where (m1.produto = e.Pro' +
        'duto) and'
      
        '                                                (m1.filial  = e.' +
        'Filial))'
      '         ) as reservado,'
      '         (select m.futuro'
      '          from movimentos m '
      '          where m.numero = (select Max(m1.numero)'
      '                                       from movimentos m1'
      
        '                                       where (m1.produto = e.Pro' +
        'duto) and'
      
        '                                                (m1.filial  = e.' +
        'Filial))'
      '         ) as futuro,'
      
        '         (select case when (m.financeirosemicms = 0) or (m.finan' +
        'ceirosemicms is null)'
      '                             then 0'
      '                     else'
      
        '                        m.financeirosemicms/(m.emestoque+m.reser' +
        'vado+m.transito+m.demonstracao+m.conserto+m.danificada)'
      '                     end '
      '          from movimentos m '
      '          where m.numero = (select Max(m1.numero)'
      '                                       from movimentos m1'
      
        '                                       where (m1.produto = e.Pro' +
        'duto) and'
      
        '                                                (m1.filial  = e.' +
        'Filial))'
      '         ) as customedio'
      'from estoques e'
      'where '
      '/*Preenchido em runtime. n'#227'o apague*/ False'
      'for update')
    RequestLive = False
    Left = 393
    Top = 17
    object qryEstoqueBloqueioproduto: TLargeintField
      FieldName = 'produto'
      DisplayFormat = '0'
    end
    object qryEstoqueBloqueiofilial: TIntegerField
      FieldName = 'filial'
      DisplayFormat = '0'
    end
    object qryEstoqueBloqueioemestoque: TFloatField
      FieldName = 'emestoque'
      DisplayFormat = '0'
    end
    object qryEstoqueBloqueioreservado: TFloatField
      FieldName = 'reservado'
      DisplayFormat = '0'
    end
    object qryEstoqueBloqueiofuturo: TFloatField
      FieldName = 'futuro'
      DisplayFormat = '0'
    end
    object qryEstoqueBloqueiocustomedio: TFloatField
      FieldName = 'customedio'
    end
  end
