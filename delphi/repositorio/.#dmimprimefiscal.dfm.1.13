  object qryServicosDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select sd.servico,'
      '       (select s.descricao'
      '        from servicos s'
      '        where s.codigo = sd.servico) as descricao,'
      
        '       (select cast(substr(cast(ae.codigoatividade as varchar),1' +
        ',4) || '#39'-'#39' || substr(cast(ae.codigoatividade as varchar),5,1)  |' +
        '| '#39'/'#39' || substr(cast(ae.codigoatividade as varchar),6,2)  as var' +
        'char)'
      '        from atividadeseconomicas ae'
      '        where ae.codigo = (select s.cnae'
      '                           from servicos s'
      '                           where s.codigo = sd.servico)'
      '       ) as atividade,'
      '       sd.quantidade,'
      '       sd.aliquotaissqn,'
      '       sd.valorservico,'
      '       sd.valorissqn,'
      '       (sd.quantidade * sd.valorservico) as valortotal,'
      
        '       (select c.nome from cidades c where c.estado = sd.estado ' +
        'and c.codigo = sd.cidade) as nomecidade'
      'from servicosdadosfiscais sd'
      'where sd.dadofiscal = :dadofiscal')
    RequestLive = False
    Left = 171
    Top = 235
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'dadofiscal'
        ParamType = ptUnknown
      end>
