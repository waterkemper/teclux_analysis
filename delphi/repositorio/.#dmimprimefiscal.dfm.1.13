  object qryVenctoAgrupados: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select count(*) as quantidade,'
      
        '       (Select ((select c.nome from cidades c where (c.estado = ' +
        '(Select cl.pracapagtoestado from clientes cl where cl.codigo = d' +
        'f.cliente)) and'
      
        '                                         (c.codigo = (Select cl.' +
        'pracapagtocidade from clientes cl where cl.codigo = df.cliente))' +
        ')||'#39' - '#39'||'
      
        '       (Select cl.pracapagtoestado from clientes cl where cl.cod' +
        'igo = df.cliente)) from dadosfiscais df where df.numero = :dadof' +
        'iscal)as pracapagto,'
      '       vdf.valorvencto,'
      '       Min(datavencto) as data'
      
        'from venctosdadosfiscais vdf join dadosfiscais df on (vdf.dadofi' +
        'scal = df.numero)'
