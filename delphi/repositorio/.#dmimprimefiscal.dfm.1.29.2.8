  object qryProdutos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'SELECT t.*,'
      
        ' cast(case when produto_cliente is null then cast(t.produto as v' +
        'archar)'
      ' else produto_cliente||'#39'-'#39'||cast(t.produto as varchar)'
      ' end as varchar) as produtocliente'
      'FROM'
      '('
      'SELECT pf.dadofiscal,'
      ' pf.numero,'
      ' pf.quantidade,'
      ' pf.aliquotaicms,'
      ' pf.produto,'
      ' pf.filial,'
      ' pf.precovenda,'
      ' trunc(pf.precovenda * pf.quantidade, 2) as precototal,'
      ' pf.composto,'
      ' pf.discriminarcomposto,'
      ' pf.discriminarpreco,'
      ' pf.ipi,'
      ' pf.classificacaofiscal,'
      ' pf.sequenciaipi,'
      ' pf.aliquotaipi,'
      ' pf.valoripi,'
      ' pf.osp,'
      ' pf.frete,'
      ' pf.seguro,'
      ' pf.desconto,'
      ' pf.fatorsubstituicao,'
      ' pf.valordescontoitem,'
      ' pf.codigofiscal,'
      
        ' (SELECT osp.pedidocliente FROM osp WHERE osp.numero = pf.osp) a' +
        's pedidocliente,'
      
        ' cast(p.descricao||'#39' '#39'||coalesce(p.valorgrade1,'#39#39')||'#39' '#39'||coalesc' +
        'e(p.valorgrade2,'#39#39') as varchar) AS produtodescricao,'
      ' pf.descricaoproduto,'
      ' p.referencia,'
      ' p.codigovisual,'
      ' c.unidade,'
      ' e.localizacao,'
      
        ' (select o.descricao from obslegais o where c.obslegal = o.codig' +
        'o) as obslegal,'
      ' pf.origem,'
      ' pf.incidencia,'
      ' m.descricao AS marcadescricao,'
      ' (select cp.produto_cliente'
      ' from clientesprodutos cp'
      ' where cp.cliente = :cliente'
      ' and cp.tipocliente = :tipocliente'
      ' and cp.produto = pf.produto) as produto_cliente,'
      ' c.producaopropria'
      'FROM  ((produtosdadosfiscais pf'
      '                   JOIN (produtos p'
      '                         JOIN (caracteristicas c'
      '                               JOIN marcas m'
      '                               ON c.marca = m.codigo)'
      '                         ON  p.caracteristica = c.codigo)'
      '                   ON pf.produto = p.codigo )'
      '                   JOIN estoques e'
      
        '                   ON pf.produto = e.produto and pf.filial = e.f' +
        'ilial)'
      'WHERE pf.dadofiscal = :dadofiscal'
      'ORDER BY pf.numero'
      ') AS t'
      '')
    RequestLive = True
    Left = 170
    Top = 17
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipocliente'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dadofiscal'
        ParamType = ptUnknown
      end>
