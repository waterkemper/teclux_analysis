  object qryDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryDadosFiscaisCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT df.numero,'
      '       df.data,'
      
        '       cast(to_char(df.data,'#39'DD/MM/YY'#39') as varchar) as dataemiss' +
        'ao,'
      '       df.situacao,'
      '       df.filialvenda,'
      '       df.contrato,'
      '       df.valortotal,'
      
        '       (df.valorvista + (df.valortotal - coalesce(df.valorvista,' +
        '0))'
      
        '                      - coalesce(df.totalvaloricmssubstituicao,0' +
        ')'
      
        '                      - coalesce(df.valoripi,0) - coalesce(df.va' +
        'lorfrete,0) - coalesce(df.despesasacessorias,0) - coalesce(vicms' +
        'stretdesp,0)'
      
        '                      - coalesce(df.seguro,0) - coalesce((select' +
        ' sum(sd.quantidade * sd.valorservico)'
      
        '                                                          from s' +
        'ervicosdadosfiscais sd'
      
        '                                                          where ' +
        'sd.dadofiscal = df.numero),0)) as valorvista,'
      ''
      
        '       (df.desconto + (select coalesce(sum(pdf.valordescontoitem' +
        '),0) from produtosdadosfiscais pdf where pdf.dadofiscal = df.num' +
        'ero)) as desconto,'
      '       (df.valortotal - coalesce(df.valorvista,0)) AS acrescimo,'
      '       df.valorfrete,'
      ''
      '       df.valorservicos,'
      '       '
      '       df.seguro,'
      
        '       case when fl.contribipi then df.valoripi else 0.00 end as' +
        ' valoripi,'
      '       case when not fl.contribipi then'
      
        '         coalesce(df.valoripi,0)+coalesce(df.despesasacessorias,' +
        '0)+coalesce(vicmsstretdesp,0)'
      '       else'
      
        '         coalesce(df.despesasacessorias,0)+coalesce(vicmsstretde' +
        'sp,0)'
      '       end as despesasacessorias,'
      '       df.codigofiscal,'
      '       cast(null as varchar) as cfopnota,'
      '       df.codigofiscalservico,'
      '       df.vendedor,'
      '       df.agente,'
      '       df.estadocfo,'
      '       df.filialemissao,'
      '       cast(df.natureza as varchar(80)) as natureza,'
      '       df.descricaosemprodutos,'
      '       df.datasaida,'
      
        '       cast(to_char(df.datasaida,'#39'DD/MM/YY'#39') as varchar) as data' +
        'saida2,'
      '       df.fornecedortransporte,'
      '       vdf.pesobruto,'
      '       vdf.pesoliquido,'
      '       vdf.volumes,'
      '       vdf.numeracao,'
      '       vdf.marca,'
      '       vdf.especietransporte,'
      '       df.frete,'
      ''
      '       cast('
      
        '       (case when (df.cliente is null) or (df.tipocliente = '#39'L'#39')' +
        ' then df.nome'
      '               else (select coalesce(vf.razao,vf.nome) as nome'
      '                     from vfornecedores vf'
      '                     where  (vf.codigo = df.cliente) and'
      '                            (vf.tipo = df.tipocliente))'
      '       end) as varchar(60)) as nome,'
      '       df.cliente,'
      '       df.tipocliente,'
      '       df.estadoplaca,'
      '       df.placa,'
      ''
      
        '       case when df.endnumero is not null and df.endcomplemento ' +
        'is not null then'
      
        '              cast(retirabrancoepipeeascii255(df.rua)||'#39', '#39'||cas' +
        't(df.endnumero as varchar) || '#39' - '#39' || retirabrancoepipeeascii25' +
        '5(coalesce(df.endcomplemento,'#39#39')) as varchar(200))'
      
        '            when df.endnumero is not null and df.endcomplemento ' +
        'is null then'
      
        '              cast(retirabrancoepipeeascii255(df.rua)||'#39', '#39'||cas' +
        't(df.endnumero as varchar) as varchar(200))'
      
        '            when df.endnumero is null and df.endcomplemento is n' +
        'ot null then'
      
        '              cast(retirabrancoepipeeascii255(df.rua)|| '#39' - '#39' ||' +
        ' retirabrancoepipeeascii255(coalesce(df.endcomplemento,'#39#39')) as v' +
        'archar(200))'
      '            else'
      
        '              cast(retirabrancoepipeeascii255(df.rua) as varchar' +
        '(200))'
      '       end as rua,'
      ''
      '       df.estado,'
      
        '       cast(substr(cast(df.cep as varchar),1,5) || '#39'-'#39' || substr' +
        '(cast(df.cep as varchar),6,3) as varchar) as cep ,'
      
        '       cast(case when (df.pessoatipo = '#39'F'#39') then substr(df.pesso' +
        'anumero,1,3) || '#39'.'#39' || substr(df.pessoanumero,4,3) || '#39'.'#39' ||'
      
        '                                                                ' +
        '         substr(df.pessoanumero,7,3) || '#39'-'#39' || substr(df.pessoan' +
        'umero,10,2)'
      
        '                        when (df.pessoatipo = '#39'J'#39') then substr(d' +
        'f.pessoanumero,1,2) || '#39'.'#39' || substr(df.pessoanumero,3,3) || '#39'.'#39 +
        ' ||'
      
        '                                                                ' +
        '          substr(df.pessoanumero,6,3) || '#39'/'#39' || substr(df.pessoa' +
        'numero,9,4) || '#39'-'#39' || substr(df.pessoanumero,13,2)'
      '                        else  df.pessoanumero'
      '               end as varchar) as pessoanumero,'
      ''
      '       df.inscricaomunicipal,'
      ''
      
        '       cast((case when length(cast(df.fonenumero as varchar)) = ' +
        '7 then '
      
        '                       substr(cast(df.fonenumero as varchar),1,3' +
        ') || '#39'-'#39' || substr(cast(df.fonenumero as varchar),4,4)'
      
        '                 when length(cast(df.fonenumero as varchar)) = 8' +
        ' then '
      
        '                       substr(cast(df.fonenumero as varchar),1,4' +
        ') || '#39'-'#39' || substr(cast(df.fonenumero as varchar),5,4)'
      '                 else   to_char(df.fonenumero,'#39#39')'
      '               end) as varchar) as fone_numero,'
      ''
      
        '       cast(case when (coalesce(df.foneddd,0) > 0) then '#39'('#39' || c' +
        'ast(df.foneddd as varchar) || '#39')'#39
      '                       else '#39'(  )'#39
      '               end as varchar) as foneddd,'
      
        '       formatar_fone_fax(fl.foneddd, fl.fonenumero,'#39#39') as dddnum' +
        'erofonefilial,'
      
        '       cast(case when length((select cast(fone2numero as varchar' +
        ') from clientes c where df.cliente = c.codigo)) = 7'
      
        '                 then '#39' / '#39'||substr(cast((select fone2numero fro' +
        'm clientes c where df.cliente = c.codigo) as varchar),1,3) || '#39'-' +
        #39' || substr(cast((select fone2numero from clientes c where df.cl' +
        'iente = c.codigo) as varchar),4,4)'
      
        '                 when length((select cast(fone2numero as varchar' +
        ') from clientes c where df.cliente = c.codigo)) = 8'
      
        '                 then '#39' / '#39'||substr(cast((select fone2numero fro' +
        'm clientes c where df.cliente = c.codigo) as varchar),1,4) || '#39'-' +
        #39' || substr(cast((select fone2numero from clientes c where df.cl' +
        'iente = c.codigo) as varchar),5,4)'
      
        '                 else   to_char((select fone2numero from cliente' +
        's c where df.cliente = c.codigo),'#39#39')'
      '                 end as varchar) as fonecelular,'
      '       (select d.nome from cidades d where (d.estado ='
      
        '                                    (Select cl.pracapagtoestado ' +
        'from clientes cl where cl.codigo = df.cliente)) and'
      
        '                                    (d.codigo = (Select cl.praca' +
        'pagtocidade from clientes cl where cl.codigo = df.cliente))) || ' +
        #39' - '#39' ||'
      
        '       (Select cl.pracapagtoestado from clientes cl where cl.cod' +
        'igo = df.cliente) as pracapagto,'
      '       df.documento,'
      
        '       (select no.numero from notas no where no.dadofiscal = df.' +
        'numero) as numeronota,'
      
        '       case when (substring(cast(df.codigofiscal as varchar), 2,' +
        ' 3)  = '#39'929'#39') then 0'
      
        '               else   (select sum(cd.base) from calculosdadosfis' +
        'cais cd where cd.dadofiscal = df.numero and cd.tipo = '#39'M'#39')'
      '       end as baseicms,'
      
        '       case when (substring(cast(df.codigofiscal as varchar), 2,' +
        ' 3) = '#39'929'#39') then 0'
      
        '               else (select sum(cd.valor) from calculosdadosfisc' +
        'ais cd where cd.dadofiscal = df.numero and cd.tipo = '#39'M'#39')'
      '       end as valoricms,'
      
        '       case when (substring(cast(df.codigofiscal as varchar), 2,' +
        ' 3) = '#39'929'#39') then 0'
      
        '               else   (select sum(cd.base) from calculosdadosfis' +
        'cais cd where cd.dadofiscal = df.numero and cd.tipo = '#39'S'#39')'
      '       end as baseissqn,'
      ''
      '       /*'
      
        '       case when (substring(cast(df.codigofiscal as varchar), 2,' +
        ' 3) = '#39'929'#39') then 0'
      
        '               else (select sum(cd.valor) from calculosdadosfisc' +
        'ais cd where cd.dadofiscal = df.numero and cd.tipo = '#39'S'#39')'
      '       end as valorissqn,'
      '       */'
      '       df.valorissqn,'
      ''
      ''
      '       cast(c.nome as varchar(40)) AS cidadenome,'
      '       cast(b.nome as varchar(80)) AS bairronome,'
      '       u.nome AS nomevendedor,'
      '       f.razao AS razaofornecedor,'
      '       f.fonenumero AS fonefornecedor,'
      '       f.foneddd AS dddfornecedor,'
      '       f.inscricaoestadual AS inscricaoestadualfornecedor,'
      
        '       cast(case when (f.pessoatipo = '#39'F'#39') then substr(f.pessoan' +
        'umero,1,3) || '#39'.'#39' || substr(f.pessoanumero,4,3) || '#39'.'#39' ||'
      
        '                                                                ' +
        '       substr(f.pessoanumero,7,3) || '#39'-'#39' || substr(f.pessoanumer' +
        'o,10,2)'
      
        '                       when (f.pessoatipo = '#39'J'#39') then substr(f.p' +
        'essoanumero,1,2) || '#39'.'#39' || substr(f.pessoanumero,3,3) || '#39'.'#39' ||'
      
        '                                                                ' +
        '       substr(f.pessoanumero,6,3) || '#39'/'#39' || substr(f.pessoanumer' +
        'o,9,4) || '#39'-'#39' || substr(f.pessoanumero,13,2)'
      '                       else  f.pessoanumero'
      '               end as varchar) as numerofornecedor,'
      '       f.estado AS estadofornecedor,'
      
        '       (select ct.nome from cidades ct where (f.estado = ct.esta' +
        'do) and (f.cidade = ct.codigo)) as cidadefornecedor,'
      '       retirabrancoepipeeascii255(f.rua) as ruafornecedor,'
      '       n.descricao AS naturezadescricao,'
      
        '       cast(case when (substring(cast(df.codigofiscal as varchar' +
        '), 2, 3) = '#39'929'#39')'
      
        '               then :ctREFERENTECUPOMFISCAL || (select cast(nume' +
        'ro as varchar) from cupons where dadofiscal = df.numero)'
      '       else null'
      '       end as varchar) as cupomfiscal,'
      '       df.observacoes as observacoesaux,'
      '       (select c.nome'
      '        from clientes c'
      '        where c.codigo = (select c1.avalista'
      '                          from contratos c1'
      '                          where c1.numero = df.contrato'
      '                         )'
      '       ) as avalista,'
      '       current_date as datasistema,'
      '       fl.inscricaoestadual as inscricaoestadualfilial,'
      
        '       cast(substr(fl.cnpj,1,2) || '#39'.'#39' || substr(fl.cnpj,3,3) ||' +
        ' '#39'.'#39' || substr(fl.cnpj,6,3) || '#39'/'#39' || substr(fl.cnpj,9,4) || '#39'-'#39 +
        ' || substr(fl.cnpj,13,2)  as varchar) as cnpjfilial,'
      ''
      
        '       cast(retirabrancoepipeeascii255(fl.rua) as varchar(100)) ' +
        'as ruafilial,'
      ''
      
        '       cast(substr(cast(fl.cep as varchar),1,5) || '#39'-'#39' || substr' +
        '(cast(fl.cep as varchar),6,3) as varchar) as cepfilial ,'
      ''
      
        '       cast((select b.nome from bairros b where (fl.estado = b.e' +
        'stado) and (fl.cidade = b.cidade) and (fl.bairro = b.codigo)) as' +
        ' varchar(80)) as bairrofilial,'
      ''
      
        '       cast((select c.nome from cidades c where (fl.estado = c.e' +
        'stado) and (fl.cidade = c.codigo)) as varchar(40)) as cidadefili' +
        'al,'
      '       fl.estado as estadofilial,'
      
        '       cast(case when length(cast(fl.fonenumero as varchar)) = 7' +
        ' then substr(cast(fl.fonenumero as varchar),1,3) || '#39'-'#39' || subst' +
        'r(cast(fl.fonenumero as varchar),4,4)'
      
        '                 when length(cast(fl.fonenumero as varchar)) = 8' +
        ' then substr(cast(fl.fonenumero as varchar),1,4) || '#39'-'#39' || subst' +
        'r(cast(fl.fonenumero as varchar),5,4)'
      '                 else   to_char(fl.fonenumero,'#39#39')'
      '            end as varchar) as fonefilial,'
      
        '       cast(case when (coalesce(fl.foneddd,0) > 0) then '#39'('#39' || c' +
        'ast(fl.foneddd as varchar) || '#39')'#39
      '                 else '#39'(  )'#39
      '            end as varchar) as dddfilial,'
      
        '       cast(case when length(cast(fl.faxnumero as varchar)) = 7 ' +
        'then substr(cast(fl.faxnumero as varchar),1,3) || '#39'-'#39' || substr(' +
        'cast(fl.faxnumero as varchar),4,4)'
      
        '                 when length(cast(fl.faxnumero as varchar)) = 8 ' +
        'then substr(cast(fl.faxnumero as varchar),1,4) || '#39'-'#39' || substr(' +
        'cast(fl.faxnumero as varchar),5,4)'
      '                 else   to_char(fl.faxnumero,'#39#39')'
      '            end as varchar) as fonefaxfilial,'
      
        '       cast(case when (coalesce(fl.faxddd,0) > 0) then '#39'('#39' || ca' +
        'sT(fl.faxddd as varchar) || '#39')'#39
      '                 else '#39'(  )'#39
      '            end as varchar) as dddfaxfilial,'
      ''
      '       fl.aliquotacreditoicms,'
      '       fl.simples,'
      
        '       (select c.cfps from contratos c where c.numero = df.contr' +
        'ato) as cfps,'
      
        '       '#39#39' as impostoretido1, '#39#39' as impostoretido2, '#39#39' as imposto' +
        'retido3, '#39#39' as impostoretido4,'
      '       cast((select cidades.nome'
      '             from cidades'
      
        '             where cidades.codigo = fl.cidade and cidades.estado' +
        '=fl.estado'
      
        '            )||'#39' - '#39'||fl.estado as varchar) as cidadeestadofilia' +
        'l,'
      
        '       cast(retirabrancoepipeeascii255(fl.rua)||'#39' - '#39'||(select b' +
        'airros.nome'
      '                            from bairros'
      '                            where bairros.estado = fl.estado'
      '                              and bairros.cidade = fl.cidade'
      '                              and bairros.codigo = fl.bairro'
      '                           )as varchar) as ruabairrofilial,'
      
        '       (select razao from filiais where codigo = df.filialvenda)' +
        ' as filialvendanome,'
      
        '       cast(case when df.totalbaseicmsproprio       > 0 then '#39'IC' +
        'MS proprio  Base: R$ '#39' || cast(df.totalbaseicmsproprio as varcha' +
        'r) end as varchar) as baseicmsproprio,'
      
        '       cast(case when df.totalvaloricmsproprio      > 0 then '#39'('#39 +
        ' || cast(df.aliquotaicmsproprio as varchar) || '#39'%): R$ '#39' || cast' +
        '(df.totalvaloricmsproprio as varchar) end as varchar) as valoric' +
        'msproprio,'
      
        '       cast(case when df.totalbaseicmssubstituicao  > 0 then '#39'Su' +
        'bstituicao  Base: R$ '#39' || cast(df.totalbaseicmssubstituicao as v' +
        'archar) end as varchar) as basesubstituicao,'
      
        '       cast(case when df.totalvaloricmssubstituicao > 0 then '#39'('#39 +
        ' || cast(df.aliquotaicmsproprio as varchar) || '#39'%): R$ '#39' || cast' +
        '(df.totalvaloricmssubstituicao as varchar) end as varchar) as va' +
        'lorsubstituicao,'
      '       df.totalbaseicmssubstituicao,'
      '       df.totalvaloricmssubstituicao,'
      '       df.anexotres,'
      '       df.acrescimofinanceiro,'
      '       df.acrescimoexcluido,'
      '       df.icmsexcluido,'
      '       df.irretido,'
      '       df.inssretido,'
      '       df.issretido,'
      '       df.cofinsretido,'
      '       df.pisretido,'
      '       df.csllretido,'
      '       df.csrfretido,'
      '       df.substituicaoipi,'
      '       df.dadofiscalcomplementar,'
      '       df.observacoescomplementar,'
      '       df.obscliente,'
      '       df.obsclienteipisuspenso,'
      '       df.observacoesicmssubstituido,'
      '       cast('#39#39' as varchar) as obscorponota,'
      '       cast('#39#39' as varchar) as valorextenso1,'
      '       cast('#39#39' as varchar) as valorextenso2,'
      '       cast('#39#39' as varchar) as valor1,'
      '       cast('#39#39' as varchar) as valor2,'
      '       cast('#39#39' as varchar) as valor3,'
      '       cast('#39#39' as varchar) as valor4,'
      '       cast('#39#39' as varchar) as valor5,'
      '       cast('#39#39' as varchar) as valor6,'
      '       cast(null as date) as data1,'
      '       cast(null as date) as data2,'
      '       cast(null as date) as data3,'
      '       cast(null as date) as data4,'
      '       cast(null as date) as data5,'
      '       cast(null as date) as data6,'
      '       cast(null as numeric(11,2)) as valorcreditoicms,'
      
        '       (select c.contribicms from clientes c where c.codigo = df' +
        '.cliente) as contribicms,'
      
        '       case when df.contrato is not null then contratos_avista(d' +
        'f.contrato) ELSE false END as avista,'
      '      endnumero,'
      
        '      case when (select min(datavencto) from venctosdadosfiscais' +
        ' vdf where vdf.dadofiscal = df.numero)=df.data then'
      '        /* a crase neste caso '#233' facultativa */'
      '        cast('#39'A VISTA'#39' as varchar(7))'
      '      else'
      '        cast('#39'A PRAZO'#39' as varchar(7))'
      '       end as formapagamento,'
      
        '       df.ValorTotalImpostoIBT,df.valorimpostonacional,df.valori' +
        'mpostoestadual,df.valorimpostomunicipal,'
      '       df.notaparcial,'
      ''
      
        '       cast(concat(substring(df.numprotocolonfse from 1 for 4),'#39 +
        '-'#39','
      '              substring(df.numprotocolonfse from 5 for 4),'#39'-'#39','
      '              substring(df.numprotocolonfse from 9 for 4),'#39'-'#39','
      
        '              substring(df.numprotocolonfse from 13 for 4)) as v' +
        'archar(19)) as numprotocolonfse,'
      '       fl.aedffatura,'
      '       df.nomepais,'
      '       dF.issqnbasecalculo,'
      '       df.infcomplementar,'
      '       df.dhprocnfe'
      ''
      ''
      'FROM'
      
        '      dadosfiscais df LEFT JOIN usuarios u ON ( df.vendedor = u.' +
        'codigo )'
      
        '                      LEFT JOIN planos p ON ( df.plano = p.codig' +
        'o )'
      
        '                      LEFT JOIN fornecedores f ON ( df.fornecedo' +
        'rtransporte = f.codigo )'
      
        '                      LEFT JOIN cidades c ON ( (df.estado = c.es' +
        'tado) and (df.cidade = c.codigo) )'
      
        '                      LEFT JOIN bairros b  ON ((df.estado = b.es' +
        'tado) and (df.cidade = b.cidade) and (df.bairro = b.codigo))'
      
        '                      LEFT JOIN naturezas n  ON ( df.codigonatur' +
        'eza = n.codigo )'
      
        '                      LEFT JOIN volumesdadosfiscais vdf  ON ( df' +
        '.numero = vdf.dadofiscal AND vdf.codigo = 1),'
      '                      filiais fl'
      'WHERE (df.numero =:numero) and (fl.codigo = df.filialemissao)')
