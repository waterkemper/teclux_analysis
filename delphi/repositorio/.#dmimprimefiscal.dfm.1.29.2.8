    Sql.Strings = (
      'select sd.servico,'
      
        '       case when sd.complementoservico is not null and ae.denomi' +
        'nacao is not null then'
      
        '              cast('#39'('#39' || ae.denominacao || '#39')'#39' || s.descricao |' +
        '| '#39' - '#39' || sd.complementoservico as varchar(1272))'
      
        '            when sd.complementoservico is null and ae.denominaca' +
        'o is not null then'
      
        '              cast('#39'('#39' || ae.denominacao || '#39')'#39' || s.descricao a' +
        's varchar(1272))'
      '            else'
      '              cast(s.descricao as varchar(1272))'
      '       end as descricao,'
      ''
      
        '        cast(substr(cast(ae.codigoatividade as varchar),1,4) || ' +
        #39'-'#39' ||'
      
        '             substr(cast(ae.codigoatividade as varchar),5,1)  ||' +
        ' '#39'/'#39' ||'
      
        '             substr(cast(ae.codigoatividade as varchar),6,2)  as' +
        ' varchar) as atividade,'
      ''
      '       sd.quantidade,'
      '       sd.aliquotaissqn,'
      '       sd.valorservico,'
      '       sd.valorissqn,'
      '       (sd.quantidade * sd.valorservico) as valortotal,'
      
        '       (select c.nome from cidades c where c.estado = sd.estado ' +
        'and c.codigo = sd.cidade) as nomecidade,'
      '       sd.cstissqn'
      'from servicosdadosfiscais sd'
      '     join servicos s'
      '          left join atividadeseconomicas ae'
      '          on s.cnae = ae.codigo'
      '     on sd.servico = s.codigo'
