procedure TdtmImprimeFiscal.BloquearEstoque;
var
  WhereSQL: String;
begin
  WhereSQL := '';
  qryProdutos.First;
  while Not qryProdutos.Eof do begin
    WhereSQL := WhereSQL +
    '((e.produto = ' + qryProdutosproduto.AsString + ')and' +
    '(e.filial = '   + qryProdutosfilial.AsString  + '))or';
    qryProdutos.Next
  end;
  Delete(WhereSQL, Length(WhereSQL) - 1, 2);
  qryEstoqueBloqueio.Sql[36] := WhereSQL;
  qryEstoqueBloqueio.Open;
end;

procedure TdtmImprimeFiscal.ObterComplementosDadosFiscais(DadoFiscal: Integer;
                                                          ModeloNota: Integer;
                                                          Industria : Boolean);
begin
  ReFazConsulta(qryDadosFiscais, [1], [DadoFiscal]);

  if qryDadosFiscaiscodigofiscal.AsInteger <> ctICMSACRESCIMOFINANCEIRO then
  begin

    RefazConsulta(qryProdutos,[0,1,2],[qryDadosFiscaiscliente.AsInteger,qryDadosFiscaistipocliente.AsString,DadoFiscal]);
    RefazConsulta(qryServicosDadosFiscais,[0],[DadoFiscal]);
    RefazConsulta(qryVenctos,[0],[DadoFiscal]);
    RefazConsulta(qryVenctoAgrupados,[0],[DadoFiscal]);
    ReFazConsulta(qryFornecedor, [0], [DadoFiscal]);
    ReFazConsulta(qrynotas, [0], [DadoFiscal]);

    if trim(qryDadosFiscaisobservacoesaux.AsString)<>'' then
      qryDadosFiscaisobservacoesaux.AsString :=
        qryDadosFiscaisobservacoesaux.AsString + #10 + ObterImpostosRetidos(qryDadosFiscais)
    else
      qryDadosFiscaisobservacoesaux.AsString := ObterImpostosRetidos(qryDadosFiscais);

  end
  else
    RefazConsulta(qryECFsDadosFiscais, [0], [DadoFiscal]);

  RefazConsulta(qryCalculos,[0],[DadoFiscal]);

  if industria then
  begin
    RefazConsulta(qrySerieFilial,[0,1],[FilialBase,SerieSugestao]);
    ModeloNota := qrySerieFilialmodelonota.AsInteger;
  end;
// REMOVIDO DE ACORDO COM O BUG #2729, ACREDITA-SE NÃO AFETAR OUTROS CLIENTES
{if ParSistema.SequenciaIPINotaSaida then
begin
    SequenciaIPI;
    PreencherObservacoesNota;
end;
}
  ReFazConsulta(qryModelosNotas, [0], [ModeloNota]);
end;

function TdtmImprimeFiscal.ObterDadosFiscais(Contrato: String): Boolean;
begin
  RefazConsulta(qryDadosFiscais, [1],[Contrato]);
  ReFazConsulta(qrySeriesFiliais, [0, 1], [FilialBase, SerieSugestao]);
  ReFazConsulta(qryModelosNotas, [0], [qrySeriesFiliaismodelonota.AsInteger]);
  if qrySeriesFiliais.RecordCount = 0 then begin
    qryDadosFiscais.Cancel;
    MensagemAviso(format(ctFILIALSEMSERIE, [FilialBase, 'mercadorias']));
    Result := False;
  end else if qrySeriesFiliaismodelonota.IsNull then begin
    MensagemAviso(ctSERIESUGESTAOSEMMODELO);
    Result := False;
  end else
  Result := True;
end;

function TdtmImprimeFiscal.ImprimirCupom(var DadosFornec: String; var FormaPagamento: String;
  var NumeroCupom: Integer; DadosFiscais, Produtos, Servicos, VenctosDadosFiscais: TtecQuery;
  Entrada: Currency; FecharCupom: Boolean; Parcial: Boolean = False): Boolean;
var
  Tributo: TtecTributo;
  Acrescimo: Real;
  StrCupom,MensagemFechamento,CPF_CNPJ: String;
  ErroNroCupom,
  Sair,
  ProducaoPropria: Boolean;
  ValorTotal: Currency;
  Cont: Integer;
  vPercTrib : Currency;
  vDescricao : String;

  function DadosFornecedorCliente: String;
  begin
{    Result := Result + 'Cliente: ' + DadosFiscais.FieldByName('cliente').AsString + ' ' +
              DadosFiscais.FieldByName('nome').AsString + slinebreak;
    Result := Result + 'CPF/CNPJ: '+DadosFiscais.FieldByName('pessoanumero').AsString + ' - DOC/IE: ' + DadosFiscais.FieldByName('documento').AsString + slinebreak;
    Result := Result + DadosFiscais.FieldByName('rua').AsString + ', ' + DadosFiscais.FieldByName('endnumero').AsString + slinebreak;
    Result := Result + DadosFiscais.FieldByName('nomebairro').AsString + slinebreak;
    Result := Result + DadosFiscais.FieldByName('cep').AsString + ' ' +
              DadosFiscais.FieldByName('cidadenome').AsString   + ' ' +
              DadosFiscais.FieldByName('estado').AsString + slinebreak;    }
    Result := Result + ' DOC/IE do Cliente: ' + DadosFiscais.FieldByName('documento').AsString+ slinebreak;
    Result := Result + ' Vendedor '+DadosFiscais.FieldByName('vendedor').AsString;
    if(DadosFiscais.FieldByName('vendedor').AsString<>'') then
    begin
      RefazConsulta(qryNomeVendedor,[0],[DadosFiscais.FieldByName('vendedor').AsVariant]);
      Result:=Result + ' - '+qryNomeVendedornomevendedor.AsString;
    end;
    Result:=Result + slinebreak;

    if (qryFornecedorrazao.AsString <> '') then
    begin

      Result := Result + 'Tr: ' + qryFornecedorrazao.AsString
               + ' Pl:' + DadosFiscais.FieldByName('placa').AsString + slinebreak;
      if qryFornecedorpessoatipo.Value = 'J' then
        Result := Result + 'CNPJ: ' + qryFornecedorpessoanumero.AsString
             + ' IE: ' + qryFornecedorinscricaoestadual.AsString  + slinebreak
      else
        Result := Result + 'CPF: ' + qryFornecedorpessoanumero.AsString
                  + ' Doc: ' + qryFornecedorinscricaoestadual.AsString + slinebreak;
        Result := Result + ' Fone: (' + qryFornecedorfoneddd.AsString + ') '
                  +  qryFornecedorfonenumero.AsString;
    end;
  end;

  Function FormadePagamento(forma_pagamento: String): String;
  begin
    if forma_pagamento = 'C' then result := 'CARTAO'
    else if forma_pagamento = 'B' then result := 'CARTAO'
    else if forma_pagamento = 'H' then result := 'CHEQUE'
    else if forma_pagamento = 'T' then result := 'CREDITO TROCA'
    else result := 'Dinheiro';
  end;

begin
  if ErroECF then
    Result := False
  else begin
    try
      Sair := False;
      ReFazConsulta(qryFornecedor, [0], [DadosFiscais.FieldByName('fornecedortransporte').AsInteger]);
      DadosFornec := DadosFornecedorCliente;
      ECFPadrao.CorrigeEstadoDeErro(false);
      CPF_CNPJ:=FormatarCPFouCGC(DadosFiscais.FieldByName('pessoanumero').AsString);
      if (CPF_CNPJ='') then
        //CPF_CNPJ - NAO INFORMADO
        CPF_CNPJ:='00000000000';

      if ParSistema.TipoTEF = tsSEMTEF then
      //CLIENTE: $codigo - $nome <enter> cpf/cnpj: $cpfcnpj - DOC/IE: $documento <enter> $rua, $numero <enter> $bairro<enter>$cep $cidade $estado <enter>
      //VENDEDOR: $vendedor <enter> TR:
        ECFPadrao.IniciarCupom(CPF_CNPJ,
                               DadosFiscais.FieldByName('cliente').AsString + ' ' + DadosFiscais.FieldByName('nome').AsString,
                               EnderecoCliente(DadosFiscais.FieldByName('rua').AsString,
                               DadosFiscais.FieldByName('endnumero').AsString,
                               DadosFiscais.FieldByName('endcomplemento').AsString,
                               DadosFiscais.FieldByName('bairro').AsString,
                               DadosFiscais.FieldByName('nomebairro').AsString,
                               DadosFiscais.FieldByName('cidade').AsString,
                               DadosFiscais.FieldByName('cidadenome').AsString,
                               DadosFiscais.FieldByName('cep').AsString,
                               DadosFiscais.FieldByName('estado').AsString))
      else
      begin
        repeat
          ECFPadrao.IniciarCupom(CPF_CNPJ,
                                 DadosFiscais.FieldByName('cliente').AsString + ' ' + DadosFiscais.FieldByName('nome').AsString,
                                 EnderecoCliente(DadosFiscais.FieldByName('rua').AsString,
                                 DadosFiscais.FieldByName('endnumero').AsString,
                                 DadosFiscais.FieldByName('endcomplemento').AsString,
                                 DadosFiscais.FieldByName('bairro').AsString,
                                 DadosFiscais.FieldByName('nomebairro').AsString,
                                 DadosFiscais.FieldByName('cidade').AsString,
                                 DadosFiscais.FieldByName('cidadenome').AsString,
                                 DadosFiscais.FieldByName('cep').AsString,
                                 DadosFiscais.FieldByName('estado').AsString));

          if ECFPadrao.Erro then begin
            if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + slinebreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
              Sair := True
          end;
        until Sair or (Not ECFPadrao.Erro);
      end;

      if ECFPadrao.Erro then begin
        Result := False;
        if ParSistema.TipoTEF = tsSEMTEF then
          MensagemErro(ECFPadrao.Mensagem)
      end else begin
        if Not ECFPadrao.Erro then begin
          Produtos.First;
          while not Produtos.Eof do begin
            if DadosFiscais.FieldByName('numero').AsInteger = Produtos.FieldByName('dadofiscal').AsInteger then begin
              if (Produtos.FieldByName('incidencia').AsString = ctTRIBUTADASUBSTITUICAO) or
                 (Produtos.FieldByName('incidencia').AsString = ctCOBRADOSUSTITUICAO) or
                 (Produtos.FieldByName('incidencia').AsString = ctISENTASUBSTITUICAO) or
                 (Produtos.FieldByName('incidencia').AsString = ctREDUCAOBASESUBSTITUICAO) or
                 (Produtos.FieldByName('csosn').asstring =  '201') or    { 201	Tributada pelo Simples Nacional com permissão de crédito e com cobrança do ICMS por substituição tributária }
                 (Produtos.FieldByName('csosn').asstring =  '202') or    { 202	Tributada pelo Simples Nacional sem permissão de crédito e com cobrança do ICMS por substituição tributária }
                 (Produtos.FieldByName('csosn').AsString =  '203') or    {203	Isenção do ICMS no Simples Nacional para faixa de receita bruta e com cobrança do ICMS por substituição tributária }
                 (Produtos.FieldByName('csosn').AsString =  '500')       {500 ICMS cobrado anteriormente por substituição tributária (substituído) ou por antecipação }
              then
                Tributo := tbSubstitui
              else if (Produtos.FieldByName('aliquotaicms').Value = 0) or
                      (Produtos.fieldbyname('incidencia').AsString = ctISENTA) or
                      (Produtos.fieldbyname('csosn').AsString =  '103') or {Isenção do ICMS no Simples Nacional para faixa de receita bruta}
                      (Produtos.fieldbyname('csosn').AsString =  '300') then   {imune}
                Tributo := tbIsento
              else
                Tributo := tbTributado;
              Sleep(500);
              if Produtos.FindField('producaopropria') <> nil then
                ProducaoPropria := Produtos.FieldByName('producaopropria').asboolean
              else
                ProducaoPropria := False;

              vDescricao := '';
              if not Produtos.fieldbyname('cest').isnull then
                vDescricao := '#' + somentenumero(Produtos.FieldByName('cest').asString);

              if not Produtos.fieldByName('classificacaofiscal').isnull then
                vDescricao := vDescricao + '#' + somentenumero(Produtos.FieldByName('classificacaofiscal').asString);

              if vDescricao <> '' then
                vDescricao := vDescricao + '#' + Produtos.FieldByName('descricaoproduto').AsString
              else
                vDescricao := Produtos.FieldByName('descricaoproduto').AsString;


              ECFPadrao.VenderItem(Produtos.FieldByName('produto').AsString,
                                   vDescricao,
                                   {Trocar(FormatFloat('0.,00', RoundTo}Truncar(Produtos.FieldByName('precovenda').AsFloat,2){),'.','')},
                                   {formatfloat('##0.000',}Produtos.FieldByName('quantidade').AsCurrency{)},
                                   Produtos.FieldByName('unidade').AsString,
                                   Produtos.FieldByName('aliquotaicms').AsString,
                                   '$', Produtos.FieldByName('valordescontoitem').AsCurrency,
                                   NomeFilialBase, Tributo, ProducaoPropria);
             ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
            end;
            if ECFPadrao.Erro then
            begin
              Result := False;
              break
            end
            else
              Produtos.Next;
          end;
          if ParSistema.ContratoComServico then begin
            Servicos.First;
            while not Servicos.Eof do begin
              if DadosFiscais.FieldByName('numero').AsInteger = Servicos.FieldByName('dadofiscal').AsInteger then
              begin
                ECFPadrao.VenderItem(Servicos.FieldByName('servico').AsString,
                                     Servicos.FieldByName('descricao').AsString,
                                     Servicos.FieldByName('valorservico').AsCurrency{AsString},
                                     Servicos.FieldByName('quantidade').AsCurrency{AsString+'000'}, 'UN',
                                     Servicos.FieldByName('aliquotaissqn').AsString,
                                     '%', 0, NomeFilialBase, tbServico, false);
                ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
              end;
              if ECFPadrao.Erro then
              begin
                Result := False;
                break
              end
              else
                Servicos.Next;
            end
          end
        end;
        if Not ECFPadrao.Erro then
        begin
          Acrescimo := DadosFiscais.FieldByName('valortotal').AsFloat
                       - DadosFiscais.FieldByName('valorvista').AsFloat
                       - DadosFiscais.FieldByName('desconto').AsFloat
                       + DadosFiscais.FieldByName('valorfrete').AsFloat
                       + DadosFiscais.FieldByName('seguro').AsFloat;
          repeat
            ECFPadrao.TotalizaCupom('$', Trocar(FormatFloat('0.,00',RoundTo(Acrescimo, -2)),'.',''));
            if ECFPadrao.Erro then
              if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + slinebreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
                Sair := True
          until Sair or (Not ECFPadrao.Erro);
        end;
        if FecharCupom then
        begin
          if (Not ECFPadrao.Erro) then
          begin

            (*
            if( (Ecfpadrao.AchaFPGDescricao('A VISTA')<>nil) and (EcfPadrao.AchaFPGDescricao('A PRAZO')<>nil)) then
            begin
              ValorTotal := RoundTo(DadosFiscais.FieldByName('valortotal').AsFloat,-2);
              if Entrada < ValorTotal then
              begin
                if Entrada > 0 then
                begin
                  FormaPagamento := 'A VISTA';
                  {FormaPagamento := 'Dinheiro';}
                  repeat
                    ECFPadrao.PagamentoCupom(FormaPagamento, Trocar(FormatFloat('0.,00', RoundTo(Entrada, -2)),'.',''));
                    if ECFPadrao.Erro then
                      if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + slinebreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
                        Sair := True
                  until Sair or (Not ECFPadrao.Erro);
                end;
                if Not ECFPadrao.Erro then
                begin
                  Entrada := RoundTo(DadosFiscais.FieldByName('valortotal').AsFloat,-2) - Entrada;
                  repeat
                    FormaPagamento := 'A PRAZO';
                    {FormaPagamento := 'Dinheiro';}
                    Sleep(1000);
                    ECFPadrao.PagamentoCupom(FormaPagamento, Trocar(FormatFloat('0.,00', RoundTo(Entrada, -2)),'.',''));
                    if ECFPadrao.Erro then
                      if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + slinebreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
                        Sair := True
                  until Sair or (Not ECFPadrao.Erro);
                end
              end else
              begin
               FormaPagamento := 'A VISTA';
               {FormaPagamento := 'Dinheiro';}
                repeat
                  ECFPadrao.PagamentoCupom(FormaPagamento, Trocar(FormatFloat('0.,00',RoundTo(DadosFiscais.FieldByName('valortotal').AsCurrency,-2)),'.',''));
                  if ECFPadrao.Erro then
                    if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + slinebreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
                      Sair := True
                until Sair or (Not ECFPadrao.Erro);
              end
            end
            else
            begin

              RefazConsulta(qryFormasPagto,[0],[DadosFiscais.FieldByName('contrato').AsString]);
              if not Parcial and (qryFormasPagto.RecordCount > 0) then
              begin
                qryFormasPagto.First;
                while not qryFormasPagto.Eof do
                begin
                  FormaPagamento := qryFormasPagtoformapagto.AsString;
                  ECFPadrao.PagamentoCupom(FormaPagamento, Trocar(FormatFloat('0.,00', RoundTo(qryFormasPagtovalor.AsCurrency, -2)),'.',''));
                  if ECFPadrao.Erro then
                    Break;
                  qryFormasPagto.Next;
                end;
              end

            end;
            *)

            if VenctosDadosFiscais.recordcount <> 0 then
            begin
              qryFormasPagamento.Close;
              qryFormasPagamento.Open;
              qryFormasPagamento.Delete;
              VenctosDadosFiscais.first;
              while not VenctosDadosFiscais.eof do
              begin
                if not qryFormasPagamento.Locate('formapagamento', FormadePagamento(VenctosDadosFiscais.fieldbyname('formapagamento').AsString),[]) then
                  qryFormasPagamento.Append
                else
                  qryFormasPagamento.edit;
                qryFormasPagamentoformapagamento.AsString :=  FormadePagamento(VenctosDadosFiscais.fieldbyname('formapagamento').AsString);
                qryFormasPagamentovalor.AsCurrency :=  qryFormasPagamentovalor.AsCurrency + VenctosDadosFiscais.fieldbyname('valorvencto').AsCurrency;
                qryFormasPagamento.post;

                VenctosDadosFiscais.next;
              end;

              qryFormasPagamento.First;
              while not qryFormasPagamento.Eof do
              begin
                FormaPagamento := qryFormasPagamentoformapagamento.AsString;
                ECFPadrao.PagamentoCupom(FormaPagamento, Trocar(FormatFloat('0.,00', RoundTo(qryFormasPagamentovalor.AsCurrency, -2)),'.',''));
                if ECFPadrao.Erro then
                  Break;
                qryFormasPagamento.Next;
              end;

            end
            else
              mensagemerro('Não vencimentos para informar as formas de pagamento. Entre em contato com o suporte');



            if Not ECFPadrao.Erro then
              repeat
                if (DadosFiscais.FindField('notaparcial')<>nil) and
                   DadosFiscais.Fieldbyname('notaparcial').AsBoolean then
                  MensagemFechamento := 'CUPOM PARCIAL '+ sLineBreak;

                MensagemFechamento := MensagemFechamento +
                                     'PV'+preencheString(DadosFiscais.FieldByName('contrato').AsString,'0',10,False) +
                                      sLineBreak  + DadosFornec;

                if (DadosFiscais.FieldByName('valortotalimpostoibt').AsCurrency<>0) then
                begin
                  vPercTrib := roundto(DadosFiscais.FieldByName('valortotalimpostoibt').AsCurrency / DadosFiscais.FieldByName('valortotal').AsCurrency * 100, -2);
                  MensagemFechamento := MensagemFechamento +
                                        'Trib Aprox R$ '+FormatarValor(DadosFiscais.FieldByName('valorimpostonacional').AsCurrency - DadosFiscais.FieldByName('valorimpostoestadual').AsCurrency,2) + ' Federal R$ '
                                         + FormatarValor(DadosFiscais.FieldByName('valorimpostoestadual').AsCurrency,2) + ' Estadual ' + sLineBreak +
                                         'Fonte: IBPT/FECOMERCIO '+'        '+Produtos.FieldByName('chaveibpt').AsString;

                  { ' Valor aproximado dos tributos (Lei 12.741/2012) R$ '+
                                      FormatarValor(DadosFiscais.FieldByName('valortotalimpostoibt').AsCurrency,2) +
                                      ' ('+FormatarValor(vPercTrib,2)+'%) Fonte: IBPT';                              }
                end;

                 //nao suporta o tamanho inteiro das observacoes
                if(pos('FIT LOGGER',ECFPadrao.SubModelo)<>0) then
                    MensagemFechamento:=copy(MensagemFechamento,1,190);

                ECFPadrao.FinalizarCupom(FormaPagamento, DadosFiscais.FieldByName('valortotal').AsString,
                                         MensagemFechamento);
                ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
                if ECFPadrao.Erro then
                  if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + slinebreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then
                    Sair := True
              until Sair or (Not ECFPadrao.Erro);
          end;
          Result := Not ECFPadrao.Erro;
          if ECFPadrao.Erro then
          begin
            MensagemErro(ECFPadrao.Mensagem);
            ECFPadrao.CancelarCupom;
          end
          else
            ECFPadrao.AbrirGaveta;
        end else
        begin
          Result := Not ECFPadrao.Erro;//True;
          FormaPagamento := '';
        end;
        if Not ECFPadrao.Erro then begin
          Cont := 0;
          repeat
            Sleep(2000);
            StrCupom := ECFPadrao.Cupom;
            try
              NumeroCupom  := StrToInt(StrCupom);
              ErroNroCupom := False;
            except
              ErroNroCupom := True;
            end;
            if ECFPadrao.Erro then begin
              if biblio.MensagemConfirmacao(ECFPadrao.Mensagem + slinebreak + ctTEFIMPRIMIRNOVAMENTE) <> smbOK then begin
                Sair := True;
                Result := False
              end
            end else if ErroNroCupom then begin
              if (Cont > 4) and  (MensagemConfirmacao('Erro na leitura do número do cupom no ECF. Tentar uma nova leitura?') <> smbOK) then begin
                Sair := True;
                Result := False
              end;
              Inc(Cont);
            end
          until Sair or (Not ErroNroCupom);
        end;
      end
    except
      ECFPadrao.CancelarCupom;
      ECFPadrao.AtualizarTotalizadorGeral(NomeArquivoECFs);
      Result := False;
      raise;
    end;
  end;
end;

function TdtmImprimeFiscal.ImprimirNota(DadoFiscal, ModeloNota: Integer; Impressora: String = ''): Boolean;
var
  Count,        Columas, ProdPag,   ServPag, ProdAux, Pagina,
  LinhasVencto, PagServ, QtdadePag, CFOP,    CFPS,    NumeroProdutos, cf: Integer;
  BandProd,     ProdutoAnterior: String;
  CompostoImpresso: Boolean;
//  CreditoICMS: Currency;

  function ContarPaginasCompostos: Integer;
  begin
    Result := 0;
    qryProdutos.First;
    while not qryProdutos.Eof do
    begin
      if qryProdutoscomposto.AsBoolean and (qryProdutosdiscriminarcomposto.AsString <> 'N') then
      begin
        if qryProdutosdiscriminarcomposto.AsString = 'C' then
          Inc(Result);
        RefazConsulta(qryProdutosCompostos, [0,1], [qryDadosFiscaisnumero.AsInteger, qryProdutosproduto.AsLargeInt]);
        Result := Result + qryProdutosCompostos.RecordCount;
      end
      else
        Inc(Result);
      qryProdutos.Next;
    end;
  end;

  procedure ImprimirComposto;
  begin
    if qryProdutosproduto.AsString <> ProdutoAnterior then
      RefazConsulta(qryProdutosCompostos, [0,1], [qryDadosFiscaisnumero.AsInteger,
                                                  qryProdutosproduto.AsLargeInt]);
    ProdutoAnterior := qryProdutosproduto.AsString;
//      qryProdutosCompostos.First;
    with TextPrinter do
    begin
      if qryProdutosdiscriminarcomposto.AsString = 'S' then
      begin
        while not qryProdutosCompostos.Eof do
        begin
          WriteBand(qryProdutosCompostos.Fields);
          BreakLine(1);
          AddClassificacaoFiscal(qryProdutosCompostosipi.AsString,qryProdutosCompostosclassificacaofiscal.AsString);
          qryProdutosCompostos.Next;
          Inc(Count);
          if Count >= ProdPag then
            Break;
        end;
        if Count < ProdPag then
          qryProdutos.Next;
      end
      else if qryProdutosdiscriminarcomposto.AsString = 'C' then
      begin
        if not CompostoImpresso then
        begin
          CompostoImpresso := True;
          WriteBand(qryProdutos.Fields);
          BreakLine(1);
          Inc(Count);
        end;
        if Count < ProdPag then
          while not qryProdutosCompostos.Eof do
          begin
            WriteBand(qryProdutosCompostos.Fields);
            BreakLine(1);
            AddClassificacaoFiscal(qryProdutosCompostosipi.AsString,qryProdutosCompostosclassificacaofiscal.AsString);
            qryProdutosCompostos.Next;
            Inc(Count);
            if Count >= ProdPag then
              Break;
          end;
        if Count < ProdPag then
        begin
          AddClassificacaoFiscal(qryProdutosipi.AsString,qryProdutosclassificacaofiscal.AsString);
          qryProdutos.Next;
          CompostoImpresso := False;
        end;
      end;
    end;
  end;

  procedure ValorExtenso;
  var LinhaE: T_Extenso;
      Extenso1, Extenso2: String;
  begin
    LinhaE.ExtTamLinha[1]:= 55;
    LinhaE.ExtTamLinha[2]:= 55;
    Extenso(qryDadosFiscaisvalortotal.AsFloat,$92,'','','','',' ', LinhaE);
    Extenso1:= LinhaE.ExtLinha[1];
    Extenso2:= LinhaE.ExtLinha[2];
    qryDadosFiscaisvalorextenso1.AsString:= Extenso1;
    qryDadosFiscaisvalorextenso2.AsString:= Extenso2;
    qryDadosFiscais.Close;
    qryDadosFiscaisvalorextenso1.Size:= Length(Extenso1);
    qryDadosFiscaisvalorextenso2.Size:= Length(Extenso2);
    qryDadosFiscais.Open;
    ReFazConsulta(qryDadosFiscais, [1], [DadoFiscal]);
    qryDadosFiscaisvalorextenso1.AsString:= Extenso1;
    qryDadosFiscaisvalorextenso2.AsString:= Extenso2;
  end;

  procedure GerarLinhasNotasFiscais;
  begin
    qryAcertoDadosFiscais.Open;
    qryAcertoDadosFiscais.First;
    while not qryAcertoDadosFiscais.Eof do
    begin
      ReFazConsulta(qryAcertoProdutos,[0],[qryAcertoDadosFiscaisnumero.AsVariant]);
      qryAcertoProdutos.First;
      while not qryAcertoProdutos.Eof do
      begin
        try
          qryLinhasNotas.Open;
          qryLinhasNotas.Append;
          qryLinhasNotasdadofiscal.AsInteger:= qryAcertoProdutosdadofiscal.AsInteger;
          qryLinhasNotaslinha.AsInteger:= qryAcertoProdutosnumero.AsInteger;
          qryLinhasNotasprodutodadofiscal.AsInteger:= qryAcertoProdutosnumero.AsInteger;
          qryLinhasNotastexto.AsString:= '';

          qryLinhasNotas.Post;
          qryAcertoProdutos.Next;
        except
          qryAcertoProdutos.Next;
        end;
      end;
      qryAcertoDadosFiscais.Next;
    end;
    Perpetrar([qryLinhasNOtas]);
  end;


  function CFOPNota: String;
  Var Dadofiscal: Integer;
      Campo: String;
  begin
    Dadofiscal:= qryDadosFiscaisnumero.AsInteger;

    ReFazConsulta(qryCodigosFiscais,[0],[Dadofiscal]);

    if (qryCodigosFiscais.RecordCount > 1) and
       (qryCodigosFiscais.RecordCount <= 2)  then
    begin
      qryCodigosFiscais.First;
      while not qryCodigosFiscais.Eof do
      begin
        Campo:= Campo + qryCodigosFiscaiscodigofiscal.AsString + ',';
        qryCodigosFiscais.Next;
      end;
      Result:= Copy(Campo,1,(Length(Campo)-1));
    end
    else if (qryCodigosFiscais.RecordCount > 2) then
    begin
      Result:= qryCodigosFiscaiscodigofiscal.AsString + '...';
    end
    else
      Result:= qryCodigosFiscaiscodigofiscal.AsString;
  end;

begin
  if not ParSistema.ControlesVoltadosparaIndustria then
  begin
    ObterComplementosDadosFiscais(DadoFiscal, ModeloNota);
    qryDadosFiscaisCalcFields(qryDadosFiscais);
    if Impressora = '' then
    begin
      if (qryModelosNotastiponotafiscal.AsString = 'Serviços') then
        NomeImpressoraEscolhida:= parsistema.NomeImpressoraNotaServicos
      else
        NomeImpressoraEscolhida:= parsistema.NomeImpressoraNotaMercadorias;
    end
    else
      NomeImpressoraEscolhida:= Impressora;

    Pagina  := 1;
    ProdAux := 0;
    Result  := False;

    with TextPrinter do begin
      BeginDoc(qryModelosNotasconfigurar.AsString);
      ProdPag      := ProductPerPage(qryModelosNotasconfigurar.AsString);
      ServPag      := ServicePerPage(qryModelosNotasconfigurar.AsString);
      LinhasVencto := ExpirationBandLines(qryModelosNotasconfigurar.AsString);

      if qryDadosFiscaisdesconto.AsFloat   > 0   then Inc(ProdAux);
      if qryDadosFiscaisacrescimo.AsFloat  > 0   then Inc(ProdAux);
{
      if qryDadosFiscaissimples.AsString <> 'N' then
        CalcularCreditoICMS;
}
      if qryDadosFiscaiscodigofiscal.AsInteger <> ctICMSACRESCIMOFINANCEIRO then
      begin
        if Pagina = 1 then
        begin
          GuardarRegistroAtual(qryProdutos,true);
          qryProdutos.First;
          while not qryProdutos.Eof do
          begin
            if (trim(qryModelosNotasobslegais.AsString) <> '') and
               (trim(qryProdutosobslegal.AsString) <> '') then
              Inc(ProdAux);
            if (trim(qryModelosNotasdescontoitem.AsString) <> '') and
               (qryProdutosvalordescontoitem.AsCurrency > 0) then
              Inc(ProdAux);
            qryProdutos.Next;
          end;
          VoltarRegistroAtual(qryProdutos);
        end;

        if ParSistema.UsaProdutoComposto then
          NumeroProdutos := ContarPaginasCompostos
        else
          NumeroProdutos := qryProdutos.RecordCount;

        if (NumeroProdutos + ProdAux) <= ProdPag then QtdadePag := 1
        else begin
          QtdadePag := ((NumeroProdutos + ProdAux) div ProdPag);
          if ((NumeroProdutos + ProdAux) mod ProdPag ) > 0 then
            Inc(QtdadePag)
        end;

        if (ServPag > 0) and (qryServicosDadosFiscais.RecordCount > ServPag) then begin
          PagServ := qryServicosDadosFiscais.RecordCount div ServPag;
          if (qryServicosDadosFiscais.RecordCount mod ServPag) > 0 then
            Inc(PagServ);
          if QtdadePag < PagServ then
            QtdadePag := PagServ;
        end;
      end
      else
      begin
        if qryDadosFiscaisacrescimofinanceiro.AsFloat > 0 then Inc(ProdAux);
        if qryDadosFiscaisacrescimoexcluido.AsFloat > 0 then Inc(ProdAux);
        if qryDadosFiscaisicmsexcluido.AsFloat > 0 then Inc(ProdAux);

        if (qryECFsDadosFiscais.RecordCount + ProdAux) <= ProdPag then QtdadePag := 1
        else begin
          QtdadePag := ((qryECFsDadosFiscais.RecordCount + ProdAux) div ProdPag);
          if ((qryDadosFiscais.RecordCount + ProdAux) mod ProdPag ) > 0 then
            Inc(QtdadePag)
        end;
      end;

      repeat
        if not (qryDadosFiscais.State in [dsedit]) then
          qryDadosFiscais.Edit;
        qryDadosFiscaiscfopnota.asString:= cfopNota;
        qryDadosfiscais.Post;

        BandString := qryModelosNotascabecalho.AsString;
        BreakToLine;

        if (qryModelosNotastiponotafiscal.AsString = '') then {conjugada (serviços e mercadorias ou só mercadorias}
        begin
          CFOP := qryDadosFiscaiscodigofiscal.AsInteger;
          CFPS := qryDadosFiscaiscodigofiscalservico.AsInteger;
          if (CFPS > 0) and (qryProdutos.RecordCount > 0)
          then WriteBand(qryDadosFiscais.Fields, ['X',' ',IntToStr(CFOP)+'/'+IntToStr(CFPS)])
          else WriteBand(qryDadosFiscais.Fields, ['X',' ', CFOP]);
        end
        else
        if (qryModelosNotastiponotafiscal.AsString = 'Serviços') then
          WriteBand(qryDadosFiscais.Fields);

        if qryDadosFiscaiscodigofiscal.AsInteger <> ctICMSACRESCIMOFINANCEIRO then
        begin
          Count := 1;
          BandString := qryModelosNotasvencimento.AsString;
          Columas := BandColumns;
          if (LinhasVencto * Columas) < qryVenctos.RecordCount then begin
            BandString := qryModelosNotasvenctoagrupados.AsString;
            BreakToLine;
            qryVenctoAgrupados.First;
            while Not qryVenctoAgrupados.Eof do begin
              WriteBand(qryVenctoAgrupados.Fields);
              if (Count mod Columas) = 0 then
                BreakLine(1);
              Inc(Count);
              qryVenctoAgrupados.Next;
            end
          end
          else// if ((LinhasVencto * Columas) >= qryVenctos.RecordCount) then
          begin
            BreakToLine;
            if ParSistema.VencimentosporExtensoNota then
            begin
              ValorExtenso;
              VencimentosSantaApolonia;
              WriteBand(qryDadosFiscais.Fields);
            end
            else
            begin
              qryVenctos.First;
              while not qryVenctos.Eof do
              begin
                WriteBand(qryVenctos.Fields);
                if (Count mod Columas) = 0 then
                  BreakLine(1);
                Inc(Count);
                qryVenctos.Next
              end
            end
          end {else begin
            BreakToLine;
            qryVenctos.First;
            while not qryVenctos.Eof do begin
              WriteBand(qryVenctos.Fields);
              if (Count mod Columas) = 0 then
                BreakLine(1);
              Inc(Count);
              qryVenctos.Next;
            end
          end};

          if qryProdutos.RecordCount > 0 then begin
            BandString := qryModelosNotasproduto.AsString;
            BreakToLine;
            BandProd := BandString;
            if Pagina = 1 then
              qryProdutos.First;
            Count := 0;

            while not qryProdutos.Eof do begin
              if ParSistema.UsaProdutoComposto and
                 (qryProdutoscomposto.AsBoolean and (qryProdutosdiscriminarcomposto.AsString <> 'N')) then
              begin
                ImprimirComposto;
                if Count >= ProdPag then
                  Break;
              end
              else
              begin
                WriteBand(qryProdutos.Fields);
                if (trim(qryModelosNotasobslegais.AsString) <> '') and
                   (trim(qryProdutosOBSLEGAL.AsString) <> '') then
                begin
                  BandString := qryModelosNotasobslegais.AsString;
                  BreakLine(1);
                  WriteBand(qryProdutos.Fields);
                  BandString := BandProd;
                  Inc(Count);
      //            if Count = ProdPag then
      //              Break;
                end;
                if (trim(qryModelosNotasdescontoitem.AsString) <> '') and
                   (qryProdutosvalordescontoitem.AsCurrency > 0) then
                begin
                  BandString := qryModelosNotasdescontoitem.AsString;
                  BreakLine(1);
                  WriteBand(qryProdutos.Fields);
                  BandString := BandProd;
                  Inc(Count);
                end;
                BreakLine(1);
                AddClassificacaoFiscal(qryProdutosipi.AsString, qryProdutosclassificacaofiscal.AsString);
                qryProdutos.Next;
                Inc(Count);
                if Count >= ProdPag then
                  Break;
              end;
            end;
          end else if (qryServicosDadosFiscais.RecordCount = 0) or (ServPag = 0) then begin
            BandString := qryModelosNotassemprodutos.AsString;
            BreakToLine;
            WriteBand(qryDadosFiscais.Fields);
          end;

          if Pagina = QtdadePag then begin
            if qryDadosFiscaisdesconto.AsFloat > 0 then begin
              BandString := qryModelosNotasrodapedesconto.AsString;
              WriteBand(qryDadosFiscais.Fields);
            end;
            if qryDadosFiscaisacrescimo.AsFloat > 0 then begin
              BandString := qryModelosNotasrodapeacrescimo.AsString;
              WriteBand(qryDadosFiscais.Fields);
            end;
          end;
          if (qryServicosDadosFiscais.RecordCount > 0) and
             (qryModelosNotasservico.AsString <> '') and
             (ServPag > 0)
          then begin
            BandString := qryModelosNotasservico.AsString;
            BreakToLine;
            if Pagina = 1 then
              qryServicosDadosFiscais.First;
            Count := 0;
            while Not qryServicosDadosFiscais.Eof do begin
              WriteBand(qryServicosDadosFiscais.Fields);
              BreakLine(1);
              qryServicosDadosFiscais.Next;
              Inc(Count);
              if Count = ServPag then
                Break;
            end;
          end;
        end
        else
        begin
          if (qryECFsDadosFiscais.RecordCount > 0) and
             (qryModelosNotasecf.AsString <> '') and
             (ProdPag > 0)
          then begin
            BandString := qryModelosNotasecf.AsString;
            BreakToLine;
            if Pagina = 1 then
              qryECFsDadosFiscais.First;
            Count := 0;
            while Not qryECFsDadosFiscais.Eof do begin
              WriteBand(qryECFsDadosFiscais.Fields);
              BreakLine(1);
              qryECFsDadosFiscais.Next;
              Inc(Count);
              if Count = ProdPag then
                Break;
            end;
            if Pagina = QtdadePag then
            begin
              if qryDadosFiscaisacrescimofinanceiro.AsFloat > 0 then
              begin
                BandString := qryModelosNotasacrescimofinanceiro.AsString;
                WriteBand(qryDadosFiscais.Fields);
              end;
              if qryDadosFiscaisacrescimoexcluido.AsFloat > 0 then
              begin
                BandString := qryModelosNotasacrescimoexcluido.AsString;
                WriteBand(qryDadosFiscais.Fields);
              end;
              if qryDadosFiscaisicmsexcluido.AsFloat > 0 then
              begin
                BandString := qryModelosNotasicmsexcluido.AsString;
                WriteBand(qryDadosFiscais.Fields);
              end;
            end;
          end;
        end;

        if Pagina = QtdadePag then
          BandString := qryModelosNotasrodape.AsString
        else
          BandString := qryModelosNotasrodapepagina.AsString;
        BreakToLine;
        if QtdadePag = 1 then
          WriteBand(qryDadosFiscais.Fields, ['', '', '', ''])
        else if Pagina < QtdadePag then
          WriteBand(qryDadosFiscais.Fields, [Pagina, QtdadePag])
        else
          WriteBand(qryDadosFiscais.Fields, ['Pagina', Pagina, ' de ', QtdadePag]);

        if (Pagina = QtdadePag) and (qryClassificacaoFiscal.RecordCount > 0) and
           (qryModelosNotasclassificacaofiscal.AsString <> '') then
        begin
          BandString := qryModelosNotasclassificacaofiscal.AsString;
          Columas := BandColumns;
          BreakToLine;
          qryClassificacaoFiscal.First;
          if qryClassificacaoFiscalipi.AsString = '' then
            qryClassificacaoFiscal.Delete;
          for cf:= 1 to qryClassificacaoFiscal.RecordCount do
          begin
            WriteBand(qryClassificacaoFiscal.Fields);
            if (cf mod Columas) = 0 then
              BreakLine(1);
            qryClassificacaoFiscal.Next;
            if cf = 15 then
              break;
          end;
        end;

        //GerarLinhasNotasFiscais;
{
        if qryDadosFiscaissimples.AsString <> 'N' then
          CalcularCreditoICMS;

        qryDadosFiscaisobservacoesicmssubstituido.AsString:= ObsLegais;
}
        //COLOCADO EM COMENTARIO - JR 11/08
        {if qryDadosFiscaisvalorcreditoicms.AsCurrency > 0 then
          qryDadosFiscaisobservacoesicmssubstituido.AsString:= ObsLegais + sLineBreak +
                                                               ValoresIcmsSubstituido + sLineBreak;}
{        else
          qryDadosFiscaisobservacoesicmssubstituido.AsString:= ValoresIcmsSubstituido;
}
        if (trim(qryDadosFiscaisobservacoesicmssubstituido.AsString) <> '') and
           (trim(qryModelosNotasobservacoesicms.AsString) <> '') then
        begin
          BandString := qryModelosNotasobservacoesicms.AsString;
          BreakToLine;
          WriteBand(qryDadosFiscais.Fields);
        end;

        BandString := qryModelosNotascanhoto.AsString;
        BreakToLine;
        WriteBand(qryDadosFiscais.Fields);

        FormFeed;

        {$IFNDEF LINUX}
           if Pagina < QtdadePag then
             WriteTextln('',0);
        {$ENDIF}

        Inc(Pagina);
      until Pagina > QtdadePag;
      EndDoc('TecLUX - Nota Fiscal de Saída');
    end;
  end
  else
    Result := ImprimirNotaIndustria(DadoFiscal,Impressora);
end;

function TdtmImprimeFiscal.SomatorioBaseIcms: Real;
var
  Val: Currency;
begin
  Val := 0;
  qryCalculos.First;
  while not qryCalculos.Eof do
  begin
    Val := Val + qryCalculosbase.Value;
    qryCalculos.Next;
  end;
  Result := Val;
end;

function TdtmImprimeFiscal.SomatorioValorIcms: Real;
var
  Val: Currency;
begin
  Val := 0;
  qryCalculos.First;
  while not qryCalculos.Eof do
  begin
    Val := Val + qryCalculosvalor.Value;
    qryCalculos.Next;
  end;
  Result := Val;
end;

procedure TdtmImprimeFiscal.GravarCupom(NumeroCupom, NumeroMaquina, Intervencao: Integer);
begin
  qryCupons.Open;
  qryCupons.Append;
  qryCuponsfilial.AsInteger      := FilialBase;
  qryCuponsmaquina.AsInteger     := StrToInt(ECFPadrao.NumeroMaquina);
  qryCuponsintervensao.AsInteger := StrToInt(ECFPadrao.Intervencao);
  qryCuponsnumero.AsInteger      := NumeroCupom;
  qryCuponsdadofiscal.AsInteger  := qryDadosFiscaisnumero.AsInteger;
  qryCuponsicmsestornado.Value   := False;
  qryCupons.Post;
end;

procedure TdtmImprimeFiscal.GravarDocumentosFiscais;
begin
  GravarDocumentosFiscais(0, 0, 0, [dfNOTAFISCAL]);
end;

procedure TdtmImprimeFiscal.GravarDocumentosFiscais(NumeroCupom, NumeroMaquina, Intervencao: Integer; TipoDocFiscal: TtecTipoDocFiscalSet);
begin
  if TipoDocFiscal = [dfNOTAFISCAL, CUPOMFISCAL] then begin
    qryDadosFiscais.Edit;
    qryDadosFiscaiscodigofiscal.Value := ((qryDadosFiscaiscodigofiscal.AsInteger div 1000) * 1000) + 929;
    qryDadosFiscaisnatureza.AsString  := 'EMISSAO CUPOM FISCAL-ECF';
    qryDadosFiscais.Post;
    GravarNota;
    GravarCupom(NumeroCupom, NumeroMaquina, Intervencao);
    Perpetrar([qryDadosFiscais, qryNotas, qrySeriesFiliais, qryCupons]);
  end else if TipoDocFiscal = [CUPOMFISCAL] then begin
    GravarCupom(NumeroCupom, NumeroMaquina, Intervencao);
    Perpetrar([qryCupons]);
  end else begin
    GravarNota;
    Perpetrar([qryNotas, qrySeriesFiliais]);
  end
end;

procedure TdtmImprimeFiscal.GravarNota;
begin
  ReFazConsulta(qrynotas, [0], [qryDadosFiscaisNumero.asinteger]);
  qryNotas.Append;
  qryNotasfilial.Value := FilialBase;
  qryNotasserie.Value := SerieSugestao;
  qryNotasnumero.Value := qrySeriesFiliaisnumeroinicial.AsInteger;
  qryNotasdadofiscal.Value := qryDadosFiscaisnumero.AsInteger;
  qryNotas.Post;
  qrySeriesFiliais.Edit;
  qrySeriesFiliaisnumeroinicial.AsInteger := qrySeriesFiliaisnumeroinicial.AsInteger + 1;
  qrySeriesFiliais.Post;
  if qrySeriesFiliaisnumeroinicial.AsInteger >= qrySeriesFiliaisnumerofinal.AsInteger then
    MensagemAviso(ctSERIEESGOTADA)
end;

function TdtmImprimeFiscal.ObterNumeroNota: Integer;
begin
  Result := 0;
  ReFazConsulta(qrySeriesFiliais, [0], [FilialBase]);
  qrySeriesFiliais.First;
  while not qrySeriesFiliais.Eof do
    if qrySeriesFiliaisnumeroinicial.Value < qrySeriesFiliaisnumerofinal.Value then
    begin
      Result := qrySeriesFiliaisnumeroinicial.Value;
      qrySeriesFiliais.Edit;
