function TdtmImprimeFiscal.ObsLegais: String;
var TemNormal, TemSubst : Boolean;
begin
  Result := '';
  TemNormal:= False;
  TemSubst:= False;
  if ((qryDadosFiscaisaliquotacreditoicms.IsNull) or
      (qryDadosFiscaisaliquotacreditoicms.AsCurrency = 0)) then
  begin
    RefazConsultaPorNome(qryProcuraFilial,['codigo'],[qryDadosFiscaisfilialvenda.AsVariant]);
    if not (qryDadosFiscais.State in [dsinsert,dsedit]) then
      qryDadosFiscais.Edit;
    qryDadosFiscaisvalorcreditoicms.AsFloat:= qryProcuraFilialcreditoicms.AsFloat;
  end;

  RefazConsultaPorNome(qryCodigosFiscais,['dadofiscal'],[qryDadosFiscaisnumero.AsVariant]);

  if qryCodigosFiscais.RecordCount = 1 then
  begin
    if ((qryCodigosFiscaiscodigofiscal.AsInteger = 5102) or
       (qryCodigosFiscaiscodigofiscal.AsInteger = 6102)) then
    begin
      if qryDadosFiscaisvalorcreditoicms.AsCurrency > 0 then
        Result:= 'PERMITE O APROVEITAMENTO DO CREDITO DE ICMS NO VALOR DE R$ '+floattostr(qryDadosFiscaisvalorcreditoicms.AsFloat)+#10+
                 'CORRESPONDENTE A ALIQUOTA DE '+floattostr(qryDadosFiscaisaliquotacreditoicms.AsFloat)+'%, NOS TERMOS DO ART. 23 DA LC 123.';
    end
    else if ((qryCodigosFiscaiscodigofiscal.AsInteger = 5405) or
             (qryCodigosFiscaiscodigofiscal.AsInteger = 6404)) then
    begin
      if qryDadosFiscaiscontribicms.AsBoolean then
        Result:= 'Imposto Retido anteriormente por Subst. Tribut. - (RICMS-SC/01, Anexo 3, art. 29).' + sLineBreak + ValoresIcmsSubstituido;
    end
    else
      Result:= '';
  end
  else if qryCodigosFiscais.RecordCount > 1 then
  begin
    qryCodigosFiscais.First;
    while not qryCodigosFiscais.Eof do
    begin
      if ((qryCodigosFiscaiscodigofiscal.AsInteger = 5102) or
          (qryCodigosFiscaiscodigofiscal.AsInteger = 6102)) then
        TemNormal:= True
      else if ((qryCodigosFiscaiscodigofiscal.AsInteger = 5405) or
            (qryCodigosFiscaiscodigofiscal.AsInteger = 6404)) then
        TemSubst:= True;

      qryCodigosFiscais.Next;
    end;

    if (TemNormal and TemSubst) then
    begin
      if qryDadosFiscaiscontribicms.AsBoolean then
      begin
        Result:= 'Imposto Retido anteriormente por Subst. Tribut. - (RICMS-SC/01, Anexo 3, art. 29).' + ValoresIcmsSubstituido;
        if qryDadosFiscaisvalorcreditoicms.AsCurrency > 0 then
          Result := Result + sLineBreak +
                   'PERMITE O APROVEITAMENTO DO CREDITO DE ICMS NO VALOR DE R$ '+floattostr(qryDadosFiscaisvalorcreditoicms.AsFloat)+#10+
                   'CORRESPONDENTE A ALIQUOTA DE '+floattostr(qryDadosFiscaisaliquotacreditoicms.AsFloat)+'%, NOS TERMOS DO ART. 23 DA LC 123.'
      end
      else if qryDadosFiscaisvalorcreditoicms.AsCurrency > 0 then
        Result:= 'PERMITE O APROVEITAMENTO DO CREDITO DE ICMS NO VALOR DE R$ '+floattostr(qryDadosFiscaisvalorcreditoicms.AsFloat)+#10+
                 'CORRESPONDENTE A ALIQUOTA DE '+floattostr(qryDadosFiscaisaliquotacreditoicms.AsFloat)+'%, NOS TERMOS DO ART. 23 DA LC 123.';
    end
    else
      Result:= '';
  end;
  Result:= Result;
end;

function TdtmImprimeFiscal.ValoresIcmsSubstituido: String;
var
  FreteRateado,
  SeguroRateado,
  DescontoRateado,
  Preco,
  ValorICMS,
  ValorICMSSubstituido,
  TotalBaseIcmsProprio,
  TotalBaseSubstituido,
  TotalValorICMSProprio,
  TotalIcmsSubstituido,
  AliquotaICMSProprio : Real;
  Pos: TBookmark;
begin
  TotalBaseIcmsProprio := 0;
  TotalBaseSubstituido := 0;
  TotalValorICMSProprio:= 0;
  TotalIcmsSubstituido := 0;
  qryProdutos.DisableControls;
  Pos:= qryProdutos.GetBookmark;
  qryProdutos.First;
  while not qryProdutos.Eof do
  begin
    if (qryProdutosincidencia.AsString = ctCOBRADOSUSTITUICAO) and
       (qryProdutosipi.AsInteger <> 0) and
       (qryProdutosfatorsubstituicao.AsFloat <> 0) then
    begin
      if qryDadosFiscaisestado.AsString = EstadoFilialBase then
        AliquotaICMSProprio := ParSistema.ICMSaDestacarDentroEstado
      else
        AliquotaICMSProprio := ParSistema.ICMSaDestacarForaEstado;

      Preco                 := qryProdutosprecovenda.AsFloat * qryProdutosquantidade.AsCurrency - qryProdutosvalordescontoitem.AsCurrency;
      FreteRateado          := Preco * qryProdutosfrete.AsFloat / qryDadosFiscaisvalortotal.AsCurrency;
      SeguroRateado         := Preco * qryProdutosseguro.AsFloat / qryDadosFiscaisvalortotal.AsCurrency;
      DescontoRateado       := Preco * qryProdutosdesconto.AsFloat / qryDadosFiscaisvalortotal.AsCurrency;
      Preco                 := Preco + FreteRateado + SeguroRateado - DescontoRateado;
      TotalBaseIcmsProprio  := TotalBaseIcmsProprio + Preco;
      ValorICMS             := Preco * AliquotaICMSProprio;
      TotalValorICMSProprio := TotalValorICMSProprio + ValorICMS;
      ValorICMSSubstituido  := (Preco / (1 + ParSistema.MarkupSubstituicao / 100)) * qryProdutosfatorsubstituicao.AsFloat;
      TotalBaseSubstituido  := TotalBaseSubstituido + ValorICMSSubstituido;
      TotalIcmsSubstituido  := TotalIcmsSubstituido + (ValorICMSSubstituido * ParSistema.ICMSaDestacarDentroEstado) - ValorICMS;
    end;
    qryProdutos.Next;
  end;
  if (TotalBaseSubstituido > 0) and
     (TotalIcmsSubstituido > 0) then
    Result := '***Base ICMS Subst. = ' + FloatToStrF(TotalBaseSubstituido,ffFixed,18,2) +
              ' ***Valor ICMS Subst. = ' + FloatToStrF(TotalIcmsSubstituido,ffFixed,18,2)
  else
    Result := '';
  qryProdutos.GotoBookmark(Pos);
  qryProdutos.FreeBookmark(Pos);
  qryProdutos.EnableControls;
end;
}

procedure TdtmImprimeFiscal.ImprimirNotaPromissoria(Dadofiscal: Integer;ImprimirAvista:Boolean);
var
Relatorio: TStringList;
Colunas: Integer;
LinhaE: T_Extenso;
Linha,Extenso1, Extenso2: String;

begin

  ReFazConsulta(qryDadosFiscais, [1], [DadoFiscal]);

  if (qryDadosFiscais.RecordCount=1)
     and (qryDadosfiscaissituacao.asstring='N')
     and (not (qryDadosFiscaisavista.AsBoolean) or (ImprimirAVista))
     and assigned(EcfPadrao) then
  begin
    RefazConsulta(qryProdutos,[0,1,2],[qryDadosFiscaiscliente.AsInteger,qryDadosFiscaistipocliente.AsString,DadoFiscal]);
    RefazConsulta(qryServicosDadosFiscais,[0],[DadoFiscal]);
    RefazConsulta(qryVenctos,[0],[DadoFiscal]);
    RefazConsulta(qryVenctoAgrupados,[0],[DadoFiscal]);
    ReFazConsulta(qryFornecedor, [0], [DadoFiscal]);
    ReFazConsulta(qryDadosCupom,[0],[DadoFiscal]);
    Relatorio := TStringList.Create;
    Colunas := ECFPadrao.Colunas;
    LinhaE.ExtTamLinha[1]:= 130;
//    LinhaE.ExtTamLinha[2]:= Colunas;

    Extenso(qryDadosFiscaisvalortotal.AsFloat,$92,'','','','',' ', LinhaE);
    Extenso1:= LinhaE.ExtLinha[1];
    //Extenso2:= LinhaE.ExtLinha[2];


    try
        Relatorio.Append(Centralizar('-----------NOTA PROMISSÓRIA-----------',Colunas));
        Relatorio.Append('');

        Relatorio.Append('Pagarei por esta Nota Promissória a');
        Relatorio.Append(RazaoFilialBase + ' '+ CNPJFilialBase);
        Relatorio.Append('Ou a sua ordem na cidade de '+CidadeFilialBase+' a');
        Relatorio.Append('quantia de R$ '+FormatFloat('#0,' + ThousandSeparator + '00', qryDadosFiscaisvalortotal.AsCurrency)+'('+trim(Extenso1)+')');
        Relatorio.Append(' em moeda corrente do país.');
        Relatorio.Append('Referente ao cupom fiscal CCF: '+ qryDadosCupomccf.asString + '/ COO: '+qryDadosCupomcoo.AsString);
        Relatorio.Append('Título No: '+qryDadosFiscaiscontrato.AsString +' de acordo com as respectivas');
        Relatorio.Append('parcelas que seguem:');
        Relatorio.Append('');

        qryVenctos.First;
        while not qryVenctos.Eof do
        begin
          Relatorio.Append(Centralizar('Parcela ' + qryVenctosnumero.AsString+ '     Valor: '+  FormatFloat('#0,' + ThousandSeparator + '00', qryVenctosvalorvencto.AsCurrency) + '    Venc: '+qryVenctosdatavencto.AsString,Colunas));
          qryVenctos.Next;
        end;
        Relatorio.Append('');
        Relatorio.Append('');
        Relatorio.Append(Centralizar('---------PRODUTOS DA NOTA-------------',Colunas));
        Relatorio.Append('Cod.   Descrição Qtde Preço Desc Total');
        qryProdutos.First;
        while not qryProdutos.Eof do
        begin;
          Relatorio.Append(qryProdutoscodigovisual.AsString+'   '+qryProdutosdescricaoproduto.AsString +'   ' +qryProdutosquantidade.AsString+'   ' + FormatFloat('#0,' + ThousandSeparator + '00', qryProdutosprecovenda.AsCurrency) + '   ' + qryProdutosdesconto.AsString + '   ' + FormatFloat('#0,' + ThousandSeparator + '00', qryProdutosprecototal.AsCurrency));
          qryProdutos.Next;
        end;

        Relatorio.Append('');
        Relatorio.Append('');
        Relatorio.Append('Vendedor(a): '+qryDadosFiscaisnomevendedor.AsString);

        Relatorio.Append('');
        Relatorio.Append('');
        Linha := stringOfChar('_',Colunas-20);
        Relatorio.Append(Centralizar(Linha,Colunas));
        Relatorio.Append(Centralizar(qryDadosFiscaiscliente.AsString+ ' - ' + qryDadosFiscaisnome.AsString,Colunas));
        Relatorio.Append(Centralizar('Cpf/Cnpj: '+qryDadosFiscaispessoanumero.AsString,Colunas));
        Relatorio.Append('');
        try
          ECFPadrao.RelatorioGerencial(Relatorio,2);
        except
              //
        end;
    finally
      Relatorio.Free;
    end;
  end;
end;

function TdtmImprimeFiscal.ImprimirNotaFiscalServico(DadoFiscal: integer;
       NomedoArq: String): boolean;
var
  PV: TfrxComponent;
       
begin

  result := true;
  try
    ObterComplementosDadosFiscais(DadoFiscal, 0, false);
    qryDadosFiscaisCalcFields(qryDadosFiscais);

//    ReFazConsulta(qryDadosFiscais, [1], [DadoFiscal]);
//    RefazConsulta(qryServicosDadosFiscais,[0],[DadoFiscal]);
//    ReFazConsulta(qrynotas, [0], [DadoFiscal]);

  //  RefazConsulta(qryVenctos,[0],[DadoFiscal]);
  //  RefazConsulta(qryVenctoAgrupados,[0],[DadoFiscal]);
  //  ReFazConsulta(qryFornecedor, [0], [DadoFiscal]);

    frxPDFExport1.DefaultPath := extractfilepath(NomedoArq);
    frxPDFExport1.FileName := trocar(NomedoArq,'.xml', '.pdf');
//    frxNotasServico.DesignReport;
    frxNotasServico.PrepareReport(true);

    if FileExists(LogotipoFilialBase) then
    begin
      PV := frxNotasServico.FindObject('fpvLogo');
      if (PV is TfrxPictureView) then
        TfrxPictureView(PV).picture.LoadFromFile(LogotipoFilialBase);
    end;

//    frxNotasServico.DesignReport();


    if fNFeVisualizarDANFE then
      frxNotasServico.ShowReport(true);

    if FileExists(NomedoArq) then
      frxNotasServico.Export(frxPDFExport1)
    else
      MensagemAviso('O arquivo ' + NomedoArq + ' não existe!');

  except
    result := false;
  end;

end;

