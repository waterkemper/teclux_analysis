procedure TdtmImprimeFiscal.AddClassificacaoFiscal(IPI, CF: String);
var
  Listado: Boolean;
begin
  if trim(IPI) <> '' then
  begin
    Listado := False;
    if not qryClassificacaoFiscal.Active then
      qryClassificacaoFiscal.Open;

    qryClassificacaoFiscal.First;
    while not qryClassificacaoFiscal.Eof do
    begin
      if qryClassificacaoFiscalIPI.AsString = IPI then
      begin
        Listado := True;
        break;
      end;
      qryClassificacaoFiscal.Next;
    end;
    if not Listado then
    begin
      qryClassificacaoFiscal.Append;
      qryClassificacaoFiscalIPI.AsString := IPI;
      qryClassificacaoFiscalCF.AsString  := CF;
      qryClassificacaoFiscal.Post;
    end;
  end;
end;

function TdtmImprimeFiscal.ImprimirNotaIndustria(DadoFiscal: Integer; Impressora: String = ''): Boolean;
var
  Count,        Columas,   ProdPag,   ProdAux, Pagina,
  LinhasVencto, QtdadePag, NumeroProdutos, cf{, pedidoanterior,LinhasObs}: Integer;
  BandProd{, ObsFormatada} : String;

begin
  if Impressora = '' then NomeImpressoraEscolhida:= parsistema.NomeImpressoraNotaMercadorias
                     else NomeImpressoraEscolhida:= Impressora;
//  pedidoanterior := 0;
  Pagina  := 1;
  ProdAux := 0;
  Result  := False;
  ObterComplementosDadosFiscais(DadoFiscal, ModeloNota, True);

{  TextPrinter.BandString := qryModelosNotasobscorponota.AsString;
  qryDadosFiscais.Edit;
  if Trim(qryDadosFiscaisobscliente.AsString) <> '' then
    qryDadosFiscaisobscorponota.AsString := qryDadosFiscaisobscliente.AsString;
  if qryDadosFiscaissubstituicaoipi.AsBoolean and
     (trim(qryDadosFiscaisobsclienteipisuspenso.AsString) <> '') then
    qryDadosFiscaisobscorponota.AsString := qryDadosFiscaisobscorponota.AsString + sLineBreak +
                                            qryDadosFiscaisobsclienteipisuspenso.AsString;
  if (qrydadosfiscaisdadofiscalcomplementar.asinteger<>0) and
     (trim(qryDadosFiscaisobservacoescomplementar.AsString) <> '') then
    qryDadosFiscaisobscorponota.AsString := qryDadosFiscaisobscorponota.AsString + sLineBreak +
                                            qryDadosFiscaisobservacoescomplementar.AsString;
  qryDadosFiscais.Post;

  ObsFormatada := TextPrinter.WriteBand(qryDadosFiscais.Fields,[], False);

  LinhasObs := PosOcor(sLineBreak,ObsFormatada,0) + 2;
}
  with TextPrinter do begin
    BeginDoc(qryModelosNotasconfigurar.AsString) ;
    ProdPag      := ProductPerPage(qryModelosNotasconfigurar.AsString);
    LinhasVencto := ExpirationBandLines(qryModelosNotasconfigurar.AsString);

    if qryDadosFiscaisdesconto.AsFloat   > 0   then Inc(ProdAux);
    if qryDadosFiscaisacrescimo.AsFloat  > 0   then Inc(ProdAux);

    if Pagina = 1 then
    begin
      GuardarRegistroAtual(qryProdutos,true);
      qryProdutos.First;
      while not qryProdutos.Eof do
      begin
        if (trim(qryModelosNotasobslegais.AsString) <> '') and
           (trim(qryProdutosobslegal.AsString) <> '') then
          Inc(ProdAux);
{
        if qryProdutospedidosaida.AsInteger <> pedidoanterior then
        begin
          Inc(ProdAux);
          pedidoanterior := qryProdutospedidosaida.AsInteger;
        end;
        if qryProdutosproduto_cliente.AsString <> '' then
          Inc(ProdAux);
}
        qryProdutos.Next;
      end;
      VoltarRegistroAtual(qryProdutos);
    end;

//    pedidoanterior := 0;
    NumeroProdutos := qryProdutos.RecordCount;
    if (NumeroProdutos + ProdAux{ + LinhasObs}) <= ProdPag then
      QtdadePag := 1
    else begin
      QtdadePag := ((NumeroProdutos + ProdAux{ + LinhasObs}) div ProdPag);
      if ((NumeroProdutos + ProdAux{ + LinhasObs}) mod ProdPag ) > 0 then
        Inc(QtdadePag)
    end;

    repeat
      // IMPRIMIR CABEÇALHO
      BandString := qryModelosNotascabecalho.AsString;
      BreakToLine;
      WriteBand(qryDadosFiscais.Fields, ['X',' ', qryDadosFiscaiscodigofiscal.AsInteger]);
      // IMPRIMIR VENCTOS
      BandString := qryModelosNotasvencimento.AsString;
      Columas := BandColumns;
      Count := 1;
      if (LinhasVencto * Columas) < qryVenctos.RecordCount then begin
        BandString := qryModelosNotasvenctoagrupados.AsString;
        Columas := BandColumns;
        BreakToLine;
        qryVenctoAgrupados.First;
        while Not qryVenctoAgrupados.Eof do begin
          WriteBand(qryVenctoAgrupados.Fields);
          if (Count mod Columas) = 0 then
            BreakLine(1);
          Inc(Count);
          qryVenctoAgrupados.Next;
        end
      end
      else
      begin
        BandString := qryModelosNotasvencimento.AsString;
        BreakToLine;
        VencimentosSantaApolonia;
        WriteBand(qryDadosFiscais.Fields);
      end;
      if qryProdutos.RecordCount > 0 then
      begin
        BandString := qryModelosNotasproduto.AsString;
        BreakToLine;
        BandProd := BandString;
        if Pagina = 1 then
          qryProdutos.First;
        Count := 0;
{
        if Trim(qryModelosNotastituloproduto.AsString) <> '' then
        begin
          BandString := qryModelosNotastituloproduto.AsString;
          WriteBand([]);
          BandString := BandProd;
          Inc(Count);
        end;
}
        while not qryProdutos.Eof do
        begin
          if not (qryProdutosproduto.IsNull  and    //CASO TENHA PRODUTO, IMPRIME PRODUTO E NAO FOI GERADO LINHA DE TEXTO
             (qryProdutosproduto_cliente.AsString = '')) then
          begin
            if (trim(qryProdutosproduto_cliente.AsString) <> '') then
            begin
              BandString := qryModelosNotasprodutocliente.AsString;
              BreakLine(1);
              WriteBand(qryProdutos.Fields);
              Inc(Count);
            end
            else
            begin
              BandString := BandProd;
              BreakLine(1);
              WriteBand(qryProdutos.Fields);
              Inc(Count);
            end;
            if (trim(qryModelosNotasobslegais.AsString) <> '') and
               (trim(qryProdutosOBSLEGAL.AsString) <> '') then
            begin
              BandString := qryModelosNotasobslegais.AsString;
              BreakLine(1);
              WriteBand(qryProdutos.Fields);
              Inc(Count);
            end;
            AddClassificacaoFiscal(qryProdutosipi.AsString, qryProdutosclassificacaofiscal.AsString);
          end
          else  // IMPRIME LINHA DE TEXTO
          begin
            BandString := qryModelosNotastexto.AsString;
            BreakLine(1);
            WriteBand(qryProdutos.Fields);
            Inc(Count);
          end;

          qryProdutos.Next;

          if Count{ + 3} >= ProdPag then
            Break;
        end;
      end;
{      // IMPRIME AS OBSERVACOES NO CORPO DA NOTA
      if (Pagina = QtdadePag) and
         (Trim(qryDadosFiscaisobscorponota.AsString) <> '') then
      begin
        BandString := qryModelosNotasobscorponota.AsString;
        BreakLine(1);
        WriteBand(qryDadosFiscais.Fields);
      end;
}
      if Pagina = QtdadePag then
        BandString := qryModelosNotasrodape.AsString
      else
        BandString := qryModelosNotasrodapepagina.AsString;
      BreakToLine;
      if QtdadePag = 1 then
        WriteBand(qryDadosFiscais.Fields, ['', '', '', ''])
      else if Pagina < QtdadePag then
        WriteBand(qryDadosFiscais.Fields, [Pagina, QtdadePag])
      else
        WriteBand(qryDadosFiscais.Fields, ['Pagina', Pagina, ' de ', QtdadePag]);

      if (Pagina = QtdadePag) and (qryClassificacaoFiscal.RecordCount > 0) and
         (qryModelosNotasclassificacaofiscal.AsString <> '') then
      begin
        BandString := qryModelosNotasclassificacaofiscal.AsString;
        Columas := BandColumns;
        BreakToLine;
        qryClassificacaoFiscal.First;
        if qryClassificacaoFiscalipi.AsString = '' then
          qryClassificacaoFiscal.Delete;
        for cf := 1 to qryClassificacaoFiscal.RecordCount do
        begin
          WriteBand(qryClassificacaoFiscal.Fields);
          if (cf mod Columas) = 0 then
            BreakLine(1);
          qryClassificacaoFiscal.Next;
          if cf = 15 then
            break;
        end;
      end;

      if (Pagina = QtdadePag) and
         (Trim(qryDadosFiscaisobservacoes.AsString) <> '') and
         (qryModelosNotasobservacoes.AsString <> '') then
      begin
        BandString := qryModelosNotasobservacoes.AsString;
        BreakToLine;
        WriteBand(qryDadosFiscais.Fields);
      end;

      BandString := qryModelosNotascanhoto.AsString;
      BreakToLine;
      WriteBand(qryDadosFiscais.Fields);

      FormFeed;

      {$IFNDEF LINUX}
         if Pagina < QtdadePag then
           WriteTextln('',0);
      {$ENDIF}

      Inc(Pagina);
    until Pagina > QtdadePag;
    EndDoc('TecLUX - Nota Fiscal de Saída');
  end;
end;

