{
procedure TdtmImprimeFiscal.CalcularCreditoICMS;
var
//  pos: TBookmark;
  TotalProdutoscomSubst, ProdutosSemSubs: Currency;
Begin
  try
  begin
    TotalProdutoscomSubst:= 0;
    ProdutosSemSubs:= 0;
    GuardarRegistroAtual(qryProdutos,true);

    qryProdutos.First;
    while not qryProdutos.Eof do
    begin
      if (qryProdutoscodigofiscal.asInteger = 5405) or
         (qryProdutoscodigofiscal.asInteger = 6404) then
        TotalProdutoscomSubst:= TotalProdutoscomSubst + (qryProdutosprecovenda.AsFloat*
                                                           qryProdutosquantidade.AsFloat)
        else
          ProdutosSemSubs:= ProdutosSemSubs +(qryProdutosprecovenda.AsFloat*
                                              qryProdutosquantidade.AsFloat);
        qryProdutos.Next;
      end;

    if not (qryDadosFiscais.State in [dsinsert,dsedit]) then
      qryDadosFiscais.Edit;

    CreditoICMS:= ProdutosSemSubs*(qryDadosFiscaisaliquotacreditoicms.AsCurrency/100);

    qryDadosFiscaisvalorcreditoicms.AsCurrency:= Truncar(CreditoICMS,2);
    qryDadosFiscais.Post;
    Perpetrar([qryDadosFiscais]);
  end
  finally
   VoltarRegistroAtual(qryProdutos);
  end;
end;

