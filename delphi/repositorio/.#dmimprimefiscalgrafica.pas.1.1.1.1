begin
  fNota.Free;
  inherited Destroy;
end;

procedure TdtmImprimeFiscalGrafica.ImprimirNota;
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
  i: Integer;
begin
  frVariables['Titulo'] := 'Espelho Nota Fiscal';
  with fNota do
  begin
// CABEÇALHO
    if Tipo = nfSAIDA then
      frVariables['TipoNota'] := '0'
    else
      frVariables['TipoNota'] := '1';
    frVariables['NumeroNota']     := Numero;
    frVariables['SerieNota']      := Serie;
    frVariables['Natureza']       := NaturezaDescricao;
    frVariables['CodigoFiscal']   := CodigoFiscal;
    frVariables['CNPJ']           := FormatarCPFouCGC(CNPJ);
    frVariables['InscEstadual']   := IE;
    frVariables['InscEstadualST'] := IEST;
    frVariables['DataEmissao']    := Data;
    frVariables['DataSaida']      := DataSaida;
    frVariables['HoraSaida']      := '';
    frVariables['codigovendedor'] := codigovendedor;
    frVariables['nomevendedor'] := nomevendedor;

  end;
// DESTINATARIO
  with fNota.Cliente do
  begin
    frVariables['DestCNPJ']      := FormatarCPFouCGC(CNPJ);
    frVariables['DestIE']        := IE;
    frVariables['DestNome']      := Nome;
    frVariables['DestEndereco']  := Rua + ', ' + IntToStr(Numero) + ' - ' + Complemento;
    frVariables['DestBairro']    := NomeBairro;
    frVariables['DestCEP']       := FormatarCEP(IntToStr(CEP));
    frVariables['DestMunicipio'] := NomeCidade;
    frVariables['DestUF']        := Estado;
    frVariables['DestFone']      := FormatarFone(IntToStr(FoneDDD),IntToStr(FoneNumero));
  end;
// VENCTOS
  qryVenctos.Open;
  qryVenctos.Delete;
  for i := 0 to fNota.Venctos.Count -1 do
    with fNota.Venctos[i] do
      qryVenctos.AppendRecord([Numero,Data,Valor]);
// TOTAIS
  with fNota.Totais do
  begin
    frVariables['ValorIPI']    := IPI;
    frVariables['BaseICMS']    := ICMSBase;
    frVariables['ValorICMS']   := ICMS;
    frVariables['BaseICMSST']  := ICMSSTBase;
    frVariables['ValorICMSST'] := ICMSST;
    frVariables['ValorFrete']  := Frete;
    frVariables['ValorSeguro'] := Seguro;
    frVariables['ValorDesconto'] := Desconto;
    frVariables['ValorDespesas'] := DespesasAcessorias;
    frVariables['ValorProdutos'] := Produtos;
    frVariables['ValorNota']     := Prazo;
  end;
// TRANSPORTE
  if fNota.TipoFrete = tfEmitente then
    frVariables['TipoFrete'] := 1
  else
    frVariables['TipoFrete'] := 2;
  with fNota.Transporte do
  begin
    frVariables['TransCNPJ']        := FormatarCPFouCGC(CNPJ);
    frVariables['TransIE']          := IE;
    frVariables['TransNome']        := Nome;
    frVariables['TransEndereco']    := Rua;
    frVariables['TransMunicipio']   := NomeCidade;
    frVariables['TransUF']          := Estado;
    frVariables['TransPlaca']       := Placa;
    frVariables['TransPlacaUF']     := EstadoPlaca;
    frVariables['TransQuantidade']  := Quantidade;
    frVariables['TransEspecie']     := Especie;
    frVariables['TransMarca']       := Marca;
    frVariables['TransNumero']      := Numero;
    frVariables['TransPesoBruto']   := PesoBruto;
    frVariables['TransPesoLiquido'] := PesoLiquido;
  end;
// PRODUTOS
  qryProdutos.Open;
  qryProdutos.Delete;
  for i := 0 to fNota.Produtos.Count -1 do
    with fNota.Produtos[i] do
    begin
      qryProdutos.Append;
      qryProdutosCodigoVisual.AsString        := CodigoVisual;
      qryProdutosDescricao.AsString           := Descricao;
      qryProdutosreferencia.AsString          := Referencia;
      qryProdutosClassificacaoFiscal.AsString := ClassificacaoFiscal;
      qryProdutosOrigem.AsString              := Origem;
      qryProdutosIncidencia.AsString          := Incidencia;
      qryProdutosCodigoFiscal.AsInteger       := CodigoFiscal;
      qryProdutosUnidade.AsString             := Unidade;
      qryProdutosQuantidade.AsFloat           := Quantidade;
      qryProdutosPrecoUnitario.AsFloat        := PrecoUnitario;
      qryProdutosPrecoTotal.AsFloat           := PrecoTotal;
      qryProdutosBaseCalculoICMS.AsFloat      := BaseCalculoICMS;
      qryProdutosValorICMS.AsFloat            := ValorICMS;
      qryProdutosValorIPI.AsFloat             := ValorIPI;
      qryProdutosAliquotaICMS.AsFloat         := AliquotaICMS;
      qryProdutosAliquotaIPI.AsFloat          := AliquotaIPI;
      qryProdutos.Post;
    end;
// DADOS ADICIONAIS
  frVariables['InfComplementares'] := fNota.InfComplementares;

//  frNota.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);
  frmPreview.cmbZoom.ItemIndex := 3;

  try
    with frmPreview do
    begin
      Relatorio := frmPreview.frCompositeReport;
      frCompositeReport.Reports.Clear;
      frCompositeReport.DoublePass := true;
      frCompositeReport.Reports.Add(frNota);
      Relatorio.Preview := frPreviewPadrao;
      Relatorio.ShowReport;
      ShowModal;
    end;
  finally
    frmPreview.Free;
  end;
end;

end.
