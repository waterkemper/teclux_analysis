implementation

uses
  biblio;
{$R *.dfm}

{ TNota }


{ TProdutos }

function TProdutos.Add: TProduto;
begin
  Result := TProduto(inherited Add);
end;

constructor TProdutos.Create(AOwner: TNota);
begin
  inherited Create(TProduto);
end;

function TProdutos.GetItem(Index: Integer): TProduto;
begin
  Result := TProduto(inherited GetItem(Index));
end;

procedure TProdutos.SetItem(Index: Integer;
  Value: TProduto);
begin
  inherited SetItem(Index, Value);
end;

{ TNota }

constructor TNota.Create;
begin
  fCliente       := TCliente.Create;
  fTotais        := TTotais.Create;
  fTransporte    := TTransporte.Create;
  fLocalRetirada := TLocalRetirada.Create;
  fLocalEntrega  := TLocalEntrega.Create;
  fExportacao    := TExportacao.Create;
  fProdutos      := TProdutos.Create(Self);
  fServicos      := TServicos.Create(Self);
  fVenctos       := TVenctos.Create(Self);
end;

destructor TNota.Destroy;
begin
  fCliente.Free;
  fTotais.Free;
