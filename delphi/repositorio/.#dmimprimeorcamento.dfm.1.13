  object qryParcelasPlanosOrcamentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select ppo.plano,'
      '           ppo.data,'
      '           ppo.valor,'
      '           p.descricao,'
      '           (Select pp.desconto From planosorcamentos pp '
      
        '                                            Where pp.plano = ppo' +
        '.plano and pp.orcamento = ppo.orcamento) as desconto,'
      '           (Select pp.valorvista From planosorcamentos pp '
      
        '                                            Where pp.plano = ppo' +
        '.plano and pp.orcamento = ppo.orcamento) as valorvista'
      'From   parcelasplanosorcamentos ppo, planos p'
      'Where (ppo.orcamento =:orcamento) and'
      '           (ppo.plano = p.codigo)  '
      'order by ppo.plano,ppo.data')
    RequestLive = False
    Left = 114
    Top = 206
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'orcamento'
        ParamType = ptUnknown
      end>
    object qryParcelasPlanosOrcamentosdata: TDateField
      Alignment = taCenter
      FieldName = 'data'
      EditMask = '99/99/9999;1; '
    end
    object qryParcelasPlanosOrcamentosvalor: TFloatField
      FieldName = 'valor'
      DisplayFormat = '0.00'
    end
    object qryParcelasPlanosOrcamentosdescricao: TStringField
      DisplayWidth = 50
      FieldName = 'descricao'
      Size = 100
    end
    object qryParcelasPlanosOrcamentosplano: TIntegerField
      FieldName = 'plano'
      DisplayFormat = '0'
    end
    object qryParcelasPlanosOrcamentosdesconto: TFloatField
      FieldName = 'desconto'
      DisplayFormat = '0.00'
    end
    object qryParcelasPlanosOrcamentosvalorvista: TFloatField
      FieldName = 'valorvista'
      DisplayFormat = '0.00'
    end
  end
