  object qryProdutosOrcamentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryProdutosOrcamentosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select po.produto,'
      '           po.filial,'
      '           po.quantidade,'
      '           po.precovenda,'
      '           (po.quantidade * po.precovenda) as total,'
      '           po.vendido,'
      '           po.previsao,'
      '           p.descricao,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           case when :VisualizarSituacaoProdutos then'
      
        '             produtosorcamentos_situacao(po.orcamento, po.produt' +
        'o, po.filial, o.situacao)'
      
        '           else cast(null as varchar(1)) end as situacao_produto' +
        ','
      
        '           case when c.emitecomplemento then c.complemento else ' +
        'cast(null as varchar(1000)) end as complemento,'
      '           c.anvisa'
      ''
      ''
      
        'From   orcamentos o, produtosorcamentos po, produtos p, caracter' +
        'isticas c'
      'Where o.codigo = po.orcamento'
      '  and po.produto = p.codigo'
      '  and p.caracteristica = c.codigo'
      '  and o.codigo = :codigo')
    RequestLive = False
    Left = 114
    Top = 86
    ParamData = <
      item
        DataType = ftString
        Name = 'VisualizarSituacaoProdutos'
        ParamType = ptUnknown
        Value = 'false'
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    object qryProdutosOrcamentosproduto: TLargeintField
      FieldName = 'produto'
      Required = True
    end
    object qryProdutosOrcamentosfilial: TIntegerField
