    Sql.Strings = (
      'Select o.codigo,'
      '           o.cliente,'
      '           o.nome,'
      '           o.emissao,'
      '           o.validade,'
      '           o.frete,'
      '           o.seguro,'
      
        '           (Select sum(po.quantidade * po.precovenda) From produ' +
        'tosorcamentos po Where po.orcamento = o.codigo) as totalprodutos' +
        ','
      
        '           (Select sum(so.quantidade * so.valorservico) From ser' +
        'vicosorcamentos so Where so.orcamento = o.codigo) as totalservic' +
        'os,'
      
        '           formatar_fone_fax(o.foneddd, o.fonenumero, o.fonerama' +
        'l) as fone,'
      
        '           formatar_fone_fax(o.fone2ddd, o.fone2numero, o.fone2r' +
        'amal) as fone2,'
      '           o.rua,'
      
        '           (Select b.nome From bairros b Where b.estado = o.esta' +
        'do and b.cidade = o.cidade and b.codigo = o.bairro) as nomebairr' +
        'o,'
      
        '           (Select c.nome From cidades c Where c.estado = o.esta' +
        'do and c.codigo = o.cidade) as nomecidade,'
      '           o.estado,'
      '           o.cep,'
      '           o.observacao, o.contrato,'
      
        '           (Select u.nome From usuarios u Where u.codigo = o.ven' +
        'dedor) as nomevendedor'
      'From   orcamentos o'
      'Where '
      'false /*        Preenchido em RunTime     */')
