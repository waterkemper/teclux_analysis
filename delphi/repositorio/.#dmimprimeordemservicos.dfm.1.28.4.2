        Name = 'TiposAtendimentos'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select'
      '   ct.numero,'
      
        '   cast(coalesce(ct.equipamento,p.codigovisual) as varchar(30)) ' +
        'as equipamento,'
      '   ct.filialproduto,'
      ''
      '   case when ct.equipamento is not null then'
      '    cast(ct.equipamento as varchar(30))'
      '   else'
      '    p.codigovisual'
      '   end as equipamentovisual,'
      ''
      '   case when ct.equipamento is not null then'
      
        '    (select e.descricao  from equipamentos e where e.codigo = ct' +
        '.equipamento)'
      '   else'
      '    p.descricao'
      '   end as descricao,'
      ''
      '   ct.filialvenda,'
      ''
      
        '   (select f.nome  from filiais f where f.codigo = ct.filialvend' +
        'a) as nomefilial,'
      ''
      '   ct.tipoequipamento,'
      '   ct.data,'
      '   ct.entrada,'
      '   case when ct.equipamento is not null then'
      
        '    (select m.descricao  from equipamentos e join marcas m on e.' +
        'marca = m.codigo  where e.codigo = ct.equipamento)'
      '   else'
      '    cast(null as varchar)'
      '   end as descricaomarca,'
      ''
      '   case when ct.equipamento is not null then'
      
        '    (select e.modelo from equipamentos e where e.codigo = ct.equ' +
        'ipamento)'
      '   else'
      '    cast(null as varchar)'
      '   end as modelo,'
      ''
      '   case when ct.equipamento is not null then'
      
        '   (select e.referencia from equipamentos e where e.codigo=ct.eq' +
        'uipamento)'
      '   else'
      '   cast(null as varchar)'
      '   end as serieequipamento,'
      '   ct.valorinicial,'
      '   ct.previsao,'
      
        '   coalesce(ct.datafechamento,cast('#39'1899-12-30'#39' as date)) as dat' +
        'afechamento,'
      '   ct.autorizacao,'
      '   ct.autfoneddd,'
      '   ct.autfonenumero,'
      '   ct.cliente,'
      '   ct.tipocliente,'
      '   ct.pessoanumero,'
      '   ct.civil,'
      '   ct.sexo,'
      '   ct.nascto,'
      '   cast(ct.idorgao||'#39'-'#39'||ct.idestado as varchar) as idorgao,'
      '   ct.iddocumento as identidade,'
      '   ct.pai,'
      '   ct.mae,'
      
        '   cast((Select ci.nome from cidades ci where ci.codigo = ct.nat' +
        'uralcidade and ci.estado = ct.naturalestado)||'#39'-'#39'||'
      
        '   (Select cid.estado from cidades cid where cid.codigo = ct.nat' +
        'uralcidade and cid.estado = ct.naturalestado)as varchar) as natu' +
        'ralidade,'
      
        '   (select coalesce(vf.razao,vf.nome)  from vfornecedores vf  wh' +
        'ere vf.codigo = ct.cliente and vf.tipo = ct.tipocliente) as nome' +
        'cliente,'
      
        '   (select d2.nome from cidades d2 where (d2.estado = ct.estado)' +
        ' and (d2.codigo = ct.cidade)) as nomecidade,'
      
        '   (select b1.nome from bairros b1 where (b1.estado = ct.estado)' +
        ' and (b1.cidade = ct.cidade) and (b1.codigo = ct.bairro)) as nom' +
        'ebairro,'
      '   ct.rua,'
      '   ct.endnumero,'
      '   ct.endcomplemento,'
      '   ct.estado,'
      '   ct.cep,'
      
        '   formatar_fone_fax(ct.foneddd, ct.fonenumero,ct.foneramal)as t' +
        'elefone,'
      
        '   formatar_fone_fax(ct.fone2ddd, ct.fone2numero,ct.fone2ramal)a' +
        's telefone2,'
      '   ct.empresa,'
      '   ct.empadmissao,'
      
        '   (select cg.descricao from cargos cg where cg.codigo = ct.empc' +
        'argo) as cargocliente,'
      
        '   formatar_fone_fax(ct.empfoneddd, ct.empfonenumero,'#39#39')as fonee' +
        'mpresa,'
      '   ct.emprendavalor,'
      '   ct.emprendafaixa,'
      
        '   cast(cast(ct.avalista as varchar)||'#39'-'#39'||(select cl.nome from ' +
        'clientes cl where cl.codigo = ct.avalista) as varchar) as avalis' +
        'ta,'
      
        '   (select sum(case when  s.tipocomissao='#39'%'#39'  then sc.valorservi' +
        'co * (s.comissao/100) else s.comissao end)'
      
        '     from servicoscontratos sc join servicos s on sc.servico = s' +
        '.codigo and sc.contrato = ct.numero) as valorcomissao,'
      
        '   (select sum(pc.quantidade*pc.precovenda) from produtoscontrat' +
        'os pc where pc.contrato = ct.numero) as totalprodutos,'
      
        '   (select sum(pc.quantidade) from produtoscontratos pc where pc' +
        '.contrato = ct.numero) as QuantidadeProdutos,'
      
        '   (select sum(s.quantidade*s.valorservico) from servicoscontrat' +
        'os s where s.contrato = ct.numero) as totalservicos,'
      
        '    cast(cast(ct.vendedor as varchar)||'#39'-'#39'||(Select u.nome from ' +
        'usuarios u where u.codigo = ct.vendedor)as varchar) as vendedor,'
      '    ct.valorprazo,'
      '    ct.valorvista,'
      '    ct.creditotroca,'
      '    ct.desconto,'
      '    ct.consideracoes,'
      '    ct.os_garantia,'
      '    ct.os_cortesia,'
      '    ct.os_garantia_status,'
      '    ct.situacao as Sit,'
      
        '    (select ta.descricao from tiposatendimentos ta where ta.codi' +
        'go = tipoatendimentocontrato(ct.numero)) as descricaoatendimento'
      '                      /*'
      '    cast (case when ct.situacao = '#39'O'#39' then '#39'A'#39
      '               when ct.situacao = '#39'R'#39' then '#39'A'#39
      '               when ct.situacao = '#39'F'#39' then '#39'F'#39
      '               when ct.situacao = '#39'P'#39' then '#39'F'#39
      '               when ct.situacao = '#39'N'#39' then '#39'F'#39
      '               when ct.situacao = '#39'C'#39' then '#39'C'#39
      '    end as varchar) as Sit'
      '    */'
      ''
      ''
      'from contratos ct left join produtos p on ct.produto = p.codigo'
      '     '
      'where ct.os and contratos_atual(ct.numero)'
      ''
      '%DataEntrada'
      '%DataFechamento'
      '%cliente'
      '%situacao'
      '%numero'
      '%filial'
      '%TipoEqptoOrdemServico'
      '%SituacaoGarantia'
      '%Equipamento'
      '%TiposAtendimentos'
      ''
      'order by ct.data, ct.numero')
    RequestLive = False
    Left = 80
    Top = 16
