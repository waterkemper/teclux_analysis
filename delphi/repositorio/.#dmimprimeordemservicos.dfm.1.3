    Macros = <
      item
        DataType = ftUnknown
        Name = 'DataEntrada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFechamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
