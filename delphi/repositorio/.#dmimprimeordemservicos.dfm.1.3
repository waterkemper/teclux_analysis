        Name = 'numero'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select'
      ' ct.numero,'
      ' coalesce(ct.equipamento,ct.produto) as equipamento,'
      ' ct.filialproduto,'
      ''
      ' case when ct.equipamento is not null then'
      
        '  (select e.descricao  from equipamentos e where e.codigo = ct.e' +
        'quipamento)'
      ' else'
      
        '  (select p.descricao  from produtos p where p.codigo = ct.produ' +
        'to)'
      ' end as descricao,'
      ''
      ' ct.filialvenda,'
      ''
      
        ' (select f.nome  from filiais f where f.codigo = ct.filialvenda)' +
        ' as nomefilial,'
      ''
      ' ct.tipoequipamento,'
      ' ct.data as entrada,'
      ' case when ct.equipamento is not null then'
      
        '  (select m.descricao  from equipamentos e join marcas m on e.ma' +
        'rca = m.codigo  where e.codigo = ct.equipamento)'
      ' else'
      '  cast(null as varchar)'
      ' end as descricaomarca,'
      ''
      ' case when ct.equipamento is not null then'
      
        '  (select e.modelo from equipamentos e where e.codigo = ct.equip' +
        'amento)'
      ' else'
      '  cast(null as varchar)'
      ' end as modelo,'
      ''
      ' case when ct.equipamento is not null then'
      
        ' (select e.referencia from equipamentos e where e.codigo=ct.equi' +
        'pamento)'
      ' else'
      ' cast(null as varchar)'
      ' end as serieequipamento,'
      ' ct.valorinicial,'
      ' ct.previsao,'
      
        ' coalesce(ct.datafechamento,cast('#39'1899-12-30'#39' as date)) as dataf' +
        'echamento,'
      ' ct.autorizacao,'
      ' ct.autfoneddd,'
      ' ct.autfonenumero,'
      ' ct.cliente,'
      ' ct.tipocliente,'
      ' ct.pessoanumero,'
      ' ct.civil,'
      ' ct.sexo,'
      ' ct.nascto,'
      ' cast(ct.idorgao||'#39'-'#39'||ct.idestado as varchar) as idorgao,'
      ' ct.iddocumento as identidade,'
      ' ct.pai,'
      ' ct.mae,'
      
        ' cast((Select ci.nome from cidades ci where ci.codigo = ct.natur' +
        'alcidade and ci.estado = ct.naturalestado)||'#39'-'#39'||'
      
        ' (Select cid.estado from cidades cid where cid.codigo = ct.natur' +
        'alcidade and cid.estado = ct.naturalestado)as varchar) as natura' +
        'lidade,'
      
        ' (select coalesce(vf.razao,vf.nome)  from vfornecedores vf  wher' +
        'e vf.codigo = ct.cliente and vf.tipo = ct.tipocliente) as nomecl' +
        'iente,'
      
        ' (select d2.nome from cidades d2 where (d2.estado = ct.estado) a' +
        'nd (d2.codigo = ct.cidade)) as nomecidade,'
      
        ' (select b1.nome from bairros b1 where (b1.estado = ct.estado) a' +
        'nd (b1.cidade = ct.cidade) and (b1.codigo = ct.bairro)) as nomeb' +
        'airro,'
      ' ct.rua,'
      ' ct.endnumero,'
      ' ct.endcomplemento,'
      ' ct.estado,'
      ' ct.cep,'
      
        ' formatar_fone_fax(ct.foneddd, ct.fonenumero,ct.foneramal)as tel' +
        'efone,'
      
        ' formatar_fone_fax(ct.fone2ddd, ct.fone2numero,ct.fone2ramal)as ' +
        'telefone2,'
      ' ct.empresa,'
      ' ct.empadmissao,'
      
        ' (select cg.descricao from cargos cg where cg.codigo = ct.empcar' +
        'go) as cargocliente,'
      
        ' formatar_fone_fax(ct.empfoneddd, ct.empfonenumero,'#39#39')as foneemp' +
        'resa,'
      ' ct.emprendavalor,'
      ' ct.emprendafaixa,'
      
        ' cast(cast(ct.avalista as varchar)||'#39'-'#39'||(select cl.nome from cl' +
        'ientes cl where cl.codigo = ct.avalista) as varchar) as avalista' +
        ','
      
        ' (select sum(case when  s.tipocomissao='#39'%'#39'  then sc.valorservico' +
        ' * (s.comissao/100) else s.comissao end)'
      
        '   from servicoscontratos sc join servicos s on sc.servico = s.c' +
        'odigo and sc.contrato = ct.numero) as valorcomissao,'
      
        ' (select sum(pc.quantidade*pc.precovenda) from produtoscontratos' +
        ' pc where pc.contrato = ct.numero) as totalprodutos,'
      
        ' (select sum(s.quantidade*s.valorservico) from servicoscontratos' +
        ' s where s.contrato = ct.numero) as totalservicos,'
      
        '  cast(cast(ct.vendedor as varchar)||'#39'-'#39'||(Select u.nome from us' +
        'uarios u where u.codigo = ct.vendedor)as varchar) as vendedor,'
      '  ct.valorprazo,'
      '  ct.valorvista,'
      '  ct.creditotroca,'
      '  ct.desconto,'
      '  ct.consideracoes'
      'from contratos ct'
      'where os'
      '%DataEntrada'
      '%DataFechamento'
      '%cliente'
      '%situacao'
      '%numero'
      '%filial'
      'order by ct.data, ct.numero')
    RequestLive = False
    Left = 80
    Top = 8
