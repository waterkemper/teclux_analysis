  object qryProdutosOrdemServicos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'SELECT OS.*,CASE WHEN movimento IS NOT NULL THEN valor/qtdemovim' +
        'ento ELSE NULL END as precocusto'
      'FROM'
      '('
      'select pc.data,'
      '       pc.produto,'
      '       pc.numero,'
      '       pc.filial,'
      
        '       (select p.descricao from produtos p where p.codigo = pc.p' +
        'roduto) as nomeproduto,  '
      '       pc.quantidade,'
      '       pc.precovenda,'
      '       m.numero as movimento,'
      '       m.financeiro,m.valor,m.quantidade as qtdemovimento'
      'from'
      
        'produtoscontratos pc left join  movimentos m on (m.numero = (sel' +
        'ect max(m2.numero)'
      
        '                                                             fro' +
        'm movimentos m2     '
      
        '                                                             whe' +
        're m2.contrato = pc.contrato and'
      
        '                                                             m2.' +
        'produto = pc.produto and'
      
        '                                                             m2.' +
        'filial = pc.filial))'
      'where pc.contrato = :contrato) as OS')
    RequestLive = False
    Active = True
    Left = 80
    Top = 72
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
