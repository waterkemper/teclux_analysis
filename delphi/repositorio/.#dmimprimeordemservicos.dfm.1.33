  object qryProdutosOrdemServicos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'SELECT OS.*,CASE WHEN movimento IS NOT NULL THEN valor/qtdemovim' +
        'ento ELSE NULL END as precocusto'
      'FROM'
      '('
      'select pc.data,'
      '       pc.produto,'
      '       p.codigovisual as produtovisual,'
      '       pc.numero,'
      '       pc.filial,'
      
        '       (select p.descricao from produtos p where p.codigo = pc.p' +
        'roduto) as nomeproduto,'
      '       pc.quantidade,'
      '       pc.precovenda,'
      '       m.numero as movimento,'
      '       m.financeiro,m.valor,m.quantidade as qtdemovimento'
      
        'from ((produtoscontratos pc join produtos p on pc.produto = p.co' +
        'digo)'
      
        '      left join  movimentos m on (m.numero = (select max(m2.nume' +
        'ro)'
      
        '                                                             fro' +
        'm movimentos m2'
      
        '                                                             whe' +
        're m2.contrato = pc.contrato and'
      
        '                                                             m2.' +
        'produto = pc.produto and'
      
        '                                                             m2.' +
        'filial = pc.filial)))'
      'where pc.contrato = :contrato) as OS')
    RequestLive = False
    Left = 80
    Top = 72
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'contrato'
        ParamType = ptUnknown
      end>
    object qryProdutosOrdemServicosdata: TDateField
      Alignment = taCenter
      FieldName = 'data'
      EditMask = '99/99/9999;1; '
    end
    object qryProdutosOrdemServicosproduto: TLargeintField
      FieldName = 'produto'
      Required = True
    end
    object qryProdutosOrdemServicosprodutovisual: TStringField
      FieldName = 'produtovisual'
      Size = 30
    end
    object qryProdutosOrdemServicosfilial: TIntegerField
      FieldName = 'filial'
      Required = True
      DisplayFormat = '0'
    end
    object qryProdutosOrdemServicosnomeproduto: TStringField
      DisplayWidth = 50
      FieldName = 'nomeproduto'
      Size = 100
    end
    object qryProdutosOrdemServicosquantidade: TFloatField
      FieldName = 'quantidade'
      Required = True
      DisplayFormat = '0.00'
    end
    object qryProdutosOrdemServicosprecovenda: TFloatField
      FieldName = 'precovenda'
      Required = True
      DisplayFormat = '0.00'
    end
    object qryProdutosOrdemServicosprecocusto: TFloatField
      FieldName = 'precocusto'
      DisplayFormat = '0.00'
    end
    object qryProdutosOrdemServicosnumero: TIntegerField
      FieldName = 'numero'
      DisplayFormat = '0'
    end
  end
