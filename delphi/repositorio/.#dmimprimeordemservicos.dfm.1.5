    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterScroll = qryOrdemServicosAfterScroll
    OnCalcFields = qryOrdemServicosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'DataEntrada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DataFechamento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cliente'
        ParamType = ptUnknown
