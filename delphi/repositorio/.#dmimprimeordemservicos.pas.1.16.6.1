procedure TdtmImprimeOrdemServicos.ImprimirRelatorio(Cabecalho, Agrupamento:String; TipoRelatorio: integer; ComCustoMedio: Boolean);
var
//  Relatorio: TfrReport;
//  frmPreview: TfrmPreviewPadrao;
  PV: TfrxComponent;

  LinhaE: T_Extenso;
  ValorExtenso, ResultExtenso: String;

  Linha, vAuxLinha,
  Extenso1,
  Extenso2,
  Extenso3,
  Extenso4, vDescricao, vDescricaoAux : String;
  I, Comp, vPosIni, vPosFim: Integer;


  MaxCol, nLinhas, a  : Integer;
  RelatorioECF : TStringList;

  procedure Alinhar(Tipo: TAlignment; PosAtual: Integer = 0);
  begin
    case Tipo of
      taCenter: Insert(stringOfChar(' ', (MaxCol - Length(linha)) div 2), Linha, 1);
      taRightJustify: Insert(stringOfChar(' ', MaxCol - Length(linha) - PosAtual), Linha, 1);
    end
  end;

  procedure ImprimirLinha(texto: String;posicao: integer); overload;
  begin
    if a = 1 then
    begin
      if (texto = '') then
        RelatorioECF.Append(stringOfChar(' ', MaxCol))
      else
        RelatorioECF.Append(texto);
    end;

    if (texto = '') then
      TextPrinter.writeln
    else
      TextPrinter.WriteTextln(texto, posicao);
  end;

begin
  self.TipoRelatorio := TipoRelatorio;
  if parsistema.ImprimirOrdemServicoNaECF and Assigned(ECFPadrao) then
  begin
    RelatorioECF := TStringList.Create;
    try
      if ParSistema.MaxColAutenticadora <> 0 then
        MaxCol := ParSistema.MaxColAutenticadora
      else
        MaxCol := 60;

      with TextPrinter do
      begin
        ImprimirParaArquivo := True;
        Text.Clear;

        for a := 1 to ParSistema.NumeroCopiasdorecibo do
        begin

          if ParSistema.Autenticadora in [1,2,4] then
            BeginDoc('', False)
          else
          begin
            BeginDoc('', True);
            writeText(EPS_ON_CONDENSED,0);
          end;

//          ImprimirLinha('', 0);

          Linha := RazaoFilialBase;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          Linha := RuaFilialBase + ' - ' + BairroFilialBase;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          Linha := 'CEP ' + FormatarCEP(CEPFilialBase) + ' - ' + CidadeFilialBase + ' - ' + EstadoFilialBase;
          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

          Linha := 'Fone: ' + FormatarFone(DDDFilialBase,FoneFilialBase);
          Alinhar(taCenter);
          ImprimirLinha(Linha, 0);

          Linha := ctCGCMF + ' ' + FormatarCPFouCGC(CNPJFilialBase) + ' ' +
                   ctIE + ' ' + InscricaoEstadualFilialBase ;

          Alinhar(taCenter);
          ImprimirLinha(linha, 0);

{
          Linha := ctIE + ' ' + InscricaoEstadualFilialBase ;
          Alinhar(taCenter);
          ImprimirLinha(Linha, 0);
}

 //         ImprimirLinha('',0);
 //         ImprimirLinha('',0);


          ImprimirLinha('',0);
//          ImprimirLinha('',0);

          Linha := 'ORDEM DE SERVIÇO N. ' + qryOrdemServicosnumero.asString;

          Alinhar(taCenter);
          ImprimirLinha(Linha, 0);

          ImprimirLinha('',0);

          Linha := 'Data de Entrada: ' + formatDateTime('dd/mm/yyyy',qryOrdemServicosentrada.asDateTime);

          if not qryOrdemServicosprevisao.isnull then
            Linha := Linha + ' Prometido para: ' + formatDateTime('dd/mm/yyyy',qryOrdemServicosprevisao.asDateTime);

//          Alinhar(taCenter);
          ImprimirLinha(Linha, 0);

          Linha := 'Cliente: ' + qryOrdemServicosnomecliente.asString;

//          Alinhar(taCenter);
          ImprimirLinha(Linha, 0);

          Linha := 'Fone: ' + qryOrdemServicostelefone.asString;

//          Alinhar(taCenter);
          ImprimirLinha(Linha, 0);

          ImprimirLinha('',0);

          Linha := 'PRODUTO      DESCRIÇÃO  QUANTIDADE  PREÇO UNIT.    TOTAL';
          ImprimirLinha(Linha,0);

//          Linha := 'QUANTIDADE  PREÇO UNIT.    TOTAL  ';
//          Alinhar(taRightJustify);
//          ImprimirLinha(Linha,0);
          ImprimirLinha(StringOfChar('-', MaxCol),0);

          qryProdutosOrdemServicos.first;
          while not qryProdutosOrdemServicos.eof do
          begin
//            linha := FormatStringOut(qryProdutosOrdemServicosprodutovisual.asString, 'L', ' ',30) + ' '+
//                     qryProdutosOrdemServicosnomeproduto.asString;
            linha := qryProdutosOrdemServicosprodutovisual.asString + ' - ' +
                     qryProdutosOrdemServicosnomeproduto.asString;

            ImprimirLinha(Linha,0);
            linha := FormatStringOut(FormatarQuantidade(qryProdutosOrdemServicosquantidade.asCurrency), 'R', ' ', 10) + ' '+
                     FormatStringOut(formatfloat('#####,##0.00', qryProdutosOrdemServicosprecovenda.asCurrency), 'R', ' ', 12) + ' '+
                     FormatStringOut(formatfloat('#####,##0.00', qryProdutosOrdemServicosquantidade.asCurrency * qryProdutosOrdemServicosprecovenda.asCurrency), 'R', ' ',12);

            Alinhar(taRightJustify);
            ImprimirLinha(Linha,0);
            qryProdutosOrdemServicos.next;
          end;

          ImprimirLinha(StringOfChar('_', MaxCol),0);
          Linha := 'TOTAL PRODUTOS ' + FormatStringOut(FormatarQuantidade(qryOrdemServicosquantidadeprodutos.asCurrency), 'R', ' ', 10) + ' ítens       '+
                     FormatStringOut(formatfloat('#####,##0.00', qryOrdemServicostotalprodutos.asCurrency), 'R', ' ', 12);

          Alinhar(taRightJustify);
          ImprimirLinha(Linha,0);

          Comp := (maxcol - 10) div 2 - length('DESCRIÇÃO SERVIÇOS') div 2;
          vAuxLInha := StringOfChar(' ', comp) + 'DESCRIÇÃO SERVIÇOS' + StringOfChar(' ', comp-1);
          if length(vAuxLinha) < (maxcol - 10) then
            VAuxLInha := vAuxLInha + StringOfChar(' ', ((maxcol - 10) - length(vAuxLinha)) );

          Linha := VAuxLInha + '   VALOR  ';
          ImprimirLinha(Linha,0);

          ImprimirLinha(StringOfChar('-', MaxCol),0);

          qryServicosOrdemServico.first;
          while not qryServicosOrdemServico.eof do
          begin
            vDescricaoAux := qryServicosOrdemServicodescricaoservico.asString;
            if not qryServicosOrdemServicocomplementoservico.isnull then
              vDescricaoAux := vDescricaoAux + ' - ' +qryServicosOrdemServicocomplementoservico.asString;

            vPosIni := 1;
            vPosFim := maxcol-10;

            if length(vDescricaoAux) > vPosFim then
            begin
              while vPosfim < length(vDescricaoAux) do
              begin
                vDescricao := copy(vDescricaoAux,vPosIni,vPosFim);
                Linha := vDescricao;
                ImprimirLinha(Linha,0);
                vPosIni := vPosFim + 1;
                vPosFim := vposfim + 1 + (maxcol - 10);
              end;
              vDescricao := copy(vDescricaoAux,vPosIni,vPosFim);
              vDescricao := vDescricao + stringofchar(' ',(maxcol-10) - length(vDescricao));

              Linha := vDescricao +
              stringofchar(' ', 10 - length(formatfloat('###,##0.00', qryServicosOrdemServicovalorservico.asCurrency*qryServicosOrdemServicoquantidade.asCurrency))) +
              formatfloat('###,##0.00', qryServicosOrdemServicovalorservico.asCurrency*qryServicosOrdemServicoquantidade.asCurrency);

              ImprimirLinha(Linha,0);
            end
            else
            begin
              vDescricao := vDescricaoAux;
              vDescricao := vDescricao + stringofchar(' ',(maxcol-10) - length(vDescricao));
              Linha := vDescricao +
              stringofchar(' ', 10 - length(formatfloat('###,##0.00', qryServicosOrdemServicovalorservico.asCurrency*qryServicosOrdemServicoquantidade.asCurrency))) +
              formatfloat('###,##0.00', qryServicosOrdemServicovalorservico.asCurrency*qryServicosOrdemServicoquantidade.asCurrency);
              ImprimirLinha(Linha,0);
            end;

            qryServicosOrdemServico.next;
          end;

          ImprimirLinha(StringOfChar('_', MaxCol),0);
          Linha := 'TOTAL SERVIÇOS  ' + formatfloat('###,##0.00', qryOrdemServicostotalservicos.asCurrency);
          Alinhar(taRightJustify);
          ImprimirLinha(Linha,0);

          ImprimirLinha(StringOfChar('_', MaxCol),0);
          Linha := 'TOTAL GERAL  ' + formatfloat('###,##0.00', qryOrdemServicostotalservicos.asCurrency+qryOrdemServicostotalprodutos.asCurrency);
          Alinhar(taRightJustify);
          ImprimirLinha(Linha,0);


          

          writeText(EPS_OFF_CONDENSED,0);
          EndDoc('TecLUX - Imprimindo recibo de Caixa.');

          ECFPadrao.RelatorioGerencial(RelatorioECF);

        end;
      end;
    finally
      RelatorioECF.free;
      NomeImpressoraEscolhida := '';
    end;

  end
  else
  begin

    frVariables['Rua']   := RuaFilialBase;
    frVariables['NomeCliente'] := RetiraAcento(qryOrdemServicosnomecliente.asString);
    frVariables['Bairro']:= BairroFilialBase + ' - CEP: ' + CEPFilialBase;
    frVariables['Cidade']:= CidadeFilialBase + ' - ' + EstadoFilialBase;
    frVariables['Fone']  := FoneFilialBase;
    frVariables['Outras']:= Cabecalho;

    frxOrdemServicoCompleto.Variables['Outras']:= quotedstr(Cabecalho);

    frVariables['ComCusto']:= ComCustoMedio;
    frxOrdemServicoCompleto.Variables['ComCusto']:= ComCustoMedio;
    frVariables['TipoRelatorio']:= TipoRelatorio;
    frxOrdemServicoCompleto.Variables['TipoRelatorio']:= TipoRelatorio;

    frVariables['Juros']        := ParSistema.PercentualAtrasoJuros2;
    frVariables['RazaoSemAcento']:= RetiraAcento(RazaoFilialBase);
    if ParSistema.PercentualAtrasoMultas2 > 0 then
      frVariables['Multa']      := 'e multa contratual de '+floattostr(ParSistema.PercentualAtrasoMultas2)+'% '
    else
      frVariables['Multa']      := '';
    LinhaE.ExtTamLinha[1]:= 150;
    Extenso(ParSistema.PercentualAtrasoJuros2,$92,'VIRGULA','VIRGULA',' ',' ',' ', LinhaE);
    ValorExtenso:= Trim(LinhaE.ExtLinha[1]);
    if Pos(',',floattostr(ParSistema.PercentualAtrasoJuros2)) = 0 then
      ResultExtenso:= Trocar(ValorExtenso,'VIRGULA','')
    else
      ResultExtenso:= Trocar(ValorExtenso,'VIRGULA E ','VIRGULA ');

    frVariables['JurosExtenso'] := ResultExtenso+ ' POR CENTO';
    frVariables['RazaoSemAcento']:= RetiraAcento(RazaoFilialBase);

    case TipoRelatorio of
      0 :frVariables['Titulo']:= 'RELATÓRIO DE ORDENS DE SERVIÇOS SINTÉTICO';

      1 :frxOrdemServicoCompleto.Variables['Titulo']:=quotedstr('ORDEM DE SERVIÇOS');
      2 :
      begin
        frxOrdemServicoCompleto.Variables['Titulo']:= quotedstr('ORDEM DE SERVIÇOS');
        frxOrdemServicoCompleto.Variables['Outras']:= '';
      end;
    end;

    if qryParcelas.RecordCount <= 16 then
      frVariables['IMPRIMINDOQUANTIDADE']  := True
    else
      frVariables['IMPRIMINDOQUANTIDADE']  := False;


//    frmPreview := TfrmPreviewPadrao.create(self.owner);
//    frmPreview.cmbZoom.ItemIndex:= 3;//125%



//    frpOrdemServicoSintetico.DesignReport;
//  frxOrdemSErvicoCompleto.DesignReport;
//  frpOrdemServicoCompleto.DesignReport;
    try
     //frpOrdemServico_Linux.DesignReport;

//     Relatorio := frmPreview.frCompositeReport;
//     frmPreview.frCompositeReport.Reports.Clear;
//     with frmPreview do
     begin
       if ParSistema.ImprimirContratoFrenteVerso then
       begin
        ImprimirRelatoriofast(null, null, MPadrao, 0, [frpOrdemServico_Windows, frpParcelas_Windows], false, self);

//        frCompositeReport.Reports.Add(frpOrdemServico_Windows);
//        frCompositeReport.Reports.Add(frpParcelas_Windows);
       end
       else
       begin
         if TipoRelatorio = 0 then
           //frCompositeReport.Reports.Add(frpOrdemServicoSintetico)
           ImprimirRelatoriofast(null, null, MSimples, 0, [frpOrdemServicoSintetico], false, self)
         else
         if (TipoRelatorio = 1) or
            (TipoRelatorio = 2) then
         begin

            if FileExists(LogotipoFilialBase) then
            begin
              PV := frxOrdemServicoCompleto.FindObject('fpvLogo');
              if (PV is TfrxPictureView) then
                TfrxPictureView(PV).picture.LoadFromFile(LogotipoFilialBase);
            end;

//            frxOrdemServicoCompleto.DesignReport;
            frxOrdemServicoCompleto.ShowReport(true);

         end;
(*
           ImprimirRelatoriofast(null, null, MSimples, 0, [frpOrdemServicoCompleto], false, self)
         else if TipoRelatorio = 2 then
//           frCompositeReport.Reports.Add(frpOrdemServicoCompleto);
           ImprimirRelatoriofast(null, null, MSimples, 0, [frpOrdemServicoCompleto], false, self)
*)
       end;
     end;
//     Relatorio.Preview := frmPreview.frPreviewPadrao;
//     Relatorio.ShowReport;

//     frmPreview.ShowModal;

    finally

//     frmPreview.Free

    end;
  end;

end;

procedure TdtmImprimeOrdemServicos.qryOrdemServicosAfterScroll(DataSet: TDataSet);
begin
  inherited;
  if TipoRelatorio <> 0 then
  begin
    ReFazConsulta(qryProdutosOrdemServicos,[0], [qryOrdemServicosnumero.AsVariant]);
    ReFazConsulta(qryServicosOrdemServico,[0],[qryOrdemServicosnumero.AsVariant]);
    RefazConsulta(qryOrdemServicoEntrada,[0],[qryOrdemServicosnumero.AsVariant]);
    ReFazConsulta(qryParcelas,[0],[qryOrdemServicosnumero.AsVariant]);

    RefazConsultaPorNome(qryQuestionarios, ['ordemservico'], [qryOrdemServicosnumero.AsVariant]);
  end;

end;

procedure TdtmImprimeOrdemServicos.qryOrdemServicosCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  case qryOrdemServicostipoequipamento.AsInteger of
   1: qryOrdemServicosdescricaotipoequipamento.AsString := ANSIUpperCase(ctNOVOCLIENTE);
   2: qryOrdemServicosdescricaotipoequipamento.AsString := ANSIUpperCase(ctUSADOCLIENTE);
   3: qryOrdemServicosdescricaotipoequipamento.AsString := ANSIUpperCase(ctATIVOFIXO);
   4: qryOrdemServicosdescricaotipoequipamento.AsString := ANSIUpperCase(ctESTOQUE);
  end;
end;

procedure TdtmImprimeOrdemServicos.qryServicosOrdemServicoCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if qryServicosOrdemServicotipocomissaoservico.AsString = '%' then
    qryServicosOrdemServicoValorComissao.AsCurrency:= qryServicosOrdemServicovalorservico.AsCurrency * (qryServicosOrdemServicocomissaoservico.AsFloat/100)
  else
    qryServicosOrdemServicoValorComissao.AsCurrency:= qryServicosOrdemServicocomissaoservico.AsFloat;
end;

