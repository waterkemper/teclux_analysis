procedure TdtmImprimeOrdemServicos.ZMonitor1MonitorEvent(Sql,
  Result: String);
var
 Listar : TStringList;
begin
  inherited;
  Listar := tStringlist.create;
  if fileexists('c:/relos.sql') then
    Listar.loadfromfile('c:/relos.sql');
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile('c:/relos.sql');
  listar.free;
end;


