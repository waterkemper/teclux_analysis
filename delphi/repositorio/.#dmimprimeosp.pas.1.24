var
  dtmImprimeOsp: TdtmImprimeOsp;

implementation
Uses
  //Biblio
  clparametrossistema,
  //Componentes
  cltextprinter;

{$R *.dfm}

{ TdtmImprimeOsp }

function TdtmImprimeOsp.ImpressaoControleProcesso(OSP: Integer;
  Impressora: String): Boolean;
begin
  result := true;
  RefazConsultaPorNome(qryOperacoesProcesso,['OSP'],[OSP]);
  if qryOperacoesProcesso.RecordCount > 0 then
  begin
    qryOperacoesProcesso.First;
    while not qryOperacoesProcesso.Eof do
    begin
      ObterDadosControleProcesso(OSP, qryOperacoesProcessooperacao.AsInteger);
      if qryControleProcesso.RecordCount <> 0 then
        result := ImprimirControleProcesso(Impressora);
      if result then
        qryOperacoesProcesso.next
      else
        break;
    end;
  end;

end;

function TdtmImprimeOsp.ImpressaoSetup(OSP: Integer; Impressora: String): Boolean;
var Operacao: Integer;
begin
  result := true;
  RefazConsultaPorNome(qryOperacoesSetup,['OSP'],[OSP]);
  if qryOperacoesSetup.RecordCount > 0 then
  begin
    qryOperacoesSetup.First;
    while not qryOperacoesSetup.Eof do
    begin
      Operacao:= qryOperacoesSetupoperacao.AsInteger;
      ObterDadosSetup(OSP, Operacao);
      if qrySetupOperacoes.RecordCount <> 0 then
        result := ImprimirSetup(OSP,Operacao,Impressora);

      if result then
        qryOperacoesSetup.next
      else
        break;
    end;
  end;
//  else
//    MensagemAviso(format(ctNENHUMREGISTROENCONTRADO,['Registro']));
end;

function TdtmImprimeOsp.ImpressaoControleProcesso(OSP, 
  Operacao: Integer;  Impressora: String): Boolean;
begin
  result := true;
  ObterDadosControleProcesso(OSP, Operacao);
  if qryControleProcesso.RecordCount <> 0 then
    result := ImprimirControleProcesso(Impressora);
end;

function TdtmImprimeOsp.ImpressaoSetup(OSP, Operacao, UsuarioSetup: Integer;
  NomeUsuarioSetup: String;  Impressora: String ): Boolean;
begin
  result := false;
  ObterDadosSetup(OSP, Operacao, UsuarioSetup, NomeUsuarioSetup);
  if qrySetupOperacoes.RecordCount <> 0 then
    result := ImprimirSetup(OSP,Operacao,Impressora);
end;

function TdtmImprimeOsp.ImprimirControleProcesso(
  Impressora: String): Boolean;
var Pagina, QtdePaginas, ControleAux, ControlePag, Count: Integer;
begin
  try

    if Impressora = '' then
      NomeImpressoraEscolhida:= ParSistema.NomeImpressoraControleProcesso
    else
      NomeImpressoraEscolhida:= Impressora;

    Pagina  := 1;
    ControleAux:= 0;
    Result  := true;

    EPS_ON_CONDENSED:= EPS_15CPP;
    with TextPrinter do
    begin
      BeginDoc(ConfigurarControleProcesso);
      ControlePag      := ProductPerPage(ConfigurarControleProcesso);

      if Pagina = 1 then
        ControleAux := qryControleProcesso.RecordCount;

      if (ControleAux <= ControlePag) then
        QtdePaginas:= 1
      else
      begin
        QtdePaginas := ControleAux div ControlePag;
        if (ControleAux mod ControlePag) > 0 then
          Inc(QtdePaginas);
      end;

      repeat
        BandString:= CabecalhoControleProcesso;
        BreakToLine;
        WriteBand(qryControleProcesso.Fields);

        if qryControleProcesso.RecordCount > 0 then
        begin
          BandString:= ListaControleProcesso;
          BreakToLine;

          if Pagina = 1 then
            qryControleProcesso.First;

          Count:= 0;
          while not qryControleProcesso.Eof do begin
            MontarLinhasPlanoControle;
            WriteBand(qryListaControleProcesso.Fields);
            qryControleProcesso.Next;
            Inc(Count);
            if Count >= ControlePag then
              Break;
          end;
          qryControleProcesso.EnableControls;
        end;

        BandString:= RodapeControleProcesso;
        BreakToLine;
        WriteBand(qryControleProcesso.Fields);


        {$IFNDEF LINUX}
        if Pagina < QtdePaginas then
          WriteTextln('',0);
        {$ENDIF}
        Inc(Pagina);
      until Pagina > QtdePaginas;
      EndDoc('TecLUX - Emissão de Controle de Processo');
    end;
    EPS_ON_CONDENSED:= EPS_20CPP;

  except
    on E: Exception do
    begin
      ShowMessage(E.Message);
      result := false;
    end;
  end;

end;

function TdtmImprimeOsp.ImprimirOSP(OSP, Lote: Integer; Impressora: String): Boolean;
var Pagina, QtdePaginas, FluxoAux, FluxPag, ProdPag, Count: Integer;
begin
  try
    if Impressora = '' then
      NomeImpressoraEscolhida:= ParSistema.NomeImpressoraOSP
    else
      NomeImpressoraEscolhida:= Impressora;

    ProdPag := 20;

    Pagina  := 1;
    FluxoAux:= 0;
    Result  := true;

    ObterDadosOSP(OSP, Lote);

    with TextPrinter do
    begin
      BeginDoc(ConfigurarOSP);
      FluxPag      := ProductPerPage(ConfigurarOSP);

      if Pagina = 1 then
      begin
        qryFluxogramasOperacoes.DisableControls;
        GuardarRegistroAtual(qryFluxogramasOperacoes, True);
        qryFluxogramasOperacoes.First;
        while not qryFluxogramasOperacoes.Eof do
        begin
          inc(fluxoAux);
          qryFluxogramasOperacoes.Next;
        end;
        VoltarRegistroAtual(qryFluxogramasOperacoes);
        qryFluxogramasOperacoes.EnableControls;
      end;

      if (FluxoAux <= FluxPag) then
        QtdePaginas:= 1
      else
      begin
        QtdePaginas:= FluxoAux div FluxPag;
        if (FluxoAux mod FluxPag) > 0 then
          Inc(QtdePaginas);
      end;

      repeat
        BandString:= CabecalhoOSP;
        BreakToLine;
        WriteBand(qryOsp.Fields);

        MontarGradeFioseFitas;
        MontarLinhasObservacoesOSP;
        BandString:= obsVoltasOhmsOSP;
        BreakToLine;
        WriteBand(qryListaFioseFitas.Fields);

        MontarLinhasObservacoes;
        MontarGradeprodutosCompostos;
        BandString:= ObsListaComponentesOSP;
        BreakToLine;
        WriteBand(qryListaComponentes.Fields);

        if qryFluxogramasOperacoes.RecordCount > 0 then
        begin
          BandString:= OperacoesOSP;
          BreakToLine;
          qryFluxogramasOperacoes.DisableControls;
          if Pagina = 1 then
            qryFluxogramasOperacoes.First;
          Count:= 0;
          while not qryFluxogramasOperacoes.Eof do
          begin
            WriteBand(qryFluxogramasOperacoes.Fields);
            qryFluxogramasOperacoes.Next;
            Inc(Count);
            if Count >= ProdPag then
              Break;
          end;
          qryFluxogramasOperacoes.EnableControls;
        end;

        FormFeed;

        {$IFNDEF LINUX}
        if Pagina < QtdePaginas then
        begin
          WriteTextln('',0);
          WriteTextln('',0);
        end;
        {$ENDIF}

        Inc(Pagina);
      until Pagina > QtdePaginas;
      EndDoc('TecLUX - Emissão de OSP');
    end;
  except
    on E: Exception do
    begin
      ShowMessage(E.Message);
      result := false;
    end;
  end;
end;

function TdtmImprimeOsp.ImprimirSetup(Osp, Operacao: Integer; Impressora: String): Boolean;
var Pagina, QtdePaginas, SetupAux, SetupPag, Count: Integer;
begin
  try

    if Impressora = '' then
      NomeImpressoraEscolhida:= ParSistema.NomeImpressoraSetupProcesso
    else
      NomeImpressoraEscolhida:= Impressora;

    Pagina  := 1;
    SetupAux:= 0;
    Result  := true;

    with TextPrinter do
    begin
      BeginDoc(ConfigurarSetup);
      SetupPag      := ProductPerPage(ConfigurarSetup);

      if Pagina = 1 then
      begin
        qrySetupOperacoes.DisableControls;
        GuardarRegistroAtual(qrySetupOperacoes, True);
        qrySetupOperacoes.First;
        while not qrySetupOperacoes.Eof do
        begin
          inc(SetupAux);
          qrySetupOperacoes.Next;
        end;
        VoltarRegistroAtual(qrySetupOperacoes);
        qrySetupOperacoes.EnableControls;
      end;

      if (SetupAux <= SetupPag) then
        QtdePaginas:= 1
      else
      begin
        QtdePaginas:= SetupAux div SetupPag;
        if (SetupAux mod SetupPag) > 0 then
          Inc(QtdePaginas);
      end;

      repeat
        BandString:= CabecalhoSetup;
        BreakToLine;
        WriteBand(qrySetupOperacoes.Fields);

        if qrySetupOperacoes.RecordCount > 0 then
        begin
          BandString:= ListaSetup;
          BreakToLine;
          qrySetupOperacoes.DisableControls;
          if Pagina = 1 then
            qrySetupOperacoes.First;
          Count:= 0;
          while not qrySetupOperacoes.Eof do
          begin
            WriteBand(qrySetupOperacoes.Fields);
            qrySetupOperacoes.Next;
            Inc(Count);
            if Count >= SetupPag then
              Break;
          end;
          qrySetupOperacoes.EnableControls;
        end;

        MontarLinhasDescricaoSetUp;
        BandString:= DescricaoOperacoes;
        BreaktoLine;
        WriteBand(qryListaDescricao.Fields);

        BandString:= RodapeSetup;
        BreakToLine;
        WriteBand(qrySetupOperacoes.Fields);

        FormFeed;

        {$IFNDEF LINUX}
        if Pagina < QtdePaginas then
          WriteTextln('',0);
        {$ENDIF}
        Inc(Pagina);
      until Pagina > QtdePaginas;
      EndDoc('TecLUX - Emissão de SET-UP de Processo');
    end;

  except
    on E: Exception do
    begin
      ShowMessage(E.Message);
      result := false;
    end;
  end;

end;


function TdtmImprimeOsp.MensagemImpressao(MSG: String): Boolean;
begin
  Result:= False;
  if MensagemSimNaoOpcaoCancelar(Format(ctMENSAGEMIMPRIMIR,[MSG]),'',false) = mryes then
  begin
    MensagemAviso('Troque o Formulário na Impressora.');
    Result:= True;
  end;
end;

procedure TdtmImprimeOsp.MontarGradeFioseFitas;
var n, m: Integer;
    PesoFio: Real;
begin
  n:= 2;
  m := 1;

  if qryListaFioseFitas.Active
  then qryListaFioseFitas.Close;

  qryListaFioseFitas.Open;
  qryListaFioseFitas.Delete;

  qryFios.First;
  while not qryFios.Eof do
  begin
    qryListaFioseFitas.Edit;
    qryListaFioseFitas.FieldByName('referencia'+inttostr(n)).AsString:= qryFioscomponente.AsString;
    qryListaFioseFitas.FieldByName('voltas'+inttostr(n)).AsString:= qryFiosnrvoltas.AsString;
    qryListaFioseFitas.FieldByName('resistividade'+inttostr(n)).AsString:= FormatFloat('##0.000',qryFiosresistividade.AsFloat);
    qryListaFioseFitas.FieldByName('tolerancia'+inttostr(n)).AsString:= FormatFloat('##0',qryFiosTolerancia.AsFloat);
    PesoFio:= qryFiosGramasPorPeca.AsFloat * qryOspQuantidade.AsFloat / 1000.;
    qryListaFioseFitas.FieldByName('quantidade'+inttostr(n)).AsString:= FormatFloat('##0.0000',PesoFio);
    qryListaFioseFitas.Post;
    qryFios.Next;
    inc(m);
    inc(n);
    inc(n); {imprime nas linhas 2 4 6 8}
    if m = 5 then
      break;
  end;

  if m <= 4 then
  begin

    qryFitas.First;
    while not qryFitas.Eof do
    begin
      qryListaFioseFitas.Edit;
      qryListaFioseFitas.FieldByName('referencia'+inttostr(n)).AsString:= qryFitascomponente.AsString;
      qryListaFioseFitas.FieldByName('voltas'+inttostr(n)).AsString:= qryFitasnrvoltas.AsString;
      qryListaFioseFitas.FieldByName('resistividade'+inttostr(n)).AsString:= ''{FormatFloat('##0.000',qryFitastolerancia.AsFloat)};
      qryListaFioseFitas.Post;
      qryFitas.Next;
      inc(m);
      inc(n);
      inc(n); {imprime nas linhas 2 4 6 8}

      if m = 5 then
        break;
    end;

  end;

end;

procedure TdtmImprimeOsp.MontarGradeProdutosCompostos;
var n: Integer;
begin
  n:= 1;
  qryProdutosCompostos.DisableControls;
  qryProdutosCompostos.First;
  while not qryProdutosCompostos.Eof do
  begin
    qryListaComponentes.Edit;
    if uppercase(qryProdutosCompostosunidade.AsString) = 'MIL' then
      qryListaComponentes.FieldByName('qtde'+inttostr(n)).AsString:= FormatFloat('###,###,##0.000',qryProdutosCompostosquantidade.AsFloat)+' '+'PC'
    else
      qryListaComponentes.FieldByName('qtde'+inttostr(n)).AsString:= FormatFloat('###,###,##0.000',qryProdutosCompostosquantidade.AsFloat)+' '+
                                                                     qryProdutosCompostosunidade.AsString;

    qryListaComponentes.FieldByName('descricao'+inttostr(n)).AsString:= qryProdutosCompostoscodigovisual.AsString{+' - '+qryProdutosCompostosdescricao.AsString};
    qryListaComponentes.Post;
    qryProdutosCompostos.Next;
    inc(n);
  end;
  qryProdutosCompostos.EnableControls;
end;

procedure TdtmImprimeOsp.MontarLinhasObservacoes;
var I,J, Inicio, Fim, Espaco: integer;
    vQuebraLinha, vQuebraLinhaeTamanho : vString;
    vTexto, vTextoAux : String;
begin

  vQuebraLinha := nil;

  {quebrar os enters}
  if Length(qryOspdadosmarcacao.AsString) > 0 then
  begin
    if pos(#13, qryOspdadosmarcacao.AsString) = 0 then
    begin
      SetLength(vQuebraLinha, length(vQuebraLinha)+1);
      vQuebraLinha[0] := qryOspdadosmarcacao.AsString;
    end
    else
    begin
      I := 0;
      vTexto := qryOspdadosmarcacao.AsString;
      while (vTexto <> '') do
      begin
        SetLength(vQuebraLinha, length(vQuebraLinha)+1);
        Inicio := 1;
        Fim := pos(#13, vTexto);

        if Fim = 0 then begin
           Fim := length(vTexto);
           vTextoAux := copy(vTexto, Inicio, Fim);
        end
        else vTextoAux := copy(vTexto, Inicio, Fim-1);
        vQuebraLinha[i] := vTextoAux;
        inc(i);
        vTexto := copy(vTexto, Fim+2, length(vTexto));
      end;
    end;
  end;

  J := 0;

  for i:=0 to length(vQuebraLinha)-1 do
  begin
    if vQuebraLinha[i] = '' then
    begin
      SetLength(vQuebraLinhaeTamanho, length(vQuebraLinhaeTamanho)+1);
      vQuebraLinhaeTamanho[j] := '';
      inc(j);
    end
    else
    begin
      Inicio:= 0;
      Espaco:= 21;
      Fim:= Espaco;
      vTexto := Copy(vQuebraLinha[i],(Inicio+1),Fim);
      while vTexto <> '' do
      begin
        SetLength(vQuebraLinhaeTamanho, length(vQuebraLinhaeTamanho)+1);
        vQuebraLinhaeTamanho[j] := vTexto;
        Inicio:= Inicio +(Espaco+1);
        if (Length(vQuebraLinha[i])>(FIM+Espaco)) then
          Fim:= Fim+Espaco
        else
          Fim:= Fim+(Length(vQuebraLinha[i])-Espaco);
        vTexto := Copy(vQuebraLinha[i],(Inicio),Fim);
        inc(j);
      end;
    end;
  end;

  if qryListaComponentes.active then
    qryListaComponentes.close;

  qryListaComponentes.Open;
  qryListaComponentes.delete;

  for i:=0 to length(vQuebraLinhaeTamanho)-1 do
  begin
    if i > 4 then
      break;
    qryListaComponentes.Edit;
    qryListaComponentes.FieldByName(('dados'+inttostr(i+1))).AsString := vQuebraLinhaeTamanho[i];
    qryListaComponentes.Post;
  end;

end;

procedure TdtmImprimeOsp.MontarLinhasObservacoesOSP;
const
  Fim = 50;
var I, Inicio: integer;
begin
  I:= 1;
  Inicio:= 1;
  if Length(qryOspobservacoes.AsString) > 0 then
  begin
    while  i <= 8 do
    begin
      qryListaFioseFitas.edit;
      if Copy(qryOspobservacoes.AsString,Inicio,Fim)<> '' then
        qryListaFioseFitas.FieldByName(('obslinha'+inttostr(i))).AsString:= Copy(qryOspobservacoes.AsString,Inicio,Fim)
      else
        qryListaFioseFitas.FieldByName(('obslinha'+inttostr(i))).AsString:= '';

      qryListaFioseFitas.Post;

      Inicio:= Inicio + fim ;

      inc(i);
    end;
  end;
end;

procedure TdtmImprimeOsp.ObterDadosControleProcesso(OSP, Operacao: integer);
begin
  RefazConsultaPorNome(qryControleProcesso,['OSP','Operacao'],
                                           [OSP, Operacao]);
end;

procedure TdtmImprimeOsp.ObterDadosOSP(OSP, Lote: Integer);
begin
  RefazConsultaporNome(qryOsp,['numero', 'numerolote'],[OSP, Lote]);

  if qryOspnumero.AsInteger > 0 then
  begin
    RefazConsultaPorNome(qryClientesProdutos,    ['cliente','tipocliente','produto'],[qryOspcliente.AsVariant, qryOsptipocliente.AsVariant, qryOspproduto.AsVariant]);
    RefazConsultaPorNome(qryProdutosCompostos,   ['composto'],[qryOspproduto.AsVariant]);
    RefazConsultaPorNome(qryFios,          ['composto'],[qryOspproduto.AsVariant]);
    RefazConsultaPorNome(qryFitas,          ['composto'],[qryOspproduto.AsVariant]);
    RefazConsultaPorNome(qryFluxogramasOperacoes,['fluxograma'],[qryOspfluxograma.AsVariant]);
  end;
end;

procedure TdtmImprimeOsp.ObterDadosSetup(OSP, Operacao: integer; UsuarioSetup: integer = 0; NomeUsuarioSetup: String = '');
begin
  RefazConsultaPorNome(qrySetupOperacoes,['OSP','Operacao','UsuarioSetup','NomeUsuarioSetup'],
                                         [OSP, Operacao, UsuarioSetup, NomeUsuarioSetup]);

  RefazConsultaPorNome(qryDescricaoOperacoes,['Operacao'],[Operacao]);
end;

procedure TdtmImprimeOsp.qryOspCalcFields(DataSet: TDataSet);
begin
  inherited;
  qryOsppartnumber.AsString := qryOsppn.AsString+'.'+qryOsporigem.AsString+'.'+qryOsprevisao.AsString;
end;



procedure TdtmImprimeOsp.MontarLinhasDescricaoSetUp;
var I,J, Inicio, Fim, Espaco: integer;
    vQuebraLinha, vQuebraLinhaeTamanho : vString;
    vTexto, vTextoAux : String;
begin

  vQuebraLinha := nil;

  {quebrar os enters}
  if Length(qryDescricaoOperacoesdescricaosetup.AsString) > 0 then
  begin
    if pos(#13, qryDescricaoOperacoesdescricaosetup.AsString) = 0 then
    begin
      SetLength(vQuebraLinha, length(vQuebraLinha)+1);
      vQuebraLinha[0] := qryDescricaoOperacoesdescricaosetup.AsString;
    end
    else
    begin
      I := 0;
      vTexto := qryDescricaoOperacoesdescricaosetup.AsString;
      while (vTexto <> '') do
      begin
        SetLength(vQuebraLinha, length(vQuebraLinha)+1);
        Inicio := 1;
        Fim := pos(#13, vTexto);

        if Fim = 0 then begin
          Fim := length(vTexto);
          vTextoAux := copy(vTexto, Inicio, Fim);
        end
        else vTextoAux := copy(vTexto, Inicio, Fim-1);

        vQuebraLinha[i] := vTextoAux;
        inc(i);
        vTexto := copy(vTexto, Fim+2, length(vTexto));
      end;
    end;
  end;

  J := 0;

  for i:=0 to length(vQuebraLinha)-1 do
  begin
    if vQuebraLinha[i] = '' then
    begin
      SetLength(vQuebraLinhaeTamanho, length(vQuebraLinhaeTamanho)+1);
      vQuebraLinhaeTamanho[j] := '';
      inc(j);
    end
    else
    begin
      Inicio:= 0;
      Espaco:= 80;
      Fim:= Espaco;
      vTexto := Copy(vQuebraLinha[i],(Inicio+1),Fim);
      while vTexto <> '' do
      begin
        SetLength(vQuebraLinhaeTamanho, length(vQuebraLinhaeTamanho)+1);
        vQuebraLinhaeTamanho[j] := vTexto;
        Inicio:= Inicio +(Espaco+1);
        if (Length(vQuebraLinha[i])>(FIM+Espaco)) then
          Fim:= Fim+Espaco
        else
          Fim:= Fim+(Length(vQuebraLinha[i])-Espaco);
        vTexto := Copy(vQuebraLinha[i],(Inicio),Fim);
        inc(j);
      end;
    end;
  end;

  if qryListaDescricao.active then
    qryListaDescricao.close;
    
  qryListaDescricao.Open;
  qryListaDescricao.delete;

  for i:=0 to length(vQuebraLinhaeTamanho)-1 do
  begin
    if i > 11 then
      break;
    qryListaDescricao.Edit;
    qryListaDescricao.FieldByName(('descricao'+inttostr(i+1))).AsString := vQuebraLinhaeTamanho[i];
    qryListaDescricao.Post;
  end;
end;

procedure TdtmImprimeOsp.MontarLinhasPlanoControle;
var Tolerancia: array[1..4] of String[100];
    Tecnica:    array[1..4] of string[100];


    {--------------------------------------------------------------------------}
    Procedure QuebrarLinhas(var ParaOnde;
                                DeOnde:   string;
                                Tamanho:  integer);
    var Linhas:   array[1..4] of string[100] absolute ParaOnde;
        Original: string;
        NL:       integer;

    begin
        Fillchar(Linhas,SizeOf(Linhas),0);
        Original:= Copy(DeOnde, 1, 4 * Tamanho);
        if Original <> '' then begin
           NL:= 1;
           while (NL <= 4) and (Length(Original) > 0) do begin
               Original:= TrimLeft(Original);
               if (Pos(#13, Original) = 0) or
                  (Pos(#13, Original) > Tamanho) then begin
                  Linhas[NL]:= Copy(Original,1,Tamanho);
                  if (Length(Original) > Tamanho)        and
                     (Copy(Original,Tamanho+1,1) <> ' ') and
                     (Copy(Original,Tamanho+1,1) <> #13) and
                     (Pos(' ', Linhas[NL]) > 1)
                  then while (Length(Linhas[NL]) > 1) and
                              (Linhas[NL][Length(Linhas[NL])] <> ' ') do
                         Delete(Linhas[NL],Length(Linhas[NL]),1);
                  Linhas[NL]:= TrimRight(Linhas[NL]);
                  Delete(Original,1,Length(Linhas[NL]));
               end
               else begin
                  Linhas[NL]:= Copy(Original, 1, Pos(#13, Original)-1);
                  Delete(Original,1,Length(Linhas[NL])+2);   {2 = Length(#13#10}
              end;
              inc(NL);
           end;
       end;
     end; {QuebrarLinhas}


begin

   QuebrarLinhas(Tolerancia, qryControleProcessoTolerancia.AsString, 39);
   QuebrarLinhas(Tecnica,    qryControleProcessoTecnica.   AsString, 39);

   if qryListaControleProcesso.active then
     qryListaControleProcesso.close;

   qryListaControleProcesso.Open;
   qryListaControleProcesso.delete;

   qryListaControleProcesso.Edit;
   qryListaControleProcessoTolerancia1.AsString := Tolerancia[1];
   qryListaControleProcessoTolerancia2.AsString := Tolerancia[2];
   qryListaControleProcessoTolerancia3.AsString := Tolerancia[3];
   qryListaControleProcessoTolerancia4.AsString := Tolerancia[4];

   qryListaControleProcessoTecnica1.   AsString := Tecnica[1];
   qryListaControleProcessoTecnica2.   AsString := Tecnica[2];
   qryListaControleProcessoTecnica3.   AsString := Tecnica[3];
   qryListaControleProcessoTecnica4.   AsString := Tecnica[4];

   qryListaControleProcessoFrequencia. AsString := qryControleProcessoFrequencia.AsString;
   if qryControleProcessotamanho.AsInteger > 0
   then qryListaControleProcessoTamanho.AsInteger:= qryControleProcessotamanho.AsInteger
   else qryListaControleProcessoTamanho.AsString := '';
   qryListaControleProcesso.Post;
end;



end.




