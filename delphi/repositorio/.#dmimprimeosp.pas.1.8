function TdtmImprimeOsp.ImpressaoControleProcesso(OSP, Lote: Integer;
  Impressora: String): Boolean;
begin
  result := true;
  RefazConsultaPorNome(qryOperacoesProcesso,['OSP'],[OSP]);
  if qryOperacoesProcesso.RecordCount > 0 then
  begin
    qryOperacoesProcesso.First;
    while not qryOperacoesProcesso.Eof do
    begin
      ObterDadosControleProcesso(OSP,Lote, qryOperacoesProcessooperacao.AsInteger);
      if qryControleProcesso.RecordCount <> 0 then
        result := ImprimirControleProcesso(Impressora);
      if result then
        qryOperacoesProcesso.next
      else
        break;
    end;
  end;

end;

function TdtmImprimeOsp.ImpressaoSetup(OSP, Lote: Integer; Impressora: String): Boolean;
var Operacao: Integer;
begin
  result := true;
  RefazConsultaPorNome(qryOperacoesSetup,['OSP'],[OSP]);
  if qryOperacoesSetup.RecordCount > 0 then
  begin
    qryOperacoesSetup.First;
    while not qryOperacoesSetup.Eof do
    begin
      Operacao:= qryOperacoesSetupoperacao.AsInteger;
      ObterDadosSetup(OSP,Lote, Operacao);
      if qrySetupOperacoes.RecordCount <> 0 then
        result := ImprimirSetup(OSP,Operacao,Impressora);

      if result then
        qryOperacoesSetup.next
      else
        break;
    end;
  end;
//  else
//    MensagemAviso(format(ctNENHUMREGISTROENCONTRADO,['Registro']));
end;

function TdtmImprimeOsp.ImpressaoControleProcesso(OSP, Lote,
  Operacao: Integer; UsuarioSetup : Integer; NomeUsuarioSetup: String; Impressora: String): Boolean;
begin
  result := true;
  ObterDadosControleProcesso(OSP,Lote, Operacao, UsuarioSetup, NomeUsuarioSetup);
  if qryControleProcesso.RecordCount <> 0 then
