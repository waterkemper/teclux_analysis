procedure TdtmLancamentoContabilidade.AtualizarParametros(Filial,
  ResultadoSintetica, ResultadoAnalitica, historico:integer);
begin
  qryParametros.Close;
  qryParametros.Open;
  if qryparametros.Locate('parametro;filial',varArrayof([221,Filial]),[]) then
  begin
    qryParametros.Edit;
    qryParametrosvalor.AsString := inttostr(ResultadoSintetica);
    qryparametros.Post;
  end
  else
  begin
    qryParametros.Append;
    qryParametrosfilial.AsInteger := filial;
    qryParametrosparametro.AsInteger := 221;
    qryParametrosvalor.AsString := inttostr(ResultadoSintetica);
    qryParametros.Post;
  end;

  if qryparametros.Locate('parametro;filial',varArrayof([222,Filial]),[]) then
  begin
    qryParametros.Edit;
    qryParametrosvalor.AsString := inttostr(ResultadoAnalitica);
    qryparametros.Post;
  end
  else
  begin
    qryParametros.Append;
    qryParametrosfilial.AsInteger := filial;
    qryParametrosparametro.AsInteger := 222;
    qryParametrosvalor.AsString := inttostr(ResultadoAnalitica);
    qryParametros.Post;
  end;

  if qryparametros.Locate('parametro;filial',varArrayof([223,Filial]),[]) then
  begin

    if historico<>0 then
    begin
      qryParametros.Edit;
      qryParametrosvalor.AsString := inttostr(historico);
      qryparametros.Post;
    end
    else
      qryParametros.Delete;
  end
  else
  begin
    if historico<>0 then
    begin
      qryParametros.Append;
      qryParametrosfilial.AsInteger := filial;
      qryParametrosparametro.AsInteger := 223;
      qryParametrosvalor.AsString := inttostr(historico);
      qryParametros.Post;
    end;
  end;
  perpetrar([qryparametros]);
end;

procedure TdtmLancamentoContabilidade.AtualizarParametrosContaResultado(
  DemonstrativaResultados: integer);
begin
  qryParametros.Close;
  qryParametros.Open;
  if qryparametros.Locate('parametro',226,[]) then
  begin
    qryParametros.Edit;
    qryParametrosvalor.AsString := inttostr(DemonstrativaResultados);
    qryparametros.Post;
  end
  else
  begin
    qryParametros.Append;
    qryParametrosfilial.asvariant := null;
    qryParametrosparametro.AsInteger := 226;
    qryParametrosvalor.AsString := inttostr(DemonstrativaResultados);
    qryParametros.Post;
  end;
  perpetrar([qryparametros]);
end;

function TdtmLancamentoContabilidade.ObterAutorizacaodoUsuario: Boolean;
var
  Usuario           : TtecUsuarios;
begin
  Result:= False;
  Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
  try
    if UsuarioLogin.AlterarDadosContabeis then
         Usuario:= ObterAutorizacao(taSENHA)
    else Usuario:= ObterAutorizacao(taLOGIN, ctALTERARDADOSCONTABEIS, ctAUTORIZADO);
    if Assigned(Usuario) then begin
      if Usuario.AlterarDadosContabeis then
        Result:= True
      else
        MensagemAviso(ctUSUARIOSEMPERMISSAO);
    end;
  finally
    Usuario.Free;
  end;
end;

