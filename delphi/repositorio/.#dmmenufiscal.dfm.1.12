    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select dic.*,'
      
        '       case when hash_paf_registro_r05=md5(dc.num_fab||cast(dc.c' +
        'oo as varchar)||cast(dlc.ccf as varchar)||cast(cod_item as varch' +
        'ar)||cast(qtde_item as varchar)||cast(vl_unit as varchar)||cast(' +
        'vl_tot_item as varchar)||cast(cod_tot_parc as varchar)||cast(ind' +
        '_canc as varchar)) then'
