  object qryMeiosPagto: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'SELECT ecf,filial,data,tipodocto,meiopagto,cast(null as varchar)' +
        ' as categoria,sum(valor) AS valoracumulado'
      'FROM'
      '('
      ' (SELECT a.ecf,a.coo,'
      '         a.filial,'
      '         a.data,'
      '         fca.valor,'
      
        '         CASE WHEN fca.tipo='#39'DN'#39' THEN CAST('#39'Dinheiro'#39' AS varchar' +
        ') ELSE CAST('#39'CHEQUE'#39' AS VARCHAR) END AS meiopagto,'
      '         CAST('#39'CF'#39' AS varchar) AS tipodocto'
      
        '  FROM autenticacoes a JOIN frentedecaixaautenticacoes fca ON a.' +
        'numero = fca.autenticacao'
      '  WHERE a.filial = :filialbase'
      '    AND a.data BETWEEN :datainicial AND :datafinal'
      '    AND a.tipo = '#39'F'#39
      '    AND fca.tipo IN  ('#39'DN'#39','#39'CH'#39')'
      '    AND a.ecf = :ecf'
      ' )'
      ' UNION'
      ' (SELECT a.ecf,a.coo,'
      '         a.filial,'
      '         a.data,'
      '         a.valor,'
      '         CAST('#39'Dinheiro'#39' AS varchar) AS meiopagto,'
      '         CAST('#39'CNF'#39' AS varchar) AS tipodocto'
      '  FROM autenticacoes a'
      '  WHERE filial = :filialbase'
      '    AND data BETWEEN :datainicial AND :datafinal'
      '    AND tipo IN ('#39'B'#39','#39'D'#39','#39'E'#39','#39'G'#39','#39'N'#39','#39'S'#39')'
      '    AND ecf = :ecf'
      ' )'
      ' UNION'
      ' (SELECT a.ecf,a.coo,'
      '         a.filial,'
      '         a.data,'
      '         a.valor,'
      '         CAST('#39'CHEQUE'#39' as varchar) AS meiopagto,'
      '         CAST('#39'CF'#39' AS varchar) AS tipodocto'
      '  FROM autenticacoes a'
      '  WHERE filial = :filialbase'
      '    AND data BETWEEN :datainicial AND :datafinal'
      '    AND tipo = '#39'H'#39
      '    AND ecf = :ecf'
      ' )'
      ' UNION'
      ' (SELECT a.ecf,a.coo,'
      '         a.filial,'
      '         a.data,'
      '         a.valor,'
      
        '         CAST((CASE WHEN a.tipotransacao = '#39'C'#39' THEN '#39'C. CREDITO ' +
        #39
      '                    ELSE '#39'C. DEBITO '#39
      
        '              END) || coalesce(a.administradora,'#39#39') AS varchar) ' +
        'AS meiopagto,'
      '         CAST('#39'CF'#39' AS varchar) AS tipodocto'
      '  FROM autenticacoes a'
      '  WHERE a.filial = :filialbase'
      '    AND a.data BETWEEN :datainicial AND :datafinal'
      '    AND a.tipo = '#39'T'#39
      '    AND a.ecf = :ecf'
      ' )'
      ') AS t'
      'GROUP BY ecf,filial,tipodocto,meiopagto,data'
      'ORDER BY data, meiopagto desc, tipodocto')
    RequestLive = True
    Left = 176
    Top = 200
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'filialbase'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ecf'
        ParamType = ptUnknown
      end>
    object qryMeiosPagtoecf: TIntegerField
      FieldName = 'ecf'
      DisplayFormat = '0'
    end
    object qryMeiosPagtofilial: TIntegerField
      FieldName = 'filial'
      DisplayFormat = '0'
    end
    object qryMeiosPagtodata: TDateField
      Alignment = taCenter
      FieldName = 'data'
      EditMask = '99/99/9999;1; '
    end
    object qryMeiosPagtotipodocto: TStringField
      FieldName = 'tipodocto'
      Size = 50
    end
    object qryMeiosPagtovaloracumulado: TFloatField
      FieldName = 'valoracumulado'
      DisplayFormat = '0.00'
    end
    object qryMeiosPagtomeiopagto: TStringField
      FieldName = 'meiopagto'
      Size = 50
    end
    object qryMeiosPagtocategoria: TStringField
      FieldName = 'categoria'
      Size = 50
    end
  end
