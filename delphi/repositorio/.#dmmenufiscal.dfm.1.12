  object qryFormasPagamentoCupom: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkFields = 'filial=filial; num_usu=num_usu; cro=cro;  coo=coo'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrDadosCupom
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select fp.*,'
      '       dlc.ccf,'
      '       case when'
      
        '         hash_paf_registro_r07=md5(dc.num_fab||cast(dc.coo as va' +
        'rchar)||cast(COALESCE(dlc.ccf,0) as varchar))'
      '       then'
      '          true'
      '       else'
      '          false'
      '       end as registrovalido'
      'from dadoscupom dc'
      '     join detalhecupom dlc'
      '       on  dc.filial = dlc.filial'
      '       and dc.num_usu = dlc.num_usu'
      '       and dc.cro = dlc.cro'
      '       and dc.coo = dlc.coo'
      '     join formaspagamentoecf fp'
      '       on  dc.filial = fp.filial'
      '       and dc.num_usu = fp.num_usu'
      '       and dc.cro = fp.cro'
      '       and dc.coo = fp.coo'
      
        'where cast(dlc.dt_ini as date) between :datainicial and :datafin' +
        'al'
      '  and dc.codigo_ecf = :num_fab'
      'order by dc.num_usu, dc.cro, dc.coo, fp.num_item, dc.filial')
    RequestLive = False
    Left = 56
    Top = 360
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'num_fab'
        ParamType = ptUnknown
      end>
