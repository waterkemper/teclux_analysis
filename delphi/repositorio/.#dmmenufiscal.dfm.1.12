  object qryDadosCupom: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select dc.num_fab,'
      '       dlc.*,'
      
        '       case when hash_paf_registro_r04=md5(dc.Num_fab||cast(dlc.' +
        'ccf as varchar)||cast(dc.coo as varchar)||cast(dlc.vl_tot as var' +
        'char)||cast(dlc.canc as varchar)) then'
      '        true'
      '       else'
      '        false'
      '       end as registrovalido'
      'from dadoscupom dc'
      '     join detalhecupom dlc'
      '       on  dc.filial = dlc.filial'
      '       and dc.num_usu = dlc.num_usu'
      '       and dc.cro = dlc.cro'
      '       and dc.coo = dlc.coo'
      
        'where cast(dlc.dt_ini as date) between :datainicial and :datafin' +
        'al'
      '  and dc.codigo_ecf = :num_fab/*dc.num_fab = :num_fab*/'
      '  '
      
        'order by dc.num_fab, dc.num_usu, dc.cro, dc.coo, dlc.ccf, dc.fil' +
        'ial')
    RequestLive = False
    Left = 56
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'num_fab'
        ParamType = ptUnknown
      end>
