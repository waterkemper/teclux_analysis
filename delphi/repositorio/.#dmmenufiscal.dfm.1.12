  object qryDadosECF: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      'select serie,mfadicional,tipo,marca,modelodescricao,'
      
        '       CASE WHEN hash_paf_registro_r01=hash_paf_registro_r01_cal' +
        'culado THEN true ELSE false END as registrovalido,'
      '       versao_sb,data_sb,maquina,cnpj,ie,'
      
        '        codigo,filial,intervencao,cniee,modelo,grandetotal,venda' +
        'bruta,'
      
        '        CASE WHEN (select hash_calculado from hash_inclusao_excl' +
        'usao WHERE nome_registro='#39'MOVECF'#39') ='
      '                  ('
      '                      md5(('#9'select cast(sum(total) as varchar)'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'from'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'('
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from ecfs'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'union'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from reducoesz'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'union'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from reducoeszdetalhes'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'union'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from dadoscupom'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'union'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from dadositemcupom'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'union'
      
        #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from detalhedemaisdocto' +
        's'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'union'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from detalhecupom'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'union'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from formaspagamentoecf'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9#9') as sel'
      #9#9#9#9#9#9#9#9#9#9#9#9#9#9'))'
      '                  )'
      '        THEN'
      '           false'
      '        else'
      '            true'
      '        end as inclusao_exclusao'
      ''
      'from'
      '('
      '  select *,'
      
        '       md5(serie || mfadicional||tipo||marca||modelodescricao||v' +
        'ersao_sb ||cast(data_sb as varchar)||cast(maquina as varchar)||c' +
        'ast(cnpj as varchar)||COALESCE(ie,'#39#39#39#39')) as hash_paf_registro_r0' +
        '1_calculado'
      ''
      '  from ecfs'
      '  where  codigo = :codigo'
      ') as sel')
    RequestLive = False
    Left = 288
    Top = 168
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
