  object qryDadosItemCupom: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkFields = 'filial=filial; num_usu=num_usu; cro=cro;  coo=coo'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrDadosCupom
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select dic.*,'
      
        '       case when upper(hash_paf_registro_r05)=upper(md5(dc.num_f' +
        'ab||cast(dc.coo as varchar)||cast(dlc.ccf as varchar)||cast(cod_' +
        'item as varchar)||cast(qtde_item as varchar)||cast(vl_unit as va' +
        'rchar)||cast(vl_tot_item as varchar)||cast(cod_tot_parc as varch' +
        'ar)||cast(ind_canc as varchar))) then'
      '         true'
      '       else'
      '         false'
      '       end as registrovalido'
      'from dadoscupom dc'
      '     join detalhecupom dlc'
      '       on  dc.filial = dlc.filial'
      '       and dc.num_usu = dlc.num_usu'
      '       and dc.cro = dlc.cro'
      '       and dc.coo = dlc.coo'
      '     join dadositemcupom dic'
      '       on  dc.filial = dic.filial'
      '       and dc.num_usu = dic.num_usu'
      '       and dc.cro = dic.cro'
      '       and dc.coo = dic.coo'
      
        'where cast(dlc.dt_ini as date) between :datainicial and :datafin' +
        'al'
      '  and dc.num_fab = :num_fab'
      'order by dc.num_usu, dc.cro, dc.coo, dic.num_item, dc.filial')
    RequestLive = False
    Left = 56
    Top = 312
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datainicial'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'datafinal'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'num_fab'
