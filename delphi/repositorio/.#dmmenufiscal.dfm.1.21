  object qryNotas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.numero as dadofiscal,'
      '       f.cnpj,'
      '       df.data as emissao,'
      '       df.valorvista as subtotal,'
      ''
      
        '       case when df.valorvista > df.valortotal then df.valorvist' +
        'a - df.valortotal'
      '       else 0.00 end as DescSubtotal,'
      ''
      '       df.TipoDescSubtotal,'
      ''
      
        '       case when df.valorvista < df.valortotal then df.valortota' +
        'l - df.valorvista'
      '       else 0.00 end as AcrescSubtotal,'
      '       df.TipoAcrescSubtotal,'
      ''
      '       df.valortotal as TotalLiquido,'
      ''
      
        '       case when df.situacao = '#39'C'#39' then cast('#39'S'#39' as char(1)) els' +
        'e cast('#39'N'#39' as char(1)) end as IndCanc,'
      '       df.CancAcrescSubTotal,'
      ''
      '       df.OrdemAplicDesc_e_Acresc,'
      ''
      
        '       cast (case when df.hash_paf_registro_j1 = md5( cast(f.cnp' +
        'j as varchar)||'
      
        '                                                 cast(df.data as' +
        ' varchar)||'
      
        '                                                 cast(df.valorvi' +
        'sta as varchar)||'
      
        '                                                 cast((case when' +
        ' df.valorvista > df.valortotal then df.valorvista - df.valortota' +
        'l'
      
        '                                                       else 0.00' +
        ' end) as varchar)||'
      ''
      #9#9#9#9#9#9#9#9#9#9#9#9' cast(df.TipoDescSubtotal as varchar)||'
      ''
      
        '                                                 cast((case when' +
        ' df.valorvista < df.valortotal then df.valortotal - df.valorvist' +
        'a'
      
        '                                                       else 0.00' +
        ' end) as varchar)||'
      #9#9#9#9#9#9#9#9#9#9#9#9' cast(df.TipoAcrescSubtotal as varchar)||'
      
        '                                                 cast(df.valorto' +
        'tal as varchar)||'
      
        '                                                 cast((case when' +
        ' df.situacao = '#39'C'#39' then cast('#39'S'#39' as char(1)) else cast('#39'N'#39' as ch' +
        'ar(1)) end) as varchar)||'
      ''
      
        '                                                 cast(df.CancAcr' +
        'escSubTotal as varchar)||'
      ''
      
        '                                                 cast(df.OrdemAp' +
        'licDesc_e_Acresc as varchar)||'
      
        '                                                 cast(coalesce(d' +
        'f.nome,'#39#39') as varchar)||'
      
        '                                                 cast(coalesce(d' +
        'f.pessoanumero,'#39#39') as varchar)||'
      
        '                                                 cast(n.numero a' +
        's varchar)||'
      
        '                                                 cast(n.serie as' +
        ' varchar)||'
      
        '                                                 cast(coalesce(d' +
        'f.chv_nfe,'#39#39') as varchar)||'
      
        '                                                 cast((case when' +
        ' df.modelodocto in ('#39'55'#39') then 2'
      
        '                                                            when' +
        ' df.modelodocto in ('#39'65'#39') then 3'
      
        '                                                            else' +
        ' 1'
      
        '                                                       end) as v' +
        'archar)'
      
        '                                                ) then rpad(df.n' +
        'ome,40,'#39' '#39') else rpad(df.nome,40,'#39'?'#39') end as varchar(40)) as  No' +
        'medoCliente,'
      ''
      '       df.pessoanumero as CPF_ou_CNPJ_Cliente,'
      '       n.numero as NumeroNota,'
      '       n.serie as SerieNota,'
      
        '       case when df.chv_nfe is null then cast(repeat('#39'0'#39',44) as ' +
        'varchar(44)) else df.chv_nfe end as chv_nfe,'
      '       case when df.modelodocto in ('#39'55'#39') then 2'
      '            when df.modelodocto in ('#39'65'#39') then 3'
      '            else 1'
      '       end as TipodeDocumento'
      ''
      'from dadosfiscais df'
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join filiais f'
      '     on df.filialemissao = f.codigo'
      ''
      'where df.data between :dataInicial and :dataFinal'
      
        '  and ((df.modelodocto in ('#39'55'#39','#39'65'#39') and df.numprotocolonfe is ' +
        'not null) or'
      '       (df.modelodocto not in ('#39'55'#39','#39'65'#39')))'
      ''
      'order by df.numero')
    RequestLive = False
    Left = 240
    Top = 384
    ParamData = <
      item
        DataType = ftString
        Name = 'dataInicial'
        ParamType = ptUnknown
        Value = '2016-10-01'
      end
      item
        DataType = ftString
