  object qryNotasItens: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkFields = 'dadofiscal = dadofiscal'
    LinkOptions = [loAlwaysResync]
    MasterSource = dsrNotas
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select df.numero as dadofiscal,'
      '       f.cnpj,'
      '       df.data as emissao,'
      '       pdf.numero,'
      '       p.codigovisual,'
      
        '       cast (case when pdf.hash_paf_registro_j2 = md5(cast(df.nu' +
        'mero as varchar)||'
      
        '                                                     cast(f.cnpj' +
        ' as varchar)||'
      
        '                                                     cast(df.dat' +
        'a as varchar)||'
      
        '                                                     cast(pdf.nu' +
        'mero as varchar)||'
      
        '                                                     cast(p.codi' +
        'govisual as varchar)||'
      
        '                                                     cast(p.desc' +
        'ricao as varchar)||'
      
        '                                                     cast(pdf.qu' +
        'antidade as varchar)||'
      
        '                                                     cast(pdf.un' +
        'idade as varchar)||'
      
        '                                                     cast(pdf.pr' +
        'ecovenda as varchar)||'
      
        '                                                     cast(coales' +
        'ce(pdf.desconto,0)+coalesce(pdf.valordescontoitem,0) as varchar)' +
        '||'
      ''
      
        '                                                     cast(coales' +
        'ce(pdf.acrescimo,0.00) as varchar)||'
      ''
      
        '                                                     cast((pdf.q' +
        'uantidade * pdf.precovenda) -'
      
        '                                                      (coalesce(' +
        'pdf.desconto,0)+'
      
        '                                                       coalesce(' +
        'pdf.valordescontoitem,0)) +'
      
        '                                                      coalesce(p' +
        'df.acrescimo,0) as varchar)||'
      ''
      '                                                      /*'
      
        '                                                     cast(df.val' +
        'orvista as varchar)||'
      ''
      
        '                                                     cast((case ' +
        'when df.valorvista > df.valortotal then df.valorvista - df.valor' +
        'total'
      
        '                                                     else 0.00 e' +
        'nd) as varchar)||'
      ''
      
        '                                                     cast('#39'V'#39' as' +
        ' varchar)||'
      ''
      
        '                                                     cast((case ' +
        'when df.valorvista < df.valortotal then df.valortotal - df.valor' +
        'vista'
      
        '                                                     else 0.00 e' +
        'nd)  as varchar)||'
      ''
      
        '                                                     cast('#39'V'#39' as' +
        ' varchar)||'
      ''
      
        '                                                     cast(df.val' +
        'ortotal as varchar)||'
      ''
      
        '                                                     cast((case ' +
        'when df.situacao = '#39'C'#39' then cast('#39'S'#39' as char(1)) else cast('#39'N'#39' a' +
        's char(1)) end) as varchar)||'
      ''
      
        '                                                     cast(0.00 a' +
        's varchar)||'
      ''
      
        '                                                     cast('#39'D'#39' as' +
        ' varchar)||'
      '                                                     */'
      ''
      
        '                                                     cast(n.nume' +
        'ro as varchar)||'
      
        '                                                     cast(n.seri' +
        'e as varchar)||'
      
        '                                                     cast(coales' +
        'ce(df.chv_nfe,'#39#39') as varchar)||'
      ''
      
        '                                                     cast(coales' +
        'ce(pdf.TipoTotalizadorParcial,'#39#39') as varchar)||'
      
        '                                                     cast(coales' +
        'ce(pdf.CasasDecimaisQuantidade,2) as varchar)||'
      
        '                                                     cast(coales' +
        'ce(pdf.CasasDecimaisValorUnitario,2) as varchar)||'
      ''
      
        '                                                     cast((case ' +
        'when df.modelodocto in ('#39'55'#39') then 2'
      
        '                                                          when d' +
        'f.modelodocto in ('#39'65'#39') then 3'
      '                                                          else 1'
      
        '                                                     end) as var' +
        'char))  then'
      '          rpad(p.descricao,100,'#39' '#39')'
      '       else'
      '          rpad(p.descricao,100,'#39'?'#39')'
      '       end as varchar(100)) as descricao,'
      ''
      '       pdf.quantidade,'
      '       pdf.unidade,'
      '       pdf.precovenda,'
      
        '       coalesce(pdf.desconto,0)+coalesce(pdf.valordescontoitem,0' +
        ') as desconto,'
      '       pdf.acrescimo,'
      '       (pdf.quantidade * pdf.precovenda) -'
      '        (coalesce(pdf.desconto,0)+'
      '         coalesce(pdf.valordescontoitem,0)) +'
      '        coalesce(pdf.acrescimo,0) as ValorTotalLiquido,'
      ''
      ''
      '      /* df.valorvista as subtotal,'
      ''
      
        '       case when df.valorvista > df.valortotal then df.valorvist' +
        'a - df.valortotal'
      '       else 0.00 end as DescSubtotal,'
      ''
      ''
      '       cast('#39'V'#39' as char(1)) as TipoDescSubtotal,'
      ''
      
        '       case when df.valorvista < df.valortotal then df.valortota' +
        'l - df.valorvista'
      '       else 0.00 end as AcrescSubtotal,'
      '       cast('#39'V'#39' as char(1)) as TipoAcrescSubtotal,'
      ''
      '       df.valortotal as TotalLiquido,'
      ''
      
        '       case when df.situacao = '#39'C'#39' then cast('#39'S'#39' as char(1)) els' +
        'e cast('#39'N'#39' as char(1)) end as IndCanc,'
      '       0.00 as CancAcrescSubTotal,'
      ''
      '       cast('#39'D'#39' as char(1)) as OrdemAplicDesc_e_Acresc,'
      ''
      '       */'
      ''
      '       n.numero as NumeroNota,'
      '       n.serie as SerieNota,'
      
        '       case when df.chv_nfe is null then cast(repeat('#39'0'#39',44) as ' +
        'varchar(44)) else df.chv_nfe end as chv_nfe,'
      ''
      ''
      ''
      
        '       coalesce(pdf.TipoTotalizadorParcial,'#39#39') as TipoTotalizado' +
        'rParcial,'
      
        '       coalesce(pdf.CasasDecimaisQuantidade,2) as CasasDecimaisQ' +
        'uantidade,'
      
        '       coalesce(pdf.CasasDecimaisValorUnitario,2) as CasasDecima' +
        'isValorUnitario,'
      ''
      ''
      '       case when df.modelodocto in ('#39'55'#39') then 2'
      '            when df.modelodocto in ('#39'65'#39') then 3'
      '            else 1'
      '       end as TipodeDocumento'
      ''
      ''
      'from dadosfiscais df'
      '     join produtosdadosfiscais pdf'
      '          join produtos p'
      '          on pdf.produto = p.codigo'
      '     on df.numero = pdf.dadofiscal'
      ''
      '     join notas n'
      '     on df.numero = n.dadofiscal'
      ''
      '     join filiais f'
      '     on df.filialemissao = f.codigo'
      ''
      'where df.data between :dataInicial and :dataFinal'
      
        '  and ((df.modelodocto in ('#39'55'#39','#39'65'#39') and df.numprotocolonfe is ' +
        'not null) or'
      '       (df.modelodocto not in ('#39'55'#39','#39'65'#39')))'
      ''
      'order by df.numero, pdf.numero'
      '')
    RequestLive = False
    Left = 312
    Top = 424
    ParamData = <
      item
        DataType = ftString
        Name = 'dataInicial'
        ParamType = ptUnknown
        Value = '2016-10-01'
      end
      item
        DataType = ftString
        Name = 'dataFinal'
        ParamType = ptUnknown
        Value = '2016-10-31'
      end>
