    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';'
      
        'SELECT CASE WHEN upper(hash_paf_registro_u1)=upper(hash_paf_regi' +
        'stro_u1_calculado) THEN true ELSE false END as registrovalido'
      'from'
      '(select hash_paf_registro_u1,'
      ''
      ''
      #9#9#9#9#9#9#9#9'md5(('#9'select cast(sum(total) as varchar)'
      #9#9#9#9#9#9#9#9#9#9'from'
      #9#9#9#9#9#9#9#9#9#9'('
      #9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from registro_a2'
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from registro_p2'
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from registro_e2'
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from ecfs'
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from paf_cabecalho'
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'('
      #9#9#9#9#9#9#9#9#9#9#9#9'select count(*) as total '
      #9#9#9#9#9#9#9#9#9#9#9#9'from reducoesz rz'
      #9#9#9#9#9#9#9#9#9#9#9#9'where datamovimento<current_date'#9#9#9#9#9#9#9#9#9#9#9#9' '
      #9#9#9#9#9#9#9#9#9#9#9')'
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'('
      #9#9#9#9#9#9#9#9#9#9#9#9'select count(*) as total'
      #9#9#9#9#9#9#9#9#9#9#9#9'from reducoesz rz'
      #9#9#9#9#9#9#9#9#9#9#9#9#9' join reducoeszdetalhes rzd'
      #9#9#9#9#9#9#9#9#9#9#9#9#9' on   rz.filial = rzd.filial'
      #9#9#9#9#9#9#9#9#9#9#9#9#9' and  rz.numerousuario = rzd.numerousuario'
      #9#9#9#9#9#9#9#9#9#9#9#9#9' and  rz.cro = rzd.cro'
      #9#9#9#9#9#9#9#9#9#9#9#9#9' and  rz.datamovimento = rzd.datamovimento'
      #9#9#9#9#9#9#9#9#9#9#9#9'where rz.datamovimento < current_date'
      #9#9#9#9#9#9#9#9#9#9#9')'#9#9#9#9#9#9#9#9#9#9#9
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'('
      #9#9#9#9#9#9#9#9#9#9#9#9'select count(*) from dadoscupom'
      #9#9#9#9#9#9#9#9#9#9#9#9
      #9#9#9#9#9#9#9#9#9#9#9')'
      #9#9#9#9#9#9#9#9#9#9#9'union all '
      #9#9#9#9#9#9#9#9#9#9#9'select count(*) from detalhecupom'
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'('
      #9#9#9#9#9#9#9#9#9#9#9#9'select count(*) from dadositemcupom'#9#9#9#9#9#9#9#9#9#9#9#9
      #9#9#9#9#9#9#9#9#9#9#9')'
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from detalhedemaisdoctos'
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'select count(*) as total from detalhecupom '
      #9#9#9#9#9#9#9#9#9#9#9'union all'
      #9#9#9#9#9#9#9#9#9#9#9'('
      #9#9#9#9#9#9#9#9#9#9#9#9'select count(*) from formaspagamentoecf'
      #9#9#9#9#9#9#9#9#9#9#9')'
      #9#9#9#9#9#9#9#9#9#9') as sel'
      #9#9#9#9#9#9#9#9#9')) as hash_paf_registro_u1_calculado'
      #9'from filiais'
      #9'where codigo=:filial'
      ') as sel'
      '')
    RequestLive = False
    Left = 368
