function TdtmMenuFiscal.TabelaProdutos(Arquivo: String): Boolean;
var
//  Temp: TextFile;
  vIAT: Char;
begin
  Result := True;

  ACBrPAF1.Path := ExtractFilePath(Arquivo);
  ACBrPAF1.Delimitador := '';
  ACBrPAF1.CurMascara  := '';

//  try
  //  AssignFile(Temp, Arquivo);
  //  Rewrite(Temp);
{         REGISTRO P1 - IDENTIFICACAO DO ESTABELECIMENTO USUÁRIO DO PAF-ECF
   -----------------------------------------------------------------------------------
  | Nº | Denominação do Campo |         Conteúdo        | Tamanho | Posição | Formato |
  |-----------------------------------------------------------------------------------|
  | 01 |  Tipo de registro    |           “P1”          |   02    |  1 | 2  |    X    |
  | 02 |        CNPJ          |CNPJ  do  estabelecimento|   14    |  3 | 16 |    N    |
  | 03 | Inscrição Estadual   |I.E.  do  estabelecimento|   14    | 17 | 30 |    X    |
  | 04 | Inscrição Municipal  |I.M.  do  estabelecimento|   14    | 31 | 44 |    X    |
  | 05 | Razão Social         |R.S.  do  estabelecimento|   50    | 45 | 94 |    X    |
   -----------------------------------------------------------------------------------
}

    RefazConsulta(qryProdutosIncExc,[0],[FilialBase]);
    with ACBrPAF1.PAF_P.RegistroP1 do
    begin
      InclusaoExclusao:= qryProdutosIncExcinclusao_exclusao.AsBoolean; /// Validação dos registros colocando ??? nos espaços em branco da razao social
      CNPJ       := preenchestring(CNPJFilialBase              ,'0',14,False);  // CNPJ do estabelecimento usuário do PAF-ECF
      IE         := preenchestring(InscricaoEstadualFilialBase ,' ',14,True );  // Inscrição Estadual do estabelecimento
      IM         := preenchestring(InscricaoMunicipalFilialBase,' ',14,True );  // Inscrição Municipal do estabelecimento
      RAZAOSOCIAL:= preenchestring(RazaoFilialBase             ,' ',50,True );  // Razão Social do estabelecimento

    end;

    {
    Writeln(Temp, 'P1' +
                  preenchestring(CNPJFilialBase              ,'0',14,False)+
                  preenchestring(InscricaoEstadualFilialBase ,' ',14,True )+
                  preenchestring(InscricaoMunicipalFilialBase,' ',14,True )+
                  preenchestring(RazaoFilialBase             ,' ',50,True ));
                  }

{                 REGISTRO P2 - RELAÇÃO DAS MERCADORIAS E SERVIÇOS
   -----------------------------------------------------------------------------------
  | Nº | Denominação do Campo |         Conteúdo        | Tamanho | Posição | Formato |
  |-----------------------------------------------------------------------------------|
  | 01 |   Tipo de registro   |           “P2”          |    02   |  1 |  2 |    X    |
  | 02 |         CNPJ         |CNPJ  do  estabelecimento|    14   |  3 | 16 |    N    |
  | 03 |        Código        | Código  da  mercadoria  |    14   | 17 | 30 |    X    |     --------------------------------
  | 04 |      Descrição       |Descrição  da  mercadoria|    50   | 31 | 80 |    X    |    | Código | Situação Tributária   |
  | 05 |       Unidade        |    Unidade de medida    |    06   | 81 | 86 |    X    |    |--------------------------------|
  | 06 |         IAT          |  Ind. Arredond./Trunc.  |    01   | 87 | 87 |    X    |    |    I   |       Isento          |
  | 07 |        IPPT          |Produção Própria/Terceiro|    01   | 88 | 88 |    X    |    |    N   |    Não Tributado      |
  | 08 | Situação Tributária  |Código da Sit. Tributaria|    01   | 89 | 89 |    X    |--->|    F   |Substituição Tributária|
  | 09 |      Alíquota        |Alíquota cfe item 7.2.1.6|    04   | 90 | 93 |    N    |    |    T   |  Tributado pelo ICMS  |
  | 10 |   Valor unitário     |V.U. duas casas decimais |    12   | 94 |105 |    N    |    |    S   | Tributado pelo ISSQN  |
   -----------------------------------------------------------------------------------      --------------------------------
}

{    if ECFPadrao.Arredonda then
      vIAT := 'A'
    else}
      vIAT := 'T';

    RefazConsulta(qryProdutos,[0],[cnpjfilialbase]);
    {
    while not qryProdutos.Eof do
    begin
      Writeln(Temp, 'P2' +
                    preenchestring(CNPJFilialBase                  ,'0',14,False)+
                    preenchestring(qryProdutoscodigovisual.AsString,' ',14,True )+
                    preenchestring(qryProdutosdescricao.AsString,   ' ',50,True )+
                    preenchestring(qryProdutosunidade.AsString,     ' ',06,True )+
                    IAT                                                          +
                    qryProdutosproducaopropria.AsString                          +
                    qryProdutossituacaotributaria.AsString                       +
                    preenchestring(Trocar(Trocar(qryProdutosaliquota.AsString,'.',''),',',''),'0',04,False)+
                    preenchestring(Trocar(Trocar(formatarValor(qryProdutosprecounitario.AsFloat,2),'.',''),',',''),'0',12,False));
      qryProdutos.Next;
    end;
    }
    while not qryprodutos.Eof do
    begin
      with ACBrPAF1.PAF_P.RegistroP2.New do
      begin
        RegistroValido := qryProdutosregistrovalido.AsBoolean;
        COD_MERC_SERV  := qryProdutosproduto.AsString;     /// Código da mercadoria ou serviço
        DESC_MERC_SERV := qryProdutosdescricao.asstring;    /// Descrição da mercadoria ou serviço
        UN_MED         := qryProdutosunidade.asstring;            /// Unidade de medida
        IAT            := vIAT;               /// Indicador de Arredondamento ou Truncamento, conforme item 7.2.1.3
        IPPT           := qryProdutosippt.asstring;              /// Indicador de Produção Própria ou de Terceiro, conforme item 7.2.1.4
        ST             := qryProdutossituacaotributaria.asstring;/// Código da Situação Tributaria conforme tabela constante no item 7.2.1.5
        if((ST='N') or (ST='I')) then
          ALIQ           := 0.00            /// Alíquota, conforme item 7.2.1.6
        else
            ALIQ           := qryProdutosaliquota.ascurrency;            /// Alíquota, conforme item 7.2.1.6
        VL_UNIT        := qryProdutosvalorunitario.ascurrency;         /// Valor unitário com duas casas decimais
      end;
      qryprodutos.next;
    end;


{                       REGISTRO P9 - TOTALIZAÇÃO DE REGISTROS
   -----------------------------------------------------------------------------------
  | Nº | Denominação do Campo |         Conteúdo        | Tamanho | Posição | Formato |
