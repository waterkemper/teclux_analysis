function TdtmMenuFiscal.MeiosPagto(DataInicial, DataFinal: TDateTime): Boolean;
var
  MeiosPagto,
  Totalizadores,
  Relatorio: TStringList;
  Categoria, Colunas, i: Integer;
  MeioPagto: String;

  procedure AchaETotalizaMeioPagto(pMeioPagto: String; var pCategoria: Integer;
        Valor: Currency);
  begin
    pCategoria := MeiosPagto.IndexOf(pMeioPagto);
    if pCategoria = -1 then
    begin
      MeiosPagto.Append(pMeioPagto);
      Totalizadores.Append(CurrToStr(Valor));
      pCategoria := MeiosPagto.Count;
    end
    else
    begin
      Totalizadores.Strings[pCategoria] := CurrToStr(StrToCurr(Totalizadores.Strings[pCategoria]) + Valor);
      Inc(pCategoria);
    end;
  end;

begin
  Result := False;
  qryMeiosPagto.ParamByName('filialbase').AsInteger := FilialBase;
  qryMeiosPagto.ParamByName('datainicial').AsDate   := DataInicial;
  qryMeiosPagto.ParamByName('datafinal').AsDate     := DataFinal;
  qryMeiosPagto.ParamByName('ecf').AsString         := ECFPadrao.Codigo;
  qryMeiosPagto.Open;

  if not qryMeiosPagto.IsEmpty then
  begin
    MeiosPagto := TStringList.Create;
    Totalizadores := TStringList.Create;
    Categoria := 0;
    MeioPagto := '';
    while not qryMeiosPagto.Eof do
    begin
      AchaETotalizaMeioPagto(qryMeiosPagtomeiopagto.AsString, Categoria,
                             qryMeiosPagtoValoracumulado.AsCurrency);

      qryMeiosPagto.Edit;
      qryMeiosPagtocategoria.AsString := IntToStr(Categoria);
      qryMeiosPagto.Post;

      qryMeiosPagto.Next;
    end;

    Relatorio := TStringList.Create;
    Colunas := ECFPadrao.Colunas;

    try
      Relatorio.Append(Centralizar('-----------MEIOS DE PAGAMENTO-----------',Colunas));
      Relatorio.Append(Centralizar('PERIODO : ' + DateToStr(DataInicial) + ' a ' + DateToStr(DataFinal),Colunas));
      Relatorio.Append(Centralizar(' MP    Data     Tipo Docto     Vlr Acum.',Colunas));
      qryMeiosPagto.First;
      while not qryMeiosPagto.Eof do
      begin
        Relatorio.Append(Centralizar(Centralizar(qryMeiosPagtocategoria.AsString,4) +
                                     qryMeiosPagtodata.AsString              +
                                     Centralizar(qryMeiosPagtotipodocto.AsString,13) +
                                     preencheString(FormatFloat('0.,00',qryMeiosPagtovaloracumulado.AsCurrency),' ',13,False),
                                     Colunas));

{        if qryMeiosPagtomeiopagto.AsString = 'A' then
          AcumuladoDinheiro      := AcumuladoDinheiro      + qryMeiosPagtovaloracumulado.AsCurrency
        else if qryMeiosPagtomp.AsString = 'B' then
          AcumuladoCheque        := AcumuladoCheque        + qryMeiosPagtovaloracumulado.AsCurrency
        else if qryMeiosPagtomp.AsString = 'C' then
          AcumuladoCreditoAmex   := AcumuladoCreditoAmex   + qryMeiosPagtovaloracumulado.AsCurrency
        else if qryMeiosPagtomp.AsString = 'D' then
          AcumuladoCreditoMaster := AcumuladoCreditoMaster + qryMeiosPagtovaloracumulado.AsCurrency
        else if qryMeiosPagtomp.AsString = 'E' then
          AcumuladoCreditoVisa   := AcumuladoCreditoVisa   + qryMeiosPagtovaloracumulado.AsCurrency
        else if qryMeiosPagtomp.AsString = 'F' then
          AcumuladoDebitoAmex    := AcumuladoDebitoAmex    + qryMeiosPagtovaloracumulado.AsCurrency
        else if qryMeiosPagtomp.AsString = 'G' then
          AcumuladoDebitoMaster  := AcumuladoDebitoMaster  + qryMeiosPagtovaloracumulado.AsCurrency
        else if qryMeiosPagtomp.AsString = 'H' then
          AcumuladoDebitoVisa    := AcumuladoDebitoVisa    + qryMeiosPagtovaloracumulado.AsCurrency;
 }
        qryMeiosPagto.Next;
      end;
      qryMeiosPagto.Close;

      Relatorio.Append('');
      Relatorio.Append('SOMA INDIVIDUAL :');

      for i := 0 to MeiosPagto.Count -1 do
      begin
        Relatorio.Append(preencheString(IntToStr(i+1)+' -> '+MeiosPagto.Strings[i],' ',30) +
                         Format('%10.2f',[StrToFloat(Totalizadores.Strings[i])]));
      end;
{
      if AcumuladoDinheiro      > 0 then
        Relatorio.Append('A->Dinheiro              = ' + preencheString(FormatFloat('0.,00',AcumuladoDinheiro)     ,' ',13,False));
      if AcumuladoCheque        > 0 then
        Relatorio.Append('B->CHEQUE                = ' + preencheString(FormatFloat('0.,00',AcumuladoCheque)       ,' ',13,False));
      if AcumuladoCreditoAmex   > 0 then
        Relatorio.Append('C->C. CREDITO AMEX       = ' + preencheString(FormatFloat('0.,00',AcumuladoCreditoAmex)  ,' ',13,False));
      if AcumuladoCreditoMaster > 0 then
        Relatorio.Append('D->C. CREDITO MASTERCARD = ' + preencheString(FormatFloat('0.,00',AcumuladoCreditoMaster),' ',13,False));
      if AcumuladoCreditoVisa   > 0 then
        Relatorio.Append('E->C. CREDITO VISA       = ' + preencheString(FormatFloat('0.,00',AcumuladoCreditoVisa)  ,' ',13,False));
      if AcumuladoDebitoAmex    > 0 then
        Relatorio.Append('F->C. DEBITO AMEX        = ' + preencheString(FormatFloat('0.,00',AcumuladoDebitoAmex)   ,' ',13,False));
      if AcumuladoDebitoMaster  > 0 then
        Relatorio.Append('G->C. DEBITO MASTERCARD  = ' + preencheString(FormatFloat('0.,00',AcumuladoDebitoMaster) ,' ',13,False));
      if AcumuladoDebitoVisa    > 0 then
        Relatorio.Append('H->C. DEBITO VISA        = ' + preencheString(FormatFloat('0.,00',AcumuladoDebitoVisa)   ,' ',13,False));
}
      try
        ECFPadrao.RelatorioGerencial(Relatorio);
      except
        Result := False;
      end;
    finally
      Relatorio.Free;
      MeiosPagto.Free;
      Totalizadores.Free;
    end;
  end;
  qryMeiosPagto.Close;
end;

