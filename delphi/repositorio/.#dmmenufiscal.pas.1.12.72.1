procedure TdtmMenuFiscal.Registro_R04(PeriodoInicial,
  PeriodoFinal: TDateTime;CodigoECF: String);
begin
  RefazConsultaPorNome(qryDadosCupom,['datainicial','datafinal','num_fab'],
                  [PeriodoInicial, PeriodoFinal, CodigoECF {ACBrPAF1.PAF_R.RegistroR01.NUM_FAB}]);

    RefazConsultaPorNome(qryDadosItemCupom,['datainicial','datafinal','num_fab'],
                    [PeriodoInicial, PeriodoFinal, CodigoECF {ACBrPAF1.PAF_R.RegistroR01.NUM_FAB}]);

    RefazConsultaPorNome(qryFormasPagamentoCupom,['datainicial','datafinal','num_fab'],
                    [PeriodoInicial, PeriodoFinal, CodigoECF{ACBrPAF1.PAF_R.RegistroR01.NUM_FAB}]);


  qryDadosCupom.First;
  while not qryDadosCupom.Eof do
  begin
    with ACBrPAF1.PAF_R.RegistroR01.Items[qryDadosECF.RecNo-1].RegistroR04.New do
    begin
      RegistroValido := qryDadosCupom.fieldbyname('registrovalido').AsBoolean;
      // Nº de ordem do usuário do ECF
      NUM_USU    := qryDadosCupom.fieldbyname('num_usu').AsInteger;

      // Nº do contador do respectivo documento emitido
      NUM_CONT   := qryDadosCupom.fieldbyname('ccf').AsInteger;

      // Nº do COO relativo ao respectivo documento
      COO        := qryDadosCupom.fieldbyname('coo').AsInteger;

      // Data de início da emissão do documento impressa no cabeçalho do documento
      DT_INI     := qryDadosCupom.fieldbyname('dt_ini').AsDateTime;

      // Valor total do documento, com  duas casas decimais.
      SUB_DOCTO  := qryDadosCupom.FieldByName('SUB_DOCTO').AsCurrency;

      // Valor do desconto ou Percentual aplicado sobre o valor do subtotal do documento, com duas casas decimais.
      SUB_DESCTO := qryDadosCupom.FieldByName('SUB_DESCTO').AsCurrency;

      // Informar “V” para valor monetário ou “P” para percentual
      TP_DESCTO  := qryDadosCupom.FieldByName('TP_DESCTO').AsString;

      // Valor do acréscimo ou Percentual aplicado sobre o valor do subtotal do documento, com duas casas decimais
      SUB_ACRES  := qryDadosCupom.FieldByName('SUB_ACRES').AsCurrency;

      // Informar “V”  para valor monetário ou “P” para percentual
      TP_ACRES   := qryDadosCupom.FieldByName('TP_ACRES').AsString;

      // Valor total do Cupom Fiscal após desconto/acréscimo, com duas casas decimais.
      VL_TOT     := qryDadosCupom.FieldByName('VL_TOT').AsCurrency;

      // Informar "S" ou "N", conforme tenha ocorrido ou não, o cancelamento do documento.
      CANC       := qryDadosCupom.FieldByName('CANC').AsString;

      // Valor do cancelamento de acréscimo no subtotal
      VL_CA      := qryDadosCupom.FieldByName('VL_CA').AsCurrency;

      // Indicador de ordem de aplicação de desconto/acréscimo em Subtotal. ‘D’ ou ‘A’ caso tenha ocorrido primeiro desconto ou acréscimo, respectivamente
      ORDEM_DA   := qryDadosCupom.FieldByName('ORDEM_DA').AsString;

      // Nome do Cliente
      NOME_CLI   := qryDadosCupom.FieldByName('NOME_CLI').AsString;

      // CPF ou CNPJ do adquirente
      CNPJ_CPF   := qryDadosCupom.FieldByName('CNPJ_CPF').AsString;

      Registro_R05;
      Registro_R07_Cupom;
    end;
    qryDadosCupom.Next;
  end;
  qryDadosCupom.Close;
  qryDadosItemCupom.Close;
  qryFormasPagamentoCupom.Close;
end;

procedure TdtmMenuFiscal.Registro_R05;
begin
  qryDadosItemCupom.First;
  while not qryDadosItemCupom.Eof do
  begin
    with ACBrPAF1.PAF_R.RegistroR01.Items[qryDadosECF.RecNo-1].RegistroR04.Items[qryDadosCupom.RecNo-1].RegistroR05.new do
    begin
      RegistroValido := qryDadosItemCupom.FieldByName('registrovalido').AsBoolean;
      // Número do item registrado no documento
      NUM_ITEM     := qryDadosItemCupom.FieldByName('NUM_ITEM').asinteger;

      // Código do produto ou serviço registrado no documento
      COD_ITEM     := qryDadosItemCupom.FieldByName('COD_ITEM').AsString;


      // Descrição do produto ou serviço constante no Cupom Fiscal
      DESC_ITEM    := qryDadosItemCupom.FieldByName('DESC_ITEM').AsString;

      // Quantidade comercializada, sem a separação das casas decimais
      QTDE_ITEM    := qryDadosItemCupom.FieldByName('QTDE_ITEM').AsCurrency;

      // Unidade de medida
      UN_MED       := qryDadosItemCupom.FieldByName('UN_MED').AsString;

      // Valor unitário do produto ou serviço, sem a separação das casas decimais.
      VL_UNIT      := qryDadosItemCupom.FieldByName('VL_UNIT').AsCurrency;

      // Valor  do desconto  incidente sobre o valor do item, com duas casas decimais.
      DESCTO_ITEM  := qryDadosItemCupom.FieldByName('DESCTO_ITEM').AsCurrency;

      // Valor do acréscimo incidente sobre o valor do item, com duas casas decimais.
      ACRES_ITEM   := qryDadosItemCupom.FieldByName('ACRES_ITEM').AsCurrency;

      // Valor total líquido do item, com duas casas decimais.
      VL_TOT_ITEM  := qryDadosItemCupom.FieldByName('VL_TOT_ITEM').AsCurrency;

      // Código do totalizador relativo ao produto ou serviço conforme tabela abaixo.
      COD_TOT_PARC := qryDadosItemCupom.FieldByName('COD_TOT_PARC').AsString;

      // Informar "S" ou "N", conforme tenha ocorrido ou não, o cancelamento total do item  no documento. Informar "P" quando ocorrer o cancelamento parcial do item.
      IND_CANC     := qryDadosItemCupom.FieldByName('IND_CANC').AsString;

      // Quantidade cancelada, no caso de cancelamento parcial de item, sem a separação das casas decimais.
      QTDE_CANC    := qryDadosItemCupom.FieldByName('QTDE_CANC').AsCurrency;

      // Valor cancelado, no caso de cancelamento parcial de item
      VL_CANC      := qryDadosItemCupom.FieldByName('VL_CANC').AsCurrency;

      // Valor do cancelamento de acréscimo no item
      VL_CANC_ACRES:= qryDadosItemCupom.FieldByName('VL_CANC_ACRES').AsCurrency;

      // Indicador de Arredondamento ou Truncamento relativo à regra de cálculo do valor total líquido do item, sendo “T”  para truncamento ou “A” para arredondamento
      IAT          := qryDadosItemCupom.FieldByName('IAT').AsString;

      // Indicador de Produção Própria ou de Terceiro relativo à mercadoria, sendo “P” para mercadoria de produção própria ou “T” para mercadoria produzida por terceiros
      IPPT         := qryDadosItemCupom.FieldByName('IPPT').AsString;

      // Parâmetro de número de casas decimais da quantidade
      QTDE_DECIMAL := qryDadosItemCupom.FieldByName('QTDE_DECIMAL').asinteger;

      // Parâmetro de número de casas decimais de valor unitário
      VL_DECIMAL   := qryDadosItemCupom.FieldByName('VL_DECIMAL').asinteger;
    end;
    qryDadosItemCupom.Next;
  end;
end;

