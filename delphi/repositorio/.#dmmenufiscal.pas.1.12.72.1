function TdtmMenuFiscal.LMFData(DataInicial, DataFinal: String;
  Simplificada: Boolean): Boolean;
begin
  Result := True;
  try
    ECFPadrao.LeituraMemoriaFiscalData(DataInicial, DataFinal, Simplificada);
  except
    Result := False;
  end;
end;

function TdtmMenuFiscal.LMFData(DataInicial, DataFinal, Arquivo: String;
  Simplificada: Boolean): Boolean;
begin
  Result := True;
  try
    ECFPadrao.LeituraMemoriaFiscalDataArquivo(DataInicial, DataFinal, Arquivo,
                                              Simplificada);
    AssinarArquivo(Arquivo);
  except
    Result := False;
  end;
end;

