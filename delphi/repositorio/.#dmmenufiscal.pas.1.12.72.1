  RefazConsultaPorNome(qryDemaisDoctos,['datainicial','datafinal','num_fab'],
                 [PeriodoInicial, PeriodoFinal,CodigoECF{ACBrPAF1.PAF_R.RegistroR01.NUM_FAB}]);
  RefazConsultaPorNome(qryFormasPagtoDemais,['datainicial','datafinal','num_fab'],
                 [PeriodoInicial, PeriodoFinal,CodigoECF{ACBrPAF1.PAF_R.RegistroR01.NUM_FAB}]);

  qryDemaisDoctos.First;
  while not qryDemaisDoctos.Eof do
