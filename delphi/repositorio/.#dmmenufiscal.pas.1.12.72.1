    with ACBrPAF1.PAF_R.RegistroR01.Items[qryDadosECF.RecNo-1].RegistroR06.New do
    begin
     RegistroValido :=qryDemaisDoctosregistrovalido.AsBoolean;
      /// Nº de ordem do usuário do ECF
