procedure TdtmMenuFiscal.ApagarUltimaLinhaArquivo(Arquivo: String);
var
  ArqTemp: TStringList;
begin
  ArqTemp := TStringList.Create;
  try
    ArqTemp.LoadFromFile(Arquivo);
