procedure TdtmMenuFiscal.ReducaoZ;
var
  ArqMov: String;
begin
  if not ECFPadrao.ImpressoraBloqueada then
  begin
    dtmGerarMapasECF := tdtmGerarMapasECF.Create(self);
    if dtmGerarMapasECF.GravarReducaoz(ECFPadrao.GerarDadosReducaoZ) then
    begin
      VerificarLeituraMemoriaFiscal;
      ECFPadrao.ReducaoZ;
      if ECFPadrao.Erro then
      begin
        dtmGerarMapasECF.GravarReducaoz(false);
        MensagemErro(ECFPadrao.Mensagem);
      end
      else
      begin
        dtmGerarMapasECF.GravarReducaoz(true);

        //Geração automatica do arquivo de movimentos por ecf apos a reducao z
        ReFazConsulta(qryDataMovimentoUltimaZ,[0,1,2,3],[ecfpadrao.seriemaquina,
                                                         ecfpadrao.intervencao,
                                                         filialbase,
                                                         UltimaReducaoZEmitida]);
        if not qryDataMovimentoUltimaZ.IsEmpty then
        begin
          ArqMov := ExtractFilePath(Application.ExeName) + 'PAF-ECF\MOVECF';
          if not DirectoryExists(ArqMov) then
            if not CreateDir(ArqMov) then
            raise Exception.Create('Impossível criar o diretório '+ArqMov);

          ArqMov := ArqMov+'\'+
                    ECFPadrao.CNIEE +
                    cortaPreencheString(ECFPadrao.SerieMaquina,'0',14,False) +
                    FormatDateTime('ddmmyyyy',qryDataMovimentoUltimaZdatamovimento.AsDateTime)+
                    '.txt';
          MovimentosECF(qryDataMovimentoUltimaZdatamovimento.AsDateTime,
                        qryDataMovimentoUltimaZdatamovimento.AsDateTime,
                        {ECFPadrao.SerieMaquina}ECFPadrao.codigo, ArqMov);
        end;
      end;
    end;
    dtmGerarMapasECF := nil;
  end
  else
    MensagemErro(ctECFBLOQUEADA)
end;

