      Visible = False
      Size = 1
    end
  end
  object qryParcelas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforeOpen = qryParcelasBeforeOpen
    AfterInsert = qryParcelasAfterInsert
    BeforePost = qryParcelasBeforePost
    AfterScroll = qryParcelasAfterScroll
    OnCalcFields = qryParcelasCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'filial'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'cliente'
        ParamType = ptUnknown
        Value = 'and cliente =421'
      end
      item
        DataType = ftUnknown
        Name = 'vencimento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'emissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ordenacao'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'SELECT p.Contrato,'
      '       cast(null as integer) as NotaFiscal,'
      '       p.Numero,'
      '       p.DataVencto,'
      '       p.ValorVencto,'
      '       coalesce(p.descontosugerido,0.00) as DescontoSugerido,'
      
        '       coalesce(p.descontosugerido,0.00) as DescontoSugerido_ori' +
        'ginal,'
      '       p.DataPagto,'
      ''
      '       p.ValorVencto +'
      
        '       CalcularJuros(p.ValorVencto, p.DataVencto, Current_date, ' +
        'c.FilialVenda) -'
      '       coalesce(p.descontosugerido,0.00) as ValorPagto,'
      ''
      '       p.ValorVencto +'
      
        '       CalcularJuros(p.ValorVencto, p.DataVencto, Current_date, ' +
        'c.FilialVenda) -'
      '       coalesce(p.descontosugerido,0.00) as ValorPagto_original,'
      ''
      ''
      ''
      '/*       coalesce(p.ValorPagto,0.00) as ValorPagto,*/'
      '/*       coalesce(p.ValorPagto,0.00) as ValorPagto_original,*/'
      ''
      
        '       CalcularJuros(p.ValorVencto, p.DataVencto, Current_date, ' +
        'c.FilialVenda) as Juros,'
      
        '       CalcularJuros(p.ValorVencto, p.DataVencto, Current_date, ' +
        'c.FilialVenda) as Juros_original,'
      ''
      ''
      '       p.FilialPagto,'
      '       p.TipoPagto,'
      '       p.FormaPagamento,'
      '       p.ContaBoleto,'
      '       CAST(TRIM(p.ParcelaOrigem) AS VARCHAR) as ParcelaOrigem,'
      '       p.ParcelaAdicional,'
      '       p.PagamentoExtraCaixa,'
      '       p.UsuarioExtraCaixa,'
      '       c.Nome,'
      '       c.Faturamento,'
      '       c.FilialVenda,'
      '       false as selecionar,'
      '       p.observacaoboleto,'
      '       p.observacaoboleto as observacaoboleto_original,'
      
        '       (select pl.descricao from planos pl where pl.codigo = c.p' +
        'lano) as plano,'
      '       p.tiporecebimento,'
      '       t.descricao,'
      '       p.ParcelaOriginal,'
      '       False as PrevisaoAlterada'
      ''
      
        'FROM   parcelas p left join tiposrecebimentos t on (t.codigo=p.t' +
        'iporecebimento), contratos c'
      'WHERE  p.Contrato = c.Numero AND'
      '       p.DataPagto IS NULL   AND'
      '       c.Situacao IN ('#39'F'#39','#39'N'#39','#39'P'#39') AND'
      '       NOT contratos_renegociado(p.contrato)'
      '%Filial'
      '%Cliente'
      '%Vencimento'
      '%Emissao'
      '%Ordenacao')
    RequestLive = True
    Left = 39
    Top = 274
