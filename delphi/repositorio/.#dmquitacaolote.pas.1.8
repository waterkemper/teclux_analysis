procedure TdtmQuitacaoLote.AbreTabelaPesquisa(TipoPesquisa: TtecQuitacaoEmLote);
begin
  case TipoPesquisa of
     qlFILIAIS,
     qlFILIAISPAGTO : Abre(ctConsultaFiliais);
     qlGRUPOFILIAIS : Abre(ctConsultaGruposFiliais);
     qlCLIENTE      : begin
                        qryConsultaClientes.Sql[08]:= 'Where (v.codigo = 0)';
                        Abre(ctConsultaClientes);
                      end;
     qlCONTA:        Abre(ctConsultaContas);
     qlEVENTO: Abre(ctConsultaEventos);
  end;
end;



