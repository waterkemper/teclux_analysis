  fTotalDuplicatas := 0;
end;

procedure TdtmQuitacaoLote.dsrParcelasDataChange(Sender: TObject;
  Field: TField);
begin
  inherited;
  if {(field = qryParcelasdescontosugerido) or}
     {(field = qryParcelasobservacaoboleto) or}
     (Field = qryParcelasValorPagto)       then
  begin
    //if Assign();
    {
    if field = qryParcelasdescontosugerido then
      qryParcelasValorPagto.AsFloat := qryParcelasValorVencto.AsFloat - qryParcelasdescontosugerido.AsFloat
    else
    }
    if qryParcelasselecionar.AsBoolean {and (Field = qryParcelasValorPagto)} then
      FTotalMarcados:= ((FTotalMarcados - qryParcelasvalorpagto_original.asCurrency) +
                                        qryParcelasvalorpagto.AsCurrency);

    fTotalDuplicatas:= ((fTotalDuplicatas - qryParcelasvalorpagto_original.asCurrency) +
                                            qryParcelasvalorpagto.AsCurrency);

    if Assigned(FOnParcelasEdit) then
      FOnParcelasEdit(qryParcelas);
  end
  else
  if (field = qryParcelasobservacaoboleto) then
  begin
    dsrParcelas.onDataChange := nil;
    qryParcelas.BeforePost := nil;
    if qryParcelas.state = dsedit then
      qryParcelas.Post;
    qryParcelas.BeforePost := qryParcelasBeforePost;
    dsrParcelas.onDataChange := dsrParcelasDataChange;
  end;
end;

