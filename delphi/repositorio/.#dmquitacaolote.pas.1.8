function TdtmQuitacaoLote.EfetuarQuitacao:Boolean;
var Usuario: TtecUsuarios;
    Recebimento, vControleRecebimento, Transacao,i,j: Integer;
begin
  Result := true;
  Usuario:= TtecUsuarios.Create(dtmTecSoft.Database);
  try
    if UsuarioLogin.Caixa then
      Usuario:= ObterAutorizacao(taSENHA)
    else Usuario:= ObterAutorizacao(taLOGIN, ctAUTORIZACAORECEBIMENTO, ctAUTORIZADO);

    if Assigned(Usuario) and Usuario.Caixa then
      begin
{      try}

        qryParcelas.AfterScroll := nil;
        qryParcelas.DisableControls;

        qryParcelas.First;
        while not qryParcelas.Eof do
        begin
          if qryParcelasSelecionar.AsBoolean then
          begin
            RefazConsulta(qryQuitarParcelas,[0,1,2],
                          [qryParcelasContrato.AsVariant,
                           qryParcelasDataVencto.AsVariant,
                           qryParcelasNumero.AsVariant]);

            if not qryQuitarParcelas.IsEmpty then
            begin
              qryQuitarParcelas.Edit;
              qryQuitarParcelasContrato.AsString          := qryParcelasContrato.AsString;
              qryQuitarParcelasNumero.AsInteger           := qryParcelasNumero.AsInteger;
              qryQuitarParcelasDataVencto.AsDateTime      := qryParcelasDataVencto.AsDateTime;
              qryQuitarParcelasValorVencto.AsFloat        := qryParcelasValorVencto.AsFloat;
              qryQuitarParcelasdescontosugerido.AsFloat   := qryParcelasdescontosugerido.AsFloat;
              qryQuitarParcelasobservacaoboleto.AsString  := qryParcelasobservacaoboleto.AsString;
              qryQuitarParcelasdebitar.AsVariant          := qryContascontacontabil.AsVariant;
              qryQuitarParcelasValorPagto.AsFloat       := qryParcelasValorPagto. AsFloat;
              qryQuitarParcelasFilialPagto.AsInteger    := qryFilialPagtoCodigo.  AsInteger;
              qryQuitarParcelasDataPagto.AsDateTime     := StrToDate(DataQuitacao);
              qryQuitarParcelasUsuarioExtracaixa.AsString := Usuario.NomeUsuario;


              {Gera Recebimentos}
              if(not qryParcelastiporecebimento.IsNull) then
              begin
                 //pega o proximo numero de transacao
                 spcTransacaoProximo.Open;
                 Transacao := spcTransacaoProximotransacao.AsInteger;
                 spcTransacaoProximo.Close;

                 //pega dados dos Tipos de Recebimento
                 RefazConsulta(qryTipoRecebimento,[0],[qryParcelastiporecebimento.AsInteger]);
                 qryQuitarParcelastiporecebimento.AsInteger := qryParcelastiporecebimento.AsInteger;
                 qryQuitarParcelasformapagamento.asString:=qryTipoRecebimentotiporecebimento.AsString;
                 qryQuitarParcelastransacao.AsInteger:=Transacao;


                 qryRecebimentos.open;
                 for i:=1 to qryTipoRecebimentonumerorecebimentos.AsInteger do
                 begin
                        spcRecebimentosproximo.open;
                        Recebimento:=SpcRecebimentosProximocodigo.AsInteger;
                        spcRecebimentosproximo.close;

                        if i=0 then
                          vControleRecebimento := Recebimento;

                        qryRecebimentos.append;

                        qryRecebimentoscodigo.AsInteger:=Recebimento;

                        qryRecebimentosfilial.AsInteger:=qryFilialPagtoCodigo.AsInteger;
                        qryRecebimentossituacao.AsString:='N';
                        qryRecebimentostransacao.AsInteger:=Transacao;
                        qryRecebimentosdatalancto.AsDateTime:=StrToDate(DataQuitacao+ ' ' +HoraQuitacao);
                        qryRecebimentosvalorlancto.AsFloat:= qryParcelasValorPagto.AsFloat/qryTipoRecebimentonumerorecebimentos.asInteger;
                        qryRecebimentostiporecebimento.asInteger := qryParcelastiporecebimento.asInteger;
                        qryRecebimentoscontrole.AsInteger := i;
                        qryRecebimentoscontrolerecebimento.AsInteger := vControleRecebimento;

                        qryRecebimentos.Post;
                 end;
              end;

              if not qryContasConta.IsNull then
                qryQuitarParcelasContaBoleto.AsInteger  := qryContasConta.AsInteger;
              if not qryEventosCodigo.IsNull then
                qryQuitarParcelasEvento.AsInteger:= qryEventosCodigo.AsInteger;
              qryQuitarParcelasParcelaAdicional.AsBoolean    := False;
              qryQuitarParcelasPagamentoExtracaixa.AsBoolean := True;

              qryQuitarParcelas.Post;
              Perpetrar([qryQuitarParcelas,qryRecebimentos]);
            end;

          end
          else
          begin
            fHouveAlteracao := false;
            if HouveAlteracao then  {Verifica individualmente}
            begin

              qryParcelas.edit;
              qryParcelasdescontosugerido_original.asCurrency := qryParcelasdescontosugerido.AsCurrency;
              qryParcelasobservacaoboleto_original.asString := qryParcelasobservacaoboleto.AsString;
//              qryParcelasvalorpagto_original.AsCurrency := qryParcelasvalorpagto.AsCurrency;
              qryParcelas.post;


              RefazConsulta(qryQuitarParcelas,[0,1,2],
                            [qryParcelasContrato.AsVariant,
                             qryParcelasDataVencto.AsVariant,
                             qryParcelasNumero.AsVariant]);

              if not qryQuitarParcelas.IsEmpty then
              begin
                qryQuitarParcelas.Edit;
                qryQuitarParcelasdescontosugerido.AsFloat   := qryParcelasdescontosugerido.AsFloat;
                qryQuitarParcelasobservacaoboleto.AsString  := qryParcelasobservacaoboleto.AsString;
                qryQuitarParcelas.post;
                Perpetrar([qryQuitarParcelas]);

              end;
            end;
          end;

          qryParcelas.Next;
        end;
{      except
        on E:Exception do Result := False;}
      end
    else
      MensagemAviso(format(ctUSUARIONAOAUTORIZADO,[ctAUTORIZARRECEBIMENTOPARCELA]));
  finally
    qryParcelas.EnableControls;
    qryParcelas.AfterScroll := qryParcelasAfterScroll;
    Usuario.Free;
  end;
  LimparContadores;
  SelecionarDuplicatas;
end;

procedure TdtmQuitacaoLote.Selecionar(TipoPesquisa: TtecQuitacaoEmLote);
begin
   case TipoPesquisa of
      qlFILIAIS:      ReFazConsulta(qryFilial,      [0],    [qryConsultaFiliaisCodigo.     AsInteger]);
      qlFILIAISPAGTO: ReFazConsulta(qryFilialPagto, [0],    [qryConsultaFiliaisCodigo.     AsInteger]);
      qlGRUPOFILIAIS: ReFazConsulta(qryGrupoFiliais,[0],    [qryConsultaGrupoFiliaisCodigo.AsInteger]);
      qlCLIENTE:      ReFazConsulta(qryClientes,    [0, 1], [qryConsultaClientesTipo.      AsString,
                                                             qryConsultaClientescodigo.    AsInteger]);
      qlCONTA:        ReFazConsulta(qryContas,      [0],    [qryConsultaContasConta.       AsInteger]);
      qlEVENTO:       refazConsulta(qryEventos,     [0],    [qryConsultaEventosCodigo.     AsInteger]);
   end;
end;

