function TdtmQuitacaoLote.SelecionarDuplicatas: Boolean;

  procedure SetValorPagto;
  var
    Pos : TBookmark;
  begin
    qryparcelas.AfterScroll := nil;
    Pos := qryParcelas.GetBookmark;
    qryParcelas.DisableControls;
    qryParcelas.First;
    while not qryParcelas.Eof do
    begin
      qryParcelas.Edit;
      qryParcelasvalorpagto.AsCurrency := qryParcelasvalorvencto.AsCurrency -
                                          qryParcelasdescontosugerido.AsCurrency +
                                          tecFinanceira.CalcularJuros(qryParcelasvalorvencto.AsCurrency,
                                                                      qryParcelasdatavencto.AsDateTime,
                                                                      DataServidor);
      qryParcelasvalorpagto_original.AsCurrency := qryParcelasvalorpagto.AsCurrency;
      qryParcelas.Next;
    end;
    qryParcelas.GotoBookmark(Pos);
    qryParcelas.FreeBookmark(Pos);
    qryParcelas.EnableControls;
    qryparcelas.AfterScroll := qryparcelasAfterScroll;
  end;

begin
  fTotalDuplicatas := 0;
  
  qryParcelas.Close;
  qryParcelas.Open;

  Result:= qryParcelas.IsEmpty;

  if not Result then begin
    LerParametros;
    SetValorPagto;
  end;
end;

