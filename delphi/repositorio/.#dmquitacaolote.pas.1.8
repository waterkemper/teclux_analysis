procedure TdtmQuitacaoLote.SetEmissaoFinal(const Value: String);
begin
  if not DataEmBranco(Value) then
       FEmissaoFinal := Value
  else FEmissaoFinal := '';
  MontaDataEmissao;

end;

procedure TdtmQuitacaoLote.SetEmissaoInicial(const Value: String);
begin
  if not DataEmBranco(Value) then
       FEmissaoInicial := Value
  else FEmissaoInicial := '';
  MontaDataEmissao;
end;

procedure TdtmQuitacaoLote.MontaDataEmissao;
const
  Data_1: String = 'and (c.faturamento = ';
  Data_2: String = 'and (c.faturamento between (';
begin
  if not DataEmBranco(FEmissaoInicial) then begin
    if DataEmBranco(FEmissaoFinal) then begin
      qryParcelas.MacroByName('emissao').AsString := Data_1 + '''' + FEmissaoInicial + ''')';
    end
    else begin
      qryParcelas.MacroByName('emissao').AsString:= Data_2 + '''' + FEmissaoInicial + ''') and (''' + FEmissaoFinal + '''))';
    end;
  end
  else begin
    if not DataEmBranco(FEmissaoFinal) then begin
      qryParcelas.MacroByName('emissao').AsString := Data_1 + '''' + FEmissaoFinal + ''')';
    end
    else begin
      qryParcelas.MacroByName('emissao').AsString := '';
    end;
  end;
end;


procedure TdtmQuitacaoLote.ZMonitor1MonitorEvent(Sql, Result: String);
var
 Listar : TStringList;
 arquivo : String;
begin
  inherited;
  Listar := tStringlist.create;
  arquivo := 'c:\teclux\monitor.sql';
  if fileexists(arquivo) then
    Listar.loadfromfile(arquivo);
  Listar.add('');
  Listar.add(sql);
  Listar.add(result);
  listar.savetofile(arquivo);
  listar.free;
end;

function TdtmQuitacaoLote.GetHouveAlteracao: Boolean;
begin
  if fHouveAlteracao or
     (qryParcelasdescontosugerido_original.asCurrency <> qryParcelasdescontosugerido.AsCurrency)  or
     (qryParcelasobservacaoboleto_original.asString <> qryParcelasobservacaoboleto.AsString) or
     (qryParcelasValorPagto.AsCurrency <> (qryParcelasValorVencto.AsCurrency - qryParcelasdescontosugerido.AsCurrency)) then
    fHouveAlteracao := True
  else
    fHouveAlteracao := false;

  result := fHouveAlteracao;
end;

