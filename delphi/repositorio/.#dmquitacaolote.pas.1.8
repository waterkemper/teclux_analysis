function TdtmQuitacaoLote.GetTotalDuplicatas: Real;
var
  Pos  : TBookmark;
  Query: TtecQuery;
  Previsao: TFloatField;
begin
  if fTotalDuplicatas = 0 then
  begin
    qryparcelas.AfterScroll := nil;
    Query   := qryParcelas;
    Previsao:= qryParcelasvalorpagto;

    fTotalDuplicatas:= 0;
    if Query.Active and not Query.IsEmpty then
    begin
      Pos:= Query.GetBookmark;
      try
        Query.DisableControls;
        Query.First;
        while not Query.Eof do begin
          fTotalDuplicatas := fTotalDuplicatas + Previsao.AsCurrency;
          Query.Next;
        end;
      finally
        Query.GotoBookmark(Pos);
        Query.FreeBookmark(Pos);
        Query.EnableControls;
        qryparcelas.AfterScroll := qryparcelasAfterScroll;
      end;
    end;
  end;

  Result := fTotalDuplicatas;
end;

