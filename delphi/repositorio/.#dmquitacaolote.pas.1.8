procedure TdtmQuitacaoLote.MarcarSelecionados(Marcando, Todos: Boolean);
var
  Pos     : TBookmark;
  I       : Integer;
  Query   : TtecQuery;
  Previsao: TFloatField;
  Quitar  : TBooleanField;

  procedure AtualizarValores;
  begin
    if Quitar.AsBoolean then begin
      FQtdeMarcados  := FQtdeMarcados + 1;
      FTotalMarcados := FTotalMarcados + Previsao.AsCurrency;
    end
    else begin
      FQtdeMarcados  := FQtdeMarcados - 1;
      FTotalMarcados := FTotalMarcados - Previsao.AsCurrency;
    end;
  end;

begin
  Query   := qryParcelas;
  Previsao:= qryParcelasvalorpagto;
  Quitar  := qryParcelasselecionar;


  if not query.IsEmpty then
  begin
   if not Todos then begin
    Query.Edit;
    Quitar.AsBoolean:= not Quitar.AsBoolean;
    Query.Post;
    AtualizarValores;
   end
   else begin
    Pos:= Query.GetBookmark;
    try
      Query.DisableControls;
      Query.First;
      for I:= 1 to Query.RecordCount do begin
        Query.Edit;
        if Marcando then begin
          if not Quitar.AsBoolean then begin
            Quitar.AsBoolean := True;
            AtualizarValores;
          end
        end
        else begin
          if Quitar.AsBoolean then begin
            Quitar.AsBoolean:= False;
            AtualizarValores;
          end;
        end;
        Query.Post;
        Query.Next;
      end;
      finally
        Query.GotoBookmark(Pos);
        Query.FreeBookmark(Pos);
        Query.EnableControls;
      end;
   end;
  end;
end;

procedure TdtmQuitacaoLote.MontaDataVencimento;
const
  Data_1: String = 'and (p.datavencto = ';
  Data_2: String = 'and (p.datavencto between (';
begin
  if not DataEmBranco(FVenctoInicial) then begin
    if DataEmBranco(FVenctoFinal) then begin
      qryParcelas.MacroByName('vencimento').AsString := Data_1 + '''' + FVenctoInicial + ''')';
    end
    else begin
      qryParcelas.MacroByName('vencimento').AsString:= Data_2 + '''' + FVenctoInicial + ''') and (''' + FVenctoFinal + '''))';
    end;
  end
  else begin
    if not DataEmBranco(FVenctoFinal) then begin
      qryParcelas.MacroByName('vencimento').AsString := Data_1 + '''' + FVenctoFinal + ''')';
    end
    else begin
      qryParcelas.MacroByName('vencimento').AsString := '';
    end;
  end;
end;


