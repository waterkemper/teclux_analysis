  object qryVolumesDadosFiscais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select'
      '  cast(rn.romaneio as varchar(20)) as codigo,'
      '  rn.dadofiscal,'
      ''
      '  vodf.codigo as numerovolume,'
      '  coalesce(nullif(vodf.volumes,0),1) as volume,'
      
        '  generate_series(1, coalesce(nullif(vodf.volumes,0),1)) as nrvo' +
        'lume,'
      '  df.chv_nfe,'
      ''
      '  n.filial,'
      '  n.serie,'
      '  n.numero,'
      ''
      '  cast(df.chv_nfe||'
      
        '  lpad(cast(generate_series(1, coalesce(nullif(vodf.volumes,0),1' +
        ')) as varchar(3)),3,'#39'0'#39')||'
      
        '  lpad(cast(coalesce(vodf.volumes,1) as varchar(3)) ,3,'#39'0'#39') as v' +
        'archar(50)) as chv_nfevolumes'
      ''
      ''
      'from romaneiosnotas rn'
      '     left join volumesdadosfiscais vodf'
      '     on rn.dadofiscal = vodf.dadofiscal'
      ''
      '     join dadosfiscais df'
      '          join notas n'
      '          on df.numero = n.dadofiscal'
      ''
      '     on rn.dadofiscal = df.numero'
      ''
      'where rn.romaneio in (%codigo)'
      '  and df.situacao <> '#39'C'#39
      ''
      'order by rn.romaneio, rn.dadofiscal')
    RequestLive = False
    Left = 480
    Top = 88
    object qryVolumesDadosFiscaiscodigo: TStringField
      FieldName = 'codigo'
    end
    object qryVolumesDadosFiscaisdadofiscal: TIntegerField
      FieldName = 'dadofiscal'
    end
    object qryVolumesDadosFiscaisvolume: TIntegerField
      FieldName = 'volume'
    end
    object qryVolumesDadosFiscaisnrvolume: TIntegerField
      FieldName = 'nrvolume'
    end
    object qryVolumesDadosFiscaischv_nfe: TStringField
      FieldName = 'chv_nfe'
      Size = 44
    end
    object qryVolumesDadosFiscaischv_nfevolumes: TStringField
      FieldName = 'chv_nfevolumes'
      Size = 50
    end
    object qryVolumesDadosFiscaisfilial: TIntegerField
      FieldName = 'filial'
    end
    object qryVolumesDadosFiscaisserie: TStringField
      FieldName = 'serie'
      Size = 3
    end
    object qryVolumesDadosFiscaisnumero: TIntegerField
      FieldName = 'numero'
    end
    object qryVolumesDadosFiscaisnumerovolume: TIntegerField
      FieldName = 'numerovolume'
    end
  end
