  object qryEstoques: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select (case when :tipo = '#39'CTR'#39' then'
      ''
      '                 (select e.localizacao'
      '                  from estoques e'
      '                  where e.produto = :produto'
      '                    and e.filial = (select pc.filial'
      '                                    from produtoscontratos pc'
      '                                    where pc.contrato = :codigo'
      
        '                                      and pc.produto = :produto ' +
        'limit 1))'
      ''
      '            when :tipo = '#39'LPA'#39' then'
      ''
      '                 (select e.localizacao'
      '                  from estoques e'
      '                  where e.produto = :produto'
      '                    and e.filial = (select lp.filial'
      '                                    from listaspadrao lp'
      
        '                                    where lp.codigo = cast(:codi' +
        'go as integer)))'
      ''
      '            when :tipo = '#39'NFS'#39' then'
      ''
      '                 (select e.localizacao'
      '                  from estoques e'
      '                  where e.produto = :produto'
      '                    and e.filial = (select pdf.filial'
      
        '                                    from produtosdadosfiscais pd' +
        'f'
      
        '                                    where pdf.dadofiscal = cast(' +
        ':codigo as integer)'
      
        '                                      and pdf.produto = :produto' +
        ' limit 1))'
      ''
      '            when :tipo = '#39'NFE'#39' then'
      ''
      '                 (select e.localizacao'
      '                  from estoques e'
      '                  where e.produto = :produto'
      '                    and e.filial = (select pnp.filial'
      '                                    from produtosnotaspag pnp'
      
        '                                    where pnp.codigonota = cast(' +
        ':codigo as integer)'
      
        '                                      and pnp.produto = :produto' +
        ' limit 1))'
      ''
      '            when :tipo = '#39'TRF'#39' then'
      ''
      '                 (select e.localizacao'
      '                  from estoques e'
      '                  where e.produto = :produto'
      '                    and e.filial = (select pf.requisitada'
      '                                    from pedidosfiliais pf'
      
        '                                    where pf.lotetransferencia =' +
        ' cast(:codigo as INTEGER)'
      
        '                                      and pf.produto = :produto ' +
        'limit 1))'
      '       end) as localizacao')
    RequestLive = False
    Left = 472
    Top = 288
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'tipo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'produto'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    object qryEstoqueslocalizacao: TStringField
      FieldName = 'localizacao'
      Size = 50
    end
  end
