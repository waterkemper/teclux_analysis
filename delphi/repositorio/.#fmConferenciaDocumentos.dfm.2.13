  object qryApagarRegistrosRPS: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'delete from volumesdadosfiscaisconferencia'
      'where (codigo,tipo) in'
      '('
      '  select c.codigo, c.tipo'
      '  from conferencia c'
      '  where c.codigo in (%codigo)'
      '    and c.tipo in ('#39'ROP'#39','#39'RPS'#39')'
      '    and exists (select crps.codigo'
      '                from conferencia crps'
      
        '                where crps.codigo = c.codigo and crps.tipo = '#39'RP' +
        'S'#39')'
      ');'
      ''
      'delete'
      '  from conferencia c'
      '  where c.codigo in (%codigo)'
      '    and c.tipo in ('#39'ROP'#39','#39'RPS'#39')'
      '    and exists (select crps.codigo'
      '                from conferencia crps'
      
        '                where crps.codigo = c.codigo and crps.tipo = '#39'RP' +
        'S'#39');'
      '')
    RequestLive = False
    Left = 128
    Top = 240
  end
