      end>
    Sql.Strings = (
      'select vdfc.tipo,'
      '       vdfc.codigo,'
      '       vdfc.dadofiscal,'
      '       n.filial,'
      '       n.serie,'
      '       n.numero,'
      '       df.chv_nfe,'
      '       vdfc.numerovolume,'
      '       vdfc.volume,'
      '       vdfc.nrvolume,'
      '       vdfc.conferido,'
      '       vdfc.conferidodigitado,'
      '       vdfc.datahora_inclusao,'
      '       vdfc.datahora_alteracao,'
      '       cast(df.chv_nfe||'
      '       lpad(cast(vdfc.nrvolume as varchar(3)),3,'#39'0'#39')||'
      
        '       lpad(cast(vdfc.volume as varchar(3)) ,3,'#39'0'#39') as varchar(5' +
        '0)) as chv_nfevolumes,'
      '       vdfc.usuario,'
      '       vdfc.filialregistro'
      ''
      'from volumesdadosfiscaisconferencia vdfc'
      '     join dadosfiscais df'
      '          join notas n'
      '          on df.numero = n.dadofiscal'
      '     on vdfc.dadofiscal = df.numero'
      ''
      'where vdfc.tipo = :tipo'
      '  and vdfc.codigo in (%codigo)'
      '    and df.situacao <> '#39'C'#39
      ''
      'order by df.data, n.numero, vdfc.volume')
    RequestLive = True
