  object qryIdentificacao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'select (case when :tipo = '#39'CTR'#39' then (select cast('#39'CONTRATO - '#39'|' +
        '|cast(:codigo as varchar) as varchar(100)))'
      
        '             when :tipo = '#39'LPA'#39' then (select cast('#39'LISTA - '#39'||ca' +
        'st(:codigo as varchar) as varchar(100)))'
      
        '             when :tipo = '#39'NFS'#39' then (select cast('#39'NF SA'#205'DA - '#39'|' +
        '|(select cast('#39'FILIAL '#39' as varchar)||cast(n.filial as varchar)||'
      
        '                                                                ' +
        '        cast('#39' S'#201'RIE '#39' as varchar)||cast(n.serie as varchar)||'
      
        '                                                                ' +
        '        cast('#39' N'#218'MERO '#39' as varchar)||cast(n.numero as varchar)'
      
        '                                                                ' +
        ' from dadosfiscais df join notas n on df.numero = n.dadofiscal'
      
        '                                                                ' +
        ' where df.numero = :codigo) as varchar(100)))'
      
        '             when :tipo = '#39'NFE'#39' then (select cast('#39'NF ENTRADA - ' +
        #39'||(select cast('#39'FORNECEDOR '#39' as varchar)||cast(np.tipofornecedo' +
        'r as varchar)||'
      
        '                                                                ' +
        '                                          cast(np.fornecedor as ' +
        'varchar)|| '
      
        '                                                                ' +
        '          cast('#39' S'#201'RIE '#39' as varchar)||cast(np.serie as varchar)|' +
        '|'
      
        '                                                                ' +
        '          cast('#39' N'#218'MERO '#39' as varchar)||cast(np.numero as varchar' +
        ')                                          '
      
        '                                                                ' +
        ' from notaspag np'
      
        '                                                                ' +
        ' where np.codigo = :codigo) as varchar(100)))'
      
        '            when :tipo = '#39'TRF'#39' then  (select cast('#39'LOTE DE TRANS' +
        'FER'#202'NCIA - '#39'||cast(:codigo as varchar) as varchar(100)))'
      '       end) as identificacao'
      '')
    RequestLive = False
    Left = 992
    Top = 200
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'tipo'
        ParamType = ptUnknown
      end
      item
