  object qryProdutosCompostos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT pc.Composto,'
      '       p2.codigovisual as compostovisual,'
      '       pc.Componente,'
      '       p.codigovisual as componentevisual,'
      '       pc.quantidade,'
      '       p.codigo,'
      '       p.descricao,'
      '       pc.preco,'
      '       (pc.quantidade * pc.preco) as total,'
      '       c.unidade as unidadecaracteristica,'
      '       pc.ordem,'
      '       pc.PossuiCustoFrete,'
      '       pc.queima,'
      '       pc.qtCeramicaCarga,'
      '       pc.percperda,'
      '       pc.imprimirosp,'
      '       pc.desconsiderarcusto,'
      '       pc.unidade,'
      '       pc.fatorconversao,'
      '       pc.ExibirFluxogramaPlanilhaCusto,'
      '       pc.QuantidadeehSomatoriodosComponentes,'
      ''
      '       p.valorgrade1,'
      '       gr_lin.descricao as linha,'
      '       p.valorgrade2,'
      '       gr_col.descricao as coluna'
      ''
      ''
      'FROM produtoscompostos pc'
      '     JOIN produtos p on p.codigo = pc.componente'
      '          JOIN caracteristicas c'
      
        '               left join grades gr_lin on c.grade1 = gr_lin.codi' +
        'go'
      
        '               left join grades gr_col on c.grade2 = gr_col.codi' +
        'go'
      '          on p.caracteristica = c.codigo'
      '     join produtos p2 on p2.codigo = pc.composto'
      'WHERE pc.composto = :composto'
      'order by pc.ordem, pc.componente'
      '')
    RequestLive = True
    Left = 1040
    Top = 240
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'composto'
        ParamType = ptUnknown
      end>
