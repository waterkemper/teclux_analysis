  object qryProdutosConferencia: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryProdutosConferenciaCalcFields
    OnNewRecord = qryProdutosConferenciaNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cp.tipo,'
      '       cp.codigo,'
      '       cp.produto,'
      '       p.codigovisual,'
      '       p.descricao,'
      '       cp.lido,'
      '       cast(null as numeric(11,3)) as quantidade,'
      '       cp.digitado,'
      ''
      '       p.valorgrade1,'
      '       gr_lin.descricao as linha,'
      '       p.valorgrade2,'
      '       gr_col.descricao as coluna'
      ''
      ''
      'from produtosconferencia cp'
      '     join produtos p'
      '          join caracteristicas c'
      
        '               left join grades gr_lin on c.grade1 = gr_lin.codi' +
        'go'
      
        '               left join grades gr_col on c.grade2 = gr_col.codi' +
        'go'
      '          on p.caracteristica = c.codigo'
      '     on cp.produto = p.codigo'
      ''
      'where cp.tipo = :tipo'
      '  and cp.codigo = :codigo '
      ''
      'order by p.codigovisual')
    RequestLive = True
    Left = 856
    Top = 96
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'tipo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    object qryProdutosConferenciatipo: TStringField
      FieldName = 'tipo'
      Size = 3
    end
