  object qryProcuraProdutosCodigoBarras: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select p.codigo,'
      '       p.codigovisual,'
      '       pcb.codigobarras,'
      '       p.descricao,'
      '       p.valorgrade1,'
      '       gr_lin.descricao as linha,'
      '       p.valorgrade2,'
      '       gr_col.descricao as coluna'
      '       '
      ''
      'From   produtos p'
      '       join caracteristicas c'
      '            left join grades gr_lin on c.grade1 = gr_lin.codigo'
      '            left join grades gr_col on c.grade2 = gr_col.codigo'
      '       on p.caracteristica = c.codigo'
      ''
      '       join produtoscodigobarras pcb'
      '       on p.codigo = pcb.produto'
      ''
      'where pcb.codigobarras = :codigobarras')
    RequestLive = True
    Left = 858
    Top = 233
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigobarras'
        ParamType = ptUnknown
      end>
