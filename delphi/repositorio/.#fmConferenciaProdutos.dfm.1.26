  object qryProdutosConferenciaVisao: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterPost = qryProdutosConferenciaVisaoAfterPost
    AfterDelete = qryProdutosConferenciaVisaoAfterDelete
    AfterScroll = qryProdutosConferenciaVisaoAfterScroll
    OnCalcFields = qryProdutosConferenciaVisaoCalcFields
    OnNewRecord = qryProdutosConferenciaVisaoNewRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select cp.*,'
      ''
      '       (case when cp.tipo = '#39'CTR'#39' then'
      ''
      '                 (select e.localizacao'
      '                  from estoques e'
      '                  where e.produto = cp.produto'
      '                    and e.filial = (select pc.filial'
      '                                    from produtoscontratos pc'
      
        '                                    where pc.contrato = cp.codig' +
        'o'
      
        '                                      and pc.produto = cp.produt' +
        'o limit 1))'
      ''
      '            when cp.tipo = '#39'LPA'#39' then'
      ''
      '                 (select e.localizacao'
      '                  from estoques e'
      '                  where e.produto = cp.produto'
      '                    and e.filial = (select lp.filial'
      '                                    from listaspadrao lp'
      
        '                                    where lp.codigo = cast(cp.co' +
        'digo as integer)))'
      ''
      '            when cp.tipo = '#39'NFS'#39' then'
      ''
      '                 (select e.localizacao'
      '                  from estoques e'
      '                  where e.produto = cp.produto'
      '                    and e.filial = (select pdf.filial'
      
        '                                    from produtosdadosfiscais pd' +
        'f'
      
        '                                    where pdf.dadofiscal = cast(' +
        'cp.codigo as integer)'
      
        '                                      and pdf.produto = cp.produ' +
        'to limit 1))'
      ''
      '            when cp.tipo = '#39'NFE'#39' then'
      ''
      '                 (select e.localizacao'
      '                  from estoques e'
      '                  where e.produto = cp.produto'
      '                    and e.filial = (select pnp.filial'
      '                                    from produtosnotaspag pnp'
      
        '                                    where pnp.codigonota = cast(' +
        'cp.codigo as integer)'
      
        '                                      and pnp.produto = cp.produ' +
        'to limit 1))'
      ''
      '            when cp.tipo = '#39'TRF'#39' then'
      ''
      '                 (select e.localizacao'
      '                  from estoques e'
      '                  where e.produto = cp.produto'
      '                    and e.filial = (select pf.requisitada'
      '                                    from pedidosfiliais pf'
      
        '                                    where pf.codigo = cast(cp.co' +
        'digo as INTEGER)'
      
        '                                      and pf.produto = cp.produt' +
        'o limit 1))'
      '       end) as localizacao'
      ''
      'from'
      '('
      'select cp.tipo,'
      '       cp.codigo,'
      '       cp.produto,'
      '       p.codigovisual,'
      '       p.descricao,'
      '       cp.lido,'
      '       cast(null as numeric(11,3)) as quantidade,'
      '       cp.digitado,'
      '       cast(null as bigint) as composto,'
      '       cast('#39#39' as varchar(30)) as compostovisual,'
      '       p.valorgrade1,'
      '       gr_lin.descricao as linha,'
      '       p.valorgrade2,'
      '       gr_col.descricao as coluna'
      ''
      'from produtosconferencia cp'
      '     join produtos p'
      '          join caracteristicas c'
      
        '               left join grades gr_lin on c.grade1 = gr_lin.codi' +
        'go'
      
        '               left join grades gr_col on c.grade2 = gr_col.codi' +
        'go'
      '          on p.caracteristica = c.codigo'
      '     on cp.produto = p.codigo'
      ''
      
        'where not (coalesce(c.composto,false) and coalesce(c.conferircom' +
        'posto,false))'
      '  and cp.tipo = :tipo'
      '  and cp.codigo = :codigo'
      ''
      ''
      'union all'
      ''
      'select cp.tipo,'
      '       cp.codigo,'
      '       pcc.componente as produto,'
      '       p.codigovisual,'
      '       p.descricao,'
      '       pcc.lido,'
      '       cast(null as numeric(11,3)) as quantidade,'
      '       pcc.digitado,'
      '       pcc.composto,'
      '       p2.codigovisual as compostovisual,'
      ''
      '       p.valorgrade1,'
      '       gr_lin.descricao as linha,'
      '       p.valorgrade2,'
      '       gr_col.descricao as coluna'
      ''
      ''
      'from produtosconferencia cp'
      '     join produtosconferenciacompostos pcc'
      '          join produtos p'
      '               join caracteristicas c'
      
        '                    left join grades gr_lin on c.grade1 = gr_lin' +
        '.codigo'
      
        '                    left join grades gr_col on c.grade2 = gr_col' +
        '.codigo'
      '               on p.caracteristica = c.codigo'
      '          on pcc.componente = p.codigo'
      '     on cp.tipo = pcc.tipo'
      '     and cp.codigo = pcc.codigo'
      '     and cp.produto = pcc.composto'
      ''
      '     join produtos p2'
      '          join caracteristicas c2'
      '          on p2.caracteristica = c2.codigo'
      '     on pcc.composto = p2.codigo'
      ''
      ''
      ''
      
        ' where (coalesce(c2.composto,false) and coalesce(c2.conferircomp' +
        'osto,false))'
      '  and cp.tipo = :tipo'
      '  and cp.codigo = :codigo'
      ''
      ') as cp'
      'order by codigovisual, composto')
    RequestLive = True
    Left = 1000
    Top = 96
    ParamData = <
      item
        DataType = ftString
        Name = 'tipo'
        ParamType = ptUnknown
        Value = #39'NFE'#39
      end
      item
        DataType = ftString
        Name = 'codigo'
        ParamType = ptUnknown
        Value = '685398'
      end>
