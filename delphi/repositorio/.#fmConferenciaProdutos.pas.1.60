procedure TfrmConferenciaProdutos.VisualizarImageURL(pTipoProcuraVisualizacaoIMG: TipoProcuraVisualizacaoIMG);
begin
  if fraVisualizarImageURL1_visible then
  begin
    fraVisualizarImageURL1.visible := true;

    case pTipoProcuraVisualizacaoIMG of
      timgprocuraCB:
            begin
              if produtoprocuracodigobarras <> '' then
                fraVisualizarImageURL1.produto := produtoprocuracodigobarras
              else
                fraVisualizarImageURL1.produto := produto;
             end;

      timgprocuracodigo:
             begin
                if produtoprocuraproduto <> '' then
                  fraVisualizarImageURL1.produto := produtoprocuraproduto
                else
                  fraVisualizarImageURL1.produto := produto;
             end;

      timgproduto: fraVisualizarImageURL1.produto := produto;
   end;

    fraVisualizarImageURL1.AbrirqryFotosProdutos(parsistema.ExibirCodigodoProdutonaConferencia);
    fraVisualizarImageURL1.produto := produto;
    fraVisualizarImageURL1.visible := fraVisualizarImageURL1_visible;
  end;
end;

