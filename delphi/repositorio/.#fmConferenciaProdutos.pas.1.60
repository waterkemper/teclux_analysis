begin
  inherited;
  qryConferenciafilial.asinteger := filialbase;
end;

procedure TfrmConferenciaProdutos.edtCodigoBarrasKeyPress(Sender: TObject;
  var Key: Char);

begin
  inherited;

//  vPressionadoEnter := key = #13;
//  if not vPressionadoEnter then

    vPressionadoAsterisco := key = '*';

    {
  if vPressionadoEnter and
     vPressionadoAsterisco then
  begin

    try
      vQuantidadeManual := strtoint(somentenumero( copy(edtCodigoBarras.text,0,
                                         pos('*',edtCodigoBarras.text)-1)));
    except
      vQuantidadeManual := 0;
    end;

    edtCodigoBarras.clear;

  end;
  }



end;

end.



