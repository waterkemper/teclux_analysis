constructor TfrmConferenciaProdutos.Create(Aowner: Tcomponent);
begin
//  dtmConferenciaProdutos := TdtmConferenciaProdutos.Create(Self);
  inherited;
  dmbasico := TdtmBasico.Create(self);

  TipoPesquisaProduto :=  pesPRODUTO;
  qryProdutosconferenciaquantidade.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosconferencialido.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosconferenciaQuantidadeFaltante.DisplayFormat := ParSistema.MascaraQuantidadeGrade;
  qryProdutosconferenciaQuantidadeExcedente.DisplayFormat := ParSistema.MascaraQuantidadeGrade;

  if dbgProdutos.ColumnByName('quantidade').Width < ParSistema.TamanhoMascaraQuantidade then  dbgProdutos.ColumnByName('quantidade').Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgProdutos.ColumnByName('lido').Width < ParSistema.TamanhoMascaraQuantidade then  dbgProdutos.ColumnByName('lido').Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgProdutos.ColumnByName('QuantidadeFaltante').Width < ParSistema.TamanhoMascaraQuantidade then  dbgProdutos.ColumnByName('QuantidadeFaltante').Width := ParSistema.TamanhoMascaraQuantidade;
  if dbgProdutos.ColumnByName('QuantidadeExcedente').Width < ParSistema.TamanhoMascaraQuantidade then  dbgProdutos.ColumnByName('QuantidadeExcedente').Width := ParSistema.TamanhoMascaraQuantidade;

  dbgProdutos.ColumnByName('codigovisual').Visible := parsistema.ExibirCodigodoProdutonaConferencia;

  dbgProdutos.ColumnByName('valorgrade1').Visible := parsistema.UsarGradesProdutos;
  dbgProdutos.ColumnByName('valorgrade2').Visible := parsistema.UsarGradesProdutos;

  InitialResize := false;

//  fraVisualizarImageURL1.Produto := Produto;

    {
  self.Width := 240;
  self.Height := 320;
  self.Left := 680;
     }

  dbgProdutos.ColumnByName('lido').readonly := not parsistema.permitirQtManualProdutosConferidos;   



end;

destructor TfrmConferenciaProdutos.Destroy;
begin

  inherited;
end;

procedure TfrmConferenciaProdutos.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  if {EscParaVoltar and} (key = VK_ESCAPE) THEN
    close
  ELSE
    case Key of
      VK_F5 : if sbnSalvar.enabled then
               sbnSalvarClick(self);

      VK_F7 : if btnImprimir.enabled then
               btnImprimirClick(self);

      VK_F11 : begin
                  if gbxCodigoBarras.caption = 'CÓDIGO DE BARRAS' then
                     gbxCodigoBarras.caption := 'PRODUTO'
                   else
                     gbxCodigoBarras.caption := 'CÓDIGO DE BARRAS';
               end;

      else
      inherited;
    end;

end;

procedure TfrmConferenciaProdutos.qryProdutosConferenciaCalcFields(DataSet: TDataSet);
begin
  inherited;
  if qryProdutosconferenciaquantidade.AsCurrency > qryProdutosconferencialido.AsCurrency then
  begin
    qryProdutosconferenciaQuantidadeFaltante.AsCurrency := qryProdutosconferenciaquantidade.AsCurrency - qryProdutosconferencialido.AsCurrency;
    qryProdutosconferenciaQuantidadeExcedente.AsCurrency := 0;
  end
  else
  if qryProdutosconferenciaquantidade.AsCurrency < qryProdutosconferencialido.AsCurrency then
  begin
    qryProdutosconferenciaQuantidadeFaltante.AsCurrency := 0;
    qryProdutosconferenciaQuantidadeExcedente.AsCurrency := qryProdutosconferencialido.AsCurrency - qryProdutosconferenciaquantidade.AsCurrency;
//    MensagemAviso('A quantidade lida ultrapassou a quantidade do documento.',true)
  end
  else
  begin
    qryProdutosconferenciaQuantidadeFaltante.AsCurrency := 0;
    qryProdutosconferenciaQuantidadeExcedente.AsCurrency := 0;
  end;

end;

procedure TfrmConferenciaProdutos.edtCodigoBarrasKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  if Key = VK_RETURN then
  begin
    try

      if vPressionadoAsterisco {and not vAguardandoChave} then
      begin

        try
          vQuantidadeManual := somentenumero( copy(edtCodigoBarras.text,0,
                                             pos('*',edtCodigoBarras.text)-1));
        except
          vQuantidadeManual := '0';
        end;

        edtCodigoBarras.clear;

        StaticTextQtLida.caption := vQuantidadeManual;

//        vAguardandoChave := true;

      end;


      if edtCodigoBarras.Text<>''then
      begin
//        vAguardandoChave := false;
        vPressionadoAsterisco := false;


        if gbxCodigoBarras.Caption = 'CÓDIGO DE BARRAS' then
        begin
          TipoPesquisaProduto := pesCodigoBarras;
          LocalizarProduto(edtCodigoBarras.Text, vQuantidadeManual)
        end
        else
        begin
          TipoPesquisaProduto :=  pesPRODUTO;
          LocalizarProduto(edtCodigoBarras.Text, vQuantidadeManual);
        end;
        vQuantidadeManual := '';
        StaticTextQtLida.caption := '';
      end;

    finally

      edtCodigoBarras.SetFocus;
      while ActiveControl.Name <> edtCodigoBarras.Name do
        edtCodigoBarras.SetFocus;

      edtCodigoBarras.SelectAll;
      SendMessage(edtCodigoBarras.Handle, EM_SETSEL, 0, length(edtCodigoBarras.Text));
    end
  end;

end;

procedure TfrmConferenciaProdutos.LocalizarProduto(TextodePesquisa, quantidademanual: String);

  Procedure IncluirProduto;
  begin
    case TipoPesquisaProduto of
      pesCODIGOBARRAS:
      begin

        AbrirTabelaEstoque(tipo, qryProcuraProdutosCodigoBarrascodigo.AsString, CodigoDocumento);

        qryprodutosconferenciavisao.append;
        qryProdutosConferenciavisaotipo.AsString := Tipo;
        qryProdutosConferenciavisaocodigo.AsString := CodigoDocumento;
        qryProdutosconferenciavisaoproduto.AsString := qryProcuraProdutosCodigoBarrascodigo.AsString;
        qryProdutosConferenciaVisaocomposto.clear;
        qryProdutosConferenciaVisaocompostovisual.asstring := '';
        qryProdutosconferenciavisaocodigovisual.AsString := qryProcuraProdutosCodigoBarrascodigovisual.AsString;
        qryProdutosconferenciavisaodescricao.AsString := qryProcuraProdutosCodigoBarrasdescricao.AsString;
        qryProdutosConferenciaVisaolocalizacao.AsString := qryEstoqueslocalizacao.asString;

        qryProdutosConferenciaVisaovalorgrade1.asString := qryProcuraProdutosCodigoBarrasvalorgrade1.asString;
        qryProdutosConferenciaVisaovalorgrade2.asString := qryProcuraProdutosCodigoBarrasvalorgrade2.asString;
        qryProdutosConferenciaVisaolinha.asString := qryProcuraProdutosCodigoBarraslinha.asString;
        qryProdutosConferenciaVisaocoluna.asString := qryProcuraProdutosCodigoBarrascoluna.asString;


        qryProdutosconferenciavisaolido.AsInteger := 1;
        qryprodutosconferenciavisao.post;

        qryprodutosconferencia.append;
        qryProdutosConferenciatipo.AsString := Tipo;
        qryProdutosConferenciacodigo.AsString := CodigoDocumento;
        qryProdutosconferenciaproduto.AsString := qryProcuraProdutosCodigoBarrascodigo.AsString;
        qryProdutosconferenciacodigovisual.AsString := qryProcuraProdutosCodigoBarrascodigovisual.AsString;
        qryProdutosconferenciadescricao.AsString := qryProcuraProdutosCodigoBarrasdescricao.AsString;

        qryProdutosConferenciavalorgrade1.asString := qryProcuraProdutosCodigoBarrasvalorgrade1.asString;
        qryProdutosConferenciavalorgrade2.asString := qryProcuraProdutosCodigoBarrasvalorgrade2.asString;
        qryProdutosConferencialinha.asString := qryProcuraProdutosCodigoBarraslinha.asString;
        qryProdutosConferenciacoluna.asString := qryProcuraProdutosCodigoBarrascoluna.asString;

        qryProdutosconferencialido.AsInteger := 1;
        qryprodutosconferencia.post;

      end;

      pesPRODUTO:
      begin
        AbrirTabelaEstoque(tipo, qryProcuraProdutoscodigo.AsString, CodigoDocumento);
        qryprodutosconferenciavisao.append;
        qryProdutosConferenciavisaotipo.AsString := Tipo;
        qryProdutosConferenciavisaocodigo.AsString := CodigoDocumento;
        qryProdutosconferenciavisaoproduto.AsString := qryProcuraProdutoscodigo.AsString;
        qryProdutosConferenciaVisaocomposto.clear;
        qryProdutosConferenciaVisaocompostovisual.asString := '';
        qryProdutosconferenciavisaocodigovisual.AsString := qryProcuraProdutoscodigovisual.AsString;
        qryProdutosconferenciavisaodescricao.AsString := qryProcuraProdutosdescricao.AsString;
        qryProdutosConferenciaVisaolocalizacao.AsString := qryEstoqueslocalizacao.asString;

        qryProdutosConferenciaVisaovalorgrade1.asString := qryProcuraProdutosvalorgrade1.asString;
         qryProdutosConferenciaVisaovalorgrade2.asString := qryProcuraProdutosvalorgrade2.asString;
        qryProdutosConferenciaVisaolinha.asString := qryProcuraProdutoslinha.asString;
        qryProdutosConferenciaVisaocoluna.asString := qryProcuraProdutoscoluna.asString;

        qryProdutosconferenciavisaolido.AsInteger := 1;
        qryprodutosconferenciavisao.post;

        qryprodutosconferencia.append;
        qryProdutosConferenciatipo.AsString := Tipo;
        qryProdutosConferenciacodigo.AsString := CodigoDocumento;
        qryProdutosconferenciaproduto.AsString := qryProcuraProdutoscodigo.AsString;
        qryProdutosconferenciacodigovisual.AsString := qryProcuraProdutoscodigovisual.AsString;
        qryProdutosconferenciadescricao.AsString := qryProcuraProdutosdescricao.AsString;

        qryProdutosConferenciavalorgrade1.asString := qryProcuraProdutosvalorgrade1.asString;
        qryProdutosConferenciavalorgrade2.asString := qryProcuraProdutosvalorgrade2.asString;
        qryProdutosConferencialinha.asString := qryProcuraProdutoslinha.asString;
        qryProdutosConferenciacoluna.asString := qryProcuraProdutoscoluna.asString;

        qryProdutosconferencialido.AsInteger := 1;
        qryprodutosconferencia.post;
      end;
    end;
  end;

  Procedure ProcurarOutrasOcorrencias(NomeDoCampo: String);
  var
    vRegistroAtual: TBookMark;
    vRegistroEncontrado : Boolean;
  begin
    if (qryProdutosconferenciaVisaoquantidade.AsCurrency < (qryProdutosconferenciaVisaolido.AsCurrency + 1)) then
    begin

      vRegistroEncontrado := false;
      vRegistroAtual := qryProdutosconferenciaVisao.GetBookmark;

      qryProdutosconferenciaVisao.first;

      while not qryProdutosconferenciaVisao.Eof do
      begin

        if qryProdutosconferenciaVisao.GetBookmark <> vRegistroAtual then
        begin

          case TipoPesquisaProduto of
            pesCODIGOBARRAS:
            begin
              if (qryProdutosconferenciaVisao.fieldbyname(NomedoCampo).asString = qryProcuraProdutosCodigoBarrascodigovisual.AsString) and
                 (qryProdutosconferenciaVisaoquantidade.AsCurrency >= (qryProdutosconferenciaVisaolido.AsCurrency + 1)) then
              begin
                 vRegistroEncontrado := True;
                 break;
              end;
            end;

            pesPRODUTO:
            begin
              if (qryProdutosconferenciaVisao.fieldbyname(NomedoCampo).asString = qryProcuraProdutoscodigovisual.AsString) and
                 (qryProdutosconferenciaVisaoquantidade.AsCurrency >= (qryProdutosconferenciaVisaolido.AsCurrency + 1)) then
              begin
                 vRegistroEncontrado := True;
                 break;
              end;
            end;
          end;

        end;

        qryProdutosconferenciaVisao.next;
      end;

      if not vRegistroEncontrado then
        qryProdutosconferenciaVisao.GotoBookmark(vRegistroAtual);

      qryProdutosconferenciaVisao.freeBookmark(vRegistroAtual);

    end;
  end;

begin
  try

    fraVisualizarImageURL1_visible := fraVisualizarImageURL1.visible;
    fraVisualizarImageURL1.visible := false;

    dsrProdutosConferenciavisao.onDataChange := nil;
    case TipoPesquisaProduto of
      pesCODIGOBARRAS:
      begin
        dmbasico.RefazConsultaPorNome(qryProcuraProdutosCodigoBarras,['codigobarras'], [TextodePesquisa]);

        if qryProcuraProdutosCodigoBarras.IsEmpty then
        begin
          biblio.PlaySound(self);
          MensagemAviso(format('O produto com o Código de Barras ''%s'' não está cadastrado',[TextodePesquisa]), true);
        end
        else
        {aqui vai ter alteração}

        if not qryProdutosconferenciaVisao.Locate('produto', qryProcuraProdutosCodigoBarrascodigo.AsString,[]) then
        begin

          VisualizarImageURL(timgprocuraCB);

          biblio.PlaySound(self);


          {
          Application.MessageBeep(MB_IconAsterisk);

          PlaySound('Campainha do Windows XP',0,snd_Async);
          }

          {
          Tocando Sons WAV

          Para reproduzir sons no formato WAV em um programa em Delphi é simples, o usuário deverá colocar na clásula Uses o MMSystem. E no corpo do programa o comando:

          Código:          ]
          }


          if Tipo = 'LPA' then
          begin
            if MensagemSelecionaOpcao(format('O produto com o Código de Barras ''%s'' não está presente na lista'+#13+
                                             'Deseja inclui-lo na lista abaixo?',[TextodePesquisa])) = smbYES then
              IncluirProduto;
          end
          else
             MensagemAviso(format('O produto com o Código de Barras ''%s'' não está presente na lista',[TextodePesquisa]), True);

          VisualizarImageURL;

        end
        else
        begin

          ProcurarOutrasOcorrencias('produto');

          if quantidademanual='' then
          begin
            qryProdutosConferenciaVisao.Edit;
            qryProdutosConferenciaVisaolido.AsCurrency := qryProdutosConferenciaVisaolido.AsCurrency + 1;
            qryProdutosConferenciaVisao.post;
          end
          else
          begin
            qryProdutosConferenciaVisao.Edit;
            qryProdutosConferenciaVisaolido.AsCurrency := strtofloat(quantidademanual);
            qryProdutosConferenciaVisaodigitado.asBoolean := (qryProdutosConferenciaVisaolido.AsCurrency<>0);
            qryProdutosConferenciaVisao.post;
          end;


          VisualizarImageURL(timgprocuraCB);

        end;
      end;

      pesPRODUTO:
      begin
        if ParSistema.PermitirProdutoAlfanumerico then
        begin
          if not qryProdutosConferenciaVisao.Locate('codigovisual',TextodePesquisa,[]) then
          begin
            dmbasico.RefazConsultaPorNome(qryProcuraProdutos,['codigo','codigovisual'], ['0',TextodePesquisa]);
            if qryProcuraProdutos.IsEmpty then
            begin
              MensagemAviso(format('O produto com o Código ''%s'' não está cadastrado',[TextodePesquisa]), true);
              biblio.PlaySound(self);
            end
            else
            begin
              VisualizarImageURL(timgprocuracodigo);
              biblio.PlaySound(self);

              if Tipo = 'LPA' then
              begin
                if MensagemSelecionaOpcao(format('O produto com o Código ''%s'' não está presente na lista'+#13+
                                             'Deseja inclui-lo na lista abaixo?',[TextodePesquisa])) = smbYES then
                  IncluirProduto;
              end
              else
                MensagemAviso(format('O produto com o Código ''%s'' não está presente na lista',[TextodePesquisa]), true);

              VisualizarImageURL;

            end;
          end
          else
          begin
            ProcurarOutrasOcorrencias('codigovisual');

            if quantidademanual='' then
            begin
              qryProdutosConferenciaVisao.Edit;
              qryProdutosConferenciaVisaolido.AsCurrency := qryProdutosConferenciaVisaolido.AsCurrency + 1;
              qryProdutosConferenciaVisao.post;
            end
            else
            begin
              qryProdutosConferenciaVisao.Edit;
              qryProdutosConferenciaVisaolido.AsCurrency := strtofloat(quantidademanual);
              qryProdutosConferenciaVisaodigitado.asBoolean := (qryProdutosConferenciaVisaolido.AsCurrency<>0);
              qryProdutosConferenciaVisao.post;
            end;


            VisualizarImageURL;


          end;
        end
        else
        begin
          if not qryProdutosConferenciaVisao.Locate('produto',TextodePesquisa,[]) then
          begin
            dmbasico.RefazConsultaPorNome(qryProcuraProdutos,['codigo','codigovisual'], [TextodePesquisa,'']);
            if qryProcuraProdutos.IsEmpty then
            begin
              biblio.PlaySound(self);
              MensagemAviso(format('O produto com o Código ''%s'' não está cadastrado',[TextodePesquisa]), true);
            end
            else
            begin

              VisualizarImageURL(timgprocuracodigo);

              biblio.PlaySound(self);

              if Tipo = 'LPA' then
              begin
                if MensagemSelecionaOpcao(format('O produto com o Código ''%s'' não está presente na lista'+#13+
                                               'Deseja inclui-lo na lista abaixo?',[TextodePesquisa])) = smbYES then
                  IncluirProduto
              end
              else
                MensagemAviso(format('O produto com o Código ''%s'' não está presente na lista',[TextodePesquisa]), true);

              VisualizarImageURL;

            end;
          end
          else
          begin
            ProcurarOutrasOcorrencias('produto');

            if quantidademanual='' then
            begin
              qryProdutosConferenciaVisao.Edit;
              qryProdutosConferenciaVisaolido.AsCurrency := qryProdutosConferenciaVisaolido.AsCurrency + 1;
              qryProdutosConferenciaVisao.post;
            end
            else
            begin
              qryProdutosConferenciaVisao.Edit;
              qryProdutosConferenciaVisaolido.AsCurrency := strtofloat(quantidademanual);
              qryProdutosConferenciaVisaodigitado.asBoolean := (qryProdutosConferenciaVisaolido.AsCurrency<>0);
              qryProdutosConferenciaVisao.post;
            end;


            VisualizarImageURL;

          end;
        end;
      end;
    end;

  finally
    fraVisualizarImageURL1.visible := fraVisualizarImageURL1_visible;
    dsrProdutosConferenciavisao.onDataChange := dsrProdutosConferenciavisaoDataChange;

    MensagemQuantidadeExcedente;

  end;

end;

procedure TfrmConferenciaProdutos.ConferirProdutos(RefazerProdutos: boolean = false; RecomecarFE: Boolean = false);
var
  vRegistroAtual : TBookMark;
  vRegistroAtualVisao : TBookMark;
  vCamposCaracteristica: TVariantArray;
  vContinuar : Boolean;
begin
  try

    fraVisualizarImageURL1_visible := fraVisualizarImageURL1.visible;
    fraVisualizarImageURL1.visible := false;

    vContinuar := True;
    with frmConferenciaProdutos do
    begin
      // qryProdutosConferencia.OnCalcFields := nil;
      //ACRESCENTEI ESTA CONDICAO CASO CONTRARIO NAO FUNCIONA ZERAR SOMENTE EXCEDENTES OU FALTANTES .. SEMPRE ZERA TUDO - 19/07/2017

      vRegistroAtual := qryTabelaProdutos.getbookMark;
      vRegistroAtualVisao := qryProdutosConferenciaVisao.getbookMark;

  //    qryProdutosConferenciaVisao.SortClear;

      if not RefazerProdutos then
      begin
        qryProdutosConferenciavisao.DisableControls;
        qryProdutosConferenciavisao.AfterScroll := nil;

        qryConferencia.ParamByname('tipo').AsString := Tipo;
        qryConferencia.ParamByname('codigo').AsString := CodigoDocumento;
        qryConferencia.Close;
        qryConferencia.Open;
        if qryConferencia.isempty then
        begin
          qryConferencia.append;
          qryConferenciatipo.AsString := Tipo;
          qryConferenciacodigo.AsString := CodigoDocumento;
          qryConferenciadata.AsDateTime := now;
          qryConferenciausuario.AsInteger := dmbasico.CodigoUsuario;
          qryConferencia.post;
        end;
        qryProdutosConferencia.ParamByname('tipo').AsString := Tipo;
        qryProdutosConferencia.ParamByname('codigo').AsString := CodigoDocumento;
        qryProdutosConferencia.Close;
        qryProdutosConferencia.Open;

        qryProdutosConferenciaCompostos.ParamByname('tipo').AsString := Tipo;
        qryProdutosConferenciaCompostos.ParamByname('codigo').AsString := CodigoDocumento;
        qryProdutosConferenciaCompostos.Close;
        qryProdutosConferenciaCompostos.Open;

        qryProdutosConferenciaVisao.ParamByname('tipo').AsString := Tipo;
        qryProdutosConferenciaVisao.ParamByname('codigo').AsString := CodigoDocumento;
        qryProdutosConferenciaVisao.Close;
        qryProdutosConferenciaVisao.Open;

        qryTabelaProdutos.First;

        if tipo <> 'TRF' then
        begin
          dbgProdutos.denysort := False;
          while not qryTabelaProdutos.eof do
          begin

            if (qryTabelaProdutos.findfield('compostovisual')<>nil) and
               (qryTabelaProdutos.findfield('produtovisual')<>nil) and
               (qryTabelaProdutos.fieldbyname('compostovisual').asString <>
                qryTabelaProdutos.fieldbyname('produtovisual').asString) then
              vContinuar := false
            else
              vContinuar := True;

            if vContinuar then
            begin

              if not qryProdutosConferencia.Locate('produto',qrytabelaprodutos.fieldbyname(NomeCampoCodigo).asstring, []) then
              begin
                qryProdutosConferencia.Append;
                qryProdutosConferenciatipo.AsString := Tipo;
                qryProdutosConferenciacodigo.AsString := CodigoDocumento;
                qryProdutosConferenciaproduto.AsString := qrytabelaprodutos.fieldbyname(NomeCampoCodigo).asstring;
                qryProdutosConferenciacodigovisual.AsString := qrytabelaprodutos.fieldbyname(NomeCampoCodigoVisual).asstring;
                qryProdutosConferenciadescricao.AsString := qrytabelaprodutos.fieldbyname(NomeCampoDescricao).asstring;
                qryProdutosConferenciaquantidade.AsCurrency := qrytabelaprodutos.fieldbyname(NomeCampoQuantidade).AsCurrency;
                qryProdutosConferencia.post;
              end
              else
              begin
                qryProdutosConferencia.edit;
                qryProdutosConferenciaquantidade.AsCurrency := qryProdutosConferenciaquantidade.AsCurrency + qrytabelaprodutos.fieldbyname(NomeCampoQuantidade).AsCurrency;
                qryProdutosConferencia.post;
              end;

              vCamposCaracteristica := dmbasico.ValorCampodaTabela('caracteristicas',
                         ['p.codigo'],
                         [qrytabelaprodutos.fieldbyname('produto').asstring],
                         ['composto','conferircomposto'],
                          ' and codigo = (select p.caracteristica from produtos p where %s = %s ) ');

              if (vCamposCaracteristica[0] = True) and
                 (vCamposCaracteristica[1] = True) then
              begin
                qryProdutosCompostos.ParamByName('composto').asString := qrytabelaprodutos.fieldbyname(NomeCampoCodigo).asstring;
                qryProdutosCompostos.close;
                qryProdutosCompostos.open;
                qryProdutosCompostos.first;
                while not qryProdutosCompostos.eof do
                begin
                  if not qryProdutosConferenciaCompostos.Locate('composto;componente',
                                                VarArrayOf([qryProdutosCompostoscomposto.asString,
                                                            qryProdutosCompostoscomponente.asstring]), [] ) then
                  begin
                    qryProdutosConferenciaCompostos.Append;
                    qryProdutosConferenciaCompostostipo.AsString := Tipo;
                    qryProdutosConferenciaCompostoscodigo.AsString := CodigoDocumento;
                    qryProdutosConferenciaCompostoscomponente.AsString := qryProdutosCompostoscomponente.asstring;
                    qryProdutosConferenciaCompostoscomposto.AsString := qryProdutosCompostoscomposto.AsString;
                    qryProdutosConferenciaCompostosquantidade.AsCurrency := (qrytabelaprodutos.fieldbyname(NomeCampoQuantidade).AsCurrency * qryProdutosCompostosquantidade.AsCurrency);
                    qryProdutosConferenciaCompostosquantidadecomponente.ascurrency := qryProdutosCompostosquantidade.asCurrency;
                    qryProdutosConferenciaCompostos.post;
                  end
                  else
                  begin
                    qryProdutosConferenciaCompostos.edit;
                    qryProdutosConferenciaCompostosquantidade.AsCurrency := qryProdutosConferenciaCompostosquantidade.AsCurrency + (qrytabelaprodutos.fieldbyname(NomeCampoQuantidade).AsCurrency * qryProdutosCompostosquantidade.AsCurrency);
                    qryProdutosConferenciaCompostos.post;
                  end;

                  if not qryProdutosConferenciaVisao.Locate('produto;composto',
                                                VarArrayOf([qryProdutosCompostoscomponente.asstring,
                                                            qryProdutosCompostoscomposto.asString]), []) then
                  begin

                    AbrirTabelaEstoque(tipo, qryProdutosCompostoscomponente.asstring, CodigoDocumento);

                    qryProdutosConferenciaVisao.Append;
                    qryProdutosConferenciaVisaotipo.AsString := Tipo;
                    qryProdutosConferenciaVisaocodigo.AsString := CodigoDocumento;
                    qryProdutosConferenciaVisaoproduto.AsString := qryProdutosCompostoscomponente.asstring;
                    qryProdutosConferenciaVisaocodigovisual.AsString := qryProdutosCompostoscomponentevisual.asstring;
                    qryProdutosConferenciaVisaocomposto.asString :=  qryProdutosCompostoscomposto.AsString;
                    qryProdutosConferenciaVisaocompostovisual.asString := qryProdutosCompostoscompostovisual.AsString;
                    qryProdutosConferenciaVisaodescricao.AsString := qryProdutosCompostosdescricao.AsString;
                    qryProdutosConferenciaVisaolocalizacao.AsString := qryEstoqueslocalizacao.asString;

                    qryProdutosConferenciaVisaovalorgrade1.asString := qryProdutosCompostosvalorgrade1.asString;
                    qryProdutosConferenciaVisaovalorgrade2.asString := qryProdutosCompostosvalorgrade2.asString;
                    qryProdutosConferenciaVisaolinha.asString := qryProdutosCompostoslinha.asString;
                    qryProdutosConferenciaVisaocoluna.asString := qryProdutosCompostoscoluna.asString;

                    qryProdutosConferenciaVisaoquantidade.AsCurrency := qrytabelaprodutos.fieldbyname(NomeCampoQuantidade).AsCurrency * qryProdutosCompostosquantidade.AsCurrency;
                    qryProdutosConferenciaVisao.post;
                  end
                  else
                  begin
                    qryProdutosConferenciaVisao.edit;
                    qryProdutosConferenciaVisaoquantidade.AsCurrency := qryProdutosConferenciaVisaoquantidade.AsCurrency +
                                                                        qrytabelaprodutos.fieldbyname(NomeCampoQuantidade).AsCurrency * qryProdutosCompostosquantidade.AsCurrency;
                    qryProdutosConferenciaVisao.post;
                  end;

                  qryProdutosCompostos.next;
                end;
              end
              else
              if not qryProdutosConferenciaVisao.Locate('produto;compostovisual',
                                                        VarArrayOf([qrytabelaprodutos.fieldbyname(NomeCampoCodigo).asString, '']), []) then
              begin
                AbrirTabelaEstoque(tipo, qrytabelaprodutos.fieldbyname(NomeCampoCodigo).asstring, CodigoDocumento);
                qryProdutosConferenciaVisao.Append;
                qryProdutosConferenciaVisaotipo.AsString := Tipo;
                qryProdutosConferenciaVisaocodigo.AsString := CodigoDocumento;
                qryProdutosConferenciaVisaoproduto.AsString := qrytabelaprodutos.fieldbyname(NomeCampoCodigo).asstring;
                qryProdutosConferenciaVisaocomposto.clear;
                qryProdutosConferenciaVisaocompostovisual.asString := '';
                qryProdutosConferenciaVisaocodigovisual.AsString := qrytabelaprodutos.fieldbyname(NomeCampoCodigoVisual).asstring;
                qryProdutosConferenciaVisaodescricao.AsString := qrytabelaprodutos.fieldbyname(NomeCampoDescricao).asstring;
                qryProdutosConferenciaVisaolocalizacao.AsString := qryEstoqueslocalizacao.asString;

                qryProdutosConferenciaVisaovalorgrade1.asString := qrytabelaprodutos.fieldbyname(valorgrade1).asString;
                qryProdutosConferenciaVisaovalorgrade2.asString := qrytabelaprodutos.fieldbyname(valorgrade2).asString;
                qryProdutosConferenciaVisaolinha.asString := qrytabelaprodutos.fieldbyname(linha).asString;
                qryProdutosConferenciaVisaocoluna.asString := qrytabelaprodutos.fieldbyname(coluna).asString;

                qryProdutosConferenciaVisaoquantidade.AsCurrency := qrytabelaprodutos.fieldbyname(NomeCampoQuantidade).AsCurrency;
                qryProdutosConferenciaVisao.post;
              end
              else
              begin
                qryProdutosConferenciaVisao.edit;
                qryProdutosConferenciaVisaoquantidade.AsCurrency := qryProdutosConferenciaVisaoquantidade.AsCurrency + qrytabelaprodutos.fieldbyname(NomeCampoQuantidade).AsCurrency;
                qryProdutosConferenciaVisao.post;
              end;

            end;

            qryTabelaProdutos.next;

          end;
        end
        else
        if tipo = 'TRF' then
        begin
          dbgProdutos.denysort := True;
          {qryTabelaProdutos.SortByField('codigovisual,data');}
          qryTabelaProdutos.first;

          while not qryTabelaProdutos.eof do
          begin

            if qryTabelaProdutos.FieldByName('lotetransferencia').asString = CodigoDocumento then
            begin

              if not qryProdutosConferencia.Locate('produto;numero',
                  VarArrayOf([qrytabelaprodutos.fieldbyname('produto').asstring,
                              qrytabelaprodutos.fieldbyname(NomeCampoNumero).asstring]),[]) then
              begin
                qryProdutosConferencia.Append;
                qryProdutosConferenciatipo.AsString := Tipo;
                qryProdutosConferenciacodigo.AsString := CodigoDocumento;
                qryProdutosConferenciaproduto.AsString := qrytabelaprodutos.fieldbyname(NomeCampoCodigo).asstring;

                qryProdutosConferenciacodigovisual.AsString := qrytabelaprodutos.fieldbyname(NomeCampoCodigoVisual).asstring;
                qryProdutosConferenciadescricao.AsString := qrytabelaprodutos.fieldbyname(NomeCampoDescricao).asstring;
                qryProdutosConferenciaquantidade.AsCurrency := qrytabelaprodutos.fieldbyname('qtdepedida').AsCurrency;

                qryProdutosConferencianumero.AsInteger := qrytabelaprodutos.fieldbyname(NomeCampoNumero).asInteger;

                qryProdutosConferencia.post;
              end;
              {
              else
              begin
                qryProdutosConferencia.edit;
                qryProdutosConferenciaquantidade.AsCurrency := qryProdutosConferenciaquantidade.AsCurrency + qrytabelaprodutos.fieldbyname('qtdepedida').AsCurrency;
                qryProdutosConferencia.post;
              end;
              }

              vCamposCaracteristica := dmbasico.ValorCampodaTabela('caracteristicas',
                         ['p.codigo'],
                         [qrytabelaprodutos.fieldbyname('produto').asstring],
                         ['composto','conferircomposto'],
                          ' and codigo = (select p.caracteristica from produtos p where %s = %s ) ');

              if (vCamposCaracteristica[0] = True) and
                 (vCamposCaracteristica[1] = True) then
              begin
                qryProdutosCompostos.ParamByName('composto').asString := qrytabelaprodutos.fieldbyname(NomeCampoNumero).asstring;
                qryProdutosCompostos.close;
                qryProdutosCompostos.open;
                qryProdutosCompostos.first;
                while not qryProdutosCompostos.eof do
                begin
                  if not qryProdutosConferenciaCompostos.Locate('composto;numero;componente',
                                                VarArrayOf([qryProdutosCompostoscomposto.asString,
                                                            qrytabelaprodutos.fieldbyname(NomeCampoNumero).asinteger,
                                                            qryProdutosCompostoscomponente.asstring]), [] ) then
                  begin
                    qryProdutosConferenciaCompostos.Append;
                    qryProdutosConferenciaCompostostipo.AsString := Tipo;
                    qryProdutosConferenciaCompostoscodigo.AsString := CodigoDocumento;

                    qryProdutosConferenciaCompostoscomponente.AsString := qryProdutosCompostoscomponente.asstring;
                    qryProdutosConferenciaCompostoscomposto.AsString := qryProdutosCompostoscomposto.AsString;
                    qryProdutosConferenciaCompostosnumero.AsInteger := qrytabelaprodutos.fieldbyname(NomeCampoNumero).asinteger;

                    qryProdutosConferenciaCompostosquantidade.AsCurrency := (qrytabelaprodutos.fieldbyname('qtdepedida').AsCurrency * qryProdutosCompostosquantidade.AsCurrency);
                    qryProdutosConferenciaCompostosquantidadecomponente.ascurrency := qryProdutosCompostosquantidade.asCurrency;
                    qryProdutosConferenciaCompostos.post;
                  end

                  else
                  begin
                    qryProdutosConferenciaCompostos.edit;
                    qryProdutosConferenciaCompostosquantidade.AsCurrency := qryProdutosConferenciaCompostosquantidade.AsCurrency + (qrytabelaprodutos.fieldbyname('qtdepedida').AsCurrency * qryProdutosCompostosquantidade.AsCurrency);
                    qryProdutosConferenciaCompostos.post;
                  end;

                  if not qryProdutosConferenciaVisao.Locate('produto;numero;composto',
                                                VarArrayOf([qryProdutosCompostoscomponente.asstring,
                                                            qryProdutosConferenciaCompostosnumero.AsInteger,
                                                            qryProdutosCompostoscomposto.asString]), []) then
                  begin

                    AbrirTabelaEstoque(tipo, qryProdutosCompostoscomponente.asstring, CodigoDocumento);

                    qryProdutosConferenciaVisao.Append;
                    qryProdutosConferenciaVisaotipo.AsString := Tipo;
                    qryProdutosConferenciaVisaocodigo.AsString := CodigoDocumento;
                    qryProdutosConferenciaVisaoproduto.AsString := qryProdutosCompostoscomponente.asstring;

                    qryProdutosConferenciaVisaonumero.AsInteger := qryProdutosConferenciaCompostosnumero.AsInteger;

                    qryProdutosConferenciaVisaocodigovisual.AsString := qryProdutosCompostoscomponentevisual.asstring;
                    qryProdutosConferenciaVisaocomposto.asString :=  qryProdutosCompostoscomposto.AsString;
                    qryProdutosConferenciaVisaocompostovisual.asString := qryProdutosCompostoscompostovisual.AsString;
                    qryProdutosConferenciaVisaodescricao.AsString := qryProdutosCompostosdescricao.AsString;
                    qryProdutosConferenciaVisaolocalizacao.AsString := qryEstoqueslocalizacao.asString;

                    qryProdutosConferenciaVisaovalorgrade1.asString := qryProdutosCompostosvalorgrade1.asString;
                    qryProdutosConferenciaVisaovalorgrade2.asString := qryProdutosCompostosvalorgrade2.asString;
                    qryProdutosConferenciaVisaolinha.asString := qryProdutosCompostoslinha.asString;
                    qryProdutosConferenciaVisaocoluna.asString := qryProdutosCompostoscoluna.asString;

                    qryProdutosConferenciaVisaoquantidade.AsCurrency := qrytabelaprodutos.fieldbyname('qtdepedida').AsCurrency * qryProdutosCompostosquantidade.AsCurrency;
                    qryProdutosConferenciaVisao.post;
                  end
                  else
                  begin
                    qryProdutosConferenciaVisao.edit;
                    qryProdutosConferenciaVisaoquantidade.AsCurrency := qryProdutosConferenciaVisaoquantidade.AsCurrency +
                                                                        qrytabelaprodutos.fieldbyname('qtdepedida').AsCurrency * qryProdutosCompostosquantidade.AsCurrency;
                    qryProdutosConferenciaVisao.post;
                  end;

                  qryProdutosCompostos.next;
                end;
              end
              else        {aqui alteração}
              if not qryProdutosConferenciaVisao.Locate('produto;numero;compostovisual',
                                                         VarArrayOf([qrytabelaprodutos.fieldbyname(NomeCampoCodigo).asstring,
                                                                     qrytabelaprodutos.fieldbyname(NomeCampoNumero).asInteger,
                                                                     '']), []) then
              begin

                AbrirTabelaEstoque(tipo, qrytabelaprodutos.fieldbyname(NomeCampoCodigo).asstring, CodigoDocumento);

                qryProdutosConferenciaVisao.Append;
                qryProdutosConferenciaVisaotipo.AsString := Tipo;
                qryProdutosConferenciaVisaocodigo.AsString := CodigoDocumento;
                qryProdutosConferenciaVisaoproduto.AsString := qrytabelaprodutos.fieldbyname(NomeCampoCodigo).asstring;

                qryProdutosConferenciaVisaonumero.AsInteger := qrytabelaprodutos.fieldbyname(NomeCampoNumero).asInteger;

                qryProdutosConferenciaVisaocomposto.clear;
                qryProdutosConferenciaVisaocompostovisual.asString := '';
                qryProdutosConferenciaVisaocodigovisual.AsString := qrytabelaprodutos.fieldbyname(NomeCampoCodigoVisual).asstring;
                qryProdutosConferenciaVisaodescricao.AsString := qrytabelaprodutos.fieldbyname(NomeCampoDescricao).asstring;
                qryProdutosConferenciaVisaolocalizacao.AsString := qryEstoqueslocalizacao.asString;

                qryProdutosConferenciaVisaovalorgrade1.asString := qrytabelaprodutos.fieldbyname(valorgrade1).asString;
                qryProdutosConferenciaVisaovalorgrade2.asString := qrytabelaprodutos.fieldbyname(valorgrade2).asString;
                qryProdutosConferenciaVisaolinha.asString := qrytabelaprodutos.fieldbyname(linha).asString;
                qryProdutosConferenciaVisaocoluna.asString := qrytabelaprodutos.fieldbyname(coluna).asString;

                qryProdutosConferenciaVisaoquantidade.AsCurrency := qrytabelaprodutos.fieldbyname(NomeCampoQuantidade).AsCurrency;
                qryProdutosConferenciaVisao.post;
              end
              else
              begin
                qryProdutosConferenciaVisao.edit;
                qryProdutosConferenciaVisaoquantidade.AsCurrency := qryProdutosConferenciaVisaoquantidade.AsCurrency + qrytabelaprodutos.fieldbyname(NomeCampoQuantidade).AsCurrency;
                qryProdutosConferenciaVisao.post;
              end;

            end;

            qryTabelaProdutos.next;
          end;
          qryProdutosConferenciaVisao.sortbyfield('codigovisual,numero');
        end;
      end;

      if RefazerProdutos then
      begin
        qryProdutosConferenciavisao.first;
        while not qryProdutosConferenciaVisao.eof do
        begin
          if RecomecarFE then
          begin
            if (qryProdutosConferenciaVisaoQuantidadeExcedente.AsFloat<>0) or
               (qryProdutosConferenciaVisaoQuantidadeFaltante.AsFloat<>0) then
            begin
              qryProdutosConferenciaVisao.Edit;
              qryProdutosConferenciaVisaolido.Clear;
              qryProdutosConferenciaVisao.post;
            end;
          end
          else
          begin
            qryProdutosConferenciaVisao.Edit;
            qryProdutosConferenciaVisaolido.Clear;
            qryProdutosConferenciaVisao.post;
          end;
          qryProdutosConferenciaVisao.next
        end;
      end;

      if qryProdutosConferenciaVisao.BookmarkValid(vRegistroAtualVisao) then
      begin
        qryProdutosConferenciaVisao.GotoBookmark(vRegistroAtualVisao);
        qryProdutosConferenciaVisao.FreeBookmark(vRegistroAtualVisao);
      end;

      qryProdutosConferenciaVisao.EnableControls;
      qryTabelaProdutos.GotoBookmark(vRegistroAtual);
      qryTabelaProdutos.FreeBookmark(vRegistroAtual);

      if not RefazerProdutos then
        sbnSalvar.Enabled := false;
                                    {
      if TSqlBuffer(qryProdutosConferenciaVisao).SortFieldCount = 0 then
        qryProdutosConferenciaVisao.SortByField('codigovisual, compostovisual');
        }


     //qryProdutosConferencia.OnCalcFields := qryProdutosConferenciaCalcFields;

      qryProdutosConferenciaVisao.AfterScroll := qryProdutosConferenciaVisaoAfterScroll;

      VisualizarImageURL;

      if not RefazerProdutos then

        ShowModal;
    end;
  finally
    fraVisualizarImageURL1.visible := fraVisualizarImageURL1_visible;
  end;
end;


procedure ConferirProdutos(qryTabelaProdutos: TtecQuery;
                           NomeCampoCodigo, NomeCampoCodigoVisual,
                           NomeCampoDescricao, NomeCampoQuantidade,
                           tipo, Codigo, valorgrade1, valorgrade2,
                           linha, coluna: String; Largura: integer = 0 ; Altura: integer = 0;
                           Aowner : Tcomponent = nil;
                           NomeCampoNumero: String = 'numero');
begin

  if not assigned(frmConferenciaProdutos) then
  begin
    if Aowner <> nil then
    begin
      frmConferenciaProdutos := TfrmConferenciaProdutos.Create(frmConferenciaProdutos);
      frmConferenciaProdutos.Position := poOwnerFormCenter;
//      frmConferenciaProdutos.WindowState := wsNormal;
//      frmConferenciaProdutos.Position := poScreenCenter;
      frmConferenciaProdutos.Left := tform(AOwner).left;
      frmConferenciaProdutos.top := tform(AOwner).top;

    end
    else
    begin
      frmConferenciaProdutos := TfrmConferenciaProdutos.Create(frmConferenciaProdutos);
      frmConferenciaProdutos.Position := poMainFormCenter;
    end;
  end;

  if (Largura <> 0) and (Altura <> 0) then
  begin
    with frmConferenciaProdutos do
    begin
      fraVisualizarImageURL1.visible := false;

      width := Largura;
      Height := Altura;
      BorderIcons := [];

      EscParaVoltar := true;
      pnlTopo.Height := sbnSalvar.Height + gbxCodigoBarras.Height;
      sbnSalvar.caption := '';
      sbnSalvar.width := 33;
      sbnSalvar.top := 0;
      sbnSalvar.Left := 1 ;

      sbnRecomecarFaltantes.Caption := 'Faltantes';

      sbnRecomecarFaltantes.width := 79;
      sbnRecomecarFaltantes.top := 0;
      sbnRecomecarFaltantes.Left :=  37;

      sbnReConferir.Caption := 'Todos';
      sbnReConferir.Width := 65;
      sbnReConferir.top := 0;
      sbnReConferir.Left := 117;

//      sbnDetalhes.Visible := true;
//      sbnDetalhes.top := 0;
//      sbnDetalhes.Left := 185;

      pnlDetalhes.Visible := true; 

      gbxCodigoBarras.left := 0;
      gbxCodigoBarras.top := sbnSalvar.Height;

      fraVisualizarImageURL1.visible := false;

      dbgProdutos.Width := Largura;
      dbgProdutos.Font.size := 6;
      dbgProdutos.ExibirNumerodaLinha := false;
      dbgProdutos.ColumnByName('descricao').width := 130;
      dbgProdutos.ColumnByName('quantidade').Index := 2;
      dbgProdutos.ColumnByName('lido').Index := 2;
      dbgProdutos.ColumnByName('digitado').Index := 4;
      dbgProdutos.ColumnByName('QuantidadeFaltante').Index := 5;
      dbgProdutos.ColumnByName('QuantidadeExcedente').Index := 6;

//      Left := tform(AOwner).left;
//      top := tform(AOwner).top;


    end;
  end
  else
    frmConferenciaProdutos.fraVisualizarImageURL1.visible := true;

  frmConferenciaProdutos.qryTabelaProdutos      := qryTabelaProdutos;
  frmConferenciaProdutos.NomeCampoCodigo        := NomeCampoCodigo;
  frmConferenciaProdutos.NomeCampoCodigoVisual  := NomeCampoCodigoVisual;
  frmConferenciaProdutos.NomeCampoDescricao     := NomeCampoDescricao;
  frmConferenciaProdutos.NomeCampoQuantidade    := NomeCampoQuantidade;
  frmConferenciaProdutos.valorgrade1            := valorgrade1;
  frmConferenciaProdutos.valorgrade2            := valorgrade2;
  frmConferenciaProdutos.linha                  := linha;
  frmConferenciaProdutos.coluna                 := coluna;

  frmConferenciaProdutos.NomeCampoNumero        := NomeCampoNumero;

  frmConferenciaProdutos.Tipo   := Tipo;
  frmConferenciaProdutos.CodigoDocumento := Codigo;

  frmConferenciaProdutos.ConferirProdutos;

end;

procedure TfrmConferenciaProdutos.FormShow(Sender: TObject);
begin
  inherited;
  edtCodigoBarras.SetFocus;
  edtCodigoBarras.SelectAll;

//HC_KEYBOARD_Handle := SetWindowsHookEx(WH_KEYBOARD, @KeyboardProc, 0, GetCurrentThreadId);

// SetWindowsHookEx(WH_KEYBOARD, @LowLevelKeyboardProc, 0, GetCurrentThreadId);

  Left := Screen.WorkAreaWidth - Width;
  Top := Screen.WorkAreaHeight - Height;

end;

procedure TfrmConferenciaProdutos.sbnReConferirClick(Sender: TObject);
begin
  inherited;

  fraVisualizarImageURL1_visible := fraVisualizarImageURL1.visible;
  fraVisualizarImageURL1.visible := false;
  ConferirProdutos(true, false);
  fraVisualizarImageURL1.visible := fraVisualizarImageURL1_visible;
end;

procedure TfrmConferenciaProdutos.dbgProdutosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);

var
  imgVisualFormURL : timage;
  URLThumb, URLNomeFoto : String;
  x,y : integer;

begin
  inherited;
  (*
  if column.index = 7 then
  begin

    dmbasico.RefazConsultaPorNome(qryProcuraProdutos,['codigo','codigovisual'], [qryProdutosConferenciaproduto.asstring,'']);

    if (qryProcuraProdutosnomefoto.asString <> '') or (qryProcuraProdutosnomethumb.asString <> '') then
    begin

      URLThumb := 'http://' + parsistema.SiteEmpresa+'/fotos/'+qryProcuraProdutosnomethumb.asString;
      URLNomeFoto := 'http://'+ parsistema.SiteEmpresa+'/fotos/'+qryProcuraProdutosnomefoto.asString;

      try
        imgVisualFormURL := Timage.create(self);
        imgVisualFormURL.Proportional := true;
        imgVisualFormURL.Stretch := true;
//        DownloadImagem(URLNomeFoto, imgVisualFormURL, true);
        DownloadImagem(URLThumb, imgVisualFormURL, true);

        with TDBGrid(Sender) do
        begin
        {
          x := (Rect.Right - Rect.Left - imgVisualFormURL.Picture.Bitmap.Width) div 2 + Rect.Left;
          y := (Rect.Bottom - Rect.Top - imgVisualFormURL.Picture.Bitmap.Height) div 2 + Rect.Top;
          Canvas.Draw(x div 2 + Rect.Left,
          y, imgVisualFormURL.Picture.Bitmap);
         }
           Canvas.Draw(Rect.Left, Rect.Top, imgVisualFormURL.Picture.Bitmap);
        end;
      except
      end;

    end;
  end
  else

  begin
  *)

    if (qryProdutosConferenciaVisaoQuantidadeFaltante.AsCurrency = 0) and
       (qryProdutosConferenciaVisaoQuantidadeExcedente.ascurrency = 0) and
       (qryProdutosConferenciaVisaolido.ascurrency <> 0) then
    begin
      TDBGrid(Sender).Canvas.Font.Color := clGreen;
      TDBGrid(Sender).Canvas.Font.Style := [fsBold];
    end
    else
    if ((qryProdutosConferenciaVisaoQuantidadeFaltante.AsCurrency <> 0) or
        (qryProdutosConferenciaVisaoQuantidadeExcedente.ascurrency <> 0)) and
       (qryProdutosConferenciaVisaolido.ascurrency <> 0) then
    begin
      TDBGrid(Sender).Canvas.Font.Color := clRed;
      TDBGrid(Sender).Canvas.Font.Style := [fsBold];
    end;
  //   TDBGrid(Sender).Canvas.Font.Style := [];

    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
//  end;

end;

procedure TfrmConferenciaProdutos.sbnSalvarClick(Sender: TObject);
var
{
  produto: String;
  lotetransferencia : Integer;
  }

  vFiltered, vExcluirItensNaoLidos : Boolean;
  vQuantidadeLidaComponente, vQuantidadeLidaComponenteaux : Real;
  vRetornoMensagem : TMessageButton;

  function ExisteItensNaoLidos: Boolean;
  begin
    result := false;
    qryProdutosConferenciaVisao.first;
    while not qryProdutosConferenciaVisao.eof do
    begin
      if qryProdutosConferenciaVisaolido.AsCurrency = 0 then
      begin
        result := true;
        break;
      end
      else
      qryProdutosConferenciaVisao.next;
    end;
  end;

begin
  inherited;
  if Tipo <> 'TRF' then
    qryProdutosConferenciaVisao.SortClear;

  qryProdutosConferenciaVisao.AfterScroll := nil;

  qryConferencia.Edit;
  qryConferenciausuario.AsInteger := dmbasico.CodigoUsuario;
  qryConferenciadata.AsDateTime := now;
  qryConferencia.post;

  if Tipo = 'TRF' then
  begin
    vFiltered := qryTabelaProdutos.filtered;
    qryTabelaProdutos.filtered := false;

    qryTabelaProdutos.First;
    while not qrytabelaprodutos.Eof do
    begin

      if qryProdutosConferencia.Locate('codigo;produto;numero',
           VarArrayOf([qryTabelaProdutos.fieldbyname('lotetransferencia').AsString,
                       qryTabelaProdutos.fieldbyname('produto').AsString,
                       qryTabelaProdutos.fieldbyname(NomeCampoNumero).AsString]), []) then
      begin

        if qryProdutosConferenciaCompostos.RecordCount <> 0 then
        begin
          vQuantidadeLidaComponente := 0;
          qryProdutosConferenciaCompostos.first;
          while not qryProdutosConferenciaCompostos.eof do
          begin
            qryProdutosConferenciaVisao.first;
            if qryProdutosConferenciaVisao.Locate('codigo;produto;numero;composto',
                                    VarArrayOf([qryTabelaProdutos.fieldbyname('lotetransferencia').AsString,
                                                qryProdutosConferenciaCompostoscomponente.asString,
                                                qryProdutosConferenciaCompostosnumero.AsInteger,
                                                qryProdutosConferenciaCompostoscomposto.AsString]), []) then
            begin
              qryProdutosConferenciaCompostos.edit;
              qryProdutosConferenciaCompostoslido.value := qryProdutosConferenciaVisaolido.value;
              qryProdutosConferenciaCompostos.post;


              vQuantidadeLidaComponenteaux := 0;
              if qryProdutosConferenciaCompostosquantidadecomponente.value <> 0 then
                vQuantidadeLidaComponenteaux :=  (qryProdutosConferenciaCompostoslido.asinteger div qryProdutosConferenciaCompostosquantidadecomponente.asinteger);

              if (vQuantidadeLidaComponente > vQuantidadeLidaComponenteaux) or
                 (vQuantidadeLidaComponente = 0) then
                vQuantidadeLidaComponente := vQuantidadeLidaComponenteaux;

            end
            else
              mensagemerro('Erro inesperado. Inconsistencia entre  ProdutosConferenciaVisao x ProdutosConferenciaCompostos');


            qryProdutosConferenciaCompostos.next;
          end;

          if qryProdutosConferencialido.value <> vQuantidadeLidaComponente then
          begin
            qryProdutosConferencia.edit;
            qryProdutosConferencialido.value := vQuantidadeLidaComponente;
            qryProdutosConferencia.post;
          end;

          if (qrytabelaprodutos.FieldByName('qtderecebida').AsFloat <> vQuantidadeLidaComponente) then
          begin
                      {
            produto := qryTabelaProdutos.fieldbyname('produto').AsString;
            lotetransferencia := qryTabelaProdutos.fieldbyname('lotetransferencia').Asinteger;
            }

            qryTabelaProdutos.Edit;
            if vQuantidadeLidaComponente = 0 then
            begin
               qrytabelaprodutos.FieldByName('qtderecebida').clear;
               {Atenção: a atribuição abaixo retira o produto da lista de tabelaprodutos caso esteja filterd, por isso o filtro é desabilitado acima}
               {ryTabelaProdutos.fieldbyname('lotetransferencia').clear;}
            end
            else
              qrytabelaprodutos.FieldByName('qtderecebida').AsFloat :=  vQuantidadeLidaComponente;

            qryTabelaProdutos.post;

          end;

        end
        else
        begin
          qryProdutosConferenciaVisao.first;

          if qryProdutosConferenciaVisao.Locate('codigo;produto;numero;compostovisual',
                                  VarArrayOf([qryTabelaProdutos.fieldbyname('lotetransferencia').AsString,
                                              qryTabelaProdutos.fieldbyname('produto').AsString,
                                              qryTabelaProdutos.fieldbyname(NomeCampoNumero).AsString, '']), []) then
          begin

            if (qrytabelaprodutos.FieldByName('qtderecebida').AsFloat <> qryProdutosConferenciaVisaolido.AsFloat) then
            begin

            {
              produto := qryTabelaProdutos.fieldbyname('produto').AsString;
              lotetransferencia := qryTabelaProdutos.fieldbyname('lotetransferencia').Asinteger;
              }

              qryTabelaProdutos.Edit;
              if qryProdutosConferenciaVisaolido.AsFloat = 0 then
              begin
                 qrytabelaprodutos.FieldByName('qtderecebida').clear;
                 {Atenção: a atribuição abaixo retira o produto da lista de tabelaprodutos caso esteja filterd, por isso o filtro é desabilitado acima}
                 {ryTabelaProdutos.fieldbyname('lotetransferencia').clear;}
              end
              else
                qrytabelaprodutos.FieldByName('qtderecebida').AsFloat :=  qryProdutosConferenciaVisaolido.AsFloat;


              qryTabelaProdutos.post;

            end;

            qryProdutosConferencia.edit;
            qryProdutosConferencialido.value := qryProdutosConferenciaVisaolido.value;
            qryProdutosConferencia.post;

          end
          else
            mensagemerro('Erro inesperado. Inconsistencia entre ProdutosConferenciaCompostos x TabelaProdutos');
        end;

      end;
      qryTabelaProdutos.next;

    end;
    dmbasico.Perpetrar([qryTabelaProdutos, qryConferencia, qryProdutosConferencia, qryProdutosConferenciaCompostos]{, SomenteGravacao});

    qryTabelaProdutos.filtered := vFiltered;
  end
  else
  if  Tipo = 'LPA' then
  begin
    vExcluirItensNaoLidos := false;

    if ExisteItensNaoLidos then
    begin
      vRetornoMensagem := MensagemSelecionaOpcao('Excluir os ítens não lidos desta lista?');
      if vRetornoMensagem = smbYes then
        vExcluirItensNaoLidos := True
      else
      if vRetornoMensagem = smbCancel then
        exit;
    end;
    
    qryProdutosConferenciaVisao.first;
    while not qryProdutosConferenciaVisao.eof do
    begin
      qrytabelaprodutos.first;


      if not qrytabelaprodutos.Locate('produto', qryProdutosConferenciaVisaoProduto.asString, []) then
      begin
        if not (vExcluirItensNaoLidos and  (qryProdutosConferenciaVisaolido.AsCurrency = 0)) then
        begin
          qryTabelaProdutos.append;
          qryTabelaProdutos.FieldByName('listapadrao').asString := qryProdutosConferenciaVisao.FieldByName('codigo').asString;
          qryTabelaProdutos.FieldByName('produto').asString := qryProdutosConferenciaVisao.FieldByName('produto').asString;
          qryTabelaProdutos.post;
        end
      end
      else
      if vExcluirItensNaoLidos and  (qryProdutosConferenciaVisaolido.AsCurrency = 0) then
        qryTabelaProdutos.delete;

      if not qryProdutosConferencia.Locate('produto',qryProdutosConferenciaVisaoProduto.asString, []) then
      begin
        if not (vExcluirItensNaoLidos and  (qryProdutosConferenciaVisaolido.AsCurrency = 0)) then
        begin
          qryProdutosConferencia.Append;
          qryProdutosConferenciatipo.AsString := Tipo;
          qryProdutosConferenciacodigo.AsString := CodigoDocumento;
          qryProdutosConferenciaproduto.AsString := qryProdutosConferenciaVisaoProduto.asString;
          qryProdutosConferenciacodigovisual.AsString := qryProdutosConferenciaVisaocodigovisual.asString;
          qryProdutosConferenciadescricao.AsString := qryProdutosConferenciaVisaodescricao.asstring;
          qryProdutosConferencialido.AsCurrency := qryProdutosConferenciaVisaolido.AsCurrency;
          qryProdutosConferencia.post;
        end;
      end
      else
      if vExcluirItensNaoLidos and  (qryProdutosConferenciaVisaolido.AsCurrency = 0) then
        qryProdutosConferencia.delete
      else
      begin
        qryProdutosConferencia.edit;
        qryProdutosConferencialido.AsCurrency := qryProdutosConferenciaVisaolido.AsCurrency;
        qryProdutosConferencia.post;
      end;

      {
      else
        mensagemerro('Erro inesperado. Inconsistencia entre tabelaprodutos x ProdutosConferenciaVisao');
        }

      if vExcluirItensNaoLidos and  (qryProdutosConferenciaVisaolido.AsCurrency = 0) then
        qryProdutosConferenciaVisao.delete
      else
        qryProdutosConferenciaVisao.next;

    end;
    dmbasico.Perpetrar([qryTabelaProdutos, qryConferencia, qryProdutosConferencia, qryProdutosConferenciaCompostos]);

  end
  else
  begin

    qryProdutosConferencia.First;
    while not qryProdutosConferencia.Eof do
    begin

      if qryProdutosConferenciaCompostos.RecordCount <> 0 then
      begin
        vQuantidadeLidaComponente := 0;
        qryProdutosConferenciaCompostos.first;
        while not qryProdutosConferenciaCompostos.eof do
        begin
          qryProdutosConferenciaVisao.first;

          if qryProdutosConferenciaVisao.Locate('codigo;produto;composto',
                                  VarArrayOf([qryProdutosConferenciacodigo.asstring,
                                              qryProdutosConferenciaCompostoscomponente.asString,
                                              qryProdutosConferenciaCompostoscomposto.AsString]), []) then
          begin
            qryProdutosConferenciaCompostos.edit;
            qryProdutosConferenciaCompostoslido.value := qryProdutosConferenciaVisaolido.value;
            qryProdutosConferenciaCompostos.post;


            vQuantidadeLidaComponenteaux := 0;
            if qryProdutosConferenciaCompostosquantidadecomponente.value <> 0 then
              vQuantidadeLidaComponenteaux :=  (qryProdutosConferenciaCompostoslido.asinteger div qryProdutosConferenciaCompostosquantidadecomponente.asinteger);

            if (vQuantidadeLidaComponente > vQuantidadeLidaComponenteaux) or
               (vQuantidadeLidaComponente = 0) then
              vQuantidadeLidaComponente := vQuantidadeLidaComponenteaux;

          end
          else
            mensagemerro('Erro inesperado. Inconsistencia entre ProdutosConferenciaVisao x ProdutosConferencia');


          qryProdutosConferenciaCompostos.next;
        end;

        if qryProdutosConferencialido.value <> vQuantidadeLidaComponente then
        begin
          qryProdutosConferencia.edit;
          qryProdutosConferencialido.value := vQuantidadeLidaComponente;
          qryProdutosConferencia.post;
        end;

      end
      else
      begin

        qryProdutosConferenciaVisao.first;
        {
        while not qryProdutosConferenciaVisao.eof do
        begin
          if (qryProdutosConferenciaVisaoproduto.asstring = qryProdutosConferenciaproduto.AsString) and
             (qryProdutosConferenciaVisaocomposto.asstring = '') then

            break
          else
            qryProdutosConferenciaVisao.next;
        end;
        }

        if qryProdutosConferenciaVisao.Locate('codigo;produto;compostovisual',
                              VarArrayOf([qryProdutosConferenciacodigo.asstring,
                                          qryProdutosConferenciaproduto.AsString,
                                          '']), []) then
        begin

          qryProdutosConferencia.edit;
          qryProdutosConferencialido.value := qryProdutosConferenciaVisaolido.value;
          qryProdutosConferencia.post;

        end
        else
          mensagemerro('Erro inesperado. Inconsistencia entre ProdutosConferenciaVisao x ProdutosConferencia');

      end;

      qryProdutosConferencia.next;

    end;
    dmbasico.Perpetrar([qryConferencia, qryProdutosConferencia, qryProdutosConferenciaCompostos]{, SomenteGravacao});
  end;

  qryProdutosConferenciaVisao.AfterScroll := qryProdutosConferenciaVisaoAfterScroll;

  sbnSalvar.Enabled := false;

  if EscParaVoltar then
    close;

end;

procedure TfrmConferenciaProdutos.sbnRecomecarFaltantesClick(Sender: TObject);
begin
  inherited;
  fraVisualizarImageURL1_visible := fraVisualizarImageURL1.visible;
  fraVisualizarImageURL1.visible := false;
  ConferirProdutos(true, true);
  fraVisualizarImageURL1.visible := fraVisualizarImageURL1_visible; 
end;

procedure TfrmConferenciaProdutos.dbgProdutosKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if key = vk_return then
    if pnlDetalhes.visible then
    begin
      edtQtdeLida.setfocus;
      edtQtdeLida.selectall;
    end;
  {
  if key = vk_return then
  begin
    if dbgprodutos.SelectedField = qryProdutosConferencialido then
    begin
      if not (qryProdutosConferencia.state in [dsedit, dsinsert]) then
        qryProdutosConferencia.edit;

      if qryProdutosConferencialido.AsCurrency <> 0 then
        qryProdutosConferenciadigitado.AsBoolean := true
      else
        qryProdutosConferenciadigitado.AsBoolean := false;

      qryProdutosConferencia.post;
    end;
  end;
  }
end;

procedure TfrmConferenciaProdutos.qryProdutosConferenciaNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosConferenciadigitado.AsBoolean := false;
  qryProdutosConferencianumero.asinteger := 1;
end;

procedure TfrmConferenciaProdutos.MensagemQuantidadeExcedente;
begin
  if qryProdutosconferenciaVisaoquantidade.AsCurrency < qryProdutosconferenciaVisaolido.AsCurrency then
    MensagemAviso('A quantidade lida ultrapassou a quantidade do documento.',true)
end;

procedure TfrmConferenciaProdutos.FormCanResize(Sender: TObject;
  var NewWidth, NewHeight: Integer; var Resize: Boolean);
begin
  inherited;
  if not InitialResize then
    Resize := true
  else
    Resize := false;  
end;

procedure TfrmConferenciaProdutos.FormResize(Sender: TObject);
begin
  inherited;
  InitialResize := true;

end;

function TfrmConferenciaProdutos.Produto: String;
begin
  result := qryProdutosConferenciaVisaoproduto.asString;
end;

function TfrmConferenciaProdutos.produtoprocuracodigobarras: String;
begin
  result := qryProcuraProdutosCodigoBarrascodigo.asString;
end;

function TfrmConferenciaProdutos.produtoprocuraproduto: String;
begin
  result := qryProcuraProdutoscodigo.asString;
end;

procedure TfrmConferenciaProdutos.qryProdutosConferenciaVisaoAfterDelete(
  DataSet: TDataSet);
begin
  inherited;
  sbnSalvar.Enabled := true;
end;

procedure TfrmConferenciaProdutos.qryProdutosConferenciaVisaoAfterPost(
  DataSet: TDataSet);
begin
  inherited;
  sbnSalvar.Enabled := true;
end;

procedure TfrmConferenciaProdutos.qryProdutosConferenciaVisaoAfterScroll(
  DataSet: TDataSet);
begin
  inherited;
  dbgProdutos.ColumnByName('valorgrade1').Title.Caption := qryProdutosConferenciaVisaolinha.AsString;
  dbgProdutos.ColumnByName('valorgrade2').Title.Caption := qryProdutosConferenciaVisaocoluna.AsString;

  VisualizarImageURL;


end;

procedure TfrmConferenciaProdutos.qryProdutosConferenciaVisaoCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if qryProdutosconferenciaVisaoquantidade.AsCurrency > qryProdutosconferenciaVisaolido.AsCurrency then
  begin
    qryProdutosconferenciaVisaoQuantidadeFaltante.AsCurrency := qryProdutosconferenciaVisaoquantidade.AsCurrency - qryProdutosconferenciaVisaolido.AsCurrency;
    qryProdutosconferenciaVisaoQuantidadeExcedente.AsCurrency := 0;
  end
  else
  if qryProdutosconferenciaVisaoquantidade.AsCurrency < qryProdutosconferenciaVisaolido.AsCurrency then
  begin
    qryProdutosconferenciaVisaoQuantidadeFaltante.AsCurrency := 0;
    qryProdutosconferenciaVisaoQuantidadeExcedente.AsCurrency := qryProdutosconferenciaVisaolido.AsCurrency - qryProdutosconferenciaVisaoquantidade.AsCurrency;
//    MensagemAviso('A quantidade lida ultrapassou a quantidade do documento.',true)
  end
  else
  begin
    qryProdutosconferenciaVisaoQuantidadeFaltante.AsCurrency := 0;
    qryProdutosconferenciaVisaoQuantidadeExcedente.AsCurrency := 0;
  end;

end;

procedure TfrmConferenciaProdutos.qryProdutosConferenciaVisaoNewRecord(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosConferenciaVisaodigitado.AsBoolean := false;
end;

procedure TfrmConferenciaProdutos.dsrProdutosConferenciaVisaoDataChange(
  Sender: TObject; Field: TField);
begin
  inherited;
  if field = qryProdutosConferenciaVisaolido then
  begin
    if not qryProdutosConferenciaVisaolido.isnull then
      qryProdutosConferenciaVisaodigitado.AsBoolean := true
    else
      qryProdutosConferenciaVisaodigitado.AsBoolean := false;

    MensagemQuantidadeExcedente;
  end;

end;

procedure TfrmConferenciaProdutos.AbrirTabelaEstoque(tipo, produto, codigodocumento: String);
begin
  dmbasico.RefazConsultaPorNome(qryEstoques,['tipo','produto','codigo'], [tipo, produto, codigodocumento]);
end;

procedure TfrmConferenciaProdutos.edtQtdeLidaKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if key = vk_return then
  begin
    if qryProdutosConferenciaVisao.State = dsedit then
      qryProdutosConferenciaVisao.post;
    edtCodigoBarras.setfocus;  

  end;
end;

procedure TfrmConferenciaProdutos.btnImprimirClick(Sender: TObject);
var
  PV: TfrxComponent;
begin
  inherited;
  qryIdentificacao.ParamByName('tipo').asString := tipo;
  qryIdentificacao.ParamByName('codigo').asString := CodigoDocumento;
  qryIdentificacao.close;
  qryIdentificacao.open;

  if FileExists(LogotipoFilialBase) then
  begin
    PV := frxImpressaoConferencia.FindObject('fpvLogo');
    if (PV is TfrxPictureView) then
      TfrxPictureView(PV).picture.LoadFromFile(LogotipoFilialBase);
  end;


  fraVisualizarImageURL1_visible := fraVisualizarImageURL1.visible;
  fraVisualizarImageURL1.visible := false;

//  frxImpressaoConferencia.DesignReport(true,false);
  frxImpressaoConferencia.ShowReport(true);

  fraVisualizarImageURL1.visible := fraVisualizarImageURL1_visible;


end;

procedure TfrmConferenciaProdutos.frxImpressaoConferenciaGetValue(
  const VarName: String; var Value: Variant);
begin
  inherited;
  if VarName = 'MascaraQuantidade' then
    Value := ParSistema.MascaraQuantidadeGrade
  else if VarName = 'CordoZebrado' then
    Value :=  strtoint(parsistema.CorZebradoRelatorio)
  else if VarName = 'RAZAOFILIALBASE' then
    Value := fRazaoFilialBase
  else if VarName = 'ENDERECO_BAIRRO' then
    Value :=  fRuaFilialBase+ ' - '+fBairroFilialBase
  else if VarName = 'CEP_CIDADE_UF' then
    Value :=  FormatarCEP(fCEPFilialBase)+'  '+fCidadeFilialBase+ '  '+ fEstadoFilialBase;

end;

