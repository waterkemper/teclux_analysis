procedure TfrmConferenciacoletor_x1_240x320.sbnConferirClick(
  Sender: TObject);
begin
  inherited;


  if pgcOperacao.ActivePage = tstContrato then
  begin

    qryProdutosContratos.ParamByName('contrato').asString := qryContratos.fieldbyname('numero').asString;
    qryProdutosContratos.close;
    qryProdutosContratos.open;

    ConferirProdutos(qryProdutosContratos,
     qryProdutosContratos.fieldbyname('produto').fieldname,
     qryProdutosContratos.fieldbyname('produto').FieldName,
     qryProdutosContratos.fieldbyname('descricaoproduto').FieldName,
     qryProdutosContratos.fieldbyname('quantidade').FieldName, 'CTR',

     ifthen(qryContratos.fieldbyname('primogenito').asstring<>'',
            qryContratos.fieldbyname('primogenito').asstring,
            qryContratos.fieldbyname('numero').asString),

     qryProdutosContratos.fieldbyname('valorgrade1').FieldName,
     qryProdutosContratos.fieldbyname('valorgrade2').FieldName,
     qryProdutosContratos.fieldbyname('linha').FieldName,
     qryProdutosContratos.fieldbyname('coluna').FieldName, 240, 320, self);

     dbgContrato.SetFocus;



  end
  else
  if pgcOperacao.ActivePage = tstNFSaida then
  begin

    qryProdutosDadosFiscais.ParamByName('dadofiscal').asString := qrydadosfiscais.fieldbyname('numero_1').asString;
    qryProdutosDadosFiscais.close;
    qryProdutosDadosFiscais.open;

    ConferirProdutos(qryProdutosDadosFiscais,
     qryProdutosDadosFiscais.fieldbyname('produto').fieldname,
     qryProdutosDadosFiscais.fieldbyname('codigovisual').FieldName,
     qryProdutosDadosFiscais.fieldbyname('descricaoproduto').FieldName,
     qryProdutosDadosFiscais.fieldbyname('quantidade').FieldName, 'NFS',
     qryProdutosDadosFiscais.fieldbyname('dadofiscal').asstring,
     qryProdutosDadosFiscais.fieldbyname('valorgrade1').FieldName,
     qryProdutosDadosFiscais.fieldbyname('valorgrade2').FieldName,
     qryProdutosDadosFiscais.fieldbyname('linha').FieldName,
     qryProdutosDadosFiscais.fieldbyname('coluna').FieldName, 240, 320, self);

     dbgNFSaida.setfocus;

  end
  else
  if pgcOperacao.ActivePage = tstNFEntrada then
  begin

    qryProdutosNotasPag.ParamByName('codigonota').asString := qryNotasPag.fieldbyname('codigo').asString;
    qryProdutosNotasPag.close;
    qryProdutosNotasPag.open;

    ConferirProdutos(qryProdutosNotasPag,
     qryProdutosNotasPag.fieldbyname('produto').fieldname,
     qryProdutosNotasPag.fieldbyname('codigovisual').FieldName,
     qryProdutosNotasPag.fieldbyname('descricaoproduto').FieldName,
     qryProdutosNotasPag.fieldbyname('quantidade').FieldName, 'NFE',
     qryProdutosNotasPag.fieldbyname('codigonota').asstring,
     qryProdutosNotasPag.fieldbyname('valorgrade1').FieldName,
     qryProdutosNotasPag.fieldbyname('valorgrade2').FieldName,
     qryProdutosNotasPag.fieldbyname('linha').FieldName,
     qryProdutosNotasPag.fieldbyname('coluna').FieldName, 240, 320, self);

     dbgNFEntrada.setfocus;

  end;



end;

