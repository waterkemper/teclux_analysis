function TfrmConferenciacoletor_x1_240x320.MontarConsultaCondicaoContrato: Boolean;
var
  vParametroSetado : boolean;

begin
  result := false;
  vParametroSetado := false;

  if edfcontrato.modified or
     edtDataContrato.Modified or
     edtNomeContrato.Modified then
  begin


    if edtDataContrato.DataValida and
      (edtDataContrato.Text <> '') then
    begin
      qryContratos.MacroByName('CondicaoDataContrato').asString := ' AND ct.data = '+quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(edtDataContrato.Text)));
      vParametroSetado := true;
    end
    else
      qryContratos.MacroByName('CondicaoDataContrato').asString := '';

    if (edtNomeContrato.Text <> '') then
    begin
      qryContratos.MacroByName('CondicaoNomeContrato').asString := format(' AND (to_ascii(ct.nome,''latin1'') ilike to_ascii(''%s%s'',''latin1''))', [edtNomeContrato.Text, '%']);
      vParametroSetado := true;
    end
    else
      qryContratos.MacroByName('CondicaoNomeContrato').asString := '';


    if (edfcontrato.Text <> '') then
    begin
      qryContratos.MacroByName('CondicaoNumeroContrato').asString := ' and ct.numero = '+quotedstr(edfcontrato.Text);
      qryContratos.MacroByName('CondicaoDataContrato').asString := '';
      qryContratos.MacroByName('CondicaoNomeContrato').asString := '';

      edtDataContrato.clear;
      edtNomeContrato.clear;

      vParametroSetado := true;
    end
    else
      qryContratos.MacroByName('CondicaoNumeroContrato').asString := '';


    if not vParametroSetado  then
      qryContratos.MacroByName('CondicaoNumeroContrato').asString := ' and false ';

    qryContratos.close;
    qryContratos.open;

    result := qryContratos.recordcount <> 0;

  end;

end;

