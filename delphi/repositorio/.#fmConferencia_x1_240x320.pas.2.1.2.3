function TfrmConferenciacoletor_x1_240x320.MontarConsultaCondicaoNFSaida: Boolean;
var
  vParametroSetado : boolean;

begin
  result := false;

  vParametroSetado := false;

  if (edtDataInicial.Modified or edtDataFinal.Modified) or
     edfchv_nfesaida.Modified or
     edfNFSaida.Modified or
     edtNomeNFSaida.Modified then

  begin

    if edtDataInicial.DataValida and
      (edtDataInicial.Text <> '') and
       edtDataFinal.DataValida and
      (edtDataFinal.Text <> '') then
    begin

      qryDadosFiscais.MacroByName('CondicaoIntervaloDataNFSaida').asString := format(' and df.data between %s and %s',
                 [quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(edtDataInicial.Text))),
                  quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(edtDataFinal.Text)))] );
      vParametroSetado := true;

    end
    else

    if edtDataInicial.DataValida and
      (edtDataInicial.Text <> '') then
    begin

      qryDadosFiscais.MacroByName('CondicaoIntervaloDataNFSaida').asString := format(' and df.data >= %s',
                 [quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(edtDataInicial.Text)))]);
      vParametroSetado := true;

    end
    else
    if edtDataFinal.DataValida and
      (edtDataFinal.Text <> '') then
    begin
      qryDadosFiscais.MacroByName('CondicaoIntervaloDataNFSaida').asString := format(' and df.data <= %s ',
                 [quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(edtDataFinal.Text)))]);
      vParametroSetado := true;
    end
    else
      qryDadosFiscais.MacroByName('CondicaoIntervaloDataNFSaida').asString := '';



    if (edfNFSaida.Text <> '') then
    begin
      qryDadosFiscais.MacroByName('CondicaoNumeroNFSaida').asString := ' and n.numero = '+edfNFSaida.Text;
      vParametroSetado := true;
    end
    else
      qryDadosFiscais.MacroByName('CondicaoNumeroNFSaida').asString := '';


    if (edtNomeNFSaida.Text <> '') then
    begin
      qryDadosFiscais.MacroByName('CondicaoNomeNFSaida').asString := format(' and (to_ascii(df.nome,''latin1'') ilike to_ascii(''%s%s'',''latin1''))', [edtNomeNFSaida.Text, '%']);
      vParametroSetado := true;
    end
    else
      qryDadosFiscais.MacroByName('CondicaoNomeNFSaida').asString := '';


    if (edfchv_nfesaida.Text <> '') then
    begin

      qryDadosFiscais.MacroByName('CondicaoChv_NFeSaida').asString := ' and df.chv_nfe = '+quotedstr(somentenumero(edfchv_nfesaida.Text));
      qryDadosFiscais.MacroByName('CondicaoIntervaloDataNFSaida').asString := '';
      qryDadosFiscais.MacroByName('CondicaoNumeroNFSaida').asString := '';
      qryDadosFiscais.MacroByName('CondicaoNomeNFSaida').asString := '';

      edtDataInicial.clear;
      edtDataFinal.clear;
      edfNFSaida.clear;
      edtNomeNFSaida.clear;

      vParametroSetado := true;
    end
    else
      qryDadosFiscais.MacroByName('CondicaoChv_NFeSaida').asString := '';


    if not vParametroSetado then
       qryDadosFiscais.MacroByName('CondicaoNumeroNFSaida').asString := ' and false ';

    qryDadosFiscais.close;
    qryDadosFiscais.open;

    result := qryDadosFiscais.recordcount <> 0;

  end;

end;

