function TfrmConferenciacoletor_x1_240x320.MontarConsultaCondicaoNFEntrada: Boolean;
var
  vParametroSetado : boolean;

begin
  result := false;

  vParametroSetado := false;

  if (edtDataInicialNFe.Modified or edtDataFinalNFe.Modified) or
     edfchv_nfeEntrada.Modified or
     edfNFEntrada.Modified or
     edtNomeNFEntrada.Modified then

  begin

    if edtDataInicialNFe.DataValida and
      (edtDataInicialNFe.Text <> '') and
       edtDataFinalNFe.DataValida and
      (edtDataFinalNFe.Text <> '') then
    begin

      qryNotasPag.MacroByName('CondicaoIntervaloDataNFEntrada').asString := format(' and np.data between %s and %s',
                 [quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(edtDataInicialNFe.Text))),
                  quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(edtDataFinalNFe.Text)))] );
      vParametroSetado := true;

    end
    else

    if edtDataInicialNFe.DataValida and
      (edtDataInicialNFe.Text <> '') then
    begin

      qryNotasPag.MacroByName('CondicaoIntervaloDataNFEntrada').asString := format(' and np.data >= %s',
                 [quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(edtDataInicialNFe.Text)))]);
      vParametroSetado := true;

    end
    else
    if edtDataFinalNFe.DataValida and
      (edtDataFinalNFe.Text <> '') then
    begin
      qryNotasPag.MacroByName('CondicaoIntervaloDataNFEntrada').asString := format(' and np.data <= %s ',
                 [quotedstr(FormatDateTime('yyyy-mm-dd',strtodate(edtDataFinalNFe.Text)))]);
      vParametroSetado := true;
    end
    else
      qryNotasPag.MacroByName('CondicaoIntervaloDataNFEntrada').asString := '';


    if (edfNFEntrada.Text <> '') then
    begin
      qryNotasPag.MacroByName('CondicaoNumeroNFEntrada').asString := ' and np.numero = '+edfNFEntrada.Text;
      vParametroSetado := true;
    end
    else
      qryNotasPag.MacroByName('CondicaoNumeroNFEntrada').asString := '';


    if (edtNomeNFEntrada.Text <> '') then
    begin
      qryNotasPag.MacroByName('CondicaoNomeNFEntrada').asString := format(' and (to_ascii(np.nome,''latin1'') ilike to_ascii(''%s%s'',''latin1''))', [edtNomeNFEntrada.Text, '%']);
      vParametroSetado := true;
    end
    else
      qryNotasPag.MacroByName('CondicaoNomeNFEntrada').asString := '';


    if (edfchv_nfeEntrada.Text <> '') then
    begin
      qryNotasPag.MacroByName('CondicaoChv_NFeEntrada').asString := ' and np.chv_nfe = '+quotedstr(somentenumero(edfchv_nfeEntrada.Text));
      qryNotasPag.MacroByName('CondicaoIntervaloDataNFEntrada').asString := '';
      qryNotasPag.MacroByName('CondicaoNumeroNFEntrada').asString := '';
      qryNotasPag.MacroByName('CondicaoNomeNFEntrada').asString := '';

      edtDataInicialNFe.clear;
      edtDataFinalNFe.clear;
      edfNFEntrada.clear;
      edtNomeNFEntrada.clear;

      vParametroSetado := true;
    end
    else
      qryNotasPag.MacroByName('CondicaoChv_NFeEntrada').asString := '';


    if not vParametroSetado then
       qryNotasPag.MacroByName('CondicaoNumeroNFEntrada').asString := ' and false ';

    qryNotasPag.close;
    qryNotasPag.open;

    result := qryNotasPag.recordcount <> 0;

  end;

end;

