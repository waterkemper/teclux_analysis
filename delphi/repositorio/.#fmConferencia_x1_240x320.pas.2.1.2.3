  pgcOperacao.TabWidth := 1;


end;

procedure TfrmConferenciacoletor_x1_240x320.KeyDown(var Key: Word;
  Shift: TShiftState);
begin
  inherited;
  if key = vk_escape then
  begin
    if pnlOpColetor.Visible then
    begin
      if MensagemConfirmacao('Tem certeza que deseja sair do sistema?') = smbOK then
        close;
    end
    else
    if pnlOperacao.Visible then
    begin
      if pgcOperacao.activepage = tstContrato then
      begin
        if pgcContrato.ActivePage = tstSelecaoContrato then
        begin
          pgcContrato.ActivePage := tstParametrosContrato;
          pgcContratoChange(nil);
          edfContrato.setfocus;
        end
        else
        begin
          pnlOpColetor.Visible := true;
          pnlOpColetor.SetFocus;
          pnlOperacao.Visible := false;
        end;
      end
      else
      if pgcOperacao.activepage = tstInterlojas then
      begin

      end
      else
      if pgcOperacao.activepage = tstNFSaida then
      begin
        if pgcNFSaida.ActivePage = tstSelecaoNFSaida then
        begin
          pgcNFSaida.ActivePage := tstParametrosNfsAIDA;
          pgcNFSaidaChange(nil);
          edfchv_nfesaida.SetFocus;
        end
        else
        begin
          pnlOpColetor.Visible := true;
          pnlOpColetor.SetFocus;
          pnlOperacao.Visible := false;
        end;
      end
      else
      if pgcOperacao.activepage = tstNFEntrada then
      begin
        if pgcNFEntrada.ActivePage = tstSelecaoNFEntrada then
        begin
          pgcNFEntrada.ActivePage := tstParametrosNfEntrada;
          pgcNFEntradaChange(nil);
          edfchv_nfeEntrada.SetFocus;
        end
        else
        begin
          pnlOpColetor.Visible := true;
          pnlOpColetor.SetFocus;
          pnlOperacao.Visible := false;
        end;
      end;

    end;
  end
  else
  if (key in [vk_1,97]) and pnlOpColetor.Visible then
    btnContratoClick(nil)
  else
  if (key in [vk_2, 98]) and pnlOpColetor.Visible then
    btnInterlojasClick(nil)
  else
  if (key in [vk_3, 99]) and pnlOpColetor.Visible then
    btnListaPadraoClick(nil)
  else
  if (key in [vk_4, 100]) and pnlOpColetor.Visible then
    btnNFEntradaClick(nil)
  else
  if (key in [vk_5, 101]) and pnlOpColetor.Visible then
    btnNFSaidaClick(nil);

end;


