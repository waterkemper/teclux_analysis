{$R *.dfm}


function AcionarTelaLerArquivo_(Owner: TComponent; Cliente: Integer; TipoCliente: String; qryProdutosIncluidos: TtecQuery; TipoImportacao: tpImportacaoArquivo): TtecQuery;
begin
  if not assigned(frrmLerProdutosArquivo) or (frrmLerProdutosArquivo.Owner <> Owner) then
  begin

    if assigned(frrmLerProdutosArquivo) then
      frrmLerProdutosArquivo.free;

    frrmLerProdutosArquivo := TfrrmLerProdutosArquivo.create(Owner);
    frrmLerProdutosArquivo.vCliente := Cliente;
    frrmLerProdutosArquivo.vTipoCliente := TipoCliente;
    frrmLerProdutosArquivo.Tipoimportacao := TipoImportacao;
    frrmLerProdutosArquivo.qryProdutosIncluidos := qryProdutosIncluidos;

    frrmLerProdutosArquivo.showmodal;
    if frrmLerProdutosArquivo.modalresult = mrOk then
      result := frrmLerProdutosArquivo.qryProdutos
    else
      result := nil;
        
  end;

//  frrmLerProdutosArquivo.Free;

end;


