  object qryNSUS: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnFilterRecord = qryNSUSFilterRecord
    Filtered = True
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'IntervaloEmissao'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ListadeFiliais'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'LIstadeFornecedores'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SituacaoCadasstroNFe'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'select f.codigo as filial,'
      '       f.mnemonico as mfilial,'
      '       formatar_cpf_cnpj(nsus.cnpjemitente) as cnpjemitente,'
      '       nsus.*,'
      
        '       case when nsus.xmlnfe is null then false else true end as' +
        ' possuixml,'
      '       (select max(nsusm.nsu)'
      '        from nsus nsusm'
      '        where nsusm.cnpj = nsus.cnpj'
      '        ) as ultnsu,'
      '       vf.codigo as codigoclifor,'
      '       vf.tipo as tipocliforn,'
      
        '       cast(substring(nsus.chnfe from 23 for 3) as varchar(3)) a' +
        's serie,'
      
        '       cast(substring(nsus.chnfe from 26 for 9) as integer) as n' +
        'rnfe,'
      ''
      
        '       case when nsus.cSitNFe = '#39'1'#39' then cast('#39'AUTORIZADA'#39' as va' +
        'rchar(10))'
      
        '            when nsus.cSitNFe = '#39'2'#39' then cast('#39'DENEGADA'#39' as varc' +
        'har(10))'
      
        '            when nsus.cSitNFe = '#39'3'#39' then cast('#39'CANCELADA'#39' as var' +
        'char(10))'
      '       end as nomecSifNFe,'
      ''
      
        '       case when np.chv_nfe is null then cast('#39'NC'#39' as varchar(2)' +
        ')'
      '            WHEN np.situacao = '#39'N'#39' then cast('#39'N'#39' as varchar(2))'
      '            WHEN np.situacao = '#39'P'#39' then cast('#39'P'#39' as varchar(2))'
      '       end as StatusNP     '
      ''
      ''
      'from nsus join filiais f on nsus.cnpj = f.cnpj'
      
        '          left join vfornecedores vf on nsus.cnpjemitente = vf.p' +
        'essoanumero'
      '          left join notaspag np on nsus.chnfe = np.chv_nfe'
      ''
      'where tipoxmlretorno = '#39'resNFe'#39
      ''
      '  %IntervaloEmissao'
      '  %ListadeFiliais'
      '  %LIstadeFornecedores'
      '  %SituacaoCadasstroNFe'
      ''
      'order by f.codigo, nsus.nsu'
      '')
    RequestLive = True
    Left = 736
    Top = 153
