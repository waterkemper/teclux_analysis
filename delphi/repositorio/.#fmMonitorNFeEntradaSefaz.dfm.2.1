    Macros = <>
    Sql.Strings = (
      'select f.codigo,'
      '       f.cnpj,'
      '       f.mnemonico,'
      '       f.razao,'
      '       f.maxNSU_sefaz,'
      '       cast((select max(nsus.nsu)'
      '        from nsus where nsus.cnpj = f.cnpj) as integer) as nsu,'
