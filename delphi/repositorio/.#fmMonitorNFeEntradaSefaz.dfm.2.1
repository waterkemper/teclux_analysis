      '       cast((select max(nsus.nsu)'
      
        '        from nsus where nsus.cnpj = f.cnpj) as integer) as nsu_i' +
        'nicial,'
      ''
      '       f.nsu_dhRecbto,'
      
        '/*       case when f.codigo = 9 then true else false end as marc' +
        'ar,*/'
      '       f.buscarxmlnfeentrada,'
      '       f.estado,'
      ''
      
        '       coalesce(EXTRACT(EPOCH FROM current_timestamp-cast(f.nsu_' +
        'dhrecbto as timestamp))/3600,0) as nhora'
      ''
      'from filiais f'
      'where f.buscarxmlnfeentrada'
