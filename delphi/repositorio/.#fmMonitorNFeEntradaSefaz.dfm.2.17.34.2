  object qryFiliais: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    BeforePost = qryFiliaisBeforePost
    AfterPost = qryFiliaisAfterPost
    OnCalcFields = qryFiliaisCalcFields
    OnFilterRecord = qryFiliaisFilterRecord
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select f.codigo,'
      '       f.cnpj,'
      '       f.mnemonico,'
      '       f.razao,'
      '       f.maxNSU_sefaz,'
      '       f.maxNSUCTE_sefaz,'
      ''
      '       cast((select max(nsus.nsu)'
      '        from nsus'
      '        where nsus.cnpj = f.cnpj'
      '          and nsus.tipo = '#39'NFE'#39') as integer) as nsu,'
      ''
      '       cast((select max(nsus.nsu)'
      '        from nsus'
      '        where nsus.cnpj = f.cnpj'
      '          and nsus.tipo = '#39'NFE'#39') as integer) as nsu_inicial,'
      ''
      '       cast((select max(nsus.nsu)'
      '        from nsus'
      '        where nsus.cnpj = f.cnpj'
      '          and nsus.tipo = '#39'CTE'#39') as integer) as nsucte,'
      ''
      '       cast((select max(nsus.nsu)'
      '        from nsus'
      '        where nsus.cnpj = f.cnpj'
      '          and nsus.tipo = '#39'CTE'#39') as integer) as nsucte_inicial,'
      ''
      '       f.nsu_dhRecbto,'
      '       f.nsucte_dhRecbto,'
      ''
      ''
      
        '       coalesce(EXTRACT(EPOCH FROM current_timestamp-cast(nullif' +
        '(btrim(f.nsu_dhrecbto),'#39#39') as timestamp))/3600,0) as nhora,'
      
        '       coalesce(EXTRACT(EPOCH FROM current_timestamp-cast(nullif' +
        '(btrim(f.nsucte_dhrecbto),'#39#39') as timestamp))/3600,0) as nhoracte' +
        ','
