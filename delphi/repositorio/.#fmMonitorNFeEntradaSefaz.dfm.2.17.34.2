    Macros = <>
    Sql.Strings = (
      'select nsus.*,'
      '       f.estado,'
      '       f.codigo'
      'from nsus'
      '     join filiais f'
      '     on nsus.cnpj = f.cnpj'
      ''
      'where true'
      '  and tipoxmlretorno = :tipo   /*in ('#39'resNFe'#39', '#39'resCTe'#39')*/'
      '  and xmlnfe is null'
      '  and f.buscarxmlnfeentrada'
      '  and nsus.csitnfe not in ('#39'3'#39','#39'2'#39') /* 3 cancelada 2 denegada */'
      '  '
      
        '  and cast(nsus.dhemi as date) >= (CURRENT_DATE - interval '#39'3 mo' +
        'nths'#39')'
      ''
      '  and f.codigo = :filial'
      '  '
      '/*  and chnfe='#39'35190400133418000177550010001017341245982292'#39'*/'
      '/*  and xnome = '#39'LUCKSPUMA INDUSTRIA E COMERCIO LTDA'#39' */'
      'order by dhemi desc, cnpj, nsu  limit 20 '
      '')
