    Macros = <>
    Sql.Strings = (
      'update notaspag set situacao = '#39'C'#39' where codigo = :codigonota;'
      ''
      'update contratos set frete_pago = sel.valornota'
      'from'
      '('
      ''
      '  select sel.*'
      '  from'
      '  ('
      ''
      '    select sel.contrato,'
      '           sel.frete_pago,'
      '           sum(sel.valornota) as valornota'
      '    from       '
      ''
      '       ('
      ''
      
        '        select df.contrato, case when np.situacao = '#39'N'#39' then np.' +
        'valornota else 0.00 end as valornota, ct.frete_pago'
      '        from contratos ct'
      '             join dadosfiscais df'
      '                  join notaspagchv npchv'
      '                       join notaspag np'
      '                       on npchv.codigonota = np.codigo'
      
        '                  on df.chv_nfe = npchv.chv_nfe                 ' +
        '  '
      '             on ct.numero = df.contrato'
      '        '
      ''
      '        where ct.numero in (select df2.contrato'
      '                            from dadosfiscais df2'
      
        '                            where df2.chv_nfe in (select npchv2.' +
        'chv_nfe'
      
        '                                                 from notaspagch' +
        'v npchv2'
      
        '                                                 where npchv2.co' +
        'digonota = :codigonota ))'
      '                           '
      ''
      '       ) as sel'
      '       group by contrato, frete_pago'
      '    ) as sel'
      '  where coalesce(sel.frete_pago,0)<>sel.valornota'
      ''
      ''
      ') as sel'
      'where contratos.numero = sel.contrato;'
      '')
    RequestLive = True
    Left = 820
    Top = 197
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigonota'
        ParamType = ptUnknown
      end>
  end
