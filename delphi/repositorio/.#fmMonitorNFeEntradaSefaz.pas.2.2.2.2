constructor TfrmMonitorNFeEntradaSefaz.Create(AOwner: TComponent);
begin
  inherited;

  TTecNotaFiscalEletronica.SetExecutavel(fNFeExecNFe);

  self.windowstate := wsMinimized;
  qryFiliais.Open;
  dbgFiliaisSefaz.Refresh;

//  sleep(2500);
//  frmMonitorNFeEntradaSefaz.WindowState := wsMinimized;

  BuscarInformacoesSefaz;
end;

destructor TfrmMonitorNFeEntradaSefaz.Destroy;
begin
  Timer1.enabled := false;
  FreeAndNil(AdvSmoothProgressBar1);
  qryNSUS.Close;
  inherited;

end;

procedure TfrmMonitorNFeEntradaSefaz.Timer1Timer(Sender: TObject);
var
vPosition : Double;

begin
  inherited;

    case PassosDistribuicao of

      opDistribuicaoDFe:
      begin
        if (qryFiliaisNSUSnsu.asstring <> '') and
           (qryFiliaisNSUSmaxnsu_sefaz.asString <> '') then
        begin
          if qryFiliaisNSUSmaxnsu_sefaz.asinteger <> qryFiliaisNSUSnsu_inicial.asinteger then
          begin
            try
              vPosition :=  (qryFiliaisNSUSnsu.asinteger - qryFiliaisNSUSnsu_inicial.asinteger) * 100 / (qryFiliaisNSUSmaxnsu_sefaz.asinteger - qryFiliaisNSUSnsu_inicial.asinteger)
            except
              vPosition := 0;
            end;
          end
          else
            vPosition := 0;

          AdvSmoothProgressBar1.Position := vPosition;
        end
        else
        begin
          vPosition := 0;
          AdvSmoothProgressBar1.Position := vPosition;
        end;

        if vMsg <> '' then
          lblMsg.Caption := vmsg;

        if fileexists(vArquivoLogSefaz) then
          mmoLog.Lines.LoadFromFile(vArquivoLogSefaz);

      end;

      opDistribuicaoDFeCienciaOPeracao:
      begin

        vPosition :=  (qryNSU.RecNo * 100) / qryNSU.recordcount;
        AdvSmoothProgressBar1.Position := vPosition;
        lblMsg.Caption := format('Efetuando a ciência da operação e gravação do xml. NSU %S - Registro %s de um total de %s',
                   [inttostr(strtoint(qrynsu.fieldbyname('nsu').asString)), inttostr(qrynsu.RecNo), inttostr(qrynsu.RecordCount)]);

        if fileexists(vArquivoLogSefaz) then
          mmoLog.Lines.LoadFromFile(vArquivoLogSefaz);

      end;

      opInicio:
      begin
        vPosition := 0;
        AdvSmoothProgressBar1.Position := vPosition;
        lblMsg.Caption := '';
      end;

      opAguardandoUmaHora:
      begin
        if TempoEsgotado(vTempoInicialEsperaVerificacao, 1800000) then
          BuscarInformacoesSefaz
        else
          lblMsg.Caption := 'A nova verificação vai iniciar em '+ formatfloat('##',(1800000 - (TempoAtual - vTempoInicialEsperaVerificacao))/1000/60) + ' segundos ';
      end;

    end;

end;

procedure TfrmMonitorNFeEntradaSefaz.qryNSUSFilterRecord(DataSet: TDataSet;
  var Accept: Boolean);
begin
  inherited;
  Accept := (qryNSUStipoxmlretorno.asString = 'resNFe');
end;

procedure TfrmMonitorNFeEntradaSefaz.sbnPararClick(Sender: TObject);
begin
  sbnBuscarNFeServidorSefaz.Caption := 'Iniciar busca no servidor da Sefaz';
  PassosDistribuicao := opInicio;
  vPararProcessamento := true;
  if assigned(_ProcessamentoNFE) then
    _ProcessamentoNFE.Terminate;

  sbnBuscarNFeServidorSefaz.onClick := sbnBuscarNFeServidorSefazClick;
end;

procedure TfrmMonitorNFeEntradaSefaz.Processamento;
begin
  PassosDistribuicao := opDistribuicaoDFe;
  try

    if not vPararProcessamento then
    begin
      qryFiliaisNSUS.close;
      qryFiliaisNSUS.Open;
      qryFiliaisNSUS.first;
      while not qryFiliaisNSUS.eof do
      begin
        if qryFiliaisnsu_dhrecbto.isnull or
          ((qryFiliaisNSUSnhora.asfloat > 1) or
           (qryFiliaisNSUSmaxnsu_sefaz.asinteger > qryFiliaisNSUSnsu.asinteger)) then
          DistribuicaoDFe(self, qryFiliaisNSUS, vMsg, vPararProcessamento, '');

        if vPararProcessamento then
          break;

        qryFiliaisNSUS.next;
      end;

      if not vPararProcessamento then
      begin
        vmsg := 'Fim da captura dos NSUs do arquivo de distribuição';
        qryNSU.close;
        qryNSU.open;

        if qryNSU.RecordCount <> 0 then
        begin
          PassosDistribuicao := opDistribuicaoDFeCienciaOPeracao;
          DistribuicaoDFeCienciaOPeracao(self, qryNSU, vMsg, vPararProcessamento);
        end;
      end;

    end;

  finally

    sbnPararClick(nil);
    PassosDistribuicao := opAguardandoUmaHora;
    IniciarTempo(vTempoInicialEsperaVerificacao);
    qryFiliais.close;
    qryFiliais.Open;

  end;

end;

procedure TfrmMonitorNFeEntradaSefaz.FormCloseQuery(Sender: TObject;
  var CanClose: Boolean);
begin
  inherited;
  sbnPararClick(nil);
end;

procedure TfrmMonitorNFeEntradaSefaz.dbgNFESefazDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if TDBGrid(Sender).Fields[DataCol].FieldName = 'statusnp' then
  begin
    if TDBGrid(Sender).DataSource.DataSet.FieldByName('statusnp').AsString = 'NC' then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := clred;
      TDBGrid(Sender).Canvas.Font.Color := clWhite;
    end
    else
    if TDBGrid(Sender).DataSource.DataSet.FieldByName('statusnp').AsString = 'N' then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := clGreen;
      TDBGrid(Sender).Canvas.Font.Color := clWhite;
    end
    else
    if TDBGrid(Sender).DataSource.DataSet.FieldByName('statusnp').AsString = 'P' then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := $000080FF;
      TDBGrid(Sender).Canvas.Font.Color := clWhite;
    end;

    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;

end;

procedure TfrmMonitorNFeEntradaSefaz.dbgFiliaisLocalDblClick(Sender: TObject);
begin
  inherited;
  MarcarFilial(not qryFiliaisbuscarxmlnfeentrada.asBoolean);
end;

procedure TfrmMonitorNFeEntradaSefaz.MarcarFilial(Marcar: boolean);
begin
  qryFiliais.edit;
  qryFiliaisbuscarxmlnfeentrada.asBoolean := Marcar;
  qryFiliais.Post;
end;

procedure TfrmMonitorNFeEntradaSefaz.sbnMarcarFiliaisClick(Sender: TObject);
begin
  inherited;
  MarcarFilial(True);
end;

procedure TfrmMonitorNFeEntradaSefaz.sbnDesmarcarFiliaisClick(Sender: TObject);
begin
  inherited;
  MarcarFilial(False);
end;

procedure TfrmMonitorNFeEntradaSefaz.sbnBuscarNFeServidorSefazClick(
  Sender: TObject);
begin
  inherited;
  BuscarInformacoesSefaz;
end;

procedure TfrmMonitorNFeEntradaSefaz.BuscarInformacoesSefaz;
begin
  vPararProcessamento := false;

  sbnBuscarNFeServidorSefaz.Caption := 'Parar busca no servidor da Sefaz';
  sbnBuscarNFeServidorSefaz.onClick := sbnPararClick;
  sbnBuscarNFeServidorSefaz.Update;

  _ProcessamentoNFE := TProcessamentoNFE.create(false);
  _ProcessamentoNFE.Processamento := Processamento;
  _ProcessamentoNFE.resume;
end;


procedure TfrmMonitorNFeEntradaSefaz.qryFiliaisAfterPost(DataSet: TDataSet);
begin
  inherited;
  qryFiliais.Transaction.Commit;
end;


