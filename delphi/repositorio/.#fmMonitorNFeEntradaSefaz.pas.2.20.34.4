procedure TfrmMonitorNFeEntradaSefaz.Timer1Timer(Sender: TObject);
var
vPosition : Double;

begin
  inherited;

    case PassosDistribuicao of

      opDistribuicaoDFe:
      begin
        if (qryFiliaisNSUSnsu.asstring <> '') and
           (qryFiliaisNSUSmaxnsu_sefaz.asString <> '') then
        begin
          if qryFiliaisNSUSmaxnsu_sefaz.asinteger <> qryFiliaisNSUSnsu_inicial.asinteger then
          begin
            try
              vPosition :=  (qryFiliaisNSUSnsu.asinteger - qryFiliaisNSUSnsu_inicial.asinteger) * 100 / (qryFiliaisNSUSmaxnsu_sefaz.asinteger - qryFiliaisNSUSnsu_inicial.asinteger)
            except
              vPosition := 0;
            end;
          end
          else
            vPosition := 0;

          AdvSmoothProgressBar1.Position := vPosition;
        end
        else
        begin
          vPosition := 0;
          AdvSmoothProgressBar1.Position := vPosition;
        end;

        if vMsg <> '' then
          lblMsg.Caption := vmsg;

        if fileexists(vArquivoLogSefaz) then
          mmoLog.Lines.LoadFromFile(vArquivoLogSefaz);

      end;

      opVarificacaoNSUFaltantes:
      begin
        vPosition :=  (qryNSUS_Faltantes.RecNo * 100) / qryNSUS_Faltantes.recordcount;
        AdvSmoothProgressBar1.Position := vPosition;

        if vMsg <> '' then
          lblMsg.Caption := vmsg
        else
          lblMsg.Caption := format('Efetuando a verificação de NSU faltantes. NSU %S - Registro %s de um total de %s',
                     [inttostr(strtoint(qryNSUS_Faltantes.fieldbyname('nsu').asString)), inttostr(qrynsu.RecNo), inttostr(qrynsu.RecordCount)]);

//        if fileexists(vArquivoLogSefaz) then
//          mmoLog.Lines.LoadFromFile(vArquivoLogSefaz);

      end;

      opDistribuicaoDFeCienciaOPeracao:
      begin

        vPosition :=  (qryNSU.RecNo * 100) / qryNSU.recordcount;
        AdvSmoothProgressBar1.Position := vPosition;

        if vMsg <> '' then
          lblMsg.Caption := vmsg
        else
          lblMsg.Caption := format('Efetuando a ciência da operação e gravação do xml. NSU %S - Registro %s de um total de %s',
                     [inttostr(strtoint(qrynsu.fieldbyname('nsu').asString)), inttostr(qrynsu.RecNo), inttostr(qrynsu.RecordCount)]);

        if fileexists(vArquivoLogSefaz) then
          mmoLog.Lines.LoadFromFile(vArquivoLogSefaz);

      end;

      opInicio:
      begin
        vPosition := 0;
        AdvSmoothProgressBar1.Position := vPosition;
        lblMsg.Caption := '';
      end;

      opAguardandoUmaHora:
      begin

        if TempoEsgotado(vTempoInicialEsperaVerificacao, 3600000) then
          BuscarInformacoesSefaz
        else
          lblMsg.Caption := 'A nova verificação vai iniciar em '+ formatfloat('##',(3600000 - (TempoAtual - vTempoInicialEsperaVerificacao))/1000/60) + ' segundos ';
      end;

    end;

    application.processmessages;

end;

