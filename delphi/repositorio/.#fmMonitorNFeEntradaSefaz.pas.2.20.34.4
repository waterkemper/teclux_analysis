procedure TfrmMonitorNFeEntradaSefaz.sbnPararClick(Sender: TObject);
begin
  sbnBuscarNFeServidorSefaz.Caption := 'Iniciar busca no servidor da Sefaz';
  PassosDistribuicao := opInicio;
  vPararProcessamento := true;
  if assigned(_ProcessamentoNFE) then
    _ProcessamentoNFE.Terminate;

  gbxFiliaisSefaz.enabled := true;
  qryFiliais.EnableControls;
  qryFiliais.Filtered := false;


  sbnBuscarNFeServidorSefaz.onClick := sbnBuscarNFeServidorSefazClick;
end;

procedure TfrmMonitorNFeEntradaSefaz.Processamento;
VAR
  vPosition : Double;
  vEntrouParaAtualizacao: Boolean;

  procedure AtualizarCTesCancelados;
  begin

    vmsg := 'Atualizando CTe´s cancelados!';

    qryCTeCancelados.ParambyName('codigo').asInteger := qryFiliaisNSUScodigo.asInteger;

    qryCTeCancelados.close;
    qryCTeCancelados.open;

    qryCTeCancelados.first;
    while not qryCTeCancelados.eof do
    begin
      qryAtualizarCte_x_NP_cancelados.parambyname('codigonota').asinteger :=
        qryCTeCanceladoscodigo.asinteger;
      qryAtualizarCte_x_NP_cancelados.ExecSql;

      qryAtualizarCte_x_NP_cancelados.Transaction.Commit;

      qryCTeCancelados.next;

      try
        vPosition := qryCTeCancelados.recno * 100 / qryCTeCancelados.recordcount
      except
        vPosition := 0;
      end;
      AdvSmoothProgressBar1.Position := vPosition;
      application.processmessages;
    end;

  end;

  procedure AtualizarNSU(Tipo: String);
  begin
    if not vPararProcessamento then
    begin
      qryNSU.parambyname('tipo').asString := Tipo;
      qryNSU.parambyname('filial').asInteger := qryFiliaisNSUScodigo.asinteger;

      qryNSU.close;
      qryNSU.open;

      if qryNSU.RecordCount <> 0 then
      begin
        vmsg := format('Ciência da Operação ou Confirmação de NSU pendentes %x/%x',[qryNSU.recno, qryNSU.recordcount]);
        PassosDistribuicao := opDistribuicaoDFeCienciaOPeracao;
        DistribuicaoDFeCienciaOPeracao(self, qryNSU, vMsg, vPararProcessamento, PassosDistribuicao, qryFiliaisNSUS, qryFiliais, qryNSUtipo.asString);
      end;


    end;
  end;

  procedure AtualizarNSUFaltantes;
  begin

    if not vPararProcessamento then
    begin

      if qryNSU.recordcount < 20 then
      begin

        vmsg := 'Início da captura de xmls NFE FALTANTES';
        qryNSUS_Faltantes.Parambyname('tipo').asString := 'NFE';
        qryNSUS_Faltantes.Parambyname('codigo').asInteger := qryFiliaisNSUScodigo.asinteger;
        qryNSUS_Faltantes.Parambyname('limit_').asInteger := 20-qryNSU.recordcount;

        qryNSUS_Faltantes.close;
        qryNSUS_Faltantes.open;

        if qryNSUS_Faltantes.RecordCount <> 0 then
        begin
          PassosDistribuicao := opVarificacaoNSUFaltantes;

          qryFiliaisNSUS.close;
          qryFiliaisNSUS.Open;

          DistribuicaoDFe(self, qryNSUS_Faltantes, vMsg, vPararProcessamento, PassosDistribuicao, qryFiliaisNSUS, qryFiliais, '', 'NFE');


        end;
      end;
    end;

    {
    if not vPararProcessamento then
    begin
      vmsg := 'Início da captura de xmls CTE FALTANTES';
      qryNSUS_Faltantes.Parambyname('tipo').asString := 'CTE';
      qryNSUS_Faltantes.close;
      qryNSUS_Faltantes.open;

      if qryNSUS_Faltantes.RecordCount <> 0 then
      begin
        PassosDistribuicao := opVarificacaoNSUFaltantes;

        qryFiliaisNSUS.close;
        qryFiliaisNSUS.Open;
        DistribuicaoDFe(self, qryNSUS_Faltantes, vMsg, vPararProcessamento, PassosDistribuicao, qryFiliaisNSUS, '', 'CTE');
      end;
    end;
    }


  end;

  procedure AtualizarNovosNSU;

    function PermiteAcessarDistribuicaoNFe: Boolean;
    begin
      result :=

          qryFiliaisnsu_dhrecbto.isnull or
          (qryFiliaisnhora.asfloat >= 1);

    end;

    function PermiteAcessarDistribuicaoCTe: Boolean;
    begin
      result :=

          qryFiliaisnsucte_dhrecbto.isnull or
          (qryFiliaisnhoracte.asfloat >= 1);

    end;


  begin
    if not vPararProcessamento then
    begin

      qryFiliais.first;
      while not qryFiliais.eof do
      begin

        if PermiteAcessarDistribuicaoNFe or
           PermiteAcessarDistribuicaoCTe then

        begin

          vEntrouParaAtualizacao := true;

          PassosDistribuicao := opDistribuicaoDFe;
          vmsg := 'Início da captura dos NSUs do arquivo de distribuição';

          qryFiliaisNSUS.parambyname('codigo').asinteger := qryFiliaisCodigo.asinteger;

          qryFiliaisNSUS.close;
          qryFiliaisNSUS.Open;
          qryFiliaisNSUS.first;

          while not qryFiliaisNSUS.eof do
          begin

             PassosDistribuicao := opDistribuicaoDFe;

             qryfiliais.Locate('codigo', qryFiliaisNSUScodigo.asinteger, []);


             if (qryFiliaisnsu.asString <> '') and
                (qryFiliaisNSUSnsu.asstring <> '') and
                (qryFiliaisnsu.asString <> qryFiliaisNSUSnsu.asstring) then
             begin
               qryFiliaisNSUS.edit;
               qryFiliaisNSUSnsu.asstring := qryFiliaisnsu.asString;
               qryFiliaisNSUSnsu_inicial.asstring := qryFiliaisnsu.asString;
               qryFiliaisNSUS.post;
             end;

            if qryFiliaisNSUSnsu_dhrecbto.isnull or
              (qryFiliaisNSUSnhora.asfloat >= 1) {or
              (qryFiliaisNSUSmaxnsu_sefaz.asinteger > qryFiliaisNSUSnsu.asinteger)} then
            begin

              qryFiliaisNSUS.edit;
              qryFiliaisNSUS.fieldbyname('nsu_cstat').clear;
              qryFiliaisNSUS.fieldbyname('nsu_cstat_motivo').clear;
              qryFiliaisNSUS.post;
              qryFiliaisNSUS.Transaction.Commit;

              application.processmessages;
              if not vPararProcessamento then
                AtualizarNSU('resNFe');

              application.processmessages;
              if not vPararProcessamento then

              if PermiteAcessarDistribuicaoNFe then
                AtualizarNSUFaltantes;


              if PermiteAcessarDistribuicaoNFe then
              begin
                PassosDistribuicao := opDistribuicaoDFe;
                DistribuicaoDFe(self, qryFiliaisNSUS, vMsg, vPararProcessamento, PassosDistribuicao, qryFiliaisNSUS, qryFiliais, '', 'NFE');
              end;


            end;


            if vPararProcessamento then
              break;

            if qryFiliaisNSUSnsucte_dhrecbto.isnull or
              (qryFiliaisNSUSnhoracte.asfloat >= 1) {or
               (qryFiliaisNSUSmaxnsucte_sefaz.asinteger > qryFiliaisNSUSnsucte.asinteger)} then
            begin

            {
            //OPERAÇÃO NÃO REALIZADA NO CÓDIGO
              application.processmessages;
              if not vPararProcessamento then
                AtualizarNSU('resCTe');
                }

              { Campos ainda não foram criados...
              qryFiliaisNSU.edit;
              qryFiliaisNSU.fieldbyname('nsucte_cstat').asString := pStat;
              qryFiliaisNSU.fieldbyname('nsucte_cstat_motivo').asString := pXStat;
              qryFiliaisNSU.post;
              qryFiliaisNSU.Transaction.Commit;
              }

              if PermiteAcessarDistribuicaoCTe then
              begin
                PassosDistribuicao := opDistribuicaoDFe;
                DistribuicaoDFe(self, qryFiliaisNSUS, vMsg, vPararProcessamento, PassosDistribuicao, qryFiliaisNSUS, qryFiliais, '', 'CTE');
              end;

              application.processmessages;
              if not vPararProcessamento then
                AtualizarCTesCancelados;

            end;

            if vPararProcessamento then
              break;

            qryFiliaisNSUS.next;

          end;

          vmsg := 'Fim da captura dos NSUs do arquivo de distribuição';

        end;

        qryFiliais.next;

      end;

      if vEntrouParaAtualizacao then
      begin
        qryFiliais.close;
        qryFiliais.Open;
        qryFiliais.EnableControls;
        qryFiliais.Filtered := false;
        application.processmessages;
        qryFiliais.DisableControls;
        qryFiliais.Filtered := true;

      end;

    end;
  end;

begin
  PassosDistribuicao := opInicio;
  try
    vEntrouParaAtualizacao := false;

//    qryFiliais.DisableControls;
//    qryFiliais.Filtered := true;


    application.processmessages;
    if not vPararProcessamento then
      AtualizarNovosNSU;


    {
    application.processmessages;
    if not vPararProcessamento then
      AtualizarNSU;


    application.processmessages;
    if not vPararProcessamento then
      AtualizarNSUFaltantes;


    application.processmessages;
    if not vPararProcessamento then
      AtualizarCTesCancelados;
      }

  finally

    PassosDistribuicao := opInicio;

    {
    sbnPararClick(nil);
    PassosDistribuicao := opAguardandoUmaHora;

    IniciarTempo(vTempoInicialEsperaVerificacao);
    }

//    qryFiliais.EnableControls;
//    qryFiliais.Filtered := false;

    if vEntrouParaAtualizacao then
    begin
      qryFiliais.close;
      qryFiliais.Open;
    end;

  end;

end;

