procedure TfrmMonitorNFeEntradaSefaz.BuscarInformacoesSefaz;
begin
  gbxFiliaisSefaz.enabled := false;
  qryFiliais.DisableControls;
  qryFiliais.Filtered := true;

  vPararProcessamento := false;

  sbnBuscarNFeServidorSefaz.Caption := 'Parar busca no servidor da Sefaz';
  sbnBuscarNFeServidorSefaz.onClick := sbnPararClick;
  sbnBuscarNFeServidorSefaz.Update;

  _ProcessamentoNFE := TProcessamentoNFE.create(false);
  _ProcessamentoNFE.Processamento := Processamento;
  _ProcessamentoNFE.resume;
end;


