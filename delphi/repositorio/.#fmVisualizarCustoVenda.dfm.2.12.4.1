  object qryOrcamentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryOrcamentosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        'select (select sum((po.quantidade * po.precovenda) - coalesce(po' +
        '.valordescontoitem,0))'
      #9'      from produtosorcamentos po'
      #9#9'    where po.orcamento =  o.codigo) as TotalItens,'
      ''
      '       (select sum((so.quantidade * so.valorservico))'
      '  '#9'    from servicosorcamentos so'
      #9#9'    where so.orcamento =  o.codigo) as TotalServico,'
      ''
      '       (select sum(po.quantidade * po.precovenda)'
      '        from produtosorcamentos po'
      '        where po.orcamento = o.codigo) as totalprodutos,'
      ''
      
        '       cast(:DescontoFinanceiro as numeric(11,2)) as DescontoFin' +
        'anceiro,'
      
        '       cast(:AcrescimoFinanceiro as numeric(11,2)) as AcrescimoF' +
        'inanceiro,'
      ''
      '       cast(:DescontoFinanceiro as numeric(11,2)) as desconto,'
      '       cast(:AcrescimoFinanceiro as numeric(11,2)) as acrescimo,'
      ''
      '       cast(:valorvista as numeric(11,2)) as valorvista,'
      '       cast(:valorprazo as numeric(11,2)) as valorprazo,'
      ''
      '       o.frete,'
      '       o.seguro,'
      ''
      
        '       (select sum(custodavenda(cast(po.orcamento as varchar), '#39 +
        'O'#39', po.produto))'
      #9'      from produtosorcamentos po'
      '        where po.orcamento = o.codigo) as TotalCusto,'
      ''
      '       0.00 as ICMSValor,'
      '       0.00 as ICMSValorst,'
      '       0.00 as pisvalorprodutos,'
      '       0.00 as cofinsvalorprodutos,'
      '       0.00 as valorissqn,'
      '       0.00 as PisValorServicos,'
      '       0.00 as CofinsValorServicos,'
      '       0.00 as ValorIPI,'
      
        '       cast(coalesce(replace(parametros_valor('#39'Al'#237'quota Simples ' +
        'Nacional'#39',o.filial),'#39','#39','#39'.'#39'),'#39'0'#39') as "numeric"(11,2)) as aliquot' +
        'aicms_sn,'
      '       0.00 as TotalIPI,'
      '       0.00 as impostoretido,'
      '       0.00 as valoricmssubstituicao,'
      '       0.00 as PercentualTotalCusto,'
      '       0.00 as totalvalorpis_servicos,'
      '       0.00 as totalvalorcofins_servicos,'
      '       0.00 as issqnbasecalculo,'
      '       0.00 as totalvalorcofins,'
      '       0.00 as SomaMargemLucro,'
      '       0.00 as baseicms,'
      '       0.00 as valoricms,'
      '       cast(0 as numeric(11,2)) as vICMSUFDest,'
      '       cast(0 as numeric(11,2)) as vICMSUFRemet,'
      '       0.00 as totalbaseicmssubstituicao,'
      '       0.00 as totalvaloricmssubstituicao,'
      '       0.00 as PercentualMargemLucro,'
      '       0.00 as SomaMargemLucroProdutos,'
      '       0.00 as ValorProdutos,'
      '       0.00 as despesasacessorias,'
      '       coalesce((select cl.consumidorfinal'
      '        from clientes cl'
      '        where cl.codigo = o.cliente'
      
        '          and '#39'C'#39' = o.tipocliente),false) as vendaconsumidorfina' +
        'l,'
      ''
      '       (select vf.contribicms'
      '       from vfornecedores vf'
      '       where vf.codigo = o.cliente'
      '        and vf.tipo = o.tipocliente) as contribicms,'
      ''
      '       cast('#39'55'#39' as varchar(2)) as modelodocto, '
      ''
      '       o.*'
      ''
      'from orcamentos o'
      ''
      'where o.codigo = :codigo')
    RequestLive = True
    Left = 464
    Top = 216
    ParamData = <
      item
        DataType = ftCurrency
        Name = 'DescontoFinanceiro'
        ParamType = ptUnknown
      end
      item
        DataType = ftCurrency
        Name = 'AcrescimoFinanceiro'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'valorvista'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'valorprazo'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'codigo'
        ParamType = ptUnknown
      end>
