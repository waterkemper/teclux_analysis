  object qryProdutosContratos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryProdutosContratosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        '    select (pc.quantidade * pc.precovenda) - coalesce(pc.valorde' +
        'scontoitem,0) as TotalItens,'
      
        '           coalesce((select custodavenda(pc.contrato, '#39'C'#39', pc.pr' +
        'oduto)),0) as TotalCusto,'
      ''
      '           /*'
      '           coalesce((select asn.aliquotaicms'
      '            from aliquotassimplesnacional asn'
      '            where asn.filial = ct.filialvenda'
      
        '              and asn.mesano = cast(to_char(ct.data, '#39'MM/YYYY'#39') ' +
        'as char(7))),0) as aliquotaicms_sn,'
      '           */'
      '           '
      
        '           cast(coalesce(replace(parametros_valor('#39'Al'#237'quota Simp' +
        'les Nacional'#39',ct.filialvenda),'#39','#39','#39'.'#39'),'#39'0'#39') as "numeric"(11,2)) ' +
        'as aliquotaicms_sn,'
      ''
      '           p.descricao,'
      '           c.unidade,'
      '           c.vendanegativa as vendasemestoque,'
      
        '           Selecionar_Aliquotaicms(:estadofilialbase, ct.estado,' +
        ' ct.pessoatipo, pc.produto) as aliquotaicms,'
      ''
      '           (select valor'
      '            from estadosicms'
      '            where estadosicms.estado = :estadofilialbase'
      
        '              and estadosicms.icms   = c.icms) as AliquotaICMSST' +
        ','
      '              '
      '           c.icms,'
      '           c.origem,'
      ''
      '           (select t.valor'
      '            from tributosicms t'
      '            where t.codigo = c.incidencia) as incidencia,'
      ''
      '           c.csosn,'
      '           c.montagem as montagemoriginal,'
      '           c.percreducaobase as percentualreducaobase,'
      '           c.predbcst,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           c.anvisa,'
      '           c.baseicms,'
      '           c.composto,'
      '           c.discriminarcomposto,'
      '           c.discriminarpreco,'
      '           c.producaopropria,'
      
        '          (select ol.descricao from obslegais ol where ol.codigo' +
        ' = c.obslegal) as obslegal,'
      '          c.icmsmodalidade,'
      '          c.icmsmodsubst,'
      '          c.piscst,'
      '          c.cofinscst,'
      '          c.ipicst,'
      '          c.aliquotapis as pisaliquota,'
      '          c.aliquotacofins as cofinsaliquota,'
      '          c.codigo_efd_t53,'
      
        '          (select ipi.genero from ipi where ipi.codigo = c.ipi) ' +
        'as genero,'
      
        '          (select ipi.extipi from ipi where ipi.codigo = c.ipi) ' +
        'as extipi,'
      '           pc.*,'
      '           p.codigovisual as produtovisual,'
      '          c.peso,'
      '          c.volumes,'
      '          pc.produto as produtooriginal,'
      '          pc.filial as filialoriginal,'
      '          pc.quantidade as QuantidadeOriginal,'
      '          c.cest,'
      '          cast(5102 as integer) as codigofiscal'
      ''
      
        '    from produtoscontratos pc, produtos p, caracteristicas c, co' +
        'ntratos ct'
      '    where (c.codigo = p.caracteristica)'
      '      and (p.codigo = pc.produto)'
      '      and (pc.contrato = ct.numero)'
      '      and (pc.contrato = :contrato)'
      '    Order By pc.numero')
    RequestLive = True
    Left = 576
    Top = 232
    ParamData = <
      item
        DataType = ftString
        Name = 'estadofilialbase'
        ParamType = ptUnknown
        Value = 'SC'
      end
      item
        DataType = ftString
        Name = 'contrato'
        ParamType = ptUnknown
        Value = '0'
      end>
