  object qryProdutosOrcamentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = True
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    OnCalcFields = qryProdutosOrcamentosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select *,'
      '       case when coalesce(TotalCusto,0.00)<>0.00 then'
      '         round((TotalVenda - TotalCusto)*100/TotalCusto,2)'
      '       else'
      '         cast(null as numeric(5,2)) end as percentualCusto,'
      ''
      '       (TotalVenda - TotalCusto) as VendaBruta,'
      ''
      
        '       (TotalVenda - TotalCusto - IcmsValor - IcmsValorST - PisV' +
        'alor - CofinsValor - ValorIPI) as MargemLucro,'
      ''
      '       case when coalesce(TotalVenda,0.00)<>0.00 then'
      
        '         ((TotalVenda - TotalCusto - IcmsValor - IcmsValorST - P' +
        'isValor - CofinsValor - ValorIPI) * 100) / TotalVenda'
      '       else'
      
        '         cast(null as numeric(5,2)) end as PercentualMargemLucro' +
        ','
      ''
      '       (TotalVenda * aliquotaicms_sn / 100) as impostossn,'
      ''
      
        '       (TotalVenda - TotalCusto) - (TotalVenda * aliquotaicms_sn' +
        ' / 100) as MargemLucrosn,'
      ''
      '       case when coalesce(TotalVenda,0.00)<>0.00 then'
      
        '         ((((TotalVenda - TotalCusto) - (TotalVenda * aliquotaic' +
        'ms_sn / 100)) * 100) / TotalVenda)'
      '       else'
      
        '         cast(null as numeric(5,2)) end as PercentualMargemLucro' +
        'sn'
      ''
      'from'
      '('
      '  select selecao.* ,'
      '         (TotalItens -'
      '          DescontoFinanceiro +'
      '          AcrescimoFinanceiro +'
      '          Frete +'
      '          Seguro +'
      '          ValorIPI +'
      '          IcmsValorST'
      '          ) as TotalVenda'
      '  from'
      ''
      '  ('
      '    select po.*, p.codigovisual as produtovisual, p.descricao,'
      ''
      
        '         (po.quantidade * po.precovenda) - coalesce(po.valordesc' +
        'ontoitem,0.00) as TotalItens,'
      ''
      '         0.00 as DescontoFinanceiro,'
      '         0.00 as AcrescimoFinanceiro,'
      '         0.00 as Frete,'
      '         0.00 as Seguro,'
      
        '         coalesce((select custodavenda(cast(po.orcamento as varc' +
        'har), '#39'O'#39', po.produto)),0.00) as TotalCusto,'
      ''
      '         0.00 as IcmsValor,'
      '         0.00 as IcmsValorST,'
      ''
      '         0.00 as PisValor,'
      '         0.00 as CofinsValor,'
      '         0.00 as cofinsbasecalculo,'
      ''
      '         0.00 as ValorIPI,'
      '         0.00 as desconto,'
      '         0.00 as acrescimo,'
      '         0.00 as despesasacessorias,'
      '         0.00 as ipioutras,'
      '         0.00 as ipiisentas,'
      '         0.00 as ipibasecalculo,'
      '         0.00 as icmsoutras,'
      '         0.00 as icmsisentas,'
      '         0.00 as reducaobase,'
      '         0.00 as icmsbasecalculo,'
      '         0.00 as vcredicmssn,'
      '         0.00 as pCredSN,'
      '         0.00 as fatorsubstituicao,'
      '         0.00 as reducaobasest,'
      '         0.00 as ICMSBaseCalculoST,'
      '         0.00 as pisbasecalculo,'
      '         0.00 as vBCSTRet,'
      '         0.00 as vICMSSTRet,'
      '         0.00 as PercReducaoMVA,'
      ''
      
        '         cast(coalesce(replace(parametros_valor('#39'Al'#237'quota Simple' +
        's Nacional'#39',o.filial),'#39','#39','#39'.'#39'),'#39'0'#39') as "numeric"(11,2)) as aliqu' +
        'otaicms_sn,'
      ''
      '         c.unidade,'
      '         c.vendanegativa as vendasemestoque,'
      
        '         Selecionar_Aliquotaicms(:estadofilialbase, o.estado, o.' +
        'pessoatipo, po.produto) as aliquotaicms,'
      ''
      '         (select valor'
      '          from estadosicms'
      '          where estadosicms.estado = :estadofilialbase'
      '            and estadosicms.icms   = c.icms) as AliquotaICMSST,'
      ''
      '         c.icms,'
      '         c.origem,'
      ''
      '         (select t.valor'
      '          from tributosicms t'
      '          where t.codigo = c.incidencia) as incidencia,'
      ''
      '         c.csosn,'
      '         c.montagem as montagemoriginal,'
      '         c.percreducaobase as percentualreducaobase,'
      '         c.predbcst,'
      '         c.anvisa,'
      '         c.baseicms,'
      '         c.composto,'
      '         c.discriminarcomposto,'
      '         c.discriminarpreco,'
      '         c.producaopropria,'
      
        '        (select ol.descricao from obslegais ol where ol.codigo =' +
        ' c.obslegal) as obslegal,'
      '        c.icmsmodalidade,'
      '        c.icmsmodsubst,'
      '        c.piscst,'
      '        c.cofinscst,'
      '        c.ipicst,'
      '        c.aliquotapis as pisaliquota,'
      '        c.aliquotacofins as cofinsaliquota,'
      '        c.codigo_efd_t53,'
      
        '        (select ipi.genero from ipi where ipi.codigo = c.ipi) as' +
        ' genero,'
      
        '        (select ipi.extipi from ipi where ipi.codigo = c.ipi) as' +
        ' extipi,'
      '        c.peso,'
      '        c.volumes,'
      '        c.cest,'
      
        '        coalesce((select ipi.aliquota from ipi where ipi.codigo ' +
        '= c.ipi),0.00) as aliquotaipi,'
      
        '        (select ipi.classificacaofiscal from ipi where ipi.codig' +
        'o = c.ipi) as classificacaofiscal,'
      '        cast(5102 as integer) as codigofiscal '
      ''
      '    from produtosorcamentos po'
      '         join orcamentos o'
      '         on po.orcamento = o.codigo'
      ''
      '         join produtos p'
      '              join caracteristicas c'
      '              on p.caracteristica = c.codigo'
      '         on p.codigo = po.produto'
      ''
      '    where po.orcamento = :orcamento'
      '  ) as selecao'
      ''
      ') as selecao'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      '')
    RequestLive = True
    Left = 544
    Top = 240
