    Sql.Strings = (
      'Select   sc.contrato,'
      '         sc.servico,'
      '         s.descricao as descricaoservico,'
      '         sc.quantidade,'
      '         sc.cancelado,'
      '         sc.aliquotaissqn,'
      '         sc.valorservico,'
      '         sc.complementoservico,'
      '         sc.equipamento,'
      '         sc.estado,'
      '         sc.cidade,'
      '         sc.reterissqn,'
      '         sc.valorissqn,'
      '         s.piscst,'
      '         s.pisaliquota as aliquotapis,'
      '         s.cofinscst,'
      '         s.cofinsaliquota as aliquotacofins,'
      '         S.codigolcp116,'
      '         s.cnae,'
      '         s.cstissqn,'
      '         (sc.quantidade * sc.valorservico) as TotalItens,'
      ''
      '         0.00 as pisbasecalculo,'
      '         0.00 as PisValor,'
      '         0.00 as cofinsbasecalculo,'
      '         0.00 as CofinsValor,'
      ''
      '       /*'
      '         coalesce((select asn.aliquotaicms'
      '          from aliquotassimplesnacional asn'
      '          where asn.filial = ct.filialvenda'
      
        '            and asn.mesano = cast(to_char(ct.data, '#39'MM/YYYY'#39') as' +
        ' char(7))),0) as aliquotaicms_sn'
      '        */'
      ''
      
        '        cast(coalesce(replace(parametros_valor('#39'Al'#237'quota Simples' +
        ' Nacional'#39',ct.filialvenda),'#39','#39','#39'.'#39'),'#39'0'#39') as "numeric"(11,2)) as ' +
        'aliquotaicms_sn'
      ''
      ''
      'From  servicoscontratos sc'
      '      join servicos s'
      '      on sc.servico = s.codigo'
      ''
      '      join contratos ct'
      '      on sc.contrato = ct.numero'
      '      '
      'Where  (sc.servico = s.codigo) and'
      '       (sc.contrato = :contrato)')
