  object qryServicos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select servico,'
      '       DescricaoServico,'
      '       TotalItens,'
      '       valorissqn,'
      '       PisValor,'
      '       CofinsValor,'
      ''
      '       TotalItens -'
      '       valorissqn -'
      '       PisValor -'
      '       CofinsValor as MargemLucro,'
      ''
      
        '      ((TotalItens - valorissqn - PisValor - CofinsValor) * 100)' +
        ' / TotalItens as PercentualMargemLucro,'
      ''
      '      (TotalItens * aliquotaicms_sn / 100) as impostossn,'
      ''
      
        '      (TotalItens - (TotalItens * aliquotaicms_sn / 100)) as Mar' +
        'gemLucrosn,'
      #9'   '
      
        '      (((TotalItens - (TotalItens * aliquotaicms_sn / 100)) * 10' +
        '0) / TotalItens) as PercentualMargemLucrosn'
      ''
      ''
      'from'
      ''
      '('
      '  select sc.servico,'
      '         s.descricao as descricaoservico,'
      '       (sc.quantidade * sc.valorservico) as TotalItens,'
      '       '
      '       coalesce(sc.valorissqn,0) as valorissqn,'
      ''
      
        '       (sc.quantidade * sc.valorservico) * coalesce(s.pisaliquot' +
        'a,0) / 100 as PisValor,'
      
        '       (sc.quantidade * sc.valorservico) * coalesce(s.cofinsaliq' +
        'uota,0) / 100 as CofinsValor,'
      ''
      '         coalesce((select asn.aliquotaicms'
      '          from aliquotassimplesnacional asn'
      '          where asn.filial = ct.filialvenda'
      
        '            and asn.mesano = cast(to_char(ct.data, '#39'MM/YYYY'#39') as' +
        ' char(7))),0) as aliquotaicms_sn'
      ''
      ''
      
        '  from servicoscontratos sc join contratos ct on sc.contrato = c' +
        't.numero'
      '       join servicos s on sc.servico = s.codigo'
      '  where sc.contrato = :contrato'
      ''
      ') as selecao')
    RequestLive = False
    Left = 144
    Top = 336
    ParamData = <
