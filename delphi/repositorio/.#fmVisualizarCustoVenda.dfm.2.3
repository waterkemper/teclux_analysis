    Sql.Strings = (
      'select'
      
        '       (select sum((pc.quantidade * pc.precovenda) - coalesce(pc' +
        '.valordescontoitem,0))'
      #9'    from produtoscontratos pc'
      #9#9'where pc.contrato =  o.numero) as TotalItens,'
      ''
      '       (select sum((sc.quantidade * sc.valorservico))'
      #9'    from servicoscontratos sc'
      #9#9'where sc.contrato =  o.numero) as TotalServico,'
      #9#9
      '       (select sum(pc.desconto)'
      #9'    from produtoscontratos pc'
      #9#9'where pc.contrato =  o.numero) as DescontoFinanceiro,'
      #9#9
      '       (select sum(pc.acrescimo)'
      #9'    from produtoscontratos pc'
      #9#9'where pc.contrato =  o.numero) as AcrescimoFinanceiro,'
      #9#9
      '       (select sum(pc.frete)'
      #9'    from produtoscontratos pc'
      #9#9'where pc.contrato =  o.numero) as Frete,'
      #9#9
      '       (select sum(pc.seguro)'
      #9'    from produtoscontratos pc'
      #9#9'where pc.contrato =  o.numero) as seguro,'
      ''
      '       (select sum(custodavenda(pc.contrato, '#39'C'#39', pc.produto))'
      #9'    from produtoscontratos pc'
      '        where pc.contrato = o.numero) as TotalCusto,'
      ''
      '       (select sum(pc.icmsvalor)'
      #9'    from produtoscontratos pc'
      #9#9'where pc.contrato =  o.numero) as ICMSValor,'
      ''
      '       (select sum(pc.icmsvalorst)'
      #9'    from produtoscontratos pc'
      #9#9'where pc.contrato =  o.numero) as ICMSValorst,'
      ''
      '       (select sum(pc.pisvalor)'
      #9'    from produtoscontratos pc'
      #9#9'where pc.contrato =  o.numero) as pisvalorprodutos,'
      ''
      '    (select sum(pc.cofinsvalor)'
      #9'    from produtoscontratos pc'
      #9#9'where pc.contrato =  o.numero) as cofinsvalorprodutos,'
      ''
      '    (select sum(sc.valorissqn)'
      '     from servicoscontratos sc'
      '     where sc.contrato = o.numero) as valorissqn,'
      ''
      
        '    (select sum((sc.quantidade * sc.valorservico) * coalesce(s.p' +
        'isaliquota,0) / 100 )'
      
        '     from servicoscontratos sc join servicos s on sc.servico = s' +
        '.codigo'
      '     where sc.contrato = o.numero) as PisValorServicos,'
      ''
      
        '    (select sum((sc.quantidade * sc.valorservico) * coalesce(s.c' +
        'ofinsaliquota,0) / 100 )'
      
        '     from servicoscontratos sc join servicos s on sc.servico = s' +
        '.codigo'
      '     where sc.contrato = o.numero) as CofinsValorServicos,'
      ''
      '   (select sum(pc.ValorIPI)'
      #9'    from produtoscontratos pc'
      #9#9'where pc.contrato =  o.numero) as ValorIPI,'
      ''
      '   coalesce((select asn.aliquotaicms'
      '    from aliquotassimplesnacional asn'
      '    where asn.filial = o.filialvenda'
      
        '      and asn.mesano = cast(to_char(o.data, '#39'MM/YYYY'#39') as char(7' +
        '))),0) as aliquotaicms_sn ,'
      ''
      
        '   (select sum(pc.valoripi) from produtoscontratos pc where pc.c' +
        'ontrato = o.numero) as TotalIPI,'
      '   '
      '   o.valoricmssubstituicao,'
      '   o.impostoretido'
      #9#9
      'from orcamentos o'
      'where o.numero = :contrato')
