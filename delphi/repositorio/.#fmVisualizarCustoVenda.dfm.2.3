  object qryProdutosOrcamentos: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select *,'
      
        '       round((TotalVenda - TotalCusto)*100/TotalCusto,2) as perc' +
        'entualCusto,'
      ''
      '       (TotalVenda - TotalCusto) as VendaBruta,'
      ''
      
        '       (TotalVenda - TotalCusto - IcmsValor - IcmsValorST - PisV' +
        'alor - CofinsValor - ValorIPI) as MargemLucro,'
      ''
      
        '       ((TotalVenda - TotalCusto - IcmsValor - IcmsValorST - Pis' +
        'Valor - CofinsValor - ValorIPI) * 100) / TotalVenda as Percentua' +
        'lMargemLucro,'
      ''
      '       (TotalVenda * aliquotaicms_sn / 100) as impostossn,'
      ''
      
        '       (TotalVenda - TotalCusto) - (TotalVenda * aliquotaicms_sn' +
        ' / 100) as MargemLucrosn,'
      
        '       ((((TotalVenda - TotalCusto) - (TotalVenda * aliquotaicms' +
        '_sn / 100)) * 100) / TotalVenda) as PercentualMargemLucrosn'
      ''
      'from'
      '('
      '  select produto,'
      
        '         (select p.descricao from produtos p where p.codigo = se' +
        'lecao.produto) as DescricaoProduto,'
      '         TotalItens,'
      '         DescontoFinanceiro,'
      '         AcrescimoFinanceiro,'
      '         Frete,'
      '         Seguro,'
      ''
      '         (TotalItens -'
      '          DescontoFinanceiro +'
      '          AcrescimoFinanceiro +'
      '          Frete +'
      '          Seguro +'
      '          ValorIPI +'
      '          IcmsValorST'
      '          ) as TotalVenda,'
      ''
      '         TotalCusto,'
      ''
      '         IcmsValor,'
      ''
      '         IcmsValorST,'
      ''
      '         PisValor,'
      '         CofinsValor,'
      ''
      '         ValorIPI,'
      ''
      '         aliquotaicms_sn'
      ''
      '  from'
      ''
      '  ('
      '    select pc.produto,'
      ''
      
        '         (pc.quantidade * pc.precovenda) - coalesce(pc.valordesc' +
        'ontoitem,0) as TotalItens,'
      ''
      '         coalesce(pc.desconto,0) as DescontoFinanceiro,'
      '         coalesce(pc.acrescimo,0) as AcrescimoFinanceiro,'
      '         coalesce(pc.frete,0) as Frete,'
      '         coalesce(pc.frete,0) as Seguro,'
      
        '         coalesce((select custodavenda(pc.contrato, '#39'C'#39', pc.prod' +
        'uto)),0) as TotalCusto,'
      ''
      '         coalesce(pc.icmsvalor,0) as IcmsValor,'
      '         coalesce(pc.icmsvalorst,0) as IcmsValorST,'
      ''
      '         coalesce(pc.pisvalor,0) as PisValor,'
      '         coalesce(pc.cofinsvalor,0) as CofinsValor,'
      ''
      '         coalesce(pc.valoripi,0) as ValorIPI,'
      ''
      '         coalesce((select asn.aliquotaicms'
      '          from aliquotassimplesnacional asn'
      '          where asn.filial = ct.filialvenda'
      
        '            and asn.mesano = cast(to_char(ct.data, '#39'MM/YYYY'#39') as' +
        ' char(7))),0) as aliquotaicms_sn'
      ''
      
        '    from produtoscontratos pc join contratos ct on pc.contrato =' +
        ' ct.numero'
      '    where pc.contrato = :contrato'
      '  ) as selecao'
      ''
      ') as selecao')
    RequestLive = False
