var
  frmVisualizarCustoVenda: TfrmVisualizarCustoVenda;
  AcionarTelaVisualizarCustoVenda: procedure (Owner: TComponent; Documento: TTecStringRetorno; Tipo: TTecStringRetorno );


implementation

{$R *.dfm}

procedure AcionarTelaVisualizarCustoVenda_(Owner: TComponent; Documento: TTecStringRetorno; Tipo: TTecStringRetorno);
var
  UsrAut: TtecUsuarios;
begin
  UsrAut :=  TdtmBasico.ObterAutorizacao(taLOGIN, 'VISUALIZAR CUSTOS', 'Gerente de Vendas', '');
  if Assigned(UsrAut) and Not UsrAut.GerenteVendas then
    MensagemAviso(ctUSUARIOSEMPERMISSAO)
  else
  begin
    if not assigned(frmVisualizarCustoVenda) or (frmVisualizarCustoVenda.Owner <> Owner) then
    begin
      if assigned(frmVisualizarCustoVenda) then
        frmVisualizarCustoVenda.free;

      frmVisualizarCustoVenda := TfrmVisualizarCustoVenda.create(Owner);

      frmVisualizarCustoVenda.qryProdutos.parambyname('contrato').asString := Documento;
      frmVisualizarCustoVenda.qryProdutos.close;
      frmVisualizarCustoVenda.qryProdutos.open;

      frmVisualizarCustoVenda.qryServicos.parambyname('contrato').asString := Documento;
      frmVisualizarCustoVenda.qryServicos.close;
      frmVisualizarCustoVenda.qryServicos.open;

      frmVisualizarCustoVenda.qryContrato.parambyname('contrato').asString := Documento;
      frmVisualizarCustoVenda.qryContrato.close;
      frmVisualizarCustoVenda.qryContrato.open;


      frmVisualizarCustoVenda.showmodal;
    end;
    frmVisualizarCustoVenda.Free;
  end;

end;


destructor TfrmVisualizarCustoVenda.Destroy;
begin
  frmVisualizarCustoVenda := nil;
  inherited;
end;

procedure TfrmVisualizarCustoVenda.qryContratoCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryContratoTotalProdutos.asCurrency := qryContratototalitens.asCurrency -
                                         qryContratodescontofinanceiro.asCurrency +
                                         qryContratoacrescimofinanceiro.asCurrency +
                                         qryContratofrete.asCurrency +
                                         qryContratoseguro.asCurrency +
                                         qryContratototalipi.asCurrency +
                                         qryContratovaloricmssubstituicao.asCurrency;


  qryContratoLiquidoServicos.asCurrency := qryContratototalservico.asCurrency - qryContratoimpostoretido.asCurrency;

  qryContratoTotalVenda.asCurrency :=  qryContratoTotalProdutos.asCurrency +
                                       qryContratoLiquidoServicos.asCurrency;

  qryContratoPercentualTotalCusto.ascurrency := (qryContratototalcusto.asCurrency * 100) / qryContratoTotalProdutos.asCurrency;
  qryContratoMargemBruta.asCurrency :=  qryContratoTotalProdutos.asCurrency - qryContratototalcusto.asCurrency;


  qryContratoMargemBrutaTotal.asCurrency := qryContratoMargemBruta.asCurrency +  qryContratoLiquidoServicos.asCurrency;

  qryContratoPisValor.asCurrency := qryContratoPisValorProdutos.asCurrency + qryContratopisvalorservicos.asCurrency;

  qryContratoCofinsValor.asCurrency := qryContratoCofinsValorProdutos.asCurrency + qryContratoCofinsValorSErvicos.asCurrency;

  qryContratoSomaMargemLucro.asCurrency := qryContratoMargemBrutaTotal.asCurrency -
                                           qryContratoicmsvalor.ascurrency -  {ver quando}
                                           qryContratoPisValor.asCurrency -
                                           qryContratoCofinsValor.asCurrency -
                                           qryContratovalorissqn.asCurrency;

  qryContratoPercentualMargemLucro.asCurrency := qryContratoSomaMargemLucro.asCurrency * 100 / qryContratoMargemBrutaTotal.asCurrency;

  qryContratoSomaMargemLucroProdutos.asCurrency := qryContratoMargemBruta.asCurrency -
                                           qryContratoicmsvalor.ascurrency -
                                           qryContratoicmsvalorst.ascurrency -
                                           qryContratopisvalorprodutos.asCurrency -
                                           qryContratocofinsvalorprodutos.asCurrency -
                                           qryContratovaloripi.asCurrency;

  qryContratoPercentualMargemLucroProdutos.asCurrency :=  qryContratoSomaMargemLucroProdutos.asCurrency * 100 / qryContratoMargemBruta.asCurrency;

  qryContratoSomaMargemLucroServicos.asCurrency := qryContratoLiquidoServicos.asCurrency -
                                                   qryContratopisvalorservicos.asCurrency -
                                                   qryContratoCofinsValorSErvicos.asCurrency -
                                                   qryContratovalorissqn.asCurrency;

  qryContratoPercentualMargemLucroServicos.asCurrency := qryContratoSomaMargemLucroServicos.asCurrency * 100 / qryContratoLiquidoServicos.asCurrency;

  qryContratoSNProdutos.asCurrency := ((qryContratoTotalProdutos.asCurrency * qryContratoaliquotaicms_sn.asCurrency) / 100);
  qryContratoSNServicos.asCurrency := ((qryContratoTotalServico.asCurrency * qryContratoaliquotaicms_sn.asCurrency) / 100);

  qryContratoSomaMargemLucroSN.asCurrency :=  qryContratoMargemBrutaTotal.asCurrency -
                                              qryContratoSNProdutos.asCurrency -
                                              qryContratoSNServicos.asCurrency;

  qryContratoPercentualMargemLucroSN.asCurrency := qryContratoSomaMargemLucroSN.asCurrency * 100 / qryContratoMargemBrutaTotal.asCurrency;

  qryContratoSomaMargemLucroSNProdutos.asCurrency := qryContratoMargemBruta.asCurrency - qryContratoSNProdutos.asCurrency;

  qryContratoPercentualMargemLucroSNProdutos.asCurrency :=  qryContratoSomaMargemLucroSNProdutos.asCurrency * 100 / qryContratoMargemBruta.asCurrency;

  qryContratoSomaMargemLucroSNServicos.asCurrency :=  qryContratototalservico.asCurrency - qryContratoSNServicos.asCurrency;

  qryContratoPercentualMargemLucroSNServicos.asCurrency := qryContratoSomaMargemLucroSNServicos.asCurrency * 100 / qryContratototalservico.asCurrency;






end;

initialization
   AcionarTelaVisualizarCustoVenda :=  AcionarTelaVisualizarCustoVenda_;


