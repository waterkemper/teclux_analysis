unit fmajuda;

interface

uses
  //CLX
  SysUtils, Classes, Graphics, Controls, Forms, Dialogs, Windows, 
  //Repositorio
  fmhelpviewer, dmbasico, biblio, cpdbfindcontrols, ctconstantes;

type
  TfrmAjudaClass = class of TfrmAjuda;
  TfrmAjuda = class(TForm)
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    function FormHelp(HelpType: THelpType; HelpContext: THelpContext;
      const HelpKeyword, HelpFile: String; var Handled: Boolean): Boolean;
    procedure FormShow(Sender: TObject);
    procedure FormMouseDown(Sender: TObject; Button: TMouseButton;
      Shift: TShiftState; X, Y: Integer);
  private
    FFormOrigemBloqueio: String;
  protected
    procedure CriarDataModulo; virtual;
    procedure DestruirDataModulo; virtual;
    procedure KeyDown(var Key: Word; Shift: TShiftState); override;
    procedure MouseDown(Button: TMouseButton; Shift: TShiftState;
      X, Y: Integer); override;

    function VerificarComponentesdePesquisa: boolean;


  public
    constructor Create(AOwner: TComponent); override;
    destructor  Destroy; override;
//    function  FormRegistrado(NomeForm: String): TfrmAjudaClass; virtual;
    procedure OperacaoPadrao(Value: Array of Variant); virtual;
    class function Referencia: TForm; virtual;
    procedure MostraContextoAjuda;
    procedure BloquearFormularios(FormNaoBloquear: String);
    procedure DesbloquearFormularios;
    property FormOrigemBloqueio: String read FFormOrigemBloqueio write FFormOrigemBloqueio;


  end;

implementation

{$R *.dfm}

type
  TtecApplication = class(TApplication);

{ TfrmAjuda }

constructor TfrmAjuda.Create(AOwner: TComponent);
begin
//try
  CriarDataModulo;
  inherited;
  if (WindowState = wsNormal) and (Not (csDesigning in ComponentState)) and (Self.Tag = 0) then
    Dimensionar(Self, poMainFormCenter);

    {except
     on E: Exception do ShowMessage(E.Message);
end; }


end;

procedure TfrmAjuda.CriarDataModulo;
begin
end;

destructor TfrmAjuda.Destroy;
var
  Par: TForm;
begin

  if self.FormStyle <>  fsNormal then
    IF SELF.TAG = 1000 THEN
       DestruirFormulario(self);   {estava travando no momento da alteração do valor de um calculo de financiamento via contrato}


  if Screen.FormCount > 1 then
    Par := Screen.Forms[1];
    {
  else
    Par := nil;}


  DestruirDataModulo;

  inherited destroy;

  if Assigned(Par) and (Par.FormStyle = fsMDIChild) and Par.CanFocus then
//    Par.SetFocus
  else
  if Assigned(Application.MainForm) then
    Application.MainForm.SetFocus;
end;

procedure TfrmAjuda.DestruirDataModulo;
begin
end;

procedure TfrmAjuda.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  inherited;
  if Not (fsModal in FormState) then
    Action := caFree
end;

function TfrmAjuda.FormHelp(HelpType: THelpType; HelpContext: THelpContext;
  const HelpKeyword, HelpFile: String; var Handled: Boolean): Boolean;
begin
  Result := True;
  Handled := True;
  if Assigned(ActiveControl) then
    if Trim(ActiveControl.HelpKeyword) <> '' then
      Exit
    else
      ActiveControl.HelpKeyword := GetArquivoAjuda
{
  else
    Application.KeywordHelp(GetArquivoAjuda);
    }
end;
{
function TfrmAjuda.FormRegistrado(NomeForm: String): TfrmAjudaClass;
var
  Pers: TPersistentClass;
begin
  Pers := ActivateClassGroup(TControl);
  Result := TfrmAjudaClass(GetClass(NomeForm));
  ActivateClassGroup(Pers);
end;
 }
procedure TfrmAjuda.MostraContextoAjuda;
begin
{
  RegisterHelpViewer;
  if HelpKeyword <> '' then
       Application.KeywordHelp(HelpKeyword)
  else Application.HelpFile:= ExtractFilePath(Application.ExeName) + 'teclux.html';
  }
end;

procedure TfrmAjuda.OperacaoPadrao(Value: Array of Variant);
begin
end;

class function TfrmAjuda.Referencia: TForm;
var
  cnt: Integer;
begin
  Result := nil;
  for cnt := 0 to Screen.FormCount - 1 do
    if Screen.Forms[cnt].ClassName = ClassName then begin
      Result := Screen.Forms[cnt];
      Break;
    end;
end;

procedure TfrmAjuda.FormShow(Sender: TObject);
begin
   // // // // // QWidget_setActiveWindow(Handle);
end;

procedure TfrmAjuda.BloquearFormularios(FormNaoBloquear: String);
var
  cnt: Integer;
  form : Tform;
begin
  for cnt := 0 to Screen.FormCount - 1 do
  begin
    form := Screen.Forms[cnt];
    if (form.Name <> 'frmAjuda') and
       (form.Name <> 'frmCadastroPadrao') and
       (form.Name <> 'frmAjudaBt') and
       (form.Name <> 'frmNavControles') and
       (form.Name <> 'frmTecsoft') and
       (form.Name <> FormNaoBloquear) then
      form.Enabled := false
  end;
end;

procedure TfrmAjuda.DesbloquearFormularios;
var
  cnt: Integer;
begin
  for cnt := 0 to Screen.FormCount - 1 do
  begin
    Screen.Forms[cnt].Enabled := true;
    if Screen.Forms[cnt].name = FormOrigemBloqueio then
      Screen.Forms[cnt].SetFocus;
  end;
end;

procedure TfrmAjuda.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  Case Key of
    VK_INSERT :
    begin
      if InsertLigado then
        InsertLigado := false
      else
        InsertLigado := true;
    end;
  end;

end;

procedure TfrmAjuda.MouseDown(Button: TMouseButton; Shift: TShiftState; X,
  Y: Integer);
begin
  inherited;

end;

function TfrmAjuda.VerificarComponentesdePesquisa: boolean;
var
  a: integer;
begin
  result := true;
  for a:= ComponentCount - 1 downto 0 do
    if (Components[a] is TtecFindCustom)  then
    begin
      if (TtecFindCustom(Components[a]).text<>'') {and
         not TtecFindCustom(Components[a]).ActiveSetControls} then
      begin
        result := TtecFindCustom(Components[a]).Exist;
        if not result then
          break;
        self.refresh;
      end;
    end
end;

procedure TfrmAjuda.FormMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
begin
;
end;

end.
