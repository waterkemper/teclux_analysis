procedure TfrmAjuda.SalvarConfiguracoesFormulario(objetivo: String);
var
 inifile: TInifile;
{ v_NomeArquivoIni: TIniFile;}
 v_NomeArquivoIni {, v_NomeArquivoIniDBGrid}: TMemIniFile;
 vConteudo : TStringList;
 i, j, k, l: integer;
 v_NomeArquivo, v_NomeArquivoDBGrid, vSecao : String;
 qryParametrosFormularios: TtecQuery;
 v_strFile : TFileStream;
// v_stream :  TStream;
// v_FileStream : TFileStream;
// v_memStream : TMemoryStream;

  function CriarNomeArquivo: Boolean;
  begin
    result := true;

    v_NomeArquivo := ExtractFilePath(Application.ExeName) + 'PARAMETROS';

    if not DirectoryExists(v_NomeArquivo) then
      if not CreateDir(v_NomeArquivo) then
      begin
        result := false;
        raise Exception.Create('Impossível criar o diretório '+v_NomeArquivo);
        exit;
      end;

    v_NomeArquivo := v_NomeArquivo + '\' + UsuarioLogin.LoginUsuario;

    if not DirectoryExists(v_NomeArquivo) then
      if not CreateDir(v_NomeArquivo) then
      begin
        result := false;
        raise Exception.Create('Impossível criar o diretório '+v_NomeArquivo);
        exit
      end;

    v_NomeArquivo := v_NomeArquivo + '\' + self.Name + '.ini';

  end;

begin
  if SalvarPropriedadesFormulario then
  begin

  {
    v_NomeArquivo := ExtractFilePath(Application.ExeName) + 'PARAMETROS';

    if not DirectoryExists(v_NomeArquivo) then
      if not CreateDir(v_NomeArquivo) then
        raise Exception.Create('Impossível criar o diretório '+v_NomeArquivo);

    v_NomeArquivo := v_NomeArquivo + '\' + UsuarioLogin.LoginUsuario;

    if not DirectoryExists(v_NomeArquivo) then
      if not CreateDir(v_NomeArquivo) then
        raise Exception.Create('Impossível criar o diretório '+v_NomeArquivo);

    v_NomeArquivo := v_NomeArquivo + '\' + self.Name + '.ini';
}

    CriarNomeArquivo;

    if FileExists(v_NomeArquivo) then
      DeleteFile(pchar(v_NomeArquivo));

{    v_NomeArquivoIni := TIniFile.Create(v_NomeArquivo);}
    v_NomeArquivoIni :=TMemIniFile.Create(v_NomeArquivo);


    for i := 0 to self.ComponentCount -1 do
    begin
      if Components[i].tag <> -1 then
      begin
        if (Components[i] is TtecPageControl) then
        begin
          v_NomeArquivoIni.EraseSection(self.Components[i].Name);
          v_NomeArquivoIni.WriteInteger(self.Components[i].Name, 'TabIndex', TtecPageControl(self.Components[i]).TabIndex);
        end
        else
        if (Components[i] is TAdvSpinEdit) then
        begin
          v_NomeArquivoIni.EraseSection(self.Components[i].Name);
          v_NomeArquivoIni.WriteInteger(self.Components[i].Name, 'Value', TAdvSpinEdit(self.Components[i]).value);
        end
        else
        if (Components[i] is TStaticText) then
        begin
          v_NomeArquivoIni.EraseSection(self.Components[i].Name);
          v_NomeArquivoIni.WriteString(self.Components[i].Name, 'Caption',TStaticText(self.Components[i]).Caption);
        end
        else
        if (Components[i] is TCheckBox) then
        begin
          v_NomeArquivoIni.EraseSection(self.Components[i].Name);
          v_NomeArquivoIni.WriteBool(self.Components[i].Name, 'Checked', TCheckBox(self.Components[i]).Checked);
        end
        else
        if (Components[i] is TtecRadioButton) then
        begin
          v_NomeArquivoIni.EraseSection(self.Components[i].Name);
          v_NomeArquivoIni.WriteBool(self.Components[i].Name, 'Checked', TtecRadioButton(self.Components[i]).Checked);
        end
        else
        if (Components[i] is TEditData) then
        begin
          v_NomeArquivoIni.EraseSection(self.Components[i].Name);
          v_NomeArquivoIni.WriteString(self.Components[i].Name, 'Text', TEditData(self.Components[i]).text);
        end
        else
        if (Components[i] is TEditNumero) and not TEditNumero(Components[i]).ReadOnly  then
        begin
          v_NomeArquivoIni.EraseSection(self.Components[i].Name);
          v_NomeArquivoIni.WriteString(self.Components[i].Name, 'Text', TEditNumero(self.Components[i]).Text);
        end
        else
        if (Components[i] is TtecDbEditFind) then
        begin
          if TtecDbEditFind(self.Components[i]).tag = 0 then
          begin
            v_NomeArquivoIni.EraseSection(self.Components[i].Name);
            v_NomeArquivoIni.WriteString(self.Components[i].Name, 'Text', TtecDbEditFind(self.Components[i]).Text);
          end;
        end
        else
        if (Components[i] is TtecDbFindLookup) then
        begin
          if TtecDbFindLookup(self.Components[i]).tag = 0 then
          begin
            v_NomeArquivoIni.EraseSection(self.Components[i].Name);
            v_NomeArquivoIni.WriteString(self.Components[i].Name, 'Text', TtecDbFindLookup(self.Components[i]).Text);
          end;  
        end
        else
        if (Components[i] is TRadioGroup) then
        begin
          v_NomeArquivoIni.EraseSection(self.Components[i].Name);
          v_NomeArquivoIni.WriteInteger(self.Components[i].Name, 'ItemIndex',TRadioGroup(self.Components[i]).ItemIndex);
        end
        else
        if (Components[i] is TCheckListBox) then
        begin
          for j := 0 to TCheckListBox(Components[i]).items.Count -1 do
          begin
            v_NomeArquivoIni.EraseSection(self.Components[i].Name+'_'+inttostr(j));
            v_NomeArquivoIni.WriteBool(self.Components[i].Name+'_'+inttostr(j), 'Checked', TCheckListBox(self.Components[i]).Checked[j]);
          end;
        end
        else
        if (Components[i] is TfraListaFiliais) or
           (Components[i] is TfraListaGruposFiliais) then
        begin
          for j := 0 to TfraListaFiliais(Components[i]).componentcount -1 do
          begin
            if (TfraListaFiliais(Components[i]).components[j] is TCheckListBox) then
            begin
              for k := 0 to TCheckListBox(TfraListaFiliais(Components[i]).components[j]).items.Count -1 do
              begin
                v_NomeArquivoIni.EraseSection(self.Components[i].Name+'_'+inttostr(j)+'_'+TfraListaFiliais(Components[i]).components[j].name+'_'+inttostr(k));
                v_NomeArquivoIni.WriteBool(self.Components[i].Name+'_'+inttostr(j)+'_'+TfraListaFiliais(Components[i]).components[j].name+'_'+inttostr(k), 'Checked',
                    TCheckListBox(TfraListaFiliais(Components[i]).components[j]).checked[k]);
              end;
            end;
          end;
        end
        else
        if (Components[i] is TFraOrdenacao_cr) then
        begin
          TFraOrdenacao_cr(Components[i]).qryLista.first;
          while not TFraOrdenacao_cr(Components[i]).qryLista.Eof do
          begin
            for j := 0 to TFraOrdenacao_cr(Components[i]).qryLista.FieldCount -1 do
            begin

              v_NomeArquivoIni.EraseSection(self.Components[i].Name + '_' +
              TFraOrdenacao_cr(Components[i]).qryLista.fieldbyname('campo').asString + '_' +
              TFraOrdenacao_cr(Components[i]).qryLista.fields[j].fieldname);

              if TFraOrdenacao_cr(Components[i]).qryLista.fields[j].datatype = ftBoolean then
                v_NomeArquivoIni.WriteBool(self.Components[i].Name + '_' +
                TFraOrdenacao_cr(Components[i]).qryLista.fieldbyname('campo').asString + '_' +
                TFraOrdenacao_cr(Components[i]).qryLista.fields[j].fieldname,

                'Valor do Campo',

                TFraOrdenacao_cr(Components[i]).qryLista.fields[j].asboolean  )
              else
                v_NomeArquivoIni.WriteString(self.Components[i].Name + '_' +
                TFraOrdenacao_cr(Components[i]).qryLista.fieldbyname('campo').asString + '_' +
                TFraOrdenacao_cr(Components[i]).qryLista.fields[j].fieldname,

                'Valor do Campo',

                TFraOrdenacao_cr(Components[i]).qryLista.fields[j].asString  );

            end;
            TFraOrdenacao_cr(Components[i]).qryLista.next;
          end
        end
        else
        {Verificar a possibilidade de recursividade em relação a outros componentes pois o frame no form é somente um objeto,
         detalhes dentro do frame não participam da verificação acima}
        if (Components[i] is TfraMultiplaSelecaoAleatoria) then
        begin
          for k := 0 to TfraMultiplaSelecaoAleatoria(Components[i]).ComponentCount -1 do
          begin
            if (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is tfraSelecaoAleatoriaItemdeProdutos) or
               (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is  TfraSelecaoAleatoriaprodutos) or
               (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is  tfraSelecaoaleatoriagruposprodutos) or
               (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is  tfraSelecaoaleatoriaclassesprodutos) or
               (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is  tfraSelecaoAleatoriamarcasProdutos) or
               (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is  tfraSelecaoAleatoriaPromocoes) then
            begin
              for l := 0 to TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].ComponentCount -1 do
              begin
                if (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l] is tfraSelecaoAleatoria) then
                begin

                  TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.first;
                  while not TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.Eof do
                  begin
                    vSecao :=  TfraMultiplaSelecaoAleatoria(Components[i]).Name + '_' + TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Name + '_' +
                      inttostr(TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.recno);

                    v_NomeArquivoIni.EraseSection(vSecao);

                    for j := 0 to TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.FieldCount -1 do
                    begin
                      if TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.fields[j].datatype = ftBoolean then
                        v_NomeArquivoIni.WriteBool(vSecao,
                        TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.fields[j].fieldname,
                        TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.fields[j].asboolean  )
                      else
                        v_NomeArquivoIni.WriteString(vSecao,
                        TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.fields[j].fieldname,
                        TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.fields[j].asString  );

                    end;

                    TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.next;
                  end;
                end;
              end;
            end;
          end;
        end
        else
        if (Components[i] is TfraSelecaoAleatoriaClientes) or
           (Components[i] is TfraSelecaoaleatoriatiporecebimento) or
           (Components[i] is TfraSelecaoaleatoriaplanorecebimento) or
           (Components[i] is TfraSelecaoaleatoriagruposfornecedores) or
           (Components[i] is TfraSelecaoaleatorialistaspadronizadas) or
           (Components[i] is TfraSelecaoaleatoriavendedores) then

        begin
          for j := 0 to Components[i].ComponentCount -1 do
          begin
            if Components[i].components[j] is tfraSelecaoAleatoria then
            begin

              TFraSelecaoAleatoria(Components[i].Components[j]).qrySelecaoAleatoria.first;
              while not TFraSelecaoAleatoria(Components[i].Components[j]).qrySelecaoAleatoria.Eof do
              begin
                vSecao :=  Components[i].Name + '_' + Components[i].Components[j].Name + '_' +
                  inttostr(TFraSelecaoAleatoria(Components[i].Components[j]).qrySelecaoAleatoria.recno);

                v_NomeArquivoIni.EraseSection(vSecao);

                for l := 0 to TFraSelecaoAleatoria(Components[i].Components[j]).qrySelecaoAleatoria.FieldCount -1 do
                begin
                  if TFraSelecaoAleatoria(Components[i].Components[j]).qrySelecaoAleatoria.fields[l].datatype = ftBoolean then
                    v_NomeArquivoIni.WriteBool(vSecao,
                    TFraSelecaoAleatoria(Components[i].Components[j]).qrySelecaoAleatoria.fields[l].fieldname,
                    TFraSelecaoAleatoria(Components[i].Components[j]).qrySelecaoAleatoria.fields[l].asboolean  )
                  else
                    v_NomeArquivoIni.WriteString(vSecao,
                    TFraSelecaoAleatoria(Components[i].Components[j]).qrySelecaoAleatoria.fields[l].fieldname,
                    TFraSelecaoAleatoria(Components[i].Components[j]).qrySelecaoAleatoria.fields[l].asString);
                end;

                TFraSelecaoAleatoria(Components[i].Components[j]).qrySelecaoAleatoria.next;
              end;
            end;
          end;
        end
        else
        if (Components[i] is TfraConsultaCodigo) then
        begin
          if TfraConsultaCodigo(self.Components[i]).edfCodigo.tag = 0 then
          begin
            v_NomeArquivoIni.EraseSection(self.Components[i].Name);
            v_NomeArquivoIni.WriteString(self.Components[i].Name, 'edfCodigo.text', TfraConsultaCodigo(self.Components[i]).edfCodigo.text);
          end;
        end;
        {
        else

        if (Components[i] is TtecDBGrid) then
        begin
          if TtecDBGrid(self.Components[i]).tag <> -1 then
          begin
            v_NomeArquivoDBGrid := trocar(v_NomeArquivo, '.ini', self.Components[i].Name+'.ini');

            try
              if (dgTitles in TtecDBGrid(self.Components[i]).Options) then
                if TtecDBGrid(self.Components[i]).datasource.dataset.active then
                  TtecDBGrid(self.Components[i]).Columns.SaveToFile(v_NomeArquivoDBGrid);
             except
               on E: Exception do ShowMessage(E.Message);
             end;
          end;
        end;
        }
      end;
    end;

    if chave='' then
      v_NomeArquivoIni.UpdateFile;

    qryParametrosFormularios := TtecQuery.Create(nil);
    qryParametrosFormularios.Database := dtmTecSoft.Database;

    if objetivo = '' then
    begin

      if Chave = '' then
        qryParametrosFormularios.Sql.Text := 'delete from parametrosformularios where nomeformulario = '+quotedstr(ExtractFileName(v_NomeArquivo)) +
                                             ' and usename = '+quotedstr(UsuarioLogin.LoginUsuario) + ' and coalesce(chave,'''')='''' and objetivo is null'
      else
        qryParametrosFormularios.Sql.Text := 'delete from parametrosformularios where nomeformulario = '+quotedstr(ExtractFileName(v_NomeArquivo)) +
                                             ' and chave = ' + quotedstr(Chave) + ' and objetivo is null';
      qryParametrosFormularios.execsql;
    end;

    vConteudo := TStringList.create;
    v_NomeArquivoIni.GetStrings(vConteudo);

    if objetivo = '' then
      qryParametrosFormularios.Sql.Text := 'insert into parametrosformularios (nomeformulario, usename, chave, conteudo) values ('+
                                            quotedstr(ExtractFileName(v_NomeArquivo)) + ', ' +
                                            quotedstr(UsuarioLogin.LoginUsuario) + ', ' +
                                            quotedstr(Chave) + ', ' +
                                            quotedstr(vConteudo.Text) + ')'
    else
      qryParametrosFormularios.Sql.Text := 'insert into parametrosformularios (nomeformulario, usename, chave, conteudo, objetivo) values ('+
                                            quotedstr(ExtractFileName(v_NomeArquivo)) + ', ' +
                                            quotedstr(UsuarioLogin.LoginUsuario) + ', ' +
                                            quotedstr(Chave) + ', ' +
                                            quotedstr(vConteudo.Text) + ', ' +
                                            quotedstr(objetivo) + ')';

    qryParametrosFormularios.execsql;
    dtmTecSoft.tstTecSoft.Commit;

    v_NomeArquivoIni.Free;
  end;

  { Configurações das grades  }

  CriarNomeArquivo;

  for i := 0 to self.ComponentCount -1 do
  begin
    if (Components[i].tag <> -1) and
       not (Components[i].InheritsFrom(TFrame)) and
       (Components[i].owner.name <> 'frmConsultaPorCampo') then
    begin

      if (Components[i] is TtecDBGrid) then
      begin
        if TtecDBGrid(Components[i]).GravarConfiguracoes and
           (TtecDBGrid(Components[i]).columns.count>1) then
        begin
//          TtecDBGrid(self.Components[i]).show;
          
          v_NomeArquivoDBGrid := trocar(v_NomeArquivo, '.ini', self.Components[i].Name+'.ini');

//          try
            if (dgTitles in TtecDBGrid(self.Components[i]).Options) then
            begin
              if TtecDBGrid(self.Components[i]).datasource <> nil then
                if TtecDBGrid(self.Components[i]).datasource.dataset <> nil then
//                begin
//                  if TtecDBGrid(self.Components[i]).datasource.dataset.active then
                    TtecDBGrid(self.Components[i]).Columns.SaveToFile(v_NomeArquivoDBGrid);
//                end
            end;
//           except
//             on E: Exception do ShowMessage(E.Message);
//           end;
        end;
      end
      else
      if (Components[i] is TDBAdvGrid) then
      begin
          v_NomeArquivoDBGrid := trocar(v_NomeArquivo, '.ini', self.Components[i].Name+'.ini');
          try

            inifile := TIniFile.Create(v_NomeArquivoDBGrid);
            inifile.WriteString('GRID','SETTINGS', TDBAdvGrid(Components[i]).ColumnStatesToString);
            inifile.Free;

          except
            on E: Exception do ShowMessage(E.Message);
          end;
      end


    end;
  end;

end;

procedure TfrmAjuda.CarregarConfiguracoesFormulario;
var
 i, j, k, l, m, n: integer;
 v_NomeArquivoIni : TMemIniFile;
// v_NomeArquivoIniDBGrid : TFileStream;
 v_NomeArquivo, v_NomeArquivoDBGrid : String;
 vValor : String;
 vvalor2 : String;
 vvalor_1, vvalor_2, vvalor_3, vSecao : String;
 vExiste : Boolean;
 qryParametrosFormularios: TtecQuery;
 vConteudo : TStringList;
// v_Stream : tFileStream;
// v_sStream : String;

  inifile: TInifile;
  s: string;

  function CriarNomeArquivo: Boolean;
  begin
    result := true;
    v_NomeArquivo := ExtractFilePath(Application.ExeName) + 'PARAMETROS';
    v_NomeArquivo := v_NomeArquivo + '\' + UsuarioLogin.LoginUsuario;
    v_NomeArquivo := v_NomeArquivo + '\' + self.Name + '.ini';
  end;


begin
  try
    if SalvarPropriedadesFormulario then
    begin
      CriarNomeArquivo;

      v_NomeArquivoIni := TMemIniFile.Create(v_NomeArquivo);


//      v_NomeArquivoIniDBGrid := TFileStream.Create(v_NomeArquivoDBGrid, fmCreate);

//      v_Stream := TFileStream.create(v_NomeArquivoDBGrid, fmCreate);
//      v_Stream.Position := 0;

      vExiste := FileExists(v_NomeArquivo);

      if not vExiste or (Chave <> '') then
      begin
        qryParametrosFormularios := TtecQuery.Create(nil);
        qryParametrosFormularios.Database := dtmTecSoft.Database;
        if Chave = '' then
          qryParametrosFormularios.Sql.Text := 'select conteudo from parametrosformularios where nomeformulario = '+quotedstr(ExtractFileName(v_NomeArquivo)) +
                                               ' and usename = '+quotedstr(UsuarioLogin.LoginUsuario) + ' and chave = '''''
        else
          qryParametrosFormularios.Sql.Text := 'select conteudo from parametrosformularios where nomeformulario = '+quotedstr(ExtractFileName(v_NomeArquivo)) +
                                               ' and chave = ' + quotedstr(Chave);

        qryParametrosFormularios.open;
        if qryParametrosFormularios.recordcount <> 0 then
        begin
          vExiste := true;
          vConteudo := TStringList.create;
          vConteudo.assign(tMemoField(qryParametrosFormularios.fieldbyname('conteudo')));
          v_NomeArquivoIni.SetStrings(vConteudo);

//          vConteudo.assign(tMemoField(qryParametrosFormularios.fieldbyname('grade')));
//          vConteudo.SaveToFile(v_NomeArquivoDBGrid);
//          v_Stream.Position := 0;


          {
          v_NomeArquivoIniDBGrid.SetStrings(vConteudo);
          }

        end;
      end;

//      if vExiste then
      begin

        for i := 0 to self.ComponentCount -1 do
        begin
          if (Components[i].tag <> -1) then
          begin

            if (Components[i] is TtecPageControl) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
                TtecPageControl(self.Components[i]).TabIndex := v_NomeArquivoIni.ReadInteger(self.Components[i].Name, 'TabIndex', 0)
            end
            else
            if (Components[i] is TCheckBox) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
                TCheckBox(self.Components[i]).Checked := v_NomeArquivoIni.ReadBool(self.Components[i].Name, 'Checked', false)
            end
            else




            if (Components[i] is TAdvSpinEdit) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
                TAdvSpinEdit(self.Components[i]).value := v_NomeArquivoIni.ReadInteger(self.Components[i].Name, 'Value', 60)
            end
            else
            if (Components[i] is TStaticText) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
                TStaticText(self.Components[i]).Caption := v_NomeArquivoIni.ReadString(self.Components[i].Name, 'Caption', '')
            end
            else
            if (Components[i] is TtecRadioButton) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
                if v_NomeArquivoIni.ReadBool(self.Components[i].Name, 'Checked', false) then
                  TtecRadioButton(self.Components[i]).checked := true;
            end
            else
            if (Components[i] is TEditData) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
                TEditData(self.Components[i]).text := v_NomeArquivoIni.ReadString(self.Components[i].Name, 'Text', '')
            end
            else
            if (Components[i] is TEditNumero) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
                TEditNumero(self.Components[i]).Text := v_NomeArquivoIni.ReadString(self.Components[i].Name, 'Text', '')
            end
            else
            if (Components[i] is TFraConsultaCodigo) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
              begin
                if TfraConsultaCodigo(self.Components[i]).edfCodigo.Tag = 0 then
                  if v_NomeArquivoIni.ReadString(self.Components[i].Name, 'edfCodigo.text', '') <> '' then
                  begin
                    TfraConsultaCodigo(self.Components[i]).edfCodigo.text := v_NomeArquivoIni.ReadString(self.Components[i].Name, 'edfCodigo.text', '');
                    TfraConsultaCodigo(self.Components[i]).edfCodigo.Exist;
                  end;
              end;
            end
            else
            if (Components[i] is TtecDbEditFind) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
              begin
                if TtecDbEditFind(self.Components[i]).tag = 0 then
                  if v_NomeArquivoIni.ReadString(self.Components[i].Name, 'Text', '') <> '' then
                  begin
                    TtecDbEditFind(self.Components[i]).Text := v_NomeArquivoIni.ReadString(self.Components[i].Name, 'Text', '');
                    TtecDbEditFind(self.Components[i]).Exist;
                  end;
              end;
            end
            else
            if (Components[i] is TtecDbFindLookup) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
              begin
                if TtecDbFindLookup(self.Components[i]).tag = 0 then
                  if v_NomeArquivoIni.ReadString(self.Components[i].Name, 'Text', '') <> '' then
                  begin
                    TtecDbFindLookup(self.Components[i]).Text := v_NomeArquivoIni.ReadString(self.Components[i].Name, 'Text', '');
                    TtecDbFindLookup(self.Components[i]).Exist;
                  end;
              end;
            end
            else
            if (Components[i] is TRadioGroup) then
            begin
              if v_NomeArquivoIni.SectionExists(self.Components[i].Name) then
                TRadioGroup(self.Components[i]).ItemIndex := v_NomeArquivoIni.ReadInteger(self.Components[i].Name, 'ItemIndex',0);
            end
            else
            if (Components[i] is TCheckListBox) then
            begin
              for j := 0 to TCheckListBox(Components[i]).Items.Count -1 do
              begin
                if v_NomeArquivoIni.SectionExists(self.Components[i].Name+'_'+inttostr(j)) then
                begin
                  TCheckListBox(self.Components[i]).Checked[j] := v_NomeArquivoIni.ReadBool(self.Components[i].Name+'_'+inttostr(j), 'Checked', false);
                  if TCheckListBox(self.Components[i]).Checked[j] then
                  begin
                    if Components[i].GetParentComponent is TTabSheet then
                      TTabSheet(Components[i].GetParentComponent).highLighted := true;
                  end;
                end
              end
            end
            else
            if (Components[i] is TfraListaFiliais) or
               (Components[i] is TfraListaGruposFiliais) then
            begin
              for j := 0 to TfraListaFiliais(Components[i]).componentcount -1 do
              begin
                if (TfraListaFiliais(Components[i]).components[j] is TCheckListBox) then
                begin
                  for k := 0 to TCheckListBox(TfraListaFiliais(Components[i]).components[j]).items.Count -1 do
                  begin
                    if v_NomeArquivoIni.SectionExists(self.Components[i].Name+'_'+inttostr(j)+'_'+TfraListaFiliais(Components[i]).components[j].name+'_'+inttostr(k)) then
                      TCheckListBox(TfraListaFiliais(Components[i]).components[j]).checked[k] :=
                          v_NomeArquivoIni.ReadBool(self.Components[i].Name+'_'+inttostr(j)+'_'+TfraListaFiliais(Components[i]).components[j].name+'_'+inttostr(k), 'Checked', false);
                  end;
                end;
              end;
            end
            else
            {

                  vvalor_1 := self.Components[i].Name;
                  vvalor_2 := inttostr(TFraOrdenacao_cr(Components[i]).qryLista.recno);
                  vvalor_3 := TFraOrdenacao_cr(Components[i]).qryLista.fields[j].fieldname;


                  vValor := v_NomeArquivoIni.ReadString(

                  self.Components[i].Name + '_' +
                  inttostr(TFraOrdenacao_cr(Components[i]).qryLista.recno) + '_' +
                  TFraOrdenacao_cr(Components[i]).qryLista.fields[j].fieldname, 'Valor do Campo', '');

            }
            if (Components[i] is TFraOrdenacao_cr) then
            begin
              TFraOrdenacao_cr(Components[i]).qryLista.first;
              while not TFraOrdenacao_cr(Components[i]).qryLista.Eof do
              begin

                for j := 0 to TFraOrdenacao_cr(Components[i]).qryLista.FieldCount -1 do
                begin
                  vSecao := self.Components[i].Name + '_' +
                            TFraOrdenacao_cr(Components[i]).qryLista.fieldbyname('campo').asString + '_' +
                            TFraOrdenacao_cr(Components[i]).qryLista.fields[j].fieldname;

                  if v_NomeArquivoIni.SectionExists(vSecao) then
                  begin
                    TFraOrdenacao_cr(Components[i]).qryLista.edit;

                    if TFraOrdenacao_cr(Components[i]).qryLista.fields[j].datatype = ftboolean then
                      TFraOrdenacao_cr(Components[i]).qryLista.fields[j].asBoolean := v_NomeArquivoIni.ReadBool(vSecao, 'Valor do Campo', true)
                    else
                      TFraOrdenacao_cr(Components[i]).qryLista.fields[j].asString := v_NomeArquivoIni.ReadString(vSecao, 'Valor do Campo', '');
                  end;
                end;
                TFraOrdenacao_cr(Components[i]).qryLista.next;

              end;
            end
            else
            {Verificar a possibilidade de recursividade em relação a outros componentes pois o frame no form é somente um objeto,
             detalhes dentro do frame não participam da verificação acima}
            if (Components[i] is TfraMultiplaSelecaoAleatoria) then
            begin

              for k := 0 to TfraMultiplaSelecaoAleatoria(Components[i]).ComponentCount -1 do
              begin
                if (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is tfraSelecaoAleatoriaItemdeProdutos) or
                   (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is TfraSelecaoAleatoriaprodutos) or
                   (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is tfraSelecaoaleatoriagruposprodutos) or
                   (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is tfraSelecaoaleatoriaclassesprodutos) or
                   (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is tfraSelecaoAleatoriamarcasProdutos) or
                   (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k] is tfraSelecaoAleatoriaPromocoes) then
                begin

                  for l := 0 to TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].ComponentCount -1 do
                  begin
                    if (TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l] is tfraSelecaoAleatoria) then
                    begin
                      LimparTabela(TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria);
                      m := 1;
                      while true do
                      begin
                        vSecao :=  TfraMultiplaSelecaoAleatoria(Components[i]).Name + '_' + TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Name + '_' + inttostr(m);
                        if v_NomeArquivoIni.SectionExists(vsecao) then
                        begin
                          TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.Append;
                          for n:=0 to TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.FieldCount - 1 do
                          begin
                            case TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.Fields[n].DataType of
                              ftBoolean : TBooleanField(TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.Fields[n]).AsBoolean :=
                                 v_NomeArquivoIni.ReadBool(vSecao, TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.Fields[n].FieldName, false)
                            else
                              if v_NomeArquivoIni.ReadString(vSecao, TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.Fields[n].FieldName, '') = '' then
                                TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.Fields[n].AsVariant := null
                              else
                                TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.Fields[n].AsVariant :=
                                  v_NomeArquivoIni.ReadString(vSecao, TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.Fields[n].FieldName, '');

                            end;
                          end;
                          TFraSelecaoAleatoria(TfraMultiplaSelecaoAleatoria(Components[i]).Components[k].Components[l]).qrySelecaoAleatoria.post;

                        end
                        else
                          break;

                        inc(m);
                      end;
                    end;
                  end;

                end;
              end;


            end
            else
            if (Components[i] is TfraSelecaoAleatoriaClientes) or
               (Components[i] is TfraSelecaoaleatoriatiporecebimento) or
               (Components[i] is TfraSelecaoaleatoriaplanorecebimento) or
               (Components[i] is TfraSelecaoaleatoriagruposfornecedores) or
               (Components[i] is TfraSelecaoaleatorialistaspadronizadas) or
               (Components[i] is TfraSelecaoaleatoriavendedores) then
            begin
              for l := 0 to Components[i].ComponentCount -1 do
              begin
                if (Components[i].Components[l] is tfraSelecaoAleatoria) then
                begin
                  LimparTabela(TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria);
                  m := 1;
                  while true do
                  begin
                    vSecao :=  Components[i].Name + '_' + Components[i].Components[l].Name + '_' + inttostr(m);
                    if v_NomeArquivoIni.SectionExists(vsecao) then
                    begin
                      TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria.Append;
                      for n:=0 to TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria.FieldCount - 1 do
                      begin
                        case TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria.Fields[n].DataType of
                          ftBoolean : TBooleanField(TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria.Fields[n]).AsBoolean :=
                             v_NomeArquivoIni.ReadBool(vSecao, TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria.Fields[n].FieldName, false)
                        else
                          if v_NomeArquivoIni.ReadString(vSecao, TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria.Fields[n].FieldName, '') = '' then
                            TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria.Fields[n].AsVariant := null
                          else
                            TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria.Fields[n].AsVariant :=
                               v_NomeArquivoIni.ReadString(vSecao, TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria.Fields[n].FieldName, '');
                        end;
                      end;
                      TFraSelecaoAleatoria(Components[i].Components[l]).qrySelecaoAleatoria.post;
                    end
                    else
                      break;

                    inc(m);
                  end;
                end;
              end;
            end;
            {
            else
            begin
              if (Components[i] is TtecDBGrid) then
              begin
                  if TtecDBGrid(self.Components[i]).tag <> -1 then
                  begin
                     try
                     v_NomeArquivoDBGrid := trocar(v_NomeArquivo, '.ini', self.Components[i].Name+'.ini');

                     if fileexists(v_NomeArquivoDBGrid) then
                       if (dgTitles in TtecDBGrid(self.Components[i]).Options) then
                         TtecDBGrid(self.Components[i]).Columns.LoadFromFile(v_NomeArquivoDBGrid);
                     except
                       on E: Exception do ShowMessage(E.Message);
                     end;
                  end;
              end;
            end;
            }
          end;
        end;
      end;
    end;


    CriarNomeArquivo;
    for i := 0 to self.ComponentCount -1 do
    begin
      if (Components[i].tag <> -1) and
         not (Components[i].InheritsFrom(TFrame)) and
         (Components[i].owner.name <> 'frmConsultaPorCampo') then
      begin
        if (Components[i] is TtecDBGrid) then
        begin
          if TtecDBGrid(Components[i]).GravarConfiguracoes and
             (TtecDBGrid(Components[i]).columns.count>1) then
          begin

             try
             TtecDBGrid(self.Components[i]).show;
             v_NomeArquivoDBGrid := trocar(v_NomeArquivo, '.ini', self.Components[i].Name+'.ini');

             if fileexists(v_NomeArquivoDBGrid) then
               if (dgTitles in TtecDBGrid(self.Components[i]).Options) then
               begin
                 TtecDBGrid(self.Components[i]).Columns.SavetoStream(TtecDBGrid(self.Components[i]).vConfiguracaoOriginal);
//                 TtecDBGrid(self.Components[i]).show; {Necessário...caso contário trava quando tenta salvar o grid}
                 TtecDBGrid(self.Components[i]).Columns.LoadFromFile(v_NomeArquivoDBGrid);
               end;
             except
               {
               on E: Exception do
               begin
                 ShowMessage(E.Message);
               end;
               }
             end;
          end;
        end
        else
        if (Components[i] is TDBAdvGrid) then
        begin

          v_NomeArquivoDBGrid := trocar(v_NomeArquivo, '.ini', self.Components[i].Name+'.ini');

          inifile := TIniFile.Create(v_NomeArquivoDBGrid);
          s := inifile.ReadString('GRID','SETTINGS','');
          inifile.Free;

          if s <> '' then
            TDBAdvGrid(Components[i]).StringToColumnStates(s);

        end;

      end;
    end;

  except
  end;
end;

procedure TfrmAjuda.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
begin
     {
  if ExisteRelatorioAberto then
  begin
    MensagemAviso('Existem relatórios abertos vinculados a este formulário.');
    Canclose := false
  end
  else
    Canclose :=  true;
    }

  FecharRelatorioAberto;
  Canclose := true;
  inherited;
end;

function TfrmAjuda.ExisteRelatorioAberto: boolean;
var
  i,j: integer;
begin
  result := false;

  for i := self.ComponentCount-1 downto 0  do
  begin
    if Components[i] is TdtmBasico then
    begin
      for j := Components[i].ComponentCount-1 downto 0  do
      begin
        if Components[i].Components[j] is TfrmPreviewPadrao then
        begin
          result := true;
          break;
        end;
      end;
    end;
  end;
  
end;

procedure TfrmAjuda.SetChave(const Value: String);
begin
  if fChave <> Value then
  begin
    fChave := Value;
    CarregarConfiguracoesFormulario;
  end;
end;

function TfrmAjuda.FecharRelatorioAberto: boolean;
var
  cnt, j: Integer;
  v_frmPreviewPadrao : TfrmPreviewPadrao;
begin
  for cnt :=self.ComponentCount-1 downto 0 do
  begin
    if Components[cnt] is TfrmPreviewPadrao then
    begin
      v_frmPreviewPadrao := TfrmPreviewPadrao(Components[cnt]);
      v_frmPreviewPadrao.ModalResult := mrOK;
    end;

    if Components[cnt] is TdtmBasico then
    begin
      for j := Components[cnt].ComponentCount-1 downto 0  do
      begin
        if Components[cnt].Components[j] is TfrmPreviewPadrao then
        begin
          v_frmPreviewPadrao := TfrmPreviewPadrao(Components[cnt].Components[j]);
          v_frmPreviewPadrao.ModalResult := mrOK;
        end;
      end;
    end;
  end;
end;


procedure TfrmAjuda.PrintScreenDetect(Sender: TObject;
  var Result: Boolean);
begin
  if GetAsyncKeyState(VK_SNAPSHOT)<>0 then
  begin
    if Clipboard.HasFormat(CF_BITMAP) then
      SalvarImagemSistema(Clipboard);

  end;

end;

procedure TfrmAjuda.FormCreate(Sender: TObject);
begin
  Application.OnIdle := PrintScreenDetect;
  SetClipboardViewer(Handle);
end;

procedure TfrmAjuda.ClipBoardChanged(var Message: TMessage);
begin
  if GetAsyncKeyState(VK_SNAPSHOT)<>0 then
  begin
    if Clipboard.HasFormat(CF_BITMAP) then
      SalvarImagemSistema(Clipboard);
  end;
end;

end.
