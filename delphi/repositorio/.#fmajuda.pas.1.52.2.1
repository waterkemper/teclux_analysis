procedure TfrmAjuda.CarregarConfiguracoesFormulario__;
var
 i, j, k: integer;
 v_strFile : TFileStream;
 v_NomeArquivo, v_NomeArquivoComponente : String;
 v_Lista: TStringList;

begin
  if SalvarPropriedadesFormulario then
