    for i := 0 to self.ComponentCount -1 do
    begin
      if (Components[i] is TCheckBox) or   //ok
         (Components[i] is TEditData) or   //ok
         (Components[i] is TEditNumero) or  //ok
         (Components[i] is TRadioGroup) or   //ok
         (Components[i] is TCheckListBox) {  //ok
