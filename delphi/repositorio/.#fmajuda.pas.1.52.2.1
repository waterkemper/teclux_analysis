destructor TfrmAjuda.Destroy;
var
  Par: TForm;
begin

  if self.FormStyle <>  fsNormal then
    IF SELF.TAG = 1000 THEN
       DestruirFormulario(self);   {estava travando no momento da alteração do valor de um calculo de financiamento via contrato}


  if Screen.FormCount > 1 then
    Par := Screen.Forms[1];
    {
  else
    Par := nil;}


  DestruirDataModulo;

  inherited destroy;

  if Assigned(Par) and (Par.FormStyle = fsMDIChild) and Par.CanFocus then
//    Par.SetFocus
