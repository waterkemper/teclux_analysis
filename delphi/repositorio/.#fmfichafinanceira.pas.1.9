function TfrmFichaFinanceira.InternoPesquisar(Titulo: String): Integer;
begin
  Result:= mrNone;
  if CtrlOn then begin
    if ActiveControl = edfCodigoCliente then begin
      dtmFichaFinanceira.Abre(ctCrediarioConsultaClientes);
      Result := inherited InternoPesquisar('Clientes');
      if Result  = mrok then begin
        dtmFichaFinanceira.Selecionar;
        dtmFichaFinanceira.ReFazConsultaContratosPorCliente;
      end;
      dtmFichaFinanceira.Fecha(ctCrediarioConsultaClientes);
    end;
  end;
end;

function TfrmFichaFinanceira.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := TfrmConsultaPorCampo.Create(nil);
