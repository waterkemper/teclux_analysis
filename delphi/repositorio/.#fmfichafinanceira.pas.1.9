procedure TfrmFichaFinanceira.sbnDebitosClick(Sender: TObject);
begin
  Debito:= not Debito;
  if Debito then begin
    pgcFichaFinanceira.ActivePage:= tstDebitos;
    dtmFichaFinanceira.CalcularDebitos(False);
    dbgParcelasCalcularDebito.SetFocus;
    sbnDebitos.Caption:= 'Ficha F7';
    sbnDebitos.Hint:='Visualizar Ficha';
  end
  else begin
    pgcFichaFinanceira.ActivePage:= tstInformacoes;
    sbnDebitos.Caption:= 'Débitos F7';
    sbnDebitos.Hint:='Visualizar débitos';
  end;
end;

procedure TfrmFichaFinanceira.sbnImprimirClick(Sender: TObject);
var
  frmImpressao: TfrmConfirmarImpressaoNoContrato;
begin
  inherited;
  dtmFichaFinanceira.SelecionarParcelas;
  if pgcFichaFinanceira.ActivePage = tstDebitos then
    dtmFichaFinanceira.ImprimirCalculosDebitos
  else begin
    frmImpressao := TfrmConfirmarImpressaoNoContrato.Create(Self, True, True, True, True, True, 1);
    frmImpressao.IntervaloCarnes:= dtmFichaFinanceira.IntervaloCarnes;
    frmImpressao.IntervaloCarnesAbertas:= dtmFichaFinanceira.IntervaloCarnesAbertas;
    frmImpressao.ckbImprimirCarneAbertas.Enabled := frmImpressao.IntervaloCarnesAbertas<>nil;
    try
      frmImpressao.ShowModal;
      if frmImpressao.ModalResult = mrOk then
      begin
        if frmImpressao.Contrato then
           dtmFichaFinanceira.ImprimirContrato;

        if frmImpressao.Carne then
           dtmFichaFinanceira.ImprimirCarne(frmImpressao.Sequencia)
        else if frmImpressao.CarneAbertas then
           dtmFichaFinanceira.ImprimirCarne(frmImpressao.Sequencia);

        if frmImpressao.Boleto then
           dtmFichaFinanceira.ImprimirBoleto(frmImpressao.Sequencia);

        if frmImpressao.Saldo then
           dtmFichaFinanceira.ImprimirSaldo;
      end
    finally
      frmImpressao.Free;
    end;
  end;
end;

