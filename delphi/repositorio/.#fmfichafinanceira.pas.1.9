procedure TfrmFichaFinanceira.actHabilitarBotaoCalcularUpdate(Sender: TObject);
begin
  inherited;
  sbnDebitos.Enabled       := not dtmFichaFinanceira.TabelaContratosClienteVazia;
//  sbnImprimir.Enabled      := pgcFichaFinanceira.ActivePage = tstDebitos;
  sbnExibirJurosDescontos.Enabled := pgcFichaFinanceira.ActivePage = tstDebitos;
  pnlProdutos.Visible      := (pgcContratos.ActivePage = tstProdutos);
  ExibeValoresCalculadosCarne;
end;

procedure TfrmFichaFinanceira.AfterCloseClientes(Sender: TObject);
begin
  fraConsultaDadosClienteFicha.BuscarDadosCliente(
                dtmFichaFinanceira.CodigoCliente,
                dtmFichaFinanceira.TipoCliente);
end;

procedure TfrmFichaFinanceira.AfterScrollContratosPorCliente(Sender: TObject);
begin
{ //TEMPORARIO JR 04/11
 if pgcContratos.ActivePage = tstContratos        then
     dtmFichaFinanceira.SelecionarContratos
  else}
  if pgcContratos.ActivePage = tstParcelas then
  begin
    if pgcParcelasRecebimentos.ActivePage = tstParcelasRecebimentos then
      dtmFichaFinanceira.SelecionarParcelas
    else if pgcParcelasRecebimentos.ActivePage = tstRecebimentosParcelas then
      dtmFichaFinanceira.SelecionarRecebimentos
  end
  else if pgcContratos.ActivePage = tstProdutos    then
     dtmFichaFinanceira.SelecionarProdutos
  else if pgcContratos.ActivePage = tstServicos    then
     dtmFichaFinanceira.SelecionarServicos
  else if pgcContratos.ActivePage = tstNotasCupons then
     dtmFichaFinanceira.SelecionarNotasCupons
  else if pgcContratos.ActivePage = tstEntrega     then
     dtmFichaFinanceira.SelecionarRomaneios
  else if pgcContratos.ActivePage = tstMontagem then
    dtmFichaFinanceira.SelecionarMontagens;
end;

constructor TfrmFichaFinanceira.Create(AOwner: TComponent);
begin
  try
    dtmFichaFinanceira := TdtmFichaFinanceira.Create(Self);
    inherited Create(AOwner);
  //  dtmFichaFinanceira.Abre(ctTabelas);
    pgcFichaFinanceira.ActivePage:= tstInformacoes;
    pgcContratos.ActivePage      := tstContratos;
    dtmFichaFinanceira.AfterScrollContratosPorCliente:= AfterScrollContratosPorCliente;
    dtmFichaFinanceira.AfterCloseClientes:= AfterCloseClientes;
    edtDataPagto.Text:= DateToStr(dtmFichaFinanceira.DataServidor);
    DataAnterior     := dtmFichaFinanceira.DataServidor;
    dtmFichaFinanceira.DataCalculo:= dtmFichaFinanceira.DataServidor;
    dbgParcelas.Columns[03].Visible:= ParSistema.ExibirDescontoSugerido;
    dbgParcelas.Columns[04].Visible:= ParSistema.ExibirDescontoSugerido;
    IndNot:= 1;
    IndCon:= 1;
    dbgprodutos.Columns[2].Visible := ParSistema.UsarGradesProdutos;
    dbgprodutos.Columns[3].Visible := ParSistema.UsarGradesProdutos;
    lblDependente.Visible:=ParSistema.ClienteComDependentes;
    dtxNomeDependente.Visible:=ParSistema.ClienteComDependentes;
    dtmFichaFinanceira.OnScrollLinhaColunaGrade := AfterScrollLinhaColunaGrade;
    ckbSomenteEmAberto.Checked:=ParSistema.MostrarSomenteContratosEmabertoFicha;
    dbgMontagem.Columns[2].Visible := ParSistema.UsarGradesProdutos;
    dbgMontagem.Columns[3].Visible := ParSistema.UsarGradesProdutos;
    if dbgProdutos.Columns[5].Width < ParSistema.TamanhoMascaraQuantidade then
      dbgProdutos.Columns[5].Width := ParSistema.TamanhoMascaraQuantidade;
    if dbgProdutos.Columns[7].Width < ParSistema.TamanhoMascaraQuantidade then
      dbgProdutos.Columns[7].Width := ParSistema.TamanhoMascaraQuantidade;
    if dbgProdutoEntrega.Columns[3].Width < ParSistema.TamanhoMascaraQuantidade then
      dbgProdutoEntrega.Columns[3].Width := ParSistema.TamanhoMascaraQuantidade;
    fraConsultaDadosClienteFicha.tstLimitesCredito.TabVisible := ParSistema.VerificarLimiteCreditoPontuacao;
  except
    on E: Exception do ShowMessage(E.Message);
  end;

end;

procedure TfrmFichaFinanceira.dbgContratosPorClienteDrawColumnCell(
  Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;

   TDBGrid(Sender).Canvas.Brush.Color := $007FAA55;
   TDBGrid(Sender).Canvas.Font.Color  := clBlack;

  if (dtmFichaFinanceira.ContratoEmAtraso) and
     (dtmFichaFinanceira.SituacaoContrato<>'C') and
     (dtmFichaFinanceira.SituacaoContrato<>'R') and not
     (dtmFichaFinanceira.ContratoRenegociado) then begin
    TDBGrid(Sender).Canvas.Brush.Color := clWhite;
    TDBGrid(Sender).Canvas.Font.Color  := clRed;
  end
  else if (dtmFichaFinanceira.ContratoEmAberto) and
          (dtmFichaFinanceira.SituacaoContrato<>'C') and
          (dtmFichaFinanceira.SituacaoContrato<>'R') and not
          (dtmFichaFinanceira.ContratoRenegociado) then begin
    TDBGrid(Sender).Canvas.Brush.Color := clWhite;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end
  else if (dtmFichaFinanceira.ContratoRenegociado) and
          (dtmFichaFinanceira.SituacaoContrato<>'C') then begin
    TDBGrid(Sender).Canvas.Brush.Color := $7DBEFF;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end
  else if dtmFichaFinanceira.SituacaoContrato = 'R' then begin
    TDBGrid(Sender).Canvas.Brush.Color := $00FFD9A4;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end
  else if (dtmFichaFinanceira.SituacaoContrato = 'C') or
          (dtmFichaFinanceira.ContratoEstornado) then begin
    TDBGrid(Sender).Canvas.Brush.Color := clYellow;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end;

  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmFichaFinanceira.dbgNotaEntregaTitleClick(Column: TColumn);
begin
  inherited;
  if AltOn then
  begin
    if Column.Index = 2 then begin
      Inc(IndNot);
      if IndNot > 2 then
        IndNot:= 1;
      case IndNot of
        1: begin
             dbgNotaEntrega.Columns[2].Title.Caption  := 'Filial/ECF/Inter./Número ...';
             dbgNotaEntrega.Columns[2].FieldName      := 'cupom';
           end;
        2: begin
             dbgNotaEntrega.Columns[2].Title.Caption:= 'Filial/Série/Número ...';
             dbgNotaEntrega.Columns[2].FieldName    := 'nota';
           end;
      end;
    end;
  end;  
end;

procedure TfrmFichaFinanceira.dbgParcelasCalcularDebitoDblClick(Sender: TObject);
begin
  inherited;
  dtmFichaFinanceira.CalcularDebitoParcelaEmAberto(False);
end;

procedure TfrmFichaFinanceira.dbgParcelasCalcularDebitoDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if (dbgParcelasCalcularDebito.DataSource.DataSet.FieldByName('Aux').AsString <> '') then begin
    //TDBGrid(Sender).Canvas.Brush.Color := $007FAA55;
    TDBGrid(Sender).Canvas.Brush.Color := clBtnFace;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end;

  if dbgParcelasCalcularDebito.DataSource.DataSet.FieldByName('quitar').AsBoolean then begin
    TDBGrid(Sender).Canvas.Brush.Color := clWhite;
    TDBGrid(Sender).Canvas.Font.Color := clRed;
  end;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

procedure TfrmFichaFinanceira.dbgParcelasCalcularDebitoKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  inherited;
  case KEY of
    VK_SPACE: if (Shift = [ssCtrl]) then
                 dbgParcelasCalcularDebitoDblClick(dbgParcelas);
  end;
end;

procedure TfrmFichaFinanceira.dbgParcelasDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
begin
  inherited;
  if (dtmFichaFinanceira.SituacaoContrato = 'C') or
     ((dtmFichaFinanceira.qryParcelastipopagto.AsString<> '') and
      (dtmFichaFinanceira.qryParcelastipopagto.AsString <> 'M')) then begin
    TDBGrid(Sender).Canvas.Brush.Color := clYellow;
    TDBGrid(Sender).Canvas.Font.Color  := clBlack;
  end
  else if (dtmFichaFinanceira.Situacao <> 'R') and not
          (dtmFichaFinanceira.ContratoRenegociado) and
          (dtmFichaFinanceira.ParcelaAtrasada) then begin
    TDBGrid(Sender).Canvas.Brush.Color := clWhite;
    TDBGrid(Sender).Canvas.Font.Color := clRed;
  end
  else if dtmFichaFinanceira.qryParcelasdatapagto.AsDateTime<>0 then begin
    TDBGrid(Sender).Canvas.Brush.Color := $007FAA55;
    TDBGrid(Sender).Canvas.Font.Color := clBlack;
  end;
  TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

destructor TfrmFichaFinanceira.Destroy;
begin
  try
//    dtmFichaFinanceira.Fecha(ctTabelas);
    inherited;
    if dtmFichaFinanceira <> nil then
      dtmFichaFinanceira := nil;
    frmFichaFinanceira:= nil;
  except
     on E: Exception do ShowMessage(E.Message);
  end;
end;

procedure TfrmFichaFinanceira.edfCodigoClienteFound(Found: Boolean);
begin
  if Found then begin
    if pgcFichaFinanceira.ActivePage = tstDebitos then
      pgcFichaFinanceira.ActivePage := tstInformacoes;
    Debito:= False;
    dtmFichaFinanceira.ReFazConsultaContratosPorCliente;
    dtmFichaFinanceira.ZerarVariaveis;
    edtDataPagto.Text             := DateToStr(dtmFichaFinanceira.DataServidor);
    dtmFichaFinanceira.DataCalculo:= dtmFichaFinanceira.DataServidor;
    fraConsultaDadosClienteFicha.BuscarDadosCliente(
                   dtmFichaFinanceira.CodigoCliente,
                   dtmFichaFinanceira.TipoCliente);
//    dbgContratosPorCliente.SetFocus;
    lblCliente.Caption:= DescricaoLabelCliente(dtmFichaFinanceira.TipoCliente[1]);
  end;
end;

procedure TfrmFichaFinanceira.ExibeValoresCalculadosCarne;
var
  Atraso, Desconto: Currency;
begin
  lblAtrasoParcelasValor.Caption   := FormatarValor(dtmFichaFinanceira.AtrasoParcela,2);
  lblAtrasoJurosValor.Caption      := FormatarValor(dtmFichaFinanceira.AtrasoJuro,2);
  lblAtrasoTotalValor.Caption      := FormatarValor(dtmFichaFinanceira.AtrasoParcela +
                                                    dtmFichaFinanceira.AtrasoJuro,2);
  lblEmAbertoParcelasValor.Caption := FormatarValor(dtmFichaFinanceira.EmAbertoParcela,2);
  lblEmAbertoDescontosValor.Caption:= FormatarValor(Abs(dtmFichaFinanceira.EmAbertoDesconto),2);
  lblEmAbertoTotalValor.Caption    := FormatarValor(dtmFichaFinanceira.EmAbertoParcela -
                                                    Abs(dtmFichaFinanceira.EmAbertoDesconto),2);
  Atraso  := RoundTo(dtmFichaFinanceira.AtrasoParcela   + dtmFichaFinanceira.AtrasoJuro,-2);
  Desconto:= RoundTo(dtmFichaFinanceira.EmAbertoParcela - Abs(dtmFichaFinanceira.EmAbertoDesconto),-2);
  lblTotalAtrasos.Caption          := FormatarValor(Atraso + Desconto,2);

  lblValorParcelas.Caption         := FormatarValor(dtmFichaFinanceira.ValorParcela,2);
  lblValorJuros.Caption            := FormatarValor(dtmFichaFinanceira.JuroParcela,2);
  lblValorDescontos.Caption        := FormatarValor(dtmFichaFinanceira.DescontoParcela,2);
  lblValorCarnes.Caption           := FormatarValor(dtmFichaFinanceira.ValorParcela +
                                                    dtmFichaFinanceira.JuroParcela  -
                                                    dtmFichaFinanceira.DescontoParcela,2);
end;

