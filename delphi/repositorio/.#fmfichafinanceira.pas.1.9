procedure TfrmFichaFinanceira.edtDataPagtoEnter(Sender: TObject);
begin
  inherited;
  if (Trim(edtDataPagto.Text) <> '') and edtDataPagto.Criticar(false) then
    DataAnterior:= StrToDate(edtDataPagto.Text)
end;

procedure TfrmFichaFinanceira.edtDataPagtoKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  inherited;
  if TeclaEnterOuReturn(Key) then
    if (Trim(edtDataPagto.Text) <> '') and edtDataPagto.Criticar(false) then
      if StrToDate(edtDataPagto.Text) <> DataAnterior then begin
        dtmFichaFinanceira.DataCalculo:= StrToDate(edtDataPagto.Text);
        dtmFichaFinanceira.CalcularDebitos(True);
        dbgParcelasCalcularDebito.SetFocus;
      end;
end;

