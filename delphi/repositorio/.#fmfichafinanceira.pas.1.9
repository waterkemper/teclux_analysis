procedure TfrmFichaFinanceira.dbgProdutosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn; State: TGridDrawState);
begin
  inherited;
  with dtmFichaFinanceira do
  begin
    if (qryProdutosdevolvidos.ascurrency<>0) and
       (qryProdutostrocados.ascurrency<>0) then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := $00A8D3FF;  //laranjão = mistura de amararelao + vermelhão
      TDBGrid(Sender).Canvas.Font.Color  := clBlack;
    end
    else
    if (qryProdutosdevolvidos.ascurrency<>0) and
       (qryProdutostrocados.ascurrency=0) then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := clYellow;
      TDBGrid(Sender).Canvas.Font.Color  := clBlack;
    end
    else
    if (qryProdutosdevolvidos.ascurrency=0) and
       (qryProdutostrocados.ascurrency<>0) then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := $009D9DFF;
      TDBGrid(Sender).Canvas.Font.Color  := clBlack;
    end;

    {
    if (QtdeCancelada > 0) and (QtdeVendida = QtdeCancelada) then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := $00FFAA00;
      TDBGrid(Sender).Canvas.Font.Color  := clBlack;
    end
    else if (QtdeCancelada > 0) and (QtdeVendida > QtdeCancelada) then
    begin
      TDBGrid(Sender).Canvas.Brush.Color := $00FFF18B;
      TDBGrid(Sender).Canvas.Font.Color := clBlack;
    end;
    }
    TDBGrid(Sender).DefaultDrawColumnCell(Rect, DataCol, Column, State);
  end;
end;

