procedure TfrmFichaFinanceira.KeyDown(var Key: Word; Shift: TShiftState);
var
  frmAjuda: TfrmAjuda;
begin
  inherited;
  Case Key of
    VK_F7     : sbnDebitos.Click;
    VK_F11    : if sbnExibirJurosDescontos.Enabled then sbnExibirJurosDescontos.Click;
    VK_F12    : if sbnImprimir.Enabled then sbnImprimir.Click;
    VK_ESCAPE : begin
                   if pgcFichaFinanceira.ActivePage = tstDebitos then
                   begin
                     pgcFichaFinanceira.ActivePage:= tstInformacoes;
                     sbnDebitos.Caption:= 'Débitos F7';
                     Debito:= not Debito;
                     pgcContratos.ActivePage      := tstContratos;
                   end
                   else if (FormOrigem<>'') then
                   begin
                     frmAjuda := TfrmAjuda(FormExists(FormOrigem));
                     if Assigned(frmAjuda) then
                       frmajuda.BringToFront;
                   end;
                   if ParSistema.VerificarLimiteCreditoPontuacao and (FormOrigem <> '') and VerificandoCredito then
                  //   if FormOrigem = 'TfrmCadastroContratos' then
                    //   dtmFichaFinanceira.SenhaCredito
                    // else if FormOrigem = 'TfrmVendasAVista' then
//                     if dtmFichaFinanceira.SenhaCredito <> nil then
//                       dtmFichaFinanceira.SenhaCredito;
//                     dtmFichaFinanceira.SenhaCredito:= nil;
                 end;
     VK_RIGHT : if (Shift = [ssCtrl]) then begin
                   if dbgNotaEntrega.Focused then
                     dbgNotaEntregaTitleClick(dbgNotaEntrega.Columns.Items[02]);
                 end;
  end;
end;

procedure TfrmFichaFinanceira.OperacaoPadrao(Value: Array of Variant);
begin
  inherited;
  edfCodigoCliente.SetFocus;
  edfCodigoCliente.Text := Value[0];
  dtmFichaFinanceira.ReFazConsultaCliente(Value[0],Value[1]);
  edfCodigoClienteFound(True);
  if (high(Value)>=2) then
  begin
    FormOrigem := Value[2];
    if High(Value) = 3 then
      VerificandoCredito := Value[3];
    if VerificandoCredito then
      fraConsultaDadosClienteFicha.pgcDetalhesCliente.ActivePage := fraConsultaDadosClienteFicha.tstLimitesCredito;
  end;
  pgcContratos.ActivePage:= tstParcelas;

  if high(Value)=4 then
  begin
    Application.ProcessMessages;
    close;
  end;
end;

