  fmConsultaBasica, fmconsultaporcampo, fmajudabt, fmrelatoriopadrao,
  // Projeto
  dmquitacaolote, DB, ZPgSqlQuery, cpquery, cpdbradiogroup, cptexto,
  cpdblookupcombobox, cpdbmemo, ToolWin;

type
  TfrmQuitacaoLote = class(TfrmAjudaBt)
    pnlFundoJanela: TPanel;
    pgcQuitacaoDuplicatas: TtecPageControl;
    tstParametros: TTabSheet;
    pgcFilialGrupoFilial: TtecPageControl;
    tstFilial: TTabSheet;
    sbnProcurarFilial: TSpeedButton;
