    edtVenctoFinal: TEditData;
    gbxEvento: TGroupBox;
    sbnEvento: TSpeedButton;
    dtxEvento: TtecDBText;
    edfEvento: TtecDbEditFind;
    gbxNotasFiscais: TGroupBox;
    tecDBGrid1: TtecDBGrid;
    dtxPlano: TtecDBText;
    gbxObservacaoBoleto: TGroupBox;
    mmoObservacaoBoleto: TtecDBMemo;
    gbxPlanoPagto: TGroupBox;
    lblA: TLabel;
    gbxEmissao: TGroupBox;
    edtEmissaoInicial: TEditData;
    edtEmissaoFinal: TEditData;
    Label2: TLabel;
    stxOrdenacao: TStaticText;
    shContaCreditoPagamento: TShape;
    lblContrapartidaAlterada: TLabel;
    gbxFaixaValores: TGroupBox;
    Label3: TLabel;
