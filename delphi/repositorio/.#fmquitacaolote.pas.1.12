    sbnProcurarCliente: TSpeedButton;
    rgbOrdenacao: TRadioGroup;
    dbgDetalhado: TtecDBGrid;
    gbxLidos: TGroupBox;
    gbxNrLidos: TGroupBox;
    gbxValorLido: TGroupBox;
    gbxMarcadas: TGroupBox;
    GroupBox2: TGroupBox;
    GroupBox3: TGroupBox;
    edtQtdeDuplicatas: TEditNumero;
    edtQtdeMarcados: TEditNumero;
    edtTotalPrevisao: TEditNumero;
    edtTotalQuitar: TEditNumero;
    gbxConta: TGroupBox;
    sbnProcurarConta: TSpeedButton;
    edfConta: TtecDbEditFind;
    dtxDigito: TtecDBText;
    Label1: TLabel;
    gbxSiglaBanco: TGroupBox;
    dtxSigla: TtecDBText;
    gbxNomeAgencia: TGroupBox;
    dtxNomeAgencia: TtecDBText;
    gbxContaDebito: TGroupBox;
    edtContaDebito: TEditNumero;
    GroupBox1: TGroupBox;
    edtDataQuitacao: TEditData;
    gbxVencimentos: TGroupBox;
