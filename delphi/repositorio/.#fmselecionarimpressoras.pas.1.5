unit fmselecionarimpressoras;

interface

uses
  SysUtils, Types, Classes, Variants, Graphics, Controls, Forms, Dialogs,
  {fmajudabt,} ComCtrls, Buttons, ExtCtrls, {fmnavcontroles,} StdCtrls,
  {cltextprinter,} ctconstantes, biblio;

type
  TfrmSelecionarImpressoras = class(Tform)
    pnlFundoJanela: TPanel;
    gbxImpressoras: TGroupBox;
    lblSelecionar: TLabel;
    cmbImpressoras: TComboBox;
    bbnOK: TBitBtn;
    Image1: TImage;
    procedure bbnOKClick(Sender: TObject);
  private
    FNomeImpressora: String;
    procedure SetNomeImpressora(const Value: String);
    { Private declarations }
  public
    constructor Create(AOwner: TComponent; TipoImpressao: Char); reintroduce;
    destructor Destroy; override;
    property NomeImpressora: String read FNomeImpressora write SetNomeImpressora;
  end;

var
  frmSelecionarImpressoras: TfrmSelecionarImpressoras;


implementation

uses
  Printers, clparametrossistema;

{$R *.dfm}

{ TfrmselecionarImpressoras }

function SelecionarImpressora_(var pImpressora: String; TipoImpressao: Char): Boolean;
begin
  result := true;

  frmSelecionarImpressoras := TfrmSelecionarImpressoras.Create(frmSelecionarImpressoras, TipoImpressao);
  try

    if frmSelecionarImpressoras.ShowModal = mrok then
    begin
      pImpressora := frmSelecionarImpressoras.NomeImpressora;
      if TipoImpressao = 'N' then
        ParSistema.NomeImpressoraNotaMercadorias := pImpressora;

    end
    else
    begin
      result := false;
      MensagemAviso(ctSELECIONARIMPRESSORA);
    end;



  finally
    frmSelecionarImpressoras.Free;
  end;
end;

constructor TfrmSelecionarImpressoras.Create(AOwner: TComponent; TipoImpressao: Char);
var
  a: Integer;
 {$IFNDEF LINUX}
  Str: String;
 {$ENDIF}
begin
  inherited Create(AOwner);
  cmbImpressoras.Items.Clear;
  cmbImpressoras.Items.Add(ctImpDefault);
  for a := 0 to Printer.Printers.Count - 1 do begin
  {$IFDEF LINUX}
    cmbImpressoras.Items.Add(Printer.Printers[a]);
  {$ELSE}
    Str := Copy(Printer.Printers[a], 1, Pos(' on', Printer.Printers[a])-1);
    if Str = '' then
      Str := Printer.Printers[a];
    cmbImpressoras.Items.Add(Str);
  {$ENDIF}
  end;
  cmbImpressoras.ItemIndex := cmbImpressoras.Items.IndexOf(ctImpDefault);
  if (TipoImpressao = 'N') then begin
    if parsistema.NomeImpressoraNotaMercadorias <> '' then
      cmbImpressoras.ItemIndex := cmbImpressoras.Items.IndexOf(parsistema.NomeImpressoraNotaMercadorias);
  end
  else   if (TipoImpressao = 'S') then begin
    if parsistema.NomeImpressoraNotaServicos <> '' then
      cmbImpressoras.ItemIndex := cmbImpressoras.Items.IndexOf(parsistema.NomeImpressoraNotaServicos);
  end
  else if (TipoImpressao = 'C') then begin
    if parsistema.NomeImpressoraCarne <> '' then
      cmbImpressoras.ItemIndex := cmbImpressoras.Items.IndexOf(parsistema.NomeImpressoraCarne);
  end
  else if (TipoImpressao = 'F') then begin
    if parsistema.NomeImpressoraFechamentoCaixa <> '' then
      cmbImpressoras.ItemIndex := cmbImpressoras.Items.IndexOf(parsistema.NomeImpressoraFechamentoCaixa);
  end;
end;

destructor TfrmSelecionarImpressoras.Destroy;
begin
  inherited;
  frmSelecionarImpressoras:= Nil;
end;

procedure TfrmSelecionarImpressoras.bbnOKClick(Sender: TObject);
begin
  inherited;
  NomeImpressora:= cmbImpressoras.Items[cmbImpressoras.ItemIndex];
  ModalResult := mrOk;
end;

procedure TfrmSelecionarImpressoras.SetNomeImpressora(const Value: String);
begin
  if FNomeImpressora <> Value then
    FNomeImpressora:= Value;
end;


initialization
  SelecionarImpressora := SelecionarImpressora_;
end.
