  object qryVisualizarLogParcelas: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doHourGlass, doAutoFillDefs]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'select *'
      'from parcelas_log'
      'where contrato in (select ct.numero'
      '                   from contratos ct'
      
        '                   where coalesce(ct.primogenito, ct.numero) = (' +
        'select coalesce(ct2.primogenito, ct2.numero)'
      
        '                                                                ' +
        'from contratos ct2'
      
        '                                                                ' +
        'where ct2.numero = :contrato)'
      ''
      '                   order by ct.numero)'
      ''
      'order by contrato,trigger_changed,numero,trigger_id;')
    RequestLive = False
    Left = 480
    Top = 136
