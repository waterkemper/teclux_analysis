interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms, 
  Dialogs, dmtecsoft, DB, cpdatasource, ZQuery, ZPgSqlQuery, cpquery,
  StdCtrls, Mask, DBCtrls, cpdbtext, Grids, DBGrids, cpdbgrid,
  frdbcgcoucpf, cptexto, Buttons, ExtCtrls, biblio, ctconstantes, clparametrossistema,
  BiDiDBNavigator, ActnList;

type
  TfraDadosLoginSite = class(TFrame)
    qryUsuarios_Site: TtecQuery;
    dsrUsuarios_Site: TtecDataSource;
    gbxCliente: TGroupBox;
    dtxCodigoCliente: TtecDBText;
    qryUsuarios_Siteusuario: TStringField;
    qryUsuarios_Sitesenha: TStringField;
    qryUsuarios_Sitenome: TStringField;
    qryUsuarios_Sitecliente: TLargeintField;
    qryUsuarios_Sitetipocliente: TStringField;
    qryUsuarios_Sitedatacadastro: TDateTimeField;
    qryUsuarios_Siteultimoacesso: TDateTimeField;
    qryUsuarios_Siteinativo: TDateTimeField;
    qryUsuarios_Siteinativol: TBooleanField;
    qryUsuarios_Siteemail: TStringField;
    qryUsuarios_Sitereset_code: TStringField;
    qryUsuarios_Sitecookie_hash: TStringField;
    qryUsuarios_Siteactivation_code: TStringField;
    qryUsuarios_Sitepessoanumero: TStringField;
    qryUsuarios_Siteofertasemail: TBooleanField;
    qryUsuarios_Siteofertassms: TBooleanField;
    qryUsuarios_Sitetipousuario: TStringField;
    qryUsuarios_Sitecomo_conheceu_site: TStringField;
    qryUsuarios_Sitecodigo_bonus: TStringField;
    qryUsuarios_Siteusuario_indicou: TIntegerField;
    qryUsuarios_Sitevendedor: TIntegerField;
    qryUsuarios_Sitenomecliente: TStringField;
    dtxTipoCliente: TtecDBText;
    dtxNomeCliente: TtecDBText;
    gbxUsuarios: TGroupBox;
    dbgUsuasrios: TtecDBGrid;
    gbxNome: TGroupBox;
    edtNome: TDBEditTexto;
    dbckbInativo: TDBCheckBox;
    gbxEmail: TGroupBox;
    edtEmail: TDBEditTexto;
    fradbcgcoucpf1: Tfradbcgcoucpf;
    gbxSenha: TGroupBox;
    edtSenha: TDBEditTexto;
    pnlBotoesProdutosContratos: TPanel;
    sbnIncluirUsuario: TSpeedButton;
    sbnExcluirUsuario: TSpeedButton;
    sbnGrarSenha: TSpeedButton;
    edtSenhaGerada: TDBEditTexto;
    qryUsuarios_Sitesenhagerada: TStringField;
    sbnSalvarUsuario: TSpeedButton;
    qryUsuarios_Sitetipopessoa: TStringField;
    actHabilitar: TActionList;
    actAbilitar: TAction;
    sbnAbilitar: TSpeedButton;
    qryUsuarios_Sitesenhaauxiliar: TStringField;
    qrymd5: TtecQuery;
    qrymd5senha: TStringField;
    procedure sbnGrarSenhaClick(Sender: TObject);
    procedure sbnIncluirUsuarioClick(Sender: TObject);
    procedure sbnExcluirUsuarioClick(Sender: TObject);
    procedure FrameEnter(Sender: TObject);
    procedure FrameConstrainedResize(Sender: TObject; var MinWidth,
      MinHeight, MaxWidth, MaxHeight: Integer);
    procedure qryUsuarios_SiteNewRecord(DataSet: TDataSet);
    procedure dsrUsuarios_SiteDataChange(Sender: TObject; Field: TField);
    procedure qryUsuarios_SiteBeforePost(DataSet: TDataSet);
