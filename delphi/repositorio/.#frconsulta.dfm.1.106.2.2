    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      
        '  SELECT cast(p.descricao || coalesce('#39' '#39'||p.valorgrade1,'#39#39') || ' +
        'coalesce('#39' '#39'||p.valorgrade2,'#39#39') || coalesce('#39' '#39'||p.referencia,'#39#39 +
        ') as varchar(120) ) as descricao,'
      '        p.valorgrade1,'
      '        p.valorgrade2,'
      '        p.referencia,'
      '        p.codigo, p.codigovisual,'
      '        codigobarras(p.codigo) as codigobarras,'
      '        e.filial,'
      '        e.emestoque,'
      '        e.reservado,'
      '        estoques_preco(e.produto, e.filial) as preco,'
      '        c.peso,'
      
        '        case when e.filial = :FilialBase then 0 else e.filial en' +
        'd as sequencia,'
      '        p.inativo,'
      '        f.mnemonico'
      ''
      '  FROM ((estoques e'
      '        JOIN (produtos p'
      '              join caracteristicas c'
      '              on p.caracteristica = c.codigo)'
      '        ON e.produto = p.codigo)'
      ''
      '        join filiais f'
      '        on e.filial = f.codigo)'
      ''
      '  where p.codigovisual = :produtovisual'
      '    and e.filial = :filial'
      ''
      '')
    RequestLive = False
    Left = 120
    Top = 128
