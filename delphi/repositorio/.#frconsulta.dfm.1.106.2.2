  object qryConsultaNCMTabela: TtecQuery
    Tag = -1
    Database = dtmTecSoft.dbaTecSoft
    Transaction = dtmTecSoft.tstTecSoft
    CachedUpdates = False
    ShowRecordTypes = [ztModified, ztInserted, ztUnmodified]
    Options = [doAutoFillDefs, doUseRowId]
    LinkOptions = [loAlwaysResync]
    Constraints = <>
    AfterOpen = qryConsultaNCMTabelaAfterOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      ';SELECT Classificacao, Codigo, CodigoTIPI,'
      '        CASE WHEN ExTIPI <> '#39'00'#39' THEN NULL'
      '             ELSE Classificacao'
      '        END AS ClassificacaoVisual,'
      '        '
      '        CAST(CASE WHEN ExTIPI = '#39'00'#39' THEN NULL'
      '                  ELSE '#39'Ex.'#39' || ExTIPI'
      '             END AS VARCHAR) AS ExtIPI,'
      '             '
      '        Descricao,'
      
        '        CAST(REPEAT('#39' '#39',(CASE WHEN (SUBSTRING(CodigoTipi,1,2) = ' +
        #39'00'#39' OR LENGTH(CodigoTIPI) = 2) THEN 0'
      '                              WHEN LENGTH(CodigoTipi) = 4 THEN 2'
      
        '                              WHEN LENGTH(CodigoTipi) > 4 THEN L' +
        'ENGTH(CodigoTipi) - 2'
      
        '                         END)) || Descricao AS VARCHAR) AS Descr' +
        'icaoEdentada,'
      '                         '
      '        CASE WHEN SouA = '#39'A'#39' THEN SouA'
      '             ELSE NULL'
      '        END AS SouA,'
      '        Aliquota, secao, CodigoTIPIAUX'
      '        '
      'FROM (SELECT Codigo,'
      '             CASE WHEN ExTIPI IS NOT NULL'
      '                  THEN CodigoTIPI || '#39'.'#39' || ExTIPI'
      '                  ELSE CodigoTIPI'
      '             END AS Codigotipi,'
      '             '
      
        '             CAST(CASE WHEN SUBSTRING(CodigoTIPI,1,2) = '#39'00'#39' THE' +
        'N '#39'SE'#199#195'O '#39' || Secao'
      
        '                       WHEN CodigoTIPI = '#39'99'#39'                THE' +
        'N codigotipi|| '#39'  NF-e'#39
      
        '                       WHEN LENGTH(CodigoTIPI) = 2           THE' +
        'N '#39'Cap. '#39'  || CodigoTIPI'
      
        '                       WHEN LENGTH(CodigoTIPI) = 4           THE' +
        'N CodigoTIPI'
      
        '                       WHEN LENGTH(CodigoTIPI) <= 6          THE' +
        'N SUBSTRING(CodigoTIPI,1,4) || '#39'.'#39' ||'
      
        '                                                                ' +
        '  SUBSTRING(CodigoTIPI,5,2)'
      '                       ELSE SUBSTRING(CodigoTIPI,1,4) || '#39'.'#39' ||'
      '                            SUBSTRING(CodigoTIPI,5,2) || '#39'.'#39' ||'
      '                            SUBSTRING(CodigoTIPI,7,2)'
      '                  END AS VARCHAR) AS Classificacao,'
      ''
      '             CASE WHEN ExTIPI IS NULL THEN '#39'00'#39
      '                  ELSE ExTIPI'
      '             END AS ExtIPI,'
      ''
      '             Descricao,'
      '             SouA,'
      ''
      '             CAST(CASE WHEN SouA  = '#39'A'#39
      '                        THEN CASE WHEN Aliquota IS NULL'
      '                                   THEN CAST('#39'NT'#39' AS VARCHAR)'
      
        '                                   ELSE CAST(aliquota AS VARCHAR' +
        ')'
      '                             END'
      '                        ELSE NULL'
      '                   END AS VARCHAR) AS Aliquota,'
      '             secao, CodigoTIPI as CodigoTIPIAUX'
      '      FROM NCMTabela'
      '      ORDER BY Secao, CodigoTIPI, ExTIPI'
      '      ) AS Selecao'
      '      ')
    RequestLive = False
    Left = 584
    Top = 408
