    BeforeOpen = qryProcuraPedidoBeforeOpen
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <
      item
        DataType = ftUnknown
        Name = 'SQLConsultaPedido'
        ParamType = ptUnknown
      end>
    Sql.Strings = (
      'Select p.numero,'
      '           p.emissao,'
      '           p.fornecedor,'
      '           p.filialfatura,'
      '           p.filialentrega,'
      '           p.filialcobranca,'
      
        '           (SELECT f.nome FROM filiais f WHERE f.codigo = p.fili' +
        'alfatura) AS nomefilialfatura,'
      
        '           (SELECT f.nome FROM filiais f WHERE f.codigo = p.fili' +
        'alentrega) AS nomefilialentrega,'
      
        '           (SELECT f.nome FROM filiais f WHERE f.codigo = p.fili' +
        'alcobranca) AS nomefilialcobranca,'
      '           p.referencia,'
      '           p.database,'
      '           p.fornecedortransporte,'
      '           p.motivo,'
      '           p.fretenota,'
      '           p.fretectr,'
      '           p.desconto1,'
      '           p.desconto2,'
      '           p.desconto3,'
      '           p.desconto4,'
      '           p.acrescimo1,'
      '           p.acrescimo2,'
      '           p.acrescimo3,'
      '           p.acrescimo4,'
      '           p.estado,'
      '           p.entrega,'
      '           p.observacoes,'
      '           p.concluido,'
      '           p.cancelado,'
      '           p.situacao,'
      '           cast(case    when p.situacao = '#39'A'#39' then '#39'ABERTO'#39
      '                        when p.situacao = '#39'C'#39' then '#39'CANCELADO'#39
      '                        when p.situacao = '#39'L'#39' then '#39'CONCLUIDO'#39
      '                        when p.situacao = '#39'P'#39' then '#39'PARCIAL'#39
      
        '                        else                       '#39'PARCIAL LIQU' +
        'IDADO'#39
      '           end as varchar) as descricaosituacao,'
      '           cast(case    when p.situacao = '#39'A'#39' then '#39'ABERTA'#39
      '                        when p.situacao = '#39'C'#39' then '#39'CANCELADA'#39
      '                        when p.situacao = '#39'L'#39' then '#39'CONCLUIDA'#39
      '                        when p.situacao = '#39'P'#39' then '#39'PARCIAL'#39
      
        '                        else                       '#39'PARCIAL LIQU' +
        'IDADA'#39
      '           end as varchar) as descricaosituacao_,'
      '           m.descricao as descricaomotivo,'
      '           cast(0 as numeric(11,2)) as valorproduto,'
      '           cast(0 as numeric(11,2)) as valoripi,'
      '           cast(0 as numeric(11,2)) as totalpedido,'
      '           cast(0 as numeric(11,2)) as totalproduto,'
      '           p.contato,'
      '           f.nome as nomefornecedor'
      'From   ((pedidos p left join motivos m on m.codigo = p.motivo)'
      
        '                  join fornecedores f on p.fornecedor = f.codigo' +
        ')'
      ''
      'Where p.numero =:numero'
      '%SQLConsultaPedido')
    RequestLive = False
    Left = 416
    Top = 64
