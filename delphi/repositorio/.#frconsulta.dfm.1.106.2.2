      '           c.plano,'
      '           c.estado,'
      '           c.rua,'
      '           c.bairro,'
      '           c.cidade,'
      '           c.cep,'
      '           (select d.nome'
      '            from cidades d'
      '            where c.estado = d.estado and'
      '                       c.cidade = d.codigo) as nomecidade,'
      '           (select b.nome'
