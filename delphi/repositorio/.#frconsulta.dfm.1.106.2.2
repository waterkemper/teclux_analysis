    Sql.Strings = (
      ';'
      'select * from (Select v.nome,'
      '       formatar_cpf_cnpj(v.pessoanumero) as pessoanumero,'
      '       v.estado,'
      '       c.nome as nomecidade,'
      '       v.codigo,'
      '       v.civil,'
      '       v.tipo as tipoorig,'
      '       cast(case when v.tipo = '#39'F'#39' then '#39'Fornecedor'#39
      '                 when v.tipo = '#39'C'#39' then '#39'Cliente'#39
      '                 when v.tipo = '#39'L'#39' then '#39'Filiais'#39
      '               end as varchar) as tipo'
      ''
      'From   vfornecedores v'
      '       join cidades c on v.cidade = c.codigo'
      '                     and V.estado = c.estado'
      ''
      'where v.estado = c.estado'
      '  and v.cidade = c.codigo'
      '  '
      '  %SQL'
      ''
      '%FiltroTipoCliente'
      '%CondicaodaConsulta'
      '%JaCadastrado'
      ''
      ') as vfornecedores'
      ''
      'Order By UPPER(TO_ASCII(nome,'#39'LATIN1'#39'))')
