      '        pi.Numero,'
      '        pi.NrPagto,'
      '        pi.DataVencto,'
      '        pi.ValorHistorico,'
      '        pi.ValorContratado,'
      ''
      
        '       (SELECT ValorDevido(pi.Contrato, pi.Tipo, pi.Numero, pi.N' +
        'rPagto,'
      '                           (CASE WHEN pi.Datapagto IS NULL'
      '                                 THEN CURRENT_DATE'
      '                                 ELSE pi.Datapagto '
