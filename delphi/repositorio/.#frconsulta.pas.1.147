procedure TfraConsulta.qryConsultaContratoAfterOpen(DataSet: TDataSet);
begin
  if ParSistema.ControlesVoltadosparaIndustria then
  begin
    qryConsultaContratonumero.DisplayLabel := 'Pedido';
    qryConsultaContratosituacao.Visible := false;
  end;
end;

function TfraConsulta.ExisteContrato(Parametro: integer; Campo, Codigo: String): Boolean;
begin
   case Parametro of
