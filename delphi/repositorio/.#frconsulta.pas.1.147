procedure TfraConsulta.qryConsultaItemProdutosFilterRecord(
  DataSet: TDataSet; var Accept: Boolean);
begin
  if OpcaoInativo = 'ATIVOS' then
    Accept := qryConsultaItemProdutosinativo.IsNull or (qryConsultaItemProdutosinativo.AsDateTime > dtmTecSoft.DataServidor)
  else
  if OpcaoInativo = 'INATIVOS' then
    Accept := not qryConsultaItemProdutosinativo.IsNull and (qryConsultaItemProdutosinativo.AsDateTime <= dtmTecSoft.DataServidor)
  else
    Accept := true;
end;

procedure TfraConsulta.FiltrarDados(Sender: TObject);
var
  vRegistroAtual : TBookMark;
begin
  OpcaoInativo := Jan.cbbOpcao.text;
  vRegistroAtual := Jan.DataSet.GetBookmark;
  Jan.DataSet.Refresh;
  if Jan.DataSet.BookmarkValid(vRegistroAtual) then
  begin
    Jan.DataSet.GotoBookmark(vRegistroAtual);
    Jan.DataSet.FreeBookmark(vRegistroAtual);
  end;

end;

procedure TfraConsulta.qryConsultaProdutosFilterRecord(DataSet: TDataSet;
  var Accept: Boolean);
begin

  if OpcaoInativo = 'ATIVOS' then
