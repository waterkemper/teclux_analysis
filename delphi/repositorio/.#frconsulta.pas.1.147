procedure TfraConsulta.qryConsultaEstoqueItemProdutosBeforeOpen(
  DataSet: TDataSet);
begin
  if parsistema.FiliaisIndependentes then
    qryConsultaEstoqueItemProdutos.MacroByName('FiliaisIndependentes').asString :=
    ' and e.filial = '+inttostr(ifthen(fTipoFilial<>'V', FilialBase, fFilialBasedaVirtual));

  qryConsultaEstoqueItemProdutos.ParamByName('parsistema_LiberarVisualizacaodeModelosProdutos').AsBoolean := parsistema.LiberarVisualizacaodeModelosProdutos;

  if assigned(FCondicoesdaConsulta) then
    FCondicoesdaConsulta;

end;

