constructor TfraConsulta.Create(AOwner: TComponent);
{var
  lField : TField;}
begin
//  manterpadrao := true;
  inherited;
  AbrirTabelaProcura := true;
  qryConsultaNCMTabela.Tag := 10;
  OpcaoInativo := 'ATIVOS';

  //  MD5Itens := T_MD5Itens.Create(True);
  ListaJan := TfrmConsultaPorCampoItens.create(true);

  {
  lField := TStringField.Create(Self);
  lField.FieldName := 'produtolc';
  lField.FieldKind := fkCalculated;
  lField.DisplayLabel := 'Produto';
  lField.DataSet   := TDataSet(qryProcuraItemProdutos);
  }


end;

procedure TfraConsulta.qryProcuraItemProdutosCalcFields(DataSet: TDataSet);
begin

  qryProcuraItemProdutos.fieldbyname('descricaolc').AsString :=
    trim(qryProcuraItemProdutos.fieldbyname('descricao').AsString+' '+
    qryProcuraItemProdutos.fieldbyname('valorgrade1').AsString+' '+
    qryProcuraItemProdutos.fieldbyname('valorgrade2').AsString);
    
end;

