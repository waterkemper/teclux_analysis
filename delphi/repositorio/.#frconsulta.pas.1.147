                                                                                     qryConsultaParcelasImoveisnumero.AsVariant,
                                                                                     qryConsultaParcelasImoveisnrpagto.AsVariant]);
    pesNOTASFILIAIS : dmbasico.ReFazConsulta(qryProcuraNotas,[2],[qryConsultaNotasnumero.AsVariant]);

    pesNIVELSALARIAL: dmbasico.ReFazConsulta(qryProcuraNivelSalarial,[0],[qryConsultaNivelSalarialcodigo.AsInteger]);
    pesMAQUINAS: dmbasico.ReFazConsulta(qryProcuraMaquinas,[0],[qryConsultaMaquinascodigo.AsInteger]);
    pesMAQUINASECF: dmbasico.ReFazConsultapornome(qryProcuraMaquinasECF,['maquina'],[qryConsultaMaquinasECFmaquina.AsString]);
    pesINTERVENCAOECF: dmbasico.ReFazConsultapornome(qryProcuraIntervencaoECF,['intervencao'],[qryConsultaIntervencaoECFintervencao.AsString]);

    pesREGIOES: dmbasico.ReFazConsulta(qryProcuraRegioes,[0],[qryConsultaRegioescodigo.AsString]);

    pesOPERACOES: dmbasico.ReFazConsultapornome(qryProcuraOperacoes,['codigo','nome','C01','C02','C03'],
