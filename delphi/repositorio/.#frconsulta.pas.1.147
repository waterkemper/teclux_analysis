function TfraConsulta.ExisteVendasPerdidas(NOmeCampo, Value: String): Boolean;
const
  SQL = 'and (pg_catalog.to_ascii(cast(%s as varchar),''latin1'') ilike pg_catalog.to_ascii(''%s%s'',''latin1''))';
begin
  if NomeCampo = 'nomevendedor' then
     NomeCampo:= 'u.nome'
  else
  if NomeCampo = 'nomefilial' then
     NomeCampo:= 'f.nome'
  else
  if NomeCampo = 'nomegrupo' then
     NomeCampo:= 'g.descricao'
  else NomeCampo:= 'vp.' + NomeCampo;


  qryConsultaVendasPerdidas.MacrobyName('SQL').AsString := Format(SQL, [NomeCampo, ANSIUpperCase(Value), '%']);
  qryConsultaVendasPerdidas.Close;
  qryConsultaVendasPerdidas.Open;

  Result := qryConsultaVendasPerdidas.RecordCount > 0;
end;

