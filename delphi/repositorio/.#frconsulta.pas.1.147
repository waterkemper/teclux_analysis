function TfraConsulta.ExisteEstoqueItemProduto(Campo,
  Codigo: string): Boolean;
var vCampo : String;
const
  SQL = ' and (upper(to_ascii(%s,''latin1'')) ilike upper(to_ascii(''%s%s'',''latin1'')))';

  SQLNoCliente =
       ' (p.codigo in (select cp.produto '+
                     'from clientesprodutos cp '+
                     'where (upper(pg_catalog.to_ascii(cp.produto_cliente,''latin1'')) '+
                     'ilike upper(pg_catalog.to_ascii(''%s%s'',''latin1''))) ) ) ';

  SQLChaves = ' and (pg_catalog.to_ascii(cast(p.codigo as varchar),''latin1'') ilike pg_catalog.to_ascii(''%s%s'',''latin1'')) '+
              ' or (pg_catalog.to_ascii(cast(p.codigovisual as varchar),''latin1'') ilike pg_catalog.to_ascii(''%s%s'',''latin1'')) '+
              ' or p.codigo in (select pcb.produto from produtoscodigobarras pcb where (pg_catalog.to_ascii(pcb.codigobarras,''latin1'') ilike pg_catalog.to_ascii(''%s%s'',''latin1''))) ';


begin

  qryConsultaEstoqueItemProdutos.parambyname('textopesquisa').asString := '';
  qryConsultaEstoqueItemProdutos.macrobyname('ordenacao').asString := 'ORDER BY UPPER(pg_catalog.TO_ASCII(descricao,''latin1'')), valorgrade1, valorgrade2, sequencia, mnemonico';

  if (campo = 'codigovisual') or
     (campo = 'codigobarras') then
  begin
   if  ParSistema.PesquisarProdutonoCliente then
      qryConsultaEstoqueItemProdutos.macrobyname('SQLInterno').asstring := Format(SQLChaves + ' or ' + SQLNoCliente,
                                                 [Codigo, '%', Codigo, '%', Codigo, '%', Codigo, '%'])
   else
      qryConsultaEstoqueItemProdutos.macrobyname('SQLInterno').asstring := Format(SQLChaves,
                                                 [Codigo, '%', Codigo, '%', Codigo, '%'])
  end
  else
  if(campo='descricao') then
  begin
      vCampo := 'p.descricao || coalesce('' ''||p.valorgrade1,'''') || coalesce('' ''||p.valorgrade2,'''') || coalesce('' ''||p.referencia,'''')';
      qryConsultaEstoqueItemProdutos.macrobyname('SQLInterno').asstring := Format(SQL, [vCampo, Codigo,'%']);
  end
  else
  if (campo = 'valorgrade1') or
     (campo = 'valorgrade2') or
     (campo = 'referencia') then
  begin
    vCampo := 'p.'+campo;
    qryConsultaEstoqueItemProdutos.macrobyname('SQLInterno').asstring := Format(SQL, [vCampo, Codigo,'%']);
  end
  else
  if (campo = 'filial') or
     (campo = 'emestoque') or
     (campo = 'reservado') OR
     (campo = 'futuro') then
  begin
    vCampo := 'e.'+campo;
    qryConsultaEstoqueItemProdutos.macrobyname('SQLInterno').asstring := Format(SQL, [vCampo, Codigo,'%']);
  end
  else
  if (campo = 'peso') then
  begin
    vCampo := 'c.'+campo;
    qryConsultaEstoqueItemProdutos.macrobyname('SQLInterno').asstring := Format(SQL, [vCampo, Codigo,'%']);
  end
  else
  if (campo = 'modelos_agg') then
  begin
    qryConsultaEstoqueItemProdutos.macrobyname('SQLInterno').asstring :=

           ' and c.codigo in (select mc.caracteristica      ' +
           '                  from modeloscaracteristicas mc  ' +
           '                       join modelos mo          ' +
           '                       on mc.modelo = mo.codigo ' +
           ' where upper(pg_catalog.to_ascii(cast(mo.descricao as varchar),''LATIN1'')) ilike upper(pg_catalog.to_ascii(''' + ansiuppercase(codigo) + '%'',''LATIN1'')))'
  end
  else
  if (campo = 'especificacoes_agg') then
  begin
    qryConsultaEstoqueItemProdutos.macrobyname('SQLInterno').asstring :=

           ' and c.codigo in (select mc.caracteristica      ' +
           '                  from modeloscaracteristicas mc  ' +
           '                       join modelos mo          ' +
           '                       on mc.modelo = mo.codigo ' +
           ' where upper(pg_catalog.to_ascii(cast(mo.especificacao as varchar),''LATIN1'')) ilike upper(pg_catalog.to_ascii(''' + ansiuppercase(codigo) + '%'',''LATIN1'')))'
  end
  else

  if (campo = 'comissao_produto') then

  begin
    try
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and c.comissao = '+trocar(currtostr(strtocurr(codigo)),',','.')
    except
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and false';
    end;
  end

  else
  if (campo = 'comissao_grupo') then
  begin
    try
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and g.comissao = '+trocar(currtostr(strtocurr(codigo)),',','.')
    except
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and false';
    end;
  end
  {
  else
  if (campo = 'preco') then
  begin
    try
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and estoques_preco(e.produto, e.filial) = '+trocar(currtostr(strtocurr(codigo)),',','.')
    except
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and false';
    end;
  end
  }
  else
  if (campo = 'preco_normal') then
  begin
    try
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and estoques_preconormal(e.produto, e.filial) = '+trocar(currtostr(strtocurr(codigo)),',','.')
    except
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and false';
    end;
  end
  else
  if (campo = 'preco_promocao') then
  begin
    try
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and estoques_precopromocao(e.produto, e.filial) = '+trocar(currtostr(strtocurr(codigo)),',','.')
    except
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and false';
    end;
  end
  else
  if (Campo = 'pedidos_estoquepedido') then
  begin
    try
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and pedidos_estoquepedido(e.produto, e.filial) = '+trocar(currtostr(strtocurr(codigo)),',','.')
    except
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and false';
    end;
  end
  else
  if (Campo = 'avancado') then
  begin
    try
        qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString :=
          ' and ((p.busca @@ cast(replace(cast(plainto_tsquery(converte_texto(:textopesquisa)) as varchar),'''','''') as tsquery))) ';

        qryConsultaEstoqueItemProdutos.parambyname('textopesquisa').asString := codigo;

        qryConsultaEstoqueItemProdutos.macrobyname('ordenacao').asString := 'ORDER BY rank_achou desc, rank DESC, rank_or DESC';
    except
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and false';
    end;
  end;


  qryConsultaEstoqueItemProdutos.close;

  qryConsultaEstoqueItemProdutos.filtered := false;
  qryConsultaEstoqueItemProdutos.Open;
  qryConsultaEstoqueItemProdutos.filtered := (OpcaoInativo <> 'AMBAS');

  Result := (qryConsultaEstoqueItemProdutos.RecordCount > 0);
end;

procedure TfraConsulta.qryConsultaEstoqueItemProdutosAfterOpen(
  DataSet: TDataSet);
begin
  qryConsultaEstoqueItemProdutosvalorgrade1.Visible := ParSistema.UsarGradesProdutos;
  qryConsultaEstoqueItemProdutosvalorgrade2.Visible := ParSistema.UsarGradesProdutos;
  qryConsultaEstoqueItemProdutospeso.Visible := ParSistema.LiberarVisualizacaoPesoProdutonasPesquisas;
  qryConsultaEstoqueItemProdutosfilial.Visible := not parsistema.FiliaisIndependentes;
  qryConsultaEstoqueItemProdutosmodelos_agg.Visible := parsistema.LiberarVisualizacaodeModelosProdutos; {bloquer false para agilizar o sql}
  qryConsultaEstoqueItemProdutosespecificacoes_agg.Visible := parsistema.LiberarVisualizacaodeModelosProdutos; {bloquer false para agilizar o sql}

end;

