                        qryConsultaOperacoesnome.AsString,
                        qryConsultaOperacoesc01.AsString, qryConsultaOperacoesc02.AsString, qryConsultaOperacoesc03.AsString ]);

    pesNIVEISCONHECIMENTO: dmbasico.ReFazConsulta(qryProcuraNiveislConhecimento,[0],[qryConsultaNiveisConhecimentocodigo.AsInteger]);
    pesMOTIVOSPARADAS: dmbasico.ReFazConsulta(qryProcuraMotivosParadas,[0],[qryConsultaMotivosParadascodigo.AsInteger]);

    pesSETORESPRODUCAO : dmbasico.ReFazConsulta(qryProcuraSetoresProducao,[0],[qryConsultaSetoresProducaocodigo.AsString]);

    pesTURNO : dmbasico.ReFazConsulta(qryProcuraTurnos,[0],[qryConsultaTurnoscodigo.AsInteger]);
    pesSERVICOSLCP116 : dmbasico.ReFazConsulta(qryProcuraServicosLCP116,[0],[qryConsultaServicoslcp116codigo.AsString]);
    pesSERVICOS : dmbasico.ReFazConsulta(qryProcuraServicos,[0],[qryConsultaServicoscodigo.AsString]);

    pesCIDADES, pesCIDADESIBGE: dmbasico.ReFazConsultaPorNome(qryProcuraCidades,['estado','codigo'],[qryConsultaCidadesestado.AsVariant, qryConsultaCidadescodigo.AsVariant]);

    pesCARGOS:  dmbasico.ReFazConsulta(qryProcuraCargos, [0], [qryConsultaCargoscodigo.AsVariant]);
    pesSETORESVENDA: dmbasico.ReFazConsulta(qryProcuraSetoresVenda, [0], [qryConsultaSetoresVendacodigo.AsVariant]);
//    pesMOEDAS: dmbasico.ReFazConsulta(qryProcuraMoedas, [0], [quotedstr(qryConsultaMoedascodigo.Asstring)]);
    pesMOEDAS: dmbasico.ReFazConsulta(qryProcuraMoedas, [0], [qryConsultaMoedascodigo.Asstring]);
    pesFLUXOGRAMA: dmbasico.ReFazConsulta(qryProcuraFluxogramas, [0], [qryConsultaFluxogramascodigo.AsVariant]);
    pesINSTRUCOESTRABALHO: dmbasico.ReFazConsulta(qryProcuraInstrucoesTrabalho, [0], [qryConsultaInstrucoesTrabalhoinstrucao.AsString]);
    pesNATUREZAS:  dmbasico.ReFazConsulta(qryProcuraNaturezas, [0], [qryConsultaNaturezascodigo.AsVariant]);
    pesTIPORECEBIMENTO : dmbasico.ReFazConsulta(qryProcuraTipoRecebimento, [0], [qryConsultaTipoRecebimentocodigo.AsVariant]);

    pesTipoMovimentoEstoque : dmbasico.ReFazConsulta(qryProcuraTipoMovimentos, [0], [qryConsultaTipoMovimentoscodigo.AsVariant]);
    pesColunas : dmbasico.ReFazConsulta(qryProcuraColunas, [0], [qryConsultaColunascodigo.AsVariant]);


    pesTIPOPAGAMENTO : dmbasico.ReFazConsulta(qryProcuraTiposPagamentos, [0], [qryConsultaTiposPagamentoscodigo.AsVariant]);

    pesEXPORTACAODADOS : dmbasico.ReFazConsulta(qryProcuraExportacaoDados, [0], [qryConsultaExportacaoDadoscodigo.AsVariant]);
    pesPLANO: dmbasico.RefazConsulta(qryProcuraPlano,[0],[qryConsultaPlanocodigo.AsVariant]);
    pesTRANSPORTADORES: dmbasico.RefazConsulta(qryProcuraTransportador,[0],[qryConsultaTransportadorcodigo.AsVariant]);

    pesNATUREZASCFOP: begin
                        qryProcuraNaturezasCFOP.MacroByName('codigonatureza').AsString :=
                            'and (n.codigo = :codigonatureza)';
                        dmbasico.ReFazConsulta(qryProcuraNaturezasCFOP,[0,2],
                                 [qryConsultaNaturezasCFOPcodigofiscal.AsVariant,
                                  qryConsultaNaturezasCFOPcodigo.AsVariant]);
                      end;

    pesNATUREZASCFOP_NF: begin

                        dmbasico.ReFazConsultaporNome(qryProcuraNaturezasCFOP_NF,['local', 'codigofiscal','finalidade','natureza'],
                                 ['', qryConsultaNaturezasCFOP_NFcodigofiscal.AsVariant, '1', qryConsultaNaturezasCFOP_NFcodigo.AsVariant]);
                      end;

    pesUSUARIOS: dmbasico.RefazConsulta(qryProcuraUsuarios,[0],[qryConsultaUsuarioscodigo.AsVariant]);

    pesGRUPOSUSUARIOS: dmbasico.RefazConsulta(qryProcuraGruposUsuarios,[0],[qryConsultaGruposUsuarioscodigo.AsVariant]);

    pesCOBRADOR: dmbasico.RefazConsulta(qryProcuraCobrador,[0],[qryConsultaCobradorcodigo.AsVariant]);
    pesTIPOPRODUTO: dmbasico.ReFazConsulta(qryProcuraTipoProduto,[0],[qryConsultaTipoProdutocodigo.AsVariant]);
    pesNATBCCRED: dmbasico.ReFazConsulta(qryProcurapiscofins_t437,[0],[qryConsultapiscofins_t437codigo.AsVariant]);

    pesMODELO: dmbasico.ReFazConsulta(qryProcuraModelo,[0],[qryConsultaModelocodigo.AsVariant]);
    pesEspecificacao: dmbasico.ReFazConsulta(qryProcuraEspecificacao,[0],[qryConsultaEspecificacaoEspecificacao.AsVariant]);

    pesMOTIVOS: dmbasico.ReFazConsulta(qryProcuraMotivos,[0],[qryConsultaMotivoscodigo.AsVariant]);

    pesFALHAS: dmbasico.ReFazConsulta(qryProcuraFalhas,[0],[qryConsultaFalhascodigo.AsVariant]);

    pesQuestionarios : dtmDicionarioDados.ReFazConsultaporNome(dtmDicionarioDados.qryQuestionarios,['codigo'],
                               [dtmDicionarioDados.qryConsultaQuestionarioscodigo.AsVariant]);

    pesEMPREENDIMENTOS   : dmbasico.ReFazConsulta(qryProcuraEmpreendimentos,[0],[qryConsultaEmpreendimentoscodigo.AsVariant]);
    pesBLOCOS            : dmbasico.ReFazConsulta(qryProcuraBlocos,[1],[qryConsultaBlocoscodigo.AsVariant]);
    pesTIPOSUNIDADES     : dmbasico.ReFazConsulta(qryProcuraTiposUnidades,[0],[qryConsultaTiposUnidadescodigo.AsVariant]);
    pesUNIDADES     : dmbasico.ReFazConsulta(qryProcuraUnidades,[0],[qryConsultaUnidadescodigo.AsVariant]);
    pesPROMOCOES    : dmbasico.ReFazConsulta(qryProcuraPromocoes,[0],[qryConsultaPromocoescodigo.AsVariant]);

    pesCashBack    : dmbasico.ReFazConsulta(qryProcuraCashBack,[0],[qryConsultaCashBackcodigo.AsVariant]);
    pesAtributos    : dmbasico.ReFazConsulta(qryProcuraAtributos,[0],[qryConsultaAtributoscodigo.AsVariant]);


    pesLOTETRANSFERENCIA : dmbasico.ReFazConsultapornome(qryProcuraLoteTransferencia,['lotetransferencia'],[qryConsultaLoteTransferencialotetransferencia.AsVariant]);

    pesIMOVEIS           : dmbasico.ReFazConsulta(qryProcuraImoveis,[2],[qryConsultaImoveisnumero.AsVariant]);
    pesLISTACASAMENTO : dmbasico.RefazConsulta(qryProcuraListadeCasamento,[0],[qryConsultaListadeCasamentocodigo.AsVariant]);
    pesORCAMENTO : dmbasico.RefazConsulta(qryProcuraOrcamentos,[0],[qryConsultaOrcamentosCodigo.AsVariant]);
    pesCupons_Desconto : dmbasico.RefazConsulta(qryProcuraCupons_Desconto,[0],[Uppercase(trim(qryConsultaCupons_Descontocodigo_cupom.AsVariant))]);

    pesMVAProtocolos : dmbasico.RefazConsulta(qryProcuraMVAProtocolos,[0],[qryConsultaMVAProtocolosprotocolo.AsVariant]);

  end;
end;

