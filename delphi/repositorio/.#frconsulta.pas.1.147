    pesCONTRATOSMANUTENCAO: dmbasico.ReFazConsulta(qryProcuraContratoManutencao,[0],[qryConsultaContratoManutencaonumero.AsInteger]);

    pesPEDIDOSSAIDA: dmbasico.ReFazConsulta(qryProcuraPedidosSaida,[0],[qryConsultaPedidosSaidanumero.AsInteger]);
    pesOSP: dmbasico.ReFazConsulta(qryProcuraOSP,[1],[qryConsultaOSPnumero.AsInteger]);
    pesREPASSECHEQUES : dmbasico.ReFazConsulta(qryProcuraRepasseCheques,[0],[qryConsultaRepasseChequesnumero.AsInteger]);

    pesCONTRATOSIMOVEIS: dmbasico.ReFazConsulta(qryProcuraContratosImoveis,[0],[qryConsultaContratosImoveiscontrato.AsVariant]);
    pesPARCELASIMOVEIS : dmbasico.ReFazConsulta(qryProcuraParcelasImoveis,[0,1,2,3],[qryConsultaParcelasImoveiscontrato.AsVariant,
