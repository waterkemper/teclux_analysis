function TfraConsulta.TabelaDePesquisaSecundaria: TZDataSet;
begin
  Result := nil
end;

function TfraConsulta.TabelaDoParametro(Parametro: Integer): TZDataSet;
begin
  Result := nil;
  case TipoPesquisa of
   pesESTADOCIDADES:
   begin
      case Parametro of
       0: Result := qryConsultaEstados;
      -1: Result := qryConsultaEstadoCidades;
       else Result := nil;
      end;
   end;
   pesCONTRATOS, pesLicitacoes: result := qryConsultaClientes;
   pesItemAtributoValor : result := qryConsultaItemAtributoElemento;

   pesOrdemservico:
   begin
      case Parametro of
       0: Result := qryConsultaClientes;
       1: Result := qryConsultaEquipamentosClientes;
       else Result := nil;
      end;
   end;
   pesCONTRATOSMANUTENCAO: result := qryConsultaClientes;
   pesPEDIDOSSAIDA: result := qryConsultaClientes;
   pesOSP: result := qryConsultaClientes;
   pesREPASSECHEQUES : result := qryconsultaclientes;
   pesCONTRATOSIMOVEIS: Result:= qryConsultaClientes;
   pesNOTASFILIAIS: result := qryConsultaClientes;
   pesNotasPag :
   begin
    case Parametro of
      0: Result := qryConsultaClientes;
      1: Result := qryConsultaSeriesFornecedor;
    else
      Result := nil;
    end;
   end;

   pesNotas :
   begin
    case Parametro of
      0: Result := qryConsultaClientes;
    else
      Result := nil;
    end;
   end;

   {
   pesNOTASFORNECEDOR : begin
                          case Parametro of
                          0: result := qryConsultaClientes;
                          1: result := qryConsultaSeriesFornecedor;
                          end
                        end;
   }

  end;
end;

function TfraConsulta.ExisteClasse(Campo, Codigo: string): Boolean;
begin
  Result := dmbasico.ExisteCodigo(qryConsultaClasses, campo, codigo);
end;

function TfraConsulta.ExisteCliente(NomeCampo: String;
  Value: Variant): Boolean;
const
  SQL = 'and (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
  SQLNomeRazao = 'and ((to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1'')) or  (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1'')))';
begin
  if ConsultarTodos then
    Result := dmbasico.ExisteCodigo(qryConsultaClientes, NomeCampo, Value)
  else
  begin
    if NomeCampo = 'nomecidade' then
    begin
      NomeCampo:= 'c.nome';
      qryConsultaClientes.MacrobyName('SQL').AsString := Format(SQL, [NomeCampo, ANSIUpperCase(Value), '%']);
    end
    else
    if (NomeCampo = 'razao') or (NomeCampo = 'nome') then
      qryConsultaClientes.MacrobyName('SQL').AsString := Format(SQLNomeRazao, ['v.razao', ANSIUpperCase(Value), '%', 'v.nome', ANSIUpperCase(Value), '%'])
    ELSE
    begin
      NomeCampo:= 'v.' + NomeCampo;
      qryConsultaClientes.MacrobyName('SQL').AsString := Format(SQL, [NomeCampo, ANSIUpperCase(Value), '%']);
    end;

    qryConsultaClientes.Close;
    qryConsultaClientes.Open;

    Result := qryConsultaClientes.RecordCount > 0;
  end;
end;

function TfraConsulta.ExisteGrupo(Campo, Codigo: string): Boolean;
begin
  Result := dmbasico.ExisteCodigo(qryConsultaGrupoProdutos, campo, codigo);
end;

function TfraConsulta.ExisteItemProduto(Campo,
  Codigo: string): Boolean;
const

  SQL = 'and (to_ascii(p.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';

  SQLSomenteProdutosdoCliente =
        'and p.codigo in  (select cp.produto '+
                           ' from clientesprodutos cp '+
                           ' where cp.cliente = :cliente '+
                              ' and cp.tipocliente = :tipocliente) '+
        '  and (to_ascii(p.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';

  SQLProdutosCliente = 'and p.codigo in '+
                          ' (select cp.produto '+
                           ' from clientesprodutos cp '+
                           ' where cp.cliente = :cliente and cp.tipocliente = :tipocliente '+
                              ' and (to_ascii(cp.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1'')))';

  SQLChaves = 'and ( (to_ascii(cast(p.codigovisual as varchar),''latin1'') ilike to_ascii(''%s%s'',''latin1'')) '+
              ' or p.codigo in (select pcb.produto from produtoscodigobarras pcb where (to_ascii(pcb.codigobarras,''latin1'') ilike to_ascii(''%s%s'',''latin1''))) )';

begin

  qryConsultaItemProdutos.MacroByName('SQLInterno').asString := '';
  qryConsultaItemProdutos.parambyname('textopesquisa').asString := '';
  qryConsultaItemProdutos.macrobyname('SQLOrdenacao').asString := 'ORDER BY UPPER(pg_catalog.TO_ASCII(descricao,''latin1'')), valorgrade1, valorgrade2';

  {Utilizado somente na OSP}
  if (campo = 'pn') or (campo = 'produto_cliente') then
    qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').AsString := Format(SQLProdutosCliente, [Campo, ANSIUpperCase(codigo), '%'])
  else
  if SomenteProdutosdoCliente then
    qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').AsString := Format(SQLSomenteProdutosdoCliente, [Campo, ANSIUpperCase(codigo), '%'])
  else
  if (campo = 'codigovisual') or
     (campo = 'codigobarras') then
    qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').AsString := Format(SQLChaves, [ANSIUpperCase(codigo), '%', ANSIUpperCase(codigo), '%'])
  else
  if (campo = 'comissao_produto') then
  begin
    try
      qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').asString := 'and c.comissao = '+trocar(currtostr(strtocurr(codigo)),',','.')
    except
      qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').asString := 'and false';
    end;
  end
  else
  if (campo = 'comissao_grupo') then
  begin
    try
      qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').asString := 'and g.comissao = '+trocar(currtostr(strtocurr(codigo)),',','.')
    except
      qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').asString := 'and false';
    end;
  end
  else
  if (Campo = 'avancado') then
  begin
    try
        qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').asString := '';
        qryConsultaItemProdutos.MacroByName('SQLInterno').asString :=
          ' and ((p.busca @@ cast(replace(cast(plainto_tsquery(converte_texto(:textopesquisa)) as varchar),'''','''') as tsquery))) ';

        qryConsultaItemProdutos.parambyname('textopesquisa').asString := codigo;

        qryConsultaItemProdutos.macrobyname('SQLOrdenacao').asString := 'ORDER BY rank_achou desc, rank DESC, rank_or DESC';
    except
      qryConsultaEstoqueItemProdutos.MacroByName('SQLInterno').asString := 'and false';
    end;
  end
  else
    qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').AsString := Format(SQL, [Campo, ANSIUpperCase(codigo), '%']);

  qryConsultaItemProdutos.close;
  qryConsultaItemProdutos.Open;
  Result := (qryConsultaItemProdutos.RecordCount > 0);
end;

function TfraConsulta.ExisteMarca(Campo, Codigo: String): Boolean;
begin
  Result := dmbasico.ExisteCodigo(qryConsultaMarcas, campo, codigo);
end;

function TfraConsulta.ExisteProduto(Campo, Codigo: string): Boolean;
const
  SQL = 'and (Maiusculo(c.%s) ilike Maiusculo(''%s%s''))';
  SQL2 = 'and c.%s = cast(%s as date)';
  SQLSomenteProdutodoCliente =
        'and c.codigo in  (select distinct p.caracteristica '+
                           ' from clientesprodutos cp '+
                           '      join produtos p '+
                           '      on cp.produto = p.codigo  '+
                           ' where cp.cliente = :cliente '+
                              ' and cp.tipocliente = :tipocliente) '+
        ' and (Maiusculo(c.%s) ilike Maiusculo(''%s%s''))';

  SQLChaves = 'and (to_ascii(cast(c.codigovisual as varchar),''latin1'') ilike to_ascii(''%s%s'',''latin1'')) ';

begin
  if SomenteProdutosdoCliente then
    qryConsultaProdutos.MacroByName('SQL').asString := Format(SQLSomenteProdutodoCliente, [Campo, Codigo, '%'])
  else
  if campo = 'codigovisual' then
    qryConsultaProdutos.MacroByName('SQL').asString := Format(SQLChaves, [ANSIUpperCase(codigo), '%'])
  else
  if (campo = 'datacadastro') or (campo = 'inativo') then
    qryConsultaProdutos.MacroByName('SQL').asString := Format(SQL2, [Campo, quotedstr(Codigo), '%'])
  else
  if (campo = 'comissao_produto') then
  begin
    try
      qryConsultaProdutos.MacroByName('SQL').asString := 'and c.comissao = '+trocar(currtostr(strtocurr(codigo)),',','.')
    except
      qryConsultaProdutos.MacroByName('SQL').asString := 'and false';
    end;
  end
  else
  if (campo = 'comissao_grupo') then
  begin
    try
      qryConsultaProdutos.MacroByName('SQL').asString := 'and g.comissao = '+trocar(currtostr(strtocurr(codigo)),',','.')
    except
      qryConsultaProdutos.MacroByName('SQL').asString := 'and false';
    end;
  end
  else
    qryConsultaProdutos.MacroByName('SQL').asString := Format(SQL, [Campo, Codigo, '%']);

  qryConsultaProdutos.close;
  qryConsultaProdutos.Open;
  Result := (qryConsultaProdutos.RecordCount > 0);
end;



function TfraConsulta.ExisteCaracteristicasProdutosClientes(Campo, Codigo: String): Boolean;
const
  SQL = 'and (Maiusculo(%s) ilike Maiusculo(''%s%s''))';
var
  vCampo : String;
begin
  if      (uppercase(campo) = uppercase('descricaocaracteristica'))         then vCampo := 'c.descricao'
  else if (uppercase(campo) = uppercase('codigocaracteristica'))       then vCampo := 'c.codigo'
  else if (uppercase(campo) = uppercase('codigocaracteristicavisual')) then vCampo := 'c.codigovisual'
  else if (uppercase(campo) = uppercase('ipi'))                        then vCampo := 'c.ipi'
  else if (uppercase(campo) = uppercase('peso'))                       then vCampo := 'c.peso'
  else if (uppercase(campo) = uppercase('codigoproduto'))              then vCampo := 'p.codigo'
  else if (uppercase(campo) = uppercase('codigoprodutovisual'))        then vCampo := 'p.codigovisual'
  else if (uppercase(campo) = uppercase('referencia'))                 then vCampo := 'p.referencia'
  else if (uppercase(campo) = uppercase('descricaoproduto'))           then vCampo := 'p.descricao'
  else if (uppercase(campo) = uppercase('inativo'))                    then vCampo := 'p.inativo'
  else if (uppercase(campo) = uppercase('classificacaofiscal'))        then vCampo := 'i.classificacaofiscal'
  else if (uppercase(campo) = uppercase('pn'))                         then vCampo := 'cp.pn'
  else if (uppercase(campo) = uppercase('CodigodoCliente'))            then vCampo := 'cp.cliente'
  else if (uppercase(campo) = uppercase('tipocliente'))                then vCampo := 'cp.tipocliente'
  else if (uppercase(campo) = uppercase('NomedoCliente'))              then vCampo := 'vf.nome';

  qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asString := Format(SQL, [vCampo, Codigo, '%']);
  qryConsultaCaracteristicasProdutosClientes.close;
  qryConsultaCaracteristicasProdutosClientes.Open;
  Result := (qryConsultaCaracteristicasProdutosClientes.RecordCount > 0);



end;


procedure TfraConsulta.AbreTabelaConsulta(TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
     pesITEMPRODUTOS      : begin
                             if not qryConsultaItemProdutos.active or (assigned(jan) and not jan.ManterParametros)   then
                             begin
                               if SomenteProdutosdoCliente then
                                 qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').AsString :=
                                    'and p.codigo in  (select cp.produto '+
                                                       ' from clientesprodutos cp '+
                                                       ' where cp.cliente = :cliente '+
                                                          ' and cp.tipocliente = :tipocliente)'
                               else
                               if qryConsultaitemprodutos.macrobyname('SQLProdutosAgendamentos').asString = '' then
                                 qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').AsString:= 'and (p.codigo = 0)';

                               qryConsultaItemProdutos.close;
                               qryConsultaItemProdutos.Open;
                             end;
                            end;

     pesLOTESPRODUTOS : begin
                          if not qryConsultaLotesProdutos.active or (assigned(jan) and not jan.ManterParametros)   then
                          begin
                            if qryConsultaLotesProdutos.macrobyname('SQLCondicao').asString = '' then
                              qryConsultaLotesProdutos.MacroByName('SQLCondicao').AsString:= 'and false';

                            qryConsultaLotesProdutos.close;
                            qryConsultaLotesProdutos.open;
                          end;
                        end;

     pesESTOQUESLOTESPRODUTOS : begin
//                          if not qryConsultaEstoquesLotesProdutos.active or (assigned(jan) and not jan.ManterParametros)   then
//                          begin
//                            if qryConsultaLotesProdutos.macrobyname('SQLCondicao').asString = '' then
//                              qryConsultaLotesProdutos.MacroByName('SQLCondicao').AsString:= 'and false';

                            qryConsultaEstoquesLotesProdutos.close;
                            qryConsultaEstoquesLotesProdutos.open;
//                          end;
                        end;


     pesEstoqueItemProdutos,
     pesITEMPRODUTOSCONSULTA
     : begin
                         if not qryConsultaEstoqueItemProdutos.active or (assigned(jan) and not jan.ManterParametros)   then
                         begin
                           qryConsultaEstoqueItemProdutos.Parambyname('FilialBase').AsInteger := FilialBase;
                           qryConsultaEstoqueItemProdutos.macrobyname('SQLInterno').asstring := 'and False';
                           qryConsultaEstoqueItemProdutos.close;

                           qryConsultaEstoqueItemProdutos.open;

                         end;
                       end;


     pesITEMPRODUTOSFIOS,
     pesITEMPRODUTOSFITAS : begin
                             qryConsultaItemProdutos.MacroByName('SQLSomenteProdutosdoCliente').AsString:= 'and true';
                             qryConsultaItemProdutos.close;
                             qryConsultaItemProdutos.Open;
                            end;

     pesPRODUTOS          : begin
                              if not qryConsultaProdutos.active or (assigned(jan) and not jan.ManterParametros)   then
                              begin
                                if SomenteProdutosdoCliente then
                                 qryConsultaProdutos.MacroByName('SQL').asString :=
                                    'and c.codigo in  (select distinct p.caracteristica '+
                                                       ' from clientesprodutos cp '+
                                                       '      join produtos p '+
                                                       '      on cp.produto = p.codigo  '+
                                                       ' where cp.cliente = :cliente '+
                                                          ' and cp.tipocliente = :tipocliente)'
                                else
                                  qryConsultaProdutos.MacroByName('SQL').asString := 'and (c.codigo = 0)';

                                qryConsultaProdutos.close;
                                qryConsultaProdutos.Open;
                             end;   
                            end;

     pesCaracteristicasProdutosClientes : begin

                                            qryConsultaCaracteristicasProdutosClientes.macrobyname('SQLProdutos').asString := 'and false';
                                            qryConsultaCaracteristicasProdutosClientes.Close;
                                            qryConsultaCaracteristicasProdutosClientes.Open;

                                          end;

     pesGRUPOS            : qryConsultaGrupoProdutos.Open;
     pesEQUIPAMENTO       : qryConsultaEquipamento.Open;
     pesMODALIDADEBCICMS  : qryConsultaModalidadeBCICMS.Open;
     pesMODALIDADEBCICMSST: qryConsultaModalidadeBCICMSST.Open;
     pesTRIBUTOSPIS: qryConsultatributospis.Open;
     pesTRIBUTOSCOFINS: qryConsultatributoscofins.Open;
     pesTRIBUTOSIPI       : qryConsultatributosipi.Open;
     pesTRIBUTOSICMS      : qryConsultaTributosICMS.Open;
     pesICMS      : qryConsultaICMS.Open;
     pesIPI      : qryConsultaIPI.Open;

     pesORIGENS      : qryConsultaORIGENS.Open;
     pesOBSLEGAIS      : qryConsultaOBSLEGAIS.Open;

     pesCLASSES           : qryConsultaClasses.Open;
     pesLOCALIZACAOESTOQUE: qryConsultaLocalizacaoEstoque.Open;
     pesMARKETPLACE : qryConsultaMarketPlace.open;
     pesSUBLOCALIZACAOESTOQUE : qryConsultaSubLocalizacaoEstoque.Open;
     pesLISTASPADRAO      : qryConsultaListasPadrao.Open;

     pesNCMTABELAIPI      : qryConsultaNCMTabela.Open;
     pesMARCAS            : qryConsultaMarcas.Open;
     pesGruposFornecedores : qryConsultaGruposFornecedores.open;
     pesCLIENTES,
     pesFORNECEDORES,
     pesFORNECEDORESTRANSPORTE      : begin

                              if qryConsultaClientes.recordcount = 0 then
                              begin

                                if ConsultarTodos then
                                  qryConsultaClientes.MacroByName('SQL').asString := ''
                                else
                                if (qryProcuraCliente.ParamByName('NaoConsiderarTipoCliente').asBoolean) and (tipovfornecedor='') then
                                  qryConsultaClientes.MacroByName('SQL').asString := ' and v.codigo = ' + inttostr(qryProcuraClientecodigo.asInteger)
                                else
                                  qryConsultaClientes.MacroByName('SQL').asString := 'and false';

                                qryConsultaClientes.Close;
                              end;

                              qryconsultaclientes.Open;
                            end;

     pesCONTAS            : qryConsultaContas.Open;

     pesEMPREENDIMENTOS   : qryConsultaEmpreendimentos.Open;
     pesBLOCOS            : qryConsultaBlocos.Open;
     pesTIPOSUNIDADES     : qryConsultaTiposUnidades.Open;
     pesUNIDADES     : qryConsultaUnidades.Open;
     pesPROMOCOES : qryConsultaPromocoes.Open;
     pesCashBack : qryConsultaCashBack.Open;
     pesAtributos : qryConsultaAtributos.Open;

     pesLOTETRANSFERENCIA : qryConsultaLoteTransferencia.OPen;

     pesIMOVEIS           : qryConsultaImoveis.Open;

     pesFILIAIS           :
     begin
       if SomenteFiliaisUsuario then
       begin
         qryConsultaFiliais.Sql.Text := qryConsultaFiliaisSomenteUsuario.Sql.Text;
         qryConsultaFiliais.parambyname('usuario').asinteger := UsuarioLogin.codigousuario;
       end
       else
         qryConsultaFiliais.Sql.Text := qryConsultaFiliaisTodas.Sql.Text;
       qryConsultaFiliais.Open;
     end;

     pesMODELOETIQUETA           : qryConsultaModelosEtiquetas.Open;

     pesNOTASNUMERO       : begin
                              qryConsultaNfSaida.ParamByName('filial').AsInteger:= FilialBase;
                              qryConsultaNfSaida.Open;
                            end;

     pesCUPOMFISCAL       : qryConsultaCupomFiscal.Open;

     pesGRUPOSFILIAIS     :
     begin
       if SomenteFiliaisUsuario then
       begin
         qryConsultaGrupoFiliais.Sql.Text := qryConsultaGrupoFiliaisSomenteUsuario.sql.text;
         qryConsultaGrupoFiliais.parambyname('usuario').asinteger := UsuarioLogin.codigousuario;
       end
       else
         qryConsultaGrupoFiliais.Sql.Text := qryConsultaGrupoFiliaisTodas.sql.text;
       qryConsultaGrupoFiliais.Open;
     end;
     pesVENDEDORES        : qryConsultaVendedores.open;
//     pesHISTORICOCONTABIL : qryConsultaHistorico.Open;

{     pesCONTADEBITO,
     pesCONTACREDITO:
     begin
       qryconsultaconta.Params[0].asinteger := 0;
       qryConsultaConta.Open;
     end;
     }

//     pesCONTAREFERENCIAL: qryConsultaPlanoReferencial.Open;

     pesAGENTES           : qryConsultaAgentes.Open;
     pesCONCEITOS         : qryConsultaConceito.Open;
     pesBANCOS            : qryConsultaBancos.Open;
     pesPEDIDOS           : begin
                              qryConsultaPedido.macrobyname('SQLConsultaPedido').asstring := ' and (p.numero > 0)';
                              qryConsultaPedido.close;
                              qryConsultaPedido.open;
                            end;
     pesSERIESFORNECEDORES : qryConsultaSeriesFornecedor.Open;
     pesSERIES             : qryConsultaSerie.Open;
     {
     pesEVENTO             : begin
                               if FSomenteEventosMais then
                                 qryConsultaEventos.MacroByName('Condicoes').AsString := 'and saida = false and tipo = ''A'''
                               else
                                 qryConsultaEventos.MacroByName('Condicoes').AsString := '';
                               qryConsultaEventos.Open;
                             end;
}
     pesNUMERONOTASPAGPRODUTOS : qryConsultaNotasPagProdutos.Open;
     pesNOTASFORNECEDOR    : qryConsultaNotasPag.Open;

     pesNotasPag          : begin
                              qryConsultaNotasPag.open;
                              qryConsultaClientes.Open;
                              qryConsultaSeriesFornecedor.Open;
                            end;

     pesNotas          : begin
                              qryConsultaNotas.open;
                              qryConsultaClientes.Open;
                            end;


     pesESTADOS            : qryConsultaEstados.Open;
     pesESTADOCIDADES      : begin
                               qryConsultaEstados.Open;
                               qryConsultaEstadoCidades.ParamByName('estado').AsString := qryConsultaEstadoscodigo.AsString;
                               qryConsultaEstadoCidades.Open;
                             end;

     pesCONTRATOS          : qryConsultaClientes.Open;

     pesItemAtributoValor : qryConsultaItemAtributoElemento.Open;

     pesLicitacoes          : qryConsultaClientes.Open;

     pesORDEMSERVICO       : begin
                               if ConsultarTodos then
                               begin
                                 qryConsultaClientes.macrobyname('SQL').asstring := '';
                                 qryConsultaClientes.close;
                                 qryConsultaClientes.Open;
                                 qryConsultaEquipamentosClientes.close;
                                 qryConsultaEquipamentosClientes.Open;
                               end
                               else
                               begin
                                 if not vEncontradoMultiplosRegistros then
                                 begin
                                   qryConsultaClientes.macrobyname('SQL').asstring := 'and false';
                                   qryConsultaClientes.BeforeOpen := nil;
                                   qryConsultaClientes.close;
                                   qryConsultaClientes.Open;
                                   qryConsultaClientes.BeforeOpen := qryConsultaClientesBeforeOpen;

                                   qryConsultaEquipamentosClientes.MacrobyName('CondicaoCliente').AsString := ' false';
                                   qryConsultaEquipamentosClientes.MacrobyName('CondicaoClienteCT').AsString := ' false';
                                   qryConsultaEquipamentosClientes.BeforeOpen := nil;
                                   qryConsultaEquipamentosClientes.close;
                                   qryConsultaEquipamentosClientes.Open;
                                   qryConsultaEquipamentosClientes.BeforeOpen := qryConsultaEquipamentosClientesBeforeOpen;
                                 end
                                 else
                                 begin
                                   qryConsultaClientes.macrobyname('SQL').asstring := '';
                                   qryConsultaClientes.close;
                                   qryConsultaClientes.Open;

                                   qryConsultaEquipamentosClientes.MacrobyName('CondicaoCliente').AsString := ' true';
                                   qryConsultaEquipamentosClientes.MacrobyName('CondicaoClienteCT').AsString := ' true';
                                   qryConsultaEquipamentosClientes.close;
                                   qryConsultaEquipamentosClientes.Open;
                                 end;

                               end;
                             end;

     pesVENDASPERDIDAS : begin
                           if not qryConsultaVendasPerdidas.active then
                           begin
                             qryConsultaVendasPerdidas.macrobyname('SQL').AsString := 'and false';
//                             qryConsultaVendasPerdidas.close;
                             qryConsultaVendasPerdidas.open;
                           end;  
                         end;

     pesCONTRATOSMANUTENCAO : qryConsultaClientes.Open;
     pesPEDIDOSSAIDA       : qryConsultaClientes.Open;
     pesNOTASFILIAIS       : qryConsultaClientes.Open;

     pesOSP                : begin
                               if qryProcuraCliente.Active then
                               begin
                                 if qryProcuraCliente.RecordCount <> 1 then
                                   qryConsultaClientes.Open
                                 else
                                   dmbasico.ReFazConsulta(qryConsultaOSP, [0], [qryprocuraClientecodigo.AsInteger]);
                               end
                               else
                                 qryConsultaClientes.Open;
                             end;

     pesREPASSECHEQUES     : begin
                               if qryProcuraCliente.Active then
                               begin
                                 if qryProcuraCliente.RecordCount <> 1 then
                                   qryConsultaClientes.Open
                                 else
                                   dmbasico.ReFazConsulta(qryConsultaRepasseCheques, [0], [qryprocuraClientecodigo.AsInteger]);
                               end
                               else
                                 qryConsultaClientes.Open;
                             end;


     pesCONTRATOSIMOVEIS   : begin
                               if qryProcuraCliente.Active then
                               begin
                                 if qryProcuraCliente.RecordCount <> 1 then
                                   qryConsultaClientes.Open
                                 else
                                   dmbasico.ReFazConsulta(qryConsultaContratosImoveis, [0,1], [qryprocuraClientecodigo.AsInteger,
                                                                                               qryProcuraClientetipo.AsVariant]);
                               end
                               else
                                 qryConsultaClientes.Open;
                             end;
     pesPARCELASIMOVEIS    : qryConsultaParcelasImoveis.Open;
     pesNIVELSALARIAL      : qryConsultaNivelSalarial.Open;
     pesMAQUINAS           : qryConsultaMaquinas.Open;
     pesMAQUINASECF        : qryConsultaMaquinasECF.Open;
     pesINTERVENCAOECF     : qryConsultaIntervencaoECF.Open;

     pesREGIOES           : qryConsultaRegioes.Open;
     pesOPERACOES          : qryConsultaOperacoes.Open;
     pesNIVEISCONHECIMENTO : qryConsultaNiveisConhecimento.Open;
     pesMOTIVOSPARADAS     : qryConsultaMotivosParadas.Open;
     pesSETORESPRODUCAO    : qryConsultaSetoresProducao.Open;
     pesTURNO              : qryConsultaTurnos.Open;
     pesSERVICOSLCP116     : qryConsultaServicoslcp116.Open;
     pesSERVICOS           : qryConsultaServicos.Open;

     pesCIDADES,pesCIDADESIBGE  : qryConsultaCidades.Open;
     pesCARGOS             : qryConsultaCargos.Open;
     pesSETORESVENDA       : qryConsultaSetoresVenda.Open;
     pesMOEDAS             : qryConsultaMoedas.Open;
     pesFLUXOGRAMA         : qryConsultaFluxogramas.Open;
     pesINSTRUCOESTRABALHO : qryConsultaInstrucoesTrabalho.Open;
     pesNATUREZAS          : qryConsultaNaturezas.Open;
     pesINVENTARIO         : qryConsultaInventario.Open;
     pesIMOBILIZADO        : begin
                               qryConsultaImobilizado.Close;
                               qryConsultaImobilizado.Open;
                             end;
     pesTIPORECEBIMENTO    : qryConsultaTipoRecebimento.Open;

     pesTipoMovimentoEstoque : qryConsultaTipoMovimentos.Open;
     pesColunas : qryConsultaColunas.Open;

     pesTIPOPAGAMENTO    : qryConsultaTiposPagamentos.Open;

     pesEXPORTACAODADOS    : qryConsultaExportacaoDados.Open;
     pesPLANO              : qryConsultaPlano.Open;
     pesTRANSPORTADORES    : qryConsultaTransportador.Open;

     pesNATUREZASCFOP      : qryConsultaNaturezasCFOP.Open;
     pesNATUREZASCFOP_NF   : qryConsultaNaturezasCFOP_NF.Open;

     pesUSUARIOS           : qryConsultaUsuarios.Open;
     pesGRUPOSUSUARIOS     : qryConsultaGruposUsuarios.Open;

     pesCOBRADOR           : qryConsultaCobrador.Open;
     pesTIPOPRODUTO        : qryConsultaTipoProduto.Open;
     pesNATBCCRED          : qryConsultapiscofins_t437.Open;

     pesMODELO        : qryConsultaModelo.Open;
     pesEspecificacao        : qryConsultaEspecificacao.Open;

     pesMOTIVOS        : qryConsultaMotivos.Open;

     pesFALHAS             : qryConsultaFalhas.Open;
     pesQuestionarios  : dtmDicionarioDados.qryConsultaQuestionarios.open; 
