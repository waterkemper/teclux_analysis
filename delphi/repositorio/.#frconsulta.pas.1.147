     pesNIVELSALARIAL     : dmbasico.ReFazConsulta(qryProcuraNivelSalarial,[],[]);
     pesMAQUINAS     : dmbasico.ReFazConsulta(qryProcuraMaquinas,[],[]);
     pesMAQUINASECF     : dmbasico.ReFazConsulta(qryProcuraMaquinasECF,[],[]);
     pesINTERVENCAOECF     : dmbasico.ReFazConsulta(qryProcuraIntervencaoECF,[],[]);

     pesREGIOES     : dmbasico.ReFazConsulta(qryProcuraRegioes,[],[]);

     pesOPERACOES     : dmbasico.ReFazConsulta(qryProcuraOperacoes,[],[]);
     pesNIVEISCONHECIMENTO: dmbasico.ReFazConsulta(qryProcuraNiveislConhecimento,[],[]);
     pesMOTIVOSPARADAS: dmbasico.ReFazConsulta(qryProcuraMotivosParadas,[],[]);
     pesSETORESPRODUCAO: dmbasico.ReFazConsulta(qryProcuraSetoresProducao,[],[]);
     pesTURNO            : dmbasico.ReFazConsulta(qryProcuraTurnos,[],[]);
     pesSERVICOSLCP116    : dmbasico.ReFazConsulta(qryProcuraServicosLCP116,[],[]);
     pesSERVICOS    : dmbasico.ReFazConsulta(qryProcuraServicos,[],[]);

     pesITEMPRODUTOS,
     pesITEMPRODUTOSCONSULTA,
     pesitemPRODUTOSFIOS,
     pesitemPRODUTOSFITAS : dmbasico.refazconsulta(qryProcuraItemProdutos,[],[]);


     pesLOTESPRODUTOS : dmbasico.refazconsulta(qryProcuraLotesProdutos,[],[]);
     pesESTOQUESLOTESPRODUTOS : dmbasico.refazconsulta(qryProcuraEstoquesLotesProdutos,[],[]);


     pesEstoqueItemProdutos : dmbasico.refazconsulta(qryProcuraEstoqueItemProdutos,[],[]);

     pesPRODUTOS          : dmbasico.refazconsulta(qryProcuraProdutos,[],[]);
     pesCaracteristicasProdutosClientes : dmbasico.refazconsulta(qryProcuraCaracteristicasProdutosClientes,[],[]);

     pesGRUPOS            : dmbasico.refazconsulta(qryProcuraGrupoProdutos,[],[]);
     pesEQUIPAMENTO       : dmbasico.refazconsulta(qryProcuraEquipamento,[],[]);
     pesMODALIDADEBCICMS  : dmbasico.refazconsulta(qryProcuraModalidadeBCICMS,[],[]);
     pesMODALIDADEBCICMSST: dmbasico.refazconsulta(qryProcuraModalidadeBCICMSST,[],[]);
     pesTRIBUTOSPIS       : dmbasico.refazconsulta(qryprocuratributospis,[],[]);
     pesTRIBUTOSCOFINS    : dmbasico.refazconsulta(qryprocuratributoscofins,[],[]);
     pesTRIBUTOSIPI       : dmbasico.refazconsulta(qryprocuratributosipi,[],[]);
     pesTRIBUTOSICMS      : dmbasico.refazconsulta(qryprocuraTributosICMS,[],[]);

     pesICMS      : dmbasico.refazconsulta(qryprocuraICMS,[],[]);
     pesIPI      : dmbasico.refazconsulta(qryprocuraIPI,[],[]);

     pesORIGENS      : dmbasico.refazconsulta(qryprocuraORIGENS,[],[]);
     pesOBSLEGAIS      : dmbasico.refazconsulta(qryprocuraOBSLEGAIS,[],[]);

