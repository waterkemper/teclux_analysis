procedure TfraConsulta.AbreTabelaProcura(TipoPesquisa: TtecPesquisa);
begin
  case TipoPesquisa of
     pesCONTRATOS         : dmbasico.ReFazConsulta(qryProcuraContrato,[],[]);
     pesItemAtributoValor : dmbasico.ReFazConsulta(qryProcuraItemAtributoValor,[],[]);
     pesLICITACOES        : dmbasico.ReFazConsulta(qryProcuraLicitacoes,[],[]);

     pesORDEMSERVICO      : dmbasico.ReFazConsulta(qryProcuraOrdemServico,[],[]);
//     pesVENDASPERDIDAS :

     pesCONTRATOSMANUTENCAO : dmbasico.ReFazConsulta(qryProcuraContratoManutencao,[],[]);
     pesPEDIDOSSAIDA      : dmbasico.ReFazConsulta(qryProcuraPedidosSaida,[],[]);
