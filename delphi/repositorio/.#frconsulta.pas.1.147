{
procedure TfraConsulta.ParametrosSeriesFornecedor(fornecedor,
  filialbase: integer; tipofornecedor: String);
begin
  qryProcuraSeriesFornecedor.ParamByName('fornecedor').AsInteger := fornecedor;
  qryProcuraSeriesFornecedor.ParamByName('tipo').AsString := tipofornecedor;
  qryProcuraSeriesFornecedor.ParamByName('filialbase').AsInteger := filialbase;

  qryConsultaSeriesFornecedor.ParamByName('fornecedor').AsInteger := fornecedor;
  qryConsultaSeriesFornecedor.ParamByName('tipo').AsString := tipofornecedor;
  qryConsultaSeriesFornecedor.ParamByName('filialbase').AsInteger := filialbase;

  qryProcuraNotasPagProdutos.ParamByName('fornecedor').AsInteger := fornecedor;
  qryProcuraNotasPagProdutos.ParamByName('tipofornecedor').AsString := tipofornecedor;
//  qryProcuraNotasPagProdutos.ParamByName('incidencia').AsString := ctCOBRADOSUSTITUICAO;

  qryconsultaNotasPagProdutos.ParamByName('fornecedor').AsInteger := fornecedor;
  qryConsultaNotasPagProdutos.ParamByName('tipofornecedor').AsString := tipofornecedor;
//  qryConsultaNotasPagProdutos.ParamByName('incidencia').AsString := ctCOBRADOSUSTITUICAO;

end;
}

