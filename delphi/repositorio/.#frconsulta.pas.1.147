function TfraConsulta.InternoPesquisar(Titulo: String): Integer;
begin
  Result := mrNone;
     {
  if manterpadrao then
  begin
    if not assigned(fJan) then
    begin
    }
      JanelaPesquisa;
      try


        jan.ExisteCodigo := ExisteInformacao;

//        if jan.DataSet = nil then
          jan.DataSet := TabelaDePesquisa;


        jan.TabelaParametro := TabelaDoParametro;
        jan.ProximoControle := ProximoControle;
        if jan.UsarParametrosDaTabela then
          jan.PosicionarTabelaDoParametro:= PosicionarTabelaNoParametro;

        Result := jan.ShowModal(Titulo);
        Jan.PesquisaIniciada := true;

      finally
        CtrlOn:= False;
      end;
   {
    end
    else
    begin
      Jan.consultainterativa := vconsultainterativa;
      Result := jan.ShowModal(Titulo);
      Jan.PesquisaIniciada := true;
    end;
  end
  else
  begin
    JanelaPesquisa;
    try
      jan.ExisteCodigo := ExisteInformacao;
      jan.DataSet := TabelaDePesquisa;
      jan.TabelaParametro := TabelaDoParametro;
      jan.ProximoControle := ProximoControle;
      Jan.consultainterativa := vconsultainterativa;
      if jan.UsarParametrosDaTabela then
        jan.PosicionarTabelaDoParametro:= PosicionarTabelaNoParametro;

      Result := jan.ShowModal(Titulo);
      Jan.PesquisaIniciada := true;
    finally
      CtrlOn:= False;
    end
  end;
  }

end;

function TfraConsulta.InternoPesquisar(Control: TtecFindCustom;
  Titulo: String): Integer;
begin
  CtrlOn := True;
  ActiveControl := Control;
  ActiveControl.SetFocus;
  Result := InternoPesquisar(Titulo);
end;

function TfraConsulta.JanelaPesquisa: TfrmConsultaBasica;
begin
  Result := nil;
end;

procedure TfraConsulta.KeyDown(var Key: Word; Shift: TShiftState);
begin
  inherited;
  Case Key of
    VK_F9     : begin
                   CtrlOn := Shift = [ssCtrl];
                   if (Shift = []) or CtrlOn then
                     InternoPesquisar('');
                 end;
    VK_Escape : {if fsModal in FormState then
                   ModalResult := mrCancel
                 else GG}
                   SetFocusFindCustom(True);
{
    VK_Return,
    VK_Enter: if [ssShift] = Shift then
               begin
                 if ActiveControl is TCustomMemo then
                   Key := 0;
                 SelectNext(ActiveControl, False, True);
               end
               else if ([ssCtrl] = Shift) then
               begin
                 if (dgEditing in TDBGrid(ActiveControl).Options) then
                   SelectNext(ActiveControl, True, True);
               end
               else if [] = Shift then
               begin
                 if ActiveControl is TCustomMemo then
                   Key := 0;
                 if NavegacaoNoControleValida then
                   SelectNext(ActiveControl, True, True)
               end
               else if (Shift = [ssCtrl]) then
               begin
                if WindowState = wsMaximized then
                  WindowState := wsNormal
                else
                 if windowstate = wsnormal then
                   WindowState := wsMaximized;
               end
               else if ([ssAlt] = Shift) and Not (ActiveControl is TCustomMemo) then
                 Key := 0
}
  end;
end;

{
function TfraConsulta.NavegacaoNoControleValida: Boolean;
  function ParentTCustomGrid: Boolean;
  var
    Par: TControl;
  begin
    Result := False;
    if Assigned(ActiveControl) then begin
      Par := ActiveControl.Parent;
      while Assigned(Par) do begin
        if Par is TCustomGrid then begin
          Result := True;
          break
        end;
        Par := Par.Parent
      end
    end
  end;

begin
  Result := Not (((ActiveControl Is TDBGrid) and
                  (Not (dgRowSelect in TDBGrid(ActiveControl).Options))
                   or ParentTCustomGrid
                   ));
end;
}

procedure TfraConsulta.PosicionarTabelaNoParametro(Ind: Integer;
  var continuar: Boolean);
begin

end;

procedure TfraConsulta.ProximoControle(Ind: Integer);
begin
  case TipoPesquisa of
    pesESTADOCIDADES:  dmbasico.ReFazConsulta(qryConsultaEstadoCidades,[0],[qryConsultaEstadoscodigo.AsString]);
    pesCONTRATOS: begin
                    qryConsultaContrato.macrobyname('WhereCliente').AsString := ' and (c.tipocliente = ''' + qryConsultaClientestipoorig.AsString + ''')';
                    dmbasico.ReFazConsulta(qryConsultaContrato, [0], [qryConsultaClientescodigo.AsInteger]);
                  end;

    pesItemAtributoValor: begin

{                            if ind = 0 then
                            begin}
                              dmbasico.ReFazConsultaPorNOme(qryConsultaItemAtributoValor, ['atributo'], [qryConsultaItemAtributoElementoatributo.AsString]);
//                              jan.ConsultaInterativa := true;
{                            end
                            else
                              jan.ConsultaInterativa := false;}

                          end;


    pesLicitacoes: begin
//                    qryConsultaLicitacoes.macrobyname('WhereCliente').AsString := ' and (c.tipocliente = ''' + qryConsultaClientestipoorig.AsString + ''')';
                    dmbasico.ReFazConsultaporNome(qryConsultaLicitacoes, ['cliente'], [qryConsultaClientescodigo.AsInteger]);
                  end;

    pesORDEMSERVICO: begin
                        case ind of
                          0:
                          begin
                            qryConsultaOrdemServico.macrobyname('WhereEquipamento').AsString := '';
                            qryConsultaOrdemServico.parambyname('equipamento').clear;
                            if qryConsultaClientestipoorig.AsString <> '' then
                            begin
                              qryConsultaOrdemServico.macrobyname('WhereCliente').AsString := ' and (c.tipocliente = ''' + qryConsultaClientestipoorig.AsString + ''')';
                              qryConsultaOrdemServico.parambyname('cliente').asinteger := qryConsultaClientescodigo.AsInteger;
                              qryConsultaEquipamentosClientes.MacrobyName('CondicaoCliente').AsString := ' ec.cliente = '+qryConsultaClientescodigo.asstring;
                              qryConsultaEquipamentosClientes.MacrobyName('CondicaoClienteCT').AsString := ' ct.cliente = '+qryConsultaClientescodigo.asstring;
                              qryConsultaEquipamentosClientes.MacrobyName('CondicaoEquipamento').AsString := ' true';
                              qryConsultaEquipamentosClientes.MacrobyName('CondicaoEquipamentoCT').AsString := ' true';
                              qryConsultaEquipamentosClientes.close;
                              qryConsultaEquipamentosClientes.open;
                              qryConsultaOrdemServico.parambyname('equipamento').AsString := qryConsultaEquipamentosClientesequipamento.asstring;
                            end
                            else
                            begin
                              qryConsultaOrdemServico.macrobyname('WhereCliente').AsString := '';
                              qryConsultaOrdemServico.parambyname('cliente').clear;

                              if consultartodos then
                              begin
                                qryConsultaEquipamentosClientes.MacrobyName('CondicaoCliente').AsString := ' true';
                                qryConsultaEquipamentosClientes.MacrobyName('CondicaoEquipamento').AsString := ' true';
                                qryConsultaEquipamentosClientes.MacrobyName('CondicaoClienteCT').AsString := ' true';
                                qryConsultaEquipamentosClientes.MacrobyName('CondicaoEquipamentoCT').AsString := ' true';
                              end
                              else
                              begin
                                qryConsultaEquipamentosClientes.MacrobyName('CondicaoCliente').AsString := ' false';
                                qryConsultaEquipamentosClientes.MacrobyName('CondicaoEquipamento').AsString := ' false';
                                qryConsultaEquipamentosClientes.MacrobyName('CondicaoClienteCT').AsString := ' false';
                                qryConsultaEquipamentosClientes.MacrobyName('CondicaoEquipamentoCT').AsString := ' false';
                              end;

                              qryConsultaEquipamentosClientes.close;
                              qryConsultaEquipamentosClientes.open;
                              if qryConsultaEquipamentosClientes.recordcount <> 0 then
                                qryConsultaOrdemServico.parambyname('equipamento').AsString := qryConsultaEquipamentosClientesequipamento.asstring
                              else
                                qryConsultaOrdemServico.parambyname('equipamento').clear;
                            end;
                            qryConsultaOrdemServico.macrobyname('SemparametrosInformados').asstring := 'false';
                            qryConsultaOrdemServico.close;
                            qryConsultaOrdemServico.open;
                          end;

                          1:
                          begin
                            if qryConsultaEquipamentosClientesequipamento.asstring <> '' then
                            begin
                              qryConsultaOrdemServico.macrobyname('WhereEquipamento').AsString := ' and ((c.equipamento = ''' + qryConsultaEquipamentosClientesequipamento.asstring + ''')'+
                                                                                                  '   or (p.codigovisual = ''' + qryConsultaEquipamentosClientesequipamento.asstring + '''))';

                              qryConsultaOrdemServico.parambyname('equipamento').AsString := qryConsultaEquipamentosClientesequipamento.asstring;
                            end
                            else
                            begin
                              qryConsultaOrdemServico.macrobyname('WhereEquipamento').AsString := '';
                              qryConsultaOrdemServico.parambyname('equipamento').clear;
                            end;
                            qryConsultaOrdemServico.macrobyname('SemparametrosInformados').asstring := 'false';
                            qryConsultaOrdemServico.close;
                            qryConsultaOrdemServico.open;
                          end;
                        end;

                     end;

    pesCONTRATOSMANUTENCAO:
                  begin
                    qryConsultaContratoManutencao.macrobyname('WhereCliente').AsString := ' and (cm.tipocliente = ''' + qryConsultaClientestipoorig.AsString + ''')';
                    dmbasico.ReFazConsulta(qryConsultaContratoManutencao, [0], [qryConsultaClientescodigo.AsInteger]);
                  end;


    pesPEDIDOSSAIDA: dmbasico.ReFazConsulta(qryConsultaPedidosSaida, [0], [qryConsultaClientescodigo.AsInteger]);
    pesOSP: begin
              jan.ConsultaInterativa := true;
              dmbasico.ReFazConsulta(qryConsultaOSP, [0], [qryConsultaClientescodigo.AsInteger]);
            end;

    pesREPASSECHEQUES: begin
              jan.ConsultaInterativa := true;
              qryConsultaRepasseCheques.MacroByName('SQLTipoFornecedor').asstring := 'and rc.tipofornecedor = ' + quotedstr(qryConsultaClientestipoorig.asstring);
              dmbasico.ReFazConsulta(qryConsultaRepasseCheques, [0], [qryConsultaClientescodigo.AsInteger]);
            end;


    pesCONTRATOSIMOVEIS:
    begin
     if ind = 0 then
        dmbasico.ReFazConsulta(qryConsultaContratosImoveis, [0], [qryConsultaClientescodigo.AsInteger]);
    end;

    pesNOTASFILIAIS: dmbasico.ReFazConsulta(qryConsultaNotas, [0], [qryConsultaClientescodigo.AsInteger]);

    pesNotasPag:
    begin
      case Ind of
        0: begin
             Jan.ConsultaInterativa := True;
             PosicionarSerieFornecedor;
           end;
        1: begin
             Jan.ConsultaInterativa := False;
             PosicionarNotaFiscal;
           end;
      end;
    end;

    pesNotas:
    begin
      case Ind of
        0: begin
             Jan.ConsultaInterativa := False;
             PosicionarNotaFiscalSaida;
           end;
      end;
    end;


  end;
end;

procedure TfraConsulta.SelecionarImpressora(Tipo: Char);
begin
  frmSelecionarImpressoras:= TfrmSelecionarImpressoras.Create(Self, Tipo);
  frmSelecionarImpressoras.ShowModal;
  frmSelecionarImpressoras.Free;
end;

procedure TfraConsulta.SetActiveControl(const Value: TWinControl);
begin
  FActiveControl := Value;
end;

procedure TfraConsulta.SetFocusFindCustom(Habilitar: Boolean);
var
  Ctrl: TtecFindCustom;

  function ProcurarControle(Ctrl: TWinControl): TtecFindCustom;
  var
    a: Integer;
  begin
    Result := nil;
    for a := 0 to Ctrl.ControlCount - 1 do
      if Ctrl.Controls[a] is TtecDbEditFind then begin
        Result := TtecDbEditFind(Ctrl.Controls[a]);
        if Result.CanFocus then
          break
      end else if Ctrl.Controls[a] is TtecDBFindLookup then begin
        Result := TtecDBFindLookup(Ctrl.Controls[a]);
        if Result.CanFocus then
          break
      end;
    if Not Assigned(Result) then
      for a := 0 to Ctrl.ControlCount - 1 do
        if Ctrl.Controls[a] is TWinControl then begin
          Result := ProcurarControle(TWinControl(Ctrl.Controls[a]));
          if Assigned(Result) and Result.CanFocus then
           break
        end
  end;
begin
  Ctrl := ProcurarControle(Self);
  if Assigned(Ctrl) then begin
    Ctrl := Ctrl.FirtsControl;
    if Ctrl.CanFocus then
      Ctrl.SetFocus
    else if Habilitar then begin
      Ctrl.Enabled := True;
      Ctrl.SetFocus
    end
  end
end;

function TfraConsulta.TabelaDePesquisa: TZDataSet;
begin

    case TipoPesquisa of
      pesITEMPRODUTOS,
      pesitemPRODUTOSFIOS,
      pesitemPRODUTOSFITAS : Result := qryConsultaItemProdutos;

      pesLOTESPRODUTOS : result := qryconsultaLotesProdutos;
      pesESTOQUESLOTESPRODUTOS : result := qryconsultaEstoquesLotesProdutos;


      pesEstoqueItemProdutos,
      pesitemPRODUTOSCONSULTA : Result := qryConsultaEstoqueItemProdutos;

      pesPRODUTOS     : Result := qryConsultaProdutos;
      pesCaracteristicasProdutosClientes : Result := qryConsultaCaracteristicasProdutosClientes;

      pesGRUPOS       : Result := qryConsultaGrupoProdutos;
      pesEQUIPAMENTO  : Result := qryConsultaEquipamento;
      pesMODALIDADEBCICMS  : Result := qryConsultaModalidadeBCICMS;
      pesMODALIDADEBCICMSST: Result := qryConsultaModalidadeBCICMSST;
      pesTRIBUTOSPIS: Result := qryConsultatributospis;
      pesTRIBUTOSCOFINS: Result := qryConsultatributoscofins;
      pesTRIBUTOSIPI       : Result := qryConsultatributosipi;
      pesTRIBUTOSICMS      : Result := qryConsultaTributosICMS;
      pesICMS      : Result := qryConsultaICMS;
      pesIPI      : Result := qryConsultaIPI;

