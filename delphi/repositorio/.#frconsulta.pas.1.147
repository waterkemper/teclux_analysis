function TfraConsulta.ExisteOrdemServico(Parametro: integer; Campo,
  Codigo: String): Boolean;
begin
   case Parametro of
     0: begin
          jan.ConsultaInterativa := vConsultaInterativa;
          Result := ExisteCliente(campo, codigo);
          if result then
            jan.ConsultaInterativa := true;
        end;
     1: begin
          Result := ExisteEquipamentoCliente(campo, codigo);
          if result then
            jan.ConsultaInterativa := true;
        end;
    -1: begin
          result := ExisteOrdemServico_(campo, codigo);
          if result then
            jan.ConsultaInterativa := true;
        end;
     else
     begin
       Result := False;
       jan.ConsultaInterativa := vConsultaInterativa;
     end;
   end;
end;

function TfraConsulta.ExisteOrdemServico_(NomeCampo: String; Value: Variant): Boolean;
const
  SQL = '(to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  if qryConsultaEquipamentosClientes.recordcount > 0 then
    Result := dmbasico.ExisteCodigo(qryConsultaOrdemServico, Nomecampo, value)
  else
  begin
    jan.ConsultaInterativa := false;
    qryConsultaOrdemServico.macrobyname('SemparametrosInformados').asstring := 'true';
    if nomecampo = 'equipamento' then
      qryConsultaOrdemServico.MacrobyName('SQL').AsString := ' and (' + Format(SQL, [NomeCampo, ANSIUpperCase(Value), '%']) + ' or ' +
                                                                   Format(SQL, ['p.codigovisual', ANSIUpperCase(Value), '%']) + ')'
    else
    if nomecampo = 'pessoanumero' then
      qryConsultaOrdemServico.MacrobyName('SQL').AsString := ' and ' + Format(SQL, [somentenumero(NomeCampo), ANSIUpperCase(Value), '%'])
    else
      qryConsultaOrdemServico.MacrobyName('SQL').AsString := ' and ' + Format(SQL, [NomeCampo, ANSIUpperCase(Value), '%']);

    qryConsultaOrdemServico.Close;
    qryConsultaOrdemServico.Open;
    qryConsultaOrdemServico.MacrobyName('SQL').AsString := '';
    qryConsultaOrdemServico.macrobyname('SemparametrosInformados').asstring := 'false';

    Result := qryConsultaOrdemServico.RecordCount > 0;
  end;
end;

function TfraConsulta.ExisteEquipamentoCliente(NomeCampo: String;
  Value: Variant): Boolean;

const
  SQL = '(to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
var
  vnomecampo: String;

begin

   if qryConsultaClientes.recordcount > 0 then
   begin
     {
     qryConsultaEquipamentosClientes.MacrobyName('CondicaoCliente').AsString := ' and ec.cliente = '+qryConsultaClientescodigo.asstring;
     qryConsultaEquipamentosClientes.Close;
     qryConsultaEquipamentosClientes.Open;
     }
     Result := dmbasico.ExisteCodigo(qryConsultaEquipamentosClientes, NomeCampo, Value);
   end
   else
   begin

     qryConsultaEquipamentosClientes.MacrobyName('CondicaoCliente').AsString := ' true';
     qryConsultaEquipamentosClientes.MacrobyName('CondicaoClienteCT').AsString := ' true';

     qryConsultaEquipamentosClientes.MacrobyName('CondicaoEquipamento').AsString := Format(SQL, [NomeCampo, ANSIUpperCase(Value), '%']);


     vnomecampo := '';
     if nomecampo = 'equipamento' then
       vnomecampo := 'p.codigovisual'
     else
     if (nomecampo = 'modelo') or (nomecampo = 'ano') then
       vnomecampo := ''
     else
       vnomecampo := nomecampo;

     if nomecampo = 'equipamento' then
       qryConsultaEquipamentosClientes.MacrobyName('CondicaoEquipamentoCT').AsString := '(' + Format(SQL, [vNomeCampo, ANSIUpperCase(Value), '%']) +
                                                                                       'or (ct.numero = ' + quotedstr(Value) + '))'

     else
       qryConsultaEquipamentosClientes.MacrobyName('CondicaoEquipamentoCT').AsString := Format(SQL, [vNomeCampo, ANSIUpperCase(Value), '%']);

     qryConsultaEquipamentosClientes.Close;
     qryConsultaEquipamentosClientes.Open;
     Result := qryConsultaEquipamentosClientes.RecordCount > 0;
   end;


end;

