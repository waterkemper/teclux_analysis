procedure TfraConsulta.qryConsultaItemProdutosAfterOpen(DataSet: TDataSet);
var
 i: integer;
begin
  case TipoPesquisa of
    pesITEMPRODUTOS :
    begin
      qryConsultaItemProdutosvalorgrade1.Visible := ParSistema.UsarGradesProdutos;
      qryConsultaItemProdutosvalorgrade2.Visible := ParSistema.UsarGradesProdutos;
      qryConsultaItemProdutospeso.Visible := ParSistema.LiberarVisualizacaoPesoProdutonasPesquisas;

      if not ParSistema.ControlesVoltadosparaIndustria then
      begin
        qryConsultaItemProdutospn.Visible := false;
        qryConsultaItemProdutosproduto_cliente.Visible := false;
      end
      else
      begin
        if qryConsultaItemProdutos.ParamByName('cliente').asinteger = 0 then
        begin
          qryConsultaItemProdutospn.Visible := false;
          qryConsultaItemProdutosproduto_cliente.Visible := false;
        end
        else
        begin
          qryConsultaItemProdutospn.Visible := true;
          qryConsultaItemProdutosproduto_cliente.Visible := true;
        end;
      end;

    end;
    pesITEMPRODUTOSFIOS :
    begin
      for i:=0 to qryConsultaItemProdutos.fieldcount -1 do
      begin
        if (qryConsultaItemProdutos.Fields[i].FieldName = 'codigovisual') or
           (qryConsultaItemProdutos.Fields[i].FieldName = 'bitola') or
           (qryConsultaItemProdutos.Fields[i].FieldName = 'liga') or
           (qryConsultaItemProdutos.Fields[i].FieldName = 'resistividade') or
           (qryConsultaItemProdutos.Fields[i].FieldName = 'tolerancia') then
          qryConsultaItemProdutos.Fields[i].Visible := true
        else
          qryConsultaItemProdutos.Fields[i].Visible := false;
      end;
    end;
    pesITEMPRODUTOSFITAS :
    begin
      for i:=0 to qryConsultaItemProdutos.fieldcount -1 do
      begin
        if (qryConsultaItemProdutos.Fields[i].FieldName = 'codigovisual') or
           (qryConsultaItemProdutos.Fields[i].FieldName = 'bitola') or
           (qryConsultaItemProdutos.Fields[i].FieldName = 'largura') or
           (qryConsultaItemProdutos.Fields[i].FieldName = 'liga') then
          qryConsultaItemProdutos.Fields[i].Visible := true
        else
          qryConsultaItemProdutos.Fields[i].Visible := false;
      end;
    end;
  end;
end;

