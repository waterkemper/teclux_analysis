procedure TfraConsulta.Selecionar(TipoPesquisa: TTecPesquisa);
var Filial: Integer;
begin
  case TipoPesquisa of
    pesITEMPRODUTOS,
    pesitemPRODUTOSFIOS,
    pesitemPRODUTOSFITAS : dmbasico.RefazConsultapornome(qryProcuraitemProdutos,['produtovisual'],[qryConsultaItemProdutoscodigovisual.AsVariant]);

    pesLOTESPRODUTOS : dmbasico.RefazConsultapornome(qryProcuraLotesProdutos,['produto','nrlote'],
       [qryConsultaLotesProdutosproduto.AsString,
        qryConsultaLotesProdutosnrlote.AsVariant]);

    pesESTOQUESLOTESPRODUTOS : dmbasico.RefazConsultapornome(qryProcuraEstoquesLotesProdutos,['produto','filial','nrlote'],
       [qryConsultaEstoquesLotesProdutosproduto.AsString,
        qryConsultaEstoquesLotesProdutosfilial.AsString,
        qryConsultaEstoquesLotesProdutosnrlote.AsVariant]);

    pesitemPRODUTOSCONSULTA : dmbasico.RefazConsultapornome(qryProcuraitemProdutos,['produtovisual'],[qryConsultaEstoqueItemProdutoscodigovisual.AsVariant]);
    pesEstoqueitemPRODUTOS : dmbasico.RefazConsultapornome(qryProcuraEstoqueItemProdutos,['PorCodigoBarra','produtovisual', 'filial'],
                                  [false, qryConsultaEstoqueItemProdutoscodigovisual.AsVariant, qryConsultaEstoqueItemProdutosfilial.AsVariant]);

    pesPRODUTOS     : dmbasico.RefazConsultapornome(qryProcuraProdutos,['caracteristicavisual'],[qryConsultaProdutoscodigovisual.AsVariant]);

    pesCaracteristicasProdutosClientes : dmbasico.RefazConsultaporNome(qryProcuraCaracteristicasProdutosClientes,
                                                   ['cliente','tipocliente','produto'{,'pn'}],
                                                   [qryConsultaCaracteristicasProdutosClientescodigodocliente.AsVariant,
                                                    qryConsultaCaracteristicasProdutosClientestipocliente.AsString,
                                                    qryConsultaCaracteristicasProdutosClientescodigoproduto.asstring {,
                                                    qryConsultaCaracteristicasProdutosClientespn.AsString}]);

    pesGRUPOS       : dmbasico.RefazConsulta(qryProcuraGrupoProdutos,[0],[qryConsultaGrupoProdutoscodigo.AsVariant]);
    pesEQUIPAMENTO : dmbasico.RefazConsulta(qryProcuraEquipamento,[0],[qryConsultaEquipamentocodigo.AsVariant]);
    pesMODALIDADEBCICMS  : dmbasico.RefazConsulta(qryProcuraModalidadeBCICMS,[0],[qryConsultaModalidadeBCICMScodigo.AsVariant]);
    pesMODALIDADEBCICMSST: dmbasico.RefazConsulta(qryProcuraModalidadeBCICMSST,[0],[qryConsultaModalidadeBCICMSSTcodigo.AsVariant]);
    pesTRIBUTOSPIS: dmbasico.RefazConsulta(qryProcuratributospis,[0],[qryConsultatributospiscodigo.AsVariant]);
    pesTRIBUTOSCOFINS: dmbasico.RefazConsulta(qryProcuratributoscofins,[0],[qryConsultatributoscofinscodigo.AsVariant]);
    pesTRIBUTOSIPI       : dmbasico.RefazConsulta(qryProcuratributosipi,[0],[qryConsultatributosipicodigo.AsVariant]);
    pesTRIBUTOSICMS      : dmbasico.RefazConsulta(qryProcuraTributosICMS,[0],[qryConsultaTributosICMScodigo.AsVariant]);

    pesICMS      : dmbasico.RefazConsulta(qryProcuraICMS,[0],[qryConsultaICMScodigo.AsVariant]);
    pesIPI      : dmbasico.RefazConsulta(qryProcuraIPI,[0],[qryConsultaIPIcodigo.AsVariant]);

    pesORIGENS      : dmbasico.RefazConsulta(qryProcuraORIGENS,[0],[qryConsultaORIGENScodigo.AsVariant]);

    pesOBSLEGAIS      : dmbasico.RefazConsulta(qryProcuraOBSLEGAIS,[0],[qryConsultaOBSLEGAIScodigo.AsVariant]);

    pesCLASSES      : dmbasico.RefazConsulta(qryProcuraClasses,[0],[qryConsultaClassescodigo.AsVariant]);
    pesLOCALIZACAOESTOQUE : dmbasico.RefazConsulta(qryProcuraLocalizacaoEstoque,[0],[qryConsultaLocalizacaoEstoqueLocalizacao.AsVariant]);
    pesMARKETPLACE : dmbasico.RefazConsulta(qryProcuraMarketPlace,[0],[qryConsultaMarketPlaceCodigo.AsVariant]);
    pesSUBLOCALIZACAOESTOQUE : dmbasico.RefazConsulta(qryProcuraSubLocalizacaoEstoque,[0],[qryConsultaSubLocalizacaoEstoqueSubLocalizacao.AsVariant]);

    pesLISTASPADRAO : dmbasico.RefazConsulta(qryProcuraListasPadrao,[0],[qryConsultaListasPadraocodigo.AsVariant]);

    pesNCMTABELAIPI : dmbasico.RefazConsulta(qryProcuraNCMTabela,[0],[qryConsultaNCMTabelacodigotipi.AsVariant]);
    pesMARCAS       : dmbasico.RefazConsulta(qryProcuraMarca, [0], [qryConsultaMarcascodigo.AsVariant]);
    pesGruposFornecedores  : dmbasico.RefazConsulta(qryProcuraGruposFornecedores, [0], [qryConsultaGruposFornecedorescodigo.AsVariant]);

    pesCLIENTES,
    pesFORNECEDORES: begin
                        if qryConsultaClientes.RecordCount > 0 then
                          dmbasico.RefazConsultaporNome(qryProcuraCliente,
                                            ['codigo','tipocliente','NaoConsiderarTipoCliente'],
                                            [qryConsultaClientescodigo.AsVariant,
                                             qryConsultaClientestipoorig.AsVariant,
                                             False]);
                        qryProcuraCliente.Parambyname('tipocliente').AsString:=qryConsultaClientestipoorig.AsString;
                      end;

    pesFORNECEDORESTRANSPORTE : begin
                        if qryConsultaClientes.RecordCount > 0 then
                          dmbasico.RefazConsultaporNome(qryProcuraCliente,
                                            ['codigo','tipocliente','NaoConsiderarTipoCliente'],
                                            [qryConsultaClientescodigo.AsVariant,
                                             qryConsultaClientestipoorig.AsVariant,
                                             True]);
                        qryProcuraCliente.Parambyname('tipocliente').AsString:=qryConsultaClientestipoorig.AsString;
                      end;

    pesFILIAIS      : begin
                        dmbasico.refazconsulta(qryProcurafiliais,[0],[qryConsultaFiliaiscodigo.AsVariant]);
                        qryProcuraFiliais.fieldbyname('codigo').FocusControl;
                      end;
    pesMODELOETIQUETA       : dmbasico.RefazConsulta(qryProcuraModelosEtiquetas, [0], [qryConsultaModelosEtiquetascodigo.AsVariant]);
    pesCONTAS       : begin
                        dmbasico.RefazConsultaPorNome(qryProcuraContas,['Conta'],[qryConsultaContasconta.AsVariant]);
                        qryProcuraContas.fieldbyname('conta').FocusControl;
                      end;
    pesIMOBILIZADO  : dmbasico.RefazConsultaPorNome(qryProcuraImobilizado,['numero'],[qryConsultaimobilizadonumero.AsVariant]);
    pesGRUPOSFILIAIS: dmbasico.refazconsulta(qryProcuragrupofiliais,[0],[qryConsultaGrupoFiliaiscodigo.AsVariant]);
    pesVENDEDORES   : dmbasico.refazconsulta(qryProcuraVendedores,[0],[qryConsultaVendedorescodigo.AsVariant]);
//    pesHISTORICOCONTABIL : dmbasico.ReFazConsulta(qryProcuraHistorico,[0],[qryConsultaHistoricocodigo.AsVariant]);
//    pesCONTADEBITO  : dmbasico.ReFazConsulta(qryProcuraDebitar,[0,1],[qryConsultaContacodigo.AsVariant,0]);
//    pesCONTACREDITO : dmbasico.ReFazConsulta(qryProcuraCreditar,[0,1],[qryConsultaContacodigo.AsVariant,0]);
//    pesCONTAREFERENCIAL : dmbasico.ReFazConsulta(qryProcuraPlanoReferencial,[0],[qryConsultaPlanoReferencialcodigo.AsVariant]);
    pesAGENTES      : dmbasico.RefazConsulta(qryProcuraAgentes,[0],[qryConsultaAgentescodigo.AsVariant]);
    pesCONCEITOS    : dmbasico.ReFazConsulta(qryProcuraConceito,[0],[qryConsultaConceitocodigo.AsVariant]);
    pesBANCOS       : dmbasico.ReFazConsulta(qryProcuraBancos,[0],[qryConsultaBancosCodigo.AsVariant]);
    pesPEDIDOS      : dmbasico.ReFazConsulta(qryProcuraPedido,[0],[qryConsultaPedidonumero.AsVariant]);
    pesSERIESFORNECEDORES       : dmbasico.ReFazConsulta(qryProcuraSeriesFornecedor,[1],[qryConsultaSeriesFornecedorserie.AsVariant]);
    pesSERIES       : dmbasico.ReFazConsulta(qryProcuraSerie,[1],[qryConsultaSerieSerie.AsVariant]);

    //pesEVENTO       : dmbasico.ReFazConsulta(qryProcuraEventos,[0],[qryConsultaEventoscodigo.AsVariant]);

    pesNOTASNUMERO  : begin
                        Filial := Filialbase;
                        dmbasico.ReFazConsulta(qryProcuraNFSaida,[1,2,3],[Filial, qryConsultaNfSaidaserie.AsString, qryConsultaNfSaidanumero.AsVariant]);
                      end;

    pesCUPOMFISCAL  : dmbasico.ReFazConsultapornome(qryProcuraCupomFiscal,
                      ['filial','maquina','intervencao','numero'],
                      [qryConsultaCupomFiscalfilial.asinteger,
                       qryConsultaCupomFiscalmaquina.AsInteger,
                       qryConsultaCupomFiscalintervensao.AsInteger,
                       qryConsultaCupomFiscalnumero.AsInteger]);

    pesNUMERONOTASPAGPRODUTOS : dmbasico.ReFazConsulta(qryProcuraNotasPagProdutos,[2,3],[
                                      qryConsultaNotasPagProdutosserie.AsVariant,
                                      qryConsultaNotasPagProdutosnumero.AsVariant]);
    pesNOTASFORNECEDOR : dmbasico.ReFazConsultapornome(qryProcuraNotasPag,['numero'],[qryConsultaNotasPagnumero.AsVariant]);
    
    pesNotasPag : dmbasico.ReFazConsultapornome(qryProcuraNotasPag,['fornecedor','tipofornecedor','serie','numero'],
                          [qryConsultaNotasPagfornecedor.AsVariant, qryConsultaNotasPagtipofornecedor.AsVariant,
                           qryConsultaNotasPagserie.AsVariant, qryConsultaNotasPagnumero.AsVariant]);

    pesNotas : dmbasico.ReFazConsultapornome(qryProcuraNotas,['filial','serie','numero'],
                          [qryConsultaNotasfilial.AsVariant,
                           qryConsultaNotasserie.AsVariant, qryConsultaNotasnumero.AsVariant]);


    pesESTADOS: dmbasico.ReFazConsulta(qryProcuraEstados,[0],[qryConsultaEstadosCodigo.AsVariant]);
    pesESTADOCIDADES: dmbasico.ReFazConsulta(qryProcuraEstadoCidades,[0,1,2],[qryConsultaEstadoCidadesestado.AsVariant,qryConsultaEstadoCidadescodigo.AsVariant]);
    pesCONTRATOS: dmbasico.ReFazConsulta(qryProcuraContrato,[0],[qryConsultaContratonumero.AsString]);

    pesItemAtributoValor: dmbasico.ReFazConsultapornome(qryProcuraItemAtributoValor,['atributo','valor'],
       [qryConsultaItemAtributoElementoatributo.asString, qryConsultaItemAtributoValorvalor.AsString]);

    pesLicitacoes: dmbasico.ReFazConsultaporNome(qryProcuraLicitacoes,['numero'],[qryConsultaLicitacoesnumero.AsString]);

    pesORDEMSERVICO: dmbasico.ReFazConsulta(qryProcuraOrdemServico,[0],[qryConsultaOrdemServiconumero.AsString]);
