     pesREPASSECHEQUES    : dMbasico.RefazConsulta(qryProcuraRepasseCheques,[],[]);
     pesCONTRATOSIMOVEIS  : dmbasico.ReFazConsulta(qryProcuraContratosImoveis,[],[]);
     pesPARCELASIMOVEIS   : dmbasico.ReFazConsulta(qryProcuraParcelasImoveis,[],[]);
     pesNOTASFILIAIS      : dmbasico.ReFazConsulta(qryProcuraNotas,[],[]);
     pesNOTASFORNECEDOR   : dmbasico.ReFazConsulta(qryProcuraNotaspag,[],[]);
     pesNotasPag          : dmbasico.ReFazConsulta(qryProcuraNotaspag,[],[]);
