function TfraConsulta.PosicionarSerieFornecedor: Boolean;
begin
  dtmBasico.ReFazConsultaPorNome(qryConsultaSeriesFornecedor,
                                 ['fornecedor','tipo','filialbase'],
       [qryConsultaClientescodigo.AsInteger, qryConsultaClientestipoorig.AsString,
       ffilialbase]);
  Result := qryConsultaSeriesFornecedor.RecordCount > 0;

end;

procedure TfraConsulta.PosicionarNotaFiscal;
begin

  qryConsultaNotasPag.macrobyname('tipofornecedor').asString := quotedstr(qryConsultaClientestipoorig.asString);

  ReFazConsultaPorNome(qryConsultaNotasPag, ['fornecedor','serie'],
    [qryConsultaClientescodigo.asInteger, qryConsultaSeriesFornecedorserie.asString]);

//  Result := qryConsultaNotasPag.RecordCount > 0;
end;

