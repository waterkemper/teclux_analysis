function TfraConsulta.ExisteLotesProdutos(Campo, Codigo: string): Boolean;
{
begin

  Result := dmbasico.ExisteCodigo(qryConsultaLotesProdutos, campo, codigo);
end;
}

const
  SQL = 'and (to_ascii(l.%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';

  SQLChaves = 'and ( (to_ascii(cast(p.codigovisual as varchar),''latin1'') ilike to_ascii(''%s%s'',''latin1'')) '+
              ' or p.codigo in (select pcb.produto from produtoscodigobarras pcb where (to_ascii(pcb.codigobarras,''latin1'') ilike to_ascii(''%s%s'',''latin1''))) )';

  SQLDescricao = 'and ( (to_ascii(cast(p.descricao as varchar),''latin1'') ilike to_ascii(''%s%s'',''latin1'')) ';

begin

  qryConsultaLotesProdutos.MacroByName('SQLCondicao').asString := '';

  {Utilizado somente na OSP}
  if (campo = 'produtovisual') or
     (campo = 'codigobarras') then
    qryConsultaLotesProdutos.MacroByName('SQLCondicao').AsString := Format(SQLChaves, [ANSIUpperCase(codigo), '%', ANSIUpperCase(codigo), '%'])
  else
  if (campo = 'descricaoproduto') then
    qryConsultaLotesProdutos.MacroByName('SQLCondicao').AsString := Format(SQLDescricao, [ANSIUpperCase(codigo), '%'])
  else
    qryConsultaLotesProdutos.MacroByName('SQLCondicao').AsString := Format(SQL, [Campo, ANSIUpperCase(codigo), '%']);

  qryConsultaLotesProdutos.close;
  qryConsultaLotesProdutos.Open;
  Result := (qryConsultaLotesProdutos.RecordCount > 0);
end;

