procedure TfraConsulta.qryConsultaItemProdutoscomissao_grupoGetText(
  Sender: TField; var Text: String; DisplayText: Boolean);
begin
  if qryConsultaItemProdutoscomissao_grupo.asCurrency <> 0 then
  begin
    if qryConsultaItemProdutostipocomissao_grupo.asString = 'V' then
      Text := qryConsultaItemProdutoscomissao_grupo.asString + ' V'
    else
      Text := qryConsultaItemProdutoscomissao_grupo.asString + ' P'
  end;

end;

