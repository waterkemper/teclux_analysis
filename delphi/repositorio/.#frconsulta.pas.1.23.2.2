function TfraConsulta.ExisteCliente(NomeCampo: String;
  Value: Variant): Boolean;
const
  SQL = 'and (to_ascii(%s,''latin1'') ilike to_ascii(''%s%s'',''latin1''))';
begin
  if ConsultarTodos then
    Result := dmbasico.ExisteCodigo(qryConsultaClientes, NomeCampo, Value)
  else
  begin
    if NomeCampo = 'nomecidade' then
         NomeCampo:= 'c.nome'
    else NomeCampo:= 'v.' + NomeCampo;

    qryConsultaClientes.Sql[20]:= Format(SQL, [NomeCampo, ANSIUpperCase(Value), '%']);
    qryConsultaClientes.Open;
    Result := qryConsultaClientes.RecordCount > 0;
  end;
end;

