function TfraConsulta.ExisteProduto(Campo, Codigo: string): Boolean;
const
  SQL = 'Where (Maiusculo(c.%s) ilike Maiusculo(''%s%s''))';
  SQLSomenteProdutodoCliente =
        'Where c.codigo in  (select distinct p.caracteristica '+
                           ' from clientesprodutos cp '+
                           '      join produtos p '+
                           '      on cp.produto = p.codigo  '+
                           ' where cp.cliente = :cliente '+
                              ' and cp.tipocliente = :tipocliente) '+
        ' and (Maiusculo(c.%s) ilike Maiusculo(''%s%s''))';

begin
  if SomenteProdutosdoCliente then
    qryConsultaProdutos.Sql[04]:= Format(SQLSomenteProdutodoCliente, [Campo, Codigo, '%'])
  else
    qryConsultaProdutos.Sql[04]:= Format(SQL, [Campo, Codigo, '%']);

  qryConsultaProdutos.Open;
  Result := (qryConsultaProdutos.RecordCount > 0);
end;


