  inherited qryProcuraItemProdutos: TtecQuery
    Sql.Strings = (
      ''
      'select p.codigo as produto,'
      '       p.codigovisual as produtovisual,'
      '       p.codigo,'
      '       p.codigovisual,'
      
        'cast(p.descricao || coalesce('#39' '#39'||p.valorgrade1,'#39#39') || coalesce(' +
        #39' '#39'||p.valorgrade2,'#39#39') || coalesce('#39' '#39'||p.referencia,'#39#39') as varc' +
        'har(120) ) as descricao,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      '      (select gr.descricao'
      '       from grades gr'
      '       where gr.codigo = c.grade1) as linha,'
      ''
      '      (select gr.descricao'
      '       from grades gr'
      '       where gr.codigo = c.grade2) as coluna,'
      ''
      '       c.unidade,'
      ''
      '      (select cp.pn'
      '       from clientesprodutos cp'
      '       where cp.produto = p.codigo and'
      '             cp.cliente=:cliente and'
      '             cp.tipocliente = :tipocliente) as pn,'
      ''
      '      (select cp.produto_cliente'
      '       from clientesprodutos cp'
      '       where cp.produto = p.codigo and'
      '             cp.cliente = :cliente and'
      '             cp.tipocliente = :tipocliente) as produto_cliente,'
      '      p.caracteristica,'
      '      c.codigovisual as caracteristicavisual,'
      '      c.setorproducao,'
      '      p.referencia,'
      '      c.grupo,'
      '      g.descricao as descricaogrupo,'
      '      c.classe,'
      '      cl.descricao as descricaoclasse'
      ''
      'from (produtos p'
      '     join (((caracteristicas c'
      '             join classes cl'
      '             on c.classe=cl.codigo)'
      '            join grupos g'
      '            on g.codigo=c.grupo)'
      '           join marcas m'
      '           on c.marca = m.codigo)'
      '     on p.caracteristica = c.codigo)'
      
        'where ( upper(to_ascii(p.codigovisual,'#39'latin1'#39')) = upper(to_asci' +
        'i(:produtovisual,'#39'latin1'#39')) or'
      ''
      #9#9'p.codigo in (select pcb.produto'
      '                      from produtoscodigobarras pcb'
      '                      where pcb.codigobarras = :produtovisual)'
      ''
      #9'   )'
      #9'   '
      '%SQLProdutosJaSelecionados'
      '%SQLFiltroItemProdutos'
      '%SQLFiltroProdutos'
      '%SQLFiltroGrupos'
      '%SQLFiltroClasses'
      '%SQLFiltroMarcas'
      '%SQLFiltroGruposFornecedores'
      '%SQLFiltroTipoProduto'
      '%SQLFiltroFornecedor'
      '%SQLFiltroLocalizacao'
      '%SQLFiltroPedidos'
      '%SQLProdutosAgendamentos'
      '%SQLFiltroFioseFitas'
      ''
      ''
      ''
      '/*'
      ''
      ':FilialBase'
      ''
      '*/')
  end
  inherited qryConsultaItemProdutos: TtecQuery
    Sql.Strings = (
      'Select p.codigo,'
      '       p.codigovisual,'
      ''
      ' codigobarras(p.codigo) as codigobarras,'
      
        '       cast(p.descricao || coalesce('#39' '#39'||p.valorgrade1,'#39#39') || co' +
        'alesce('#39' '#39'||p.valorgrade2,'#39#39') || coalesce('#39' '#39'||p.referencia,'#39#39') ' +
        'as varchar(178) ) as descricao,'
      '       p.valorgrade1,'
      '       p.valorgrade2,'
      ''
      '       c.bitola,'
      '       c.liga,'
      '       c.resistividade,'
      '       c.tolerancia,'
      ''
      '      (select cp.pn'
      '       from clientesprodutos cp'
      '       where cp.produto = p.codigo and'
      '             cp.cliente=:cliente and'
      '             cp.tipocliente=:tipocliente) as pn,'
      ''
      '      (select cp.produto_cliente'
      '       from clientesprodutos cp'
      '       where cp.produto = p.codigo and'
      '             cp.cliente = :cliente and'
      '             cp.tipocliente = :tipocliente) as produto_cliente,'
      '       c.peso,'
      '       p.inativo      '
      ''
      ''
      'from (produtos p'
      '     join (((caracteristicas c'
      '             join classes cl'
      '             on c.classe=cl.codigo)'
      '            join grupos g'
      '            on g.codigo=c.grupo)'
      '           join marcas m'
      '           on c.marca = m.codigo)'
      '     on p.caracteristica = c.codigo)'
      ''
      'where true'
      ''
      '%SQLSomenteProdutosdoCliente'
      '%SQLProdutosJaSelecionados'
      '%SQLFiltroItemProdutos'
      '%SQLFiltroProdutos'
      '%SQLFiltroGrupos'
      '%SQLFiltroClasses'
      '%SQLFiltroMarcas'
      '%SQLFiltroGruposFornecedores'
      '%SQLFiltroFornecedor'
      '%SQLFiltroClientes'
      '%SQLFiltroLocalizacao'
      '%SQLFiltroTipoProduto'
      '%SQLFiltroFioseFitas'
      '%SQLFiltroPedidos'
      '%SQLProdutosAgendamentos'
      '%SQLOrdenacao'
      ''
      ''
      '/*'
      ''
      ':FilialBase'
      ''
      '*/')
  end
end
