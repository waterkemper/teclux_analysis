            pesUNIDADES     : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaUnidadescodigo.AsVariant;
            pesPROMOCOES     : begin
                                 edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaPromocoescodigo.AsVariant;
                                 Selecionar(TipoPesquisa);
                               end;

            pesCashBack     : begin
                                 edfCodigo.text := qryConsultaCashBackCodigo.AsVariant;
                                 edfCodigo.exist;
                                 edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaCashBackCodigo.AsVariant;
                                 Selecionar(TipoPesquisa);
                               end;

            pesAtributos     : begin
                                 edfCodigo.text := qryConsultaAtributosCodigo.AsVariant;
                                 edfCodigo.exist;
                                 edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaAtributosCodigo.AsVariant;
                                 Selecionar(TipoPesquisa);
                               end;



            pesLOTETRANSFERENCIA : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaLoteTransferencialotetransferencia.AsVariant;
            pesIMOVEIS           : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaImoveisnumero.AsVariant;

            pesTIPORECEBIMENTO : begin
                                   edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaTipoRecebimentocodigo.AsVariant;
                                   Selecionar(TipoPesquisa);
                                 end;

            pesTipoMovimentoEstoque : begin
                                        edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaTipoMovimentoscodigo.AsVariant;
                                        Selecionar(TipoPesquisa);
                                      end;

            pesCOLUNAS : begin
                                        edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaColunascodigo.AsVariant;
                                        Selecionar(TipoPesquisa);
                                      end;


            pesTIPOPAGAMENTO   : begin
                                   edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaTiposPagamentoscodigo.AsVariant;
                                   Selecionar(TipoPesquisa);
                                 end;


            pesLISTACASAMENTO  : begin
                                   edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultalistadecasamentocodigo.AsVariant;
                                   Selecionar(TipoPesquisa);
                                 end;
            pesORCAMENTO  : begin
                               edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaOrcamentoscodigo.AsVariant;
                               Selecionar(TipoPesquisa);
                            end;

            pesCupons_Desconto : begin
                                  edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaCupons_Descontocodigo_cupom.AsVariant;
                                  Selecionar(TipoPesquisa);
                                 end;

            pesMVAProtocolos  : begin
                                   if edfcodigo.DataField<>'' then
                                     edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaMVAProtocolosprotocolo.AsVariant;

                                   Selecionar(TipoPesquisa);
                                end;



          end;
          edfCodigoFound(true);
        end;
        opPESQUISA : begin
                       if (TipoPesquisa = pesNotas) and (edfcodigo.group<>'') then
                       begin
                         edfcodigo.Text := qryConsultaNotasnumero.AsVariant;
                         edfcodigo.Exist;
                       end
                       else
                       if (TipoPesquisa = pesNotasPag) and (edfcodigo.group<>'') then
                       begin
                         edfcodigo.Text := qryConsultaNotasPagnumero.AsVariant;
                         edfcodigo.Exist;
                       end
                       else
                       if (TipoPesquisa = pesNOTASFORNECEDOR) and (edfcodigo.group<>'') then
                       begin
                         edfcodigo.Text := qryConsultaNotasPagnumero.AsVariant;
                         edfcodigo.Exist;
                       end
                       else
                       if (TipoPesquisa = pesORDEMSERVICO) then
                       begin
                         qryProcuraOrdemServico.close;
                         qryProcuraOrdemServico.parambyname('numero').asstring := qryConsultaordemserviconumero.asstring;
                         qryProcuraOrdemServico.macrobyname('SQL').asstring := ' and c.numero = '+quotedstr(qryConsultaordemserviconumero.asstring);
                         edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaOrdemServiconumero.AsVariant;
                         Selecionar(TipoPesquisa);
                         qryProcuraOrdemServico.macrobyname('SQL').asstring := '';
                       end
                       else
                         Selecionar(TipoPesquisa);

                       if assigned(FOnFound) then
                         FOnFound;
                     end;
      end;
    end;
    if abrirtabelaProcura then
    begin
      try
        if ActiveControl.CanFocus then
          ActiveControl.SetFocus;
      except
      end;

      if edfcodigo.CanFocus then
      begin
        edfCodigo.SetFocus;
        edfCodigo.SelectAll;
      end;
    end;

    FechaTabelaPesquisa(TipoPesquisa);
  end;
end;

function TfraConsultaCodigo.JanelaPesquisa: TfrmConsultaBasica;
begin

  Jan.ConsultaInterativa := Not (TipoPesquisa in [pesPRODUTOS, pesITEMPRODUTOS, pesLOTESPRODUTOS,
                                                  pesITEMPRODUTOSCONSULTA, pesEstoqueItemProdutos,
                                                  pesCaracteristicasProdutosClientes,
                                                  pesFORNECEDORES, pesFORNECEDORESTRANSPORTE,  pesCLIENTES,
                                                  pesCONTRATOS, pesLICITACOES, pesCONTRATOSMANUTENCAO, pesPEDIDOSSAIDA,
                                                  pesOSP, pesREPASSECHEQUES, pesNOTASFILIAIS, pesNotasPag, pesNotas,
                                                  pesCONTRATOSIMOVEIS, pesORDEMSERVICO, pesVENDASPERDIDAS]) {and CtrlOn};

  if (TipoPesquisa in [pesITEMPRODUTOSFIOS, pesITEMPRODUTOSFITAS, pesESTOQUESLOTESPRODUTOS]) then
     Jan.ConsultaInterativa := true;

  if (TipoPesquisa in [pesFORNECEDORES, pesFORNECEDORESTRANSPORTE, pesCLIENTES, pesORDEMSERVICO]) {and CtrlOn} and ConsultarTodos then
    Jan.ConsultaInterativa := true;

  Jan.UsarParametrosDaTabela := False;
  if (TipoPesquisa in [pesESTADOCIDADES, pesCONTRATOS, pesLICITACOES, pesORDEMSERVICO,
                       pesCONTRATOSMANUTENCAO, pesPEDIDOSSAIDA, pesNOTASFILIAIS,
                       pesCONTRATOSIMOVEIS, pesVENDASPERDIDAS, pesNotasPag, pesNotas, pesItemAtributoValor]) then
    Jan.UsarParametrosDaTabela := true;

  if (TipoPesquisa in [pesOSP, pesREPASSECHEQUES]) then
    Jan.UsarParametrosDaTabela := qryProcuraCliente.IsEmpty;


  if (TipoPesquisa in [pesITEMPRODUTOS, pesITEMPRODUTOSCONSULTA, pesPRODUTOS, pesEstoqueItemProdutos]) then
  begin
    if not Jan.ManterParametros then
    begin
      Jan.gbxSelecionar.visible := true;
      Jan.cbbOpcao.visible := true;

      Jan.cbbOpcao.items.clear;
      Jan.cbbOpcao.items.Add('ATIVOS');
      Jan.cbbOpcao.items.Add('INATIVOS');
      Jan.cbbOpcao.items.Add('AMBOS');
      Jan.cbbOpcao.text := 'ATIVOS';
      Jan.cbbOpcao.OnSelect := FiltrarDados;
      Jan.ManterParametros := true;
    end;
  end;


  Result := Jan;
  vConsultaInterativa := jan.consultainterativa;
//  FreeAndNil(jan);
end;


{
procedure TfraConsultaCodigo.SettipoPesquisaCodigo(
  const Value: TTipoPesquisaCodigo);
begin
  FTipoPesquisaCodigo := Value;
  case TipoPesquisaCodigo of
    Cliente : TipoPesquisa := pesCLIENTES;
    Fornecedor : TipoPesquisa := pesFORNECEDORES;
    marca   : TipoPesquisa := pesMARCAS;
  end;
  AbreTabelaProcura(TipoPesquisa);
end;
}

procedure TfraConsultaCodigo.edfCodigoKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
  vTeclaPressionada := true;
  inherited;
  Case Key of
    VK_F9     : begin
                   CtrlOn := Shift = [ssCtrl];
//                   if (Shift = []) or CtrlOn then
                   if CtrlOn then
                     if TipoPesquisa <> pesCupons_Desconto then
                       InternoPesquisar(edfCodigo, TituloPesquisa);
                 end;
    VK_Return : begin
                   case edfCodigo.Operacao of
                     opPESQUISA :
                     begin
                       if assigned(FOnFound) then
                         FOnFound;
                     end;
                   end;
                 end;
  end;
  vTeclaPressionada := false;
end;

