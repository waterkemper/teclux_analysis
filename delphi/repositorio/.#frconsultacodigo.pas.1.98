                                edfCodigo.DataSource.DataSet.fieldbyname('natureza').AsInteger := qryConsultaNaturezasCFOP_NFcodigo.Asinteger;
                                edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaNaturezasCFOP_NFcodigofiscal.AsVariant;
