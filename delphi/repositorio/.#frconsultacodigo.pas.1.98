unit frconsultacodigo;

interface

uses
  SysUtils, Types, Classes, Graphics, Controls, Forms, Dialogs,
  frconsulta, StdCtrls, DBCtrls, cpdbtext, Buttons, Mask,
  cpdbfindcontrols, ctconstantes, dmbasico, fmconsultabasica, fmconsultaporcampo,
   Windows, zquery, DB, cpdatasource, ZPgSqlQuery, dmtecsoft,
  clusuario, cpquery, clparametrossistema, ZTransact, biblio,
  dmdicionariodados, cpdbgrid, TypInfo, ExtCtrls;

                        

type
  TfraConsultaCodigo = class(TfraConsulta)
    sbnProcura: TSpeedButton;
    dtxDescricao: TtecDBText;
    edfCodigo: TtecDBFindLookup;
    procedure edfCodigoKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure sbnProcuraClick(Sender: TObject);
    procedure edfCodigoFound(Found: Boolean);
    procedure edfCodigoExit(Sender: TObject);
    procedure edfCodigoMessage(var Msg: String);
    procedure edfCodigoEnter(Sender: TObject);
    procedure qryProcuraClienteBeforeOpen(DataSet: TDataSet);
    procedure qryConsultaEstoqueItemProdutosAfterOpen(DataSet: TDataSet);
  private
    vTeclaPressionada: Boolean;
    FQuantidadeNaturezas: Boolean;
    FAbrirPesquisaQuandoReadOnly: boolean;
    FOperacao: TtecTipoOperacao;
    function getQuantidadeNaturezas: Boolean;
  protected
    dmbasico : TdtmBasico;
    function JanelaPesquisa: TfrmConsultaBasica; override;
    function TituloPesquisa: String;

  private
    FTipoCliente: String;
    FOnFound: TtecProcedure;
    FFilialSelecionada: Variant;
    procedure SetTipoCliente(const Value: String);
    function PosicionarEstado(codigo: String): Boolean;
    function PosicionarRegistro(TipoPesquisa: TTecPesquisa; Parametro: Integer): Boolean;
    property QuantidadeNaturezas: Boolean read getQuantidadeNaturezas write FQuantidadeNaturezas;



    { Private declarations }
  public
    { Public declarations }
    vedfCodigoEnter : boolean;
    constructor Create(AOwner: TComponent); override;
//    destructor Destroy; override;
    
    property TipoCliente: String read FTipoCliente write SetTipoCliente;
    property OnFound: TTecProcedure read FOnFound write FOnFound;
    function InternoPesquisar(Titulo: String): Integer; override;
    procedure PosicionarTabelaNoParametro(Ind: Integer; var continuar: Boolean); override;

    property FilialSelecionada: Variant read FFilialSelecionada write FFilialSelecionada;
    property AbrirPesquisaQuandoReadOnly: boolean read FAbrirPesquisaQuandoReadOnly write FAbrirPesquisaQuandoReadOnly default false;


  end;

  function AcionarPesquisaGrade__(Fonte: TDataSource;
                                  Tabela : TDataset;
                                  NomedoCampo: String;
                                  TipoPesquisa: TTecPesquisa;
                                  AOwner: TComponent;
                                  visivel: Boolean): Boolean;

  var
    fraConsultaCodigo : tfraConsultaCodigo;


implementation

{$R *.dfm}

constructor TfraConsultaCodigo.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  AbrirPesquisaQuandoReadOnly := False;
end;

function TfraConsultaCodigo.InternoPesquisar(Titulo: String): Integer;
var
  vContinuar : Boolean;
begin
  vContinuar := true;

  {nas atribuições qdo for readonly não há razão para pesquisar}
  if (edfCodigo.Operacao = OPAtribuicao) or ((edfcodigo.Operacao = opPESQUISA) and (edfcodigo.Group<>'') ) then
    if edfCodigo.DataField <> '' then
      if edfcodigo.ReadOnly or

          ((edfCodigo.DataSource.DataSet.FindField(edfCodigo.DataField)<>nil) and
           (edfCodigo.DataSource.DataSet.FieldByName(edfCodigo.DataField).ReadOnly)) or

          ((edfCodigo.DataSource.DataSet<>nil) and
           (edfcodigo.Operacao = opATRIBUICAO) and
           (TtecQuery(edfCodigo.DataSource.DataSet).ReadOnly)) then

//        if AbrirTabelaProcura then
         if CtrlOn then
           vContinuar := AbrirPesquisaQuandoReadOnly;


  if vContinuar then
  begin
    AbreTabelaConsulta(TipoPesquisa);
    Result := inherited InternoPesquisar(Titulo);
    if TipoPesquisa = pesNCMTABELAIPI then
    begin
      if Result <> mrCancel then
        while not (qryConsultaNCMTabelasoua.ASString = 'A') do
        begin
           Result := inherited InternoPesquisar(Titulo);
           if Result = mrCancel then
             break;
        end;

    end;

    if Result = mrOK then
    begin
      case edfCodigo.Operacao of
        opATRIBUICAO :
        begin
          if edfcodigo.LookupQuery <> nil then
            if edfCodigo.Group='' then
              if not (edfCodigo.DataSource.State in [dsinsert, dsedit]) then
                edfCodigo.DataSource.edit;

          case TipoPesquisa of
            pesEstoqueItemProdutos  : Selecionar(TipoPesquisa);
            pesITEMPRODUTOSCONSULTA : Selecionar(TipoPesquisa);

            pesITEMPRODUTOS,
            pesITEMPRODUTOSFIOS,
            pesITEMPRODUTOSFITAS  : begin

                                if  {ParSistema.PermitirProdutoAlfanumerico} true then
                                begin

                                  edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsString := qryConsultaItemProdutoscodigovisual.AsString;
                                  edfCodigo.modified := True;
                                  edfCodigo.Exist;


                                  {
                                  if TtecQuery(edfCodigo.DataSource.Dataset).FindField('produto')<>nil then
                                     edfCodigo.DataSource.DataSet.fieldbyname('produto').AsString := qryConsultaItemProdutoscodigo.AsString;

                                  if TtecQuery(edfCodigo.DataSource.Dataset).FindField('codigo')<>nil then
                                     edfCodigo.DataSource.DataSet.fieldbyname('codigo').AsString := qryConsultaItemProdutoscodigo.AsString;
                                  }

                                end
                                else
                                begin
                                  edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsString := qryConsultaItemProdutoscodigo.AsString;

                                  {
                                  if TtecQuery(edfCodigo.DataSource.Dataset).FindField('produtovisual')<>nil then
                                     edfCodigo.DataSource.DataSet.fieldbyname('produtovisual').AsString := qryConsultaItemProdutoscodigovisual.AsString;
                                  if TtecQuery(edfCodigo.DataSource.Dataset).FindField('codigovisual')<>nil then
                                     edfCodigo.DataSource.DataSet.fieldbyname('codigovisual').AsString := qryConsultaItemProdutoscodigovisual.AsString;
                                   }  
                                end;
                                Selecionar(TipoPesquisa);

                              end;
            pesLOTESPRODUTOS : begin

                                  edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsString := qryConsultaLotesProdutosnrlote.AsString;
                                  Selecionar(TipoPesquisa);
                                  edfCodigo.modified := True;
                                  edfCodigo.Exist;
                               end;

            pesESTOQUESLOTESPRODUTOS : begin

                                  edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsString := qryConsultaEstoquesLotesProdutosnrlote.AsString;
                                  Selecionar(TipoPesquisa);
                                  edfCodigo.modified := True;
                                  edfCodigo.Exist;
                               end;


            pesPRODUTOS     : begin
//                                if  ParSistema.PermitirProdutoAlfanumerico  then
                                  edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsString := qryConsultaProdutoscodigovisual.AsString;
//                                else
//                                  edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsString := qryConsultaProdutoscodigo.AsString;
                                  Selecionar(TipoPesquisa);
                              end;

            pesCaracteristicasProdutosClientes : begin
                                                   Selecionar(TipoPesquisa);
                                                 end;

            pesGRUPOS       : begin
                                edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaGrupoProdutoscodigo.AsVariant;
                                Selecionar(TipoPesquisa);
                              end;

            pesEQUIPAMENTO   : begin
                                edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaEquipamentocodigo.AsVariant;
                                Selecionar(TipoPesquisa);
                              end;

            pesMODALIDADEBCICMS : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaModalidadeBCICMScodigo.AsVariant;
            pesMODALIDADEBCICMSST : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaModalidadeBCICMSSTcodigo.AsVariant;

            pesTRIBUTOSPIS : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultatributospiscodigo.AsVariant;
            pesTRIBUTOSCOFINS : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultatributoscofinscodigo.AsVariant;

            pesTRIBUTOSIPI : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultatributosipicodigo.AsVariant;
            pesTRIBUTOSICMS : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaTributosICMScodigo.AsVariant;
            pesICMS : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaICMScodigo.AsVariant;
            pesIPI : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaIPIcodigo.AsVariant;

            pesORIGENS : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaORIGENScodigo.AsVariant;
            pesOBSLEGAIS : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaOBSLEGAIScodigo.AsVariant;            


            pesCLASSES      : begin
                                edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaClassescodigo.AsVariant;
                                Selecionar(TipoPesquisa);
                              end;

            pesLOCALIZACAOESTOQUE : begin
                                      edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaLocalizacaoEstoqueLocalizacao.AsVariant;
                                      Selecionar(TipoPesquisa);
                                    end;

            pesMARKETPLACE : begin
                               edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaMarketPlacecodigo.AsVariant;
                               Selecionar(TipoPesquisa);
                             end;

            pesSUBLOCALIZACAOESTOQUE : begin
                                      edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaSubLocalizacaoEstoqueSubLocalizacao.AsVariant;
                                      Selecionar(TipoPesquisa);
                                    end;

            pesLISTASPADRAO      : begin
                                edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaListasPadraocodigo.AsVariant;
                                Selecionar(TipoPesquisa);
                              end;

            pesNCMTABELAIPI : begin
                                try
                                  edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaNCMTabelacodigotipi.AsVariant;
                                except end;
                                Selecionar(TipoPesquisa);
                              end;
            pesMARCAS       : begin
                                edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaMarcascodigo.AsVariant;
                                Selecionar(TipoPesquisa);
                              end;

            pesGruposFornecedores : begin
                                      edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaGruposFornecedorescodigo.AsVariant;
                                      Selecionar(TipoPesquisa);
                                    end;
            pesCLIENTES,
            pesFORNECEDORES : begin

                                if edfcodigo.datasource <> nil then
                                begin
                                  if edfCodigo.DataSource.DataSet.findfield('tipofornecedor') <> nil then
                                    edfCodigo.DataSource.DataSet.fieldbyname('tipofornecedor').AsVariant := qryConsultaClientestipoorig.AsVariant;

                                  if edfCodigo.DataSource.DataSet.findfield('tipocliente') <> nil then
                                    edfCodigo.DataSource.DataSet.fieldbyname('tipocliente').AsVariant := qryConsultaClientestipoorig.AsVariant;
                                end;

                                Selecionar(TipoPesquisa);
                                if assigned(edfCodigo.DataSource) then
                                begin
                                  edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaClientescodigo.AsVariant;
                                  if edfCodigo.Group='' then
                                    edfcodigo.Exist;
                                end;
                                ValorSelecionado:= qryConsultaClientescodigo.AsVariant;
                              end;

            pesFORNECEDORESTRANSPORTE : BEGIN
                                          edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaClientescodigo.AsVariant;
                                          Selecionar(TipoPesquisa);
                                        end;


            pesCONTAS       : edfCodigo.DataSource.DataSet.FieldByName(edfCodigo.DataField).AsVariant:= qryConsultaContasconta.AsVariant;

            pesFILIAIS      :Begin


                               if (edfCodigo.group='') then
                                 edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaFiliaiscodigo.AsVariant
                               else
                               begin
                                 edfCodigo.Text := qryConsultaFiliaiscodigo.AsVariant;
                                 edfCodigo.exist;
                               end;

                               Selecionar(TipoPesquisa);
                               ValorSelecionado:= qryConsultaFiliaisnome.AsVariant;
                             end;
            pesMODELOETIQUETA : Selecionar(TipoPesquisa);

            pesNOTASNUMERO  : begin
                                edfCodigo.DataSource.DataSet.FieldByName(edfcodigo.DataField).AsVariant := qryConsultaNfSaidanumero.AsVariant;
                                Selecionar(TipoPesquisa);
                              end;

            pesCUPOMFISCAL  : begin
                                edfCodigo.DataSource.DataSet.FieldByName(edfcodigo.DataField).AsVariant := qryConsultaCupomFiscalnumero.AsVariant;
                                Selecionar(TipoPesquisa);
                              end;

            pesGRUPOSFILIAIS : edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaGrupoFiliaiscodigo.AsVariant;
            pesVENDEDORES : begin
                              edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaVendedorescodigo.AsVariant;
                              Selecionar(TipoPesquisa);
                             end;
                             
            pesAGENTES    : edfCodigo.DataSource.DataSet.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaAgentescodigo.AsVariant;
            pesCONCEITOS  : edfCodigo.DataSource.DataSet.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaConceitocodigo.AsVariant;
  //          pesCONTACREDITO,
  //          pesCONTADEBITO: edfCodigo.DataSource.DataSet.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaContacodigo.AsVariant;
  //          pesCONTAREFERENCIAL: edfCodigo.DataSource.DataSet.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaPlanoReferencialcodigo.AsVariant;
  //          pesHISTORICOCONTABIL : edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaHistoricocodigo.AsVariant;
            pesBANCOS: edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaBancosCodigo.AsVariant;
            pesPEDIDOS:begin
                       edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaPedidonumero.AsVariant;
                       Selecionar(TipoPesquisa);
                       ValorSelecionado:= qryConsultaPedidonumero.AsVariant;
                       end;
            pesSERIESFORNECEDORES : begin
                                      edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaSeriesFornecedorserie.AsVariant;
                                      if edfCodigo.group<>'' then
                                      begin
                                        edfcodigo.Text := qryConsultaSeriesFornecedorserie.AsVariant;
                                        edfcodigo.Exist;
                                      end;  
                                    end;
            pesSERIES             : begin
                                      qryProcuraSerie.ParamByName('Serie').AsString:= qryConsultaSerieSerie.AsVariant;
                                      Selecionar(TipoPesquisa);
                                      if edfCodigo.Group='' then
                                        edfCodigo.DataSource.DataSet.FieldByName(edfCodigo.DataField).AsVariant:= qryConsultaSerieSerie.AsVariant
                                      else
                                      begin
                                        edfCodigo.Text := qryConsultaSerieSerie.AsVariant;
                                        edfCodigo.exist;
                                      end;
                                    end;
  //          pesEVENTO             : edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaEventoscodigo.AsVariant;
            pesNUMERONOTASPAGPRODUTOS :  edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaNotasPagProdutosnumero.AsVariant;
            pesESTADOS: edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaEstadoscodigo.AsVariant;
            pesESTADOCIDADES: begin
                                qryProcuraEstadoCidades.BeforeOpen := nil;
                                qryProcuraEstadoCidades.ParamByName('estado').AsString := qryConsultaEstadoCidadesestado.AsString;
                                edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaEstadoCidadescodigo.AsVariant;
                                Selecionar(TipoPesquisa);
                                qryProcuraEstadoCidades.BeforeOpen := qryProcuraEstadoCidadesBeforeOpen;
                                //edfcodigo.Exist;
                              end;
            pesCONTRATOS: begin
                            edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaContratonumero.AsVariant;
                            Selecionar(TipoPesquisa);
                          end;

            pesItemAtributoValor:
                          begin
                            edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaItemAtributoValoratributo.AsVariant;
                            edfcodigo.datasource.dataset.FieldByName('valor').AsVariant := qryConsultaItemAtributoValorvalor.AsVariant;

                            Selecionar(TipoPesquisa);
                          end;


            pesLICITACOES: begin
                            if edfcodigo.group <> '' then
                            begin
                              edfcodigo.text := qryConsultaLicitacoesnumero.AsString;
                              edfcodigo.exist;

                            end
                            else
                            begin
                              edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaLicitacoesnumero.AsVariant;
                              Selecionar(TipoPesquisa);
                            end;
                          end;


            pesORDEMSERVICO: begin
                               qryProcuraOrdemServico.parambyname('numero').asstring := qryConsultaordemserviconumero.asstring;
                               qryProcuraOrdemServico.macrobyname('SQL').asstring := ' and c.numero = '+quotedstr(qryConsultaordemserviconumero.asstring);
                               edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaOrdemServiconumero.AsVariant;
                               Selecionar(TipoPesquisa);
                               qryProcuraOrdemServico.macrobyname('SQL').asstring := '';
                             end;

            pesVENDASPERDIDAS : valorselecionado := qryConsultaVendasPerdidasCodigo.AsVariant;

            pesCONTRATOSMANUTENCAO: begin
                            edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaContratoManutencaonumero.AsVariant;
                            Selecionar(TipoPesquisa);
                          end;

            pesPEDIDOSSAIDA: begin
                            edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaPedidosSaidanumero.AsVariant;
                            Selecionar(TipoPesquisa);
                            valorselecionado := qryConsultaPedidosSaidanumero.AsVariant;
                          end;
            pesOSP: begin
                      edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaOSPnumero.AsVariant;
                      Selecionar(TipoPesquisa);
                      valorselecionado := qryconsultaOSPnumero.asVariant;
                    end;

            pesREPASSECHEQUES: begin
                      edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaRepasseChequesnumero.AsVariant;
                      Selecionar(TipoPesquisa);
                      valorselecionado := qryConsultaRepasseChequesnumero.asVariant;
                    end;


            pesCONTRATOSIMOVEIS: begin
                                   edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaContratosImoveiscontrato.AsVariant;
                                   Selecionar(TipoPesquisa);
                                   valorselecionado := qryConsultaContratosImoveiscontrato.AsVariant;
                                 end;
            pesPARCELASIMOVEIS : begin
                                   edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaParcelasImoveiscontrato.AsVariant;
                                   Selecionar(TipoPesquisa);
                                 end;
            pesNOTASFILIAIS : begin
                                edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaNotasnumero.AsVariant;
                                Selecionar(TipoPesquisa);
                              end;
            pesNOTASFORNECEDOR : begin
                                edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaNotasPagnumero.AsVariant;
                                Selecionar(TipoPesquisa);
                              end;

            pesNotasPag : begin
//                            edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaNotasPagcodigo.AsVariant;
                            Selecionar(TipoPesquisa);
                          end;

            pesNotas : begin
//                            edfCodigo.DataSource.DataSet.fieldbyname(edfcodigo.DataField).AsVariant := qryConsultaNotasPagcodigo.AsVariant;
                            Selecionar(TipoPesquisa);
                          end;

            pesNIVELSALARIAL: begin
                      edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaNivelSalarialcodigo.AsVariant;
                      Selecionar(TipoPesquisa);
                      valorselecionado := qryConsultaNivelSalarialcodigo.asVariant;
                    end;

            pesMAQUINAS: begin
                      edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaMaquinascodigo.AsVariant;
                      Selecionar(TipoPesquisa);
                      valorselecionado := qryConsultaMaquinascodigo.asVariant;
                    end;

            pesMAQUINASECF: begin
                      edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaMaquinasECFmaquina.AsVariant;
                      Selecionar(TipoPesquisa);
                      valorselecionado := qryConsultaMaquinasECFmaquina.asVariant;
                    end;

            pesINTERVENCAOECF: begin
                      edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaIntervencaoECFintervencao.AsVariant;
                      Selecionar(TipoPesquisa);
                      valorselecionado := qryConsultaIntervencaoECFintervencao.AsVariant;
                    end;

            pesREGIOES: begin
                      edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaRegioescodigo.AsVariant;
                      Selecionar(TipoPesquisa);
                      valorselecionado := qryConsultaRegioescodigo.asVariant;
                    end;

            pesOPERACOES: begin
                      Selecionar(TipoPesquisa);
                      valorselecionado := qryConsultaOperacoescodigo.asVariant;
                    end;

            pesNIVEISCONHECIMENTO: begin
                                     edfcodigo.datasource.dataset.FieldByName(edfCodigo.DataField).AsVariant := qryConsultaNiveisConhecimentocodigo.AsVariant;
                                     Selecionar(TipoPesquisa);
                                   end;

            pesMOTIVOSPARADAS:     begin
