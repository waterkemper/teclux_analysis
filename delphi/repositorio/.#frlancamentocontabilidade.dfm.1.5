      'select csff.filial,'
      
        '       coalesce(csff.contacontabil, csfg.contacontabil) as conta' +
        'contabil,'
      '       coalesce(csff.descricao,csfg.descricao) as descricao,'
      
        '       coalesce(csff.historicocontabil,csfg.historicocontabil) a' +
        's historicocontabil'
      'from contassaidasfiliais csfg'
      '     left join contassaidasfiliais csff'
      '     on csfg.descricao = csff.descricao'
      '    and csff.filial = :filial'
      'where csfg.filial is null'
      
        ') as contassaidasfiliais left join planocontas pl on contassaida' +
        'sfiliais.contacontabil = pl.codigo'
      
        '                         left join historicos h on contassaidasf' +
        'iliais.historicocontabil = h.codigo'
      
        'order by UPPER(TO_ASCII(contassaidasfiliais.descricao,'#39'LATIN1'#39'))' +
