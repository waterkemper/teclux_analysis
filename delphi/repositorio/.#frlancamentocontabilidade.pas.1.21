    function VerificarLancamentosContabeis: Boolean;

    //Referente a Lançamentos para Imóveis
    property DataChaves : TtecDataRetorno read FDataChaves write FDataChaves;
    property DesMenorJuros: TTecBooleanRetorno read FDesMenorJuros Write FDesMenorJuros;
    property SaldoTransMenorSaldoHist : TTecBooleanRetorno read FSaldoTransMenorSaldoHist write FSaldoTransMenorSaldoHist;
         //Venda
    property ContaDebitoVendaImoveis   : TTecIntegerRetorno read FContaDebitoVendaImoveis write FContaDebitoVendaImoveis;
