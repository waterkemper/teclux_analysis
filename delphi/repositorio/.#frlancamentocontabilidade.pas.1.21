    property GerarDuplicatas: TtecFuncaoBoolean read FGerarDuplicatas write FGerarDuplicatas;
    property CReDBigualValorNota: TtecFuncaoBoolean read FCReDBigualValorNota write FCReDBigualValorNota;
    property GravarSemLanctos: TtecFuncaoBoolean read FGravarSemLanctos write FGravarSemLanctos;
