         //Chaves
    property ContaDebitoChavesImoveis  : TTecIntegerRetorno read FContaDebitoChavesImoveis write FContaDebitoChavesImoveis;
    property ContaCreditoChavesImoveis : TTecIntegerRetorno read FContaCreditoChavesImoveis write FContaCreditoChavesImoveis;
         //Impostos - Contas
    property ContaCreditoCofinsRetido  : TTecIntegerRetorno read FContaCreditoCofinsRetido write FContaCreditoCofinsRetido;
    property ContaCreditoCSLLRetido    : TTecIntegerRetorno read FContaCreditoCSLLRetido write FContaCreditoCSLLRetido;
