{$R *.dfm}

procedure TfraMultiplaSelecaoAleatoria.Timer1Timer(Sender: TObject);
begin
  tstItemdeProduto.Highlighted := (fraSelecaoAleatoriaItemdeProdutos.fraSelecaoAleatoriaItemdeProduto.qryselecaoaleatoria.recordcount <> 0);
  tstProduto.Highlighted := (fraSelecaoAleatoriaprodutos.fraSelecaoAleatoriaProduto.qryselecaoaleatoria.recordcount <> 0);
  tstSelecaoAleatoriaGrupoProduto.Highlighted := (fraSelecaoaleatoriagruposprodutos.fraSelecaoAleatoriaGrupoProduto.qryselecaoaleatoria.recordcount <> 0);
  tstSelecaoAleatoriaClasseProduto.Highlighted := (fraSelecaoaleatoriaclassesprodutos.fraSelecaoAleatoriaClasseProduto.qryselecaoaleatoria.recordcount <> 0);
  tstSelecaoAleatoriaMarcaProduto.Highlighted := (fraSelecaoAleatoriamarcasProdutos.fraSelecaoAleatoriamarcasProduto.qryselecaoaleatoria.recordcount <> 0);
  tstSelecaoAleatoriamodelosProduto.Highlighted := (fraSelecaoAleatoriamodelosProdutos1.fraSelecaoAleatoriaModelosProduto.qryselecaoaleatoria.recordcount <> 0);
