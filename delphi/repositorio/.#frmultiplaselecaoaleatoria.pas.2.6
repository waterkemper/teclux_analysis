  tstListaPadronizada.Highlighted := (fraSelecaoaleatorialistaspadronizadas.fraSelecaoaleatorialistaspadronizadas.qryselecaoaleatoria.recordcount <> 0);

end;

procedure TfraMultiplaSelecaoAleatoria.fraSelecaoAleatoriaItemdeProdutosbnProcuraClick(
  Sender: TObject);
begin
  fraSelecaoAleatoriaItemdeProdutos.fraSelecaoAleatoriaItemdeProdutosbnProcuraClick(
  Sender);

end;

constructor TfraMultiplaSelecaoAleatoria.Create(AOwner: TComponent);
begin
  inherited;
  tstSelecaoAleatoriamodelosProduto.tabvisible := ParSistema.LiberarVisualizacaodeModelosProdutos and
                                                  (AOwner.ClassName = 'TfrmConsultaEstoque');
end;

end.
