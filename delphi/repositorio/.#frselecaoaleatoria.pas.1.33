unit frselecaoaleatoria;

interface

uses
  SysUtils, Types, Classes, Graphics, Controls, Forms, Dialogs, DB,
  ZQuery, ZPgSqlQuery, cpquery, cpdatasource, Grids, DBGrids, cpdbgrid,
  frconsulta, frconsultacodigo, Buttons, ExtCtrls, ctconstantes,
  frconsultacontabil, frconsultacodigocontabil, StdCtrls, biblio,
  windows;

type
  TfraSelecaoAleatoria = class(TFrame)
    dbgSelecaoAleatoria: TtecDBGrid;
    dsrSelecaoAleatoria: TtecDataSource;
    qrySelecaoAleatoria: TtecQuery;
    pnlLabels: TPanel;
    sbnProcura: TSpeedButton;
    sbnExcluir: TSpeedButton;
    sbnExcluirTodos: TSpeedButton;
    sbnIncluirItem: TSpeedButton;
    pnlAbaixo: TPanel;
    lblOrientacao: TLabel;
    pnlAbaixoDireita: TPanel;
    Splitter1: TSplitter;
    procedure sbnIncluirItemClick(Sender: TObject);
    procedure sbnExcluirClick(Sender: TObject);
    procedure sbnExcluirTodosClick(Sender: TObject);
    procedure qryCamposAplicacaoFilterRecord(DataSet: TDataSet;
      var Accept: Boolean);
    procedure dbgSelecaoAleatoriaCellClick(Column: TColumn);
  protected
  private
    FCampoParaLista: String;
    fcondicaodaselecao: TtecFuncaoBoolean;
    FCampoParaLista2: String;
    fUtilizarCamparacaoeLogica: boolean;
    fPossuiCampoFilial: boolean;
    FCampoParaLista5: String;
    FCampoParaLista4: String;
    FCampoParaLista3: String;
    FCampo_chv_nfe: String;
    FCampo_codigonota: String;
    fPossuiCampochv_nfe: boolean;
    fPossuiCampocodigonota: boolean;
    fPossuiCamposerie: boolean;
    fPossuiCamponumeronota: boolean;
    fPossuiCampooperacao: boolean;
    fPossuiCampodadofiscal: boolean;
    fPossuiCampoTipo: boolean;
    fPossuiCampoDescricao: boolean;
//    FCampo_valor: String;
    function GetStringSelecionada: String;
    function GetListaSelecionada: vString;
    function GetStringSelecionada2: String;
    procedure setUtilizarCamparacaoeLogica(const Value: boolean);
    function GetListaCondicional: String;
    function GetListaCondicionalcomTipo: String;

    procedure Excluir;
    function GetListaCondicionalJson: String;
    procedure AbrirTabela;
    { Private declarations }
  public
    { Public declarations }
    ConsultaSelecaoAleatoria
     : TfraConsultaCodigo;
    ConsultaSelecaoAleatoriaContabil : TfraConsultaCodigoContabil;
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;

    function Operador(opcomparacao: String): String;
    function Separador_Inicial(opcomparacao: String): String;
    function Separador_Final(opcomparacao: String): String;

    property CampoParaLista: String read FCampoParaLista write FCampoParaLista;
    property CampoParaLista2: String read FCampoParaLista2 write FCampoParaLista2;
    property CampoParaLista3: String read FCampoParaLista3 write FCampoParaLista3;
    property CampoParaLista4: String read FCampoParaLista4 write FCampoParaLista4;
    property CampoParaLista5: String read FCampoParaLista5 write FCampoParaLista5;

    property Campo_chv_nfe: String read FCampo_chv_nfe write FCampo_chv_nfe;
    property Campo_codigonota: String read FCampo_codigonota write FCampo_codigonota;
//    property Campo_valor: String read FCampo_valor write FCampo_valor;


    property StringSelecionada: String read GetStringSelecionada;
    property StringSelecionada2: String read GetStringSelecionada2;

    property ListaSelecionada: vString read GetListaSelecionada;
    property condicaodaselecao: TtecFuncaoBoolean read fcondicaodaselecao write fcondicaodaselecao;

    property ListaCondicional: String read GetListaCondicional;
    property ListaCondicionalcomTipo: String read GetListaCondicionalcomTipo;

    property ListaCondicionalJson: String read GetListaCondicionalJson;

    property UtilizarCamparacaoeLogica: boolean read fUtilizarCamparacaoeLogica write setUtilizarCamparacaoeLogica default false;

    property PossuiCampoFilial: boolean read fPossuiCampoFilial write fPossuiCampoFilial default false;
    property PossuiCamposerie: boolean read fPossuiCamposerie write fPossuiCamposerie default false;
    property PossuiCamponumeronota: boolean read fPossuiCamponumeronota write fPossuiCamponumeronota default false;
    property PossuiCampooperacao: boolean read fPossuiCampooperacao write fPossuiCampooperacao default false;
    property PossuiCampochv_nfe: boolean read fPossuiCampochv_nfe write fPossuiCampochv_nfe default false;
    property PossuiCampocodigonota: boolean read fPossuiCampocodigonota write fPossuiCampocodigonota default false;
    property PossuiCampodadofiscal: boolean read fPossuiCampodadofiscal write fPossuiCampodadofiscal default false;

    property PossuiCampoTipo: boolean read fPossuiCampoTipo write fPossuiCampoTipo default true;
    property PossuiCampoDescricao: boolean read fPossuiCampoDescricao write fPossuiCampoDescricao default true;
//    property PossuiCampoValor: boolean read fPossuiCampoValor write fPossuiCampoValor default false;

    procedure AdicionarItemNaLista(Codigo: String);
    procedure AdicionarListaItemNaLista(Lista: TStringList);

  end;

implementation

uses dmtecsoft;

{$R *.dfm}

procedure TfraSelecaoAleatoria.sbnIncluirItemClick(Sender: TObject);
begin
  AbrirTabela;

  qrySelecaoAleatoria.Append;
  dbgSelecaoAleatoria.SelectedIndex := 0;
end;

procedure TfraSelecaoAleatoria.sbnExcluirClick(Sender: TObject);
begin
  AbrirTabela;
  if not qrySelecaoAleatoria.isempty then
    qrySelecaoAleatoria.Delete;
end;

procedure TfraSelecaoAleatoria.sbnExcluirTodosClick(Sender: TObject);
begin
  AbrirTabela;
  qrySelecaoAleatoria.First;
  while not qrySelecaoAleatoria.eof do
    qrySelecaoAleatoria.Delete
end;

function TfraSelecaoAleatoria.GetStringSelecionada: String;
begin
  result := '';

  if qryselecaoaleatoria.active then
  begin
    if (CampoParaLista<>'') and (CampoParaLista2='') then
    begin
      qrySelecaoAleatoria.First;
      while not qrySelecaoAleatoria.Eof do
      begin
        if assigned(condicaodaselecao) then
        begin
          if condicaodaselecao then
          begin
            if not qrySelecaoAleatoria.fieldbyname(CampoParaLista).isnull then
            begin
              if qrySelecaoAleatoria.fieldbyname(CampoParaLista).DataType = ftString then
                result := result + quotedstr(qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString) + ','
              else
                result := result + qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString + ',';
            end;
          end;
          qrySelecaoAleatoria.Next;
        end
        else
        begin
          if not qrySelecaoAleatoria.fieldbyname(CampoParaLista).isnull then
          begin
            if qrySelecaoAleatoria.fieldbyname(CampoParaLista).DataType = ftString then
              result := result + quotedstr(qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString) + ','
            else
              result := result + qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString + ',';
          end;
          qrySelecaoAleatoria.Next;
        end;
      end;
      if result <> '' then
        delete(result,length(result),1);
    end
    else
    if (CampoParaLista<>'') and (CampoParaLista2<>'') then
    begin
      qrySelecaoAleatoria.First;
      while not qrySelecaoAleatoria.Eof do
      begin
        if assigned(condicaodaselecao) then
        begin
          if condicaodaselecao then
          begin
            if not qrySelecaoAleatoria.fieldbyname(CampoParaLista).isnull and
               not qrySelecaoAleatoria.fieldbyname(CampoParaLista2).isnull then
            begin
              if qrySelecaoAleatoria.fieldbyname(CampoParaLista).DataType = ftString then
                result := result + '(' + quotedstr(qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString)
              else
                result := result + '(' + qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString ;

              if qrySelecaoAleatoria.fieldbyname(CampoParaLista2).DataType = ftString then
                result := result + ',' + quotedstr(qrySelecaoAleatoria.fieldbyname(CampoParaLista2).AsString) + '),'
              else
                result := result + ',' + qrySelecaoAleatoria.fieldbyname(CampoParaLista2).AsString + '),';
            end;
          end;
          qrySelecaoAleatoria.Next;
        end
        else
        begin
          if not qrySelecaoAleatoria.fieldbyname(CampoParaLista).isnull and
             not qrySelecaoAleatoria.fieldbyname(CampoParaLista2).isnull then
          begin
            if qrySelecaoAleatoria.fieldbyname(CampoParaLista).DataType = ftString then
              result := result + '(' + quotedstr(qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString)
            else
              result := result + '(' + qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString ;

            if qrySelecaoAleatoria.fieldbyname(CampoParaLista2).DataType = ftString then
              result := result + ',' + quotedstr(qrySelecaoAleatoria.fieldbyname(CampoParaLista2).AsString) + '),'
            else
              result := result + ',' + qrySelecaoAleatoria.fieldbyname(CampoParaLista2).AsString + '),';
          end;

          qrySelecaoAleatoria.Next;
        end;
      end;
      if result <> '' then
        delete(result,length(result),1);
    end;
  end;


end;

function TfraSelecaoAleatoria.GetListaSelecionada: vString;
var
  Lista : vString;
begin
  Lista := nil;
  if qrySelecaoAleatoria.active then
  begin
    if (CampoParaLista<>'') and qryselecaoaleatoria.active then
    begin
      qrySelecaoAleatoria.First;
      while not qrySelecaoAleatoria.Eof do
      begin
        if assigned(condicaodaselecao) then
        begin
          if condicaodaselecao then
          begin
            SetLength(Lista, length(Lista)+1);
            Lista[length(Lista)-1] := qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString;
          end;
          qrySelecaoAleatoria.Next;
        end
        else
        begin
          Lista[length(Lista)-1] := qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString;
          qrySelecaoAleatoria.Next;
        end;
      end;
    end;
  end;
  result := Lista;
end;

function TfraSelecaoAleatoria.GetStringSelecionada2: String;
begin

  if qrySelecaoAleatoria.fieldbyname(CampoParaLista).DataType = ftString then
    result := ''''
  else
    result := '';

  if qrySelecaoAleatoria.active then
  begin
    if CampoParaLista<>'' then
    begin
      qrySelecaoAleatoria.First;
      while not qrySelecaoAleatoria.Eof do
      begin
        if assigned(condicaodaselecao) then
        begin
          if condicaodaselecao then
          begin
            if not qrySelecaoAleatoria.fieldbyname(CampoParaLista).isnull then
            begin
              if qrySelecaoAleatoria.fieldbyname(CampoParaLista).DataType = ftString then
                result := result +  quotedstr(qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString) + quotedstr(',')
              else
                result := result + qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString + ',';
            end;
          end;
          qrySelecaoAleatoria.Next;
        end
        else
        begin
          if not qrySelecaoAleatoria.fieldbyname(CampoParaLista).isnull then
          begin
            if qrySelecaoAleatoria.fieldbyname(CampoParaLista).DataType = ftString then
              result := result +  quotedstr(qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString) + quotedstr(',')
            else
              result := result + qrySelecaoAleatoria.fieldbyname(CampoParaLista).AsString + ',';
          end;
          qrySelecaoAleatoria.Next;
        end;
      end;
    end;
  end;

  if (qrySelecaoAleatoria.fieldbyname(CampoParaLista).DataType = ftString) and (result <> '''') then
    delete(result,length(result)-2,2)
  else
    delete(result,length(result),1);

end;

constructor TfraSelecaoAleatoria.Create(AOwner: TComponent);
begin
  inherited;
  dbgSelecaoAleatoria.ondelete := Excluir;
end;

procedure TfraSelecaoAleatoria.setUtilizarCamparacaoeLogica(
  const Value: boolean);
begin
  fUtilizarCamparacaoeLogica := Value;

  if UtilizarCamparacaoeLogica then
  begin

  {
    qryComparacao.close;
    qryComparacao.open;

    qryLogica.close;
    qryLogica.open;
    }

//    dtmTecSoft.qryCamposAplicacao.filtered := false;

//    dtmTecSoft.qryCamposAplicacao.onFilterRecord := qryCamposAplicacaoFilterRecord;


    (*
    if (ConsultaSelecaoAleatoria <> nil) and
       (ConsultaSelecaoAleatoria.TipoPesquisa = pesLOTESPRODUTOS) then
    begin
      qryCamposAplicacao.sql.clear;
      qryCamposAplicacao.sql.append('select cast(''nrlote'' as varchar(10)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''fabricacao'' as varchar(10)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''validade'' as varchar(10)) as campo ');
    end
    else
    if (ConsultaSelecaoAleatoria <> nil) and
       (ConsultaSelecaoAleatoria.TipoPesquisa = pesNotasPag) then
    begin
      qryCamposAplicacao.sql.clear;
      qryCamposAplicacao.sql.append('select cast(''codigonota'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''chv_nfe'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''fornecedor'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''tipofornecedor'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''serie'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''numero'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''descricao'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''valornota'' as varchar(35)) as campo ');

    end
    else
    if (ConsultaSelecaoAleatoria <> nil) and
       (ConsultaSelecaoAleatoria.TipoPesquisa = pesNotas) then
    begin
      qryCamposAplicacao.sql.clear;
      qryCamposAplicacao.sql.append('select cast(''dadofiscal'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''chv_nfe'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''filial'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''serie'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''numero'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''descricao'' as varchar(35)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''valornota'' as varchar(35)) as campo ');

    end
    else
    if (ConsultaSelecaoAleatoria <> nil) and
       (ConsultaSelecaoAleatoria.TipoPesquisa = pesContratos) then
    begin
      qryCamposAplicacao.sql.clear;
      qryCamposAplicacao.sql.append('select cast(''contrato'' as varchar(11)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''nome'' as varchar(11)) as campo ');
    end
    else
    if (ConsultaSelecaoAleatoria <> nil) and
       (ConsultaSelecaoAleatoria.TipoPesquisa = pesESPECIFICACAO) then
    begin
      qryCamposAplicacao.sql.clear;
      qryCamposAplicacao.sql.append('select cast(''descricao'' as varchar(11)) as campo');
    end
    else
    if (ConsultaSelecaoAleatoria <> nil) and
       (ConsultaSelecaoAleatoria.TipoPesquisa = pesITEMPRODUTOS) then {pesITEMPRODUTOS tem campos adicionais}
    begin
      qryCamposAplicacao.sql.clear;
      qryCamposAplicacao.sql.append('select cast(''codigo'' as varchar(11)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''descricao'' as varchar(11)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''valorgrade1'' as varchar(11)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''valorgrade2'' as varchar(11)) as campo ');
    end
    else
    if (ConsultaSelecaoAleatoria <> nil) and
       (ConsultaSelecaoAleatoria.TipoPesquisa = pesCLIENTES) then {pesITEMPRODUTOS tem campos adicionais}
    begin
      qryCamposAplicacao.sql.clear;
      qryCamposAplicacao.sql.append('select cast(''codigo'' as varchar(11)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''descricao'' as varchar(11)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''cpf/cnpj'' as varchar(11)) as campo ');
    end
    else
    if (ConsultaSelecaoAleatoria <> nil) and
       (ConsultaSelecaoAleatoria.TipoPesquisa = pesLOCALIZACAOESTOQUE) then {pesITEMPRODUTOS tem campos adicionais}
    begin
      qryCamposAplicacao.sql.clear;
      qryCamposAplicacao.sql.append('select cast(''descricao'' as varchar(11)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''valorgrade1'' as varchar(11)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''valorgrade2'' as varchar(11)) as campo ');
    end
    else
    if (ConsultaSelecaoAleatoria <> nil) and
       (ConsultaSelecaoAleatoria.TipoPesquisa = pesItemAtributoValor) then {pesITEMPRODUTOS tem campos adicionais}
    begin
      qryCamposAplicacao.sql.clear;
      qryCamposAplicacao.sql.append('select cast(''atributo'' as varchar(11)) as campo union all ');
      qryCamposAplicacao.sql.append('select cast(''valor'' as varchar(11)) as campo ');
    end
    else
    begin
      if PossuiCampoFilial then
      begin
        qryCamposAplicacao.sql.clear;
        qryCamposAplicacao.sql.append('select cast(''codigo'' as varchar(11)) as campo union all ');
        qryCamposAplicacao.sql.append('select cast(''filial'' as varchar(11)) as campo union all ');
        qryCamposAplicacao.sql.append('select cast(''descricao'' as varchar(11)) as campo ');
      end
      else
        qryCamposAplicacao := dtmTecSoft.qryCamposAplicacao;
    end;

    if not qryCamposAplicacao.active then
      qryCamposAplicacao.open;
    *)


    if  ((ConsultaSelecaoAleatoria <> nil) and
         (ConsultaSelecaoAleatoria.TipoPesquisa in [pesLOTESPRODUTOS])) then
    begin

      with TLargeIntField.Create(qrySelecaoAleatoria) do
      begin
        FieldName := 'lote';
        DisplayLabel := 'lote';
        FieldKind:= fkdata;
        DataSet := qrySelecaoAleatoria;
        qrySelecaoAleatoria.FieldDefs.Add(qrySelecaoAleatoria.Name + FieldName, ftlargeint, 0, true);
      end;

      with TStringField.Create(qrySelecaoAleatoria) do
      begin
        FieldName := 'nrlote';
        DisplayLabel := 'Nº Lote';
        FieldKind:= fkdata;
        DataSet := qrySelecaoAleatoria;
        qrySelecaoAleatoria.FieldDefs.Add(qrySelecaoAleatoria.Name + FieldName, ftString, 20, true);
      end;

      with TDateField.Create(qrySelecaoAleatoria) do
      begin
        FieldName := 'fabricacao';
        DisplayLabel := 'Fabricação';
        FieldKind:= fkdata;
//        EditMask := '99\-9999\-99999999999999\-99\-999\-999999999\-9\-99999999\-9;0;_';
        DataSet := qrySelecaoAleatoria;
        qrySelecaoAleatoria.FieldDefs.Add(qrySelecaoAleatoria.Name + FieldName, ftDate, 0, false);
      end;

      with TDateField.Create(qrySelecaoAleatoria) do
      begin
        FieldName := 'validade';
        DisplayLabel := 'Validade';
        FieldKind:= fkdata;
        DataSet := qrySelecaoAleatoria;
        qrySelecaoAleatoria.FieldDefs.Add(qrySelecaoAleatoria.Name + FieldName, ftDate, 0, false);
      end;

    end;

    if  ((ConsultaSelecaoAleatoria <> nil) and
         (ConsultaSelecaoAleatoria.TipoPesquisa in [pesItemAtributoValor])) then
    begin

      with TStringField.Create(qrySelecaoAleatoria) do
      begin
        FieldName := 'atributo';
        DisplayLabel := 'Atributo';
        FieldKind:= fkdata;
        DataSet := qrySelecaoAleatoria;
        qrySelecaoAleatoria.FieldDefs.Add(qrySelecaoAleatoria.Name + FieldName, ftString, 100, true);
      end;

      with TStringField.Create(qrySelecaoAleatoria) do
      begin
        FieldName := 'valor';
        DisplayLabel := 'Valor';
        FieldKind:= fkdata;
        DataSet := qrySelecaoAleatoria;
        qrySelecaoAleatoria.FieldDefs.Add(qrySelecaoAleatoria.Name + FieldName, ftString, 200, true);
      end;

    end;


    if {(dtmTecSoft.qryCamposAplicacao.active and dtmTecSoft.qryCamposAplicacao.locate('campo', 'codigo', [])) or}

        ((ConsultaSelecaoAleatoria <> nil) and
         ((ConsultaSelecaoAleatoria.TipoPesquisa in [pesNotas, pesNotasPag]) or
         not (ConsultaSelecaoAleatoria.TipoPesquisa
              in [pesItemAtributoValor, pesLOTESPRODUTOS,
                  pesContratos, pesESPECIFICACAO,
                  pesLOCALIZACAOESTOQUE, pesItemAtributoValor]))) or


        ((ConsultaSelecaoAleatoriaContabil <> nil) and
         ((ConsultaSelecaoAleatoriaContabil.TipoPesquisa in [pesNotas, pesNotasPag]) or
         not (ConsultaSelecaoAleatoriaContabil.TipoPesquisa
              in [pesItemAtributoValor, pesLOTESPRODUTOS,
                  pesContratos, pesESPECIFICACAO,
                  pesLOCALIZACAOESTOQUE, pesItemAtributoValor]))) then



    begin

      with TStringField.Create(qrySelecaoAleatoria) do
      begin
        FieldName := 'Codigo';
        DisplayLabel := 'Código';
        FieldKind:= fkdata;
        DataSet := qrySelecaoAleatoria;
        qrySelecaoAleatoria.FieldDefs.Add(qrySelecaoAleatoria.Name + FieldName, ftString, 18, true);
      end;

    end;

    if PossuiCampoFilial then
    begin
      with TIntegerField.Create(qrySelecaoAleatoria) do
      begin
        FieldName := 'filial';
        DisplayLabel := 'Filial';
        FieldKind:= fkdata;
        DataSet := qrySelecaoAleatoria;
        qrySelecaoAleatoria.FieldDefs.Add(qrySelecaoAleatoria.Name + FieldName, ftInteger, 0, true);
      end;
    end;

    if  ((ConsultaSelecaoAleatoria <> nil) and
