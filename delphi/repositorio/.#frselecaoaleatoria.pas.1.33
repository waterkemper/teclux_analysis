procedure TfraSelecaoAleatoria.dbgSelecaoAleatoriaCellClick(
  Column: TColumn);
begin
  AbrirTabela;
end;

procedure TfraSelecaoAleatoria.AbrirTabela;
begin
  if not qrySelecaoAleatoria.active then
  begin
    qrySelecaoAleatoria.Open;
    qrySelecaoAleatoria.delete;
    qrySelecaoAleatoria.delete;
  end;

end;

end.
