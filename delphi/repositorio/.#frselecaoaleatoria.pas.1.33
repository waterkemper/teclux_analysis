          vCampo := qryselecaoaleatoria.fieldbyname(CampoParaLista2).asString;
          dbgSelecaoAleatoria.SelectedIndex := dbgSelecaoAleatoria.ColumnByName(vCampo).Index;
          MensagemErro('A expressão lógica esta incorreta. O conteúdo do campo '+quotedstr(qryselecaoaleatoria.fieldbyname(CampoParaLista2).asstring)+ ' está vazio.');
          abort;
        end
        else
        if qryselecaoaleatoria.fieldbyname(CampoParaLista3).isnull then
        begin
          dbgSelecaoAleatoria.SetFocus;
          vCampo := qryselecaoaleatoria.fieldbyname(CampoParaLista3).asString;
          dbgSelecaoAleatoria.SelectedIndex := dbgSelecaoAleatoria.ColumnByName(vCampo).Index;
          MensagemErro('A expressão lógica esta incorreta. O conteúdo do campo '+quotedstr(qryselecaoaleatoria.fieldbyname(CampoParaLista3).asstring)+ ' está vazio.');
          abort;
        end
        else
        begin
        {
          if (operador(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) = 'in') or
             (operador(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) = 'not in') then
          begin
            result := result +

                    'cast('+qryselecaoaleatoria.fieldbyname('campo').asstring + ' as varchar) ' + operador(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) + ' ' +
                    separador_inicial(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) +
                    quotedstr(qryselecaoaleatoria.fieldbyname(qryselecaoaleatoria.fieldbyname('campo').asstring).asstring) + ' ' +
                    separador_final(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) +

                    Conjuncao + ' ';
          end
          else
          begin
          }
            result := result +

                    '(cast('+CampoParaLista+' as jsonb) @>  '+quotedstr('{"'+ qryselecaoaleatoria.fieldbyname(CampoParaLista2).asstring+'":"'+
                                                                             qryselecaoaleatoria.fieldbyname(CampoParaLista3).asstring+'"}')+')'+

                      Conjuncao + ' ';

  {        end;}
          qryselecaoaleatoria.next;
        end;
      {
      end
      else
      begin
          if (operador(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) = 'in') or
             (operador(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) = 'not in') then
          begin
            result := result +

                    'cast('+qryselecaoaleatoria.fieldbyname('campo').asstring + ' as varchar) ' + operador(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) + ' ' +
                    separador_inicial(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) +
                    quotedstr(qryselecaoaleatoria.fieldbyname('descricao').asstring) + ' ' +
                    separador_final(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) +

                    Conjuncao + ' ';

          end
          else
          begin
            result := result +

                    qryselecaoaleatoria.fieldbyname('campo').asstring + ' ' + operador(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) + ' ' +
                    separador_inicial(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) +
                    quotedstr(qryselecaoaleatoria.fieldbyname('descricao').asstring) + ' ' +
                    separador_final(qryselecaoaleatoria.fieldbyname('opcomparacao').asstring) +

                    Conjuncao + ' ';
          end;
          qryselecaoaleatoria.next;
          }
      end;
    end;
  end;
end;

