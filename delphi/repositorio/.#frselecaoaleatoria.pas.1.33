function TfraSelecaoAleatoria.Operador(opcomparacao: String): String;
begin
  if opcomparacao = 'Contém' then
    result := 'ilike'
  else
  if opcomparacao = 'Não Contém' then
    result := 'not ilike'
  else
  if opcomparacao = 'Contido na Lista' then
    result := 'in'
  else
  if opcomparacao = 'não Contido na Lista' then
    result := 'not in'
  else
    result := copy(opcomparacao,1,2)
end;



procedure TfraSelecaoAleatoria.Excluir;
begin
  if sbnExcluir.enabled then
    sbnExcluirClick(nil);
end;

procedure TfraSelecaoAleatoria.AdicionarItemNaLista(Codigo: String);
begin
  if not qrySelecaoAleatoria.active then
  begin
    qrySelecaoAleatoria.open;
    qrySelecaoAleatoria.delete;
    qrySelecaoAleatoria.delete;
  end;

  qrySelecaoAleatoria.append;
  qrySelecaoAleatoria.fieldbyname('codigo').asString := codigo;
  qrySelecaoAleatoria.post;

  if assigned(ConsultaSelecaoAleatoria) then
  begin
    ConsultaSelecaoAleatoria.edfcodigo.text := codigo;
    ConsultaSelecaoAleatoria.edfcodigo.modified := true;
    ConsultaSelecaoAleatoria.edfcodigo.exist;
    if assigned(ConsultaSelecaoAleatoria.OnFound) then
      ConsultaSelecaoAleatoria.OnFound;
  end
  else
  if assigned(ConsultaSelecaoAleatoriaContabil) then
  begin
    ConsultaSelecaoAleatoriaContabil.edfcodigo.text := codigo;
    ConsultaSelecaoAleatoriaContabil.edfcodigo.modified := true;
    ConsultaSelecaoAleatoriaContabil.edfcodigo.exist;
    if assigned(ConsultaSelecaoAleatoriaContabil.OnFound) then
      ConsultaSelecaoAleatoriaContabil.OnFound;

  end;
end;

procedure TfraSelecaoAleatoria.AdicionarListaItemNaLista(
  Lista: TStringList);
var
  i : integer;
begin
  for i:=0 to Lista.count-1 do
    AdicionarItemNaLista(Lista[i]);
end;

