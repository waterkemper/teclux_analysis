unit frselecaoaleatoriatiporecebimento;

interface

uses
  Windows, Messages, SysUtils, Variants, classes, Graphics, Controls, Forms, 
  Dialogs, frselecaoaleatoria, db, frConsulta, frConsultaCodigo, cpdbfindcontrols, ctconstantes, biblio;

type
  TfraSelecaoaleatoriatiporecebimento = class(TFrame)
    fraSelecaoAleatoriatiporecebimento: TfraSelecaoAleatoria;
    procedure fraSelecaoAleatoriatiporecebimentodbgSelecaoAleatoriaDblClick(
      Sender: TObject);
    procedure fraSelecaoAleatoriatiporecebimentodbgSelecaoAleatoriaKeyDown(
      Sender: TObject; var Key: Word; Shift: TShiftState);
    procedure fraSelecaoaleatoriatiporecebimentobnProcuraClick(
      Sender: TObject);
    procedure fraSelecaoAleatoriatiporecebimentoqrySelecaoAleatoriaAfterOpen(
      DataSet: TDataSet);
    procedure fraSelecaoAleatoriatiporecebimentoqrySelecaoAleatoriaNewRecord(
      DataSet: TDataSet);
  private
    { Private declarations }
    procedure AcionarPesquisaGrade;
    procedure AtribuirDadostiporecebimento;
    function GetListaCondicional: String;

  public
    { Public declarations }
    constructor Create(AOwner: TComponent); override;
    property ListaCondicional: String read GetListaCondicional;


  end;

implementation

{$R *.dfm}

{ TfraSelecaoaleatoriatiporecebimento }

procedure TfraSelecaoaleatoriatiporecebimento.AcionarPesquisaGrade;
begin
  with fraSelecaoAleatoriatiporecebimento do
  begin
    dbgSelecaoAleatoria.SetFocus;
    ConsultaSelecaoAleatoria.CtrlOn := True;
    ConsultaSelecaoAleatoria.InternoPesquisar('Item de Produto');
    dbgSelecaoAleatoria.SetFocus;
    dbgSelecaoAleatoria.SelectedIndex :=  0;
  end;
end;

constructor TfraSelecaoaleatoriatiporecebimento.Create(AOwner: TComponent);
begin
  inherited;


  fraSelecaoAleatoriatiporecebimento.qrySelecaoAleatoria.Sql.Text :=
//     'SELECT  Codigo, descricao FROM produtos WHERE false';
     'SELECT  cast(null as char(18)) as Codigo, '+
            ' cast(null as char(1)) as tipo, '+
            ' cast(null as varchar(50)) as descricao, '+
            ' cast(null as varchar(10)) as campo, '+
            ' cast(null as varchar(20)) as opcomparacao, '+
            ' cast(null as varchar(2)) as oplogico ';


  fraSelecaoAleatoriatiporecebimento.UtilizarCamparacaoeLogica := true;

  fraSelecaoAleatoriatiporecebimento.CampoParaLista := 'codigo';


  with fraSelecaoAleatoriatiporecebimento do
  begin

    ConsultaSelecaoAleatoria := TfraConsultaCodigo.Create(self);
    ConsultaSelecaoAleatoria.Name := 'fraConsultaSelecaoAleatoria';
    ConsultaSelecaoAleatoria.edfCodigo.MaxLength := 4;
    ConsultaSelecaoAleatoria.edfCodigo.DataSource := dsrSelecaoAleatoria;
    ConsultaSelecaoAleatoria.edfCodigo.DataField := 'codigo';
    ConsultaSelecaoAleatoria.edfCodigo.DataaFieldInterno := 'codigo';
    ConsultaSelecaoAleatoria.edfCodigo.DataaFieldVisual := 'codigo';

    ConsultaSelecaoAleatoria.edfCodigo.Operacao := opATRIBUICAO;
    ConsultaSelecaoAleatoria.edfCodigo.LookupSource := ConsultaSelecaoAleatoria.dsrProcuraTipoRecebimento;
    ConsultaSelecaoAleatoria.edfCodigo.LookupQueryParameter := 'codigo';
    ConsultaSelecaoAleatoria.edfCodigo.LookupField := 'codigo';
    ConsultaSelecaoAleatoria.edfCodigo.LookupaFieldinterno := 'codigo';
    ConsultaSelecaoAleatoria.edfCodigo.LookupaFieldVisual := 'codigo';
    ConsultaSelecaoAleatoria.edfCodigo.NaoExecutarLookupFound := true;

    ConsultaSelecaoAleatoria.AbrirTabelaProcura := false;
//    ConsultaSelecaoAleatoria.CondicoesdaConsulta := CondicoesFluxoGramasOperacoes;
    ConsultaSelecaoAleatoria.TipoPesquisa := pesTIPORECEBIMENTO;
    ConsultaSelecaoAleatoria.OnFound := AtribuirDadostiporecebimento;

  end;
end;

procedure TfraSelecaoaleatoriatiporecebimento.fraSelecaoAleatoriatiporecebimentodbgSelecaoAleatoriaDblClick(
  Sender: TObject);
begin
  if (fraSelecaoAleatoriatiporecebimento.dbgSelecaoAleatoria.SelectedField = fraSelecaoAleatoriatiporecebimento.qrySelecaoAleatoria.FieldByName('codigo')) then
    acionarPesquisaGrade;

end;

procedure TfraSelecaoaleatoriatiporecebimento.fraSelecaoAleatoriatiporecebimentodbgSelecaoAleatoriaKeyDown(
  Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  if Shift = [ssCtrl] then
  begin
    case Key of
      VK_F9     : begin
                     if (fraSelecaoAleatoriatiporecebimento.dbgSelecaoAleatoria.SelectedField = fraSelecaoAleatoriatiporecebimento.qrySelecaoAleatoria.FieldByName('codigo')) then
                     begin
                       fraSelecaoAleatoriatiporecebimento.ConsultaSelecaoAleatoria.CtrlOn := Shift = [ssCtrl];
                       if (Shift = []) or fraSelecaoAleatoriatiporecebimento.ConsultaSelecaoAleatoria.CtrlOn then
                         AcionarPesquisaGrade
                     end;    
                   end;
    end;
  end
  else
  case Key of
    VK_Return: if (fraSelecaoAleatoriatiporecebimento.dbgSelecaoAleatoria.SelectedField = fraSelecaoAleatoriatiporecebimento.qrySelecaoAleatoria.FieldByName('codigo')) then
                begin
                  fraSelecaoAleatoriatiporecebimento.ConsultaSelecaoAleatoria.edfCodigo.text := fraSelecaoAleatoriatiporecebimento.qrySelecaoAleatoria.FieldByName('codigo').asString;
                  fraSelecaoAleatoriatiporecebimento.ConsultaSelecaoAleatoria.edfCodigo.exist;
                  if not fraSelecaoAleatoriatiporecebimento.ConsultaSelecaoAleatoria.qryProcuraTipoRecebimento.IsEmpty then
                    AtribuirDadostiporecebimento
                  else
                  begin
                    key := 0;
                    fraSelecaoAleatoriatiporecebimento.dbgSelecaoAleatoria.SelectedIndex := 0;
                    fraSelecaoAleatoriatiporecebimento.dbgSelecaoAleatoria.SetFocus;
                  end;
                end;
  end;

end;

procedure TfraSelecaoaleatoriatiporecebimento.fraSelecaoaleatoriatiporecebimentobnProcuraClick(
  Sender: TObject);
begin
  AcionarPesquisaGrade;

end;

procedure TfraSelecaoaleatoriatiporecebimento.fraSelecaoAleatoriatiporecebimentoqrySelecaoAleatoriaAfterOpen(
  DataSet: TDataSet);
begin
  with fraSelecaoAleatoriatiporecebimento do
  begin
    qrySelecaoAleatoria.FieldByName('codigo').DisplayLabel := 'tipo';
//    qrySelecaoAleatoria.FieldByName('codigo').SetFieldType(ftLargeInt);
    qrySelecaoAleatoria.FieldByName('codigo').ReadOnly := False;

    qrySelecaoAleatoria.FieldByName('descricao').DisplayLabel := 'Descrição';
    qrySelecaoAleatoria.FieldByName('descricao').ReadOnly := true;

    qrySelecaoAleatoria.FieldByName('opcomparacao').DisplayLabel := 'Comparação';
    qrySelecaoAleatoria.FieldByName('opcomparacao').ReadOnly := false;

    qrySelecaoAleatoria.FieldByName('oplogico').DisplayLabel := 'Lógica';
    qrySelecaoAleatoria.FieldByName('oplogico').ReadOnly := false;

    qrySelecaoAleatoria.Append;
    qrySelecaoAleatoria.Post;
  end;

end;

procedure TfraSelecaoaleatoriatiporecebimento.fraSelecaoAleatoriatiporecebimentoqrySelecaoAleatoriaNewRecord(
  DataSet: TDataSet);
begin
  with fraSelecaoAleatoriatiporecebimento do
  begin
    qrySelecaoAleatoria.FieldByName('campo').asString := 'codigo';
    qrySelecaoAleatoria.FieldByName('opcomparacao').asString := '= Igual a';
    qrySelecaoAleatoria.FieldByName('oplogico').asString := 'ou';
  end;
end;

procedure TfraSelecaoaleatoriatiporecebimento.AtribuirDadostiporecebimento;
begin
  with fraSelecaoAleatoriatiporecebimento do
  begin
    qrySelecaoAleatoria.Edit;
    qrySelecaoAleatoria.FieldByName('codigo').AsString :=
        ConsultaSelecaoAleatoria.qryProcuraTipoRecebimentocodigo.AsString;

    qrySelecaoAleatoria.FieldByName('descricao').AsString :=
        ConsultaSelecaoAleatoria.qryProcuraTipoRecebimentodescricao.AsString;

    if qrySelecaoAleatoria.FieldByName('campo').asString = '' then
      qrySelecaoAleatoria.FieldByName('campo').asString := 'codigo';

    if qrySelecaoAleatoria.FieldByName('opcomparacao').asString = '' then
      qrySelecaoAleatoria.FieldByName('opcomparacao').asString := '= Igual a';

    if qrySelecaoAleatoria.FieldByName('oplogico').asString = '' then
      qrySelecaoAleatoria.FieldByName('oplogico').asString := 'ou';

    qrySelecaoAleatoria.Post;

  end;
end;

function TfraSelecaoaleatoriatiporecebimento.GetListaCondicional: String;
begin
  result := trocar(fraSelecaoAleatoriatiporecebimento.ListaCondicional, 'codigo', 'tr.codigo');
  result := trocar(result, 'descricao','tr.descricao');
end;

end.
