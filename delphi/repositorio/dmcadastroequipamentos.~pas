procedure TdtmCadastroEquipamentos.AbrirTabelas(TipoPesquisa: TtecCadastroEquipamentos);
begin
  case TipoPesquisa of
    ceqEQUIPAMENTO: begin
                        if (FCliente>0) then
                          qryConsultaEquipamentos.Sql[05]:='WHERE codigo NOT IN (SELECT ec.equipamento FROM equipamentosclientes ec where ec.cliente<>'+inttostr(FCliente)+')' ;
                        Abre(ctConsultaEquipamentos);
                    end;
          ceqMARCA: Abre(ctConsultaMarcas);
        ceqPRODUTO: begin
                      qryConsultaProdutos.Sql[8] := 'where false';
                      Abre(ctConsultaProdutos);
                    end;
  end;
end;

