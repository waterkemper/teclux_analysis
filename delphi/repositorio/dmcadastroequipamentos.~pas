procedure TdtmCadastroEquipamentos.Imprimir;
var
  Relatorio: TfrReport;
  frmPreview: TfrmPreviewPadrao;
begin
  qryProdutosEquipamentos.Filter   := 'imprimir';
  GuardarRegistroAtual(qryProdutosEquipamentos, true);
  qryProdutosEquipamentos.First;
  while not qryProdutosEquipamentos.Eof do
  begin
    if qryProdutosEquipamentosimprimir.AsBoolean then
    begin
      qryProdutosEquipamentos.Filtered := True;
      break;
    end;
    qryProdutosEquipamentos.Next;
  end;
  VoltarRegistroAtual(qryProdutosEquipamentos);

{  if not flag then
  begin
    qryProdutosEquipamentos.First;
    while not qryProdutosEquipamentos.Eof do
    begin
      qryProdutosEquipamentos.Edit;
      qryProdutosEquipamentosimprimir.AsBoolean := true;
      qryProdutosEquipamentos.Post;
      qryProdutosEquipamentos.Next;
    end;
    qryProdutosEquipamentos.First;
    VoltarRegistroAtual(qryProdutosEquipamentos);
  end;
}
  FImprimindo := True;
  frVariables['titulo']:='REQUISIÇÃO DE MATERIAL';
//  frpEquipamento.DesignReport;
  frmPreview := TfrmPreviewPadrao.create(self);
  frmPreview.cmbZoom.ItemIndex := 3;
  try
    Relatorio := frmPreview.frCompositeReport;
    frmPreview.frCompositeReport.Reports.Clear;
    frmPreview.frCompositeReport.Reports.Add(frpEquipamento);
    Relatorio.Preview := frmPreview.frPreviewPadrao;
    Relatorio.ShowReport;
    frmPreview.ShowModal;  finally
    qryProdutosEquipamentos.Filtered := False;
    frmPreview.Free;
    FImprimindo := False;
  end;
end;

