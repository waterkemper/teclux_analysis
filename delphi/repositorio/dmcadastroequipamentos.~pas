function TdtmCadastroEquipamentos.IncluirProdutoEquipamento(
  Editar: Boolean): Boolean;

  procedure ProdutosUtilizados;
  var
    SQLP: String;
    Produto: Int64;
  begin
    SQLP:= '';
    if not qryProdutosEquipamentos.IsEmpty then begin
      Produto:= qryProdutosEquipamentosproduto.AsLargeInt;
      GuardarRegistroAtual(qryProdutosEquipamentos, True);
      try
        qryProdutosEquipamentos.First;
        while not qryProdutosEquipamentos.Eof do begin
          if not Editar or
             (Editar and (Produto <> qryProdutosEquipamentosproduto.AsLargeInt)) then
            SQLP:= SQLP + 'and (p.codigo <> ' + IntToStr(qryProdutosEquipamentosproduto.AsLargeInt) + ')';
          qryProdutosEquipamentos.Next;
        end;
      finally
        VoltarRegistroAtual(qryProdutosEquipamentos);
      end;
    end;
    qryProcuraProduto.Sql[3] := SQLP;
    qryConsultaProdutos.Sql[8]:= SQLP;
  end;

begin
  ProdutosUtilizados;
  if qryProdutosEquipamentos.State in [dsInsert, dsEdit] then
    qryProdutosEquipamentos.Cancel;
  if Editar and not qryProdutosEquipamentos.IsEmpty then begin
    qryProcuraProduto.Params[0].AsString := qryProdutosEquipamentosproduto.AsString;
    qryProdutosEquipamentos.Edit;
    qryProdutosEquipamentos.Cancel;
  end
  else
  begin
    qryProcuraProduto.Params[0].Clear;
    qryProdutosEquipamentos.Append;
    qryProdutosEquipamentosquantidade.AsCurrency := ParSistema.ValordaQuantidade;
  end;
  Result := True;
end;

