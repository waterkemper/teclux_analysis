function TdtmCadastroEquipamentos.GravarEquipamento: Boolean;
var
  n : Integer;
begin
  Result := False;
  n := 0;
  if qryEquipamentos.CheckRequiredFields then begin
    if (qryEquipamentos.State = dsInsert) and
       (qryEquipamentosCodigo.AsString = '') then begin
      spcEquipamentosProximoCodigo.Open;
      qryEquipamentosCodigo.AsString:= spcEquipamentosProximoCodigoCodigo.AsString;
      spcEquipamentosProximoCodigo.Close;
    end;
    qryEquipamentos.Post;
    if FCliente > 0 then
    begin
      if qryEquipamentosCliente.State=dsInsert then
      begin
        qryEquipamentosClientedescricao.AsString:=qryEquipamentosdescricao.AsString;
        qryEquipamentosClienteequipamento.AsString:= qryEquipamentosCodigo.AsString;
        qryEquipamentosClientereferencia.AsString:=qryEquipamentosreferencia.AsString;
        qryEquipamentosClientemodelo.AsString:=qryEquipamentosmodelo.AsString;
        qryEquipamentosClienteano.AsInteger:=qryEquipamentosano.AsInteger;
        qryEquipamentosClienteopcionais.AsString:=qryEquipamentosopcionais.AsString;
      end;
      if not qryEquipamentosCliente.IsEmpty then
      begin
        qryEquipamentosCliente.First;
        while not qryEquipamentosCliente.Eof do
        begin
          qryEquipamentosCliente.Edit;
          qryEquipamentosClientecliente.AsInteger:= FCliente;
          qryEquipamentosCliente.Post;
          qryEquipamentosCliente.Next;
        end;
      end;
    end;

    qryProdutosEquipamentos.DisableControls;
    qryProdutosEquipamentos.First;
    while not qryProdutosEquipamentos.Eof do
    begin
      qryProdutosEquipamentos.Edit;
      qryProdutosEquipamentosequipamento.AsString := qryEquipamentosCodigo.AsString;
      Inc(n);
      qryProdutosEquipamentosnumero.AsInteger := n;
      qryProdutosEquipamentos.Post;
      qryProdutosEquipamentos.Next;
    end;
    qryProdutosEquipamentos.EnableControls;

    Perpetrar([qryEquipamentos,qryEquipamentosCliente,qryProdutosEquipamentos]);

    if FCliente>0 then
    begin
      RefazConsultaEquipamentosClientes(FCliente);
    end;

    Result := True;
  end
end;

function TdtmCadastroEquipamentos.IncluirEquipamento(Editar: Boolean): Boolean;
begin
  if(FCliente>0) then
  begin
    IncluirEquipamentosCliente(Editar);
    if Editar then
    begin
      if self.owner.classname <> 'TfrmCadastroEquipamentos' then
        RefazConsulta(qryEquipamentos,[0],[qryEquipamentosClienteequipamento.AsString]);

      qryEquipamentos.Edit;
    end
    else
      qryEquipamentos.Insert;
  end
  else
  begin
    if editar and (qryEquipamentos.recordcount<>0) then
      qryEquipamentos.edit
    else
      qryEquipamentos.Insert;
  end;
  Result := True;
end;

function TdtmCadastroEquipamentos.IncluirEquipamentosCliente(Editar: Boolean): Boolean;
{
  procedure Equipamentos;
  var
    Pos: TBookmark;
    Campos: String;
    Equipamento: String;
  begin
    Campos:= '';
    Equipamento:= qryEquipamentosClienteequipamento.AsString;
    Pos:= qryEquipamentosCliente.GetBookmark;
    try
      qryEquipamentosCliente.DisableControls;
      if not (qryEquipamentosCliente.State in [dsinsert, dsedit]) then
        qryEquipamentosCliente.Edit;
      qryEquipamentosCliente.First;
      while not qryEquipamentosCliente.Eof do begin
        if not Editar then
          Campos:= Campos + '' + qryEquipamentosClienteequipamento.AsString + ','
        else if qryEquipamentosClienteequipamento.AsString <> Equipamento then
          Campos:= Campos + '' + qryEquipamentosClienteequipamento.AsString + ',';
        qryEquipamentosCliente.Next;
      end;
    finally
      qryEquipamentosCliente.GotoBookmark(Pos);
      qryEquipamentosCliente.FreeBookmark(Pos);
      qryEquipamentosCliente.EnableControls;
      Delete(Campos,Length(Campos),1);
      if Campos = '' then Campos:= '0';
    end;
//    qryProcuraEquipamentos.Sql[12] := Format('Where (ec.equipamento <> %s)',[IntToStr(Equipamento)]);
//    qryProcuraEquipamentos.Sql[14] := Format('and not (e.codigo in (%s))',  [Campos]);
//    qryConsultaEquipamentos.Sql[09]:= Format('Where (ec.equipamento <> %s)',[IntToStr(Equipamento)]);
//    qryConsultaEquipamentos.Sql[11]:= Format('and not (e.codigo in (%s))',  [Campos]);
  end;
}

begin
//  Equipamentos;
  if not Editar or qryEquipamentosCliente.IsEmpty then
    qryEquipamentosCliente.Append
  else
  begin
    qryEquipamentosCliente.Edit;
    qryEquipamentosCliente.Cancel;
  end;
  Result:= True;
end;

