function TdtmCadastroEquipamentos.ExcluirEquipamento: Boolean;
begin
  if (FCliente>0) then
  begin
    if not qryEquipamentosCliente.IsEmpty then
         qryEquipamentosCliente.Delete
    else qryEquipamentosCliente.Cancel;
    Perpetrar([qryEquipamentosCliente]);
  end;
  qryEquipamentos.Delete;
  Perpetrar([qryEquipamentos, qryProdutosEquipamentos]);
  Result := True;
end;

function TdtmCadastroEquipamentos.ExcluirEquipamentosCliente: Boolean;
begin
  Result:= False;
  if MensagemConfirmacao(format(ctCONFIRMEEXCLUIR, ['o EQUIPAMENTO DO CLIENTE'])) = smbOk then begin
    if not qryEquipamentosCliente.IsEmpty then
    begin
         qryEquipamentosCliente.Delete;
         Perpetrar([qryEquipamentosCliente]);
    end
    else qryEquipamentosCliente.Cancel;
    Result:= True;
  end;
end;

