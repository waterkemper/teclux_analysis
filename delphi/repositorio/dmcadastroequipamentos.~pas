begin
  qryEquipamentosCliente.MacroByName('OrderBy').AsString:= 'order by (e.descricao)';
  ReFazConsulta(qryEquipamentosCliente,[0],[cliente]);
  qryequipamentoscliente.Locate('equipamento', qryEquipamentosCodigo.asString,[]);
end;

procedure TdtmCadastroEquipamentos.Selecionar(TipoPesquisa: TtecCadastroEquipamentos);
begin
  case TipoPesquisa of
    ceqEQUIPAMENTO: begin
                        RefazConsulta(qryEquipamentos, [0], [qryConsultaEquipamentosCodigo.AsString]);
                        if (FCliente>0) then
                          qryEquipamentos.Edit;
                    end;
          ceqMARCA: begin
                      qryEquipamentos.Edit;
                      qryEquipamentosmarca.AsInteger:= qryConsultaMarcascodigo.AsInteger;
                    end;
        ceqPRODUTO: begin
                      qryProdutosEquipamentos.Edit;
                      qryProdutosEquipamentosproduto.AsLargeInt := qryConsultaProdutoscodigo.AsLargeInt;
                      qryProdutosEquipamentosdescricao.AsString := qryConsultaProdutosdescricao.AsString;
                      qryProdutosEquipamentosvalorgrade1.AsString := qryConsultaProdutosvalorgrade1.AsString;
                      qryProdutosEquipamentosvalorgrade2.AsString := qryConsultaProdutosvalorgrade2.AsString;
                      RefazConsulta(qryProcuraProduto,[0],[qryConsultaProdutoscodigo.AsVariant]);
                    end;

  end;
end;


