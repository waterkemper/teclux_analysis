    Constraints = <>
    AfterScroll = qryContratosAfterScroll
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT c.cliente,'
      '       c.tipocliente,'
      '       c.avalista,'
      
        '       (select cl.nome from clientes cl where cl.codigo=c.avalis' +
        'ta) as nomeavalista,'
      '       c.numero,'
      '       c.data, c.faturamento,'
      '       c.filialvenda,'
      '       c.valorprazo as valor,'
      '       c.valorvista,'
      '       c.frete,'
      '       c.desconto,'
      '       (c.valorprazo - c.valorvista) as acrescimo,'
      '       c.origem,'
      '       c.situacao,'
      '       c.primogenito,'
      
        '       COALESCE((select d.nome from dependentes d where d.codigo' +
        ' = c.dependente),c.consideracoes) as nomedependente,'
      '       (select c2.numero'
      '        from   contratos c2'
      '        where  (c2.origem = c.numero)) as renegociado,'
      ''
      '       (select ct.nome'
      '        from   contratos ct'
      '        where  ct.numero = (select c2.numero'
      '                            from   contratos c2'
      
        '                            where  (c2.numero = c.primogenito) a' +
        'nd'
      '                                   (c2.cliente <> c.cliente) and'
      
        '                                   (c2.tipocliente <> c.tipoclie' +
        'nte))) as nomeclienteprimogenito,'
      '       (select ct.nome'
      '        from   contratos ct'
      '        where  ct.numero = (select c2.numero'
      '                            from   contratos c2'
      '                            where  (c2.numero = c.origem) and'
      '                                   (c2.cliente <> c.cliente) and'
      
        '                                   (c2.tipocliente <> c.tipoclie' +
        'nte))) as nomeclienteorigem,'
      '       (select ct.nome'
      '        from   contratos ct'
      '        where ct.numero = (select c2.numero'
      '                           from   contratos c2'
      '                           where  (c2.numero = (select c3.numero'
      
        '                                                from   contratos' +
        ' c3'
      
        '                                                where  (c3.orige' +
        'm = c.numero)  and'
      
        '                                                       (c3.clien' +
        'te <> c.cliente) and'
      
        '                                                       (c3.tipoc' +
        'liente <> c.tipocliente))))) as nomeclienterenegociado,'
      '       u.nome,'
      '       planos_descricaoresumida(c.plano) as planoresumido,'
      '       c.plano,'
      
        '       (select pl.descricao from planos pl where pl.codigo = c.p' +
        'lano) as descricaoplano,'
      '       vficha_situacaocontrato(c.numero) as situacaocontrato,'
      '     CASE WHEN contratos_emaberto(c.numero)'
      '          THEN True'
      '          ELSE False'
      '     END as aberto,'
      '     (select u.nome'
      '      from usuarios u'
      '      where u.codigo = (select uc.usuario'
      '                        from usuarioscontratos uc'
      
        '                        where uc.contrato = c.numero order by uc' +
        '.data desc limit 1)) as nomecobrador,'
      ''
      ''
      '       coalesce((select 2'
      '                 where exists (select ps.contrato'
      
        '                               from pedidos_site ps             ' +
        '               /* 1=Opera'#231#227'o presencial; */'
      
        '                               where ps.contrato = c.numero limi' +
        't 1)), 1) as indpres,  /* 2=Opera'#231#227'o n'#227'o presencial, pela Intern' +
        'et; */'
      '     (select true'
      '      from parcelas p'
      '      where p.contrato = c.numero'
      
        '        and p.datapagto is null limit 1) as ExisteParcelaemAbert' +
        'o,'
      ''
      '     c.cupom_valor_desconto,'
      ''
      '     c.cupom_desconto,'
      ''
      '     (select c_p.codigo_cupom'
      '      from cupons_desconto c_p'
      '      where c_p.codigo = c.cupom_desconto) as codigo_cupom,'
      ''
      '     c.desconto_cashback, '
      ''
      '     c.os '
      ''
      ''
      'FROM  contratos c, usuarios u'
      'WHERE c.vendedor = u.codigo and'
      '      c.numero=:numero')
    RequestLive = False
    Left = 64
    Top = 136
    ParamData = <
      item
        DataType = ftString
        Name = 'numero'
        ParamType = ptUnknown
        Value = '0'
      end>
