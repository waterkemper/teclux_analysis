      #9#9#9#9'      else '#39'PARCIAL'#39
      #9#9#9#9' end)'
      #9#9'           end),'#39'ABERTA'#39') as varchar) as situacao'
      ''
      ''
      
        'from ((((produtoscontratos pc join dadosfiscais df on pc.contrat' +
        'o = df.contrato)'
      #9'join produtosdadosfiscais pdf on df.numero = pdf.dadofiscal'
      #9#9#9#9'     and pc.produto = pdf.produto'
      #9#9#9#9'     and pc.filial = pdf.filial)'
      #9'join requisicoes r on df.numero = r.dadofiscal)'
