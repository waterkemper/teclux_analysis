function TdtmImprimeCarne.ImprimirCarneECF: Boolean;
var
 titulo, valoresparcelas, textolivre, nomecliente, rg_cpf, vendedor, cidade_data, cod_con_data,
 cod_con_data2, demonstracao, ultimaparcelapaga, codigobarras: String;
 a: Integer;
 sair:boolean;

begin
  if not ErroECF then
  begin
    titulo := qryParcelasrazaocarne.AsString;
    nomecliente := 'CLIENTE: ' + qryParcelasECFnome.AsString{ + #13#10};
    rg_cpf := 'CPF: ' + qryParcelasECFpessoanumero.AsString{ + #13#10};
    Vendedor := 'VENDEDOR: ' + qryParcelasECFvendedor.AsString{ + #13#10};
    cidade_data := CidadeFilialBase + ', ' + DataExtenso(DataServidor){ + #13#10};
    cod_con_data := 'CÓD.CLIENTE        CONTRATO        DATA COMPRA'{ + #13#10};
    cod_con_data2 := Format('%-11s', [qryParcelasECFcliente.AsString])  +
                     Format('%16s', [qryParcelasECFcontrato.AsString]) + '         ' +
                     preencheString(FormatDateTime('dd/mm/yyyy',qryParcelasECFdata.AsDateTime), ' ', 11) + #13#10{#13#10};
    qryParcelasECF.First;
    ultimaparcelapaga := '';
    codigobarras := '';
    while not qryParcelasECF.Eof do
    begin
      if qryParcelasECFdatapagto.AsString = ' ' then
        break
      else
        ultimaparcelapaga := Format('%3.3d', [qryParcelasECFnumero.AsInteger]) + ' ' +
                             Format('%8s',[qryParcelasECFdatapagto.AsString]) + ' ' +
                             Format('%8s',[trim(Trocar(Trocar(Format('%8.2m',[qryParcelasECFvalorvencto.AsFloat]),'R',''),'$',''))]) +  '  ' +
                             Format('%7s',[trim(Trocar(Trocar(Format('%7.2m',[qryParcelasECFacrescimo.AsFloat]),'R',''),'$',''))]) +  '  ' +
                             Format('%5s',[trim(Trocar(Trocar(Format('%5.2m',[qryParcelasECFdesconto.AsFloat]),'R',''),'$',''))]) +  '  ' +
                             Format('%7s',[trim(Trocar(Trocar(Format('%7.2m',[qryParcelasECFvalorpagto.AsFloat]),'R',''),'$',''))]) + #13#10#13#10;
      qryParcelasECF.Next;
    end;
    qryParcelasECF.First;
    while not qryParcelasECF.Eof do
    begin
      if qryParcelasECFdatapagto.AsString = ' ' then
      begin
        codigobarras := qryParcelasECFcontrato.AsString + Format('%3.3d', [qryParcelasECFnumero.AsInteger]);
        break;
      end;
      qryParcelasECF.Next;
    end;
    if ultimaparcelapaga <> '' then
      demonstracao := 'DEMONSTRATIVO DO ÚLTIMO PAGTO DESSE CONTRATO' + #13#10 +
                      'PAR DT.PAGTO VL.PARC.  ACRÉSC.  DESC.  VL.PAGO'{ + #13#10}
    else
      demonstracao := '';

    textolivre := '              VENCIMENTOS DO CARNÊ' + #13#10 +
                  'PAR   DT.VENCTO   PARCELA   DT.PAGTO    SITUAÇÃO';

    Sair := True;
    valoresparcelas := '';
    try
      try
        if not ecfpadrao.erro then
        begin
          repeat
            a := 0;
            qryParcelasECF.First;
            while not qryParcelasECF.Eof do
            begin
              Inc(a);
              if a mod 10 = 0 then
              begin
                valoresparcelas := valoresparcelas + Format('%-7.3d', [qryParcelasECFnumero.AsInteger]) +// '    ' +
                         preencheString(FormatDateTime('dd/mm/yy',qryParcelasECFdatavencto.AsDateTime), ' ', 8) + '   ' +
                         Format('%7s',[trim(Trocar(Trocar(Format('%7.2m',[qryParcelasECFvalorvencto.AsFloat]),'R',''),'$',''))]) +//  '   ' +
                         Format('%11s',[qryParcelasECFdatapagto.AsString]) +// '     ' +
                         Format('%10s',[qryParcelasECFsituacao.AsString]);// + #13#10;
                ECFPadrao.RelatorioGerencial([valoresparcelas],1);
                valoresparcelas := '';
              end
              else
              begin
                valoresparcelas := valoresparcelas + Format('%-7.3d', [qryParcelasECFnumero.AsInteger]) +// '    ' +
                         preencheString(FormatDateTime('dd/mm/yy',qryParcelasECFdatavencto.AsDateTime), ' ', 8) + '   ' +
                         Format('%7s',[trim(Trocar(Trocar(Format('%7.2m',[qryParcelasECFvalorvencto.AsFloat]),'R',''),'$',''))]) +//  '   ' +
                         Format('%11s',[qryParcelasECFdatapagto.AsString]) +// '     ' +
                         Format('%10s',[qryParcelasECFsituacao.AsString]) + #13#10;
              end;
              qryParcelasECF.Next;
            end;
            if (not ecfpadrao.erro) and (valoresparcelas <> '') then
            begin
              ECFPadrao.RelatorioGerencial([titulo, nomecliente, rg_cpf, vendedor,cidade_data, cod_con_data, cod_con_data2,demonstracao,ultimaparcelapaga,textolivre,valoresparcelas],1);
//              ECFPadrao.RelatorioGerencial([textolivre,valoresparcelas],1);
              valoresparcelas := '';
            end;
            if ecfpadrao.erro then
              Sair := biblio.MensagemConfirmacao(ECFPadrao.Mensagem + #13#10 + ctTEFIMPRIMIRNOVAMENTE) <> smbOK;
          until Sair or (Not ecfpadrao.erro);
        end;
        if (not ecfpadrao.erro) and (codigobarras <> '') then
        begin
          repeat
            ECFPadrao.CodigoBarrasEAN13MFD(codigobarras);
            if ecfpadrao.erro then
              Sair := biblio.MensagemConfirmacao(ECFPadrao.Mensagem + #13#10 + ctTEFIMPRIMIRNOVAMENTE) <> smbOK;
          until Sair or (Not ecfpadrao.erro);
        end
      except
        raise;
      end;
    finally
      ECFPadrao.FecharRelatorioGerencial;
      Result := Sair;
    end;
  end
  else
    Result := false;
end;

