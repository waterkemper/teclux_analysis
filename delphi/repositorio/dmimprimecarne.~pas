function TdtmImprimeCarne.ObterParcelas(Contrato: String): Boolean;
begin
  qryParcelas.MacroByName('WhereNumeroParcelas').AsString := '';
  RefazConsulta(qryParcelas,[0],[Contrato]);
  qryParcelas.First;
  AtribuirPercentualAtrasoJuros;
  Result:= (qryParcelas.RecordCount > 0);
end;

function TdtmImprimeCarne.ObterParcelas(Contrato: String; NumeroParcelas: vString): Boolean;
const
  SQLParcelas= 'and (p.numero in (%s))';
var
  i: Integer;
  parcelas: String;
begin
  if Numeroparcelas<>nil then
  begin
    for i:=0 to length(numeroparcelas)-1 do
      parcelas := parcelas+NumeroParcelas[i]+',';

    delete(parcelas,length(parcelas),1);
    qryParcelas.MacroByName('WhereNumeroParcelas').AsString := format(SQLParcelas,[parcelas]);
  end
  else
    qryParcelas.MacroByName('WhereNumeroParcelas').AsString := format(SQLParcelas,['0']);

  RefazConsulta(qryParcelas,[0],[Contrato]);
  qryParcelas.First;
  AtribuirPercentualAtrasoJuros;
  Result:= (qryParcelas.RecordCount > 0);

end;


function TdtmImprimeCarne.ImprimirCarnesContrato(Contrato: String; SomenteAbertas: Boolean): Boolean;
begin
//  Result := False;
  if ParSistema.ImpressaoCarneECF and ObterParcelasECF(Contrato) then
    try
      Result := ImprimirCarneECF;
    except
      raise
    end
  else
  begin
    result := AbrirModeloCarne;
    if result then
      if ObterParcelas(Contrato) then
        try
          Result := ImprimirCarne(SomenteAbertas,nil);
        except
          raise
        end;
  end;
end;

function TdtmImprimeCarne.ImprimirCarnesContrato(Contrato: String;
  NumeroParcelas: vString; IniciarFinalizarDocumento: Boolean = True): Boolean;
begin
//  Result := False;
  if ParSistema.ImpressaoCarneECF and ObterParcelasECF(Contrato) then
    try
      Result := ImprimirCarneECF;
    except
      raise
    end
  else
  begin
    if IniciarFinalizarDocumento then
      result := AbrirModeloCarne
    else
      result := true;

    if result then
      if ObterParcelas(Contrato,NumeroParcelas) then
        try
          Result := ImprimirCarne(false, NumeroParcelas, IniciarFinalizarDocumento);
        except
          raise
        end;
  end;
end;

function TdtmImprimeCarne.ImprimirCarne(SomenteAbertas: Boolean;
  NumeroParcelas: vString; IniciarFinalizarDocumento: Boolean = True): Boolean;
var Esquerdo: Boolean;
    Cabecalho:      Array [01..02] of String;
    Nome:           Array [01..02] of String;
    ComAtraso:      Array [01..02] of String;
    SemAtraso:      Array [01..02] of String;
    EmAberto:       Array [01..02] of String;
    Juros:          Array [01..02] of String;
    TotalAtraso:    Array [01..02] of String;
    TotalSemAtraso: Array [01..02] of String;
    Rodape:         Array [01..02] of String;

    a: integer;
   {$IFNDEF LINUX}
    vNewIndex : integer;
    vPrinter : TPrinter;
   {$ENDIF}

    PV: TfrxComponent;


begin
  Result := True;
  try
    if NumeroParcelas = nil then
    begin
      a:=0;
      NumeroParcelas := nil;
      SetLength(NumeroParcelas, qryparcelas.RecordCount);
      qryParcelas.First;
      while not qryparcelas.Eof do
      begin
        NumeroParcelas[a] := qryParcelasnumero.AsString;
        inc(a);
        qryparcelas.next;
      end;
    end;

    NomeImpressoraEscolhida:=  parsistema.NomeImpressoraCarne;
    if qryModeloCarnearquivofast.AsString <> '' then
    begin
      if not FileExists(qryModeloCarnearquivofast.AsString) then
        mensagemErro('Arquivo '+qryModeloCarnearquivofast.AsString+ ' não encontrado!')
      else
      begin
        frpCarne_fast_4.LoadFromFile(qryModeloCarnearquivofast.AsString);
        frpCarne_fast_4.PrepareReport;
//        frpCarne_fast_4.DesignReport;

        if FileExists(LogotipoFilialBase) then
        begin
          PV := frpCarne_fast_4.FindObject('PictureFatura');
          if (PV is TfrxPictureView) then
            TfrxPictureView(PV).picture.LoadFromFile(LogotipoFilialBase);
        end;


//        frpCarne_fast_4.DesignReport;        
        if parsistema.NomeImpressoraCarne<>'' then
        begin
          frpCarne_fast_4.PrintOptions.Printer := parsistema.NomeImpressoraCarne;
          frpCarne_fast_4.SelectPrinter;
          frpCarne_fast_4.PrepareReport;
          frpCarne_fast_4.Print;
        end
        else
          frpCarne_fast_4.ShowReport(true);
      end;
    end
    else
    begin
      with TextPrinter do begin
        if IniciarFinalizarDocumento then
          BeginDoc(qryModeloCarneconfigurar.AsString);

        if ColCarne = 1 then begin  //------------ Carne com uma (1) coluna -----------------------
          for a:=0 to length(NumeroParcelas)-1 do
          begin
            if qryparcelas.Locate('numero',Numeroparcelas[a],[]) then
            begin
              if (qryParcelasvalorpagto.AsCurrency = 0) or not SomenteAbertas then begin
                BandString := qryModeloCarnecabecalho.AsString;
                BreakToLine;
                WriteBand(qryParcelas.Fields);

                if (qryParcelasvalorpagto.AsCurrency > 0) then begin
                  if not SomenteAbertas then begin
                    if (qryParcelasvalorpagto.AsCurrency > qryParcelasvalorvencto.AsCurrency) then begin
                      BandString:= qryModeloCarneComAtraso.AsString;
                      BreakToLine;
                      WriteBand(qryParcelas.Fields);
                    end
                    else begin
                      BandString:= qryModeloCarneSemAtraso.AsString;
                      BreakToLine;
                      WriteBand(qryParcelas.Fields);
                    end;
                  end;
                end
                else begin
                  BandString:= qryModeloCarneemaberto.AsString;
                  BreakToLine;
                  WriteBand(qryParcelas.Fields);
                end;
                if qryModeloCarneimprimirlayout.AsBoolean and not SomenteAbertas then begin
                   if qryModeloCarneRodape.AsString <> '' then begin
                      BandString:= qryModeloCarnerodape.AsString;
                      BreakToLine;
                      WriteBand(qryParcelas.Fields);
                   end;
                end;
                {$IFDEF LINUX}
                   FormFeedCarneLinux;
                {$ELSE}
                   FormFeed;
                {$ENDIF}
              end;
            end;
          end;
    //    EndDoc('TecLUX - Carnê');
        end  //---- Carne com duas (2) colunas (João Fretta & Cia) -----------------
        else if ColCarne = 2 then begin
             Esquerdo := True;
             FillChar(Cabecalho,SizeOf(Cabecalho),0);
             FillChar(Nome,SizeOf(Nome),0);
             FillChar(ComAtraso,SizeOf(ComAtraso),0);
             FillChar(SemAtraso,SizeOf(SemAtraso),0);
             FillChar(EmAberto,SizeOf(EmAberto),0);
             FillChar(Juros,SizeOf(Juros),0);
             FillChar(TotalAtraso,SizeOf(TotalAtraso),0);
             FillChar(TotalSemAtraso,SizeOf(TotalSemAtraso),0);
             FillChar(Rodape,SizeOf(Rodape),0);

             qryParcelas.First;
             while not qryParcelas.Eof do begin
                if (qryParcelasvalorpagto.AsCurrency = 0) or not SomenteAbertas then begin
                   //--------------- Cabecalho ------------------------------------------------------
                   if Esquerdo then Cabecalho[01] := qryModeloCarneCABECALHO.AsString
                               else Cabecalho[02] := qryModeloCarneLINHA01.AsString;

                   //--------------- Linha01 --------------------------------------------------------
                   if Esquerdo then Nome[01] := qryModeloCarneLINHA02.AsString
                               else Nome[02] := qryModeloCarneLINHA03.AsString;

                   //--------------------------------------------------------------------------------
                   if (qryParcelasvalorpagto.AsCurrency > 0) then begin
                     if not SomenteAbertas then begin
                       if (qryParcelasVALORPAGTO.AsCurrency > qryParcelasVALORVENCTO.AsCurrency) then begin
                          //--------------- ComAtraso ------------------------------------------------------
                          if Esquerdo then ComAtraso[01] := qryModeloCarneCOMATRASO.AsString
                                      else ComAtraso[02] := qryModeloCarneLINHA05.AsString;

                          //--------------- Linha07 Linha08 (Juros) -----------------------------------------
                          if Esquerdo then Juros[01] := qryModeloCarneLINHA07.AsString
                                      else Juros[02] := qryModeloCarneLINHA08.AsString;

                          //--------------- Linha09 Linha10 (Total Pago) ------------------------------------
                          if Esquerdo then TotalAtraso[01] := qryModeloCarneLINHA09.AsString
                                      else TotalAtraso[02] := qryModeloCarneLINHA10.AsString;
                       end
                       else begin
                         //--------------- SemAtraso --------------------------------------------------------
                          if Esquerdo then SemAtraso[01] := qryModeloCarneSEMATRASO.AsString
                                      else SemAtraso[02] := qryModeloCarneLINHA06.AsString;

                         //--------------- Linha11 Linha12 (Total Pago)--------------------------------------
                         if Esquerdo then TotalSemAtraso[01] := qryModeloCarneLINHA11.AsString
                                     else TotalSemAtraso[02] := qryModeloCarneLINHA12.AsString;
                      end;
                    end;
                   end
                   else begin
                     //--------------- EmAberto ---------------------------------------------------------
                     if Esquerdo then EmAberto[01] := qryModeloCarneEMABERTO.AsString {8}
                                 else EmAberto[02] := qryModeloCarneLinha04.AsString;
                  end;
                  //--------------- Rodape ---------------------------------------------------------
                  if Esquerdo then Rodape[01] := qryModeloCarneRODAPE.AsString
                              else Rodape[02] := qryModeloCarneLINHA13.AsString;


                  if not Esquerdo then begin
                     qryParcelas.Prior;
                     if Cabecalho[1] <> '' then begin
                        BandString := Cabecalho[1];    //--- Cabecalho Esquerdo
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;
                     qryParcelas.Next;
                     if Cabecalho[2] <> '' then begin
                        BandString := Cabecalho[2];    //--- Cabecalho Direito
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;
                     //--------------------------------------------------------------------
                     qryParcelas.Prior;
                     if Nome[1] <> '' then begin
                        BandString := Nome[1];    //--- Linha01 Esquerdo (nome)
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;
                     qryParcelas.Next;
                     if Nome[2] <> '' then begin
                        BandString := Nome[2];    //--- Linha01 Direito (nome)
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;

                     //--------------------------------------------------------------------
                     qryParcelas.Prior;
                     if ComAtraso[1] <> '' then begin
                        BandString := ComAtraso[1];    //--- Com Atraso Esquerdo
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end
                     else
                     if SemAtraso[1] <> '' then begin
                        BandString := SemAtraso[1];    //--- Sem Atraso Esquerdo
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end else
                     if EmAberto[1] <> '' then begin
                        BandString := EmAberto[1];    //--- Em Aberto Esquerdo
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;

                     qryParcelas.Next;
                     if ComAtraso[2] <> '' then begin
                        BandString := ComAtraso[2];    //--- Com Atraso Direito
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end else
                     if SemAtraso[2] <> '' then begin
                        BandString := SemAtraso[2];    //--- Sem Atraso Direito
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end else
                     if EmAberto[2] <> '' then begin
                        BandString := EmAberto[2];    //--- Em Aberto Direito
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;

                     qryParcelas.Prior;
                     if Juros[1] <> '' then begin
                        BandString := Juros[1];    //--- Juros Esquerdo
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;
                     qryParcelas.Next;
                     if Juros[2] <> '' then begin
                        if Juros[1] = '' then
                           Juros[2] := '<sp>(74L)</sp>' + Juros[2];

                        BandString := Juros[2];    //--- Juros Direito
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;

                     //--------------------------------------------------------------------
                     qryParcelas.Prior;
                     if TotalAtraso[1] <> '' then begin
                        BandString := TotalAtraso[1];    //--- Total Com Atraso Esquerdo
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end else
                     if TotalSemAtraso[1] <> '' then begin
                        BandString := TotalSemAtraso[1];    //--- Total Sem Atraso Esquerdo
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;

                     qryParcelas.Next;
                     if TotalAtraso[2] <> '' then begin
                        if (TotalAtraso[1] = '') and (TotalSemAtraso[1] = '') then
                           TotalAtraso[2] := '<sp>(69L)</sp>' + TotalAtraso[2];

                        BandString := TotalAtraso[2];    //--- Total Com Atraso Direito
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end else
                     if TotalSemAtraso[2] <> '' then begin
                        if (TotalSemAtraso[1] = '') and (TotalAtraso[1] = '')  then
                           TotalSemAtraso[2] := '<sp>(69L)</sp>' + TotalSemAtraso[2];

                        BandString := TotalSemAtraso[2];    //--- Total Sem Atraso Direito
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;

                     //--------------------------------------------------------------------
                     qryParcelas.Prior;
                     if Rodape[1] <> '' then begin
                        BandString := Rodape[1];    //--- Rodape Esquerdo (nome cliente abaixo)
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;
                     qryParcelas.Next;
                     if Rodape[2] <> '' then begin
                        BandString := Rodape[2];    //--- Rodape Diereito (nome cliente abaixo)
                        BreakToLine;
                        WriteBand(qryParcelas.Fields);
                     end;

    (*               BandString := qryModeloCarneLinha14.AsString;   //-- Salto de página
                     BreakToLine;
                     WriteBand(qryParcelas.Fields);
    *)
                     {$IFDEF LINUX}
                       FormFeedCarneLinux;
                     {$ELSE}
                       FormFeed;
                     {$ENDIF}

                     FillChar(Cabecalho,SizeOf(Cabecalho),0);
                     FillChar(NOme,SizeOf(Nome),0);
                     FillChar(ComAtraso,SizeOf(ComAtraso),0);
                     FillChar(SemAtraso,SizeOf(SemAtraso),0);
                     FillChar(EmAberto,SizeOf(EmAberto),0);
                     FillChar(Juros,SizeOf(Juros),0);
                     FillChar(TotalAtraso,SizeOf(TotalAtraso),0);
                     FillChar(TotalSemAtraso,SizeOf(TotalSemAtraso),0);
                     FillChar(Rodape,SizeOf(Rodape),0);
                  end;
                  Esquerdo:= not Esquerdo;
                  qryParcelas.Next;
                end;
             end;

             if not Esquerdo then begin
                if Cabecalho[1] <> '' then begin
                   BandString := Cabecalho[1];    //--- Cabecalho Esquerdo
                   BreakToLine;
                   WriteBand(qryParcelas.Fields);
                end;
                if Nome[1] <> '' then begin
                   BandString := Nome[1];    //--- Linha01 Esquerdo (nome)
                   BreakToLine;
                   WriteBand(qryParcelas.Fields);
                end;
                if ComAtraso[1] <> '' then begin
                   BandString := ComAtraso[1];    //--- Com Atraso Esquerdo
                   BreakToLine;
                   WriteBand(qryParcelas.Fields);
                end;
                if SemAtraso[1] <> '' then begin
                   BandString := SemAtraso[1];    //--- Com Sem Atraso Esquerdo
                   BreakToLine;
                   WriteBand(qryParcelas.Fields);
                end;
                if EmAberto[1] <> '' then begin
                   BandString := EmAberto[1];    //--- Em Aberto Esquerdo
                   BreakToLine;
                   WriteBand(qryParcelas.Fields);
                end;
                if Juros[1] <> '' then begin
                   BandString := Juros[1];    //--- Juros Esquerdo
                   BreakToLine;
                   WriteBand(qryParcelas.Fields);
                end;
                if TotalAtraso[1] <> '' then begin
                   BandString := TotalAtraso[1];    //--- Total Atraso Esquerdo
                   BreakToLine;
                   WriteBand(qryParcelas.Fields);
                end;
                if TotalSemAtraso[1] <> '' then begin
                   BandString := TotalSemAtraso[1];    //--- Total Sem Atraso Esquerdo
                   BreakToLine;
                   WriteBand(qryParcelas.Fields);
                end;
                if Rodape[1] <> '' then begin
                   BandString := Rodape[1];    //--- Rodape Esquerdo (nome cliente abaixo)
                   BreakToLine;
                   WriteBand(qryParcelas.Fields);
                end;

         (*       BandString := qryModeloCarneLinha14.AsString;
                BreakToLine;
                WriteBand(qryParcelas.Fields); *)

               {$IFDEF LINUX}
                 FormFeedCarneLinux;
               {$ELSE}
                 FormFeed;
               {$ENDIF}
             end;
             FillChar(Cabecalho,SizeOf(Cabecalho),0);
             FillChar(NOme,SizeOf(Nome),0);
             FillChar(ComAtraso,SizeOf(ComAtraso),0);
             FillChar(SemAtraso,SizeOf(SemAtraso),0);
             FillChar(EmAberto,SizeOf(EmAberto),0);
             FillChar(Juros,SizeOf(Juros),0);
             FillChar(TotalAtraso,SizeOf(TotalAtraso),0);
             FillChar(TotalSemAtraso,SizeOf(TotalSemAtraso),0);
             FillChar(Rodape,SizeOf(Rodape),0);
        end;
        if IniciarFinalizarDocumento then
          EndDoc('TecLUX - Carnê');
      end;
    end;
  except
    result := false;
  end;
end;

