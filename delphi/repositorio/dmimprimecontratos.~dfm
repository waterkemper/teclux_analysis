      ''
      ') as pc  left join usuarios u on pc.vendedor = u.codigo'
      ''
      
        'group by pc.localizacao, pc.sublocalizacao, pc.produtovisual, pc' +
        '.descricao, pc.referencia, pc.valorgrade1, pc.valorgrade2, /*com' +
        'postovisual,*/ pc.filial, pc.vendedor, u.nome'
      ''
      
        'order by pc.localizacao, pc.sublocalizacao, pc.produtovisual, pc' +
