    Sql.Strings = (
      ';'
      
        'select pc.localizacao, pc.sublocalizacao, pc.produtovisual, pc.d' +
        'escricao, pc.referencia, pc.filial,'
      
        '       pc.valorgrade1, pc.valorgrade2, /*compostovisual,*/ pc.ve' +
