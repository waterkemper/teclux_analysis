    LinkOptions = [loAlwaysResync]
    Constraints = <>
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'SELECT c.Contrato,'
      '       c.Cliente,'
      ''
      '      (SELECT coalesce(v.razao,v.nome)'
      '          FROM vFornecedores v'
      '          WHERE v.Codigo = c.Cliente AND'
      '                v.Tipo   = c.TipoCliente) AS NomeCliente,'
      '                '
      '      (SELECT v.PessoaTipo'
      '         FROM vFornecedores v'
      '         WHERE v.Codigo = c.Cliente AND'
      '               v.Tipo   = c.TipoCliente) AS TipoCliente,'
      '               '
      '       Formatar_CPF_CNPJ((SELECT CAST(v.PessoaNumero AS VARCHAR)'
      '                             FROM vFornecedores v'
      '                             WHERE v.Codigo = c.Cliente AND'
      
        '                                   v.Tipo   = c.TipoCliente)) AS' +
        ' NumeroCliente,'
      '       c.Principal,                                   '
      '       c.Percentual,'
      '       c.Representante,'
      '       '
      '       CAST(c.Representante || '#39' - '#39' ||'
      '           (SELECT coalesce(v.razao,v.nome)'
      '              FROM vFornecedores v'
      '               WHERE v.Codigo = c.Representante AND'
      
        '                     v.Tipo   = c.TipoRepresentante) AS VARCHAR)' +
        ' AS NomeRepresentante,'
      '                     '
      '      (SELECT v.PessoaTipo'
      '          FROM vFornecedores v'
      '          WHERE v.Codigo = c.Representante AND'
      
        '                v.Tipo   = c.TipoRepresentante) AS TipoRepresent' +
        'ante,'
      '                '
      '      (SELECT v.PessoaNumero'
      '          FROM vFornecedores v'
      '          WHERE v.Codigo = c.Representante AND'
      
        '                v.Tipo   = c.TipoRepresentante) AS NumeroReprese' +
        'ntante,'
      '                '
      '       c.Fiador,'
      '       CAST(c.Fiador || '#39' - '#39' ||'
      '           (SELECT coalesce(v.razao,v.nome)'
      '               FROM vFornecedores v'
      '               WHERE v.Codigo = c.Fiador AND'
      
        '                     v.Tipo   = c.TipoFiador) AS VARCHAR) AS Nom' +
        'eFiador,'
      '                     '
      '      (SELECT v.PessoaTipo'
      '          FROM vFornecedores v'
      '          WHERE v.Codigo = c.Fiador AND'
      '                v.Tipo   = c.TipoFiador) AS TipoFiador,'
      '                '
      '      (SELECT v.PessoaNumero'
      '          FROM vFornecedores v'
      '          WHERE v.Codigo = c.Fiador AND'
      '                v.Tipo   = c.TipoFiador) AS NumeroFiador,'
      '       c.Observacoes'
      '       '
      'FROM compradores c'
      'WHERE c.Contrato = :Contrato'
      'ORDER BY c.Principal DESC, c.Percentual DESC'
      '')
    RequestLive = True
    Left = 121
