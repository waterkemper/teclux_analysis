        Value = 'false'
      end>
    Sql.Strings = (
      'Select o.codigo,'
      '           o.cliente,'
      '           o.nome,'
      '           o.emissao,'
      '           o.validade,'
      '           o.frete,'
      '           o.seguro,'
      ''
      
        '           (Select sum(coalesce(po.valordescontoitem,0) + coales' +
        'ce(po.descontogeral,0) )'
      '            From produtosorcamentos po'
      
        '            Where po.orcamento = o.codigo) as totaldescontoprodu' +
        'tos,'
      ''
      
        '           (Select sum((po.quantidade * po.precovenda) - coalesc' +
        'e(po.valordescontoitem,0) - coalesce(po.descontogeral,0) )'
      '            From produtosorcamentos po'
      '            Where po.orcamento = o.codigo) as totalprodutos,'
      ''
      
        '           (Select sum(so.quantidade * so.valorservico) From ser' +
        'vicosorcamentos so Where so.orcamento = o.codigo) as totalservic' +
        'os,'
      ''
      
        '           formatar_fone_fax(o.foneddd, o.fonenumero, o.fonerama' +
        'l) as fone,'
      
        '           formatar_fone_fax(o.fone2ddd, o.fone2numero, o.fone2r' +
        'amal) as fone2,'
      '           o.rua, o.numero, o.complemento,'
      ''
      '           (Select b.nome'
      '            From bairros b'
      '            Where b.estado = o.estado'
      '              and b.cidade = o.cidade'
      '              and b.codigo = o.bairro) as nomebairro,'
      ''
      
        '           (Select c.nome From cidades c Where c.estado = o.esta' +
        'do and c.codigo = o.cidade) as nomecidade,'
      '           o.estado,'
      '           o.cep,'
      
        '           cast(trim(coalesce(parametros_valor('#39'Observa'#231#227'o Padr'#227 +
        'o Or'#231'amento'#39', o.filial),'#39#39')||'#39' '#39'||coalesce(o.observacao,'#39#39')) as ' +
        'varchar(2081)) as observacao,'
      '           o.contrato, vf.pessoatipo, vf.pessoanumero,'
      ''
      '           (Select u.nome'
      '            From usuarios u'
      '            Where u.codigo = o.vendedor) as nomevendedor'
      ''
      'From   orcamentos o'
      '       left join vfornecedores vf'
      '       on o.cliente = vf.codigo'
      '       and o.tipocliente = vf.tipo'
      ''
      'Where'
      ''
      '%SQL')
