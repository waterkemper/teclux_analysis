    Constraints = <>
    OnCalcFields = qryProdutosOrcamentosCalcFields
    ExtraOptions = [poTextAsMemo, poOidAsBlob]
    Macros = <>
    Sql.Strings = (
      'Select po.produto, p.codigovisual as produtovisual,'
      '           po.filial,'
      '           po.quantidade,'
      '           po.precovenda,'
      
        '           Nullif(coalesce(po.valordescontoitem,0) + coalesce(po' +
        '.descontogeral,0),0) as desconto,'
      
        '           (po.quantidade * po.precovenda) - (coalesce(po.valord' +
        'escontoitem,0) + coalesce(po.descontogeral,0)) as total,'
      '           po.vendido,'
      '           po.previsao,'
      '           p.descricao,'
      '           p.valorgrade1,'
      '           p.valorgrade2,'
      '           case when :VisualizarSituacaoProdutos then'
      
        '             produtosorcamentos_situacao(po.orcamento, po.produt' +
        'o, po.filial, o.situacao)'
      
        '           else cast(null as varchar(1)) end as situacao_produto' +
        ','
      
        '           case when c.emitecomplemento then c.complemento else ' +
        'cast(null as varchar(1000)) end as complemento,'
      '           c.anvisa,'
      ''
      
        '           (select cast(cast('#39'http://'#39' as varchar)||parametros_v' +
        'alor('#39'SITE EMPRESA'#39',NULL)||cast('#39'/fotos/'#39' as varchar)||fp.nomefo' +
        'to as varchar(350))'
      '            from fotosprodutos fp'
      '            where fp.produto = po.produto'
      '              order by fp.posicao limit 1 ) as nomefoto'
      ''
      ''
      
        'From   orcamentos o, produtosorcamentos po, produtos p, caracter' +
        'isticas c'
      'Where o.codigo = po.orcamento'
      '  and po.produto = p.codigo'
      '  and p.caracteristica = c.codigo'
      '  and o.codigo = :codigo'
      ''
      'order by po.numero')
    RequestLive = False
