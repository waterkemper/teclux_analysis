procedure TdtmImprimeOrcamento.ImprimirOrcamento(Orcamentos: String);
var
  arquivofast : String;
begin
  qryOrcamentos.macrobyname('sql').asString := '(o.codigo in (' + Orcamentos + '))';

  qryOrcamentos.close;
  qryOrcamentos.Open;

  if not qryOrcamentos.IsEmpty then
  begin
    frVariables['Rua']   := RuaFilialBase;
    frVariables['Bairro']:= BairroFilialBase + ' - CEP: ' + CEPFilialBase;
    frVariables['Cidade']:= CidadeFilialBase + ' - ' + EstadoFilialBase;
    frVariables['Fone']  := FoneFilialBase;

    arquivofast := ExtractFilePath(Application.ExeName) + 'frpOrcamento.frf';
    if FileExists(arquivofast) then
      frpOrcamento.LoadFromFile(arquivofast);

//    frpOrcamento.designreport;

    ImprimirRelatoriofast(null, null, MSimples, 0, [frpOrcamento], false, self);
  end;end;

procedure TdtmImprimeOrcamento.qryOrcamentosAfterScroll(DataSet: TDataSet);
begin
  ReFazConsulta(qryProdutosOrcamentos,      [0,1],[ParSistema.VisualizarSituacaoProdutos,
                                                   qryOrcamentoscodigo.AsInteger]);
  ReFazConsulta(qryServicosOrcamento,       [0],[qryOrcamentoscodigo.AsInteger]);
  ReFazConsulta(qryParcelasPlanosOrcamentos,[0],[qryOrcamentoscodigo.AsInteger]);
end;

procedure TdtmImprimeOrcamento.frpOrcamentoBeforePrint(Memo: TStringList;
  View: TfrView);
{  var
  vnomearquivo : String;}
begin
  inherited;
  if (View.Name = 'fpvLogo') then
  begin
    if FileExists(LogotipoFilialBase) then
//      try
        TfrPictureView(View).Picture.LoadFromFile(LogotipoFilialBase)
//      except
//      end;
  end
  else
  if (View.Name = 'ProductPicture') then
  begin
  {
    if qryProdutosOrcamentos.recno = 1 then
       TfrPictureView(View).Picture.LoadFromFile('n:\imagens\113670017012014102909.bmp')
    else
    if qryProdutosOrcamentos.recno = 2 then
       TfrPictureView(View).Picture.LoadFromFile('n:\imagens\40006102011021038.bmp');
       }
                              {
    vnomearquivo := trocar(qryProdutosOrcamentosnomefoto.asString, 'http://', '');
    vnomearquivo := trocar(vnomearquivo, '/', '\');
    vnomearquivo := extractfilename(vnomearquivo);
    vnomearquivo := trocar(vnomearquivo, extractfileext(vnomearquivo), '.bmp');
    vnomearquivo := 'n:\imagens\'+vnomearquivo;

    DownloadIMGStream(qryProdutosOrcamentosnomefoto.asString, true);

    TfrPictureView(View).Picture.LoadFromFile(vnomearquivo);
                              }
    if qryProdutosOrcamentosnomefoto.asString<>'' then
    begin
      TfrPictureView(View).visible := true;
      TfrPictureView(View).Picture.Bitmap.LoadFromStream(DownloadIMGStream(qryProdutosOrcamentosnomefoto.asString, true));
    end
    else
      TfrPictureView(View).visible := false;

  end

end;

procedure TdtmImprimeOrcamento.qryProdutosOrcamentosCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  qryProdutosOrcamentosdescricaolc.asString := trim(qryProdutosOrcamentosdescricao.asString + ' ' +
                                                    qryProdutosOrcamentosvalorgrade1.asString + ' ' +
                                                    qryProdutosOrcamentosvalorgrade2.asString);
  if not qryProdutosOrcamentosanvisa.isnull then
    qryProdutosOrcamentosdescricaolc.asString := qryProdutosOrcamentosdescricaolc.asString + ' MS - ' +
                                                 qryProdutosOrcamentosanvisa.asString;
end;


