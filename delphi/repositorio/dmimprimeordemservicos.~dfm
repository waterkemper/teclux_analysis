    Macros = <>
    Sql.Strings = (
      'select q.codigo as questionario, '
      '       q.descricao as descricaoquestionario,'
      '       q.descricao_text as descriacaoquestionario_texto,'
      '       '
      '       p.codigo as pergunta, '
      '       p.descricao as descricaopergunta, '
      '       p.tipo as tipopergunta,'
      '       p.sequencia as sequenciapergunta,'
      '       '
      '       r.codigo as resposta,'
      '       r.resposta as descricaoresposta,'
      '       r.sequencia as sequenciaresposta,'
      '       '
      '       case when p.tipo in ('#39'm'#250'ltipla'#39', '#39#250'nica'#39')  then'
      '        coalesce((select true'
      '         from respostas_os ro'
      '         where ro.resposta = r.codigo'
      '           and ro.contrato = ct.numero'
      '           and ro.equipamento = ct.equipamento),false)'
      '       else cast(null as boolean) end as respostaboolean_os,'
      '       '
      '       case when p.tipo in ('#39'texto'#39')  then'
      '       '
      '        (select ro.texto'
      '         from respostas_os ro'
      '         where ro.resposta = r.codigo'
      '           and ro.contrato = ct.numero'
      '           and ro.equipamento = ct.equipamento)'
      
        '       else cast(null as varchar(1000)) end as respostatexto_os ' +
        '   '
      '       '
      'from questionarios q'
      '     join perguntas p'
      '          join respostas r'
      '          on p.codigo = r.pergunta'
      '     on q.codigo = p.questionario,'
      '    '
      '    contratos ct '
      '     '
      'where ct.numero = :ordemservico /*'#39'923603'#39'*/'
      '  and q.codigo = (select e.checklist '
      '                  from equipamentos e'
      '                  where e.codigo = ct.equipamento)'
      'order by p.sequencia, r.sequencia')
