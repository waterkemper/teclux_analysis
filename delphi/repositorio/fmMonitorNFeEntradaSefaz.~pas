procedure TfrmMonitorNFeEntradaSefaz.qryFiliaisCalcFields(
  DataSet: TDataSet);
begin
  inherited;
  if qryFiliaisnsu_dhrecbto.isnull then
    qryFiliaisnhora.clear
  else
    qryFiliaisnhora.value := hoursBetween(now(), FormatarTimeStamp(qryFiliaisnsu_dhrecbto.asString));

  if qryFiliaisnsucte_dhrecbto.isnull then
    qryFiliaisnhoracte.clear
  else
    qryFiliaisnhoracte.value := hoursBetween(now(), FormatarTimeStamp(qryFiliaisnsucte_dhrecbto.asString));

end;

