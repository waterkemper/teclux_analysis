procedure TfrmMonitorNFeEntradaSefaz.sbnPararClick(Sender: TObject);
begin
  sbnBuscarNFeServidorSefaz.Caption := 'Iniciar busca no servidor da Sefaz';
  PassosDistribuicao := opInicio;
  vPararProcessamento := true;
  if assigned(_ProcessamentoNFE) then
    _ProcessamentoNFE.Terminate;

  gbxFiliaisSefaz.enabled := true;

  sbnBuscarNFeServidorSefaz.onClick := sbnBuscarNFeServidorSefazClick;
end;

procedure TfrmMonitorNFeEntradaSefaz.Processamento;
VAR
  vPosition : Double;

  function PermiteAcessarDistribuicaoNFe: Boolean;
  begin
    result :=
        qryFiliaisbuscarxmlnfeentrada.asBoolean {and

        (qryFiliaisnsu_dhrecbto.isnull or
         (qryFiliaisnhora.asfloat >= 1))};

  end;

  function PermiteAcessarDistribuicaoCTe: Boolean;
  begin
    result :=
        qryFiliaisbuscarxmlnfeentrada.asBoolean {and

        (qryFiliaisnsucte_dhrecbto.isnull or
         (qryFiliaisnhoracte.asfloat >= 1))};

  end;

  procedure AtualizarCTesCancelados;
  begin

    vmsg := 'Atualizando CTe´s cancelados!';

    qryCTeCancelados.ParambyName('codigo').asInteger := qryFiliaiscodigo.asInteger;

    qryCTeCancelados.close;
    qryCTeCancelados.open;

    qryCTeCancelados.first;
    while not qryCTeCancelados.eof do
    begin
      qryAtualizarCte_x_NP_cancelados.parambyname('codigonota').asinteger :=
        qryCTeCanceladoscodigo.asinteger;
      qryAtualizarCte_x_NP_cancelados.ExecSql;

      qryAtualizarCte_x_NP_cancelados.Transaction.Commit;

      qryCTeCancelados.next;

      try
        vPosition := qryCTeCancelados.recno * 100 / qryCTeCancelados.recordcount
      except
        vPosition := 0;
      end;
      AdvSmoothProgressBar1.Position := vPosition;
      application.processmessages;
    end;

  end;

  procedure AtualizarNSU(Tipo: String);
  begin
    if not vPararProcessamento then
    begin
      qryNSU.parambyname('tipo').asString := Tipo;
      qryNSU.parambyname('filial').asInteger := qryFiliaiscodigo.asinteger;

      qryNSU.close;
      qryNSU.open;

      if qryNSU.RecordCount <> 0 then
      begin
        vmsg := 'Ciência da Operação ou Confirmação de NSU pendentes '+inttostr(qryNSU.recno)+'/'+inttostr(qryNSU.recordcount);
        PassosDistribuicao := opDistribuicaoDFeCienciaOPeracao;
        DistribuicaoDFeCienciaOPeracao(self, qryNSU, vMsg, vPararProcessamento, PassosDistribuicao, qryFiliais, qryNSUtipo.asString);
      end;


    end;
  end;

  procedure AtualizarNSUFaltantes;
  begin

    if not vPararProcessamento then
    begin

      if qryNSU.recordcount < 19 then
      begin

        vmsg := 'Início da captura de xmls NFE FALTANTES';
        qryNSUS_Faltantes.Parambyname('tipo').asString := 'NFE';
        qryNSUS_Faltantes.Parambyname('codigo').asInteger := qryFiliaiscodigo.asinteger;
        qryNSUS_Faltantes.Parambyname('limit_').asInteger := 19-qryNSU.recordcount;

        qryNSUS_Faltantes.close;
        qryNSUS_Faltantes.open;

        if qryNSUS_Faltantes.RecordCount <> 0 then
        begin
          PassosDistribuicao := opVarificacaoNSUFaltantes;

          DistribuicaoDFe(self, qryNSUS_Faltantes, vMsg, vPararProcessamento, PassosDistribuicao, qryFiliais, '', 'NFE');


        end;
      end;
    end;

  end;


begin
  PassosDistribuicao := opInicio;
  vTempoInicialEsperaVerificacao := 0;
  try

    application.processmessages;

    if not vPararProcessamento then
    begin

      qryFiliais.first;
      while not qryFiliais.eof do
      begin

        if PermiteAcessarDistribuicaoNFe or
           PermiteAcessarDistribuicaoCTe then

        begin


          PassosDistribuicao := opDistribuicaoDFe;
          vmsg := 'Início da captura dos NSUs do arquivo de distribuição';

          PassosDistribuicao := opDistribuicaoDFe;

          {
          if (qryFiliaisnsu.asString <> '') and
             (qryFiliaisnsu.asstring <> '') and
              (qryFiliaisnsu.asString <> qryFiliaisnsu.asstring) then
          begin
            qryFiliais.edit;
            qryFiliaisnsu.asstring := qryFiliaisnsu.asString;
            qryFiliaisnsu_inicial.asstring := qryFiliaisnsu.asString;
            qryFiliais.post;
          end;
          }


          if PermiteAcessarDistribuicaoNFe then
          begin
            qryFiliais.edit;
            qryFiliais.fieldbyname('nsu_cstat').clear;
            qryFiliais.fieldbyname('nsu_cstat_motivo').clear;
            qryFiliais.post;
            qryFiliais.Transaction.Commit;

            application.processmessages;
            if not vPararProcessamento then
              AtualizarNSU('resNFe');

            if vPararProcessamento then
              break;

            application.processmessages;
            if not vPararProcessamento then
              if PermiteAcessarDistribuicaoNFe then
                 AtualizarNSUFaltantes;

            if vPararProcessamento then
              break;

            application.processmessages;
            if not vPararProcessamento then
              if PermiteAcessarDistribuicaoNFe then
              begin
                PassosDistribuicao := opDistribuicaoDFe;
                DistribuicaoDFe(self, qryFiliais, vMsg, vPararProcessamento, PassosDistribuicao, qryFiliais, '', 'NFE');
              end;
          end;


          if PermiteAcessarDistribuicaoCTe then
          begin
            PassosDistribuicao := opDistribuicaoDFe;
            DistribuicaoDFe(self, qryFiliais, vMsg, vPararProcessamento, PassosDistribuicao, qryFiliais, '', 'CTE');

            if not vPararProcessamento then
              AtualizarCTesCancelados;
          end;

          vmsg := 'Fim da captura dos NSUs do arquivo de distribuição';

        end;

        if qryFiliaisbuscarxmlnfeentrada.asBoolean and

           ((vTempoInicialEsperaVerificacao = 0) or

            ((vTempoInicialEsperaVerificacao <> 0) and
             (not qryFiliaisnsu_dhrecbto.isnull and
              (FormatarTimeStamp(qryFiliaisnsu_dhrecbto.asString) < vTempoInicialEsperaVerificacao)
              )
             ) or

            ((vTempoInicialEsperaVerificacao <> 0) and
             (not qryFiliaisnsucte_dhrecbto.isnull and
              (FormatarTimeStamp(qryFiliaisnsucte_dhrecbto.asString) < vTempoInicialEsperaVerificacao)
              )
             )) then
         begin
           if FormatarTimeStamp(qryFiliaisnsu_dhrecbto.asString) >
              FormatarTimeStamp(qryFiliaisnsucte_dhrecbto.asString) then

             vTempoInicialEsperaVerificacao := FormatarTimeStamp(qryFiliaisnsucte_dhrecbto.asString)
           else
             vTempoInicialEsperaVerificacao := FormatarTimeStamp(qryFiliaisnsu_dhrecbto.asString);
         end;

        qryFiliais.next;

      end;

    end;

  finally

    sbnPararClick(nil);
    PassosDistribuicao := opAguardandoTempo;

  end;

end;

