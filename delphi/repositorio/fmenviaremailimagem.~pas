procedure TfrmEnviarEmailImagem.Marcarlistadearquivos(quantidade: integer);
var
  path: String;
  i,j: Integer;

begin

  flistadearquivos := TStringList.create;
  flistadearquivos.Sorted := true;


    for i := 0 to CheckFileListBoxEx.items.count-1 do
      flistadearquivos.add( DateTimeToStr(FileDateToDateTime(FileAge(CheckFileListBoxEx.directory+'\'+CheckFileListBoxEx.items[i]))) +
              CheckFileListBoxEx.items[i] );

    j:=-1;
    if (flistadearquivos.Count-1) > quantidade then
      j:= (flistadearquivos.Count-1) - quantidade;

    for i:= 0 to j do
      flistadearquivos.Delete(0);

    flistadearquivos.Sorted := false;
    for i:= 0 to flistadearquivos.count-1 do
      flistadearquivos[i] := Copy(flistadearquivos[i], 20, 50);
    flistadearquivos.Sorted := true;

    for i:= 0 to flistadearquivos.count-1 do
    begin
      j := CheckFileListBoxEx.Items.IndexOf(flistadearquivos[i]);
      if j<>-1 then
        CheckFileListBoxEx.Checked[j] := True;
    end;

    CheckFileListBoxEx.ItemIndex := CheckFileListBoxEx.Items.Count-1;
    CheckFileListBoxEx.Selected[CheckFileListBoxEx.ItemIndex] := true;

    CheckFileListBoxExChange(CheckFileListBoxEx);

end;

procedure TfrmEnviarEmailImagem.CheckFileListBoxExChange(Sender: TObject);
begin
  if CheckFileListBoxEx.FileName <> '' then
    imgVisualFormURL.Picture.LoadFromFile(CheckFileListBoxEx.FileName);
end;

end.
