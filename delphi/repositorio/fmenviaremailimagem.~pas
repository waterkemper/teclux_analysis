constructor TfrmEnviarEmailImagem.Create(AOwner: TComponent; Host, Email, Contato, Texto, Assunto: String; origem: TOrigemEmail = Outros);
var
  Lista : TStringList;
  i: integer;

begin
  inherited Create(AOwner);
  Caption := Caption + ' - ' + Texto;
  edtEmail.Lines.Clear;

  try
    Lista := TStringList.Create;
    ExtractStrings([';'], [], PChar(Email), Lista);
    for i:=0 to Lista.count-1 do
       edtEmail.Lines.Append(trim(lista[i]));

  finally
    Lista.free;
  end;

  edtcontato.Text:= Contato;
  edtHost.Text := Host;
  edtAssunto.Text:= trim(UsuarioLogin.Assunto + ' '+ Assunto);
  mmoIntroducao.Text:= UsuarioLogin.Introducao;
  mmoConclusao.Text:= UsuarioLogin.Conclusao;
  FTexto:= Texto;
  Msg := TStringList.Create;
  OrigemEmail := Origem;

  if OrigemEmail = EnvioNFe then
  begin
    gbxhost.visible := false;
    gbxAssunto.visible := false;
    gbxIntroducao.visible := false;
    gbxtexto.visible := false;
    gbxConclusao.visible := false;
//    sbnEnviar.top := gbxemail.top + 85;
    self.height := self.height - gbxhost.height - gbxAssunto.Height - gbxIntroducao.Height - gbxtexto.Height - gbxConclusao.Height;
  end;

  CheckFileListBoxEx.Directory :=  ExtractFilePath(Application.ExeName) + 'Saidas\Captura_da_Tela\'+formatDateTime('yyyy-mm-dd', now());
  CheckFileListBoxEx.Mask := '*.jpg';
  Marcarlistadearquivos(3);

end;

