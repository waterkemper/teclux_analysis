procedure TfrmEnviarEmailImagem.sbnEnviarClick(Sender: TObject);
var
  SMTP : TIdSMTP;
  POP3 : TIdPOP3;
  MsgEmail : TIdMessage;
  i: integer;
  msgaux : String;
  vResult : Boolean;
  vListadeArquivosMarcados : tStringList;

  function ListadeArquivosMarcados: TStringList;
  var
  i: integer;
  begin
    result := tStringLIst.create;
    for i:=0 to CheckFileListBoxEx.Items.Count-1 do
    begin
      if CheckFileListBoxEx.Checked[i] then
        result.append(CheckFileListBoxEx.FileName);
    end;
    vListadeArquivosMarcados := result;
  end;


begin
  inherited;

  vResult := true;
  Enviou:=True;
  if (MensagemConfirmacao(ctCONFIRMAENVIOEMAIL) = smbOk) and (ListaEmailValido(edtEmail, vListaEmailValidos)) then
  begin

    if OrigemEmail <> EnvioNFe then
    begin

      if edtEmail.lines.Text <> '' then
      begin

        if parsistema.UsaitecLUX and
           (OrigemEmail = Orcamento) then
          close
        else
        begin


          Caption:= 'Enviando...';

          msg.append(' REFERÊNCIA '+'<BR>');
          for i:=0 to mmotexto.Lines.Count -1 do
            msg.Append(mmotexto.Lines[i]+'<BR>');

          msg.append(' INTRODUÇÃO '+'<BR>');
          for i:=0 to mmoIntroducao.Lines.Count -1 do
            msg.Append(mmoIntroducao.Lines[i]+'<BR>');

          msg.append(' CONCLUSÃO '+'<BR>');
          for i:=0 to mmoConclusao.Lines.Count -1 do
            msG.Append(mmoConclusao.Lines[i]+'<BR>');

          if edtcontato.Text <> '' then
          begin
            msg.append(' CONTATO '+'<BR>');
            msg.Append(edtcontato.Text+'<BR>');
          end;

          ListadeArquivosMarcados;

          vResult := EnviarEmail_(LowerCase(UsuarioLogin.HostSmtpusuario),
                       UsuarioLogin.UsuarioEmailUsuario,
                       UsuarioLogin.SenhaEmailUsuario,
                       UsuarioLogin.PortaSmtpUsuario,
                       LowerCase(UsuarioLogin.EmailUsuario),
                       vListaEmailValidos, edtAssunto.Text, msg.Text, fEmpresa,
                       usuariologin.smtprequersslUsuario,
                       vListadeArquivosMarcados);

          if vResult then
          begin
            MensagemAviso(ctEMAILENVIADOCOMSUCESSO);
            self.ModalResult := mrOk;
          end
          else
            Enviou := false;
        end;


      end
      else
      begin
        MensagemAviso('E-mail em branco');
        edtEmail.SetFocus;
      end;
    end
    else
    begin
      self.ModalResult := mrOk;
    end;
  end;
end;

