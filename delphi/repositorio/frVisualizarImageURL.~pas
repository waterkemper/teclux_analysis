//      vBitmap := TBitmap.Create;
      vBitmap := imgVisualFormURL.Picture.Bitmap;
//      ResizeBitmap(vBitmap, 200, 150, clBtnFace);


      ImageList1.Add(vBitmap, nil);

    end;

end;

