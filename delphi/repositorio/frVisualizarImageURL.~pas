procedure TfraVisualizarImageURL.AbrirImagensdaPasta(Caminho, mascara: String;
  quantidade: integer);

var
  newbtn: TToolButton;
  I: integer;
  vBotoesCriados: Boolean;
  vBitmap: TBitmap;

