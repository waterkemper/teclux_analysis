      begin
      {
        ImageList1.width := imgVisualFormURL.Picture.Bitmap.width;
        ImageList1.Height := imgVisualFormURL.Picture.Height;
        }

        ImageList1.width := imgVisualFormURL.Picture.width;
        ImageList1.Height := imgVisualFormURL.Picture.Height;

