package login;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  tecsoft6,
  automacao,
  frx;

contains
  dmtecsoft in 'dmtecsoft.pas' {dtmTecSoft: TDataModule},
  fmlogin in 'fmlogin.pas' {frmLogin},
  fmrenovarsenha in 'fmrenovarsenha.pas' {frmRenovarSenha},
  fmsplash in 'fmsplash.pas' {frmSplash},
  rglogin in 'rglogin.pas',
  dmbasico in 'dmbasico.pas' {dtmBasico: TDataModule};

end.
