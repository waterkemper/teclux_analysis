unit uProcessamentoNFE;

interface

uses
  Classes {$IFDEF MSWINDOWS} , Windows {$ENDIF}, ctconstantes;

type
  TProcessamentoNFE = class(TThread)
  private
    fProcessamento: TtecProcedure;
  private
    procedure SetName;

  protected
    procedure Execute; override;
    constructor Create;
  public  
    property Processamento: TtecProcedure read fProcessamento write fProcessamento;
  end;

implementation

{ Important: Methods and properties of objects in visual components can only be
  used in a method called using Synchronize, for example,

      Synchronize(UpdateCaption);

  and UpdateCaption could look like,

    procedure TProcessamentoNFE.UpdateCaption;
    begin
      Form1.Caption := 'Updated in a thread';
    end; }

{$IFDEF MSWINDOWS}
type
  TThreadNameInfo = record
    FType: LongWord;     // must be 0x1000
    FName: PChar;        // pointer to name (in user address space)
    FThreadID: LongWord; // thread ID (-1 indicates caller thread)
    FFlags: LongWord;    // reserved for future use, must be zero
  end;
{$ENDIF}

{ TProcessamentoNFE }

procedure TProcessamentoNFE.SetName;
{$IFDEF MSWINDOWS}
var
  ThreadNameInfo: TThreadNameInfo;
{$ENDIF}
begin
{$IFDEF MSWINDOWS}
  ThreadNameInfo.FType := $1000;
  ThreadNameInfo.FName := 'ProcessamentoNFE';
  ThreadNameInfo.FThreadID := $FFFFFFFF;
  ThreadNameInfo.FFlags := 0;

  try
    RaiseException( $406D1388, 0, sizeof(ThreadNameInfo) div sizeof(LongWord), @ThreadNameInfo );
  except
  end;
{$ENDIF}
end;

procedure TProcessamentoNFE.Execute;
begin
  SetName;
  { Place thread code here }
  while not terminated do
//    processamento;
   Synchronize(processamento);
end;

constructor TProcessamentoNFE.Create;
begin
  FreeOnTerminate := True; // Libera o objeto após terminar.
  Priority := TpLower; { Configura sua prioridade na lista de processos do Sistema operacional. }
//  Resume; // Inicia o Thread.
end;

end.
